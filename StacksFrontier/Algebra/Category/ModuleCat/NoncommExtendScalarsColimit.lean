module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import StacksFrontier.Algebra.Category.ModuleCat.NoncommExtendScalars
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Extension of scalars commutes with a colimit of the target ring

Let `A` be a ring, let `M` be an `A`-module and let `k ↦ B_k` be a diagram of rings equipped
with compatible homomorphisms `β_k : A → B_k`, with colimit `B` and `γ : A → B`. Reading each
relative tensor product `B_k ⊗_A M` as an `A`-module by restriction of scalars along `β_k`,
the base changes form a diagram of `A`-modules and the maps `b ⊗ m ↦ ι_k(b) ⊗ m` form a cocone
on it with apex `B ⊗_A M`. This file proves that **that cocone is colimiting** whenever the
colimit of rings is one whose underlying additive colimit is computed objectwise — in
particular whenever the diagram is filtered.

Filteredness is needed, and is needed only here: the underlying additive group of a colimit of
rings is the colimit of the underlying additive groups exactly for filtered diagrams (for a
coproduct of rings it is a tensor product, not a direct sum). It enters through the single
instance `PreservesColimitsOfShape K (forget₂ RingCat AddCommGrpCat)`, which is what the
statements below assume; `Stacks.NoncommChangeOfRings.Colimit.instPreservesColimitsOfShape`
supplies it for every small filtered shape.

## Implementation notes

`B ⊗_A M` is `Stacks.NoncommChangeOfRings.BaseChange γ M`, the quotient of `B ⊗[ℤ] M` by the
submodule `tensorRel γ M` generated by the relations `(b · γ a) ⊗ m - b ⊗ (a · m)`. So a map
out of it is a map out of `B ⊗[ℤ] M` killing those relations, and a map out of `B ⊗[ℤ] M` is a
biadditive map on `B × M`, i.e. an additive map `B → Hom(M, -)`. The colimit is therefore used
exactly twice:

* to **descend** an additive map from the stages: `Colimit.descAdd`;
* to know that the stages **generate** the colimit additively, so that a relation which holds
  on every `ι_k(b)` holds for every `b`: `Colimit.forall_of_forall_ι`, proved from the
  uniqueness half of the same universal property applied to the quotient by the subgroup the
  stages generate.

Everything else is bookkeeping: the two relations to be checked on a pure tensor
(`descPairing_mul_right`, which says the descended pairing kills `tensorRel`, and
`descPairing_smul`, which says the descended map is `A`-linear) are each additive in the ring
variable, so `forall_of_forall_ι` reduces them to the stages, where they are the defining
relation `tmul_smul` and the `A`-linearity of the cocone leg.

No flatness, finite presentation or commutativity hypothesis appears: the statement is about
`Stacks.NoncommChangeOfRings.BaseChange`, the relative tensor product along a homomorphism of
not necessarily commutative rings.

## Main definitions

* `Stacks.NoncommChangeOfRings.Colimit.diagram`: the diagram `k ↦ B_k ⊗_A M` of `A`-modules.
* `Stacks.NoncommChangeOfRings.Colimit.cocone`: the cocone on it with apex `B ⊗_A M`, whose
  leg at `k` sends `b ⊗ m` to `ι_k(b) ⊗ m`.

## Main results

* `Stacks.NoncommChangeOfRings.Colimit.descAdd`: a compatible family of additive maps out of the
  stages of a colimit of rings descends to the colimit.
* `Stacks.NoncommChangeOfRings.Colimit.forall_of_forall_ι`: the stages of a colimit of rings
  generate it additively.
* `Stacks.NoncommChangeOfRings.Colimit.eq_zero_of_mem_tensorRel`: an additive map out of
  `B ⊗[ℤ] M` respecting the defining relation vanishes on `tensorRel`, although the latter is a
  `B`-span: its generating set is stable under the action of `B`.
* `Stacks.NoncommChangeOfRings.Colimit.isColimitCocone`: **the cocone is colimiting.**

## References

* [Stacks Project, Tag 0EXB](https://stacks.math.columbia.edu/tag/0EXB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TensorProduct

universe w' w v u₁ u₂

namespace Stacks.NoncommChangeOfRings.Colimit

/-! ### Additive descent along a colimit of rings -/

section RingColimit

variable {K : Type w} [Category.{w'} K] {D : K ⥤ RingCat.{u₂}} {c : Cocone D}
  [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})]
  {P : Type u₂} [AddCommGroup P]

/-- Every small filtered shape has its colimits of rings computed on the underlying additive
groups. -/
instance instPreservesColimitsOfShape (J : Type) [SmallCategory J] [IsFiltered J] :
    PreservesColimitsOfShape J (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂}) :=
  (preservesSmallestFilteredColimits_of_preservesFilteredColimits
    (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})).preserves_filtered_colimits J

/-- A colimit cocone of rings is a colimit cocone of the underlying additive groups. -/
noncomputable def isColimitForget₂ (hc : IsColimit c) :
    IsColimit ((forget₂ RingCat.{u₂} AddCommGrpCat.{u₂}).mapCocone c) :=
  isColimitOfPreserves _ hc

/-- A compatible family of additive maps out of the rings of a diagram, as a cocone of additive
groups. -/
noncomputable def addCocone (ψ : ∀ k, ↑(D.obj k) →+ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k') (x : D.obj k), ψ k' ((D.map g).hom x) = ψ k x) :
    Cocone (D ⋙ forget₂ RingCat.{u₂} AddCommGrpCat.{u₂}) where
  pt := AddCommGrpCat.of P
  ι :=
    { app k := AddCommGrpCat.ofHom (ψ k)
      naturality := fun {k k'} g => by
        ext x
        exact hψ g x }

/-- **Additive descent along a colimit of rings**: a compatible family of additive maps out of
the stages descends to the colimit. -/
noncomputable def descAdd (hc : IsColimit c) (ψ : ∀ k, ↑(D.obj k) →+ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k') (x : D.obj k), ψ k' ((D.map g).hom x) = ψ k x) :
    ↑c.pt →+ P :=
  ((isColimitForget₂ hc).desc (addCocone ψ hψ)).hom

/-- The map `descAdd hc ψ hψ` restricts to `ψ k` on the `k`-th stage. -/
lemma descAdd_ι (hc : IsColimit c) (ψ : ∀ k, ↑(D.obj k) →+ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k') (x : D.obj k), ψ k' ((D.map g).hom x) = ψ k x)
    (k : K) (x : D.obj k) :
    descAdd hc ψ hψ ((c.ι.app k).hom x) = ψ k x :=
  ConcreteCategory.congr_hom ((isColimitForget₂ hc).fac (addCocone ψ hψ) k) x

/-- Two additive maps out of a colimit of rings which agree on every stage are equal. -/
lemma addHom_ext (hc : IsColimit c) {g h : ↑c.pt →+ P}
    (H : ∀ (k : K) (x : D.obj k), g ((c.ι.app k).hom x) = h ((c.ι.app k).hom x)) : g = h := by
  have hgh : AddCommGrpCat.ofHom g = AddCommGrpCat.ofHom h :=
    (isColimitForget₂ hc).hom_ext fun k => by ext x; exact H k x
  exact AddMonoidHom.ext fun x => ConcreteCategory.congr_hom hgh x

/-- **The stages of a colimit of rings generate it additively**: a predicate closed under
zero, addition and negation which holds on the image of every leg holds everywhere. -/
lemma forall_of_forall_ι (hc : IsColimit c) {p : ↑c.pt → Prop} (hzero : p 0)
    (hadd : ∀ x y, p x → p y → p (x + y)) (hneg : ∀ x, p x → p (-x))
    (hι : ∀ (k : K) (x : D.obj k), p ((c.ι.app k).hom x)) (b : ↑c.pt) : p b := by
  let T : AddSubgroup ↑c.pt :=
    { carrier := {x | p x}
      zero_mem' := hzero
      add_mem' := fun ha hb => hadd _ _ ha hb
      neg_mem' := fun ha => hneg _ ha }
  have h0 : QuotientAddGroup.mk' T = (0 : ↑c.pt →+ ↑c.pt ⧸ T) :=
    addHom_ext hc fun k x => by
      rw [AddMonoidHom.zero_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
      exact hι k x
  have hb := DFunLike.congr_fun h0 b
  rwa [AddMonoidHom.zero_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff] at hb

/-- Two additive functions on a colimit of rings which agree on every stage agree everywhere. -/
private lemma eq_of_forall_ι (hc : IsColimit c) {g h : ↑c.pt → P}
    (hg : ∀ x y, g (x + y) = g x + g y) (hh : ∀ x y, h (x + y) = h x + h y)
    (H : ∀ (k : K) (x : D.obj k), g ((c.ι.app k).hom x) = h ((c.ι.app k).hom x)) (b : ↑c.pt) :
    g b = h b :=
  DFunLike.congr_fun (addHom_ext hc (g := AddMonoidHom.mk' g hg) (h := AddMonoidHom.mk' h hh) H) b

end RingColimit

/-! ### Pure tensors and the restriction of scalars -/

section Restrict

variable {A : Type u₁} [Ring A] {B : Type u₂} [Ring B] (f : A →+* B)
  {N : ModuleCat.{u₂} A}

/-- The pure tensor `b ⊗ m` of `B ⊗_A M`, as an element of its restriction of scalars to `A`.
It differs from `objTmul` only by an unfolding of `ModuleCat.restrictScalars`. -/
noncomputable def restrictTmul (b : B) (m : ↑N) :
    ↑((ModuleCat.restrictScalars f).obj ((extendScalars.{u₂} f).obj N)) := tmul f b m

/-- `b ⊗ 0 = 0`. -/
lemma restrictTmul_zero_right (b : B) : restrictTmul f b (0 : ↑N) = 0 := tmul_zero f b

/-- `b ⊗ (m + m') = b ⊗ m + b ⊗ m'`. -/
lemma restrictTmul_add_right (b : B) (m m' : ↑N) :
    restrictTmul f b (m + m') = restrictTmul f b m + restrictTmul f b m' := tmul_add f b m m'

/-- `0 ⊗ m = 0`. -/
lemma restrictTmul_zero_left (m : ↑N) : restrictTmul f (0 : B) m = 0 := zero_tmul f m

/-- `(b + b') ⊗ m = b ⊗ m + b' ⊗ m`. -/
lemma restrictTmul_add_left (b b' : B) (m : ↑N) :
    restrictTmul f (b + b') m = restrictTmul f b m + restrictTmul f b' m := add_tmul f b b' m

/-- `(-b) ⊗ m = -(b ⊗ m)`. -/
lemma restrictTmul_neg_left (b : B) (m : ↑N) : restrictTmul f (-b) m = -restrictTmul f b m :=
  (congrArg (mk f ↑N) (TensorProduct.neg_tmul b m)).trans (map_neg (mk f ↑N) _)

/-- The defining relation of the relative tensor product, in the restricted spelling. -/
lemma restrictTmul_mul_left (b : B) (a : A) (m : ↑N) :
    restrictTmul f (b * f a) m = restrictTmul f b (a • m) := tmul_smul f b a m

/-- Induction on pure tensors, with the carrier read as a restriction of scalars. -/
lemma restrict_induction_on
    {motive : ↑((ModuleCat.restrictScalars f).obj ((extendScalars.{u₂} f).obj N)) → Prop}
    (x : ↑((ModuleCat.restrictScalars f).obj ((extendScalars.{u₂} f).obj N)))
    (zero : motive 0) (pure : ∀ (b : B) (m : ↑N), motive (restrictTmul f b m))
    (add : ∀ u v, motive u → motive v → motive (u + v)) : motive x :=
  induction_on f (motive := motive) x zero pure add

/-- A `σ`-semilinear map read as an `A`-linear map between the restrictions of scalars, when
`σ ∘ f₁ = f₂`. -/
@[ega "II 1.7.2" "partial"]
noncomputable def restrictHom {B₁ B₂ : Type u₂} [Ring B₁] [Ring B₂] {f₁ : A →+* B₁}
    {f₂ : A →+* B₂} {σ : B₁ →+* B₂} (hcomm : ∀ a, σ (f₁ a) = f₂ a)
    {N₁ : ModuleCat.{u₂} B₁} {N₂ : ModuleCat.{u₂} B₂} (φ : ↑N₁ →ₛₗ[σ] ↑N₂) :
    (ModuleCat.restrictScalars f₁).obj N₁ ⟶ (ModuleCat.restrictScalars f₂).obj N₂ :=
  ModuleCat.homEquiv.symm
    { toFun := fun x => (φ x : ↑N₂)
      map_add' := fun x y => map_add φ x y
      map_smul' := fun a x =>
        (map_smulₛₗ φ (f₁ a) x).trans (congrArg (fun r => r • φ x) (hcomm a)) }

/-- Two `A`-linear maps out of the restriction of an extension of scalars agree as soon as they
agree on the pure tensors. -/
lemma restrictExtend_hom_ext {P : ModuleCat.{u₂} A}
    {x y : (ModuleCat.restrictScalars f).obj ((extendScalars.{u₂} f).obj N) ⟶ P}
    (H : ∀ (b : B) (m : ↑N), x (restrictTmul f b m) = y (restrictTmul f b m)) : x = y := by
  refine ModuleCat.hom_ext (LinearMap.ext fun z => ?_)
  refine restrict_induction_on f (motive := fun z => x z = y z) z ?_ H ?_
  · rw [map_zero, map_zero]
  · intro u v hu hv
    rw [map_add, map_add, hu, hv]

end Restrict

/-! ### The defining relations of the relative tensor product -/

section Relations

variable {A : Type u₁} [Ring A] {B : Type u₂} [Ring B] (f : A →+* B) (N : Type v)
  [AddCommGroup N] [Module A N]

/-- **An additive map out of `B ⊗[ℤ] M` which respects the defining relation of the relative
tensor product vanishes on `tensorRel f M`.** No `B`-linearity is needed even though
`tensorRel f M` is a `B`-span: a `B`-multiple of a generator is again a generator, so every
element of the span is already a sum of generators. -/
lemma eq_zero_of_mem_tensorRel {Q : Type*} [AddCommGroup Q] (h : (B ⊗[ℤ] N) →+ Q)
    (H : ∀ (b : B) (a : A) (m : N), h ((b * f a) ⊗ₜ[ℤ] m) = h (b ⊗ₜ[ℤ] (a • m)))
    {x : B ⊗[ℤ] N} (hx : x ∈ tensorRel f N) : h x = 0 := by
  have hx' : x ∈ Submodule.span B
      {y : B ⊗[ℤ] N |
        ∃ (b : B) (a : A) (m : N), y = (b * f a) ⊗ₜ[ℤ] m - b ⊗ₜ[ℤ] (a • m)} := hx
  obtain ⟨n, cf, gf, hsum⟩ := Submodule.mem_span_set'.1 hx'
  rw [← hsum, map_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  obtain ⟨b, a, m, hb⟩ := (gf i).2
  have hstep : cf i • ((gf i : B ⊗[ℤ] N)) =
      (cf i * b * f a) ⊗ₜ[ℤ] m - (cf i * b) ⊗ₜ[ℤ] (a • m) := by
    rw [hb, smul_sub, mul_assoc]
    rfl
  rw [hstep, map_sub, H, sub_self]

end Relations

/-! ### The diagram of base changes and its cocone -/

section BaseChange

variable {A : Type u₁} [Ring A] {K : Type w} [Category.{w'} K] {D : K ⥤ RingCat.{u₂}}
  {c : Cocone D}
  (β : ∀ k, A →+* ↑(D.obj k))
  (hβ : ∀ {k k' : K} (g : k ⟶ k') (a : A), (D.map g).hom (β k a) = β k' a)
  (γ : A →+* ↑c.pt) (hγ : ∀ (k : K) (a : A), (c.ι.app k).hom (β k a) = γ a)
  (M : ModuleCat.{u₂} A)

include hβ in
/-- The transition morphism of the diagram: base change of the identity of `M` along the square
cut out by a map of the diagram of rings. -/
noncomputable def transition {k k' : K} (g : k ⟶ k') :
    (ModuleCat.restrictScalars (β k)).obj ((extendScalars.{u₂} (β k)).obj M) ⟶
      (ModuleCat.restrictScalars (β k')).obj ((extendScalars.{u₂} (β k')).obj M) :=
  restrictHom (hβ g) (squareMap (β k) (β k') (hβ g) LinearMap.id)

/-- The transition morphism along `g : k ⟶ k'` sends `b ⊗ m` to `D.map g b ⊗ m`. -/
lemma transition_restrictTmul {k k' : K} (g : k ⟶ k') (b : ↑(D.obj k)) (m : ↑M) :
    transition β hβ M g (restrictTmul (β k) b m) =
      restrictTmul (β k') ((D.map g).hom b) m := rfl

include hβ in
/-- **The diagram `k ↦ B_k ⊗_A M`**, read as a diagram of `A`-modules by restriction of scalars
along `β k`. -/
@[reducible] noncomputable def diagram : K ⥤ ModuleCat.{u₂} A where
  obj k := (ModuleCat.restrictScalars (β k)).obj ((extendScalars.{u₂} (β k)).obj M)
  map g := transition β hβ M g
  map_id k := restrictExtend_hom_ext (β k) fun b m => by
    rw [transition_restrictTmul, ModuleCat.id_apply, D.map_id k]
    rfl
  map_comp {k _ _} g g' := restrictExtend_hom_ext (β k) fun b m => by
    rw [transition_restrictTmul, ModuleCat.comp_apply, transition_restrictTmul,
      transition_restrictTmul, D.map_comp g g']
    rfl

/-- The map of the diagram along `g : k ⟶ k'` sends `b ⊗ m` to `D.map g b ⊗ m`. -/
lemma diagram_map_restrictTmul {k k' : K} (g : k ⟶ k') (b : ↑(D.obj k)) (m : ↑M) :
    (diagram β hβ M).map g (restrictTmul (β k) b m) =
      restrictTmul (β k') ((D.map g).hom b) m := rfl

include hγ in
/-- The leg at `k` of the cocone: base change of the identity of `M` along the square cut out
by the coprojection `B_k → B`. -/
noncomputable def leg (k : K) :
    (diagram β hβ M).obj k ⟶
      (ModuleCat.restrictScalars γ).obj ((extendScalars.{u₂} γ).obj M) :=
  restrictHom (hγ k) (squareMap (β k) γ (hγ k) LinearMap.id)

/-- The leg at `k` sends `b ⊗ m` to `ι_k(b) ⊗ m`. -/
lemma leg_restrictTmul (k : K) (b : ↑(D.obj k)) (m : ↑M) :
    leg β hβ γ hγ M k (restrictTmul (β k) b m) =
      restrictTmul γ ((c.ι.app k).hom b) m := rfl

include hγ in
/-- **The cocone `k ↦ (B_k ⊗_A M → B ⊗_A M)`** on the diagram of base changes. -/
@[reducible] noncomputable def cocone : Cocone (diagram β hβ M) where
  pt := (ModuleCat.restrictScalars γ).obj ((extendScalars.{u₂} γ).obj M)
  ι :=
    { app := leg β hβ γ hγ M
      naturality := fun {k _} g => by
        have hid : leg β hβ γ hγ M k ≫
            ((Functor.const K).obj ((ModuleCat.restrictScalars γ).obj
              ((extendScalars.{u₂} γ).obj M))).map g = leg β hβ γ hγ M k :=
          Category.comp_id _
        rw [hid]
        refine restrictExtend_hom_ext (β k) fun b m => ?_
        rw [ModuleCat.comp_apply, diagram_map_restrictTmul, leg_restrictTmul,
          leg_restrictTmul]
        exact congrArg (fun r => restrictTmul γ r m)
          (ConcreteCategory.congr_hom (c.w g) b) }

/-- The component of `cocone` at `k` is `leg` at `k`. -/
lemma cocone_ι_app (k : K) :
    (cocone β hβ γ hγ M).ι.app k = leg β hβ γ hγ M k := rfl

end BaseChange

/-! ### The colimiting property -/

section Desc

variable {A : Type u₁} [Ring A] {K : Type w} [Category.{w'} K] {D : K ⥤ RingCat.{u₂}}
  {c : Cocone D} [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})]
  (β : ∀ k, A →+* ↑(D.obj k))
  (hβ : ∀ {k k' : K} (g : k ⟶ k') (a : A), (D.map g).hom (β k a) = β k' a)
  (γ : A →+* ↑c.pt) (hγ : ∀ (k : K) (a : A), (c.ι.app k).hom (β k a) = γ a)
  (M : ModuleCat.{u₂} A) (hc : IsColimit c) (s : Cocone (diagram β hβ M))

/-- The pure tensors of `B_k ⊗_A M`, paired against `M`: an additive map from `B_k` to the
additive maps `M → s.pt`. -/
noncomputable def pairing (k : K) : ↑(D.obj k) →+ (↑M →ₗ[ℤ] ↑s.pt) :=
  AddMonoidHom.mk'
    (fun b => AddMonoidHom.toIntLinearMap
      (AddMonoidHom.mk' (fun m => s.ι.app k (restrictTmul (β k) b m)) fun m m' => by
        change s.ι.app k (restrictTmul (β k) b (m + m')) =
          s.ι.app k (restrictTmul (β k) b m) + s.ι.app k (restrictTmul (β k) b m')
        rw [restrictTmul_add_right, map_add]))
    fun b b' => LinearMap.ext fun m => by
      change s.ι.app k (restrictTmul (β k) (b + b') m) =
        s.ι.app k (restrictTmul (β k) b m) + s.ι.app k (restrictTmul (β k) b' m)
      rw [restrictTmul_add_left, map_add]

omit [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})] in
/-- The pairing at `k` sends `b` and `m` to the image of `b ⊗ m` under the leg of `s` at `k`. -/
lemma pairing_apply (k : K) (b : ↑(D.obj k)) (m : ↑M) :
    pairing β hβ M s k b m = s.ι.app k (restrictTmul (β k) b m) := rfl

omit [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})] in
/-- The `A`-linearity of a cocone leg, read on pure tensors. -/
lemma leg_smul_restrictTmul (k : K) (a : A) (b : ↑(D.obj k)) (m : ↑M) :
    s.ι.app k (restrictTmul (β k) (β k a * b) m) =
      a • s.ι.app k (restrictTmul (β k) b m) :=
  (s.ι.app k).hom.map_smul a (restrictTmul (β k) b m)

omit [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})] in
/-- The pairings of the stages are compatible with the maps of the diagram of rings. -/
lemma pairing_comp {k k' : K} (g : k ⟶ k') (b : ↑(D.obj k)) :
    pairing β hβ M s k' ((D.map g).hom b) = pairing β hβ M s k b := by
  refine LinearMap.ext fun m => ?_
  have hw := ConcreteCategory.congr_hom (s.w g) (restrictTmul (β k) b m)
  rwa [ModuleCat.comp_apply, diagram_map_restrictTmul] at hw

/-- The pairing of the stages, descended to the colimit. -/
noncomputable def descPairing : ↑c.pt →+ (↑M →ₗ[ℤ] ↑s.pt) :=
  descAdd hc (pairing β hβ M s) fun g b => pairing_comp β hβ M s g b

/-- The descended pairing sends `ι_k(b)` and `m` to the image of `b ⊗ m` under the leg of `s`
at `k`. -/
lemma descPairing_ι (k : K) (b : ↑(D.obj k)) (m : ↑M) :
    descPairing β hβ M hc s ((c.ι.app k).hom b) m =
      s.ι.app k (restrictTmul (β k) b m) :=
  (DFunLike.congr_fun
      (descAdd_ι hc (pairing β hβ M s) (fun g b => pairing_comp β hβ M s g b) k b) m).trans
    (pairing_apply β hβ M s k b m)

include hγ in
/-- The descended pairing respects the defining relation of the relative tensor product. -/
lemma descPairing_mul_right (b : ↑c.pt) (a : A) (m : ↑M) :
    descPairing β hβ M hc s (b * γ a) m = descPairing β hβ M hc s b (a • m) := by
  refine eq_of_forall_ι hc
    (g := fun b => descPairing β hβ M hc s (b * γ a) m)
    (h := fun b => descPairing β hβ M hc s b (a • m)) ?_ ?_ ?_ b
  · intro x y
    simp only [add_mul, map_add, LinearMap.add_apply]
  · intro x y
    simp only [map_add, LinearMap.add_apply]
  · intro k x
    rw [← hγ k a, ← map_mul, descPairing_ι, descPairing_ι, restrictTmul_mul_left]

include hγ in
/-- The descended pairing is `A`-semilinear in the ring variable. -/
lemma descPairing_smul (a : A) (b : ↑c.pt) (m : ↑M) :
    descPairing β hβ M hc s (γ a * b) m = a • descPairing β hβ M hc s b m := by
  refine eq_of_forall_ι hc
    (g := fun b => descPairing β hβ M hc s (γ a * b) m)
    (h := fun b => a • descPairing β hβ M hc s b m) ?_ ?_ ?_ b
  · intro x y
    simp only [mul_add, map_add, LinearMap.add_apply]
  · intro x y
    simp only [map_add, LinearMap.add_apply, smul_add]
  · intro k x
    rw [← hγ k a, ← map_mul, descPairing_ι, descPairing_ι]
    exact leg_smul_restrictTmul β hβ M s k a x m

/-- The descended additive map out of `B ⊗[ℤ] M`. -/
noncomputable def descTensor : (↑c.pt ⊗[ℤ] ↑M) →+ ↑s.pt :=
  (TensorProduct.lift (descPairing β hβ M hc s).toIntLinearMap).toAddMonoidHom

/-- `descTensor` sends `b ⊗ m` to the descended pairing of `b` and `m`. -/
lemma descTensor_tmul (b : ↑c.pt) (m : ↑M) :
    descTensor β hβ M hc s (b ⊗ₜ[ℤ] m) = descPairing β hβ M hc s b m := rfl

include hγ in
/-- The descended additive map out of `B ⊗_A M`. -/
noncomputable def descAddHom : BaseChange γ ↑M →+ ↑s.pt :=
  QuotientAddGroup.lift (tensorRel γ ↑M).toAddSubgroup (descTensor β hβ M hc s)
    fun _ hx =>
      eq_zero_of_mem_tensorRel γ ↑M (descTensor β hβ M hc s)
        (fun b a m => descPairing_mul_right β hβ γ hγ M hc s b a m) hx

/-- `descAddHom` sends `b ⊗ m` to the descended pairing of `b` and `m`. -/
lemma descAddHom_tmul (b : ↑c.pt) (m : ↑M) :
    descAddHom β hβ γ hγ M hc s (tmul γ b m) = descPairing β hβ M hc s b m := rfl

include hγ in
/-- `descAddHom` is `A`-linear, for the action of `A` on `B ⊗_A M` through `γ`. -/
lemma descAddHom_smul (a : A) (x : BaseChange γ ↑M) :
    descAddHom β hβ γ hγ M hc s (γ a • x) = a • descAddHom β hβ γ hγ M hc s x := by
  refine induction_on γ
    (motive := fun x => descAddHom β hβ γ hγ M hc s (γ a • x) =
      a • descAddHom β hβ γ hγ M hc s x) x ?_ ?_ ?_
  · rw [smul_zero, map_zero, smul_zero]
  · intro b m
    rw [Stacks.NoncommChangeOfRings.smul_tmul, descAddHom_tmul, descAddHom_tmul]
    exact descPairing_smul β hβ γ hγ M hc s a b m
  · intro y z hy hz
    rw [smul_add, map_add, map_add, hy, hz, smul_add]

include hγ in
/-- The morphism of `A`-modules descending a cocone on the diagram of base changes. -/
noncomputable def descHom : (cocone β hβ γ hγ M).pt ⟶ s.pt :=
  ModuleCat.homEquiv.symm
    { toFun := fun x => descAddHom β hβ γ hγ M hc s x
      map_add' := map_add _
      map_smul' := fun a x => descAddHom_smul β hβ γ hγ M hc s a x }

/-- `descHom` sends `b ⊗ m` to the descended pairing of `b` and `m`. -/
lemma descHom_restrictTmul (b : ↑c.pt) (m : ↑M) :
    descHom β hβ γ hγ M hc s (restrictTmul γ b m) = descPairing β hβ M hc s b m := rfl

end Desc

section IsColimit

variable {A : Type u₁} [Ring A] {K : Type w} [Category.{w'} K] {D : K ⥤ RingCat.{u₂}}
  {c : Cocone D} [PreservesColimitsOfShape K (forget₂ RingCat.{u₂} AddCommGrpCat.{u₂})]
  (β : ∀ k, A →+* ↑(D.obj k))
  (hβ : ∀ {k k' : K} (g : k ⟶ k') (a : A), (D.map g).hom (β k a) = β k' a)
  (γ : A →+* ↑c.pt) (hγ : ∀ (k : K) (a : A), (c.ι.app k).hom (β k a) = γ a)
  (M : ModuleCat.{u₂} A) (hc : IsColimit c)

include hγ in
/-- **Extension of scalars commutes with a colimit of the target ring.** For a ring `A`, an
`A`-module `M` and a diagram of `A`-rings `B_k` whose colimit `B` is computed additively on the
underlying additive groups — in particular for any filtered diagram — the cocone sending a pure
tensor `b ⊗ m` of `B_k ⊗_A M` to `ι_k(b) ⊗ m` in `B ⊗_A M` is a colimit cocone of
`A`-modules. -/
@[ega "IV 8.5.2.1" "more general"]
noncomputable def isColimitCocone : IsColimit (cocone β hβ γ hγ M) where
  desc s := descHom β hβ γ hγ M hc s
  fac s k := restrictExtend_hom_ext (β k) fun b m => by
    rw [ModuleCat.comp_apply, cocone_ι_app, leg_restrictTmul, descHom_restrictTmul,
      descPairing_ι]
  uniq s φ hφ := restrictExtend_hom_ext γ fun b x => by
    refine forall_of_forall_ι hc
      (p := fun b => φ (restrictTmul γ b x) =
        descHom β hβ γ hγ M hc s (restrictTmul γ b x)) ?_ ?_ ?_ ?_ b
    · rw [restrictTmul_zero_left, map_zero, map_zero]
    · intro y z hy hz
      rw [restrictTmul_add_left, map_add, map_add, hy, hz]
    · intro y hy
      rw [restrictTmul_neg_left, map_neg, map_neg, hy]
    · intro k y
      have h := ConcreteCategory.congr_hom (hφ k) (restrictTmul (β k) y x)
      rw [ModuleCat.comp_apply] at h
      rw [descHom_restrictTmul, descPairing_ι]
      exact h

/-- A compatible family of `A`-linear maps out of the base changes, as a cocone on the diagram
of base changes. -/
noncomputable def coconeOfFamily {P : ModuleCat.{u₂} A} (ψ : ∀ k, (diagram β hβ M).obj k ⟶ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k'), (diagram β hβ M).map g ≫ ψ k' = ψ k) :
    Cocone (diagram β hβ M) where
  pt := P
  ι :=
    { app := ψ
      naturality := fun {_ _} g => (hψ g).trans (Category.comp_id _).symm }

include hγ in
/-- **The descent of a compatible family of `A`-linear maps out of the base changes.** -/
noncomputable def descOfFamily (hc : IsColimit c) {P : ModuleCat.{u₂} A}
    (ψ : ∀ k, (diagram β hβ M).obj k ⟶ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k'), (diagram β hβ M).map g ≫ ψ k' = ψ k) :
    (cocone β hβ γ hγ M).pt ⟶ P :=
  (isColimitCocone β hβ γ hγ M hc).desc (coconeOfFamily β hβ M ψ hψ)

include hγ in
/-- The descent of a compatible family `ψ`, composed with the leg at `k`, is `ψ k`. -/
lemma leg_comp_descOfFamily (hc : IsColimit c) {P : ModuleCat.{u₂} A}
    (ψ : ∀ k, (diagram β hβ M).obj k ⟶ P)
    (hψ : ∀ {k k' : K} (g : k ⟶ k'), (diagram β hβ M).map g ≫ ψ k' = ψ k) (k : K) :
    leg β hβ γ hγ M k ≫ descOfFamily β hβ γ hγ M hc ψ hψ = ψ k :=
  (isColimitCocone β hβ γ hγ M hc).fac (coconeOfFamily β hβ M ψ hψ) k

include hγ in
/-- Two `A`-linear maps out of `B ⊗_A M` which agree after every leg are equal. -/
lemma hom_ext_of_leg (hc : IsColimit c) {P : ModuleCat.{u₂} A}
    {x y : (cocone β hβ γ hγ M).pt ⟶ P}
    (H : ∀ k, leg β hβ γ hγ M k ≫ x = leg β hβ γ hγ M k ≫ y) : x = y :=
  (isColimitCocone β hβ γ hγ M hc).hom_ext H

end IsColimit

end Stacks.NoncommChangeOfRings.Colimit

end
