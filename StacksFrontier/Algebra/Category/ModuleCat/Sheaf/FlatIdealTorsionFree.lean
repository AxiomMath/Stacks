module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafQuasiIso
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatOpenRestriction
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.IdealGeneratedByNonzerodivisor
import StacksCore.Tactic.StacksAttribute

/-!
# A flat sheaf of modules is ideal-torsion-free

Let `(X, O_X)` be a ringed space and `ι : I ⟶ O_X` a sheaf of ideals locally generated by a
section which is a nonzerodivisor on `O_X`. Then every flat sheaf of `O_X`-modules `F` satisfies
`F[I] = 0`. Stalkwise, every generator of `I_x` is a nonzerodivisor of `O_{X,x}`, and a
nonzerodivisor acts injectively on a flat module.

## Main results

* `Stacks.IdealTorsion.germ_mem_nonZeroDivisors`: the germ of a local generator which is a
  nonzerodivisor on the structure sheaf is a nonzerodivisor in the stalk.
* `Stacks.IdealTorsion.stalkGenerator_mem_nonZeroDivisors`: every generator of the stalk ideal
  is a nonzerodivisor in the stalk.
* `Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat`: a flat sheaf of modules is
  `I`-torsion free.

## Implementation notes

The argument runs through the stalkwise characterization of Tag 0GT5. The module structure on
the stalk of a sheaf of modules appears under two names — Mathlib's instance on a colimit of
modules, and `Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule`, the one the stalkwise
characterization is stated with — which agree by definition (`stalkModule_eq`).

That a generator of the stalk ideal is a nonzerodivisor needs no stalkwise form of the
hypothesis on the ideal: it is enough that the germ of one regular local generator is a
nonzerodivisor, which is a filtered-colimit argument on germs, together with the fact that every
generator of the stalk ideal divides it.

## References

* [Stacks Project, Tag 0GT5](https://stacks.math.columbia.edu/tag/0GT5)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
-/

@[expose] public section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.SheafOfModules.TensorStalkRingedSpace
  (O ringStalk grpStalk ringGerm grpGerm stalkModule stalkModule_germ_smul)

universe u

namespace Stacks.IdealTorsion

section

variable (X : RingedSpace.{u})

local notation "Oₓ" => structureSheafRing X
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- Regularity of a local generator on the structure sheaf, read as cancellation in the ring of
sections. -/
private lemma eq_zero_of_reg {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    {U : Opens X} {f : I.val.obj (op U)} (hreg : IsGeneratorRegularOn X i 𝒪 U f)
    (V : Opens X) (hVU : V ≤ U) (c : (O X).obj (op V))
    (hc : c * idealSection X i (op V) ((I.val.map (homOfLE hVU).op).hom f) = 0) : c = 0 := by
  refine hreg V hVU (a₁ := c) (a₂ := 0) ?_
  simp only [smul_zero]
  change idealSection X i (op V) ((I.val.map (homOfLE hVU).op).hom f) * c = 0
  rw [mul_comm]
  exact hc

/-- The germ at `x` of a local generator of the ideal which is a nonzerodivisor on the structure
sheaf is a nonzerodivisor in the stalk `O_{X,x}`: a relation between germs is a relation between
sections on a smaller neighbourhood, where regularity applies. -/
public lemma germ_mem_nonZeroDivisors {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    {U : Opens X} {f : I.val.obj (op U)} (hreg : IsGeneratorRegularOn X i 𝒪 U f)
    (x : X) (hxU : x ∈ U) :
    ringGerm X x U hxU (idealSection X i (op U) f) ∈ nonZeroDivisors (ringStalk X x) := by
  have key : ∀ a : ringStalk X x,
      a * ringGerm X x U hxU (idealSection X i (op U) f) = 0 → a = 0 := by
    intro a ha
    obtain ⟨V, hVU, hxV, s, hs⟩ := X.presheaf.exists_le_germ_eq a hxU
    set gV : X.presheaf.obj (op V) :=
      (X.presheaf.map (homOfLE hVU).op).hom (idealSection X i (op U) f) with hgVdef
    have hs' : ringGerm X x V hxV s = a := hs
    have hgerm : ringGerm X x V hxV gV = ringGerm X x U hxU (idealSection X i (op U) f) :=
      X.presheaf.germ_res_apply (homOfLE hVU) x hxV _
    have ha'' : ringGerm X x V hxV (s * gV) = ringGerm X x V hxV 0 := by
      rw [map_zero, map_mul, hs', hgerm]
      exact ha
    obtain ⟨W, hxW, iW, iW', e⟩ := X.presheaf.germ_eq x hxV hxV _ _ ha''
    have hWV : W ≤ V := iW.le
    have hWU : W ≤ U := hWV.trans hVU
    have hzero : (X.presheaf.map (homOfLE hWV).op).hom (s * gV) = 0 := by
      have h1 : (X.presheaf.map iW.op).hom (s * gV) = 0 := by rw [e, map_zero]
      have h2 : iW = homOfLE hWV := Subsingleton.elim _ _
      rw [← h2]
      exact h1
    have hcomp : (X.presheaf.map (homOfLE hWV).op).hom gV
        = (X.presheaf.map (homOfLE hWU).op).hom (idealSection X i (op U) f) := by
      rw [hgVdef, ← ConcreteCategory.comp_apply, ← CategoryTheory.Functor.map_comp]
      rfl
    have hres : idealSection X i (op W) ((I.val.map (homOfLE hWU).op).hom f)
        = (X.presheaf.map (homOfLE hWV).op).hom gV := by
      rw [hcomp]
      exact Stacks.IdealTorsion.idealSection_naturality X i (homOfLE hWU).op f
    have hsW : (X.presheaf.map (homOfLE hWV).op).hom s = 0 := by
      refine eq_zero_of_reg X i hreg W hWU _ ?_
      rw [hres, ← map_mul]
      exact hzero
    have hfin : ringGerm X x W hxW ((X.presheaf.map (homOfLE hWV).op).hom s)
        = ringGerm X x V hxV s :=
      X.presheaf.germ_res_apply (homOfLE hWV) x hxW s
    rw [← hs', ← hfin, hsW, map_zero]
  exact mem_nonZeroDivisors_iff_right.2 key

/-- Every generator of the stalk ideal `I_x` is a nonzerodivisor of `O_{X,x}`: it divides the
germ of a regular local generator, which is a nonzerodivisor. -/
public lemma stalkGenerator_mem_nonZeroDivisors {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (hregl : IsLocallyGeneratedByRegular X ι) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) : f ∈ nonZeroDivisors (ringStalk X x) := by
  obtain ⟨U, hxU, g, _, hreg⟩ := hregl x
  have hgx : ringGerm X x U hxU (idealSection X ι (op U) g) ∈ nonZeroDivisors (ringStalk X x) :=
    germ_mem_nonZeroDivisors X ι hreg x hxU
  obtain ⟨r, hr⟩ := hf.2 (ringGerm X x U hxU (idealSection X ι (op U) g)) ⟨U, hxU, g, rfl⟩
  have key : ∀ a : ringStalk X x, a * f = 0 → a = 0 := by
    intro a ha
    refine (mem_nonZeroDivisors_iff.1 hgx).2 a ?_
    rw [hr, mul_comm r f, ← mul_assoc, ha, zero_mul]
  exact mem_nonZeroDivisors_iff_right.2 key

/-- The two names for the module structure on the stalk of a sheaf of modules — Mathlib's on a
colimit of modules, and `stalkModule` — agree by definition. -/
public lemma stalkModule_eq (F : PresheafOfModules.{u} (O X)) (x : X.carrier) :
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) F x = stalkModule X F x :=
  rfl

/-- Flatness depends on a module structure only through its value, so it transports along an
equality of module structures. -/
private lemma flat_of_eq_module {R : Type u} [CommSemiring R] {M : Type u} [AddCommMonoid M]
    {i₁ i₂ : Module R M} (h : i₁ = i₂) (hf : @Module.Flat R M _ _ i₁) :
    @Module.Flat R M _ _ i₂ := h ▸ hf

/-- A flat sheaf of modules has flat stalks, in the germ-representative spelling of the stalk
module structure. -/
public lemma stalk_flat_of_isFlat (F : SheafOfModules.{u} Oₓ)
    (hF : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.sheaf) F)
    (x : X.carrier) : Module.Flat (ringStalk X x) (grpStalk X F.val x) :=
  flat_of_eq_module (stalkModule_eq X F.val x)
    ((AlgebraicGeometry.SheafOfModules.isFlat_iff_stalk_flat X.sheaf F).1 hF x)

/-- On a flat sheaf of modules every generator of the stalk ideal acts injectively: it is a
nonzerodivisor of `O_{X,x}` and the stalk is a flat `O_{X,x}`-module. -/
public lemma isStalkwiseGeneratorRegular_of_isFlat {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (hregl : IsLocallyGeneratedByRegular X ι) (F : SheafOfModules.{u} Oₓ)
    (hF : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.sheaf) F) :
    IsStalkwiseGeneratorRegular X ι F := by
  intro x f hf
  have : Module.Flat (ringStalk X x) (grpStalk X F.val x) := stalk_flat_of_isFlat X F hF x
  exact Module.Flat.isSMulRegular_of_nonZeroDivisors
    (stalkGenerator_mem_nonZeroDivisors X ι hregl x f hf)

/-- **A flat sheaf of modules is ideal-torsion-free.** For an ideal sheaf locally generated by a
nonzerodivisor, a flat `O_X`-module `F` has `F[I] = 0`: stalkwise a generator of `I_x` is a
nonzerodivisor of `O_{X,x}`, hence acts injectively on the flat stalk `F_x`. -/
public theorem isIdealTorsionFree_of_isFlat (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι) (F : SheafOfModules.{u} Oₓ)
    (hF : AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.sheaf) F) :
    IsIdealTorsionFree X ι F := by
  have : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank
      (C := Opens X) (J := Opens.grothendieckTopology X) I 1 :=
    isFiniteLocallyFreeOfRank_one_of_isLocallyGeneratedByRegular X ι hregl
  exact ((idealTorsionFree_tfae X ι F).out 5 1).1
    (isStalkwiseGeneratorRegular_of_isFlat X ι hregl F hF)

end

end Stacks.IdealTorsion

end
