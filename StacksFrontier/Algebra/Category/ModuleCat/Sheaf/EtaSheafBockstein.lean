/-! ### Successive quotients of two composable monomorphisms -/

section Abstract

variable {A : Type u₁} [Category.{v₁} A] [Abelian A]

/-- The map `coker a ⟶ coker (a ≫ b)` induced by `b`. -/
public noncomputable abbrev quotientIncl {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁) :
    cokernel a ⟶ cokernel (a ≫ b) :=
  cokernel.desc a (b ≫ cokernel.π (a ≫ b))
    (by simpa only [← Category.assoc] using cokernel.condition (a ≫ b))

/-- The map `coker (a ≫ b) ⟶ coker b` induced by the identity of the common target of `b`. -/
public noncomputable abbrev quotientProj {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁) :
    cokernel (a ≫ b) ⟶ cokernel b :=
  cokernel.desc (a ≫ b) (cokernel.π b) (by simp [Category.assoc, cokernel.condition])

/-- The sequence `coker a → coker (a ≫ b) → coker b` of successive quotients, as a complex. -/
public noncomputable abbrev quotientShortComplex {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁) :
    ShortComplex A :=
  ShortComplex.mk (quotientIncl a b) (quotientProj a b) (by
    apply (cancel_epi (cokernel.π a)).1
    simp [quotientIncl, quotientProj, Category.assoc])

/-- **The successive-quotient sequence of two monomorphisms is short exact.** It is the middle
part of the kernel-cokernel sequence of `a` and `b`, whose two outer terms are the kernels
of `b` and of `a ≫ b` and therefore vanish. -/
public theorem quotientShortComplex_shortExact {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁)
    [Mono a] [Mono b] : (quotientShortComplex a b).ShortExact := by
  let f := quotientIncl a b
  let g := quotientProj a b
  let E := kernelCokernelCompSequence a b
  have hE : E.Exact := kernelCokernelCompSequence_exact a b
  have hmid : (ShortComplex.mk (E.map' 2 3) (E.map' 3 4)
      (by simpa using hE.toIsComplex.zero' 2 3 4)).Exact := hE.exact' 2 3 4
  have hm : Mono (E.map' 3 4) :=
    (ShortComplex.exact_iff_mono _ ((isZero_kernel_of_mono b).eq_of_src _ _)).1 hmid
  have hmid' : (ShortComplex.mk (E.map' 3 4) (E.map' 4 5)
      (by simpa using hE.toIsComplex.zero' 3 4 5)).Exact := hE.exact' 3 4 5
  have hf : E.map' 3 4 = f := by
    apply (cancel_epi (cokernel.π a)).1
    dsimp [E, f, quotientIncl, kernelCokernelCompSequence, ComposableArrows.Precomp.map]
  have hg : E.map' 4 5 = g := by
    apply (cancel_epi (cokernel.π (a ≫ b))).1
    dsimp [E, g, quotientProj, kernelCokernelCompSequence, ComposableArrows.Precomp.map]
    simp
  have hm' : Mono f := hf ▸ hm
  have hepi' : Epi g := by
    rw [← hg]
    infer_instance
  have hExact : (ShortComplex.mk f g (by
      apply (cancel_epi (cokernel.π a)).1
      simp [f, g, quotientIncl, quotientProj, Category.assoc])).Exact := by
    simpa only [← hf, ← hg] using hmid'
  exact ShortComplex.ShortExact.mk' hExact hm' hepi'

/-- The short exact sequence `0 → A₂ → A₁ → coker b → 0` attached to a monomorphism `b`. -/
private noncomputable abbrev monoShortComplex {A₁ A₂ : A} (b : A₂ ⟶ A₁) : ShortComplex A :=
  ShortComplex.mk b (cokernel.π b) (cokernel.condition b)

private theorem monoShortComplex_shortExact {A₁ A₂ : A} (b : A₂ ⟶ A₁) [Mono b] :
    (monoShortComplex b).ShortExact :=
  ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel b) inferInstance inferInstance

/-- The map of short exact sequences from `0 → A₂ → A₁ → coker b → 0` to the
successive-quotient sequence of `a` and `b`, given by the three cokernel projections. -/
private noncomputable def monoToQuotient {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁) :
    monoShortComplex b ⟶ quotientShortComplex a b where
  τ₁ := cokernel.π a
  τ₂ := cokernel.π (a ≫ b)
  τ₃ := 𝟙 _
  comm₁₂ := by simp only [quotientIncl, cokernel.π_desc]
  comm₂₃ := by simp only [quotientProj, cokernel.π_desc, Category.comp_id]

end Abstract

/-! ### The connecting maps of the successive-quotient sequences square to zero -/

section AbstractDerived

variable {A : Type u₁} [Category.{v₁} A] [Abelian A] [HasDerivedCategory.{w} A]
  (G : DerivedCategory A ⥤ DerivedCategory A) [G.CommShift ℤ]

/-- The connecting map of the successive-quotient sequence of `a` and `b` factors through the
map induced by `coker.π a`, by naturality of the homology sequence along `monoToQuotient`. -/
private theorem delta_quotientShortComplex {A₁ A₂ A₃ : A} (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁)
    [Mono a] [Mono b] (i : ℤ) :
    DerivedCategory.HomologySequence.δ
        (G.mapTriangle.obj (quotientShortComplex_shortExact a b).singleTriangle) i (i + 1) rfl =
      DerivedCategory.HomologySequence.δ
          (G.mapTriangle.obj (monoShortComplex_shortExact b).singleTriangle) i (i + 1) rfl ≫
        (DerivedCategory.homologyFunctor A (i + 1)).map
          (G.map ((DerivedCategory.singleFunctor A 0).map (cokernel.π a))) := by
  have hnat := (DerivedCategory.homologyFunctor A 0).homologySequenceδ_naturality
    (G.mapTriangle.map (ShortComplex.ShortExact.singleTriangle.map
      (monoShortComplex_shortExact b) (quotientShortComplex_shortExact a b) (monoToQuotient a b)))
    i (i + 1) rfl
  have h₃ : (G.mapTriangle.map (ShortComplex.ShortExact.singleTriangle.map
      (monoShortComplex_shortExact b) (quotientShortComplex_shortExact a b)
      (monoToQuotient a b))).hom₃ =
      𝟙 (G.obj ((DerivedCategory.singleFunctor A 0).obj (cokernel b))) := by
    change G.map ((DerivedCategory.singleFunctor A 0).map (𝟙 (cokernel b))) = _
    rw [CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
  have hm : ((DerivedCategory.homologyFunctor A 0).shift i).map
      (G.mapTriangle.map (ShortComplex.ShortExact.singleTriangle.map
        (monoShortComplex_shortExact b) (quotientShortComplex_shortExact a b)
        (monoToQuotient a b))).hom₃ = 𝟙 _ := by
    rw [h₃]
    exact CategoryTheory.Functor.map_id _ _
  rw [hm] at hnat
  exact (Category.id_comp _).symm.trans hnat

/-- **Consecutive connecting maps of the successive-quotient sequences of a chain of three
monomorphisms compose to zero.** The first factors through the map induced by `coker.π a`,
which factors through the surjection `coker (c ≫ a) ⟶ coker a`, and the second annihilates the
image of the second map of its own triangle. -/
private theorem delta_comp_delta [G.IsTriangulated] {A₁ A₂ A₃ A₄ : A} (c : A₄ ⟶ A₃)
    (a : A₃ ⟶ A₂) (b : A₂ ⟶ A₁) [Mono c] [Mono a] [Mono b] (i : ℤ) :
    DerivedCategory.HomologySequence.δ
        (G.mapTriangle.obj (quotientShortComplex_shortExact a b).singleTriangle) i (i + 1) rfl ≫
      DerivedCategory.HomologySequence.δ
        (G.mapTriangle.obj (quotientShortComplex_shortExact c a).singleTriangle)
          (i + 1) (i + 1 + 1) rfl = 0 := by
  have hzero : (DerivedCategory.homologyFunctor A (i + 1)).map
        (G.map ((DerivedCategory.singleFunctor A 0).map (quotientProj c a))) ≫
      DerivedCategory.HomologySequence.δ
        (G.mapTriangle.obj (quotientShortComplex_shortExact c a).singleTriangle)
          (i + 1) (i + 1 + 1) rfl = 0 :=
    DerivedCategory.HomologySequence.comp_δ
      (G.mapTriangle.obj (quotientShortComplex_shortExact c a).singleTriangle)
      (G.map_distinguished _ (quotientShortComplex_shortExact c a).singleTriangle_distinguished)
      (i + 1) (i + 1 + 1) rfl
  have hmap : (DerivedCategory.homologyFunctor A (i + 1)).map
        (G.map ((DerivedCategory.singleFunctor A 0).map (cokernel.π (c ≫ a)))) ≫
      (DerivedCategory.homologyFunctor A (i + 1)).map
        (G.map ((DerivedCategory.singleFunctor A 0).map (quotientProj c a))) =
      (DerivedCategory.homologyFunctor A (i + 1)).map
        (G.map ((DerivedCategory.singleFunctor A 0).map (cokernel.π a))) := by
    rw [← CategoryTheory.Functor.map_comp, ← G.map_comp, ← CategoryTheory.Functor.map_comp,
      show cokernel.π (c ≫ a) ≫ quotientProj c a = cokernel.π a from by
        simp only [quotientProj, cokernel.π_desc]]
  have key : (DerivedCategory.homologyFunctor A (i + 1)).map
        (G.map ((DerivedCategory.singleFunctor A 0).map (cokernel.π a))) ≫
      DerivedCategory.HomologySequence.δ
        (G.mapTriangle.obj (quotientShortComplex_shortExact c a).singleTriangle)
          (i + 1) (i + 1 + 1) rfl = 0 := by
    rw [← hmap]
    exact (Category.assoc _ _ _).trans ((congrArg _ hzero).trans comp_zero)
  exact (congrArg (· ≫ DerivedCategory.HomologySequence.δ
      (G.mapTriangle.obj (quotientShortComplex_shortExact c a).singleTriangle)
        (i + 1) (i + 1 + 1) rfl) (delta_quotientShortComplex G a b i)).trans
    ((Category.assoc _ _ _).trans ((congrArg _ key).trans comp_zero))

end AbstractDerived

/-! ### The Bockstein complex -/

/-- A functor that is an equivalence preserves monomorphisms: its counit expresses every object
of the target as an image, and it is full and faithful, so a test pair of morphisms into
`F.obj Y` comes from a test pair for `f`. -/
private theorem mono_map_of_isEquivalence {C : Type u₁} {D : Type u₂} [Category.{v₁} C]
    [Category.{v₂} D] (F : C ⥤ D) [F.IsEquivalence] {Y Z : C} (f : Y ⟶ Z) (hf : Mono f) :
    Mono (F.map f) := by
  have := hf
  exact F.map_mono f

variable (X : RingedSpace.{u, u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- On the structure sheaf the ideal-power transition `I^{⊗ (n+1)} ⟶ I^{⊗ n}` is the image of
`ι` under the tensor autoequivalence of the invertible sheaf `I^{⊗ n}`, hence a
monomorphism.

This is the companion of `Eta.idealPowerIncl_mono`, which asks for `I`-torsion-freeness of the
module: at the structure sheaf invertibility of `I` alone suffices, because the transition is
then the image of a monomorphism under an equivalence.  Public because
`EtaSheafPowerQuotientResolution.lean` needs exactly this form — the mono of the short exact
sequence `0 → I^{n+1} → I^n → I^n/I^{n+1} → 0` — and the only other inhabitant of the
torsion-freeness binder at `𝒪`, `Reduction.isIdealTorsionFree_unit`, carries a hypothesis on the
structure-sheaf stalks that Situation 0GT4 does not have. -/
public theorem idealPowerIncl_mono
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (n : ℤ) : Mono (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι n 𝒪) := by
  let P := tensorPower X.sheaf.obj ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I n
  have hPinv' : Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property P :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry _ _ _
      (tensorPower_isInvertible X.sheaf.obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I n)
  let F := (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).obj P
  have hFeq : F.IsEquivalence :=
    Stacks.SheafOfModules.tensorLeftFunctor_isEquivalence X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property P
  have hTeq : ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      X.sheaf).flip.obj I).IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I
  let c := F.map ι
  have hc : Mono c := mono_map_of_isEquivalence F ι inferInstance
  have tensorMap : (Functor.uncurry.obj
      (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf)).map
        (X := (P, I)) (Y := (P, 𝒪)) (𝟙 P, ι) = c :=
    (congrArg (fun transformation => transformation.app I ≫ c)
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf).map_id P)).trans
        (Category.id_comp c)
  have h₁ : Mono (powSuccIso
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
        X.sheaf).flip.obj I).asEquivalence n 𝒪).inv := inferInstance
  have h₂ : Mono (tensorProductRightUnitor X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property P).hom :=
    @IsIso.mono_of_iso _ _ _ _
      (tensorProductRightUnitor X.sheaf.obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property P).hom
      (tensorProductRightUnitor X.sheaf.obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property P).isIso_hom
  exact @mono_comp' (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
    _ _ _ _ _ _ h₁
    (@mono_comp' (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
      _ _ _ _ _ _ (tensorMap.symm ▸ hc) h₂)

/-- The quotient `I^i/I^{i+1}` of consecutive integer powers of the invertible ideal `I`. -/
public noncomputable abbrev powerQuotient
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (i : ℤ) : SheafOfModules.{u} Oₓ :=
  cokernel (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι i 𝒪)

/-- The sequence `I^{i+1}/I^{i+2} → I^i/I^{i+2} → I^i/I^{i+1}` of successive power quotients,
as a complex. -/
public noncomputable abbrev powerQuotientShortComplex
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (i : ℤ) : ShortComplex (SheafOfModules.{u} Oₓ) :=
  quotientShortComplex (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι (i + 1) 𝒪)
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι i 𝒪)

/-- **The successive-power quotient sequence is short exact:**
`0 → I^{i+1}/I^{i+2} → I^i/I^{i+2} → I^i/I^{i+1} → 0`. -/
public theorem powerQuotientShortExact
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (i : ℤ) : (powerQuotientShortComplex X I ι i).ShortExact :=
  @quotientShortComplex_shortExact (SheafOfModules.{u} Oₓ) inferInstance inferInstance _ _ _
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι (i + 1) 𝒪)
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι i 𝒪)
    (idealPowerIncl_mono X I ι (i + 1)) (idealPowerIncl_mono X I ι i)

/-- The `i`-th term `H^i(M ⊗^L I^i/I^{i+1})` of the Bockstein complex. -/
public noncomputable abbrev bocksteinTerm [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) (i : ℤ) : SheafOfModules.{u} Oₓ :=
  (DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) i).obj
    (((canonicalDerivedTensorProduct X.sheaf).tensor.obj M).obj
      ((DerivedCategory.singleFunctor (SheafOfModules.{u} Oₓ) 0).obj (powerQuotient X I ι i)))

/-- **The Bockstein operator**
`β^i : H^i(M ⊗^L I^i/I^{i+1}) ⟶ H^{i+1}(M ⊗^L I^{i+1}/I^{i+2})`, the connecting map of the
long exact cohomology-sheaf sequence of the triangle obtained by applying `M ⊗^L -` to the
successive-power quotient sequence. -/
public noncomputable def bocksteinOperator [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) (i : ℤ) :
    bocksteinTerm X I ι M i ⟶ bocksteinTerm X I ι M (i + 1) :=
  letI := (canonicalDerivedTensorProduct X.sheaf).commShift_right M
  DerivedCategory.HomologySequence.δ
    (((canonicalDerivedTensorProduct X.sheaf).tensor.obj M).mapTriangle.obj
      (powerQuotientShortExact X I ι i).singleTriangle) i (i + 1) rfl

/-- **Stacks Project, Tag 0GT8.** Consecutive Bockstein operators compose to zero,
`β^{i+1} ∘ β^i = 0`. -/
@[stacks 0GT8 "square-zero Bockstein maps"]
public theorem bockstein_comp_bockstein [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) (i : ℤ) :
    bocksteinOperator X I ι M i ≫ bocksteinOperator X I ι M (i + 1) = 0 :=
  have _h₁ := idealPowerIncl_mono X I ι i
  have _h₂ := idealPowerIncl_mono X I ι (i + 1)
  have _h₃ := idealPowerIncl_mono X I ι (i + 1 + 1)
  let := (canonicalDerivedTensorProduct X.sheaf).commShift_right M
  let := (canonicalDerivedTensorProduct X.sheaf).exact_right M
  @delta_comp_delta _ _ _ _ ((canonicalDerivedTensorProduct X.sheaf).tensor.obj M) _ _
    _ _ _ _
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι (i + 1 + 1) 𝒪)
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι (i + 1) 𝒪)
    (Stacks.IdealTorsion.Eta.idealPowerIncl X I ι i 𝒪) _h₃ _h₂ _h₁ i

/-- **Stacks Project, Tag 0GT8.** The Bockstein complex `H^•(M/I)` of an object `M` of
`D(O_X)`: the integer-indexed complex whose `i`-th term is `H^i(M ⊗^L I^i/I^{i+1})` and whose
differentials are the Bockstein operators. -/
@[stacks 0GT8 "the Bockstein complex"]
public noncomputable def bocksteinComplex [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) : CochainComplex (SheafOfModules.{u} Oₓ) ℤ :=
  CochainComplex.of (bocksteinTerm X I ι M) (bocksteinOperator X I ι M)
    (bockstein_comp_bockstein X I ι M)

/-- The terms of the Bockstein complex are the cohomology sheaves `H^i(M ⊗^L I^i/I^{i+1})`. -/
@[simp] public theorem bocksteinComplex_X [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) (i : ℤ) :
    (bocksteinComplex X I ι M).X i = bocksteinTerm X I ι M i := rfl

/-- The differentials of the Bockstein complex are the Bockstein operators. -/
public theorem bocksteinComplex_d [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) (i : ℤ) :
    (bocksteinComplex X I ι M).d i (i + 1) = bocksteinOperator X I ι M i := by
  simp only [bocksteinComplex, CochainComplex.of_d]

end Stacks.IdealTorsion.Bockstein

end
