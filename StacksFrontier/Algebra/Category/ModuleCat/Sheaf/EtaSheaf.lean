open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

open Stacks.SheafOfModules.TensorStalkRingedSpace
    (ringStalk grpStalk ringGerm grpGerm stalkMapL tensorStalkIso tensorStalkIso_germ
      tensorStalkIso_natural toTensorSheafSection stalkModule_germ_smul)

open Stacks.SheafOfModules.Invertible ( tensorRightFunctor_isEquivalence
  tensorPowerEquivalence powSuccIso powSuccIso_natural
  tensorProductRightUnitor)

universe u v w

namespace Stacks.IdealTorsion.Eta

variable (X : RingedSpace.{u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))
local notation "𝒪" => SheafOfModules.unit Oₓ

-- No bridging instance between the `Stacks` spelling of Tag 01CS and the `AlgebraicGeometry`
-- one used by Tag 01CU's tensor-power calculus: `AlgebraicGeometry.SheafOfModules.IsInvertible`
-- abbreviates `Stacks.SheafOfModules.IsInvertible`
-- (`StacksFrontier/Topology/Sheaves/Modules/Invertible.lean`), and an instance converting the class
-- to itself is a self-loop that makes instance search fail rather than succeed.

/-- The `n`-th invertible ideal power acting on a module. -/
public noncomputable abbrev idealPowerTerm
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (n : ℤ) (M : SheafOfModules.{u} Oₓ) : SheafOfModules.{u} Oₓ :=
  (tensorPowerEquivalence X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
        n).functor.obj M

/-- The inclusion from the next ideal power, induced by the ideal inclusion. -/
public noncomputable def idealPowerIncl
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (n : ℤ) (M : SheafOfModules.{u} Oₓ) :
    idealPowerTerm X I (n + 1) M ⟶ idealPowerTerm X I n M := by
  letI : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).IsEquivalence :=
      tensorRightFunctor_isEquivalence X.sheaf.obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
  let P : SheafOfModules.{u} Oₓ := idealPowerTerm X I n M
  let c : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj P).obj I ⟶
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj P).obj 𝒪 :=
    ((Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))).map
      (X := (P, I)) (Y := (P, 𝒪)) (𝟙 P, ι)
  exact (powSuccIso
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).asEquivalence n M).inv ≫
    c ≫ (tensorProductRightUnitor X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property P).hom

/-- The `n`-th ideal-power action on a morphism of module sheaves. -/
public noncomputable def idealPowerMap
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (n : ℤ) {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N) :
    idealPowerTerm X I n M ⟶ idealPowerTerm X I n N :=
  (tensorPowerEquivalence X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
        n).functor.map a

/-- Twisting by an ideal power sends a composite to the composite of the twists. -/
lemma idealPowerMap_comp
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    {M N P : SheafOfModules.{u} Oₓ} (n : ℤ)
    (a : M ⟶ N) (b : N ⟶ P) :
    idealPowerMap X I n (a ≫ b) =
      idealPowerMap X I n a ≫ idealPowerMap X I n b :=
  Functor.map_comp
      (tensorPowerEquivalence X.sheaf.obj
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
            n).functor a b

/-- Twisting by an ideal power sends an identity to an identity. -/
lemma idealPowerMap_id
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (n : ℤ) (M : SheafOfModules.{u} Oₓ) :
    idealPowerMap X I n (𝟙 M) = 𝟙 (idealPowerTerm X I n M) :=
  CategoryTheory.Functor.map_id
    (tensorPowerEquivalence X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
          n).functor M

open MonoidalCategory in
/-- **The right unit constraint of the tensor product of sheaves of modules is natural.**
Tensoring a morphism `a : M ⟶ N` with the identity of the structure sheaf and then contracting
is contracting and then applying `a`. -/
theorem tensorProductRightUnitor_naturality
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (O : Cᵒᵖ ⥤ CommRingCat.{w})
    (hO : Presheaf.IsSheaf J (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf O))
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [HasWeakSheafify J AddCommGrpCat.{w}]
    {M N : SheafOfModules.{w}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO⟩))} (a : M ⟶ N) :
    ((Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, w, w, w}
      ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO⟩))).map
        (X := (M, SheafOfModules.unit _)) (Y := (N, SheafOfModules.unit _))
        (a, 𝟙 _) ≫ (tensorProductRightUnitor O hO N).hom =
      (tensorProductRightUnitor O hO M).hom ≫ a := by
  let S := (PresheafOfModules.sheafification.{w}
      (R := (Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk O
          (Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO))))
            (𝟙 ((Stacks.SheafOfModules.Tensor.ringSheaf
              (CategoryTheory.ObjectProperty.FullSubcategory.mk O
                (Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO)))).obj))
  let adj := (PresheafOfModules.sheafificationAdjunction.{w}
      (R := (Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk O
          (Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO))))
            (𝟙 ((Stacks.SheafOfModules.Tensor.ringSheaf
              (CategoryTheory.ObjectProperty.FullSubcategory.mk O
                (Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO)))).obj))
  -- The unitor square of the presheaf monoidal structure, pushed forward by `S`. It is a ground
  -- equation between morphisms of sheaves, proved with no rewriting, so the two spellings of the
  -- counit's source — `S.obj N.val` and `(forget ⋙ restrictScalars ⋙ S).obj N` — never have to
  -- be unified by a tactic that works below `default` transparency.
  have key : S.map (a.val ▷ (𝟙_ (PresheafOfModules.{w}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO⟩)).obj))) ≫
        S.map (ρ_ N.val).hom =
      S.map (ρ_ M.val).hom ≫ S.map a.val :=
    (S.map_comp _ _).symm.trans
      ((congrArg S.map (MonoidalCategory.rightUnitor_naturality a.val)).trans
        (S.map_comp _ _))
  have ha : S.map ((PresheafOfModules.restrictScalars (𝟙 _)).map a.val) =
      S.map a.val := by rfl
  have h := adj.counit.naturality a
  change S.map ((PresheafOfModules.restrictScalars (𝟙 _)).map a.val) ≫
      adj.counit.app N = adj.counit.app M ≫ a at h
  rw [ha] at h
  rw [Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map]
  have hN : (tensorProductRightUnitor O hO N).hom = S.map (ρ_ N.val).hom ≫ adj.counit.app N :=
    rfl
  have hM : (tensorProductRightUnitor O hO M).hom = S.map (ρ_ M.val).hom ≫ adj.counit.app M :=
    rfl
  have hw : (PresheafOfModules.sheafification (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf
        ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO⟩).obj)).map
        (PresheafOfModules.tensorHom a.val (𝟙 (SheafOfModules.unit
          (Stacks.SheafOfModules.Tensor.ringSheaf
            ⟨O, Presheaf.isSheaf_of_isSheaf_comp _ O (forget₂ CommRingCat RingCat) hO⟩)).val)) =
      S.map (a.val ▷ _) :=
    rfl
  rw [hN, hM]
  -- Replace the tensor map by the whiskering, reassociate, insert `key`, insert `h`,
  -- reassociate: every step is a term, so each is elaborated at `default` transparency.
  exact (congrArg (fun k => k ≫ (S.map (ρ_ N.val).hom ≫ adj.counit.app N)) hw).trans
    ((Category.assoc _ _ _).symm.trans
    ((congrArg (fun k => k ≫ adj.counit.app N) key).trans
      ((Category.assoc _ _ _).trans
        ((congrArg (S.map (ρ_ M.val).hom ≫ ·) h).trans (Category.assoc _ _ _).symm))))

/-- The inclusion `I^{⊗ (n+1)} ⊗ M ⟶ I^{⊗ n} ⊗ M` is natural in `M`. -/
lemma idealPowerIncl_natural
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    {M N : SheafOfModules.{u} Oₓ} (n : ℤ) (f : M ⟶ N) :
    idealPowerIncl X I ι n M ≫ idealPowerMap X I n f =
    idealPowerMap X I (n + 1) f ≫ idealPowerIncl X I ι n N := by
  let E := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I
  let : E.IsEquivalence := tensorRightFunctor_isEquivalence
    X.sheaf.obj ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
  let T := (Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))
  let pM := powSuccIso E.asEquivalence n M
  let pN := powSuccIso E.asEquivalence n N
  let rM : T.obj (idealPowerTerm X I n M, 𝒪) ≅ idealPowerTerm X I n M :=
    tensorProductRightUnitor X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property
        (idealPowerTerm X I n M)
  let rN : T.obj (idealPowerTerm X I n N, 𝒪) ≅ idealPowerTerm X I n N :=
    tensorProductRightUnitor X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property
        (idealPowerTerm X I n N)
  let eM : idealPowerTerm X I n M ⟶ idealPowerTerm X I n N :=
    (tensorPowerEquivalence X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
        n).functor.map f
  let eN : idealPowerTerm X I (n + 1) M ⟶ idealPowerTerm X I (n + 1) N :=
    (tensorPowerEquivalence X.sheaf.obj
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I
        (n + 1)).functor.map f
  have hpow : E.map eM ≫ pN.hom = pM.hom ≫ eN :=
    powSuccIso_natural
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
          I).asEquivalence
      n f
  have hinv : pM.inv ≫ E.map eM = eN ≫ pN.inv := by
    refine (cancel_mono pN.hom).mp ?_
    -- Both sides are reduced to `eN` by ground equations; `simp`'s `Category.assoc` step does
    -- not fire on this goal, which is type-correct only at `default` transparency.
    exact ((Category.assoc _ _ _).trans
        ((congrArg (pM.inv ≫ ·) hpow).trans (pM.inv_hom_id_assoc eN))).trans
      ((Category.assoc eN pN.inv pN.hom).trans
        ((congrArg (eN ≫ ·) pN.inv_hom_id).trans (Category.comp_id eN))).symm
  have hswap :
      T.map (X := (idealPowerTerm X I n M, I))
        (Y := (idealPowerTerm X I n M, 𝒪)) (𝟙 _, ι) ≫
      T.map (X := (idealPowerTerm X I n M, 𝒪))
        (Y := (idealPowerTerm X I n N, 𝒪)) (eM, 𝟙 _) =
      T.map (X := (idealPowerTerm X I n M, I))
        (Y := (idealPowerTerm X I n N, I)) (eM, 𝟙 _) ≫
      T.map (X := (idealPowerTerm X I n N, I))
        (Y := (idealPowerTerm X I n N, 𝒪)) (𝟙 _, ι) := by
    rw [← T.map_comp, ← T.map_comp]
    congr 1
  let cM : T.obj (idealPowerTerm X I n M, I) ⟶
      T.obj (idealPowerTerm X I n M, 𝒪) := T.map (𝟙 _, ι)
  let cN : T.obj (idealPowerTerm X I n N, I) ⟶
      T.obj (idealPowerTerm X I n N, 𝒪) := T.map (𝟙 _, ι)
  let t : T.obj (idealPowerTerm X I n M, 𝒪) ⟶
      T.obj (idealPowerTerm X I n N, 𝒪) := T.map (eM, 𝟙 _)
  have hswap' : cM ≫ t = E.map eM ≫ cN :=
    hswap.trans (congrArg (fun morphism => morphism ≫ cN)
      ((congrArg (fun morphism => E.map eM ≫ morphism)
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj
          (idealPowerTerm X I n N)).map_id I)).trans (Category.comp_id (E.map eM))))
  have hun : t ≫ rN.hom = rM.hom ≫ eM :=
    tensorProductRightUnitor_naturality X.sheaf.obj (Oₓ).property eM
  change (pM.inv ≫ cM ≫ rM.hom) ≫ eM = eN ≫ (pN.inv ≫ cN ≫ rN.hom)
  -- Every step is a term rather than a rewrite: the objects of these composites carry two
  -- spellings of the ring sheaf, so `rw`/`simp` cannot match on them, while `exact`-style
  -- elaboration of each step runs at `default` transparency and goes through.
  exact (Category.assoc pM.inv (cM ≫ rM.hom) eM).trans
    ((congrArg (pM.inv ≫ ·) (Category.assoc cM rM.hom eM)).trans
      ((congrArg (fun morphism => pM.inv ≫ cM ≫ morphism) hun.symm).trans
        ((congrArg (pM.inv ≫ ·) (Category.assoc cM t rN.hom).symm).trans
          ((congrArg (fun morphism => pM.inv ≫ morphism ≫ rN.hom) hswap').trans
            ((congrArg (pM.inv ≫ ·) (Category.assoc (E.map eM) cN rN.hom)).trans
              ((Category.assoc pM.inv (E.map eM) (cN ≫ rN.hom)).symm.trans
                ((congrArg (fun morphism => morphism ≫ cN ≫ rN.hom) hinv).trans
                  (Category.assoc eN pN.inv (cN ≫ rN.hom)))))))))

/-- Twisting by an ideal power sends a zero morphism to zero. -/
lemma idealPowerMap_zero
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (n : ℤ) (M N : SheafOfModules.{u} Oₓ) :
    idealPowerMap X I n (0 : M ⟶ N) = 0 :=
  (tensorPowerEquivalence X.sheaf.obj (Oₓ).property I n).functor.map_zero M N

/-- The canonical `O_{X,x}`-module structure on the stalk of a sheaf of `O_X`-modules, with the
structure sheaf spelled as `structureSheaf X.sheaf`. This is
`TensorStalkRingedSpace.stalkModule`, restated at that spelling: instance search runs at
`instances` transparency, below which `(structureSheaf X.sheaf).obj` and
`TensorStalkRingedSpace.O X` do not agree, so the upstream instance is invisible to it. -/
public noncomputable instance moduleGrpStalk (M : SheafOfModules.{u} Oₓ) (x : X) :
    Module (ringStalk X x) (grpStalk X M.val x) :=
  Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X M.val x

/-- Sections of a sheaf of `O_X`-modules over `V`, read through a restriction map and therefore
spelled as a module over the sections on the larger open, still carry their own action of the
sections on `V`. The identification is a `ModuleCat.restrictScalars` unfolding together with the
two spellings of the structure sheaf, so instance search cannot find it unaided. -/
private instance moduleRestrictScalarsSection (M : SheafOfModules.{u} Oₓ)
    {U V : (Opens X)ᵒᵖ} (g : U ⟶ V) :
    Module ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj V)
      ((ModuleCat.restrictScalars ((Oₓ).obj.map g).hom).obj (M.val.obj V)) :=
  inferInstanceAs (Module ((Oₓ).obj.obj V) (M.val.obj V))

/-- Sections of a sheaf of `O_X`-modules are a module over the sections of the structure sheaf in
its `RingCat`-valued spelling. -/
public instance moduleTensorStalkSections (M : SheafOfModules.{u} Oₓ) (U : (Opens X)ᵒᵖ) :
    Module ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj U) (M.val.obj U) :=
  inferInstanceAs (Module ((Oₓ).obj.obj U) (M.val.obj U))

/-- The stalk of a sheaf of `O_X`-modules is a module over the `RingCat`-valued stalk of the
structure sheaf, which is the scalar ring `AlgebraicGeometry.SheafOfModules.stalkFunctor`
produces. -/
private noncomputable instance moduleRingCatStalk (M : SheafOfModules.{u} Oₓ) (x : X) :
    Module (TopCat.Presheaf.stalk (C := RingCat.{u})
        (Stacks.SheafOfModules.TensorStalkRingedSpace.O X) x)
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) M.val.presheaf x) :=
  let N : PresheafOfModules.{u} (Stacks.SheafOfModules.TensorStalkRingedSpace.O X) := M.val
  inferInstanceAs (Module (TopCat.Presheaf.stalk (C := RingCat.{u})
      (Stacks.SheafOfModules.TensorStalkRingedSpace.O X) x)
    (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) N.presheaf x))

section
local notation "Oₛ" => structureSheafRing X
local notation "𝒪ₛ" => SheafOfModules.unit Oₛ

open Opposite

/-- The order chain `F[I] ≤ F[I^1] = ⊥ ≤ 0`, read on sections. It is stated here, where the
module sheaf is spelled over `structureSheafRing X`, because that is the only spelling for which
instance search finds the lattice of subsheaves; the consumer below is indexed by
`structureSheaf X.sheaf` instead, and an `≤` written there has no `LE` instance. -/
private lemma mem_zeroSubsheaf_of_mem_idealAnnihilated
    {I : SheafOfModules.{u} Oₛ} (i : I ⟶ 𝒪ₛ) (F : SheafOfModules.{u} Oₛ)
    (hF : idealPowerAnnihilatorSubsheaf X i F 1 = ⊥)
    (U : (Opens X)ᵒᵖ) (s : F.val.obj U)
    (hs : s ∈ (idealAnnihilatedSubsheaf X i F).toSubmodule.obj U) :
    s ∈ (zeroSubsheaf X F).toSubmodule.obj U :=
  SheafOfModules.Submodule.le_iff.mp
    (((idealAnnihilatedSubsheaf_le_sup X i F).trans (le_of_eq hF)).trans bot_le) U hs

private lemma eq_zero_of_ideal_annihilates
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (U : (Opens X)ᵒᵖ) (m : M.val.obj U)
    (hm : ∀ (V : Opens X) (hVU : V ≤ unop U) (a : I.val.obj (op V)),
      idealSection X ι (op V) a • (M.val.map (homOfLE hVU).op).hom m = 0) :
    m = 0 :=
  mem_zeroSubsheaf_of_mem_idealAnnihilated X ι M hM U m hm

/-- The germ at `x` of the restriction of a section to a smaller open `V ∋ x` is the germ of the
section itself. -/
public lemma grpGerm_res {X : RingedSpace.{u}}
    (F : SheafOfModules.{u} (structureSheafRing X))
    (U V : Opens X) (hVU : V ≤ U) (x : X) (hxV : x ∈ V)
    (s : F.val.obj (op U)) :
    grpGerm X F.val x V hxV
        ((F.val.map (homOfLE hVU).op).hom s) =
      grpGerm X F.val x U (hVU hxV) s := by
  change (TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) F.val.presheaf V x hxV).hom
      ((F.val.presheaf.map (homOfLE hVU).op).hom
        ((PresheafOfModules.presheaf_obj_coe (M := F.val) (op U)).symm ▸ s)) = _
  rw [TopCat.Presheaf.germ_res_apply (C := AddCommGrpCat.{u}) F.val.presheaf
    (homOfLE hVU) x hxV _]
  rfl

/-- The stalk at `x` of the unit module sheaf `O_X`, identified additively with the ring stalk
`O_{X,x}`. -/
public noncomputable def unitStalkAddEquiv (x : X) :
    grpStalk X (SheafOfModules.unit Oₓ).val x ≃+
      ringStalk X x :=
  (preservesColimitIso (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
    ((OpenNhds.inclusion x).op ⋙ X.presheaf)).symm.addCommGroupIsoToAddEquiv

/-- `unitStalkAddEquiv` sends the germ of a section of `O_X` to its germ in the ring stalk. -/
public lemma unitStalkAddEquiv_germ (x : X) (U : Opens X) (hxU : x ∈ U)
    (r : X.presheaf.obj (op U)) :
    unitStalkAddEquiv X x
      (grpGerm X (SheafOfModules.unit Oₓ).val x U hxU r) =
      ringGerm X x U hxU r := by
  have h := ι_preservesColimitIso_inv (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
    ((OpenNhds.inclusion x).op ⋙ X.presheaf) (op ⟨U, hxU⟩)
  exact congrArg (fun q => q.hom r) h

/-- `unitStalkAddEquiv` as an `O_{X,x}`-linear equivalence. -/
public noncomputable def unitStalkLinearEquiv (x : X) :
    grpStalk X (SheafOfModules.unit Oₓ).val x ≃ₗ[
      ringStalk X x] ringStalk X x := by
  refine { __ := unitStalkAddEquiv X x, map_smul' := ?_ }
  intro r m
  obtain ⟨U, hxU, s, rfl⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat) (SheafOfModules.unit Oₓ).val.presheaf m
  obtain ⟨V, hxV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf r
  let W : Opens X := U ⊓ V
  have hxW : x ∈ W := ⟨hxU, hxV⟩
  have hs := grpGerm_res (SheafOfModules.unit Oₓ) U W inf_le_left x hxW s
  have ht := X.presheaf.germ_res_apply (homOfLE (show W ≤ V from inf_le_right)) x hxW t
  change unitStalkAddEquiv X x
    (ringGerm X x V hxV t •
      grpGerm X (SheafOfModules.unit Oₓ).val x U hxU s) =
    ringGerm X x V hxV t * unitStalkAddEquiv X x
      (grpGerm X (SheafOfModules.unit Oₓ).val x U hxU s)
  change ringGerm X x W hxW
      ((X.presheaf.map (homOfLE inf_le_right).op).hom t) =
    ringGerm X x V hxV t at ht
  -- Every expression below mentions `grpGerm X (SheafOfModules.unit Oₓ).val`, whose first
  -- explicit argument is only of the required type at `default` transparency; so `rw` can
  -- neither instantiate `stalkModule_germ_smul` nor match `unitStalkAddEquiv_germ` on it. The
  -- identity is therefore proved once with the section and the scalar as bound variables, where
  -- the lemmas can be applied to explicit arguments, and then instantiated.
  have key : ∀ (U : Opens X) (hxU : x ∈ U) (r : X.presheaf.obj (op U))
      (s : (SheafOfModules.unit Oₓ).val.obj (op U)),
      unitStalkAddEquiv X x
          (ringGerm X x U hxU r • grpGerm X (SheafOfModules.unit Oₓ).val x U hxU s) =
        ringGerm X x U hxU r *
          unitStalkAddEquiv X x (grpGerm X (SheafOfModules.unit Oₓ).val x U hxU s) := by
    intro U hxU r s
    refine Eq.trans (congrArg (unitStalkAddEquiv X x)
      (stalkModule_germ_smul X (SheafOfModules.unit Oₓ).val x U hxU r s).symm) ?_
    refine Eq.trans (unitStalkAddEquiv_germ X x U hxU _) ?_
    refine Eq.trans ?_ (congrArg (fun z => ringGerm X x U hxU r * z)
      (unitStalkAddEquiv_germ X x U hxU s).symm)
    exact map_mul (ringGerm X x U hxU) _ _
  rw [← hs, ← ht]
  exact key W hxW _ _

/-- `unitStalkLinearEquiv` sends the germ of a section of `O_X` to its germ in the ring stalk. -/
public lemma unitStalkLinearEquiv_germ (x : X) (U : Opens X) (hxU : x ∈ U)
    (r : X.presheaf.obj (op U)) :
    unitStalkLinearEquiv X x
      (grpGerm X (SheafOfModules.unit Oₓ).val x U hxU r) =
      ringGerm X x U hxU r :=
  unitStalkAddEquiv_germ X x U hxU r

/-- The stalk map of a morphism of module sheaves sends the germ of a section to the germ of its
image. -/
public lemma stalkMapL_germ {I J : SheafOfModules.{u} Oₓ} (i : I ⟶ J)
    (x : X) (U : Opens X) (hxU : x ∈ U) (s : I.val.obj (op U)) :
    stalkMapL X I.val J.val i.val x
      (grpGerm X I.val x U hxU s) =
      grpGerm X J.val x U hxU ((i.val.app (op U)).hom s) :=
  TopCat.Presheaf.stalkFunctor_map_germ_apply' (C := AddCommGrpCat.{u})
    U x hxU ((PresheafOfModules.toPresheaf
      (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map i.val) s

/-- The stalk map of a composite is the composite of the stalk maps. -/
public lemma stalkMapL_comp
    (F G H : SheafOfModules.{u} Oₓ) (f : F ⟶ G) (g : G ⟶ H) (x : X) :
    stalkMapL X F.val H.val (f ≫ g).val x =
      (stalkMapL X G.val H.val g.val x).comp
        (stalkMapL X F.val G.val f.val x) := by
  -- `Functor.map_comp` is applied twice as a *ground* equation, so nothing has to be matched
  -- against a goal whose type still mentions the other spelling of the ring sheaf.
  have key : (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        ((PresheafOfModules.toPresheaf
          (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map (f.val ≫ g.val)) =
      (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
          ((PresheafOfModules.toPresheaf
            (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map f.val) ≫
        (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
          ((PresheafOfModules.toPresheaf
            (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map g.val) :=
    (congrArg (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      (Functor.map_comp (PresheafOfModules.toPresheaf
        (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)) f.val g.val)).trans
      (Functor.map_comp (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x) _ _)
  ext m
  exact congrArg (fun k => AddCommGrpCat.Hom.hom k m) key

/-- The stalk map of a monomorphism of module sheaves is injective. -/
public lemma stalkMapL_injective_of_mono
    {F G : SheafOfModules.{u} Oₓ} (f : F ⟶ G) [Mono f] (x : X) :
    Function.Injective (stalkMapL X F.val G.val f.val x) := by
  let T := SheafOfModules.toSheaf Oₓ
  change Function.Injective ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map (T.map f).1).hom
  exact (AddCommGrpCat.mono_iff_injective _).mp
    ((TopCat.Presheaf.mono_iff_stalk_mono (T.map f)).mp (Functor.map_mono T f) x)

/-- The stalk map of the identity is the identity. -/
public lemma stalkMapL_id (F : SheafOfModules.{u} Oₓ) (x : X) :
    stalkMapL X F.val F.val (𝟙 F.val) x = LinearMap.id := by
  -- `Functor.map_id` is applied twice as a ground equation; `simp` cannot use it here, because
  -- the goal is type-correct only at `default` transparency.
  have key : (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        ((PresheafOfModules.toPresheaf
          (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map (𝟙 F.val)) =
      𝟙 ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).obj
        ((PresheafOfModules.toPresheaf
          (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).obj F.val)) :=
    (congrArg (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        ((PresheafOfModules.toPresheaf
          (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map_id F.val)).trans
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map_id _)
  ext m
  exact congrArg (fun k => AddCommGrpCat.Hom.hom k m) key

end

open Opposite

open MonoidalCategory TensorProduct in
/-- On a pure tensor the zeroth ideal-power inclusion is the action of the ambient section of
the ideal factor. -/
lemma idealPowerIncl_zero_app_toTensorSheafSection
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (U : Opens X)
    (m : M.val.obj (op U)) (a : I.val.obj (op U)) :
    ((idealPowerIncl X I ι 0 M).val.app (op U)).hom
      (toTensorSheafSection X M I (op U)
        (m ⊗ₜ[X.presheaf.obj (op U)] a)) =
      (M.val.obj (op U)).isModule.toSMul.smul (idealSection X ι (op U) a) m := by
  let S := (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let adj := (PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let R := SheafOfModules.forget ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) ⋙
    PresheafOfModules.restrictScalars (𝟙 (Oₓ).obj)
  let q : M.val ⊗ I.val ⟶ M.val := (M.val ◁ ι.val) ≫ (ρ_ M.val).hom
  have hnat : q ≫ adj.unit.app M.val =
      adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val) ≫ R.map (S.map q) :=
          adj.unit.naturality q
  have htri : adj.unit.app M.val ≫ R.map (adj.counit.app M) = 𝟙 M.val :=
    adj.right_triangle_components M
  have h : adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val) ≫
      (S.map q ≫ adj.counit.app M).val = q := by
    change adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val) ≫
      R.map (S.map q ≫ adj.counit.app M) = q
    -- `R.map_comp`, reassociation, the unit's naturality square and the right triangle, all as
    -- terms: `rw` cannot even instantiate `Functor.map_comp` here, because the composite
    -- `S.map q ≫ adj.counit.app M` is type-correct only at `default` transparency.
    exact (congrArg
        (fun k => adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val) ≫ k)
          (R.map_comp (S.map q) (adj.counit.app M))).trans
      ((Category.assoc (adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val))
        (R.map (S.map q))
            (R.map (adj.counit.app M))).symm.trans
        ((congrArg (fun k => k ≫ R.map (adj.counit.app M)) hnat.symm).trans
          ((Category.assoc q (adj.unit.app M.val) (R.map (adj.counit.app M))).trans
            ((congrArg (fun k => q ≫ k) htri).trans (Category.comp_id q)))))
  -- `S.map_comp` is folded into `h` before the section is extracted. Rewriting with it
  -- afterwards is impossible: by then the composite sits under a `.val` projection, and `rw`
  -- has no type-correct motive for it.
  have hv := congrArg (fun k => (k.app (op U)).hom
      (m ⊗ₜ[X.presheaf.obj (op U)] a))
    ((congrArg (fun k => adj.unit.app (PresheafOfModules.tensorObj (O := X.presheaf) M.val I.val) ≫
      (k ≫ adj.counit.app M).val)
      (S.map_comp (M.val ◁ ι.val) (ρ_ M.val).hom).symm).trans h)
  dsimp only [q] at hv
  exact (congrArg (fun morphism =>
    (((morphism ≫ (tensorProductRightUnitor X.sheaf.obj (Oₓ).property M).hom).val.app
      (op U)).hom (toTensorSheafSection X M I (op U)
        (m ⊗ₜ[X.presheaf.obj (op U)] a))))
    (Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map X.sheaf (𝟙 M) ι)).trans hv

open TensorProduct in
private lemma eq_zero_of_idealPowerIncl_comp_eq_zero
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {Q M : SheafOfModules.{u} Oₓ} (hM : IsIdealTorsionFree X ι M)
    (b : Q ⟶ M) (hb : idealPowerIncl X I ι 0 Q ≫ b = 0) : b = 0 := by
  ext U m
  apply eq_zero_of_ideal_annihilates X ι M hM U
  intro V hVU a
  have hnat := congrArg (fun t => t.hom m) (b.val.naturality (homOfLE hVU).op)
  change (b.val.app (op V)).hom ((Q.val.map (homOfLE hVU).op).hom m) =
      (M.val.map (homOfLE hVU).op).hom ((b.val.app U).hom m) at hnat
  rw [← hnat]
  have hv := congrArg (fun t => (t.val.app (op V)).hom
    (toTensorSheafSection X Q I (op V)
      (((Q.val.map (homOfLE hVU).op).hom m) ⊗ₜ[X.presheaf.obj (op V)] a))) hb
  change (b.val.app (op V)).hom
    (((idealPowerIncl X I ι 0 Q).val.app (op V)).hom _) = 0 at hv
  rw [idealPowerIncl_zero_app_toTensorSheafSection X I ι Q V
    ((Q.val.map (homOfLE hVU).op).hom m) a] at hv
  -- The section is passed without a `show … from` ascription: that elaborates to a `letFun`
  -- node, which blocks `convert` (and `rw`) on the resulting hypothesis.
  have he := (b.val.app (op V)).hom.map_smul
    (idealSection X ι (op V) a)
    ((Q.val.map (homOfLE hVU).op).hom m)
  exact he.symm.trans hv

private lemma idealPowerIncl_zero_mono
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M) :
    Mono (idealPowerIncl X I ι 0 M) := by
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I
  have : T.IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  apply (Preadditive.mono_iff_cancel_zero _).2
  intro A a ha
  let Q := T.objPreimage A
  let e := T.objObjPreimageIso A
  obtain ⟨b, hb⟩ := T.map_surjective (e.hom ≫ a)
  have hzero : idealPowerIncl X I ι 0 Q ≫ b = 0 := by
    change idealPowerIncl X I ι 0 Q ≫ idealPowerMap X I 0 b = 0
    refine Eq.trans (idealPowerIncl_natural X I ι 0 b) ?_
    change T.map b ≫ idealPowerIncl X I ι 0 M = 0
    refine Eq.trans (congrArg (fun k => k ≫ idealPowerIncl X I ι 0 M) hb) ?_
    exact (Category.assoc e.hom a (idealPowerIncl X I ι 0 M)).trans
      ((congrArg (fun k => e.hom ≫ k) ha).trans comp_zero)
  -- `Q` is `T.objPreimage A`, so it is spelled over the sheafification's structure sheaf; an
  -- ascribed `b = 0` then asks for a `Zero` on a hom-set instance search cannot see. Taking the
  -- type from the lemma avoids writing it, and the cancellation is done by the inverse of `e`
  -- rather than by `cancel_epi`, which would need `Epi e.hom` at the other spelling.
  have hbzero := eq_zero_of_idealPowerIncl_comp_eq_zero X I ι hM b hzero
  have hea : e.hom ≫ a = 0 :=
    hb.symm.trans ((congrArg T.map hbzero).trans (T.map_zero Q M))
  exact zero_of_epi_comp e.hom hea

/-- The map `I_x → O_{X,x}` induced on stalks by the ideal inclusion `ι : I ⟶ O_X`. -/
public noncomputable abbrev idealStalkMap
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) (x : X) :
    grpStalk X I.val x →ₗ[ringStalk X x]
      ringStalk X x :=
  (unitStalkLinearEquiv X x).toLinearMap.comp
    (stalkMapL X I.val (SheafOfModules.unit Oₓ).val ι.val x)

/-- `idealStalkMap` sends the germ of a section `a` of `I` to the germ of its image under `ι`. -/
public lemma idealStalkMap_germ
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) (x : X)
    (U : Opens X) (hxU : x ∈ U) (a : I.val.obj (op U)) :
    idealStalkMap X ι x (grpGerm X I.val x U hxU a) =
      ringGerm X x U hxU (idealSection X ι (op U) a) := by
  change unitStalkLinearEquiv X x
    (stalkMapL X I.val (SheafOfModules.unit Oₓ).val ι.val x
      (grpGerm X I.val x U hxU a)) = _
  -- `unitStalkLinearEquiv_germ` takes its section in `X.presheaf.obj (op U)`, which the section
  -- `(ι.val.app _).hom a` of the unit sheaf only is at `default` transparency; so it is applied
  -- to explicit arguments rather than matched against the goal.
  refine Eq.trans (congrArg (fun z => unitStalkLinearEquiv X x z)
    (stalkMapL_germ X ι x U hxU a)) ?_
  exact unitStalkLinearEquiv_germ X x U hxU ((ι.val.app (op U)).hom a)

/-- When `ι` is a monomorphism, the induced map `I_x → O_{X,x}` is injective. -/
public lemma idealStalkMap_injective
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) [Mono ι] (x : X) :
    Function.Injective (idealStalkMap X ι x) :=
  (unitStalkLinearEquiv X x).injective.comp (stalkMapL_injective_of_mono X ι x)

open TensorProduct in
/-- On stalks, the inclusion `I ⊗ M ⟶ M` (the case `n = 0` of `idealPowerIncl`), read through
the identification `tensorStalkIso` of the stalk of a tensor product, sends `m ⊗ a` to
`ι_x(a) • m`. -/
public lemma idealPowerIncl_zero_stalk_tmul
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X)
    (m : grpStalk X M.val x)
    (a : grpStalk X I.val x) :
    stalkMapL X (idealPowerTerm X I (0 + 1) M).val (idealPowerTerm X I 0 M).val
      (idealPowerIncl X I ι 0 M).val x
      ((tensorStalkIso X x M I).symm
        (m ⊗ₜ[ringStalk X x] a)) = idealStalkMap X ι x a • m := by
  obtain ⟨U, hxU, m, rfl⟩ := TopCat.Presheaf.exists_germ_eq
    (C := AddCommGrpCat) M.val.presheaf m
  obtain ⟨V, hxV, a, rfl⟩ := TopCat.Presheaf.exists_germ_eq
    (C := AddCommGrpCat) I.val.presheaf a
  let W : Opens X := U ⊓ V
  have hxW : x ∈ W := ⟨hxU, hxV⟩
  have hm := grpGerm_res M U W inf_le_left x hxW m
  have ha := grpGerm_res I V W inf_le_right x hxW a
  -- Spell the source of the stalk map as the tensor sheaf, which is the spelling
  -- `tensorStalkIso_germ` produces; `stalkMapL_germ` then matches on the nose.
  change stalkMapL X
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj
      (I))).val M.val
    (idealPowerIncl X I ι 0 M).val x
    ((tensorStalkIso X x M I).symm
      (grpGerm X M.val x U hxU m ⊗ₜ[ringStalk X x]
        grpGerm X I.val x V hxV a)) = _
  rw [← hm, ← ha]
  -- `tensorStalkIso_germ` and `stalkMapL_germ` both carry the module sheaves as *explicit*
  -- arguments typed over `structureSheafRing X`, which `rw` cannot instantiate with sheaves
  -- typed over `structureSheaf X.sheaf`. Both are therefore applied to explicit arguments.
  refine Eq.trans (congrArg
    (fun z => stalkMapL X
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X)).presheaf, ((X)).IsSheaf⟩).obj (M)).obj
        (I))).val M.val
      (idealPowerIncl X I ι 0 M).val x z)
    ((congrArg (fun z => (tensorStalkIso X x M I).symm z)
        (tensorStalkIso_germ X x M I W hxW
          ((M.val.map (homOfLE (inf_le_left : W ≤ U)).op).hom m)
          ((I.val.map (homOfLE (inf_le_right : W ≤ V)).op).hom a))).symm.trans
      ((tensorStalkIso X x M I).symm_apply_apply _))) ?_
  refine Eq.trans (stalkMapL_germ X (idealPowerIncl X I ι 0 M) x W hxW
    (toTensorSheafSection X M I (op W)
      ((M.val.map (homOfLE (inf_le_left : W ≤ U)).op).hom m ⊗ₜ[X.presheaf.obj (op W)]
        (I.val.map (homOfLE (inf_le_right : W ≤ V)).op).hom a))) ?_
  -- The section-level value of the ideal-power inclusion on a pure tensor, fed in with its
  -- arguments spelled out so that no unification across the two ring-sheaf spellings is needed.
  refine Eq.trans (congrArg (fun s => grpGerm X M.val x W hxW s)
    (idealPowerIncl_zero_app_toTensorSheafSection X I ι M W
      ((M.val.map (homOfLE (inf_le_left : W ≤ U)).op).hom m)
      ((I.val.map (homOfLE (inf_le_right : W ≤ V)).op).hom a))) ?_
  refine Eq.trans (stalkModule_germ_smul X M.val x W hxW
    (idealSection X ι (op W) ((I.val.map (homOfLE (inf_le_right : W ≤ V)).op).hom a))
    ((M.val.map (homOfLE (inf_le_left : W ≤ U)).op).hom m)) ?_
  refine Eq.trans (congrArg
    (fun r => r • grpGerm X M.val x W hxW
      ((M.val.map (homOfLE (inf_le_left : W ≤ U)).op).hom m))
    (idealStalkMap_germ X ι x W hxW
      ((I.val.map (homOfLE (inf_le_right : W ≤ V)).op).hom a)).symm) ?_
  exact congrArg₂ (fun (r : ringStalk X x) (s : grpStalk X M.val x) => r • s)
    (congrArg (fun b => idealStalkMap X ι x b) ha) hm

private lemma idealStalkMap_smul_comm
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) [Mono ι] (x : X)
    (a b : grpStalk X I.val x) :
    idealStalkMap X ι x a • b = idealStalkMap X ι x b • a := by
  apply idealStalkMap_injective X ι x
  simp only [map_smul, smul_eq_mul, mul_comm]

open TensorProduct in
private lemma idealPowerMap_one_stalk_tmul
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (b : M ⟶ N) (x : X)
    (m : grpStalk X M.val x)
    (a : grpStalk X I.val x) :
    stalkMapL X (idealPowerTerm X I 1 M).val
      (idealPowerTerm X I 1 N).val (idealPowerMap X I 1 b).val x
      ((tensorStalkIso X x M I).symm
        (m ⊗ₜ[ringStalk X x] a)) =
    (tensorStalkIso X x N I).symm
      (stalkMapL X M.val N.val b.val x m ⊗ₜ[ringStalk X x] a) := by
  apply (tensorStalkIso X x N I).injective
  have h := congrArg (fun tensorMap => tensorMap ((tensorStalkIso X x M I).symm
    (m ⊗ₜ[ringStalk X x] a)))
    (tensorStalkIso_natural X x M I N I b (𝟙 I))
  have h' := h.trans (congrArg (fun morphism =>
    (tensorStalkIso X x N I) (stalkMapL X
      (((Stacks.SheafOfModules.Tensor.sheafTensor
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj M).obj I).val
      (((Stacks.SheafOfModules.Tensor.sheafTensor
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj N).obj I).val
      (SheafOfModules.Hom.val morphism) x
      ((tensorStalkIso X x M I).symm (m ⊗ₜ[ringStalk X x] a))))
    (Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map X.sheaf b (𝟙 I)))
  have hid : stalkMapL X I.val I.val (SheafOfModules.Hom.val (𝟙 I)) x = LinearMap.id :=
    stalkMapL_id X I x
  rw [hid] at h'
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.apply_symm_apply, TensorProduct.map_tmul,
    LinearMap.id_apply] at h'
  convert h'.symm using 1 <;> first
    | rfl
    | exact (tensorStalkIso X x N I).apply_symm_apply _

private lemma sheafHom_ext_stalk
    {M N : SheafOfModules.{u} Oₓ} {a b : M ⟶ N}
    (h : ∀ x : X, stalkMapL X M.val N.val a.val x =
      stalkMapL X M.val N.val b.val x) : a = b := by
  ext U m
  apply TopCat.Presheaf.section_ext ((SheafOfModules.toSheaf Oₓ).obj N) (unop U)
  intro x hx
  have hx' := congrArg (fun q => q (grpGerm X M.val x (unop U) hx m)) (h x)
  rw [stalkMapL_germ, stalkMapL_germ] at hx'
  exact hx'

open TensorProduct in
private lemma idealPowerIncl_zero_tensor
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) :
    idealPowerIncl X I ι 0 (idealPowerTerm X I 1 M) =
      idealPowerMap X I 1 (idealPowerIncl X I ι 0 M) := by
  apply sheafHom_ext_stalk
  intro x
  apply LinearMap.ext
  intro z
  obtain ⟨t, rfl⟩ := (tensorStalkIso X x (idealPowerTerm X I 1 M) I).symm.surjective z
  induction t using TensorProduct.inductionOn with
  | add t s ht hs =>
    simp only [map_add]
    exact (map_add _ _ _).trans ((congrArg₂ (· + ·) ht hs).trans (map_add _ _ _).symm)
  | tmul m a =>
    -- `idealPowerIncl X I ι 0 _` carries the degree `0 + 1`, while
    -- `idealPowerMap_one_stalk_tmul` is stated at `1`; spell both sides so that each
    -- lemma matches the explicit arguments it is applied to.
    change stalkMapL X (idealPowerTerm X I (0 + 1) (idealPowerTerm X I 1 M)).val
          (idealPowerTerm X I 0 (idealPowerTerm X I 1 M)).val
          (idealPowerIncl X I ι 0 (idealPowerTerm X I 1 M)).val x
          ((tensorStalkIso X x (idealPowerTerm X I 1 M) I).symm
            (m ⊗ₜ[ringStalk X x] a)) =
        stalkMapL X (idealPowerTerm X I 1 (idealPowerTerm X I (0 + 1) M)).val
          (idealPowerTerm X I 1 (idealPowerTerm X I 0 M)).val
          (idealPowerMap X I 1 (idealPowerIncl X I ι 0 M)).val x
          ((tensorStalkIso X x (idealPowerTerm X I (0 + 1) M) I).symm
            (m ⊗ₜ[ringStalk X x] a))
    rw [idealPowerIncl_zero_stalk_tmul, idealPowerMap_one_stalk_tmul]
    obtain ⟨t, rfl⟩ := (tensorStalkIso X x M I).symm.surjective m
    induction t using TensorProduct.inductionOn with
    | add t s ht hs =>
      simp only [map_add]
      change idealStalkMap X ι x a •
          ((tensorStalkIso X x M I).symm t + (tensorStalkIso X x M I).symm s) = _
      refine Eq.trans (smul_add (idealStalkMap X ι x a) _ _)
        (Eq.trans (congrArg₂ (· + ·) ht hs) (Eq.symm ?_))
      refine Eq.trans (congrArg (fun w => (tensorStalkIso X x (idealPowerTerm X I 0 M) I).symm w)
        (Eq.trans (congrArg (fun w => w ⊗ₜ[ringStalk X x] a) (map_add _ _ _))
          (TensorProduct.add_tmul _ _ a))) ?_
      exact map_add _ _ _
    | tmul m b =>
      rw [idealPowerIncl_zero_stalk_tmul]
      apply (tensorStalkIso X x M I).injective
      -- `map_smul`, `apply_symm_apply` and the two tensor-product identities are applied to
      -- explicit arguments for the same reason: `simp` reports no progress on a goal that
      -- mixes the two spellings of the module sheaf.
      refine Eq.trans (map_smul (tensorStalkIso X x M I) (idealStalkMap X ι x a)
        ((tensorStalkIso X x M I).symm (m ⊗ₜ[ringStalk X x] b))) ?_
      refine Eq.trans (congrArg (fun w => idealStalkMap X ι x a • w)
        ((tensorStalkIso X x M I).apply_symm_apply (m ⊗ₜ[ringStalk X x] b))) ?_
      refine Eq.trans (TensorProduct.tmul_smul (idealStalkMap X ι x a) m b).symm ?_
      refine Eq.trans (congrArg (fun w => m ⊗ₜ[ringStalk X x] w)
        (idealStalkMap_smul_comm X ι x a b)) ?_
      refine Eq.trans (TensorProduct.smul_tmul (idealStalkMap X ι x b) m a).symm ?_
      exact ((tensorStalkIso X x M I).apply_symm_apply
        ((idealStalkMap X ι x b • m) ⊗ₜ[ringStalk X x] a)).symm

private lemma mono_idealPowerIncl_zero_of_iso
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (e : M ≅ N)
    [Mono (idealPowerIncl X I ι 0 M)] :
    Mono (idealPowerIncl X I ι 0 N) := by
  have h : idealPowerIncl X I ι 0 N ≫ e.inv =
      idealPowerMap X I 1 e.inv ≫ idealPowerIncl X I ι 0 M :=
    idealPowerIncl_natural X I ι 0 e.inv
  -- `mono_of_mono_fac` would need `Mono` of the right-hand composite, whose middle object is
  -- `idealPowerTerm X I 1 M` on one side and `idealPowerTerm X I (0 + 1) M` on the other; no
  -- ascription reaches a composite's middle object, so instance search cannot bridge it.
  -- Cancelling zero instead keeps the whole argument at the level of equations.
  refine (Preadditive.mono_iff_cancel_zero _).2 ?_
  intro A a ha
  -- `Functor.map_isIso` would ask for `IsIso e.inv` in the *functor's* source category, which
  -- is the sheafification spelling of the same category; `Iso.isIso_inv` is then invisible.
  -- The inverse is exhibited instead, using functoriality of `idealPowerMap`.
  have hmapid : ∀ P : SheafOfModules.{u} Oₓ,
      idealPowerMap X I 1 (𝟙 P) = 𝟙 (idealPowerTerm X I 1 P) :=
    fun P => (tensorPowerEquivalence X.sheaf.obj (Oₓ).property I 1).functor.map_id P
  have hg : IsIso (idealPowerMap X I 1 e.inv) :=
    ⟨idealPowerMap X I 1 e.hom,
      ((idealPowerMap_comp X I 1 e.inv e.hom).symm.trans
        (congrArg (fun k : N ⟶ N => idealPowerMap X I 1 k) e.inv_hom_id)).trans (hmapid N),
      ((idealPowerMap_comp X I 1 e.hom e.inv).symm.trans
        (congrArg (fun k : M ⟶ M => idealPowerMap X I 1 k) e.hom_inv_id)).trans (hmapid M)⟩
  have h1 : (a ≫ idealPowerMap X I 1 e.inv) ≫ idealPowerIncl X I ι 0 M = 0 :=
    (Category.assoc a (idealPowerMap X I 1 e.inv) (idealPowerIncl X I ι 0 M)).trans
      ((congrArg (fun k => a ≫ k) h.symm).trans
        ((Category.assoc a (idealPowerIncl X I ι 0 N) e.inv).symm.trans
          ((congrArg (fun k => k ≫ e.inv) ha).trans zero_comp)))
  have h2 : a ≫ idealPowerMap X I 1 e.inv = 0 :=
    (Preadditive.mono_iff_cancel_zero (idealPowerIncl X I ι 0 M)).1 inferInstance _ _ h1
  exact zero_of_comp_mono (idealPowerMap X I 1 e.inv) h2

private lemma idealPowerIncl_zero_power_mono
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) [Mono (idealPowerIncl X I ι 0 M)] (n : ℤ) :
    Mono (idealPowerIncl X I ι 0 (idealPowerTerm X I n M)) := by
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I
  have : T.IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  induction n using Int.induction_on with
  | zero =>
    change Mono (idealPowerIncl X I ι 0 M)
    assumption
  | succ k ih =>
    have := ih
    have : Mono (idealPowerIncl X I ι 0
        (idealPowerTerm X I 1 (idealPowerTerm X I k M))) := by
      rw [idealPowerIncl_zero_tensor]
      -- After the rewrite the ambient category is spelled through the sheafification's
      -- structure sheaf, so `ih` — stated over `structureSheaf X.sheaf` — is invisible to
      -- instance search. Restating it at that spelling makes it visible again.
      have : @Mono (SheafOfModules.{u}
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))) _ _ _
          (idealPowerIncl X I ι 0 (idealPowerTerm X I (k : ℤ) M)) := ih
      exact Functor.map_mono T _
    exact mono_idealPowerIncl_zero_of_iso X I ι
      (M := idealPowerTerm X I 1 (idealPowerTerm X I k M))
      (N := idealPowerTerm X I (k + 1) M)
      (powSuccIso T.asEquivalence k M)
  | pred k ih =>
    let q : ℤ := -(k : ℤ) - 1
    have hq : q + 1 = -(k : ℤ) := by
      dsimp [q]
      omega
    have : Mono (idealPowerIncl X I ι 0 (idealPowerTerm X I (q + 1) M)) :=
      hq.symm ▸ ih
    have : Mono (idealPowerIncl X I ι 0
        (idealPowerTerm X I 1 (idealPowerTerm X I q M))) :=
      mono_idealPowerIncl_zero_of_iso X I ι
        (M := idealPowerTerm X I (q + 1) M)
        (N := idealPowerTerm X I 1 (idealPowerTerm X I q M))
        (powSuccIso T.asEquivalence q M).symm
    have hm : Mono (T.map (idealPowerIncl X I ι 0 (idealPowerTerm X I q M))) := by
      change Mono (idealPowerMap X I 1 (idealPowerIncl X I ι 0 (idealPowerTerm X I q M)))
      rw [← idealPowerIncl_zero_tensor]
      exact this
    exact T.mono_of_mono_map hm

/-- On an `I`-torsion-free module the ideal-power inclusion `I^{⊗ (n+1)} ⊗ M ⟶ I^{⊗ n} ⊗ M` is a
monomorphism, in every integer degree. -/
public theorem idealPowerIncl_mono
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M) (n : ℤ) :
    Mono (idealPowerIncl X I ι n M) := by
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I
  have : T.IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  have := idealPowerIncl_zero_mono X I ι M hM
  have := idealPowerIncl_zero_power_mono X I ι M n
  have heq : idealPowerIncl X I ι n M =
      (powSuccIso T.asEquivalence n M).inv ≫
        idealPowerIncl X I ι 0 (idealPowerTerm X I n M) := by
    let P := idealPowerTerm X I n M
    let c : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj P).obj I ⟶
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj P).obj 𝒪 :=
      ((Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))).map
        (X := (P, I)) (Y := (P, 𝒪)) (𝟙 P, ι)
    let r : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).obj P).obj 𝒪 ⟶ P :=
      (tensorProductRightUnitor X.sheaf.obj (Oₓ).property P).hom
    change (powSuccIso T.asEquivalence n M).inv ≫ c ≫ r =
      (powSuccIso T.asEquivalence n M).inv ≫ (𝟙 _ ≫ c ≫ r)
    rw [Category.id_comp]
  rw [heq]
  -- Neither `infer_instance` nor `mono_comp` can assemble this: the composite's middle object
  -- carries the sheafification spelling of the structure sheaf on one side and
  -- `structureSheaf X.sheaf` on the other, and no ascription reaches a composite's middle
  -- object. Cancelling zero keeps the argument at the level of equations, where the
  -- identification is available because every step is checked at `default` transparency.
  refine (Preadditive.mono_iff_cancel_zero _).2 ?_
  intro A a hA
  have h1 : (a ≫ (powSuccIso T.asEquivalence n M).inv) ≫
      idealPowerIncl X I ι 0 (idealPowerTerm X I n M) = 0 :=
    (Category.assoc a (powSuccIso T.asEquivalence n M).inv
      (idealPowerIncl X I ι 0 (idealPowerTerm X I n M))).trans hA
  -- The type is taken from the lemma rather than ascribed: writing `= 0` here would ask for a
  -- `Zero` on a hom-set whose objects are spelled through `powSuccIso`, which instance search
  -- does not see.
  have h2 := (Preadditive.mono_iff_cancel_zero
        (idealPowerIncl X I ι 0 (idealPowerTerm X I n M))).1
      (idealPowerIncl_zero_power_mono X I ι M n) _ _ h1
  have : Mono (powSuccIso T.asEquivalence n M).inv :=
    @IsIso.mono_of_iso _ _ _ _ _ (Iso.isIso_inv _)
  exact zero_of_comp_mono (powSuccIso T.asEquivalence n M).inv h2

/-- The image of `idealStalkMap` lies in the stalk ideal `I_x ⊆ O_{X,x}`. -/
public lemma idealStalkMap_mem_stalkIdeal
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) (x : X)
    (a : grpStalk X I.val x) :
    idealStalkMap X ι x a ∈ stalkIdeal X ι x := by
  obtain ⟨U, hxU, a, rfl⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat) I.val.presheaf a
  exact ⟨U, hxU, a, (idealStalkMap_germ X ι x U hxU a).symm⟩

private lemma exists_stalk_generator
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) [Mono ι] (x : X)
    (f : ringStalk X x) (hf : GeneratesStalkIdeal X ι x f) :
    ∃ a : grpStalk X I.val x, idealStalkMap X ι x a = f ∧
      ∀ b : grpStalk X I.val x,
        ∃ r : ringStalk X x, b = r • a := by
  obtain ⟨U, hxU, a, ha⟩ := hf.1
  refine ⟨grpGerm X I.val x U hxU a, ?_, ?_⟩
  · exact (idealStalkMap_germ X ι x U hxU a).trans ha
  · intro b
    obtain ⟨r, hr⟩ := hf.2 _ (idealStalkMap_mem_stalkIdeal X ι x b)
    refine ⟨r, idealStalkMap_injective X ι x ?_⟩
    rwa [map_smul, idealStalkMap_germ, ha]

/-- An isomorphism of sheaves of modules induces an isomorphism on every stalk. -/
public noncomputable def moduleStalkIso
    {M N : SheafOfModules.{u} Oₓ} (e : M ≅ N) (x : X) :
    grpStalk X M.val x ≃ₗ[ringStalk X x]
      grpStalk X N.val x where
  __ := stalkMapL X M.val N.val e.hom.val x
  invFun := stalkMapL X N.val M.val e.inv.val x
  left_inv m := by
    have h := stalkMapL_comp X M N M e.hom e.inv x
    rw [e.hom_inv_id] at h
    have hid : stalkMapL X M.val M.val (SheafOfModules.Hom.val (𝟙 M)) x =
        LinearMap.id := stalkMapL_id X M x
    rw [hid] at h
    exact (congrArg (fun q => q m) h).symm
  right_inv m := by
    have h := stalkMapL_comp X N M N e.inv e.hom x
    rw [e.inv_hom_id] at h
    have hid : stalkMapL X N.val N.val (SheafOfModules.Hom.val (𝟙 N)) x =
        LinearMap.id := stalkMapL_id X N x
    rw [hid] at h
    exact (congrArg (fun q => q m) h).symm

open TensorProduct in
private lemma idealStalk_faithfulSMul
    (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I] (x : X) :
    FaithfulSMul (ringStalk X x) (grpStalk X I.val x) := by
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj I
  have : T.IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  let J := T.asEquivalence.inverse.obj 𝒪
  let e : T.obj J ≅ 𝒪 := T.asEquivalence.counitIso.app 𝒪
  let E := (tensorStalkIso X x J I).symm.trans
    ((moduleStalkIso X e x).trans (unitStalkLinearEquiv X x))
  -- `J` is spelled over the sheafification's structure sheaf, a spelling instance search does
  -- not see through, so the module structure on its stalk is supplied by hand.
  let : Module (ringStalk X x) (grpStalk X J.val x) :=
    Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X J.val x
  constructor
  intro r s hrs
  have h : ∀ t : grpStalk X J.val x ⊗[ringStalk X x]
      grpStalk X I.val x, r • t = s • t := by
    intro t
    induction t using TensorProduct.inductionOn with
    | add t u ht hu => simp only [smul_add, ht, hu]
    | tmul a b => rw [← tmul_smul, ← tmul_smul, hrs b]
  simpa only [map_smul, LinearEquiv.apply_symm_apply, smul_eq_mul, mul_one] using
    congrArg E (h (E.symm 1))

/-- The degree-`n` sheaf of the décalage, as the inverse image of the next
ideal power under the twisted differential. -/
public noncomputable abbrev etaTerm
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (n : ℤ) :
    SheafOfModules.{u} Oₓ :=
  pullback (idealPowerMap X I n (F.d n (n + 1)))
    (idealPowerIncl X I ι n (F.X (n + 1)))

/-- The differential data for the sheaf-theoretic décalage. The first equation
states that the restricted differential has, in degree `n + 1`, the section
recorded by the second projection of the defining pullback. -/
public structure EtaDifferentialData
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) where
  /-- The differential from the degree-`n` term to the degree-`(n + 1)` term. -/
  d : ∀ n : ℤ, etaTerm X I ι F n ⟶ etaTerm X I ι F (n + 1)
  d_fst : ∀ n : ℤ,
    d n ≫ pullback.fst
      (idealPowerMap X I (n + 1) (F.d (n + 1) ((n + 1) + 1)))
      (idealPowerIncl X I ι (n + 1) (F.X ((n + 1) + 1))) =
    pullback.snd
      (idealPowerMap X I n (F.d n (n + 1)))
      (idealPowerIncl X I ι n (F.X (n + 1)))
  d_comp_d : ∀ n : ℤ, d n ≫ d (n + 1) = 0

/-- The second projection of the degree-`n` fibre product is killed by the twisted differential
in degree `n + 1`, which is what lets the differential of `η_I F` be defined on it. -/
public theorem etaTerm_snd_comp_d_eq_zero
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (n : ℤ)
    (hmono : Mono (idealPowerIncl X I ι n (F.X ((n + 1) + 1)))) :
    pullback.snd (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1))) ≫
      idealPowerMap X I (n + 1) (F.d (n + 1) ((n + 1) + 1)) = 0 := by
  have := hmono
  apply (cancel_mono (idealPowerIncl X I ι n (F.X ((n + 1) + 1)))).mp
  rw [Category.assoc, ← idealPowerIncl_natural, ← Category.assoc,
    ← pullback.condition, Category.assoc, ← idealPowerMap_comp,
    F.d_comp_d, idealPowerMap_zero, comp_zero, zero_comp]

/-- The uniquely determined differential of décalage, constructed from the
termwise pullbacks. -/
public noncomputable def etaDifferentialData
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n)) :
    EtaDifferentialData X I ι F := by
  refine ⟨(fun n => pullback.lift
    (pullback.snd
      (idealPowerMap X I n (F.d n (n + 1)))
      (idealPowerIncl X I ι n (F.X (n + 1))))
    0 ?_), ?_, ?_⟩
  · rename_i n
    rw [zero_comp]
    exact etaTerm_snd_comp_d_eq_zero X I ι F n
      (idealPowerIncl_mono X I ι (F.X ((n + 1) + 1)) (hF _) n)
  · intro n
    exact pullback.lift_fst _ _ _
  · intro n
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, pullback.lift_snd]
      simp
    · rw [Category.assoc, pullback.lift_snd]
      simp

/-- The sheaf-theoretic décalage by an invertible ideal. -/
public noncomputable def etaObj
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n)) :
    CochainComplex (SheafOfModules.{u} Oₓ) ℤ :=
  let e := etaDifferentialData X I ι F hF
  CochainComplex.of (etaTerm X I ι F) e.d e.d_comp_d

/-- The term of `etaObj X I ι F hF` in degree `n` is `etaTerm X I ι F n`. -/
@[simp] public theorem etaObj_X
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaObj X I ι F hF).X n = etaTerm X I ι F n := rfl

/-- The complex obtained by taking the stalk of each term and differential. -/
public noncomputable def stalkComplex (x : X)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) :
    CochainComplex (ModuleCat.{u} (ringStalk X x)) ℤ := by
  let H := AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x
  letI : H.PreservesZeroMorphisms := ⟨by
    intro Y Z
    apply ModuleCat.hom_ext
    dsimp [H, AlgebraicGeometry.SheafOfModules.stalkFunctor,
      AlgebraicGeometry.SheafOfModules.stalkMap]
    ext z
    change (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((PresheafOfModules.toPresheaf ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).obj).map
        ((SheafOfModules.forget Oₓ).map (0 : Y ⟶ Z))) z = 0
    simp only [Functor.map_zero]
    rfl⟩
  let G := H ⋙ ModuleCat.restrictScalars
    (SemilinearStalk.commStalkIso X.presheaf x).inv.hom
  letI : G.PreservesZeroMorphisms := ⟨by
    intro Y Z
    change (ModuleCat.restrictScalars
      (SemilinearStalk.commStalkIso X.presheaf x).inv.hom).map
        (H.map (0 : Y ⟶ Z)) = 0
    rw [Functor.map_zero]
    rfl⟩
  exact (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj F

/-- The module-valued stalk functor, with scalars identified with the local
ring of the ringed space. -/
public noncomputable abbrev stalkModuleFunctor (x : X) :
    SheafOfModules.{u} Oₓ ⥤ ModuleCat.{u} (ringStalk X x) :=
  AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x ⋙ ModuleCat.restrictScalars
    (SemilinearStalk.commStalkIso X.presheaf x).inv.hom

private theorem stalkModuleFunctor_preservesFiniteLimits (X : RingedSpace.{u}) (x : X) :
    PreservesFiniteLimits (stalkModuleFunctor X x) := by
  let H := AlgebraicGeometry.SheafOfModules.stalkFunctor
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) x
  let U := forget₂ (ModuleCat.{u} (TopCat.Presheaf.stalk
    (C := RingCat.{u}) (X := X) ((Stacks.SheafOfModules.Tensor.ringSheaf
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).obj x))
        AddCommGrpCat.{u}
  have : PreservesFiniteLimits (H ⋙ U) := by
    change PreservesFiniteLimits
      (SheafOfModules.toSheaf ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))) ⋙
        (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
          TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x))
    have h1 : PreservesFiniteLimits (SheafOfModules.toSheaf.{u}
        ((Stacks.SheafOfModules.Tensor.ringSheaf
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)))) :=
      inferInstance
    have h2 : PreservesFiniteLimits (TopCat.Sheaf.forget AddCommGrpCat.{u} X ⋙
        TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x) :=
      TopCat.Sheaf.instPreservesFiniteLimitsCompPresheafForgetStalkFunctor x
    exact @comp_preservesFiniteLimits _ _ _ _ _ _ _ _ h1 h2
  have hH : PreservesFiniteLimits H := preservesFiniteLimits_of_reflects_of_preserves H U
  let E := ModuleCat.restrictScalarsEquivalenceOfRingEquiv
    (SemilinearStalk.commStalkRingEquiv X.presheaf x)
  have : E.inverse.IsEquivalence := inferInstance
  have : PreservesLimitsOfSize.{0, 0} E.inverse :=
    E.toAdjunction.rightAdjoint_preservesLimits
  exact @comp_preservesFiniteLimits _ _ _ _ _ _ H E.inverse hH
    (PreservesLimitsOfSize.preservesFiniteLimits E.inverse)


private lemma stalkModuleFunctor_smul_germ
    (M : SheafOfModules.{u} Oₓ) (x : X) (U : Opens X) (hxU : x ∈ U)
    (r : X.presheaf.obj (op U)) (m : M.val.obj (op U)) :
    ringGerm X x U hxU r •
      (show (stalkModuleFunctor X x).obj M from
        grpGerm X M.val x U hxU m) =
      grpGerm X M.val x U hxU
        ((Stacks.SheafOfModules.Tensor.ringSheafSectionModule
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)
          (op U) (M.val.obj (op U))).toSMul.smul r m) := by
  have h := SemilinearStalk.commStalkRingEquiv_germ X.presheaf x U hxU r
  have hi : (SemilinearStalk.commStalkIso X.presheaf x).inv.hom
      (ringGerm X x U hxU r) =
    (TopCat.Presheaf.germ (C := RingCat)
      (X.presheaf ⋙ forget₂ CommRingCat RingCat) U x hxU).hom r := by
    apply (SemilinearStalk.commStalkRingEquiv X.presheaf x).injective
    change (SemilinearStalk.commStalkRingEquiv X.presheaf x)
      ((SemilinearStalk.commStalkRingEquiv X.presheaf x).symm
        (X.presheaf.germ U x hxU r)) = _
    rw [RingEquiv.apply_symm_apply]
    exact h.symm
  change (SemilinearStalk.commStalkIso X.presheaf x).inv.hom
      (ringGerm X x U hxU r) •
      (TopCat.Presheaf.germ M.val.presheaf U x hxU).hom m = _
  rw [hi]
  exact (PresheafOfModules.germ_ringCat_smul M.val x U hxU r m).symm

/-- **The two spellings of the stalk of a sheaf of modules agree, `O_{X,x}`-linearly.**  The
stalk produced by `stalkModuleFunctor` — the `RingCat`-valued stalk functor of Tag 01AH followed
by restriction of scalars along `SemilinearStalk.commStalkIso` — and the stalk `grpStalk` of the
stalk calculus of Tag 01CB have the same underlying abelian group, and the two `O_{X,x}`-actions
on it agree, both being determined by the germ of a scalar acting on the germ of a section.

The underlying map is the identity, so this is the identification that lets a statement proved in
one spelling be used in the other; it is `no_expose` only because its scalar compatibility is
proved from private germ lemmas. -/
@[no_expose]
public noncomputable def stalkModuleLinearEquiv
    (M : SheafOfModules.{u} Oₓ) (x : X) :
    (stalkModuleFunctor X x).obj M ≃ₗ[ringStalk X x]
      grpStalk X M.val x where
  toFun m := m
  invFun m := m
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' r m := by
    obtain ⟨U, hxU, a, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf r
    obtain ⟨V, hxV, b, rfl⟩ :=
      TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat) M.val.presheaf m
    let W : Opens X := U ⊓ V
    have hxW : x ∈ W := ⟨hxU, hxV⟩
    have ha := X.presheaf.germ_res_apply (homOfLE (show W ≤ U from inf_le_left)) x hxW a
    have hb := grpGerm_res M V W inf_le_right x hxW b
    change (show grpStalk X M.val x from
      ringGerm X x U hxU a •
        (show (stalkModuleFunctor X x).obj M from grpGerm X M.val x V hxV b)) =
      ringGerm X x U hxU a • grpGerm X M.val x V hxV b
    change ringGerm X x W hxW
      ((X.presheaf.map (homOfLE inf_le_left).op).hom a) =
      ringGerm X x U hxU a at ha
    rw [← ha, ← hb]
    -- The `show … from` ascriptions above are `letFun` nodes, which `rw` will not look through;
    -- the two germ identities are therefore composed as terms.
    exact (stalkModuleFunctor_smul_germ X M x W hxW _ _).trans
      (stalkModule_germ_smul X M.val x W hxW _ _)

private lemma stalkModuleLinearEquiv_natural
    {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N) (x : X)
    (m : (stalkModuleFunctor X x).obj M) :
    stalkModuleLinearEquiv X N x ((stalkModuleFunctor X x).map a m) =
      stalkMapL X M.val N.val a.val x (stalkModuleLinearEquiv X M x m) := rfl

/-- Division by the generator `f` of the stalk ideal: multiplication by `f` lands in the range
of the injective map `ι_x : I_x → O_{X,x}`, and this is the induced map to `I_x`. No generator
of `I_x` is chosen; the unique preimage is taken instead. -/
private noncomputable def idealGeneratorMap
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    ringStalk X x →ₗ[
      ringStalk X x]
      grpStalk X I.val x :=
  LinearMap.codRestrictOfInjective (LinearMap.id.smulRight f) (idealStalkMap X ι x)
    (idealStalkMap_injective X ι x) fun r => by
      obtain ⟨a, ha, -⟩ := exists_stalk_generator X ι x f hf
      exact ⟨r • a, by rw [map_smul, ha]; rfl⟩

private lemma idealGeneratorMap_apply
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (r : ringStalk X x) :
    idealStalkMap X ι x (idealGeneratorMap X I ι x f hf r) = r * f :=
  LinearMap.codRestrictOfInjective_comp_apply _ _ _ _ r

private lemma idealGeneratorMap_injective
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    Function.Injective (idealGeneratorMap X I ι x f hf) := by
  have := idealStalk_faithfulSMul X I x
  intro r s hrs
  obtain ⟨a, ha, hgen⟩ := exists_stalk_generator X ι x f hf
  have hmul : r * f = s * f := by
    rw [← idealGeneratorMap_apply X I ι x f hf, ← idealGeneratorMap_apply X I ι x f hf, hrs]
  have hsmul : r • a = s • a := by
    apply idealStalkMap_injective X ι x
    rw [map_smul, map_smul, ha]
    simpa only [smul_eq_mul] using hmul
  apply FaithfulSMul.eq_of_smul_eq_smul
    (α := grpStalk X I.val x)
  intro b
  obtain ⟨t, rfl⟩ := hgen b
  rw [smul_comm r t, hsmul, smul_comm]

private lemma idealGeneratorMap_surjective
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    Function.Surjective (idealGeneratorMap X I ι x f hf) := by
  intro b
  obtain ⟨r, hr⟩ := hf.2 _ (idealStalkMap_mem_stalkIdeal X ι x b)
  exact ⟨r, idealStalkMap_injective X ι x
    ((idealGeneratorMap_apply X I ι x f hf r).trans hr.symm)⟩

/-- At a generator `f` of the stalk ideal, division by `f` identifies `O_{X,x}` with `I_x`. -/
private noncomputable def idealGeneratorEquiv
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    ringStalk X x ≃ₗ[
      ringStalk X x]
      grpStalk X I.val x :=
  LinearEquiv.ofBijective (idealGeneratorMap X I ι x f hf)
    ⟨idealGeneratorMap_injective X I ι x f hf, idealGeneratorMap_surjective X I ι x f hf⟩

private lemma idealGeneratorEquiv_map
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (r : ringStalk X x) :
    idealStalkMap X ι x (idealGeneratorEquiv X I ι x f hf r) = r * f :=
  idealGeneratorMap_apply X I ι x f hf r

/-- **At a point where the stalk ideal has a generator, the stalk of the ideal is free of rank
one.**  Division by the generator is the isomorphism `O_{X,x} ≅ I_x`; this records its inverse.
No local ring hypothesis is needed: the generator is given, rather than produced from the
triviality of the Picard group of a local ring. -/
public theorem nonempty_grpStalk_linearEquiv_of_generatesStalkIdeal
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    Nonempty (grpStalk X I.val x ≃ₗ[ringStalk X x] ringStalk X x) :=
  ⟨(idealGeneratorEquiv X I ι x f hf).symm⟩

open TensorProduct in
private noncomputable def tensorGeneratorEquiv
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    grpStalk X (idealPowerTerm X I 1 M).val x ≃ₗ[ringStalk X x]
      grpStalk X M.val x :=
  (tensorStalkIso X x M I).trans
    ((TensorProduct.congr (LinearEquiv.refl _ _)
      (idealGeneratorEquiv X I ι x f hf).symm).trans (TensorProduct.rid _ _))

open TensorProduct in
/-- Two linear maps out of a tensor product that agree on pure tensors agree everywhere. The
zero and additivity steps are taken here, where the element is a bound variable of a plain
module: at the use sites below the goal's type mentions both spellings of the ring sheaf, and
there `simp only [map_zero]` and `simp only [map_add]` no longer fire. -/
public lemma eq_of_forall_tmul {R : Type u} [CommRing R] {A B C : Type u}
    [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
    [AddCommGroup C] [Module R C]
    (L N : A ⊗[R] B →ₗ[R] C)
    (h : ∀ (a : A) (b : B), L (a ⊗ₜ[R] b) = N (a ⊗ₜ[R] b)) (t : A ⊗[R] B) : L t = N t :=
  LinearMap.congr_fun (TensorProduct.ext' h) t

open TensorProduct in
private lemma tensorGeneratorEquiv_smul
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (z : grpStalk X (idealPowerTerm X I 1 M).val x) :
    stalkMapL X _ _ (idealPowerIncl X I ι 0 M).val x z =
      f • tensorGeneratorEquiv X I ι M x f hf z := by
  obtain ⟨t, rfl⟩ := (tensorStalkIso X x M I).symm.surjective z
  -- Both sides are linear in `t`, so `eq_of_forall_tmul` reduces the claim to pure tensors.
  -- Running `TensorProduct.induction_on` here instead leaves the zero and additivity branches
  -- as goals `simp only [map_zero]`/`[map_add]` cannot close, since the stalk element's type
  -- mentions both spellings of the ring sheaf.
  refine eq_of_forall_tmul
    ((stalkMapL X (idealPowerTerm X I (0 + 1) M).val (idealPowerTerm X I 0 M).val
        (idealPowerIncl X I ι 0 M).val x) ∘ₗ (tensorStalkIso X x M I).symm.toLinearMap)
    (f • ((tensorGeneratorEquiv X I ι M x f hf).toLinearMap ∘ₗ
      (tensorStalkIso X x M I).symm.toLinearMap)) ?_ t
  intro m a
  change stalkMapL X (idealPowerTerm X I (0 + 1) M).val (idealPowerTerm X I 0 M).val
      (idealPowerIncl X I ι 0 M).val x
      ((tensorStalkIso X x M I).symm (m ⊗ₜ[ringStalk X x] a)) =
    f • tensorGeneratorEquiv X I ι M x f hf
      ((tensorStalkIso X x M I).symm (m ⊗ₜ[ringStalk X x] a))
  · obtain ⟨r, rfl⟩ := (idealGeneratorEquiv X I ι x f hf).surjective a
    rw [idealPowerIncl_zero_stalk_tmul, idealGeneratorEquiv_map]
    change (r * f) • m = f •
      (TensorProduct.rid (ringStalk X x) (grpStalk X M.val x))
        ((TensorProduct.congr (LinearEquiv.refl _ _)
          (idealGeneratorEquiv X I ι x f hf).symm)
          ((tensorStalkIso X x M I)
            ((tensorStalkIso X x M I).symm
              (m ⊗ₜ (idealGeneratorEquiv X I ι x f hf) r))))
    rw [(tensorStalkIso X x M I).apply_symm_apply]
    simp only [TensorProduct.congr_tmul, LinearEquiv.refl_apply,
      LinearEquiv.symm_apply_apply, TensorProduct.rid_tmul]
    simpa only [mul_smul] using smul_comm r f m

private noncomputable def idealPowerStepEquiv
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (stalkModuleFunctor X x).obj (idealPowerTerm X I (n + 1) M) ≃ₗ[ringStalk X x]
      (stalkModuleFunctor X x).obj (idealPowerTerm X I n M) :=
  haveI : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  (stalkModuleLinearEquiv X _ x).trans
    ((moduleStalkIso X
      (powSuccIso
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
            I).asEquivalence n M).symm x).trans
      ((tensorGeneratorEquiv X I ι (idealPowerTerm X I n M) x f hf).trans
        (stalkModuleLinearEquiv X _ x).symm))

private lemma idealPowerStepEquiv_smul
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ)
    (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I (n + 1) M)) :
    (stalkModuleFunctor X x).map (idealPowerIncl X I ι n M) z =
      f • idealPowerStepEquiv X I ι M x f hf n z := by
  have : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).IsEquivalence :=
    tensorRightFunctor_isEquivalence X.sheaf.obj (Oₓ).property I
  apply (stalkModuleLinearEquiv X _ x).injective
  rw [map_smul, stalkModuleLinearEquiv_natural]
  change _ = f • tensorGeneratorEquiv X I ι (idealPowerTerm X I n M) x f hf _
  -- `tensorGeneratorEquiv_smul` is applied to explicit arguments and composed with `Eq.trans`.
  -- Rewriting with it fails twice over: its own arguments include the module sheaf, which `rw`
  -- cannot instantiate across the two ring-sheaf spellings, and the stalk element appears in
  -- the goal under a different coercion path than the one the lemma's statement produces.
  refine Eq.trans ?_ (tensorGeneratorEquiv_smul X I ι (idealPowerTerm X I n M) x f hf
    (moduleStalkIso X (powSuccIso
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
          (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
            I).asEquivalence n M).symm x
      (stalkModuleLinearEquiv X (idealPowerTerm X I (n + 1) M) x z)))
  change stalkMapL X _ _ (idealPowerIncl X I ι n M).val x _ =
    ((stalkMapL X _ _ (idealPowerIncl X I ι 0 (idealPowerTerm X I n M)).val x).comp
      (stalkMapL X _ _
        (powSuccIso
          ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
            (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
              I).asEquivalence n M).inv.val x)) _
  -- The middle object of the composite has two spellings, the one `idealPowerIncl` produces
  -- and the one `powSuccIso` produces; supplying it as an explicit argument of
  -- `stalkMapL_comp` avoids having to unify them under a rewrite.
  exact LinearMap.congr_fun (stalkMapL_comp X (idealPowerTerm X I (n + 1) M)
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).asEquivalence.functor.obj
      (idealPowerTerm X I n M))
    (idealPowerTerm X I n M)
    (powSuccIso ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf)).flip.obj
        I).asEquivalence n M).inv
    (idealPowerIncl X I ι 0 (idealPowerTerm X I n M)) x) _

/-- **Multiplication by the ideal is multiplication by the generator, at a stalk (one
inclusion).**  Every value of the stalk of `I ⊗ M ⟶ M` is an `f`-multiple.

Stated as an existential rather than as an equality of submodules because the ambient module
can be named in two ways here — the tensor sheaf and the first ideal power — and only inside
this module are the two interchangeable; a consumer assembles the two inclusions into whichever
submodule spelling it needs, inside its own types. -/
public theorem exists_smul_eq_stalk_idealPowerIncl_zero
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I (0 + 1) M)) :
    ∃ w : (stalkModuleFunctor X x).obj (idealPowerTerm X I 0 M),
      (stalkModuleFunctor X x).map (idealPowerIncl X I ι 0 M) z = f • w :=
  ⟨idealPowerStepEquiv X I ι M x f hf 0 z, idealPowerStepEquiv_smul X I ι M x f hf 0 z⟩

/-- **Multiplication by the ideal is multiplication by the generator, at a stalk (the other
inclusion).**  Every `f`-multiple is a value of the stalk of `I ⊗ M ⟶ M`, because the stalk of
that inclusion is `f` times an isomorphism. -/
public theorem exists_stalk_idealPowerIncl_zero_eq_smul
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (w : (stalkModuleFunctor X x).obj (idealPowerTerm X I 0 M)) :
    ∃ z : (stalkModuleFunctor X x).obj (idealPowerTerm X I (0 + 1) M),
      (stalkModuleFunctor X x).map (idealPowerIncl X I ι 0 M) z = f • w := by
  refine ⟨(idealPowerStepEquiv X I ι M x f hf 0).symm w, ?_⟩
  refine Eq.trans (idealPowerStepEquiv_smul X I ι M x f hf 0 _) ?_
  exact congrArg (fun v => f • v) ((idealPowerStepEquiv X I ι M x f hf 0).apply_symm_apply w)

/-- Given linear equivalences `s n : P (n + 1) ≃ₗ[R] P n` for all integers `n`, the linear
equivalence `P n ≃ₗ[R] P 0` obtained by composing them, for every integer `n`. -/
public noncomputable def integerLinearEquiv
    {R : Type u} [CommRing R] (P : ℤ → Type v)
    [∀ n, AddCommGroup (P n)] [∀ n, Module R (P n)]
    (s : ∀ n, P (n + 1) ≃ₗ[R] P n) (n : ℤ) : P n ≃ₗ[R] P 0 :=
  Int.inductionOn' n 0 (LinearEquiv.refl _ _)
    (fun k _ e => (s k).trans e)
    (fun k _ e => (s (k - 1)).symm.trans
      (cast (congrArg (fun m => P m ≃ₗ[R] P 0) (show k = k - 1 + 1 by ring)) e))

/-- In degree `0`, `integerLinearEquiv` is the identity. -/
lemma integerLinearEquiv_zero
    {R : Type u} [CommRing R] (P : ℤ → Type v)
    [∀ n, AddCommGroup (P n)] [∀ n, Module R (P n)]
    (s : ∀ n, P (n + 1) ≃ₗ[R] P n) :
    integerLinearEquiv P s 0 = LinearEquiv.refl _ _ := by
  simp only [integerLinearEquiv, Int.inductionOn'_self]

/-- `integerLinearEquiv` in degree `n + 1` is `integerLinearEquiv` in degree `n` precomposed with
`s n`. -/
lemma integerLinearEquiv_succ
    {R : Type u} [CommRing R] (P : ℤ → Type v)
    [∀ n, AddCommGroup (P n)] [∀ n, Module R (P n)]
    (s : ∀ n, P (n + 1) ≃ₗ[R] P n) (n : ℤ) (z : P (n + 1)) :
    integerLinearEquiv P s n (s n z) = integerLinearEquiv P s (n + 1) z := by
  by_cases hn : 0 ≤ n
  · simp only [integerLinearEquiv, Int.inductionOn'_add_one hn, LinearEquiv.trans_apply]
  · have h : n + 1 ≤ 0 := by omega
    have he := Int.inductionOn'_sub_one
      (motive := fun n => P n ≃ₗ[R] P 0)
      (zero := LinearEquiv.refl R (P 0))
      (succ := fun k _ e => (s k).trans e)
      (pred := fun k _ e => (s (k - 1)).symm.trans (by rw [sub_add_cancel]; exact e)) h
    change integerLinearEquiv P s (n + 1 - 1) = _ at he
    have he' : integerLinearEquiv P s n =
        (s n).symm.trans (integerLinearEquiv P s (n + 1)) := by
      convert! he using 1 <;> congr! 3 <;> try omega
      exact (cast_heq _ _).symm
    rw [he']
    simp only [LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply]

private noncomputable def idealPowerStalkLinearMap
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (stalkModuleFunctor X x).obj (idealPowerTerm X I n M) →ₗ[ringStalk X x]
      EtaPow.Loc f ((stalkModuleFunctor X x).obj M) :=
  (EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) n).comp
    (integerLinearEquiv (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
      (idealPowerStepEquiv X I ι M x f hf) n).toLinearMap

private lemma idealPowerStalkLinearMap_zero
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    idealPowerStalkLinearMap X I ι M x f hf 0 = EtaPow.toLoc f _ := by
  -- The zeroth power map is the localization map. Both halves of that are stated separately —
  -- the transition equivalence at `0` is the identity, and `f^0 • ·` is the identity — so that
  -- neither has to be found by `simp` inside a goal whose type mentions the sheaf spellings.
  have hzero : ∀ (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I 0 M)),
      (integerLinearEquiv
          (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
          (idealPowerStepEquiv X I ι M x f hf) 0) z = z :=
    fun z => congrArg (fun q => q z)
      (integerLinearEquiv_zero
        (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
        (idealPowerStepEquiv X I ι M x f hf))
  have hpow : ∀ (w : (stalkModuleFunctor X x).obj M),
      EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) 0 w =
        EtaPow.toLoc f ((stalkModuleFunctor X x).obj M) w := by
    intro w
    rw [EtaPow.fpowMap_apply, zpow_zero, one_smul]
  ext z
  exact Eq.trans
    (congrArg (fun w => EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) 0 w) (hzero z))
    (hpow z)

private lemma idealPowerStalkLinearMap_succ
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ)
    (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I (n + 1) M)) :
    idealPowerStalkLinearMap X I ι M x f hf n
      ((stalkModuleFunctor X x).map (idealPowerIncl X I ι n M) z) =
    idealPowerStalkLinearMap X I ι M x f hf (n + 1) z := by
  dsimp only [idealPowerStalkLinearMap, LinearMap.comp_apply, LinearEquiv.coe_coe]
  -- In the goal the transition equivalence sits behind its linear-map coercion, which
  -- `integerLinearEquiv_succ` does not see; do that step in its own statement instead and
  -- transport it with `congrArg`.
  have hinner :
      integerLinearEquiv (fun k => (stalkModuleFunctor X x).obj (idealPowerTerm X I k M))
            (idealPowerStepEquiv X I ι M x f hf) n
          ((stalkModuleFunctor X x).map (idealPowerIncl X I ι n M) z) =
        f • integerLinearEquiv
            (fun k => (stalkModuleFunctor X x).obj (idealPowerTerm X I k M))
            (idealPowerStepEquiv X I ι M x f hf) (n + 1) z := by
    rw [idealPowerStepEquiv_smul X I ι M x f hf, map_smul,
      integerLinearEquiv_succ
        (fun k => (stalkModuleFunctor X x).obj (idealPowerTerm X I k M))
        (idealPowerStepEquiv X I ι M x f hf) n z]
  -- `f • ·` followed by `f^n • ι ·` is `f^(n+1) • ι ·`. Stated with the element as a bound
  -- variable, this is a fact about plain modules and `rw` can do it; stated against the goal it
  -- cannot, because there the element's type still mentions both ring-sheaf spellings.
  have hpow : ∀ (w : (stalkModuleFunctor X x).obj M),
      EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) n (f • w) =
        EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) (n + 1) w := by
    intro w
    rw [EtaPow.fpowMap_apply, EtaPow.fpowMap_apply, map_smul,
      ← EtaPow.fUnit_units_smul, smul_smul, zpow_add, zpow_one]
  refine Eq.trans (congrArg
    (fun w => EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) n w) hinner) ?_
  exact hpow _

private lemma idealPowerStalkLinearMap_range
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    LinearMap.range (idealPowerStalkLinearMap X I ι M x f hf n) =
      EtaPow.fpowSub f ((stalkModuleFunctor X x).obj M) n := by
  rw [EtaPow.fpowSub_eq_range]
  let e := integerLinearEquiv
    (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
    (idealPowerStepEquiv X I ι M x f hf) n
  ext z
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨e y, rfl⟩
  · rintro ⟨y, rfl⟩
    refine ⟨e.symm y, ?_⟩
    change EtaPow.fpowMap f _ n (e (e.symm y)) = _
    exact congrArg (fun w => EtaPow.fpowMap f ((stalkModuleFunctor X x).obj M) n w)
      (e.apply_symm_apply y)

private lemma stalkModuleFunctor_map_injective
    {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N) [Mono a] (x : X) :
    Function.Injective ((stalkModuleFunctor X x).map a) :=
  stalkMapL_injective_of_mono X a x

private lemma stalkGenerator_isSMulRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    IsSMulRegular ((stalkModuleFunctor X x).obj M) f := by
  have := idealPowerIncl_mono X I ι M hM 0
  intro a b hab
  let e := idealPowerStepEquiv X I ι M x f hf 0
  have h := stalkModuleFunctor_map_injective X (idealPowerIncl X I ι 0 M) x
  have he : e.symm a = e.symm b := h (by
    rw [idealPowerStepEquiv_smul X I ι M x f hf,
      idealPowerStepEquiv_smul X I ι M x f hf]
    change f • e (e.symm a) = f • e (e.symm b)
    -- `simp only [LinearEquiv.apply_symm_apply]` does not fire on this goal, so the two
    -- cancellations are applied as ground equations around `hab`.
    exact Eq.trans (congrArg (fun w => f • w) (e.apply_symm_apply a))
      (Eq.trans hab (congrArg (fun w => f • w) (e.apply_symm_apply b)).symm))
  exact e.symm.injective he

private lemma idealPowerStalkLinearMap_injective
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    Function.Injective (idealPowerStalkLinearMap X I ι M x f hf n) := by
  intro a b hab
  apply (integerLinearEquiv
    (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
    (idealPowerStepEquiv X I ι M x f hf) n).injective
  apply EtaPow.toLoc_injective_of_isSMulRegular
    (stalkGenerator_isSMulRegular X I ι M hM x f hf)
  exact EtaPow.fUnit_zpow_smul_injective n hab

private lemma linearMap_eq_of_integer_succ
    {R : Type u} [CommRing R] (P : ℤ → Type v)
    [∀ n, AddCommGroup (P n)] [∀ n, Module R (P n)]
    {Q : Type w} [AddCommGroup Q] [Module R Q]
    (f : R) (hf : IsSMulRegular Q f) (s : ∀ n, P (n + 1) ≃ₗ[R] P n)
    (p q : ∀ n, P n →ₗ[R] Q) (hzero : p 0 = q 0)
    (hp : ∀ n z, p n (f • s n z) = p (n + 1) z)
    (hq : ∀ n z, q n (f • s n z) = q (n + 1) z)
    (n : ℤ) : p n = q n := by
  induction n using (Int.inductionOn' · 0) with
  | zero => exact hzero
  | succ k hk ih =>
    ext z
    rw [← hp, ← hq, ih]
  | pred k hk ih =>
    ext z
    obtain ⟨w, rfl⟩ := (s (k - 1)).surjective z
    apply hf
    change f • p (k - 1) (s (k - 1) w) = f • q (k - 1) (s (k - 1) w)
    rw [← (p (k - 1)).map_smul, ← (q (k - 1)).map_smul, hp, hq]
    have ih' : p (k - 1 + 1) = q (k - 1 + 1) := by
      rwa [sub_add_cancel]
    exact LinearMap.congr_fun ih' w

/-- A generator `f` acts injectively on its own localization. -/
private lemma isSMulRegular_loc {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M]
    [Module A M] (f : A) : IsSMulRegular (EtaPow.Loc f M) f := fun a b h =>
  EtaPow.fUnit_zpow_smul_injective 1 (by simpa only [zpow_one, EtaPow.fUnit_units_smul] using h)

private lemma idealPowerStalkLinearMap_natural
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ)
    (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I n M)) :
    EtaPow.fLoc f ((stalkModuleFunctor X x).map a).hom
        (idealPowerStalkLinearMap X I ι M x f hf n z) =
      idealPowerStalkLinearMap X I ι N x f hf n
        ((stalkModuleFunctor X x).map (idealPowerMap X I n a) z) := by
  let G := stalkModuleFunctor X x
  have hn (k : ℤ) (w : G.obj (idealPowerTerm X I (k + 1) M)) :
      G.map (idealPowerMap X I k a) (G.map (idealPowerIncl X I ι k M) w) =
        G.map (idealPowerIncl X I ι k N) (G.map (idealPowerMap X I (k + 1) a) w) :=
    ConcreteCategory.congr_hom
      (by simpa only [Functor.map_comp] using
        congrArg G.map (idealPowerIncl_natural X I ι k a)) w
  have := linearMap_eq_of_integer_succ
    (fun k => G.obj (idealPowerTerm X I k M)) f (isSMulRegular_loc f)
    (idealPowerStepEquiv X I ι M x f hf)
    (fun k => (EtaPow.fLoc f (G.map a).hom).comp (idealPowerStalkLinearMap X I ι M x f hf k))
    (fun k => (idealPowerStalkLinearMap X I ι N x f hf k).comp
      (G.map (idealPowerMap X I k a)).hom) ?_ ?_ ?_ n
  · exact LinearMap.congr_fun this z
  · ext w
    exact (congrArg _ (LinearMap.congr_fun (idealPowerStalkLinearMap_zero X I ι M x f hf) w)).trans
      ((EtaPow.fLoc_toLoc _ _).trans
        (LinearMap.congr_fun (idealPowerStalkLinearMap_zero X I ι N x f hf) _).symm)
  · intro k w
    rw [← idealPowerStepEquiv_smul X I ι M x f hf]
    exact congrArg (EtaPow.fLoc f (G.map a).hom) (idealPowerStalkLinearMap_succ X I ι M x f hf k w)
  · intro k w
    rw [← idealPowerStepEquiv_smul X I ι M x f hf]
    exact (congrArg (idealPowerStalkLinearMap X I ι N x f hf k) (hn k w)).trans
      (idealPowerStalkLinearMap_succ X I ι N x f hf k _)

/-- The normalized comparison from the stalk of every integer ideal power to
the localization of the original stalk. The zeroth comparison is localization;
successive comparisons agree with the ideal-power inclusions. -/
public structure IdealPowerStalkComparison
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X)
    (f : ringStalk X x) where
  /-- The comparison map from the stalk of the degree-`n` ideal power of `M` to the
  localization `(M_x)_f`. -/
  map : ∀ n : ℤ,
    (stalkModuleFunctor X x).obj (idealPowerTerm X I n M) ⟶
      ModuleCat.of (ringStalk X x)
        (EtaPow.Loc f ((stalkModuleFunctor X x).obj M))
  zero : map 0 = ModuleCat.ofHom
    (EtaPow.toLoc f ((stalkModuleFunctor X x).obj M))
  succ : ∀ n : ℤ,
    (stalkModuleFunctor X x).map (idealPowerIncl X I ι n M) ≫ map n = map (n + 1)
  range : ∀ n : ℤ,
    LinearMap.range (map n).hom =
      EtaPow.fpowSub f ((stalkModuleFunctor X x).obj M) n

/-- The generator-normalized local comparison of the ideal-power filtration: in degree `n` it
is division by `f^n`, landing in `f^{-n} M_x ⊆ (M_x)_f`. -/
@[no_expose]
public noncomputable def idealPowerStalkComparison
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X)
    (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    IdealPowerStalkComparison X I ι M x f where
  map n := ModuleCat.ofHom
    (X := (stalkModuleFunctor X x).obj (idealPowerTerm X I n M))
    (idealPowerStalkLinearMap X I ι M x f hf n)
  zero := congrArg (ModuleCat.ofHom (X := (stalkModuleFunctor X x).obj M))
    (idealPowerStalkLinearMap_zero X I ι M x f hf)
  succ n := by
    apply ModuleCat.hom_ext
    ext z
    exact idealPowerStalkLinearMap_succ X I ι M x f hf n z
  range := idealPowerStalkLinearMap_range X I ι M x f hf

private lemma idealPowerStalkComparison_map
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (c : IdealPowerStalkComparison X I ι M x f) (n : ℤ) :
    (c.map n).hom = idealPowerStalkLinearMap X I ι M x f hf n := by
  refine linearMap_eq_of_integer_succ
    (fun n => (stalkModuleFunctor X x).obj (idealPowerTerm X I n M)) f
    (isSMulRegular_loc f)
    (idealPowerStepEquiv X I ι M x f hf)
    (fun n => (c.map n).hom) (idealPowerStalkLinearMap X I ι M x f hf) ?_ ?_ ?_ n
  · rw [c.zero, idealPowerStalkLinearMap_zero]
    rfl
  · intro k z
    rw [← idealPowerStepEquiv_smul X I ι M x f hf]
    exact ConcreteCategory.congr_hom (c.succ k) z
  · intro k z
    rw [← idealPowerStepEquiv_smul X I ι M x f hf]
    exact idealPowerStalkLinearMap_succ X I ι M x f hf k z

/-- The comparison of the ideal-power filtration with the powers of a generator is unique: its
three defining properties determine it in every degree, so the normalization used by
`etaStalkIso_hom` involves no choice beyond that of the generator `f`. -/
public theorem IdealPowerStalkComparison.map_eq
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (M : SheafOfModules.{u} Oₓ) (x : X)
    (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f)
    (c : IdealPowerStalkComparison X I ι M x f) (n : ℤ) :
    c.map n = (idealPowerStalkComparison X I ι M x f hf).map n := by
  apply ModuleCat.hom_ext
  exact idealPowerStalkComparison_map X I ι M x f hf c n

/-- **A generator of the stalk ideal is regular on the stalk of an `I`-torsion-free module.**
Multiplication by the ideal is injective on the stalk because the inclusion of the first ideal
power is a monomorphism, and at the stalk that inclusion is `f` times an isomorphism
(`idealPowerStepEquiv`).

No hypothesis on the stalks of the structure sheaf is needed: the generator `f` is given, so the
freeness of the stalk of `I` that produces one is not used here. -/
public alias isSMulRegular_stalk_of_generatesStalkIdeal := stalkGenerator_isSMulRegular

/-- **The normalized comparison of the ideal-power filtration is injective** in every degree, on
an `I`-torsion-free module: division by `f^n` is injective on the stalk because `f` is regular
there (`isSMulRegular_stalk_of_generatesStalkIdeal`).

Together with the `range` field of `IdealPowerStalkComparison` this makes `map n` an isomorphism
of the stalk of the `n`-th ideal power onto the submodule `f^n M_x` of `(M_x)_f`, which is what a
consumer outside this module needs in order to read the ideal-power filtration at a stalk as the
`f`-power filtration. -/
public theorem idealPowerStalkComparison_map_injective
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (hM : IsIdealTorsionFree X ι M)
    (x : X) (f : ringStalk X x) (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    Function.Injective ((idealPowerStalkComparison X I ι M x f hf).map n).hom :=
  idealPowerStalkLinearMap_injective X I ι M hM x f hf n

/-- **The normalized comparison of the ideal-power filtration is natural in the module.**  The
stalk of the `n`-th twist `I^{⊗ n} ⊗ a` of a map of modules becomes, after division by `f^n`, the
localization of the stalk of `a` itself. -/
public theorem idealPowerStalkComparison_map_natural
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (a : M ⟶ N)
    (x : X) (f : ringStalk X x) (hf : GeneratesStalkIdeal X ι x f) (n : ℤ)
    (z : (stalkModuleFunctor X x).obj (idealPowerTerm X I n M)) :
    EtaPow.fLoc f ((stalkModuleFunctor X x).map a).hom
        ((idealPowerStalkComparison X I ι M x f hf).map n z) =
      (idealPowerStalkComparison X I ι N x f hf).map n
        ((stalkModuleFunctor X x).map (idealPowerMap X I n a) z) :=
  idealPowerStalkLinearMap_natural X I ι a x f hf n z

/-- A pullback `P` of `d` and `i`, identified through `a ∘ p` with the submodule of `L` cut out by
the image of `a` and the preimage under `t` of the image of `b`, given injections `a`, `b`, `c`
compatible with `t`, `d` and `i`. -/
noncomputable def pullbackRangeEquiv
    {R : Type u} [CommRing R] {P A B C L K : ModuleCat.{u} R}
    {p : P ⟶ A} {q : P ⟶ B} {d : A ⟶ C} {i : B ⟶ C}
    (hp : IsPullback p q d i)
    (a : A →ₗ[R] L) (b : B →ₗ[R] K) (c : C →ₗ[R] K) (t : L →ₗ[R] K)
    (ha : Function.Injective a) (hb : Function.Injective b) (hc : Function.Injective c)
    (hd : t.comp a = c.comp d.hom) (hi : c.comp i.hom = b) :
    P ≃ₗ[R] ↥(LinearMap.range a ⊓ (LinearMap.range b).comap t) := by
  have hd' (z : A) : t (a z) = c (d z) := LinearMap.congr_fun hd z
  have hi' (z : B) : c (i z) = b z := LinearMap.congr_fun hi z
  have hcomm (z : P) : t (a (p z)) = b (q z) := by
    rw [hd', ← hi']
    exact congrArg c (ConcreteCategory.congr_hom hp.w z)
  let l : P →ₗ[R] ↥(LinearMap.range a ⊓ (LinearMap.range b).comap t) :=
    (a.comp p.hom).codRestrict _ (fun z => ⟨⟨p z, rfl⟩, ⟨q z, (hcomm z).symm⟩⟩)
  have ht := hp.map (forget (ModuleCat.{u} R))
  refine LinearEquiv.ofBijective l ⟨?_, ?_⟩
  · intro z w hzw
    have he : p z = p w := ha (congrArg Subtype.val hzw)
    apply Types.ext_of_isPullback ht he
    apply hb
    change b (q z) = b (q w)
    rw [← hcomm, ← hcomm, he]
  · intro z
    obtain ⟨v, hv⟩ := z.property.1
    obtain ⟨w, hw⟩ := z.property.2
    have he : d v = i w := hc (by
      rw [← hd', hi', hv, hw])
    obtain ⟨y, hy, _⟩ := Types.exists_of_isPullback ht v w he
    refine ⟨y, Subtype.ext ?_⟩
    change a (p y) = z.val
    change p y = v at hy
    rw [hy, hv]

/-- `pullbackRangeEquiv` is `a ∘ p` on elements. -/
lemma pullbackRangeEquiv_apply
    {R : Type u} [CommRing R] {P A B C L K : ModuleCat.{u} R}
    {p : P ⟶ A} {q : P ⟶ B} {d : A ⟶ C} {i : B ⟶ C}
    (hp : IsPullback p q d i)
    (a : A →ₗ[R] L) (b : B →ₗ[R] K) (c : C →ₗ[R] K) (t : L →ₗ[R] K)
    (ha : Function.Injective a) (hb : Function.Injective b) (hc : Function.Injective c)
    (hd : t.comp a = c.comp d.hom) (hi : c.comp i.hom = b) (z : P) :
    (pullbackRangeEquiv hp a b c t ha hb hc hd hi z).val = a (p z) := rfl

/-- The fibre product of `d` and `i`, identified with the submodule `S` of `L` cut out by the
image of `a` and the preimage under `t` of the image of `b`. -/
noncomputable def pullbackSubmoduleIso
    {R : Type u} [CommRing R] {P A B C L K : ModuleCat.{u} R}
    {p : P ⟶ A} {q : P ⟶ B} {d : A ⟶ C} {i : B ⟶ C}
    (hp : IsPullback p q d i)
    (a : A →ₗ[R] L) (b : B →ₗ[R] K) (c : C →ₗ[R] K) (t : L →ₗ[R] K)
    (ha : Function.Injective a) (hb : Function.Injective b) (hc : Function.Injective c)
    (hd : t.comp a = c.comp d.hom) (hi : c.comp i.hom = b)
    (S : Submodule R L) (hS : LinearMap.range a ⊓ (LinearMap.range b).comap t = S) :
    P ≅ ModuleCat.of R S :=
  ((pullbackRangeEquiv hp a b c t ha hb hc hd hi).trans
    (LinearEquiv.ofEq _ S hS)).toModuleIso

/-- `pullbackSubmoduleIso` followed by the inclusion of `S` is `p` followed by `a`. -/
lemma pullbackSubmoduleIso_hom
    {R : Type u} [CommRing R] {P A B C L K : ModuleCat.{u} R}
    {p : P ⟶ A} {q : P ⟶ B} {d : A ⟶ C} {i : B ⟶ C}
    (hp : IsPullback p q d i)
    (a : A →ₗ[R] L) (b : B →ₗ[R] K) (c : C →ₗ[R] K) (t : L →ₗ[R] K)
    (ha : Function.Injective a) (hb : Function.Injective b) (hc : Function.Injective c)
    (hd : t.comp a = c.comp d.hom) (hi : c.comp i.hom = b)
    (S : Submodule R L) (hS : LinearMap.range a ⊓ (LinearMap.range b).comap t = S) :
    (pullbackSubmoduleIso hp a b c t ha hb hc hd hi S hS).hom ≫
        ModuleCat.ofHom S.subtype = p ≫ ModuleCat.ofHom a := by
  apply ModuleCat.hom_ext
  refine LinearMap.ext fun z => ?_
  change ((LinearEquiv.ofEq _ S hS)
    (pullbackRangeEquiv hp a b c t ha hb hc hd hi z) : L) = a (p z)
  rw [LinearEquiv.coe_ofEq_apply]
  exact pullbackRangeEquiv_apply hp a b c t ha hb hc hd hi z

private lemma etaTerm_stalk_range_inf
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    LinearMap.range (idealPowerStalkLinearMap X I ι (F.X n) x f hf n) ⊓
        (LinearMap.range
          (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf (n + 1))).comap
          (EtaPow.fLoc f ((stalkModuleFunctor X x).map (F.d n (n + 1))).hom) =
      EtaComplex.term f (stalkComplex X x F) n := by
  rw [idealPowerStalkLinearMap_range, idealPowerStalkLinearMap_range]
  rfl

private lemma idealPowerStalkLinearMap_comp_natural
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (EtaPow.fLoc f ((stalkModuleFunctor X x).map (F.d n (n + 1))).hom).comp
        (idealPowerStalkLinearMap X I ι (F.X n) x f hf n) =
      (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf n).comp
        ((stalkModuleFunctor X x).map (idealPowerMap X I n (F.d n (n + 1)))).hom := by
  ext z
  exact idealPowerStalkLinearMap_natural X I ι (F.d n (n + 1)) x f hf n z

private lemma idealPowerStalkLinearMap_comp_succ
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ)
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (idealPowerStalkLinearMap X I ι M x f hf n).comp
        ((stalkModuleFunctor X x).map (idealPowerIncl X I ι n M)).hom =
      idealPowerStalkLinearMap X I ι M x f hf (n + 1) := by
  ext z
  exact idealPowerStalkLinearMap_succ X I ι M x f hf n z

/-- In degree `n` the stalk of the décalage term is the degree-`n` term of the décalage of the
stalk complex: the defining fibre product is carried by the normalized ideal-power comparisons
onto the intersection of `f^{-n} F^n_x` with the preimage of `f^{-(n+1)} F^{n+1}_x`. -/
private noncomputable def etaTermStalkIso
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (stalkModuleFunctor X x).obj (etaTerm X I ι F n) ≅
      ModuleCat.of _ (EtaComplex.term f (stalkComplex X x F) n) :=
  letI := stalkModuleFunctor_preservesFiniteLimits X x
  pullbackSubmoduleIso
    (L := ModuleCat.of _ (EtaPow.Loc f ((stalkModuleFunctor X x).obj (F.X n))))
    (K := ModuleCat.of _ (EtaPow.Loc f ((stalkModuleFunctor X x).obj (F.X (n + 1)))))
    ((IsPullback.of_hasPullback (idealPowerMap X I n (F.d n (n + 1)))
      (idealPowerIncl X I ι n (F.X (n + 1)))).map (stalkModuleFunctor X x))
    (idealPowerStalkLinearMap X I ι (F.X n) x f hf n)
    (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf (n + 1))
    (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf n)
    (EtaPow.fLoc f ((stalkModuleFunctor X x).map (F.d n (n + 1))).hom)
    (idealPowerStalkLinearMap_injective X I ι _ (hF n) x f hf n)
    (idealPowerStalkLinearMap_injective X I ι _ (hF (n + 1)) x f hf (n + 1))
    (idealPowerStalkLinearMap_injective X I ι _ (hF (n + 1)) x f hf n)
    (idealPowerStalkLinearMap_comp_natural X I ι F x f hf n)
    (idealPowerStalkLinearMap_comp_succ X I ι (F.X (n + 1)) x f hf n)
    _ (etaTerm_stalk_range_inf X I ι F x f hf n)

private lemma etaTermStalkIso_hom
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (etaTermStalkIso X I ι F hF x f hf n).hom ≫
        ModuleCat.ofHom (EtaComplex.term f (stalkComplex X x F) n).subtype =
      (stalkModuleFunctor X x).map
        (pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1)))) ≫
        ModuleCat.ofHom
          (X := (stalkModuleFunctor X x).obj (idealPowerTerm X I n (F.X n)))
          (idealPowerStalkLinearMap X I ι (F.X n) x f hf n) :=
  let := stalkModuleFunctor_preservesFiniteLimits X x
  pullbackSubmoduleIso_hom _ _ _ _ _ _ _ _ _ _ _
    (etaTerm_stalk_range_inf X I ι F x f hf n)

/-- The differential of `η_I F` followed by the first projection of the target fibre product is
the second projection of the source fibre product. -/
lemma etaObj_d_fst
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n)) (n : ℤ) :
    (etaObj X I ι F hF).d n (n + 1) ≫
        pullback.fst (idealPowerMap X I (n + 1) (F.d (n + 1) (n + 1 + 1)))
          (idealPowerIncl X I ι (n + 1) (F.X (n + 1 + 1))) =
      pullback.snd (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1))) := by
  simpa only [etaObj, CochainComplex.of_d] using
    (etaDifferentialData X I ι F hF).d_fst n

/-- The degreewise comparisons commute with the differentials: both sides agree after the
monomorphism into the localization, where the square becomes the defining condition of the
fibre product together with the naturality of the ideal-power comparisons. -/
private lemma etaTermStalkIso_comm
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n, IsIdealTorsionFree X ι (F.X n))
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (etaTermStalkIso X I ι F hF x f hf n).hom ≫
        (EtaComplex.etaObject f (stalkComplex X x F)).d n (n + 1) =
      (stalkComplex X x (etaObj X I ι F hF)).d n (n + 1) ≫
        (etaTermStalkIso X I ι F hF x f hf (n + 1)).hom := by
  set G := stalkModuleFunctor X x with hG
  set C := stalkComplex X x F with hC
  let p (k : ℤ) := pullback.fst (idealPowerMap X I k (F.d k (k + 1)))
    (idealPowerIncl X I ι k (F.X (k + 1)))
  let q (k : ℤ) := pullback.snd (idealPowerMap X I k (F.d k (k + 1)))
    (idealPowerIncl X I ι k (F.X (k + 1)))
  let a (k : ℤ) := ModuleCat.ofHom
    (X := G.obj (idealPowerTerm X I k (F.X k)))
    (idealPowerStalkLinearMap X I ι (F.X k) x f hf k)
  let v (k : ℤ) := ModuleCat.ofHom (EtaComplex.term f C k).subtype
  let t := ModuleCat.ofHom (EtaPow.fLoc f (G.map (F.d n (n + 1))).hom)
  let b := ModuleCat.ofHom
    (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf (n + 1))
  let c := ModuleCat.ofHom
    (idealPowerStalkLinearMap X I ι (F.X (n + 1)) x f hf n)
  have he (k : ℤ) : (etaTermStalkIso X I ι F hF x f hf k).hom ≫ v k = G.map (p k) ≫ a k :=
    etaTermStalkIso_hom X I ι F hF x f hf k
  have hd : (EtaComplex.etaObject f C).d n (n + 1) ≫ v (n + 1) = v n ≫ t := by
    rw [EtaComplex.etaObject_d]
    rfl
  have hn : a n ≫ t = G.map (idealPowerMap X I n (F.d n (n + 1))) ≫ c :=
    ModuleCat.hom_ext (idealPowerStalkLinearMap_comp_natural X I ι F x f hf n)
  have hs : G.map (idealPowerIncl X I ι n (F.X (n + 1))) ≫ c = b :=
    ModuleCat.hom_ext (idealPowerStalkLinearMap_comp_succ X I ι (F.X (n + 1)) x f hf n)
  have hE : (stalkComplex X x (etaObj X I ι F hF)).d n (n + 1) ≫ G.map (p (n + 1)) =
      G.map (q n) := by
    change G.map ((etaObj X I ι F hF).d n (n + 1)) ≫ G.map (p (n + 1)) = G.map (q n)
    exact (G.map_comp ((etaObj X I ι F hF).d n (n + 1)) (p (n + 1))).symm.trans
      (congrArg (fun k => G.map k) (etaObj_d_fst X I ι F hF n))
  have hmono : Mono (v (n + 1)) := (ModuleCat.mono_iff_injective _).mpr Subtype.val_injective
  apply (cancel_mono (v (n + 1))).mp
  -- Each step is a separately stated `have`, so that its statement is elaborated on its own
  -- rather than as a `calc` chain: `calc` cannot synthesize the `Trans` instance here, because
  -- the middle term of the chain is type-correct only at `default` transparency.
  have step₁ : ((etaTermStalkIso X I ι F hF x f hf n).hom ≫
      (EtaComplex.etaObject f C).d n (n + 1)) ≫ v (n + 1) = (G.map (p n) ≫ a n) ≫ t :=
    (Category.assoc (etaTermStalkIso X I ι F hF x f hf n).hom
        ((EtaComplex.etaObject f C).d n (n + 1)) (v (n + 1))).trans
      ((congrArg (fun k => (etaTermStalkIso X I ι F hF x f hf n).hom ≫ k) hd).trans
        ((Category.assoc (etaTermStalkIso X I ι F hF x f hf n).hom (v n) t).symm.trans
          (congrArg (fun k => k ≫ t) (he n))))
  have step₂ : (G.map (p n) ≫ a n) ≫ t = G.map (q n) ≫ b := by
    rw [Category.assoc, hn, ← Category.assoc, ← G.map_comp,
      pullback.condition, G.map_comp, Category.assoc, hs]
  have step₃ : G.map (q n) ≫ b =
      ((stalkComplex X x (etaObj X I ι F hF)).d n (n + 1) ≫
        (etaTermStalkIso X I ι F hF x f hf (n + 1)).hom) ≫ v (n + 1) :=
    ((congrArg (fun k => k ≫ a (n + 1)) hE).symm.trans
        (Category.assoc ((stalkComplex X x (etaObj X I ι F hF)).d n (n + 1))
          (G.map (p (n + 1))) (a (n + 1)))).trans
      ((congrArg (fun k => (stalkComplex X x (etaObj X I ι F hF)).d n (n + 1) ≫ k)
          (he (n + 1)).symm).trans
        (Category.assoc ((stalkComplex X x (etaObj X I ι F hF)).d n (n + 1))
          (etaTermStalkIso X I ι F hF x f hf (n + 1)).hom (v (n + 1))).symm)
  exact step₁.trans (step₂.trans step₃)

/-- **Stacks Project, Tag 0GT6.** At a generator `f` of the ideal stalk `I_x`, the stalk of the
sheaf-theoretic décalage `η_I F` is isomorphic, as a complex of modules over the local ring
`O_{X,x}`, to the ordinary décalage `η_f` of the complex of stalks. -/
@[stacks 0GT6, no_expose]
public noncomputable def etaStalkIso
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) :
    stalkComplex X x (etaObj X I ι F hF) ≅
      EtaComplex.etaObject f (stalkComplex X x F) :=
  HomologicalComplex.Hom.isoOfComponents (etaTermStalkIso X I ι F hF x f hf)
    (fun n m h => by
      subst h
      exact etaTermStalkIso_comm X I ι F hF x f hf n)

/-- In degree `n`, the comparison of Tag 0GT6 is the normalized ideal-power map applied to the
first projection of the defining fibre product, read inside the localization. -/
@[stacks 0GT6 "generator-normalized degreewise map"]
public theorem etaStalkIso_hom
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (f : ringStalk X x)
    (hf : GeneratesStalkIdeal X ι x f) (n : ℤ) :
    (etaStalkIso X I ι F hF x f hf).hom.f n ≫
      ModuleCat.ofHom (Submodule.subtype (EtaComplex.term f (stalkComplex X x F) n)) =
    (stalkModuleFunctor X x).map
      (pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1)))) ≫
      (idealPowerStalkComparison X I ι (F.X n) x f hf).map n := by
  have h : (etaStalkIso X I ι F hF x f hf).hom.f n =
      (etaTermStalkIso X I ι F hF x f hf n).hom := rfl
  rw [h]
  exact etaTermStalkIso_hom X I ι F hF x f hf n

end Stacks.IdealTorsion.Eta
