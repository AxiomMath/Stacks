module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GradedAlgebraQuotient
public import StacksFrontier.CategoryTheory.Sites.Modules.IdealSubsheafLocal

/-!
# The graded ideal generated by a submodule of one homogeneous piece

Let `𝒜` be a sheaf of graded algebras on a site and `ℱ ⊆ 𝒜_d` a submodule of one homogeneous
piece.  This file constructs the graded ideal `ℱ𝒜` generated by `ℱ`: in degree `n` it is the
smallest submodule of `𝒜_n` with local membership containing every product `f · a` of a local
section `f` of `ℱ` with a local section `a` of `𝒜_m`, where `d + m = n`.  It is stable under
right multiplication by homogeneous sections, and, when `𝒜` is commutative, it is a two-sided
graded ideal, `SheafOfModules.GradedAlgebra.Ideal.ofDegree`.

## Main definitions

* `SheafOfModules.GradedAlgebra.generatorSpan`: the objectwise span of the products `f · a`.
* `SheafOfModules.GradedAlgebra.generatedInDegree`: its closure, the degree-`n` piece of `ℱ𝒜`.
* `SheafOfModules.GradedAlgebra.Ideal.ofDegree`: the graded ideal `ℱ𝒜`.

## Main results

* `SheafOfModules.GradedAlgebra.mem_generatedInDegree`: `ℱ𝒜` contains the products.
* `SheafOfModules.GradedAlgebra.generatedInDegree_le`: it is the smallest submodule with local
  membership containing them.
* `SheafOfModules.GradedAlgebra.Ideal.ofDegree_le`: `ℱ𝒜` is contained in every graded ideal
  containing `ℱ`.

## Implementation notes

The degree equation `d + m = n` is a hypothesis and the product is related to the section of
`𝒜_n` by a heterogeneous equality, as in the `mul_assoc` field of
`SheafOfModules.GradedAlgebra`; substituting the equation turns it into an equality.  Stability
under right multiplication holds already for the objectwise span of the generators, by
associativity, and passes to the closure because a section of the closure lies locally in the
span; stability under left multiplication then follows from commutativity.

## References

* [Stacks Project, Tag 085M](https://stacks.math.columbia.edu/tag/085M)
* [Stacks Project, Tag 0802](https://stacks.math.columbia.edu/tag/0802)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe v u v' u'

namespace SheafOfModules.GradedAlgebra

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  {A : GradedAlgebra.{u, v} R} {d : ℤ} (ℱ : (A.piece d).Submodule)

/-- The products `f · a` of a local section `f` of `ℱ ⊆ 𝒜_d` with a local section `a` of `𝒜_m`,
read as sections of `𝒜_n` whenever `d + m = n`. -/
def generatorSet (n : ℤ) (X : Cᵒᵖ) : Set ((A.piece n).val.obj X) :=
  {x | ∃ (m : ℤ) (_ : d + m = n) (f : (A.piece d).val.obj X) (_ : f ∈ ℱ.obj X)
    (a : (A.piece m).val.obj X), HEq x ((A.mul d m).app X f a)}

/-- A generator restricts to a generator. -/
theorem map_mem_generatorSet {n : ℤ} {X Y : Cᵒᵖ} (g : X ⟶ Y) {x : (A.piece n).val.obj X}
    (hx : x ∈ generatorSet ℱ n X) : (A.piece n).val.map g x ∈ generatorSet ℱ n Y := by
  obtain ⟨m, rfl, f, hf, a, hx⟩ := hx
  obtain rfl := eq_of_heq hx
  exact ⟨m, rfl, (A.piece d).val.map g f, ℱ.map_mem g hf, (A.piece m).val.map g a,
    heq_of_eq ((A.mul d m).naturality g f a)⟩

/-- **The objectwise span of the products `f · a`**, a submodule of the underlying presheaf of
modules of `𝒜_n`. -/
def generatorSpan (n : ℤ) : (A.piece n).val.Submodule where
  obj X := Submodule.span _ (generatorSet ℱ n X)
  map {X Y} g := by
    intro x hx
    rw [Submodule.mem_comap]
    change (A.piece n).val.map g x ∈ Submodule.span _ (generatorSet ℱ n Y)
    induction hx using Submodule.span_induction with
    | mem y hy => exact Submodule.subset_span (map_mem_generatorSet ℱ g hy)
    | zero =>
        rw [show (A.piece n).val.map g (0 : (A.piece n).val.obj X) = 0 from map_zero _]
        exact Submodule.zero_mem _
    | add y z _ _ hy hz =>
        rw [show (A.piece n).val.map g (y + z) =
            (A.piece n).val.map g y + (A.piece n).val.map g z from map_add _ _ _]
        exact Submodule.add_mem _ hy hz
    | smul c y _ hy =>
        exact Eq.mpr (congrArg (· ∈ Submodule.span _ (generatorSet ℱ n Y))
          ((A.piece n).val.map_smul g c y)) (Submodule.smul_mem _ _ hy)

/-- A product of a local section of `ℱ` with a homogeneous local section of complementary degree
lies in the span of the generators. -/
theorem mem_generatorSpan {m n : ℤ} (hmn : d + m = n) {X : Cᵒᵖ} {f : (A.piece d).val.obj X}
    (hf : f ∈ ℱ.obj X) (a : (A.piece m).val.obj X) {x : (A.piece n).val.obj X}
    (hx : HEq x ((A.mul d m).app X f a)) : x ∈ (generatorSpan ℱ n).obj X :=
  Submodule.subset_span ⟨m, hmn, f, hf, a, hx⟩

/-- **The degree-`n` piece of the graded ideal `ℱ𝒜` generated by `ℱ ⊆ 𝒜_d`**: the smallest
submodule of `𝒜_n` with local membership containing every product of a local section of `ℱ`
with a homogeneous local section of `𝒜` of complementary degree. -/
def generatedInDegree (n : ℤ) : (A.piece n).Submodule :=
  Stacks.SheafOfModules.sheafifySubmodule (generatorSpan ℱ n)

/-- The objectwise span of the generators lies in the generated piece. -/
theorem generatorSpan_le_generatedInDegree (n : ℤ) :
    generatorSpan ℱ n ≤ (generatedInDegree ℱ n).toSubmodule :=
  Stacks.SheafOfModules.le_sheafifySubmodule _

/-- **`ℱ𝒜` contains the products**: if `d + m = n` and `x` is the product of a local section of
`ℱ` with a local section of `𝒜_m`, then `x` is a local section of `(ℱ𝒜)_n`. -/
theorem mem_generatedInDegree {m n : ℤ} (hmn : d + m = n) {X : Cᵒᵖ}
    {f : (A.piece d).val.obj X} (hf : f ∈ ℱ.obj X) (a : (A.piece m).val.obj X)
    {x : (A.piece n).val.obj X} (hx : HEq x ((A.mul d m).app X f a)) :
    x ∈ (generatedInDegree ℱ n).obj X :=
  generatorSpan_le_generatedInDegree ℱ n X (mem_generatorSpan ℱ hmn hf a hx)

/-- **`ℱ𝒜` is the smallest submodule with local membership containing the products.** -/
theorem generatedInDegree_le {n : ℤ} {N : (A.piece n).Submodule}
    (h : ∀ (m : ℤ), d + m = n → ∀ (X : Cᵒᵖ) (f : (A.piece d).val.obj X), f ∈ ℱ.obj X →
      ∀ (a : (A.piece m).val.obj X) (x : (A.piece n).val.obj X),
        HEq x ((A.mul d m).app X f a) → x ∈ N.obj X) :
    generatedInDegree ℱ n ≤ N := by
  refine Stacks.SheafOfModules.sheafifySubmodule_le fun X => Submodule.span_le.2 ?_
  rintro x ⟨m, hmn, f, hf, a, hx⟩
  exact h m hmn X f hf a x hx

/-- Membership in the generated pieces is unchanged by a heterogeneous equality across an
equality of degrees. -/
theorem mem_generatedInDegree_of_heq {n n' : ℤ} (hn : n = n') {X : Cᵒᵖ}
    {x : (A.piece n).val.obj X} {x' : (A.piece n').val.obj X} (hxx : HEq x x')
    (hx : x ∈ (generatedInDegree ℱ n).obj X) : x' ∈ (generatedInDegree ℱ n').obj X := by
  subst hn
  obtain rfl := eq_of_heq hxx
  exact hx

/-- `ℱ` lies in the degree-`d` piece of the ideal it generates: a section is its product with
the unit. -/
theorem le_generatedInDegree_self : ℱ ≤ generatedInDegree ℱ d :=
  SheafOfModules.Submodule.le_iff.2 fun X f hf =>
    mem_generatedInDegree ℱ (add_zero d) hf (A.one.eval X) (A.mul_one d X f).symm

/-- Right multiplication carries the span of the generators into the span of the generators: a
product `(f · a) · b` is regrouped as `f · (a · b)` by associativity. -/
theorem mul_mem_generatorSpan_right (i j : ℤ) (X : Cᵒᵖ) {x : (A.piece i).val.obj X}
    (hx : x ∈ (generatorSpan ℱ i).obj X) (b : (A.piece j).val.obj X) :
    (A.mul i j).app X x b ∈ (generatorSpan ℱ (i + j)).obj X := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨m, rfl, f, hf, a, hy⟩ := hy
      obtain rfl := eq_of_heq hy
      exact mem_generatorSpan ℱ (add_assoc d m j).symm hf _ (A.mul_assoc d m j X f a b)
  | zero =>
      rw [map_zero, AddMonoidHom.zero_apply]
      exact Submodule.zero_mem _
  | add y z _ _ hy hz =>
      rw [map_add, AddMonoidHom.add_apply]
      exact Submodule.add_mem _ hy hz
  | smul c y _ hy =>
      rw [(A.mul i j).map_smul_left]
      exact Submodule.smul_mem _ _ hy

/-- **`ℱ𝒜` is stable under right multiplication** by homogeneous local sections of `𝒜`: a section
of `(ℱ𝒜)_i` lies locally in the span of the generators, and right multiplication preserves that
span. -/
theorem mul_mem_generatedInDegree_right (i j : ℤ) (X : Cᵒᵖ) {x : (A.piece i).val.obj X}
    (hx : x ∈ (generatedInDegree ℱ i).obj X) (b : (A.piece j).val.obj X) :
    (A.mul i j).app X x b ∈ (generatedInDegree ℱ (i + j)).obj X := by
  obtain ⟨T, hT, hxT⟩ := Stacks.SheafOfModules.exists_sieve_of_mem_sheafifySubmodule hx
  refine Stacks.SheafOfModules.mem_sheafifySubmodule_of_mem hT fun Y g hg => ?_
  rw [(A.mul i j).naturality g.op x b]
  exact mul_mem_generatorSpan_right ℱ i j (op Y) (hxT g hg) _

/-- **The graded ideal generated by a submodule of one homogeneous piece**, for a commutative
sheaf of graded algebras: its degree-`n` piece is `(ℱ𝒜)_n`. -/
def Ideal.ofDegree
    (hcomm : ∀ (i j : ℤ) (X : Cᵒᵖ) (a : (A.piece i).val.obj X) (b : (A.piece j).val.obj X),
      HEq ((A.mul i j).app X a b) ((A.mul j i).app X b a)) : Ideal A where
  piece n := generatedInDegree ℱ n
  mul_mem_left i j X a x hx :=
    mem_generatedInDegree_of_heq ℱ (add_comm j i) (hcomm i j X a x).symm
      (mul_mem_generatedInDegree_right ℱ j i X hx a)
  mul_mem_right i j X _x b hx := mul_mem_generatedInDegree_right ℱ i j X hx b

/-- The pieces of the graded ideal generated by `ℱ`. -/
theorem Ideal.ofDegree_piece
    (hcomm : ∀ (i j : ℤ) (X : Cᵒᵖ) (a : (A.piece i).val.obj X) (b : (A.piece j).val.obj X),
      HEq ((A.mul i j).app X a b) ((A.mul j i).app X b a)) (n : ℤ) :
    (Ideal.ofDegree ℱ hcomm).piece n = generatedInDegree ℱ n :=
  rfl

/-- **`ℱ𝒜` is the smallest graded ideal containing `ℱ`.** -/
theorem Ideal.ofDegree_le
    (hcomm : ∀ (i j : ℤ) (X : Cᵒᵖ) (a : (A.piece i).val.obj X) (b : (A.piece j).val.obj X),
      HEq ((A.mul i j).app X a b) ((A.mul j i).app X b a)) (I : Ideal A)
    (h : ℱ ≤ I.piece d) (n : ℤ) : (Ideal.ofDegree ℱ hcomm).piece n ≤ I.piece n := by
  refine generatedInDegree_le ℱ ?_
  rintro m rfl X f hf a x hx
  obtain rfl := eq_of_heq hx
  exact I.mul_mem_right d m X a (SheafOfModules.Submodule.le_iff.1 h X hf)

end SheafOfModules.GradedAlgebra

end
