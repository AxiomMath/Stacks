module

public import StacksFrontier.Algebra.Category.ModuleCat.Presheaf.ChangeOfRingsAdjunction
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SitePointStalkTensor

/-!
# The stalk of a sectionwise extension of scalars at a point of a site

Let `(C, J)` be a site, `Φ` a point of it, `θ : A₁ ⟶ A₂` a morphism of presheaves of commutative
rings on `C` and `G` a presheaf of `A₁`-modules. Extension of scalars along `θ` produces the
presheaf of `A₂`-modules `A₂ ⊗_{A₁} G` with sections `A₂(U) ⊗_{A₁(U)} G(U)` over an object `U`
of `C` (Stacks 03CU), and a canonical morphism `G ⟶ A₂ ⊗_{A₁} G` of presheaves of `A₁`-modules
sending a section `m` to `1 ⊗ m`.

This file proves that extension of scalars is computed stalkwise: at the point `Φ` the induced
map `G_Φ → (A₂ ⊗_{A₁} G)_Φ` exhibits its target as the base change of `G_Φ` along the stalk
`A₁,Φ → A₂,Φ` of `θ`, that is,

`(A₂ ⊗_{A₁} G)_Φ = A₂,Φ ⊗_{A₁,Φ} G_Φ`.

The content is that the tensor product commutes with the filtered colimit computing a stalk at a
point of a site, with a base ring that varies over the colimit.

## Main definitions

* `Stacks.SitePointBaseChange.cof`: the presheaf `A₂ ⊗_{A₁} G`, and
  `Stacks.SitePointBaseChange.cofTmul` its pure-tensor sections.
* `Stacks.SitePointBaseChange.toStalk`: the canonical linear map `G_Φ → (A₂ ⊗_{A₁} G)_Φ` over
  the stalk `A₁,Φ`, induced by `m ↦ 1 ⊗ m`.
* `Stacks.SitePointBaseChange.stalkTensorDesc`: the comparison map
  `(A₂ ⊗_{A₁} G)_Φ → A₂,Φ ⊗_{A₁,Φ} G_Φ`.

## Main results

* `Stacks.SitePointBaseChange.isBaseChange_toStalk`: **the base-change colimit interchange at a
  point of a site.** The stalk of `A₂ ⊗_{A₁} G` at `Φ` is the base change of `G_Φ` along the
  stalk of `θ`.
* `Stacks.SitePointBaseChange.changeOfRingsStalkEquiv`: the resulting linear equivalence
  `A₂,Φ ⊗_{A₁,Φ} G_Φ ≃ (A₂ ⊗_{A₁} G)_Φ`.

## References

* [Stacks Project, Tag 03CU](https://stacks.math.columbia.edu/tag/03CU)
* [Stacks Project, Tag 04EH](https://stacks.math.columbia.edu/tag/04EH)
* [Stacks Project, Tag 05V5](https://stacks.math.columbia.edu/tag/05V5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

open scoped TensorProduct ChangeOfRings

universe w v u

namespace Stacks.SitePointBaseChange

open Stacks.PresheafOfModules.ChangeOfRings

variable {C : Type u} [Category.{v} C] [LocallySmall.{w} C] {J : GrothendieckTopology C}
  {A₁ A₂ : Cᵒᵖ ⥤ CommRingCat.{w}} (θ : A₁ ⟶ A₂)
  (G : PresheafOfModules.{w} (ringPresheaf A₁))

/-! ### Sections of the sectionwise extension of scalars -/

/-- Extension of scalars along `θ`, applied to `G`: the presheaf of `A₂`-modules with sections
`A₂(U) ⊗_{A₁(U)} G(U)` over an object `U` of `C`. -/
abbrev cof : PresheafOfModules.{w} (ringPresheaf A₂) :=
  (Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj G

/-- The pure tensor `a ⊗ m`, as a section of `A₂ ⊗_{A₁} G` over an object of `C`. -/
def cofTmul (U : C) (a : A₂.obj (op U)) (m : G.obj (op U)) : ↑((cof θ G).obj (op U)) :=
  letI := (θ.app (op U)).hom.toAlgebra
  a ⊗ₜ[A₁.obj (op U)] m

omit [LocallySmall.{w} C] in
/-- The sections of `A₂ ⊗_{A₁} G` over an object of `C` are generated by the pure tensors. -/
theorem cof_induction {U : C} {motive : ↑((cof θ G).obj (op U)) → Prop}
    (tmul : ∀ a m, motive (cofTmul θ G U a m))
    (add : ∀ s t, motive s → motive t → motive (s + t))
    (t : ↑((cof θ G).obj (op U))) : motive t := by
  let := (θ.app (op U)).hom.toAlgebra
  exact TensorProduct.inductionOn t tmul add

omit [LocallySmall.{w} C] in
/-- Restricting a pure tensor section of `A₂ ⊗_{A₁} G` restricts both factors. -/
theorem res_cofTmul {U V : C} (g : V ⟶ U) (a : A₂.obj (op U)) (m : G.obj (op U)) :
    (cof θ G).restrictₛₗ g.op (cofTmul θ G U a m) =
      cofTmul θ G V ((A₂.map g.op).hom a) (G.restrictₛₗ g.op m) :=
  Stacks.PresheafOfModules.ChangeOfRings.cofMap_tmul θ G g.op a m

omit [LocallySmall.{w} C] in
/-- Multiplying a pure tensor section of `A₂ ⊗_{A₁} G` by a section of `A₂` multiplies its
first factor. -/
theorem smul_cofTmul (U : C) (a b : A₂.obj (op U)) (m : G.obj (op U)) :
    a • cofTmul θ G U b m = cofTmul θ G U (a * b) m := by
  let := (θ.app (op U)).hom.toAlgebra
  exact TensorProduct.smul_tmul' a b m

omit [LocallySmall.{w} C] in
/-- Scalars move across a pure tensor section of `A₂ ⊗_{A₁} G` along `θ`. -/
theorem cofTmul_one_smul (U : C) (r : A₁.obj (op U)) (m : G.obj (op U)) :
    cofTmul θ G U 1 (r • m) = cofTmul θ G U ((θ.app (op U)).hom r) m := by
  let := (θ.app (op U)).hom.toAlgebra
  exact (TensorProduct.smul_tmul (R := A₁.obj (op U)) r (1 : A₂.obj (op U)) m).symm.trans
    (congrArg (· ⊗ₜ[A₁.obj (op U)] m) (Algebra.algebraMap_eq_smul_one r).symm)

/-- The map `m ↦ 1 ⊗ m` on sections over an object of `C`. -/
def oneTmul (U : C) : G.obj (op U) →+ ↑((cof θ G).obj (op U)) where
  toFun m := cofTmul θ G U 1 m
  map_zero' := by
    let := (θ.app (op U)).hom.toAlgebra
    exact TensorProduct.tmul_zero _ _
  map_add' m m' := by
    let := (θ.app (op U)).hom.toAlgebra
    exact TensorProduct.tmul_add _ m m'

omit [LocallySmall.{w} C] in
/-- The map `m ↦ 1 ⊗ m` sends a section to the pure tensor with first factor `1`. -/
@[simp]
lemma oneTmul_apply (U : C) (m : G.obj (op U)) : oneTmul θ G U m = cofTmul θ G U 1 m := rfl

/-! ### The comparison with the base change of the stalk -/

section Comparison

variable (Φ : J.Point.{w})

/-- The algebra structure of the stalk of `A₂` over the stalk of `A₁` induced by `θ`. -/
abbrev stalkAlgebra : Algebra (ringFiber Φ A₁) (ringFiber Φ A₂) :=
  ((Φ.presheafFiber (A := CommRingCat.{w})).map θ).hom.toAlgebra

variable [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)]
  (halg : algebraMap (ringFiber Φ A₁) (ringFiber Φ A₂) =
    ((Φ.presheafFiber (A := CommRingCat.{w})).map θ).hom)

omit [LocallySmall.{w} C] in
include halg in
/-- The structure map `A₁,Φ → A₂,Φ` sends the germ of a section `r` to the germ of `θ(r)`. -/
theorem germ_algebraMap (U : C) (x : Φ.fiber.obj U) (r : A₁.obj (op U)) :
    algebraMap (ringFiber Φ A₁) (ringFiber Φ A₂) (ringGerm Φ A₁ U x r) =
      ringGerm Φ A₂ U x ((θ.app (op U)).hom r) := by
  rw [halg]
  exact Φ.toPresheafFiber_naturality_apply θ U x r

/-- The `A₁,Φ`-module structure on the stalk of `A₂ ⊗_{A₁} G`, by restriction of scalars along
the structure map. -/
instance moduleRingFiberCof : Module (ringFiber Φ A₁) ↑(moduleFiber Φ A₂ (cof θ G)) :=
  Module.compHom _ (algebraMap (ringFiber Φ A₁) (ringFiber Φ A₂))

/-- The two scalar actions on the stalk of `A₂ ⊗_{A₁} G` form a tower. -/
instance isScalarTowerCof :
    IsScalarTower (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₂ (cof θ G)) :=
  IsScalarTower.of_algebraMap_smul fun _ _ => rfl

/-! #### The canonical map on stalks -/

/-- The restricted `A₁,Φ`-action on the stalk of `A₂ ⊗_{A₁} G` is the `A₂,Φ`-action through the
structure map. -/
lemma smul_moduleFiber_cof (r : ringFiber Φ A₁) (y : ↑(moduleFiber Φ A₂ (cof θ G))) :
    r • y = algebraMap (ringFiber Φ A₁) (ringFiber Φ A₂) r • y := rfl

/-- The germ of `1 ⊗ m` over one neighbourhood of `Φ`, as a map of abelian groups. -/
def oneTmulGerm (U : C) (x : Φ.fiber.obj U) :
    ((PresheafOfModules.toPresheaf (ringPresheaf A₁)).obj G).obj (op U) ⟶
      AddCommGrpCat.of ↑(moduleFiber Φ A₂ (cof θ G)) :=
  AddCommGrpCat.ofHom ((germ Φ A₂ (cof θ G) U x).comp (oneTmul θ G U))

omit [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)] in
/-- The maps `Stacks.SitePointBaseChange.oneTmulGerm` are compatible with restriction along a
morphism of neighbourhoods. -/
lemma oneTmulGerm_w {U V : C} (g : U ⟶ V) (x : Φ.fiber.obj U) :
    ((PresheafOfModules.toPresheaf (ringPresheaf A₁)).obj G).map g.op ≫
        oneTmulGerm θ G Φ U x =
      oneTmulGerm θ G Φ V (Φ.fiber.map g x) := by
  refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun (t : G.obj (op V)) => ?_)
  change germ Φ A₂ (cof θ G) U x (cofTmul θ G U 1 (G.restrictₛₗ g.op t)) =
    germ Φ A₂ (cof θ G) V (Φ.fiber.map g x) (cofTmul θ G V 1 t)
  rw [germ_w g x (cofTmul θ G V 1 t), res_cofTmul, map_one]

/-- The map `G_Φ → (A₂ ⊗_{A₁} G)_Φ` sending the germ of `m` to the germ of `1 ⊗ m`, as an
additive map. -/
def toStalkAdd : ↑(moduleFiber Φ A₁ G) →+ ↑(moduleFiber Φ A₂ (cof θ G)) :=
  (Φ.presheafFiberDesc (oneTmulGerm θ G Φ) (fun _ _ g x => oneTmulGerm_w θ G Φ g x)).hom

omit [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)] in
/-- The canonical map on stalks sends the germ of a section `m` to the germ of `1 ⊗ m`. -/
theorem toStalkAdd_germ (U : C) (x : Φ.fiber.obj U) (m : G.obj (op U)) :
    toStalkAdd θ G Φ (germ Φ A₁ G U x m) = germ Φ A₂ (cof θ G) U x (cofTmul θ G U 1 m) :=
  ConcreteCategory.congr_hom (Φ.toPresheafFiber_presheafFiberDesc (oneTmulGerm θ G Φ)
    (fun _ _ g x => oneTmulGerm_w θ G Φ g x) U x) m

/-- An element of the stalk of `G` and an element of the stalk of `A` are germs of sections over a
common neighbourhood of `Φ`. -/
private theorem exists_germ_eq_ringGerm_eq {A : Cᵒᵖ ⥤ CommRingCat.{w}}
    (m : ↑(moduleFiber Φ A₁ G)) (a : ringFiber Φ A) :
    ∃ (W : C) (z : Φ.fiber.obj W) (s : G.obj (op W)) (c : A.obj (op W)),
      germ Φ A₁ G W z s = m ∧ ringGerm Φ A W z c = a := by
  obtain ⟨U, x, s, hs⟩ := germ_jointly_surjective (O := A₁) (M := G) m
  obtain ⟨V, y, c, hc⟩ := ringGerm_jointly_surjective (O := A) a
  obtain ⟨W, z, p, q, hp, hq⟩ := Stacks.exists_common_nbhd (Φ := Φ) x y
  exact ⟨W, z, G.restrictₛₗ p.op s, A.map q.op c, by rw [← germ_w p z s, hp, hs],
    by rw [← ringGerm_w q z c, hq, hc]⟩

include halg in
/-- The canonical map on stalks is semilinear over the structure map, hence linear for the
restricted `A₁,Φ`-action. -/
theorem toStalkAdd_smul (r : ringFiber Φ A₁) (m : ↑(moduleFiber Φ A₁ G)) :
    toStalkAdd θ G Φ (r • m) = r • toStalkAdd θ G Φ m := by
  obtain ⟨W, z, s, ρ, hs, hρ⟩ := exists_germ_eq_ringGerm_eq G Φ m r
  rw [← hs, ← hρ, ← germ_smul W z, toStalkAdd_germ, toStalkAdd_germ, cofTmul_one_smul,
    smul_moduleFiber_cof, germ_algebraMap θ Φ halg, ← germ_smul W z, smul_cofTmul, mul_one]

include halg in
/-- The canonical map `G_Φ → (A₂ ⊗_{A₁} G)_Φ`, as a linear map over the stalk of `A₁`. -/
def toStalk : ↑(moduleFiber Φ A₁ G) →ₗ[ringFiber Φ A₁] ↑(moduleFiber Φ A₂ (cof θ G)) where
  toFun := toStalkAdd θ G Φ
  map_add' := map_add _
  map_smul' := toStalkAdd_smul θ G Φ halg

include halg in
/-- The canonical linear map on stalks sends the germ of `m` to the germ of `1 ⊗ m`. -/
theorem toStalk_germ (U : C) (x : Φ.fiber.obj U) (m : G.obj (op U)) :
    toStalk θ G Φ halg (germ Φ A₁ G U x m) =
      germ Φ A₂ (cof θ G) U x (cofTmul θ G U 1 m) :=
  toStalkAdd_germ θ G Φ U x m

/-! #### The comparison map in the other direction -/

include halg in
/-- The comparison map on the sections over one neighbourhood of `Φ`: it sends a section `a ⊗ m`
of `A₂ ⊗_{A₁} G` to the tensor product of the germs of `a` and of `m`. -/
def stalkTmulHom (U : C) (x : Φ.fiber.obj U) :
    ↑((cof θ G).obj (op U)) →+
      TensorProduct (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₁ G) :=
  letI := (θ.app (op U)).hom.toAlgebra
  Stacks.PresheafOfModules.ChangeOfRings.tmulMap (A₁.obj (op U)) (A₂.obj (op U))
    (ringFiber Φ A₁) (ringFiber Φ A₂)
    (Φ.toPresheafFiber U x A₁).hom (Φ.toPresheafFiber U x A₂).hom
    (RingHom.ext fun r => (germ_algebraMap θ Φ halg U x r).symm)
    (G.obj (op U)) ↑(moduleFiber Φ A₁ G) (germ Φ A₁ G U x) (fun r m => germ_smul U x r m)

include halg in
/-- The comparison map sends a pure tensor to the tensor product of the germs. -/
theorem stalkTmulHom_cofTmul (U : C) (x : Φ.fiber.obj U) (a : A₂.obj (op U))
    (m : G.obj (op U)) :
    stalkTmulHom θ G Φ halg U x (cofTmul θ G U a m) =
      ringGerm Φ A₂ U x a ⊗ₜ[ringFiber Φ A₁] germ Φ A₁ G U x m := by
  let := (θ.app (op U)).hom.toAlgebra
  exact Stacks.PresheafOfModules.ChangeOfRings.tmulMap_tmul (A₁.obj (op U)) (A₂.obj (op U))
    (ringFiber Φ A₁) (ringFiber Φ A₂)
    (Φ.toPresheafFiber U x A₁).hom (Φ.toPresheafFiber U x A₂).hom
    (RingHom.ext fun r => (germ_algebraMap θ Φ halg U x r).symm)
    (G.obj (op U)) ↑(moduleFiber Φ A₁ G) (germ Φ A₁ G U x) (fun r m => germ_smul U x r m) a m

include halg in
/-- The comparison maps over the neighbourhoods of `Φ` are compatible with restriction. -/
theorem stalkTmulHom_res {U V : C} (g : V ⟶ U) (y : Φ.fiber.obj V)
    (t : ↑((cof θ G).obj (op U))) :
    stalkTmulHom θ G Φ halg V y ((cof θ G).restrictₛₗ g.op t) =
      stalkTmulHom θ G Φ halg U (Φ.fiber.map g y) t := by
  refine cof_induction θ G (motive := fun t => stalkTmulHom θ G Φ halg V y
    ((cof θ G).restrictₛₗ g.op t) = stalkTmulHom θ G Φ halg U (Φ.fiber.map g y) t)
    (fun a m => ?_) (fun s t hs ht => ?_) t
  · rw [res_cofTmul, stalkTmulHom_cofTmul, stalkTmulHom_cofTmul, ringGerm_w g y a,
      germ_w g y m]
  · simp only [map_add, hs, ht]

include halg in
/-- The comparison maps on sections, as maps of abelian groups out of the sections over one
neighbourhood of `Φ`. -/
def stalkTmulGerm (U : C) (x : Φ.fiber.obj U) :
    ((PresheafOfModules.toPresheaf (ringPresheaf A₂)).obj (cof θ G)).obj (op U) ⟶
      AddCommGrpCat.of
        (TensorProduct (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₁ G)) :=
  AddCommGrpCat.ofHom (stalkTmulHom θ G Φ halg U x)

include halg in
/-- The maps `Stacks.SitePointBaseChange.stalkTmulGerm` are compatible with restriction along a
morphism of neighbourhoods. -/
lemma stalkTmulGerm_w {U V : C} (g : U ⟶ V) (x : Φ.fiber.obj U) :
    ((PresheafOfModules.toPresheaf (ringPresheaf A₂)).obj (cof θ G)).map g.op ≫
        stalkTmulGerm θ G Φ halg U x =
      stalkTmulGerm θ G Φ halg V (Φ.fiber.map g x) :=
  AddCommGrpCat.hom_ext (AddMonoidHom.ext fun t => stalkTmulHom_res θ G Φ halg g x t)

include halg in
/-- The comparison map `(A₂ ⊗_{A₁} G)_Φ → A₂,Φ ⊗_{A₁,Φ} G_Φ`, obtained by descending the
comparison maps on sections through the colimit defining the stalk. -/
def stalkTensorDesc :
    ↑(moduleFiber Φ A₂ (cof θ G)) →+
      TensorProduct (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₁ G) :=
  (Φ.presheafFiberDesc (stalkTmulGerm θ G Φ halg)
    (fun _ _ g x => stalkTmulGerm_w θ G Φ halg g x)).hom

include halg in
/-- The comparison map sends the germ of a section to the value of the comparison map on that
section. -/
theorem stalkTensorDesc_germ (U : C) (x : Φ.fiber.obj U) (t : ↑((cof θ G).obj (op U))) :
    stalkTensorDesc θ G Φ halg (germ Φ A₂ (cof θ G) U x t) =
      stalkTmulHom θ G Φ halg U x t :=
  ConcreteCategory.congr_hom (Φ.toPresheafFiber_presheafFiberDesc (stalkTmulGerm θ G Φ halg)
    (fun _ _ g x => stalkTmulGerm_w θ G Φ halg g x) U x) t

/-! #### The interchange -/

include halg in
/-- **The base-change colimit interchange at a point of a site.** The canonical map
`G_Φ → (A₂ ⊗_{A₁} G)_Φ` exhibits the stalk of `A₂ ⊗_{A₁} G` as the base change of `G_Φ` along
the stalk `A₁,Φ → A₂,Φ` of `θ`; that is, `(A₂ ⊗_{A₁} G)_Φ = A₂,Φ ⊗_{A₁,Φ} G_Φ`. -/
theorem isBaseChange_toStalk :
    IsBaseChange (ringFiber Φ A₂) (toStalk θ G Φ halg) := by
  have hleft : ∀ z : TensorProduct (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₁ G),
      stalkTensorDesc θ G Φ halg
        ((toStalk θ G Φ halg).liftBaseChange (ringFiber Φ A₂) z) = z := by
    intro z
    induction z using TensorProduct.inductionOn with
    | add a b ha hb => simp only [map_add, ha, hb]
    | tmul a m =>
      obtain ⟨W, z, s, c, hs, hc⟩ := exists_germ_eq_ringGerm_eq G Φ m a
      rw [← hs, ← hc, LinearMap.liftBaseChange_tmul, toStalk_germ, ← germ_smul W z,
        smul_cofTmul, mul_one, stalkTensorDesc_germ, stalkTmulHom_cofTmul]
  have hright : ∀ n : ↑(moduleFiber Φ A₂ (cof θ G)),
      (toStalk θ G Φ halg).liftBaseChange (ringFiber Φ A₂)
        (stalkTensorDesc θ G Φ halg n) = n := by
    intro n
    obtain ⟨U, x, t, ht⟩ := germ_jointly_surjective (O := A₂) (M := cof θ G) n
    rw [← ht]
    refine cof_induction θ G (motive := fun t =>
      (toStalk θ G Φ halg).liftBaseChange (ringFiber Φ A₂)
        (stalkTensorDesc θ G Φ halg (germ Φ A₂ (cof θ G) U x t)) =
          germ Φ A₂ (cof θ G) U x t) (fun a m => ?_) (fun s s' hs hs' => ?_) t
    · rw [stalkTensorDesc_germ, stalkTmulHom_cofTmul, LinearMap.liftBaseChange_tmul,
        toStalk_germ, ← germ_smul U x, smul_cofTmul, mul_one]
    · simp only [map_add, hs, hs']
  exact IsBaseChange.of_equiv
    (LinearEquiv.ofBijective ((toStalk θ G Φ halg).liftBaseChange (ringFiber Φ A₂))
      (Function.bijective_iff_has_inverse.mpr
        ⟨stalkTensorDesc θ G Φ halg, hleft, hright⟩))
    fun m => by
      rw [LinearEquiv.ofBijective_apply, LinearMap.liftBaseChange_one_tmul]

include halg in
/-- The stalk of a sectionwise extension of scalars, as a linear equivalence
`A₂,Φ ⊗_{A₁,Φ} G_Φ ≃ (A₂ ⊗_{A₁} G)_Φ`. -/
def changeOfRingsStalkEquiv :
    TensorProduct (ringFiber Φ A₁) (ringFiber Φ A₂) ↑(moduleFiber Φ A₁ G) ≃ₗ[ringFiber Φ A₂]
      ↑(moduleFiber Φ A₂ (cof θ G)) :=
  (isBaseChange_toStalk θ G Φ halg).equiv

include halg in
/-- The comparison equivalence sends `a ⊗ m` to `a` times the image of `m`. -/
theorem changeOfRingsStalkEquiv_tmul (a : ringFiber Φ A₂) (m : ↑(moduleFiber Φ A₁ G)) :
    changeOfRingsStalkEquiv θ G Φ halg (a ⊗ₜ[ringFiber Φ A₁] m) =
      a • toStalk θ G Φ halg m :=
  rfl

omit [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)] in
/-- The canonical map on stalks is natural in the presheaf of modules. -/
theorem toStalkAdd_naturality {N : PresheafOfModules.{w} (ringPresheaf A₁)} (α : G ⟶ N)
    (m : ↑(moduleFiber Φ A₁ G)) :
    (presheafModuleFiberOfCommRing Φ A₂).map ((changeOfRings θ).map α) (toStalkAdd θ G Φ m) =
      toStalkAdd θ N Φ ((presheafModuleFiberOfCommRing Φ A₁).map α m) := by
  obtain ⟨U, x, s, hs⟩ := germ_jointly_surjective (O := A₁) (M := G) m
  rw [← hs, toStalkAdd_germ, germ_naturality, germ_naturality, toStalkAdd_germ]
  refine congrArg (fun t => germ Φ A₂ (cof θ N) U x t) ?_
  exact Stacks.PresheafOfModules.ChangeOfRings.cofHom_app_tmul θ α (op U) 1 s

/-! #### The interchange as an isomorphism of modules over the stalk -/

/-- The stalk of `θ`, as a homomorphism of the `CommRingCat`-valued stalk rings. -/
abbrev stalkRingHom : ringFiber Φ A₁ →+* ringFiber Φ A₂ :=
  ((Φ.presheafFiber (A := CommRingCat.{w})).map θ).hom

omit [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)] in
/-- **The base-change colimit interchange at a point of a site**, as an isomorphism of modules
over the stalk of `A₂`: the base change of `G_Φ` along the stalk of `θ` is the stalk of
`A₂ ⊗_{A₁} G`. -/
def extendScalarsStalkObjIso :
    (ModuleCat.extendScalars (stalkRingHom θ Φ)).obj (moduleFiber Φ A₁ G) ≅
      moduleFiber Φ A₂ (cof θ G) :=
  letI : Algebra (ringFiber Φ A₁) (ringFiber Φ A₂) := stalkAlgebra θ Φ
  LinearEquiv.toModuleIso (changeOfRingsStalkEquiv θ G Φ rfl)

omit [Algebra (ringFiber Φ A₁) (ringFiber Φ A₂)] in
/-- The interchange isomorphism sends `1 ⊗ m` to the image of `m` under the canonical map. -/
lemma extendScalarsStalkObjIso_hom_one_tmul (m : ↑(moduleFiber Φ A₁ G)) :
    (extendScalarsStalkObjIso θ G Φ).hom
        ((1 : ringFiber Φ A₂) ⊗ₜ[ringFiber Φ A₁, stalkRingHom θ Φ] m) =
      toStalkAdd θ G Φ m := by
  let : Algebra (ringFiber Φ A₁) (ringFiber Φ A₂) := stalkAlgebra θ Φ
  change changeOfRingsStalkEquiv θ G Φ rfl ((1 : ringFiber Φ A₂) ⊗ₜ[ringFiber Φ A₁] m) = _
  rw [changeOfRingsStalkEquiv_tmul, one_smul]
  rfl

end Comparison

section NatIso

variable (Φ : J.Point.{w})

omit G in
/-- **The base-change colimit interchange at a point of a site, as a natural isomorphism of
stalk functors.** Taking stalks at `Φ` carries extension of scalars along `θ` to extension of
scalars along the stalk of `θ`. -/
def extendScalarsStalkNatIso :
    presheafModuleFiberOfCommRing Φ A₁ ⋙ ModuleCat.extendScalars (stalkRingHom θ Φ) ≅
      Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ ⋙
        presheafModuleFiberOfCommRing Φ A₂ :=
  NatIso.ofComponents (fun G => extendScalarsStalkObjIso θ G Φ) (by
    intro G N α
    refine ModuleCat.ExtendScalars.hom_ext (fun m => ?_)
    change (extendScalarsStalkObjIso θ N Φ).hom
        ((1 : ringFiber Φ A₂) ⊗ₜ[ringFiber Φ A₁, stalkRingHom θ Φ]
          ((presheafModuleFiberOfCommRing Φ A₁).map α m)) =
      (presheafModuleFiberOfCommRing Φ A₂).map ((changeOfRings θ).map α)
        ((extendScalarsStalkObjIso θ G Φ).hom
          ((1 : ringFiber Φ A₂) ⊗ₜ[ringFiber Φ A₁, stalkRingHom θ Φ] m))
    rw [extendScalarsStalkObjIso_hom_one_tmul, extendScalarsStalkObjIso_hom_one_tmul,
      toStalkAdd_naturality])

end NatIso

end Stacks.SitePointBaseChange

