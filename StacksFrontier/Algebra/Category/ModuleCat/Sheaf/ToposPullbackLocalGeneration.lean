/-!
# Pullback along a morphism of ringed topoi preserves local generation by `r` sections

Stacks 03DL(4) calls a sheaf of modules on a ringed site *locally generated by `r` sections*
when every object of the site has a covering such that, on each member, the restricted module
is generated by `r` global sections.  This file proves that this condition is stable under
pullback along a morphism of ringed topoi, as asserted in Stacks 03DO.

The pullback `f^*G = O_C ⊗_{f⁻¹O_D} f⁻¹G` of Stacks 03D6(2) is the inverse image of
Stacks 03D2 followed by extension of scalars along the inverse-image form of the structure
map.

## Main definitions

* `Stacks.Sheaves.LocalGeneration.tupleSheaf` is the `r`-fold product of a sheaf of sets,
  whose sections are `r`-tuples of sections.
* `Stacks.Sheaves.LocalGeneration.combinationValue` and `linearCombination` are a linear
  combination of sections, pointwise and as a morphism of sheaves of sets.
* `Stacks.Sheaves.LocalGeneration.spanSieve` and `LocallySpans` are the sieve on which a
  section is a combination of a given family, and the condition that a family spans locally.
* `Stacks.Sheaves.LocalGeneration.generatingTupleSheaf` is the sheaf of locally spanning
  `r`-tuples.
* `Stacks.Sheaves.LocalGeneration.sheafificationOverIso` and `extendScalarsOverIso` are the
  comparisons of sheafification and of extension of scalars with restriction to a slice site.

## Main results

* `Stacks.Sheaves.LocalGeneration.pullbackModules_isLocallyGeneratedByOnSite` is Stacks 03DO
  for local generation by `r` sections.
* `Stacks.Sheaves.LocalGeneration.pullbackModule_locallyGeneratedBy` is the statement for the
  inverse-image factor, taken for an arbitrary `PullbackModuleData`.
* `Stacks.Sheaves.LocalGeneration.extendScalars_isLocallyGeneratedBy` is the statement for the
  extension-of-scalars factor.

## References

* [Stacks Project, Tag 03DO](https://stacks.math.columbia.edu/tag/03DO)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03D2](https://stacks.math.columbia.edu/tag/03D2)
* [Stacks Project, Tag 03CZ](https://stacks.math.columbia.edu/tag/03CZ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace Stacks.Sheaves.LocalGeneration

universe v u v' u' w w'

/-! ### Sections of the sheaf-of-sets operations -/

/-- The component of `Sheaf.binaryOpHom op hop` at `X` applies `op X` to the two projections of
a section of `A ⨯ B`. -/
lemma binaryOpHom_hom_app_apply {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A B E : Sheaf J (Type w)}
    (op : ∀ X : Cᵒᵖ, A.obj.obj X → B.obj.obj X → E.obj.obj X)
    (hop : ∀ {X Y : Cᵒᵖ} (g : X ⟶ Y) (a : A.obj.obj X) (b : B.obj.obj X),
      E.obj.map g (op X a b) = op Y (A.obj.map g a) (B.obj.map g b))
    (X : Cᵒᵖ) (p : (A ⨯ B).obj.obj X) :
    (Sheaf.binaryOpHom (A := A) (B := B) (E := E) op hop).hom.app X p =
      op X ((prod.fst : A ⨯ B ⟶ A).hom.app X p)
        ((prod.snd : A ⨯ B ⟶ B).hom.app X p) :=
  rfl

/-- The component of `Sheaf.constHom c hc` at `X` is constant with value `c X`. -/
lemma constHom_hom_app_apply {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {E : Sheaf J (Type w)}
    (c : ∀ X : Cᵒᵖ, E.obj.obj X)
    (hc : ∀ {X Y : Cᵒᵖ} (g : X ⟶ Y), E.obj.map g (c X) = c Y)
    (X : Cᵒᵖ) (p : (⊤_ (Sheaf J (Type w))).obj.obj X) :
    (Sheaf.constHom (E := E) c hc).hom.app X p = c X :=
  rfl

/-- A morphism of sheaves of types is locally surjective if and only if it is a strong
epimorphism. -/
theorem locallySurjective_iff_strongEpi
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {F G : Sheaf J (Type w)} (p : F ⟶ G) :
    Sheaf.IsLocallySurjective p ↔ StrongEpi p := by
  constructor
  · intro hp
    let := hp
    apply (extremalEpi_iff_strongEpi_of_hasPullbacks p).mp
    refine { isIso := ?_ }
    intro Z g i h hi
    have h' : g.hom ≫ i.hom = p.hom := (sheafToPresheaf J (Type w)).congr_map h
    have : Sheaf.IsLocallySurjective i :=
      Presheaf.isLocallySurjective_of_isLocallySurjective_fac J h'
    apply (Sheaf.isLocallyBijective_iff_isIso i).mp
    refine ⟨?_, inferInstance⟩
    rw [Sheaf.isLocallyInjective_iff_injective]
    intro U
    have : Mono i.hom := inferInstanceAs (Mono ((sheafToPresheaf J (Type w)).map i))
    have : Mono (i.hom.app U) :=
      inferInstanceAs (Mono (((evaluation Cᵒᵖ (Type w)).obj U).map i.hom))
    exact (CategoryTheory.mono_iff_injective _).mp inferInstance
  · intro hp
    let := hp
    apply (Sheaf.isLocallySurjective_iff_isIso p).mpr
    exact ExtremalEpi.isIso p (Sheaf.toImage p) (Sheaf.imageι p) (Sheaf.toImage_ι p)

/-- A left adjoint between categories of sheaves of types carries locally surjective morphisms
to locally surjective morphisms. -/
theorem map_locallySurjective_of_adjunction
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    {L : Sheaf J (Type w) ⥤ Sheaf K (Type w')}
    {R : Sheaf K (Type w') ⥤ Sheaf J (Type w)} (adj : L ⊣ R)
    {F G : Sheaf J (Type w)} (p : F ⟶ G) [Sheaf.IsLocallySurjective p] :
    Sheaf.IsLocallySurjective (L.map p) := by
  let := adj.isLeftAdjoint
  let := adj.isRightAdjoint
  have := (locallySurjective_iff_strongEpi p).mp inferInstance
  exact (locallySurjective_iff_strongEpi _).mpr (adj.strongEpi_map_of_strongEpi p)

/-- A morphism of sheaves of modules is an epimorphism if and only if the underlying morphism of
sheaves of abelian groups is locally surjective. -/
theorem module_epi_iff_locallySurjective
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {M N : SheafOfModules.{w} R} (p : M ⟶ N) :
    Epi p ↔ Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf.{w} R).map p) := by
  let : HasSheafify J AddCommGrpCat.{w} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  have h := Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{w}
    ((SheafOfModules.toSheaf.{w} R).map p)
  constructor
  · intro hp
    let := hp
    let := AlgebraicGeometry.SheafOfModules.toSheaf_preservesColimits.{w, v, u, w} R
    let : PreservesColimitsOfSize.{0, 0} (SheafOfModules.toSheaf.{w} R) :=
      preservesColimitsOfSize_shrink (SheafOfModules.toSheaf.{w} R)
    exact h.mpr inferInstance
  · intro hp
    exact (SheafOfModules.toSheaf.{w} R).epi_of_epi_map (h.mp hp)

/-- The inverse image functor on sheaves of modules given by
`P : ToposPullback.PullbackModuleData J K f R` preserves epimorphisms. -/
theorem pullbackModule_preservesEpimorphisms
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    [J.HasSheafCompose (forget RingCat.{w})]
    [K.HasSheafCompose (forget RingCat.{w'})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [K.HasSheafCompose (forget AddCommGrpCat.{w'})]
    [HasWeakSheafify K AddCommGrpCat.{w'}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{w'}]
    (f : MorphismOfTopoi (Sheaf J (Type w)) (Sheaf K (Type w')))
    (R : Sheaf K RingCat.{w'}) (P : ToposPullback.PullbackModuleData J K f R) :
    P.moduleFunctor.PreservesEpimorphisms := by
  constructor
  intro M N p hp
  have hloc := (module_epi_iff_locallySurjective p).mp hp
  have hloc' : Sheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf R ⋙ sheafCompose K (forget AddCommGrpCat.{w'})).map p) :=
    (Presheaf.isLocallySurjective_iff_whisker_forget K _).mp hloc
  have hi := map_locallySurjective_of_adjunction f.adj
    ((SheafOfModules.toSheaf R ⋙ sheafCompose K (forget AddCommGrpCat.{w'})).map p)
  apply (SheafOfModules.toSheaf.{w} P.ring).epi_of_epi_map
  suffices Sheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf.{w} P.ring).map (P.moduleFunctor.map p)) from by
    let := this
    infer_instance
  change Presheaf.IsLocallySurjective J
    ((SheafOfModules.toSheaf P.ring).map (P.moduleFunctor.map p)).hom
  rw [Presheaf.isLocallySurjective_iff_whisker_forget]
  change Sheaf.IsLocallySurjective
    ((P.moduleFunctor ⋙ SheafOfModules.toSheaf P.ring ⋙
      sheafCompose J (forget AddCommGrpCat.{w})).map p)
  have hn := P.moduleIso.hom.naturality p
  have hfac :
      (P.moduleFunctor ⋙ SheafOfModules.toSheaf P.ring ⋙
        sheafCompose J (forget AddCommGrpCat.{w})).map p =
      (P.moduleIso.app M).hom ≫
        f.inverseImage.map
          ((SheafOfModules.toSheaf R ⋙ sheafCompose K (forget AddCommGrpCat.{w'})).map p) ≫
        (P.moduleIso.app N).inv := by
    simpa only [Functor.comp_map, Iso.app_hom, Iso.app_inv,
      Category.assoc, Iso.hom_inv_id_app, Category.comp_id] using
      congrArg (fun k ↦ k ≫ (P.moduleIso.app N).inv) hn
  rw [hfac]
  infer_instance

/-- A functor between sheaves of modules which preserves finite coproducts and epimorphisms and
carries the unit to the unit carries a family of `r` generating sections of `M` to a family of
`r` generating sections of `L.obj M`. -/
theorem map_generatingSections_of_finite
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    {R : Sheaf J RingCat.{w}} {S : Sheaf K RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [HasWeakSheafify K AddCommGrpCat.{w}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (L : SheafOfModules.{w} R ⥤ SheafOfModules.{w} S)
    [PreservesFiniteCoproducts L] [L.PreservesEpimorphisms]
    (e : SheafOfModules.unit S ≅ L.obj (SheafOfModules.unit R))
    {M : SheafOfModules.{w} R} (σ : M.GeneratingSections) (r : ℕ)
    (hσ : Nonempty (σ.I ≃ Fin r)) :
    ∃ τ : (L.obj M).GeneratingSections, Nonempty (τ.I ≃ Fin r) := by
  classical
  let : HasSheafify K AddCommGrpCat.{w} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  let : Finite σ.I := Finite.of_equiv (Fin r) hσ.some.symm
  let π := (SheafOfModules.mapFreeIso L σ.I e).hom ≫ L.map σ.π
  have : Epi π := inferInstance
  refine ⟨⟨σ.I, (L.obj M).freeHomEquiv π, ?_⟩, hσ⟩
  simpa only [Equiv.symm_apply_apply] using this

/-- The `r`-fold product of a sheaf of types `A`: its sections over `U` are the `r`-tuples of
sections of `A` over `U`. -/
noncomputable def tupleSheaf {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type w)) (r : ℕ) : Sheaf J (Type w) where
  obj := {
    obj := fun U => Fin r → A.obj.obj U
    map := fun f => ↾(fun s i => A.obj.map f (s i))
    map_id := by intro U; ext s i; exact ConcreteCategory.congr_hom (A.obj.map_id U) (s i)
    map_comp := by
      intro U V W f g
      ext s i
      exact ConcreteCategory.congr_hom (A.obj.map_comp f g) (s i) }
  property := by
    apply (isSheaf_iff_isSheaf_of_type J _).2
    intro U S hS x hx
    let xi (i : Fin r) : Presieve.FamilyOfElements A.obj S := fun _ f hf => x f hf i
    have hxi (i : Fin r) : (xi i).Compatible := by
      intro V W Z a b f g hf hg hab
      exact congrFun (hx a b hf hg hab) i
    let hA := (isSheaf_iff_isSheaf_of_type J _).1 A.property S hS
    refine ⟨fun i => hA.amalgamate (xi i) (hxi i), ?_, ?_⟩
    · intro V f hf
      funext i
      exact hA.valid_glue (hxi i) f hf
    · intro t ht
      funext i
      exact hA.isSeparatedFor.ext (fun _ f hf => (congrFun (ht f hf) i).trans
        (hA.valid_glue (hxi i) f hf).symm)

/-- The `i`-th projection `tupleSheaf A r ⟶ A`. -/
noncomputable def tupleProjection {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type w)) (r : ℕ) (i : Fin r) : tupleSheaf A r ⟶ A where
  hom := { app := fun _ => ↾(fun s => s i) }

/-- An `r`-tuple of sections of `A` over `U`, read as a section of `tupleSheaf A r`. -/
def tupleMk {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {A : Sheaf J (Type w)} {r : ℕ} {U : Cᵒᵖ} (s : Fin r → A.obj.obj U) :
    (tupleSheaf A r).obj.obj U := s

/-- The `i`-th projection of the tuple `tupleMk s` is `s i`. -/
@[simp]
lemma tupleProjection_app_tupleMk {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A : Sheaf J (Type w)} {r : ℕ} {U : Cᵒᵖ}
    (s : Fin r → A.obj.obj U) (i : Fin r) :
    (tupleProjection A r i).hom.app U (tupleMk s) = s i :=
  rfl

/-- The morphism into `tupleSheaf A r` whose `i`-th component is `s i`. -/
noncomputable def tupleLift {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {A B : Sheaf J (Type w)} {r : ℕ} (s : Fin r → (B ⟶ A)) :
    B ⟶ tupleSheaf A r where
  hom := {
    app := fun U => ↾(fun x i => (s i).hom.app U x)
    naturality := by
      intro U V f
      ext x
      funext i
      exact ConcreteCategory.congr_hom ((s i).hom.naturality f) x }

/-- The `i`-th component of `tupleLift s` is `s i`. -/
theorem tupleLift_projection {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A B : Sheaf J (Type w)} {r : ℕ}
    (s : Fin r → (B ⟶ A)) (i : Fin r) :
    tupleLift s ≫ tupleProjection A r i = s i := rfl

/-- `tupleSheaf A r`, with its projections, is a product of `r` copies of `A`. -/
noncomputable def tupleIsLimit {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (A : Sheaf J (Type w)) (r : ℕ) :
    IsLimit (Fan.mk (tupleSheaf A r) (tupleProjection A r)) :=
  Fan.IsLimit.mk _ (fun s => tupleLift s.proj)
    (fun _ _ => rfl) (fun s m hm => by
      ext U x
      funext i
      exact congrArg (fun k : s.pt ⟶ A => k.hom.app U x) (hm i))

/-- The underlying sheaf of types of a sheaf of modules. -/
noncomputable abbrev moduleUnderlying {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) : Sheaf J (Type w) :=
  (SheafOfModules.toSheaf R ⋙ sheafCompose J (forget AddCommGrpCat.{w})).obj M

/-- A section of a sheaf of modules, read as a section of its underlying sheaf of sets. -/
def underlyingSection {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {U : Cᵒᵖ} (m : M.val.obj U) :
    (moduleUnderlying M).obj.obj U := m

/-- The linear combination `∑ i, a i • s i` of sections `s i` of `M` over `U` with coefficients
`a i` in `R` over `U`. -/
def combinationValue {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    (M : SheafOfModules.{w} R) {U : Cᵒᵖ} {r : ℕ}
    (a : Fin r → R.obj.obj U) (s : Fin r → M.val.obj U) : M.val.obj U := ∑ i, a i • s i

/-- Restriction of a section of `M` over `U` along a morphism `g : U ⟶ V` of `Cᵒᵖ`, as a section
of `M` over `V`. -/
noncomputable def restr {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) {U V : Cᵒᵖ} (g : U ⟶ V)
    (m : M.val.obj U) : M.val.obj V :=
  M.val.map g m

/-- Restricting along a composite is restricting twice. -/
lemma restr_restr {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) {U V W : Cᵒᵖ} (g : U ⟶ V) (h : V ⟶ W)
    (m : M.val.obj U) : restr M h (restr M g m) = restr M (g ≫ h) m :=
  (M.val.map_comp_apply g h m).symm

/-- Restricting along the identity does nothing. -/
lemma restr_id {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) {U : Cᵒᵖ} (m : M.val.obj U) :
    restr M (𝟙 U) m = m := by
  simp [restr]

/-- Restriction is linear on linear combinations: it restricts both the coefficients and the
sections. -/
lemma restr_combinationValue {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    (M : SheafOfModules.{w} R) {U V : Cᵒᵖ} (g : U ⟶ V) {r : ℕ}
    (a : Fin r → R.obj.obj U) (s : Fin r → M.val.obj U) :
    restr M g (combinationValue M a s) =
      combinationValue M (fun i => R.obj.map g (a i)) (fun i => restr M g (s i)) := by
  rw [restr, combinationValue, map_sum]
  exact Finset.sum_congr rfl fun i _ ↦ M.val.map_smul g (a i) (s i)

/-- The morphism of sheaves of types taking a section `x` of `T` to the linear combination of the
sections `s i x` with coefficients `a i x`. -/
noncomputable def linearCombination {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {T : Sheaf J (Type w)} {r : ℕ}
    (a : Fin r → (T ⟶ (sheafCompose J (forget RingCat.{w})).obj R))
    (s : Fin r → (T ⟶ moduleUnderlying M)) : T ⟶ moduleUnderlying M where
  hom := {
    app := fun U => ↾(fun x => combinationValue M
      (fun i => (a i).hom.app U x) (fun i => (s i).hom.app U x))
    naturality := by
      intro U V f
      ext x
      let aU : Fin r → R.obj.obj U := fun i => (a i).hom.app U x
      let sU : Fin r → M.val.obj U := fun i => (s i).hom.app U x
      let aV : Fin r → R.obj.obj V := fun i => (a i).hom.app V (T.obj.map f x)
      let sV : Fin r → M.val.obj V := fun i => (s i).hom.app V (T.obj.map f x)
      change (∑ i, aV i • sV i : M.val.obj V) = M.val.map f (∑ i, aU i • sU i)
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [M.val.map_smul]
      exact congrArg₂ (fun (c : R.obj.obj V) (m : M.val.obj V) => c • m)
        (ConcreteCategory.congr_hom ((a i).hom.naturality f) x)
        (ConcreteCategory.congr_hom ((s i).hom.naturality f) x) }

/-- The sieve of the morphisms `f : V ⟶ U` along which the restriction of `x` is a linear
combination of the restrictions of the sections `s i`. -/
noncomputable def spanSieve {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    (M : SheafOfModules.{w} R) {r : ℕ} {U : C}
    (s : Fin r → M.val.obj (Opposite.op U)) (x : M.val.obj (Opposite.op U)) :
    Sieve U where
  arrows V f := ∃ a : Fin r → R.obj.obj (Opposite.op V),
    combinationValue M a (fun i => restr M f.op (s i)) = restr M f.op x
  downward_closed := by
    intro V W f hf g
    obtain ⟨a, ha⟩ := hf
    refine ⟨fun i => R.obj.map g.op (a i), ?_⟩
    have h := restr_combinationValue M g.op a (fun i => restr M f.op (s i))
    rw [ha] at h
    simpa only [restr_restr, ← op_comp] using h.symm

/-- The family `s` of sections of `M` over `U` spans `M` locally: for every `f : V ⟶ U`, every
section of `M` over `V` is, on a covering sieve of `V`, a linear combination of the restrictions
of the `s i`. -/
abbrev LocallySpans {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    (M : SheafOfModules.{w} R) {r : ℕ} {U : C}
    (s : Fin r → M.val.obj (Opposite.op U)) : Prop :=
  ∀ (V : C) (f : V ⟶ U) (x : M.val.obj (Opposite.op V)),
    spanSieve M (U := V) (fun i => restr M f.op (s i)) x ∈ J V

/-- A locally spanning family stays locally spanning after restriction along `f : V ⟶ U`. -/
theorem locallySpans_map {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    {M : SheafOfModules.{w} R} {r : ℕ} {U V : C}
    {s : Fin r → M.val.obj (Opposite.op U)} (hs : LocallySpans M s) (f : V ⟶ U) :
    LocallySpans M (U := V) (fun i => restr M f.op (s i)) := by
  intro W g x
  simpa only [restr_restr, ← op_comp] using hs W (g ≫ f) x

/-- A family spans locally as soon as its restrictions to the members of a covering sieve do. -/
theorem locallySpans_of_cover {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    {M : SheafOfModules.{w} R} {r : ℕ} {U : C}
    {s : Fin r → M.val.obj (Opposite.op U)} (S : Sieve U) (hS : S ∈ J U)
    (hs : ∀ (V : C) (f : V ⟶ U), S f →
      LocallySpans M (U := V) (fun i => restr M f.op (s i))) : LocallySpans M s := by
  intro V f x
  apply J.transitive (J.pullback_stable f hS)
  intro W g hg
  have h := hs W (g ≫ f) hg W (𝟙 W) (restr M g.op x)
  apply J.superset_covering _ h
  intro Z k hk
  obtain ⟨a, ha⟩ := hk
  refine ⟨a, ?_⟩
  simpa only [restr_restr, op_id, Category.comp_id, Category.assoc, ← op_comp] using ha

/-- For a locally spanning family `s` over `U`, the sieve on which a section `x` over `U` is a
linear combination of `s` covers `U`. -/
lemma spanSieve_mem_of_locallySpans {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    {M : SheafOfModules.{w} R} {r : ℕ} {U : C}
    {s : Fin r → M.val.obj (Opposite.op U)} (hs : LocallySpans M s)
    (x : M.val.obj (Opposite.op U)) : spanSieve M s x ∈ J U := by
  simpa only [op_id, restr_id] using hs U (𝟙 U) x

/-- The subpresheaf of `tupleSheaf (moduleUnderlying M) r` of locally spanning `r`-tuples. -/
noncomputable def generatingTuples {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) : Subfunctor (tupleSheaf (moduleUnderlying M) r).obj where
  obj _ := { s | LocallySpans M s }
  map f s hs := locallySpans_map (s := s) hs f.unop

/-- The presheaf of locally spanning `r`-tuples of sections of `M` is a sheaf. -/
theorem generatingTuples_isSheaf {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) :
    Presieve.IsSheaf J (generatingTuples M r).toFunctor := by
  apply (Subfunctor.isSheaf_iff _ ((isSheaf_iff_isSheaf_of_type J _).1
    (tupleSheaf (moduleUnderlying M) r).property)).2
  intro U s hs
  exact locallySpans_of_cover (s := s) _ hs (fun _ _ hf ↦ hf)

/-- The sheaf of locally spanning `r`-tuples of sections of `M`. -/
noncomputable def generatingTupleSheaf {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) : Sheaf J (Type w) :=
  ⟨(generatingTuples M r).toFunctor,
    (isSheaf_iff_isSheaf_of_type J _).2 (generatingTuples_isSheaf M r)⟩

/-- The first projection of a section of `prod.lift a b` is the corresponding section of `a`. -/
theorem prod_lift_fst_apply {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A B T : Sheaf J (Type w)}
    (a : T ⟶ A) (b : T ⟶ B) (U : Cᵒᵖ) (x : T.obj.obj U) :
    (prod.fst : A ⨯ B ⟶ A).hom.app U ((prod.lift a b).hom.app U x) = a.hom.app U x :=
  congrArg (fun k : T ⟶ A ↦ k.hom.app U x) (prod.lift_fst a b)

/-- The second projection of a section of `prod.lift a b` is the corresponding section of `b`. -/
theorem prod_lift_snd_apply {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A B T : Sheaf J (Type w)}
    (a : T ⟶ A) (b : T ⟶ B) (U : Cᵒᵖ) (x : T.obj.obj U) :
    (prod.snd : A ⨯ B ⟶ B).hom.app U ((prod.lift a b).hom.app U x) = b.hom.app U x :=
  congrArg (fun k : T ⟶ B ↦ k.hom.app U x) (prod.lift_snd a b)

/-- Composing `L.map (prod.lift a b)` with the comparison morphism `prodComparison L M N` gives
`prod.lift (L.map a) (L.map b)`. -/
theorem map_pair {A B : Type*} [Category A] [Category B]
    [HasBinaryProducts A] [HasBinaryProducts B]
    (L : A ⥤ B) {T M N : A} (a : T ⟶ M) (b : T ⟶ N) :
    L.map (prod.lift a b) ≫ prodComparison L M N = prod.lift (L.map a) (L.map b) := by
  apply prod.hom_ext <;> simp [prodComparison, ← L.map_comp]

/-- A section of the underlying sheaf of sets of a sheaf of modules, read as a section of the
sheaf of modules. -/
def moduleSection {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {U : Cᵒᵖ} (m : (Sheaf.moduleSheaf R M).obj.obj U) :
    M.val.obj U := m

/-- A section of the underlying sheaf of sets of a sheaf of rings, read as a section of the
sheaf of rings. -/
def ringSection {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    [J.HasSheafCompose (forget RingCat.{w})] (R : Sheaf J RingCat.{w}) {U : Cᵒᵖ}
    (a : (Sheaf.ringSheaf R).obj.obj U) : R.obj.obj U := a

/-- The section of `Sheaf.moduleAddHom` at a pair of maps into the underlying sheaf. -/
lemma lift_moduleAddHom_app {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {T : Sheaf J (Type w)}
    (α β : T ⟶ Sheaf.moduleSheaf R M) (U : Cᵒᵖ) (x : T.obj.obj U) :
    (prod.lift α β ≫ Sheaf.moduleAddHom R M).hom.app U x =
      moduleSection M (α.hom.app U x) + moduleSection M (β.hom.app U x) := by
  have h : (prod.lift α β ≫ Sheaf.moduleAddHom R M).hom.app U x =
      moduleSection M ((prod.fst : Sheaf.moduleSheaf R M ⨯ Sheaf.moduleSheaf R M ⟶
          Sheaf.moduleSheaf R M).hom.app U ((prod.lift α β).hom.app U x)) +
        moduleSection M ((prod.snd : Sheaf.moduleSheaf R M ⨯ Sheaf.moduleSheaf R M ⟶
          Sheaf.moduleSheaf R M).hom.app U ((prod.lift α β).hom.app U x)) :=
    rfl
  rw [h, prod_lift_fst_apply, prod_lift_snd_apply]

/-- The section of `Sheaf.moduleSMulHom` at a pair of maps into the underlying sheaves. -/
lemma lift_moduleSMulHom_app {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {T : Sheaf J (Type w)}
    (α : T ⟶ Sheaf.ringSheaf R) (β : T ⟶ Sheaf.moduleSheaf R M) (U : Cᵒᵖ)
    (x : T.obj.obj U) :
    (prod.lift α β ≫ Sheaf.moduleSMulHom R M).hom.app U x =
      ringSection R (α.hom.app U x) • moduleSection M (β.hom.app U x) := by
  have h : (prod.lift α β ≫ Sheaf.moduleSMulHom R M).hom.app U x =
      ringSection R ((prod.fst : Sheaf.ringSheaf R ⨯ Sheaf.moduleSheaf R M ⟶
          Sheaf.ringSheaf R).hom.app U ((prod.lift α β).hom.app U x)) •
        moduleSection M ((prod.snd : Sheaf.ringSheaf R ⨯ Sheaf.moduleSheaf R M ⟶
          Sheaf.moduleSheaf R M).hom.app U ((prod.lift α β).hom.app U x)) :=
    rfl
  rw [h, prod_lift_fst_apply, prod_lift_snd_apply]

/-- The linear combination of an empty family of sections is zero. -/
theorem linearCombination_zero {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {T : Sheaf J (Type w)}
    (a : Fin 0 → (T ⟶ (sheafCompose J (forget RingCat.{w})).obj R))
    (s : Fin 0 → (T ⟶ moduleUnderlying M)) :
    linearCombination M a s = terminal.from T ≫ Sheaf.moduleZeroHom _ M := by
  ext U x
  change combinationValue M (fun i ↦ ringSection R ((a i).hom.app U x))
      (fun i ↦ moduleSection M ((s i).hom.app U x)) = (0 : M.val.obj U)
  simp [combinationValue]

/-- A linear combination of `r + 1` sections is the sum of its first term and the linear
combination of the remaining `r` sections. -/
theorem linearCombination_succ {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {T : Sheaf J (Type w)} {r : ℕ}
    (a : Fin (r + 1) → (T ⟶ (sheafCompose J (forget RingCat.{w})).obj R))
    (s : Fin (r + 1) → (T ⟶ moduleUnderlying M)) :
    linearCombination M a s =
      prod.lift (prod.lift (a 0) (s 0) ≫ Sheaf.moduleSMulHom _ M)
        (linearCombination M (fun i => a i.succ) (fun i => s i.succ)) ≫
          Sheaf.moduleAddHom _ M := by
  ext U x
  have h := lift_moduleAddHom_app M (prod.lift (a 0) (s 0) ≫ Sheaf.moduleSMulHom R M)
    (linearCombination M (fun i ↦ a i.succ) (fun i ↦ s i.succ)) U x
  rw [lift_moduleSMulHom_app] at h
  refine Eq.trans ?_ h.symm
  change combinationValue M (fun i ↦ ringSection R ((a i).hom.app U x))
      (fun i ↦ moduleSection M ((s i).hom.app U x)) =
    ringSection R ((a 0).hom.app U x) • moduleSection M ((s 0).hom.app U x) +
      combinationValue M (fun i ↦ ringSection R ((a i.succ).hom.app U x))
        (fun i ↦ moduleSection M ((s i.succ).hom.app U x))
  simp [combinationValue, Fin.sum_univ_succ]

/-- The inverse image along `f`, followed by the comparison isomorphism of `P`, carries the linear
combination of the sections `s i` with coefficients `a i` to the linear combination of their
images. -/
theorem map_linearCombination
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    [J.HasSheafCompose (forget RingCat.{w})]
    [K.HasSheafCompose (forget RingCat.{w'})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [K.HasSheafCompose (forget AddCommGrpCat.{w'})]
    (f : MorphismOfTopoi (Sheaf J (Type w)) (Sheaf K (Type w')))
    (R : Sheaf K RingCat.{w'}) (P : ToposPullback.PullbackModuleData J K f R)
    (M : SheafOfModules.{w'} R) {T : Sheaf K (Type w')} {r : ℕ}
    (a : Fin r → (T ⟶ (sheafCompose K (forget RingCat.{w'})).obj R))
    (s : Fin r → (T ⟶ moduleUnderlying M)) :
    f.inverseImage.map (linearCombination M a s) ≫ (P.moduleIso.app M).inv =
      linearCombination (P.moduleFunctor.obj M)
        (fun i => f.inverseImage.map (a i) ≫ P.ringIso.inv)
        (fun i => f.inverseImage.map (s i) ≫ (P.moduleIso.app M).inv) := by
  induction r with
  | zero =>
      rw [linearCombination_zero, linearCombination_zero, Functor.map_comp,
        P.moduleZero_map]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [← Category.assoc]
      congr 1
      apply Subsingleton.elim
  | succ r ih =>
      rw [linearCombination_succ, Functor.map_comp, P.moduleAdd_map]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [← Category.assoc, ← Category.assoc, map_pair,
        prod.lift_map, Functor.map_comp, P.action_map]
      simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
      rw [← Category.assoc, ← Category.assoc, map_pair, prod.lift_map, ih, linearCombination_succ]
      have ha : P.action M = Sheaf.moduleSMulHom _ (P.moduleFunctor.obj M) := by
        ext U x
        exact P.action_apply M U x
      rw [ha]
      rfl

/-- The sections over `U` of a product of two sheaves of types are the pairs of sections over
`U`. -/
noncomputable def prodSectionEquiv {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} (A B : Sheaf J (Type w)) (U : Cᵒᵖ) :
    (A ⨯ B).obj.obj U ≃ A.obj.obj U × B.obj.obj U := by
  let E := sheafToPresheaf J (Type w) ⋙ (evaluation Cᵒᵖ (Type w)).obj U
  have : HasBinaryProduct A B := inferInstance
  exact ((asIso (prodComparison E A B)) ≪≫ Types.binaryProductIso _ _).toEquiv

/-- The first component of `prodSectionEquiv A B U x` is the first projection of `x`. -/
theorem prodSectionEquiv_fst {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} (A B : Sheaf J (Type w)) (U : Cᵒᵖ)
    (x : (A ⨯ B).obj.obj U) :
    (prodSectionEquiv A B U x).1 = (prod.fst : A ⨯ B ⟶ A).hom.app U x := by
  let E := sheafToPresheaf J (Type w) ⋙ (evaluation Cᵒᵖ (Type w)).obj U
  have : HasBinaryProduct A B := inferInstance
  change (prodComparison E A B ≫ (Types.binaryProductIso _ _).hom ≫ ↾Prod.fst) x = _
  rw [Types.binaryProductIso_hom_comp_fst, prodComparison_fst]
  rfl

/-- The second component of `prodSectionEquiv A B U x` is the second projection of `x`. -/
theorem prodSectionEquiv_snd {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} (A B : Sheaf J (Type w)) (U : Cᵒᵖ)
    (x : (A ⨯ B).obj.obj U) :
    (prodSectionEquiv A B U x).2 = (prod.snd : A ⨯ B ⟶ B).hom.app U x := by
  let E := sheafToPresheaf J (Type w) ⋙ (evaluation Cᵒᵖ (Type w)).obj U
  have : HasBinaryProduct A B := inferInstance
  change (prodComparison E A B ≫ (Types.binaryProductIso _ _).hom ≫ ↾Prod.snd) x = _
  rw [Types.binaryProductIso_hom_comp_snd, prodComparison_snd]
  rfl

/-- The first projection of the section corresponding to the pair `(a, b)` is `a`. -/
theorem prodSectionEquiv_symm_fst {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} (A B : Sheaf J (Type w)) (U : Cᵒᵖ)
    (a : A.obj.obj U) (b : B.obj.obj U) :
    (prod.fst : A ⨯ B ⟶ A).hom.app U ((prodSectionEquiv A B U).symm (a, b)) = a := by
  rw [← prodSectionEquiv_fst, Equiv.apply_symm_apply]

/-- The second projection of the section corresponding to the pair `(a, b)` is `b`. -/
theorem prodSectionEquiv_symm_snd {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} (A B : Sheaf J (Type w)) (U : Cᵒᵖ)
    (a : A.obj.obj U) (b : B.obj.obj U) :
    (prod.snd : A ⨯ B ⟶ B).hom.app U ((prodSectionEquiv A B U).symm (a, b)) = b := by
  rw [← prodSectionEquiv_snd, Equiv.apply_symm_apply]

/-- Two sections of a product of two sheaves of types with the same projections are equal. -/
theorem prod_section_ext {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {A B : Sheaf J (Type w)} {U : Cᵒᵖ}
    {x y : (A ⨯ B).obj.obj U}
    (h₁ : (prod.fst : A ⨯ B ⟶ A).hom.app U x = (prod.fst : A ⨯ B ⟶ A).hom.app U y)
    (h₂ : (prod.snd : A ⨯ B ⟶ B).hom.app U x = (prod.snd : A ⨯ B ⟶ B).hom.app U y) :
    x = y := by
  apply (prodSectionEquiv A B U).injective
  apply Prod.ext
  · simpa only [prodSectionEquiv_fst] using h₁
  · simpa only [prodSectionEquiv_snd] using h₂

/-- The `i`-th projection from the sheaf of locally spanning `r`-tuples of sections of `M` to the
underlying sheaf of `M`. -/
noncomputable def generatorProjection {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) (i : Fin r) :
    generatingTupleSheaf M r ⟶ moduleUnderlying M where
  hom := { app := fun _ => ↾(fun s => s.val i) }

/-- The morphism taking an `r`-tuple of coefficients and a locally spanning `r`-tuple of sections
to the corresponding linear combination, together with the tuple of sections. -/
noncomputable def universalCombination {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) :
    tupleSheaf ((sheafCompose J (forget RingCat.{w})).obj R) r ⨯ generatingTupleSheaf M r ⟶
      moduleUnderlying M ⨯ generatingTupleSheaf M r :=
  prod.lift (linearCombination M
    (fun i => prod.fst ≫ tupleProjection _ r i)
    (fun i => prod.snd ≫ generatorProjection M r i)) prod.snd

/-- The morphism `universalCombination M r` is locally surjective. -/
theorem universalCombination_locallySurjective {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) (r : ℕ) :
    Sheaf.IsLocallySurjective (universalCombination M r) := by
  let A := moduleUnderlying M
  let B := generatingTupleSheaf M r
  let Q := tupleSheaf ((sheafCompose J (forget RingCat.{w})).obj R) r
  constructor
  intro U y
  let x : M.val.obj (Opposite.op U) := (prod.fst : A ⨯ B ⟶ A).hom.app _ y
  let p : B.obj.obj (Opposite.op U) := (prod.snd : A ⨯ B ⟶ B).hom.app _ y
  have hp := spanSieve_mem_of_locallySpans p.property x
  apply J.superset_covering _ hp
  intro V f hf
  obtain ⟨a, ha⟩ := hf
  let q := B.obj.map f.op p
  let z := (prodSectionEquiv Q B (Opposite.op V)).symm (tupleMk a, q)
  refine ⟨z, ?_⟩
  dsimp only [universalCombination]
  apply prod_section_ext
  · rw [prod_lift_fst_apply]
    change combinationValue M
      (fun i ↦ ((prod.fst : Q ⨯ B ⟶ Q).hom.app _ z) i)
      (fun i ↦ ((prod.snd : Q ⨯ B ⟶ B).hom.app _ z).val i) = _
    dsimp only [z]
    rw [prodSectionEquiv_symm_fst, prodSectionEquiv_symm_snd, NatTrans.naturality_apply]
    change combinationValue M a (fun i ↦ restr M f.op (p.val i)) = restr M f.op x
    exact ha
  · rw [prod_lift_snd_apply]
    dsimp only [z]
    rw [prodSectionEquiv_symm_snd, NatTrans.naturality_apply]

/-- Let `q : E ⟶ moduleUnderlying M ⨯ P` be locally surjective, with first component the linear
combination of the `t ≫ s i` with coefficients `a i` and second component `t`. Then for every
section `p` of `P` the family of sections `s i p` spans `M` locally. -/
theorem locallySpans_of_parameterized_surjection
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {P E : Sheaf J (Type w)} {r : ℕ}
    (a : Fin r → (E ⟶ (sheafCompose J (forget RingCat.{w})).obj R))
    (s : Fin r → (P ⟶ moduleUnderlying M)) (t : E ⟶ P)
    (q : E ⟶ moduleUnderlying M ⨯ P) [Sheaf.IsLocallySurjective q]
    (h₁ : q ≫ prod.fst = linearCombination M a (fun i => t ≫ s i))
    (h₂ : q ≫ prod.snd = t) {U : C} (p : P.obj.obj (Opposite.op U)) :
    LocallySpans M (U := U) (fun i => (s i).hom.app _ p) := by
  intro V f x
  let y := (prodSectionEquiv (moduleUnderlying M) P (Opposite.op V)).symm
    (underlyingSection M x, P.obj.map f.op p)
  apply J.superset_covering _ (Presheaf.imageSieve_mem J q.hom y)
  intro W g hg
  obtain ⟨z, hz⟩ := hg
  refine ⟨fun i ↦ (a i).hom.app (Opposite.op W) z, ?_⟩
  have hz₁ := congrArg (fun k ↦ (prod.fst : moduleUnderlying M ⨯ P ⟶
    moduleUnderlying M).hom.app (Opposite.op W) k) hz
  have hz₂ := congrArg (fun k ↦ (prod.snd : moduleUnderlying M ⨯ P ⟶
    P).hom.app (Opposite.op W) k) hz
  have eq₁ := congrArg (fun k : E ⟶ moduleUnderlying M ↦ k.hom.app (Opposite.op W) z) h₁
  have eq₂ := congrArg (fun k : E ⟶ P ↦ k.hom.app (Opposite.op W) z) h₂
  dsimp only [y] at hz₁ hz₂
  rw [NatTrans.naturality_apply, prodSectionEquiv_symm_fst] at hz₁
  rw [NatTrans.naturality_apply, prodSectionEquiv_symm_snd] at hz₂
  have ht : t.hom.app (Opposite.op W) z = P.obj.map g.op (P.obj.map f.op p) :=
    eq₂.symm.trans hz₂
  have hs (i : Fin r) : (s i).hom.app (Opposite.op W) (t.hom.app _ z) =
      restr M g.op (restr M f.op ((s i).hom.app _ p)) := by
    rw [ht]
    change (s i).hom.app (Opposite.op W) (P.obj.map g.op (P.obj.map f.op p)) =
      M.val.map g.op (M.val.map f.op ((s i).hom.app (Opposite.op U) p))
    rw [NatTrans.naturality_apply, NatTrans.naturality_apply]
    rfl
  have he := eq₁.symm.trans hz₁
  let az : Fin r → R.obj.obj (Opposite.op W) := fun i ↦ (a i).hom.app _ z
  let sz : Fin r → M.val.obj (Opposite.op W) := fun i ↦ (s i).hom.app _ (t.hom.app _ z)
  change combinationValue M az sz = restr M g.op x at he
  simpa only [az, sz, hs] using he

/-- A section of the inverse image along `f` of the sheaf of locally spanning `r`-tuples of `M`
gives a locally spanning `r`-tuple of sections of the inverse image `P.moduleFunctor.obj M`. -/
theorem pullback_generatingTuple_locallySpans
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    [J.HasSheafCompose (forget RingCat.{w})]
    [K.HasSheafCompose (forget RingCat.{w'})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [K.HasSheafCompose (forget AddCommGrpCat.{w'})]
    (f : MorphismOfTopoi (Sheaf J (Type w)) (Sheaf K (Type w')))
    (R : Sheaf K RingCat.{w'}) (P : ToposPullback.PullbackModuleData J K f R)
    (M : SheafOfModules.{w'} R) (r : ℕ) {U : C}
    (p : (f.inverseImage.obj (generatingTupleSheaf M r)).obj.obj (Opposite.op U)) :
    LocallySpans (P.moduleFunctor.obj M) (U := U)
      (fun i => (f.inverseImage.map (generatorProjection M r i) ≫
        (P.moduleIso.app M).inv).hom.app _ p) := by
  let _ := f.preservesFiniteLimits
  let L := f.inverseImage
  let G := generatingTupleSheaf M r
  let A := moduleUnderlying M
  let Q := tupleSheaf ((sheafCompose K (forget RingCat.{w'})).obj R) r
  let e := prodComparison L A G ≫ prod.map (P.moduleIso.app M).inv (𝟙 (L.obj G))
  have : IsIso e := by dsimp [e, L]; infer_instance
  let q := L.map (universalCombination M r) ≫ e
  have : Sheaf.IsLocallySurjective (universalCombination M r) :=
    universalCombination_locallySurjective M r
  have : Sheaf.IsLocallySurjective (L.map (universalCombination M r)) :=
    map_locallySurjective_of_adjunction f.adj _
  have : Sheaf.IsLocallySurjective q := by dsimp [q]; infer_instance
  apply locallySpans_of_parameterized_surjection (P.moduleFunctor.obj M)
    (fun i ↦ L.map (prod.fst ≫ tupleProjection _ r i) ≫ P.ringIso.inv)
    (fun i ↦ L.map (generatorProjection M r i) ≫ (P.moduleIso.app M).inv)
    (L.map (prod.snd : Q ⨯ G ⟶ G)) q _ _ p
  · change L.map (universalCombination M r) ≫
      (prodComparison L A G ≫ prod.map (P.moduleIso.app M).inv (𝟙 (L.obj G))) ≫ prod.fst = _
    rw [Category.assoc, prod.map_fst, prodComparison_fst_assoc,
      ← Functor.map_comp_assoc]
    rw [show universalCombination M r ≫ prod.fst = linearCombination M
      (fun i ↦ prod.fst ≫ tupleProjection _ r i)
      (fun i ↦ prod.snd ≫ generatorProjection M r i) from prod.lift_fst _ _]
    change L.map (linearCombination M
      (fun i ↦ prod.fst ≫ tupleProjection _ r i)
      (fun i ↦ prod.snd ≫ generatorProjection M r i)) ≫ (P.moduleIso.app M).inv = _
    rw [map_linearCombination f R P]
    simp only [Functor.map_comp, Category.assoc]
    rfl
  · dsimp [q, e]
    simp only [Category.assoc, prod.map_snd, Category.comp_id,
      prodComparison_snd, ← Functor.map_comp]
    congr 1
    exact prod.lift_snd _ _

/-- An `r`-tuple of global sections of `M` such that every section of `M` over every object is
locally a linear combination of them is a family of `r` generating sections of `M`. -/
theorem exists_generatingSections_of_locally_spanning_sections
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} R) (r : ℕ) (s : Fin r → M.sections)
    (hs : ∀ (U : C) (x : M.val.obj (Opposite.op U)),
      spanSieve M (fun i => (s i).val (Opposite.op U)) x ∈ J U) :
    ∃ σ : M.GeneratingSections, Nonempty (σ.I ≃ Fin r) := by
  let t : ULift.{w} (Fin r) → M.sections := fun i ↦ s i.down
  let π := M.freeHomEquiv.symm t
  have hπ : Epi π := by
    constructor
    intro N a b hab
    have hs' (i : Fin r) : SheafOfModules.sectionsMap a (s i) =
        SheafOfModules.sectionsMap b (s i) := by
      have h := congrArg (fun k ↦ N.freeHomEquiv k ⟨i⟩) hab
      simpa only [SheafOfModules.freeHomEquiv_comp_apply,
        Equiv.apply_symm_apply, π, t] using h
    ext U x
    let S := spanSieve M (fun i ↦ (s i).val U) x
    have hN := (isSheaf_iff_isSheaf_of_type J _).1 (moduleUnderlying N).property
    apply (hN S (hs U.unop x)).isSeparatedFor.ext
    intro V f hf
    obtain ⟨c, hc⟩ := hf
    change N.val.map f.op (a.val.app U x) = N.val.map f.op (b.val.app U x)
    rw [← PresheafOfModules.naturality_apply, ← PresheafOfModules.naturality_apply,
      show (M.val.map f.op) x = restr M f.op x from rfl, ← hc, combinationValue]
    simp only [map_sum, map_smul]
    apply Finset.sum_congr rfl
    intro i _
    congr 1
    have h := congrArg (fun k : N.sections ↦ k.val (Opposite.op V)) (hs' i)
    have hsi := (s i).property f.op
    change restr M f.op ((s i).val U) = (s i).val (Opposite.op V) at hsi
    rw [hsi]
    exact h
  exact ⟨⟨ULift.{w} (Fin r), t, hπ⟩, ⟨Equiv.ulift⟩⟩

/-- A locally spanning `r`-tuple of sections of `M` over `U` gives a family of `r` generating
sections of the restriction `M.over U`. -/
theorem exists_generatingSections_over_of_locallySpans
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    (M : SheafOfModules.{w} R) {r : ℕ} {U : C}
    [HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [(J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (s : Fin r → M.val.obj (Opposite.op U)) (hs : LocallySpans M s) :
    ∃ σ : (M.over U).GeneratingSections, Nonempty (σ.I ≃ Fin r) := by
  let t (i : Fin r) : (M.over U).sections :=
    PresheafOfModules.sectionsMk (fun V ↦ M.val.map V.unop.hom.op (s i)) (by
      intro V W f
      change M.val.map f.unop.left.op (M.val.map V.unop.hom.op (s i)) =
        M.val.map W.unop.hom.op (s i)
      rw [← PresheafOfModules.map_comp_apply, ← op_comp, Over.w])
  apply exists_generatingSections_of_locally_spanning_sections (M.over U) r t
  intro V x
  let S := spanSieve M (U := V.left) (fun i ↦ M.val.map V.hom.op (s i)) x
  have hS := hs V.left V.hom x
  exact (J.over U).superset_covering (fun _ _ hf ↦ hf) (J.overEquiv_symm_mem_over V S hS)

/-- A section over `U` of the image of the morphism from the free module defined by a finite family
of global sections `s` lies in the span of the sections `s i` over `U`. -/
theorem freeHom_image_mem_span
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} R) {I : Type w} [Finite I] (s : I → M.sections)
    (U : Cᵒᵖ) (x : (SheafOfModules.free (R := R) I).val.obj U) :
    (M.freeHomEquiv.symm s).val.app U x ∈
      Submodule.span (R.obj.obj U) (M := M.val.obj U) (Set.range (fun i => (s i).val U)) := by
  classical
  let E := SheafOfModules.evaluation.{w} R U
  let : E.Additive := { map_add := by intros; rfl }
  let S := Submodule.span (R.obj.obj U) (M := M.val.obj U) (Set.range (fun i ↦ (s i).val U))
  let Q := ModuleCat.of (R.obj.obj U) (M.val.obj U ⧸ S)
  let q : M.val.obj U ⟶ Q := ModuleCat.ofHom S.mkQ
  have hq : E.map (M.freeHomEquiv.symm s) ≫ q = 0 := by
    apply (isColimitOfPreserves E (SheafOfModules.isColimitFreeCofan I)).hom_ext
    intro i
    change E.map (SheafOfModules.ιFree i.as) ≫ E.map (M.freeHomEquiv.symm s) ≫ q = _
    rw [← E.map_comp_assoc (SheafOfModules.ιFree i.as) (M.freeHomEquiv.symm s) q,
      ← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply, Equiv.apply_symm_apply]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro a
    change R.obj.obj U at a
    change S.mkQ ((M.unitHomEquiv.symm (s i.as)).val.app U a) = 0
    apply (Submodule.Quotient.mk_eq_zero S).2
    have ha : (M.unitHomEquiv.symm (s i.as)).val.app U a =
        (a • moduleSection M ((s i.as).val U) : M.val.obj U) := rfl
    rw [ha]
    exact S.smul_mem a (Submodule.subset_span ⟨i.as, rfl⟩)
  exact (Submodule.Quotient.mk_eq_zero S).1
    (congrArg (fun k ↦ k.hom x) hq)

/-- Every section of `M` over `U` is locally a linear combination of a family of generating
sections of `M` indexed by `Fin r`. -/
theorem generatingSections_locally_span
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} R) (σ : M.GeneratingSections) (r : ℕ)
    (e : σ.I ≃ Fin r) (U : C) (x : M.val.obj (Opposite.op U)) :
    spanSieve M (fun i => (σ.s (e.symm i)).val (Opposite.op U)) x ∈ J U := by
  let : Finite σ.I := Finite.of_equiv (Fin r) e.symm
  have : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map σ.π) :=
    (module_epi_iff_locallySurjective _).mp inferInstance
  apply J.superset_covering _
    (Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf R).map σ.π).hom x)
  intro V f hf
  obtain ⟨z, hz⟩ := hf
  have hmem := freeHom_image_mem_span M σ.s (Opposite.op V) z
  have hr : (Set.range (fun i ↦ (σ.s i).val (Opposite.op V)) :
        Set (M.val.obj (Opposite.op V))) =
      Set.range (fun i : Fin r ↦ (σ.s (e.symm i)).val (Opposite.op V)) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e.symm i, rfl⟩
  rw [hr] at hmem
  obtain ⟨a, ha⟩ := (Submodule.mem_span_range_iff_exists_fun (R.obj.obj (Opposite.op V))).1 hmem
  refine ⟨a, ?_⟩
  have hn (i : Fin r) : restr M f.op ((σ.s (e.symm i)).val (Opposite.op U)) =
      (σ.s (e.symm i)).val (Opposite.op V) := (σ.s (e.symm i)).property f.op
  rw [combinationValue]
  simp only [hn]
  exact ha.trans hz

/-- A family of `r` generating sections of `M.over U`, evaluated over the identity of `U`, is a
locally spanning `r`-tuple of sections of `M` over `U`. -/
theorem locallySpans_of_generatingSections_over
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    (M : SheafOfModules.{w} R) {U : C}
    [HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [(J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (σ : (M.over U).GeneratingSections) (r : ℕ) (e : σ.I ≃ Fin r) :
    LocallySpans M (U := U)
      (fun i => (σ.s (e.symm i)).val (Opposite.op (Over.mk (𝟙 U)))) := by
  intro V f x
  have h := generatingSections_locally_span (M.over U) σ r e (Over.mk f) x
  rw [GrothendieckTopology.mem_over_iff] at h
  apply J.superset_covering _ h
  intro W g hg
  rw [Sieve.overEquiv_iff] at hg
  obtain ⟨a, ha⟩ := hg
  refine ⟨a, ?_⟩
  have hn (i : Fin r) : restr M f.op
      ((σ.s (e.symm i)).val (Opposite.op (Over.mk (𝟙 U)))) =
      (σ.s (e.symm i)).val (Opposite.op (Over.mk f)) :=
    (σ.s (e.symm i)).property
      (Over.homMk f (by simp) : Over.mk f ⟶ Over.mk (𝟙 U)).op
  simp only [hn]
  exact ha

/-- The sections of the terminal sheaf of types over any object form a singleton. -/
private noncomputable abbrev terminalSectionUnique {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) (U : Cᵒᵖ) : Unique ((⊤_ (Sheaf J (Type w))).obj.obj U) :=
  haveI : HasTerminal (Sheaf J (Type w)) := inferInstance
  Types.isTerminalEquivUnique _ (terminalIsTerminal.isTerminalObj
    (sheafToPresheaf J (Type w) ⋙ (evaluation Cᵒᵖ (Type w)).obj U))

/-- If `M` is locally generated by `r` sections, then the sheaf of locally spanning `r`-tuples of
sections of `M` has sections locally, that is, its morphism to the terminal sheaf is locally
surjective. -/
theorem generatingTupleSheaf_locallyInhabited
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} R) (r : ℕ)
    (hM : ∀ U : C, ∃ S : J.Cover U, ∀ (V : C) (f : V ⟶ U), S f →
      ∃ σ : (M.over V).GeneratingSections, Nonempty (σ.I ≃ Fin r)) :
    Sheaf.IsLocallySurjective (terminal.from (generatingTupleSheaf M r)) := by
  constructor
  intro U y
  obtain ⟨S, hS⟩ := hM U
  apply J.superset_covering _ S.condition
  intro V f hf
  obtain ⟨σ, ⟨e⟩⟩ := hS V f hf
  refine ⟨⟨fun i ↦ (σ.s (e.symm i)).val (Opposite.op (Over.mk (𝟙 V))),
    locallySpans_of_generatingSections_over M σ r e⟩, ?_⟩
  let := terminalSectionUnique J (Opposite.op V)
  exact Subsingleton.elim _ _

/-- If `M` is locally generated by `r` sections, then so is its inverse image
`P.moduleFunctor.obj M` along `f`. -/
theorem pullbackModule_locallyGeneratedBy
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    [J.HasSheafCompose (forget RingCat.{w})]
    [K.HasSheafCompose (forget RingCat.{w})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [K.HasSheafCompose (forget AddCommGrpCat.{w})]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : D, HasWeakSheafify (K.over U) AddCommGrpCat.{w}]
    [∀ U : D, (K.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (f : MorphismOfTopoi (Sheaf J (Type w)) (Sheaf K (Type w)))
    (R : Sheaf K RingCat.{w}) (P : ToposPullback.PullbackModuleData J K f R)
    (M : SheafOfModules.{w} R) (r : ℕ)
    (hM : ∀ U : D, ∃ S : K.Cover U, ∀ (V : D) (g : V ⟶ U), S g →
      ∃ σ : (M.over V).GeneratingSections, Nonempty (σ.I ≃ Fin r)) :
    ∀ U : C, ∃ S : J.Cover U, ∀ (V : C) (g : V ⟶ U), S g →
      ∃ σ : ((P.moduleFunctor.obj M).over V).GeneratingSections, Nonempty (σ.I ≃ Fin r) := by
  let _ := f.preservesFiniteLimits
  let G := generatingTupleSheaf M r
  have : Sheaf.IsLocallySurjective (terminal.from G) :=
    generatingTupleSheaf_locallyInhabited M r hM
  have : Sheaf.IsLocallySurjective (f.inverseImage.map (terminal.from G)) :=
    map_locallySurjective_of_adjunction f.adj _
  let q := f.inverseImage.map (terminal.from G) ≫ terminalComparison f.inverseImage
  have : Sheaf.IsLocallySurjective q := by dsimp [q]; infer_instance
  intro U
  let := terminalSectionUnique J (Opposite.op U)
  let y : (⊤_ (Sheaf J (Type w))).obj.obj (Opposite.op U) := default
  refine ⟨⟨Presheaf.imageSieve q.hom y, Presheaf.imageSieve_mem J q.hom y⟩, ?_⟩
  intro V g hg
  obtain ⟨p, hp⟩ := hg
  exact exists_generatingSections_over_of_locallySpans (P.moduleFunctor.obj M) _
    (pullback_generatingTuple_locallySpans f R P M r p)

/-- Restriction of scalars along an isomorphism of sheaves of rings preserves local generation by
`r` sections. -/
theorem restrictScalars_locallyGeneratedBy_of_isIso
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R S : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (φ : R ⟶ S) [IsIso φ] (M : SheafOfModules.{w} S) (r : ℕ)
    (hM : ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (M.over V).GeneratingSections, Nonempty (σ.I ≃ Fin r)) :
    ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (((SheafOfModules.restrictScalars φ).obj M).over V).GeneratingSections,
        Nonempty (σ.I ≃ Fin r) := by
  intro U
  obtain ⟨T, hT⟩ := hM U
  refine ⟨T, ?_⟩
  intro V g hg
  obtain ⟨σ, ⟨e⟩⟩ := hT V g hg
  let s : Fin r → M.val.obj (Opposite.op V) :=
    fun i ↦ (σ.s (e.symm i)).val (Opposite.op (Over.mk (𝟙 V)))
  have hs : LocallySpans M s := locallySpans_of_generatingSections_over M σ r e
  apply exists_generatingSections_over_of_locallySpans ((SheafOfModules.restrictScalars φ).obj M) s
  intro W f x
  apply J.superset_covering _ (hs W f x)
  intro Z k hk
  obtain ⟨a, ha⟩ := hk
  refine ⟨fun i ↦ (inv φ).hom.app (Opposite.op Z) (a i), ?_⟩
  have hi (b : S.obj.obj (Opposite.op Z)) :
      (φ.hom.app (Opposite.op Z)) ((inv φ).hom.app (Opposite.op Z) b) = b :=
    congrArg (fun q : S ⟶ S ↦ q.hom.app (Opposite.op Z) b) (IsIso.inv_hom_id φ)
  change combinationValue M
      (fun i ↦ φ.hom.app (Opposite.op Z) ((inv φ).hom.app (Opposite.op Z) (a i)))
      (fun i ↦ restr M k.op (restr M f.op (s i))) = restr M k.op x
  simpa only [hi] using ha

/-- A left adjoint of restriction of scalars carries a family of generating sections of `M` to a
family of generating sections of `L.obj M` with the same index type. -/
theorem generatingSections_leftAdjoint_restrictScalars
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R S : Sheaf J RingCat.{w}}
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    {L : SheafOfModules.{w} R ⥤ SheafOfModules.{w} S}
    (φ : R ⟶ S) (adj : L ⊣ SheafOfModules.restrictScalars φ)
    (M : SheafOfModules.{w} R) (σ : M.GeneratingSections) :
    ∃ τ : (L.obj M).GeneratingSections, Nonempty (τ.I ≃ σ.I) := by
  refine ⟨⟨σ.I, fun i ↦ SheafOfModules.sectionsMap (M := M) (adj.unit.app M) (σ.s i), ?_⟩,
    ⟨Equiv.refl _⟩⟩
  constructor
  intro N a b hab
  apply (adj.homEquiv M N).injective
  apply (cancel_epi σ.π).1
  apply ((SheafOfModules.restrictScalars φ).obj N).freeHomEquiv.injective
  funext i
  have h := congrArg (fun k ↦ N.freeHomEquiv k i) hab
  have hts : (L.obj M).freeHomEquiv ((L.obj M).freeHomEquiv.symm
      (fun i ↦ SheafOfModules.sectionsMap (M := M) (adj.unit.app M) (σ.s i))) =
      fun i ↦ SheafOfModules.sectionsMap (M := M) (adj.unit.app M) (σ.s i) :=
    Equiv.apply_symm_apply _ _
  rw [SheafOfModules.freeHomEquiv_comp_apply, SheafOfModules.freeHomEquiv_comp_apply,
    hts] at h
  have hσ : M.freeHomEquiv (M.freeHomEquiv.symm σ.s) = σ.s := Equiv.apply_symm_apply _ _
  simp only [Adjunction.homEquiv_unit, SheafOfModules.GeneratingSections.π,
    SheafOfModules.freeHomEquiv_comp_apply, SheafOfModules.sectionsMap_comp, hσ]
  apply Subtype.ext
  funext U
  exact congrArg (fun y : N.sections ↦ y.val U) h

/-! ### Extension of scalars and restriction to a slice site -/

/-- If `f₁ ≫ f₂ = f₃` and `f₃` is locally surjective, then `f₂` is locally surjective. -/
theorem isLocallySurjective_second_of_fac {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) {F₁ F₂ F₃ : Cᵒᵖ ⥤ AddCommGrpCat.{w}}
    {f₁ : F₁ ⟶ F₂} {f₂ : F₂ ⟶ F₃} {f₃ : F₁ ⟶ F₃} (fac : f₁ ≫ f₂ = f₃)
    (h : Presheaf.IsLocallySurjective J f₃) : Presheaf.IsLocallySurjective J f₂ := by
  let _ := h
  exact Presheaf.isLocallySurjective_of_isLocallySurjective_fac J fac

/-- If `f₁ ≫ f₂ = f₃`, `f₃` is locally injective and `f₁` is locally surjective, then `f₂` is
locally injective. -/
theorem isLocallyInjective_second_of_fac {C : Type u} [Category.{v} C]
    (J : GrothendieckTopology C) {F₁ F₂ F₃ : Cᵒᵖ ⥤ AddCommGrpCat.{w}}
    {f₁ : F₁ ⟶ F₂} {f₂ : F₂ ⟶ F₃} {f₃ : F₁ ⟶ F₃} (fac : f₁ ≫ f₂ = f₃)
    (hinj : Presheaf.IsLocallyInjective J f₃)
    (hsurj : Presheaf.IsLocallySurjective J f₁) : Presheaf.IsLocallyInjective J f₂ := by
  let _ := hinj
  let _ := hsurj
  exact Presheaf.isLocallyInjective_of_isLocallyInjective_of_isLocallySurjective_fac J f₃ fac

/-- Sheafification commutes with restriction to the slice site over `U`: the sheafification of the
restriction of a presheaf of modules `P` is the restriction of the sheafification of `P`. -/
noncomputable def sheafificationOverIso
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    (R : Sheaf J RingCat.{w})
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (U : C)
    [HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [(J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (P : PresheafOfModules.{w} R.obj) :
    (PresheafOfModules.sheafification (𝟙 (R.over U).obj)).obj
      ((PresheafOfModules.pushforward (F := Over.forget U) (𝟙 (R.over U).obj)).obj P) ≅
      ((PresheafOfModules.sheafification (𝟙 R.obj)).obj P).over U := by
  let Q := (PresheafOfModules.pushforward (F := Over.forget U) (𝟙 (R.over U).obj)).obj P
  let N := ((PresheafOfModules.sheafification (𝟙 R.obj)).obj P).over U
  let η := (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj)).unit.app P
  let ηU : Q ⟶ (PresheafOfModules.restrictScalars (𝟙 (R.over U).obj)).obj N.val :=
    { app V := η.app ((Over.forget U).op.obj V)
      naturality := fun f => η.naturality ((Over.forget U).op.map f) }
  let q : (PresheafOfModules.sheafification (𝟙 (R.over U).obj)).obj Q ⟶ N :=
    (PresheafOfModules.sheafificationHomEquiv (𝟙 (R.over U).obj)).symm ηU
  have hq : CategoryTheory.toSheafify (J.over U) Q.presheaf ≫
      (PresheafOfModules.toPresheaf (R.over U).obj).map q.val =
      Functor.whiskerLeft (Over.forget U).op (CategoryTheory.toSheafify J P.presheaf) := by
    have h := (PresheafOfModules.sheafificationHomEquiv (𝟙 (R.over U).obj)
      (P := Q) (F := N)).apply_symm_apply ηU
    exact congrArg (fun k => (PresheafOfModules.toPresheaf (R.over U).obj).map k) h
  have hsurj : Presheaf.IsLocallySurjective (J.over U)
      (Functor.whiskerLeft (Over.forget U).op (CategoryTheory.toSheafify J P.presheaf)) :=
    Presheaf.isLocallySurjective_whisker (J.over U) J (Over.forget U) _
  have hinj : Presheaf.IsLocallyInjective (J.over U)
      (Functor.whiskerLeft (Over.forget U).op (CategoryTheory.toSheafify J P.presheaf)) :=
    Presheaf.isLocallyInjective_whisker (J.over U) J (Over.forget U) _
  have hqs : Presheaf.IsLocallySurjective (J.over U)
      ((PresheafOfModules.toPresheaf (R.over U).obj).map q.val) :=
    isLocallySurjective_second_of_fac (J.over U) hq hsurj
  have hqi : Presheaf.IsLocallyInjective (J.over U)
      ((PresheafOfModules.toPresheaf (R.over U).obj).map q.val) :=
    isLocallyInjective_second_of_fac (J.over U) hq hinj
      (((J.over U).W_toSheafify Q.presheaf).isLocallySurjective)
  have : IsIso ((SheafOfModules.toSheaf (R.over U)).map q) :=
    (Sheaf.isLocallyBijective_iff_isIso _).mp ⟨hqi, hqs⟩
  have : IsIso q := isIso_of_reflects_iso q (SheafOfModules.toSheaf (R.over U))
  exact asIso q

/-- Extension of scalars commutes with restriction to a slice site: extending scalars on the
slice site along the restricted morphism of sheaves of commutative rings gives the restriction
of the extension of scalars. -/
@[sga "4 IV 12.11" "12.11(a)"]
noncomputable def extendScalarsOverIso
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {A₁ A₂ : Cᵒᵖ ⥤ CommRingCat.{w}} (θ : A₁ ⟶ A₂)
    (h₁ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₁))
    (h₂ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₂))
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (U : C)
    [HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [(J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} (RingedToposModules.commRingSheaf J A₁ h₁)) :
    (RingedToposModules.extendScalars (J.over U)
          (Functor.whiskerLeft (Over.forget U).op θ)
          ((RingedToposModules.commRingSheaf J A₁ h₁).over U).property
          ((RingedToposModules.commRingSheaf J A₂ h₂).over U).property).obj
        (SheafOfModules.over M U) ≅
      SheafOfModules.over ((RingedToposModules.extendScalars J θ h₁ h₂).obj M) U :=
  sheafificationOverIso (RingedToposModules.commRingSheaf J A₂ h₂) U
    ((Stacks.PresheafOfModules.ChangeOfRings.changeOfRings θ).obj M.val)

/-- Extension of scalars preserves local generation by `r` sections. -/
theorem extendScalars_isLocallyGeneratedBy
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {A₁ A₂ : Cᵒᵖ ⥤ CommRingCat.{w}} (θ : A₁ ⟶ A₂)
    (h₁ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₁))
    (h₂ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₂))
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} (RingedToposModules.commRingSheaf J A₁ h₁)) (r : ℕ)
    (hM : ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (SheafOfModules.over M V).GeneratingSections, Nonempty (σ.I ≃ Fin r)) :
    ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (SheafOfModules.over
        ((RingedToposModules.extendScalars J θ h₁ h₂).obj M) V).GeneratingSections,
        Nonempty (σ.I ≃ Fin r) := by
  intro U
  obtain ⟨T, hT⟩ := hM U
  refine ⟨T, ?_⟩
  intro V g hg
  obtain ⟨σ, ⟨e⟩⟩ := hT V g hg
  obtain ⟨τ, ⟨d⟩⟩ := generatingSections_leftAdjoint_restrictScalars
    (RingedToposModules.commRingSheafMap (J.over V) (Functor.whiskerLeft (Over.forget V).op θ)
      ((RingedToposModules.commRingSheaf J A₁ h₁).over V).property
      ((RingedToposModules.commRingSheaf J A₂ h₂).over V).property)
    (RingedToposModules.extendRestrictScalarsAdjunction (J.over V)
      (Functor.whiskerLeft (Over.forget V).op θ)
      ((RingedToposModules.commRingSheaf J A₁ h₁).over V).property
      ((RingedToposModules.commRingSheaf J A₂ h₂).over V).property)
    (SheafOfModules.over M V) σ
  exact ⟨τ.equivOfIso (extendScalarsOverIso θ h₁ h₂ V M), ⟨d.trans e⟩⟩

/-! ### Pullback along a morphism of ringed topoi -/

/-- The pullback of a sheaf of modules that is locally generated by `r` sections along a
morphism of ringed topoi is again locally generated by `r` sections. -/
@[stacks 03DO "part (4), locally generated by `r` sections: for an arbitrary morphism of ringed
  topoi"]
theorem pullbackModules_isLocallyGeneratedByOnSite
    {X : AlgebraicGeometry.RingedTopos.{v, u, w}}
    {Y : AlgebraicGeometry.RingedTopos.{v', u', w}}
    [X.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
    [Y.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
    [X.J.HasSheafCompose (forget RingCat.{w})]
    [Y.J.HasSheafCompose (forget RingCat.{w})]
    [X.J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [Y.J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [HasWeakSheafify X.J AddCommGrpCat.{w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{w}]
    [∀ U : Y.C, HasWeakSheafify (Y.J.over U) AddCommGrpCat.{w}]
    [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : Y.C, (Y.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (f : RingedToposModules.RingedToposHom X Y)
    (F : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) (r : ℕ)
    (hF : F.IsLocallyGeneratedByOnSite r) :
    ((RingedToposModules.RingedToposHom.pullbackModules f).obj F).IsLocallyGeneratedByOnSite r := by
  have hP := pullbackModule_locallyGeneratedBy f.toToposHom
    (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)
    (ToposPullback.pullbackModule X.J Y.J f.toToposHom
      (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) F r hF
  exact extendScalars_isLocallyGeneratedBy (RingedToposModules.fSharpCommRing f)
    (ToposPushforward.inverseImageRingSheaf f.toToposHom
      (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)).property
    (Stacks.SheafOfModules.Tensor.ringSheaf X.O).property _ r hP

end Stacks.Sheaves.LocalGeneration

