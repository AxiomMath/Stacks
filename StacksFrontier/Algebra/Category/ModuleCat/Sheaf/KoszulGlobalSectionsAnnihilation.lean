module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalSectionSmul
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.CechContractible

/-!
# The Koszul complex of a finite family of global sections on a site

Let `O` be a sheaf of commutative rings on a site and let `f₁, …, f_r` be global sections of
`O` — compatible families of local sections.  This file builds the Koszul complex
`K(O, f₁, …, f_r)` as a complex of sheaves of `O`-modules, and proves that multiplication by
each `f_j` is null-homotopic on it, so that the ideal generated by the `f_j` annihilates every
cohomology sheaf.  That annihilation is [Stacks, Tag 0663]; the library previously had it only
for modules over a commutative ring, as
`Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator`.

## Main definitions

* `Stacks.Sheaves.KoszulGlobalSections.prodSection`: the global section `f_S = ∏_{i ∈ S} f_i`.
* `Stacks.Sheaves.KoszulGlobalSections.smulEnd`: multiplication by a global section, as an
  endomorphism of the identity functor of `O`-modules.
* `Stacks.Sheaves.KoszulGlobalSections.koszulFunctor`: the Koszul system, the diagram on
  `Finset (Fin r)` constant at the rank-one module `O` whose transition map along `S ⊆ T` is
  multiplication by `f_{T \ S}`.
* `Stacks.Sheaves.KoszulGlobalSections.koszulComplex`: the Koszul complex, the alternating
  complex of that system.
* `Stacks.Sheaves.KoszulGlobalSections.koszulHtpy`: the contracting homotopy at an index `j`.
* `Stacks.Sheaves.KoszulGlobalSections.koszulSmulMap`: multiplication by `f_j` on the complex.

## Main results

* `Stacks.Sheaves.KoszulGlobalSections.koszulHtpy_comp_dAux_add_dAux_comp_koszulHtpy`: the
  homotopy identity, `h ∘ d + d ∘ h = f_j`.
* `Stacks.Sheaves.KoszulGlobalSections.koszulSmulNullHomotopic`: multiplication by `f_j` is
  null-homotopic on the Koszul complex.
* `Stacks.Sheaves.KoszulGlobalSections.smulEnd_app_homology_eq_zero` and
  `Stacks.Sheaves.KoszulGlobalSections.smul_homology_eq_zero`: **[Stacks, Tag 0663]** on a site,
  in morphism and in sectionwise form.

## Implementation notes

The complex is not built from an exterior algebra.  It is the alternating complex
`CategoryTheory.AlternatingCech.complex` — which is parametric in any preadditive category with
finite products and any diagram on `Finset (Fin r)` — applied to the system that is *constant*
at `O` and whose transition maps are multiplications.  In degree `p` the term is therefore the
product of copies of `O` indexed by the subsets of cardinality `p`, which is visibly the Koszul
term `Λ^p(O^r)`, and `d ∘ d = 0` together with the sign combinatorics come for free from that
file.  This is also what makes the contracting homotopy cheap: because every object of the
system is the *same* module, the component of the homotopy at `A` is a bare projection onto the
factor `A ∪ {j}`, with no transition map to invert.  The contracting homotopy of the extended
alternating Čech complex in
`StacksFrontier/AlgebraicGeometry/FormalGeometry/DerivedCompletionRinged/CechContractible.lean`
does have to invert one, and its proof consequently cancels a monomorphism; the proof here
cannot and does not, since multiplication by `f_j` need not be injective.

Commutativity of the rings of sections is needed twice and is supplied by two instances
deduced from `O` being a sheaf of *commutative* rings: `IsMulCommutative`, which
`Stacks.SheafOfModules.globalSectionToEnd` consumes, and `CommMonoid`, without which the finite
products `f_S` do not elaborate.  Global sections are taken on the `RingCat` side, where the
module action lives.

## References

* [Stacks Project, Tag 0663](https://stacks.math.columbia.edu/tag/0663)
* [Stacks Project, Tag 099H](https://stacks.math.columbia.edu/tag/099H)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.AlternatingCech
open AlgebraicGeometry.SheafOfModules

universe v u w

namespace Stacks.Sheaves.KoszulGlobalSections

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]

variable (O : Sheaf J CommRingCat.{w})

/-- The rings of sections of the underlying sheaf of rings are commutative. -/
instance isMulCommutative_underlyingRing (U : Cᵒᵖ) :
    IsMulCommutative ((Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj U) := by
  change IsMulCommutative (O.obj.obj U)
  infer_instance

open scoped IsMulCommutative

/-- The rings of sections of the underlying sheaf of rings are commutative monoids, so finite
products of local sections are available. -/
instance commMonoid_underlyingRing (U : Cᵒᵖ) :
    CommMonoid (((Stacks.SheafOfModules.Tensor.ringSheaf O).obj ⋙ forget RingCat.{w}).obj U) := by
  change CommMonoid (O.obj.obj U)
  infer_instance

/-- A global section of the structure sheaf: a compatible family of local sections of the
underlying sheaf of rings. -/
abbrev GlobalSection :=
  ((Stacks.SheafOfModules.Tensor.ringSheaf O).obj ⋙ forget RingCat.{w}).sections

section Sections

variable {r : ℕ}

/-- The product `f_S = ∏_{i ∈ S} f_i` of a finite subfamily of global sections, as a global
section: the rings of sections are commutative, and a ring homomorphism carries a product to
the product of the images. -/
def prodSection (f : Fin r → GlobalSection O) (S : Finset (Fin r)) : GlobalSection O :=
  ⟨fun U ↦ ∏ i ∈ S, (f i).val U, by
    intro U V g
    change ((Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map g).hom (∏ i ∈ S, (f i).val U) = _
    rw [map_prod]
    exact Finset.prod_congr rfl fun i _ ↦ (f i).property g⟩

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})] in
/-- The value of `prodSection O f S` on `U` is the product of the values of the `f i`, `i ∈ S`,
on `U`. -/
@[simp] theorem prodSection_val (f : Fin r → GlobalSection O) (S : Finset (Fin r)) (U : Cᵒᵖ) :
    (prodSection O f S).val U = ∏ i ∈ S, (f i).val U := rfl

end Sections

section Diff

variable {r : ℕ}

/-- For `S ⊆ T ⊆ V` the complement of `T \ S` inside `V \ S` is `V \ T`. -/
theorem sdiff_sdiff_sdiff {S T V : Finset (Fin r)} (hST : S ⊆ T) :
    (V \ S) \ (T \ S) = V \ T := by
  ext i
  simp only [Finset.mem_sdiff, not_and, not_not]
  constructor
  · rintro ⟨⟨hiV, hiS⟩, h⟩
    exact ⟨hiV, fun hiT ↦ hiS (h hiT)⟩
  · rintro ⟨hiV, hiT⟩
    exact ⟨⟨hiV, fun hiS ↦ hiT (hST hiS)⟩, fun hiT' ↦ absurd hiT' hiT⟩

/-- `T \ S` is contained in `V \ S` when `T ⊆ V`. -/
theorem sdiff_subset_sdiff_left {S T V : Finset (Fin r)} (hTV : T ⊆ V) :
    T \ S ⊆ V \ S := fun _ h ↦ Finset.mem_sdiff.mpr
  ⟨hTV (Finset.mem_sdiff.mp h).1, (Finset.mem_sdiff.mp h).2⟩

end Diff

section KoszulFunctor

variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}]
variable {r : ℕ}

/-- Multiplication by a global section of `O`, as an endomorphism of the identity functor of
the category of `O`-modules. -/
abbrev smulEnd (a : GlobalSection O) :
    End (𝟭 (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O))) :=
  Stacks.SheafOfModules.globalSectionToEnd (Stacks.SheafOfModules.Tensor.ringSheaf O) a

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- On a local section `x` of `M` over `U`, multiplication by `a` is `x ↦ a|_U • x`. -/
theorem smulEnd_app_apply (a : GlobalSection O)
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)) (U : Cᵒᵖ)
    (x : M.val.obj U) :
    ((smulEnd O a).app M).val.app U x = a.val U • x := rfl

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- Multiplication by a global section whose local values are all `1` is the identity. -/
theorem smulEnd_app_eq_id {a : GlobalSection O} (ha : ∀ U : Cᵒᵖ, a.val U = 1)
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)) :
    (smulEnd O a).app M = 𝟙 M := by
  ext U x
  rw [smulEnd_app_apply, ha, one_smul]
  rfl

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- Multiplication by a product of global sections is the composite of the two
multiplications. -/
theorem smulEnd_app_eq_comp {a b c : GlobalSection O}
    (habc : ∀ U : Cᵒᵖ, c.val U = b.val U * a.val U)
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)) :
    (smulEnd O c).app M = (smulEnd O a).app M ≫ (smulEnd O b).app M := by
  ext U x
  rw [smulEnd_app_apply]
  show c.val U • x = ((smulEnd O b).app M).val.app U (((smulEnd O a).app M).val.app U x)
  rw [smulEnd_app_apply, smulEnd_app_apply, habc, mul_smul]

/-- The rank-one `O`-module, the common value of the Koszul system. -/
abbrev koszulObj : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O) :=
  SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O)

/-- The Koszul system of a finite family of global sections: the constant diagram at the rank-one
module `O`, with the transition map along `S ⊆ T` given by multiplication by `f_{T \ S}`. -/
@[reducible] def koszulFunctor (f : Fin r → GlobalSection O) :
    Finset (Fin r) ⥤ SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O) where
  obj _ := koszulObj O
  map {S T} h := (smulEnd O (prodSection O f (T \ S))).app (koszulObj O)
  map_id S := smulEnd_app_eq_id O (fun U ↦ by
    rw [prodSection_val, Finset.sdiff_self, Finset.prod_empty]
    rfl) (koszulObj O)
  map_comp {S T V} h h' := smulEnd_app_eq_comp O (fun U ↦ by
    rw [prodSection_val, prodSection_val, prodSection_val,
      ← Finset.prod_sdiff (sdiff_subset_sdiff_left (leOfHom h')),
      sdiff_sdiff_sdiff (leOfHom h)]
    rfl) (koszulObj O)

/-- **The Koszul complex of a finite family of global sections**, as the alternating complex of
the Koszul system: in degree `p` the product of copies of `O` indexed by the subsets of
cardinality `p`, with the alternating differential whose `(S, T)`-entry for `S = T \ {k}` is
multiplication by `f_k`. -/
abbrev koszulComplex (f : Fin r → GlobalSection O) :
    CochainComplex (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)) ℤ :=
  AlternatingCech.complex (koszulFunctor O f)

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- The transition map of the Koszul system along `S ⊆ T` is multiplication by `f_{T \ S}`. -/
theorem koszulFunctor_map (f : Fin r → GlobalSection O) {S T : Finset (Fin r)} (h : S ⊆ T) :
    (koszulFunctor O f).map (homOfLE h) =
      (smulEnd O (prodSection O f (T \ S))).app (koszulObj O) := rfl

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- Multiplication by a global section is central: it commutes with every morphism. -/
theorem smulEnd_app_comp (a : GlobalSection O)
    {M N : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)} (g : M ⟶ N) :
    (smulEnd O a).app M ≫ g = g ≫ (smulEnd O a).app N :=
  ((smulEnd O a).naturality g).symm

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- Multiplication by two global sections with the same local values agrees. -/
theorem smulEnd_app_congr {a b : GlobalSection O} (hab : ∀ U : Cᵒᵖ, a.val U = b.val U)
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O)) :
    (smulEnd O a).app M = (smulEnd O b).app M := by
  ext U x
  rw [smulEnd_app_apply, smulEnd_app_apply, hab]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- A transition map of the Koszul system across a single new index `k` is multiplication by
`f_k`. -/
theorem koszulFunctor_map_single (f : Fin r → GlobalSection O) {S T : Finset (Fin r)}
    (h : S ⊆ T) {k : Fin r} (hk : T \ S = {k}) :
    (koszulFunctor O f).map (homOfLE h) = (smulEnd O (f k)).app (koszulObj O) := by
  rw [koszulFunctor_map]
  exact smulEnd_app_congr O (fun U ↦ by rw [prodSection_val, hk, Finset.prod_singleton]) _

/-- `B \ B.erase k = {k}` for `k ∈ B`. -/
theorem sdiff_erase_eq_singleton {S : Finset (Fin r)} {k : Fin r} (hk : k ∈ S) :
    S \ S.erase k = {k} := by
  ext i
  simp only [Finset.mem_sdiff, Finset.mem_erase, Finset.mem_singleton, not_and]
  constructor
  · rintro ⟨hiS, h⟩
    by_contra hik
    exact h hik hiS
  · rintro rfl
    exact ⟨hk, fun h _ ↦ h rfl⟩

/-- `insert j S \ S = {j}` for `j ∉ S`. -/
theorem insert_sdiff_eq_singleton {S : Finset (Fin r)} {j : Fin r} (hj : j ∉ S) :
    insert j S \ S = {j} := by
  ext i
  simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton]
  constructor
  · rintro ⟨hi, hiS⟩
    exact hi.resolve_right hiS
  · rintro rfl
    exact ⟨Or.inl rfl, hj⟩

/-- `insert j S \ insert j (S.erase k) = {k}` for `k ∈ S` and `j ∉ S`. -/
theorem insert_sdiff_insert_erase {S : Finset (Fin r)} {j k : Fin r} (hk : k ∈ S) (hj : j ∉ S) :
    insert j S \ insert j (S.erase k) = {k} := by
  have hkj : k ≠ j := fun h ↦ hj (h ▸ hk)
  ext i
  simp only [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_erase, Finset.mem_singleton, not_or,
    not_and]
  constructor
  · rintro ⟨hi, hij, h⟩
    by_contra hik
    exact h hik (hi.resolve_left hij)
  · rintro rfl
    exact ⟨Or.inr hk, hkj, fun h _ ↦ h rfl⟩

end KoszulFunctor

section Homotopy

variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}]
variable {r : ℕ} (f : Fin r → GlobalSection O) (j : Fin r)

open AlternatingCech

/-- **The contracting homotopy of the Koszul complex at the index `j`.** Its component at a
subset `A` of cardinality `q` is the projection onto the factor indexed by `A ∪ {j}`, with the
sign with which `j` enters `A ∪ {j}`, and is zero when `j` already lies in `A`. Unlike the
contracting homotopy of the extended alternating Čech complex, no transition map has to be
inverted: every term of the Koszul system is the same module `O`. -/
def koszulHtpy {p q : ℤ} (hqp : q + 1 = p) :
    term (koszulFunctor O f) p ⟶ term (koszulFunctor O f) q :=
  Pi.lift fun A : Idx r q =>
    if hA : j ∈ A.1 then 0
    else Cech.cechSign A.1 j •
      Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) (idxInsert j A hA hqp)

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- The component of the homotopy at a subset containing `j` vanishes. -/
theorem koszulHtpy_comp_pi_of_mem {p q : ℤ} (hqp : q + 1 = p) (A : Idx r q) (hA : j ∈ A.1) :
    koszulHtpy O f j hqp ≫ Pi.π (fun S : Idx r q => (koszulFunctor O f).obj S.1) A = 0 := by
  rw [koszulHtpy, Pi.lift_π, dite_eq_left hA]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- The component of the homotopy at a subset not containing `j`. -/
theorem koszulHtpy_comp_pi_of_notMem {p q : ℤ} (hqp : q + 1 = p) (A : Idx r q) (hA : j ∉ A.1) :
    koszulHtpy O f j hqp ≫ Pi.π (fun S : Idx r q => (koszulFunctor O f).obj S.1) A =
      Cech.cechSign A.1 j •
        Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) (idxInsert j A hA hqp) := by
  rw [koszulHtpy, Pi.lift_π, dite_eq_right hA]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- The component of the homotopy at a subset not containing `j`, read on a factor whose index
is only propositionally `A ∪ {j}`. -/
theorem koszulHtpy_comp_pi_of_eq {p q : ℤ} (hqp : q + 1 = p) (A : Idx r q) (hA : j ∉ A.1)
    (B : Idx r p) (hBA : B.1 = insert j A.1) :
    koszulHtpy O f j hqp ≫ Pi.π (fun S : Idx r q => (koszulFunctor O f).obj S.1) A =
      Cech.cechSign A.1 j •
        Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B := by
  rw [koszulHtpy_comp_pi_of_notMem O f j hqp A hA]
  congr 2
  exact Subtype.ext hBA.symm

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- The homotopy followed by the differential, read on the factor indexed by `B`. -/
private theorem htpy_comp_dAux_comp_pi {p q : ℤ} (hqp : q + 1 = p) (B : Idx r p) :
    koszulHtpy O f j hqp ≫ dAux (koszulFunctor O f) hqp ≫
        Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B =
      ∑ k ∈ B.1.attach, Cech.cechSign B.1 k.1 •
        ((koszulHtpy O f j hqp ≫
            Pi.π (fun S : Idx r q => (koszulFunctor O f).obj S.1) (idxErase B k hqp)) ≫
          (koszulFunctor O f).map (homOfLE (Finset.erase_subset (k : Fin r) B.1))) := by
  rw [dAux_comp_pi (koszulFunctor O f) hqp B, Preadditive.comp_sum]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [Preadditive.comp_zsmul, ← Category.assoc]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- **The homotopy identity.** In each degree, multiplication by `f_j` on the Koszul complex is
the sum of the two composites of the differential with the contracting homotopy at `j`. -/
theorem koszulHtpy_comp_dAux_add_dAux_comp_koszulHtpy {p q s : ℤ} (hqp : q + 1 = p)
    (hps : p + 1 = s) :
    koszulHtpy O f j hqp ≫ dAux (koszulFunctor O f) hqp +
        dAux (koszulFunctor O f) hps ≫ koszulHtpy O f j hps =
      (smulEnd O (f j)).app (term (koszulFunctor O f) p) := by
  classical
  refine Pi.hom_ext _ _ fun B ↦ ?_
  rw [Preadditive.add_comp, Category.assoc, Category.assoc,
    smulEnd_app_comp O (f j) (Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B)]
  by_cases hB : j ∈ B.1
  · have hzero : ∀ b ∈ B.1.attach, b ≠ (⟨j, hB⟩ : {x // x ∈ B.1}) →
        Cech.cechSign B.1 b.1 • ((koszulHtpy O f j hqp ≫
            Pi.π (fun S : Idx r q => (koszulFunctor O f).obj S.1) (idxErase B b hqp)) ≫
          (koszulFunctor O f).map (homOfLE (Finset.erase_subset (b : Fin r) B.1))) = 0 := by
      intro b _ hb
      have hjb : j ∈ (idxErase B b hqp).1 := by
        rw [val_idxErase]
        exact Finset.mem_erase.mpr ⟨fun h ↦ hb (Subtype.ext h.symm), hB⟩
      rw [koszulHtpy_comp_pi_of_mem O f j hqp _ hjb, zero_comp, smul_zero]
    have hA : j ∉ (idxErase B (⟨j, hB⟩ : {x // x ∈ B.1}) hqp).1 := by
      rw [val_idxErase]
      exact Finset.notMem_erase j B.1
    rw [koszulHtpy_comp_pi_of_mem O f j hps B hB, comp_zero, add_zero,
      htpy_comp_dAux_comp_pi O f j hqp B,
      Finset.sum_eq_single_of_mem (⟨j, hB⟩ : {x // x ∈ B.1}) (Finset.mem_attach _ _) hzero,
      koszulHtpy_comp_pi_of_eq O f j hqp _ hA B (by
        rw [val_idxErase]
        exact (Finset.insert_erase hB).symm),
      Preadditive.zsmul_comp, smul_smul,
      show Cech.cechSign B.1 ((⟨j, hB⟩ : {x // x ∈ B.1}) : Fin r) *
            Cech.cechSign ((idxErase B (⟨j, hB⟩ : {x // x ∈ B.1}) hqp).1) j = 1 from by
        rw [val_idxErase, Cech.cechSign_erase]
        exact cechSign_mul_self B.1 j,
      one_smul]
    congr 1
    exact koszulFunctor_map_single O f _ (sdiff_erase_eq_singleton hB)
  · obtain ⟨T, hTB⟩ : ∃ T : Idx r s, T.1 = insert j B.1 := ⟨idxInsert j B hB hps, rfl⟩
    have hjmem : ∀ k : {x // x ∈ B.1}, j ∉ (idxErase B k hqp).1 := fun k h ↦ by
      rw [val_idxErase] at h
      exact hB (Finset.mem_of_mem_erase h)
    have hTj : T.1.erase j = B.1 := by rw [hTB]; exact Finset.erase_insert hB
    have hTk : ∀ k : {x // x ∈ B.1}, T.1.erase k.1 = insert j (B.1.erase k.1) := fun k ↦ by
      rw [hTB]
      exact Finset.erase_insert_of_ne (fun h : j = k.1 ↦ hB (h ▸ k.2))
    have key1 : koszulHtpy O f j hqp ≫ dAux (koszulFunctor O f) hqp ≫
          Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B =
        ∑ k ∈ B.1.attach, (Cech.cechSign B.1 k.1 * Cech.cechSign (B.1.erase k.1) j) •
          (Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1)
              (idxInsert j (idxErase B k hqp) (hjmem k) hqp) ≫
            (smulEnd O (f k.1)).app (koszulObj O)) := by
      rw [htpy_comp_dAux_comp_pi O f j hqp B]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      rw [koszulHtpy_comp_pi_of_notMem O f j hqp _ (hjmem k),
        Preadditive.zsmul_comp, smul_smul,
        show Cech.cechSign B.1 (k : Fin r) *
              Cech.cechSign ((idxErase B k hqp).1) j =
            Cech.cechSign B.1 (k : Fin r) * Cech.cechSign (B.1.erase (k : Fin r)) j from by
          rw [val_idxErase]]
      congr 2
      exact koszulFunctor_map_single O f _ (sdiff_erase_eq_singleton k.2)
    have key2 : dAux (koszulFunctor O f) hps ≫ koszulHtpy O f j hps ≫
          Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B =
        (Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1) B ≫
            (smulEnd O (f j)).app (koszulObj O)) +
          ∑ k ∈ B.1.attach, (Cech.cechSign B.1 j * Cech.cechSign (insert j B.1) k.1) •
            (Pi.π (fun S : Idx r p => (koszulFunctor O f).obj S.1)
                (idxInsert j (idxErase B k hqp) (hjmem k) hqp) ≫
              (smulEnd O (f k.1)).app (koszulObj O)) := by
      rw [koszulHtpy_comp_pi_of_eq O f j hps B hB T hTB, Preadditive.comp_zsmul,
        dAux_comp_pi (koszulFunctor O f) hps T, Finset.smul_sum,
        sum_attach_insert_of_eq hTB hB]
      have hsignj : Cech.cechSign B.1 j * Cech.cechSign T.1 j = 1 := by
        rw [hTB, Cech.cechSign_insert]
        exact cechSign_mul_self B.1 j
      have hsignk : ∀ k : Fin r, Cech.cechSign T.1 k = Cech.cechSign (insert j B.1) k :=
        fun k ↦ by rw [hTB]
      have hBT : B.1 ⊆ T.1 := hTB ▸ Finset.subset_insert j B.1
      have hEsub : ∀ m : {x // x ∈ T.1}, (idxErase T m hps).1 ⊆ T.1 := fun m ↦ by
        rw [val_idxErase]
        exact Finset.erase_subset _ _
      have hXT : ∀ k : {x // x ∈ B.1},
          (idxInsert j (idxErase B k hqp) (hjmem k) hqp).1 ⊆ T.1 := fun k ↦ by
        rw [val_idxInsert, val_idxErase, ← hTk k]
        exact Finset.erase_subset _ _
      congr 1
      · rw [pi_comp_map_congr (koszulFunctor O f)
            (show idxErase T (⟨j, hTB ▸ Finset.mem_insert_self j B.1⟩ : {x // x ∈ T.1}) hps = B from
              Subtype.ext (by rw [val_idxErase, hTj])) (hEsub _) hBT,
          koszulFunctor_map_single O f hBT (k := j)
            (by rw [hTB]; exact insert_sdiff_eq_singleton hB),
          smul_smul, hsignj, one_smul]
      · refine Finset.sum_congr rfl fun k _ ↦ ?_
        rw [pi_comp_map_congr (koszulFunctor O f)
            (show idxErase T (⟨k.1, hTB ▸ Finset.mem_insert_of_mem k.2⟩ : {x // x ∈ T.1}) hps =
                idxInsert j (idxErase B k hqp) (hjmem k) hqp from
              Subtype.ext (by rw [val_idxErase, hTk k, val_idxInsert, val_idxErase]))
            (hEsub _) (hXT k),
          koszulFunctor_map_single O f (hXT k) (k := k.1)
            (by rw [val_idxInsert, val_idxErase, hTB]
                exact insert_sdiff_insert_erase k.2 hB),
          smul_smul, hsignk]
    rw [key1, key2, show ∀ (Z : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf O))
        (a b c : term (koszulFunctor O f) p ⟶ Z), a + (b + c) = (a + c) + b from
      fun _ a b c ↦ by rw [add_comm b c, ← add_assoc], ← Finset.sum_add_distrib,
      Finset.sum_eq_zero (fun k _ ↦ by
        rw [← add_smul, cechSign_erase_add_cechSign_insert k.2 hB, zero_smul]),
      zero_add]

/-- Multiplication by `f_j`, as an endomorphism of the Koszul complex. -/
def koszulSmulMap : koszulComplex O f ⟶ koszulComplex O f where
  f p := (smulEnd O (f j)).app ((koszulComplex O f).X p)
  comm' p q _ := smulEnd_app_comp O (f j) ((koszulComplex O f).d p q)

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- In degree `p`, `koszulSmulMap O f j` is multiplication by `f_j` on the `p`-th term. -/
@[simp] theorem koszulSmulMap_f (p : ℤ) :
    (koszulSmulMap O f j).f p = (smulEnd O (f j)).app ((koszulComplex O f).X p) := rfl

/-- **Multiplication by `f_j` is null-homotopic on the Koszul complex**: the contracting
homotopy at `j` realises it. -/
def koszulSmulNullHomotopic : Homotopy (koszulSmulMap O f j) 0 :=
  (CochainComplex.HomComplex.Cochain.equivHomotopy _ _).symm
    ⟨CochainComplex.HomComplex.Cochain.mk
      (fun p q _ => koszulHtpy O f j (show q + 1 = p by omega)), by
      ext p : 1
      rw [CochainComplex.HomComplex.Cochain.ofHom_v,
        CochainComplex.HomComplex.Cochain.add_v,
        CochainComplex.HomComplex.δ_v (-1) 0 (neg_add_cancel 1) _ p p (add_zero p) (p - 1)
          (p + 1) rfl rfl]
      simp only [CochainComplex.HomComplex.Cochain.ofHom_v, Int.negOnePow_zero, one_smul,
        HomologicalComplex.zero_f, add_zero, koszulSmulMap_f]
      rw [complex_d_eq (koszulFunctor O f) (show p - 1 + 1 = p by omega),
        complex_d_eq (koszulFunctor O f) (show p + 1 = p + 1 from rfl)]
      exact (koszulHtpy_comp_dAux_add_dAux_comp_koszulHtpy O f j
        (show p - 1 + 1 = p by omega) (show p + 1 = p + 1 from rfl)).symm⟩

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})] in
/-- The map induced on cohomology by multiplication by `f_j` is multiplication by `f_j`. -/
theorem homologyMap_koszulSmulMap (p : ℤ) :
    HomologicalComplex.homologyMap (koszulSmulMap O f j) p =
      (smulEnd O (f j)).app ((koszulComplex O f).homology p) := by
  have hcyc : HomologicalComplex.cyclesMap (koszulSmulMap O f j) p =
      (smulEnd O (f j)).app ((koszulComplex O f).cycles p) := by
    rw [← cancel_mono ((koszulComplex O f).iCycles p), HomologicalComplex.cyclesMap_i]
    exact (smulEnd_app_comp O (f j) ((koszulComplex O f).iCycles p)).symm
  rw [← cancel_epi ((koszulComplex O f).homologyπ p), HomologicalComplex.homologyπ_naturality,
    hcyc]
  exact smulEnd_app_comp O (f j) ((koszulComplex O f).homologyπ p)

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})] in
/-- **[Stacks, Tag 0663] for a finite family of global sections of a sheaf of rings on a site.**
Each `f_j` annihilates every cohomology sheaf of the Koszul complex, because multiplication by
`f_j` is null-homotopic on that complex. -/
theorem smulEnd_app_homology_eq_zero (p : ℤ) :
    (smulEnd O (f j)).app ((koszulComplex O f).homology p) = 0 := by
  rw [← homologyMap_koszulSmulMap O f j p,
    (koszulSmulNullHomotopic O f j).homologyMap_eq p, HomologicalComplex.homologyMap_zero]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})] in
/-- The sectionwise form: `f_j` kills every local section of every cohomology sheaf of the
Koszul complex. -/
theorem smul_homology_eq_zero (p : ℤ) (X : Cᵒᵖ)
    (x : ((koszulComplex O f).homology p).val.obj X) :
    (f j).val X • x = 0 := by
  have h := smulEnd_app_homology_eq_zero O f j p
  have h2 := congrArg (fun (ψ : ((koszulComplex O f).homology p) ⟶
    ((koszulComplex O f).homology p)) => ψ.val.app X x) h
  rw [smulEnd_app_apply] at h2
  exact h2

end Homotopy

end Stacks.Sheaves.KoszulGlobalSections

