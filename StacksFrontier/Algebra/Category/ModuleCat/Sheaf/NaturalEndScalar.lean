module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalSectionSmul
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators

/-!
# Natural endomorphisms that are multiplication by a global section

Let `R` be a sheaf of rings with commutative rings of sections on a site.  Every endomorphism of
the structure sheaf `𝒪 = unit R`, viewed as a module over itself, is multiplication by a global
section of `R`.  Consequently, for a functor `X` into sheaves of `R`-modules sending an object `O`
to a module isomorphic to `𝒪`, a natural endomorphism `τ` of `X` is multiplication by one global
section at every object `F` whose image is jointly generated by the images of morphisms `O ⟶ F`;
in particular it commutes with *every* morphism between such images, not only with those in the
image of `X`.

This is the form in which the comparison of two systems of canonical identifications of iterated
inverse images is shown to be harmless: their discrepancy is such a natural endomorphism.

## Main results

* `Stacks.SheafOfModules.eq_globalSectionToEnd_app_unit`: an endomorphism of `unit R` is
  multiplication by a global section.
* `Stacks.SheafOfModules.app_eq_globalSectionToEnd_app_of_jointlyEpi`: the natural endomorphism
  is that multiplication at every jointly generated object.
* `Stacks.SheafOfModules.jointlyEpi_map_of_generatingSections`: for a left adjoint, the images of
  a family of generating sections are jointly epimorphic.
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite

universe v u w m

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (R : Sheaf J RingCat.{w}) [∀ U, IsMulCommutative (R.obj.obj U)]

open scoped IsMulCommutative

/-- The compatible family of local sections of `R` attached to an endomorphism of `unit R`: its
value on `1` over every object. -/
def unitEndSection (u : _root_.SheafOfModules.unit R ⟶ _root_.SheafOfModules.unit R) :
    (R.obj ⋙ forget RingCat).sections where
  val U := ((_root_.SheafOfModules.unit R).unitHomEquiv u).val U
  property {_U _V} i := ((_root_.SheafOfModules.unit R).unitHomEquiv u).property i

/-- **An endomorphism of the structure sheaf is multiplication by a global section.** -/
theorem eq_globalSectionToEnd_app_unit
    (u : _root_.SheafOfModules.unit R ⟶ _root_.SheafOfModules.unit R) :
    u = (globalSectionToEnd.{v, u, w, w} R (unitEndSection R u)).asHom.app
      (_root_.SheafOfModules.unit R) := by
  apply (_root_.SheafOfModules.unit R).unitHomEquiv.injective
  ext U
  rw [_root_.SheafOfModules.unitHomEquiv_apply_coe, _root_.SheafOfModules.unitHomEquiv_apply_coe]
  exact (mul_one ((unitEndSection R u).val U)).symm

variable {R}

/-- An endomorphism of a module isomorphic to the structure sheaf is multiplication by a global
section. -/
theorem exists_eq_globalSectionToEnd_app_of_iso {P : _root_.SheafOfModules.{w} R}
    (κ : P ≅ _root_.SheafOfModules.unit R) (t : P ⟶ P) :
    ∃ f : (R.obj ⋙ forget RingCat).sections, t = (globalSectionToEnd.{v, u, w, w} R f).asHom.app P := by
  refine ⟨unitEndSection R (κ.inv ≫ t ≫ κ.hom), ?_⟩
  have hn := (globalSectionToEnd.{v, u, w, w} R (unitEndSection R (κ.inv ≫ t ≫ κ.hom))).asHom.naturality
    κ.hom
  simp only [Functor.id_map] at hn
  rw [← Iso.cancel_iso_hom_right _ _ κ, ← hn,
    ← eq_globalSectionToEnd_app_unit R (κ.inv ≫ t ≫ κ.hom)]
  simp

/-- **A natural endomorphism which is multiplication by a global section at `O` is that
multiplication at every object whose image is jointly generated by images of morphisms out of
`O`.** -/
theorem app_eq_globalSectionToEnd_app_of_jointlyEpi {K : Type*} [Category K]
    (X : K ⥤ _root_.SheafOfModules.{m} R) (τ : X ⟶ X) {O : K}
    (f : (R.obj ⋙ forget RingCat).sections)
    (hf : τ.app O = (globalSectionToEnd.{v, u, w, m} R f).asHom.app (X.obj O))
    {F : K} {ι : Type*} (s : ι → (O ⟶ F))
    (hs : ∀ {P : _root_.SheafOfModules.{m} R} (a b : X.obj F ⟶ P),
      (∀ i, X.map (s i) ≫ a = X.map (s i) ≫ b) → a = b) :
    τ.app F = (globalSectionToEnd.{v, u, w, m} R f).asHom.app (X.obj F) := by
  refine hs _ _ fun i => ?_
  rw [τ.naturality, hf]
  exact ((globalSectionToEnd.{v, u, w, m} R f).asHom.naturality (X.map (s i))).symm

/-- Multiplication by a global section commutes with every morphism. -/
theorem globalSectionToEnd_app_comp (f : (R.obj ⋙ forget RingCat).sections)
    {P Q : _root_.SheafOfModules.{m} R} (φ : P ⟶ Q) :
    (globalSectionToEnd.{v, u, w, m} R f).asHom.app P ≫ φ =
      φ ≫ (globalSectionToEnd.{v, u, w, m} R f).asHom.app Q :=
  ((globalSectionToEnd.{v, u, w, m} R f).asHom.naturality φ).symm

end Stacks.SheafOfModules

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
  [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **The images under a left adjoint of a family of generating sections are jointly
epimorphic.** -/
theorem jointlyEpi_map_of_generatingSections {D : Type*} [Category D]
    (X : _root_.SheafOfModules.{w} R ⥤ D) (hX : X.IsLeftAdjoint) {F : _root_.SheafOfModules.{w} R}
    (σ : F.GeneratingSections) {P : D} (a b : X.obj F ⟶ P)
    (h : ∀ i, X.map (F.unitHomEquiv.symm (σ.s i)) ≫ a =
      X.map (F.unitHomEquiv.symm (σ.s i)) ≫ b) : a = b := by
  let adj := @Adjunction.ofIsLeftAdjoint _ _ _ _ X hX
  apply (adj.homEquiv F P).injective
  have hi : ∀ i, _root_.SheafOfModules.ιFree i ≫ σ.π = F.unitHomEquiv.symm (σ.s i) := fun i => by
    rw [← _root_.SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply σ.π i]
    congr 1
    exact congrFun (F.freeHomEquiv.apply_symm_apply σ.s) i
  rw [← cancel_epi σ.π]
  apply (_root_.SheafOfModules.freeHomEquiv _).injective
  funext i
  show (X.rightAdjoint.obj P).unitHomEquiv (_root_.SheafOfModules.ιFree i ≫ σ.π ≫ _) =
    (X.rightAdjoint.obj P).unitHomEquiv (_root_.SheafOfModules.ιFree i ≫ σ.π ≫ _)
  rw [← Category.assoc, hi, ← Category.assoc, hi, ← adj.homEquiv_naturality_left,
    ← adj.homEquiv_naturality_left, h i]

end Stacks.SheafOfModules

end
