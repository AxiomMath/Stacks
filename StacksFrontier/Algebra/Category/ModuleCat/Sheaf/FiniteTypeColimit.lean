/-!
# Finite-type sheaves of modules in a directed colimit

Let `X` be a quasi-compact space, `R` a sheaf of rings on it and `F : I ⥤ SheafOfModules R` a
directed system whose colimit is of finite type. Stacks 01BB says that the colimit is already
generated by one stage: some `colimit.ι F i` is an epimorphism. If moreover every transition
map of the system is injective, then that `colimit.ι F i` is an isomorphism.

## Main results

* `Stacks.SheafOfModules.exists_epi_to_colimit_of_isFiniteType`: some `colimit.ι F i` is an
  epimorphism.
* `Stacks.SheafOfModules.exists_isIso_to_colimit_of_isFiniteType`: some `colimit.ι F i` is an
  isomorphism when the transition maps are injective.

## Implementation notes

The result is stated for a sheaf of arbitrary (not necessarily commutative) rings on a
topological space. Surjectivity and injectivity of morphisms of sheaves are expressed
categorically by `Epi` and `Mono`, and "equals a stage" by the canonical colimit map being an
isomorphism.

## References

* [Stacks Project, Tag 01BB](https://stacks.math.columbia.edu/tag/01BB)
* [Stacks Project, Tag 01AH](https://stacks.math.columbia.edu/tag/01AH), colimits of sheaves of
  modules and their stalks.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.SheafOfModules

private noncomputable def sectionsOfTerminalValue {C : Type*} [Category C] {R : Cᵒᵖ ⥤ RingCat.{u}}
    (M : PresheafOfModules.{u} R) (T : C) (hT : IsTerminal T)
    (t : M.obj (op T)) : M.sections :=
  M.sectionsMk (fun Y => M.map (hT.from Y.unop).op t) fun X Y f => by
    rw [← M.map_comp_apply, show (hT.from X.unop).op ≫ f = (hT.from Y.unop).op from
      Quiver.Hom.unop_inj (hT.comp_from f.unop)]

private lemma sections_ext_of_terminal {C : Type*} [Category C]
    {R : Cᵒᵖ ⥤ RingCat.{u}} (M : PresheafOfModules.{u} R) (T : C)
    (hT : IsTerminal T) (s t : M.sections)
    (h : s.eval (op T) = t.eval (op T)) : s = t := by
  apply PresheafOfModules.sections_ext
  intro Y
  let f := (hT.from Y.unop).op
  have hm : M.map f (s.eval (op T)) = M.map f (t.eval (op T)) :=
    congrArg (ConcreteCategory.hom (M.map f)) h
  exact (s.property f).symm.trans (hm.trans (t.property f))

private lemma sectionsMap_eval {C : Type*} [Category C]
    {R : Cᵒᵖ ⥤ RingCat.{u}} {M N : PresheafOfModules.{u} R}
    (f : M ⟶ N) (s : M.sections) (Y : Cᵒᵖ) :
    (PresheafOfModules.sectionsMap f s).eval Y = f.app Y (s.eval Y) := rfl

private lemma sheaf_unitHomEquiv_symm_app_one
    {C : Type*} [Category C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{u}} [HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (M : SheafOfModules.{u} R) (s : M.sections) (Y : Cᵒᵖ) :
    (M.unitHomEquiv.symm s).val.app Y (1 : R.obj.obj Y) = s.eval Y := by
  change ((PresheafOfModules.unitHomEquiv M.val).symm s).app Y
    (1 : R.obj.obj Y) = s.eval Y
  simp only [PresheafOfModules.unitHomEquiv]
  change (1 : R.obj.obj Y) • s.eval Y = s.eval Y
  simp

@[simp]
private lemma sectionsOfTerminalValue_eval {C : Type*} [Category C]
    {R : Cᵒᵖ ⥤ RingCat.{u}} (M : PresheafOfModules.{u} R) (T : C)
    (hT : IsTerminal T) (t : M.obj (op T)) :
    (sectionsOfTerminalValue M T hT t).eval (op T) = t := by
  change M.map (hT.from T).op t = t
  rw [hT.from_self, op_id, M.map_id]
  simp only [ModuleCat.restrictScalarsId'_inv_app,
    ModuleCat.restrictScalarsId'App_inv_apply]
  rfl

private def terminalOverOpen {X : TopCat.{u}} (W : Opens X) :
    IsTerminal (Over.mk (𝟙 W)) := by
  letI : ∀ Z, Unique (Z ⟶ Over.mk (𝟙 W)) := fun Z => {
    default := Over.homMk Z.hom (by simp)
    uniq := fun f => by
      ext
      simpa using f.w }
  exact IsTerminal.ofUnique _

variable {X : TopCat.{u}}
  (R : Sheaf (Opens.grothendieckTopology X) RingCat.{u})
  [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U, HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u}]
  [∀ U, ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{u}]
  {I : Type u} [Preorder I] [Nonempty I] [IsDirectedOrder I]

omit [∀ U, HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u}]
  [∀ U, ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
private lemma exists_local_lift_from_stage (F : I ⥤ SheafOfModules.{u} R)
    (V : Opens X) (x : X) (hxV : x ∈ V)
    (s : (colimit F).val.presheaf.obj (op V)) :
    ∃ (W : Opens X) (hWV : W ≤ V) (_hxW : x ∈ W) (i : I)
      (t : (F.obj i).val.presheaf.obj (op W)),
      (ConcreteCategory.hom (((SheafOfModules.toSheaf R).map
        (colimit.ι F i)).hom.app (op W))) t =
        (colimit F).val.presheaf.map (homOfLE hWV).op s := by
  let St := AlgebraicGeometry.SheafOfModules.stalkFunctor R x
  let G := F ⋙ St
  have hcol : IsColimit (St.mapCocone (colimit.cocone F)) :=
    isColimitOfPreserves St (colimit.isColimit F)
  let germ := (ConcreteCategory.hom
    (TopCat.Presheaf.germ (C := AddCommGrpCat.{u})
      (X := X) (colimit F).val.presheaf V x hxV)) s
  obtain ⟨i, ti, hti⟩ := Concrete.isColimit_exists_rep G hcol germ
  obtain ⟨V₀, hxV₀, t₀, ht₀⟩ :=
    TopCat.Presheaf.exists_germ_eq (F.obj i).val.presheaf ti
  let fi : (F.obj i).val.presheaf ⟶ (colimit F).val.presheaf :=
    (PresheafOfModules.toPresheaf R.obj).map
      ((SheafOfModules.forget R).map (colimit.ι F i))
  have hti' : (ConcreteCategory.hom
      ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map fi)) ti = germ := by
    change (ConcreteCategory.hom
      ((AlgebraicGeometry.SheafOfModules.stalkMap R x (colimit.ι F i)))) ti = germ at hti
    change (ConcreteCategory.hom
      ((AlgebraicGeometry.SheafOfModules.stalkMap R x (colimit.ι F i)))) ti = germ
    simpa [AlgebraicGeometry.SheafOfModules.stalkMap, fi] using hti
  have hfi : (TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map fi
      ((TopCat.Presheaf.germ (C := AddCommGrpCat.{u})
        (X := X) (F.obj i).val.presheaf V₀ x hxV₀) t₀) = germ := by
    rw [ht₀]
    exact hti'
  have hmap : (ConcreteCategory.hom
      (TopCat.Presheaf.germ (C := AddCommGrpCat.{u})
        (X := X) (colimit F).val.presheaf V₀ x hxV₀))
      ((ConcreteCategory.hom (fi.app (op V₀))) t₀) = germ := by
    rw [← TopCat.Presheaf.stalkFunctor_map_germ_apply]
    exact hfi
  have heq := TopCat.Presheaf.germ_eq (colimit F).val.presheaf x hxV₀ hxV
    ((ConcreteCategory.hom (fi.app (op V₀))) t₀) s hmap
  obtain ⟨W, hxW, hWV₀, hWV, hsections⟩ := heq
  refine ⟨W, leOfHom hWV, hxW,
    i, (ConcreteCategory.hom ((F.obj i).val.presheaf.map hWV₀.op)) t₀, ?_⟩
  change (ConcreteCategory.hom (fi.app (op W)))
      ((ConcreteCategory.hom ((F.obj i).val.presheaf.map hWV₀.op)) t₀) =
    (ConcreteCategory.hom ((colimit F).val.presheaf.map hWV.op)) s
  have hnat := fi.naturality hWV₀.op
  rw [← ConcreteCategory.comp_apply, hnat, ConcreteCategory.comp_apply]
  exact hsections

private lemma exists_common_upper_bound {J : Type*} [Finite J]
    (f : J → I) : ∃ k : I, ∀ j, f j ≤ k := by
  obtain ⟨k, hk⟩ := (Set.finite_range f).bddAbove
  exact ⟨k, fun j => hk ⟨j, rfl⟩⟩

omit [Nonempty I] [IsDirectedOrder I] in
private lemma epi_overMap_of_generators_lift
    (F : I ⥤ SheafOfModules.{u} R) (U W : Opens X) (hWU : W ≤ U)
    (gs : ((colimit F).over U).GeneratingSections) [Finite gs.I]
    (i : I) (lift : gs.I → (F.obj i).val.presheaf.obj (op W))
    (hlift : ∀ j,
      (ConcreteCategory.hom (((SheafOfModules.toSheaf R).map
        (colimit.ι F i)).hom.app (op W))) (lift j) =
          (ConcreteCategory.hom ((colimit F).val.presheaf.map (homOfLE hWU).op))
            ((gs.s j).val (op (Over.mk (𝟙 U))))) :
    Epi ((SheafOfModules.overMap R (homOfLE hWU)).map
      ((colimit.ι F i).over U)) := by
  let _ := Fintype.ofFinite gs.I
  let H := SheafOfModules.overMap R (homOfLE hWU)
  let m := H.map ((colimit.ι F i).over U)
  let ψ := (((colimit F).over U).freeHomEquiv).symm gs.s
  let η := (SheafOfModules.overMapUnitIso (R := R) (homOfLE hWU)).symm
  let e := SheafOfModules.mapFreeIso H gs.I η
  let hT := terminalOverOpen W
  let θ := (((H.obj ((F.obj i).over U)).freeHomEquiv).symm
    (fun j => sectionsOfTerminalValue (H.obj ((F.obj i).over U)).val
      (Over.mk (𝟙 W)) hT (lift j)))
  have _ : Epi ψ := gs.epi
  have _ : Epi (H.map ψ) := Functor.map_epi H ψ
  have _ : Epi (e.hom ≫ H.map ψ) := inferInstance
  have hfun : (H.obj ((colimit F).over U)).freeHomEquiv (θ ≫ m) =
      (H.obj ((colimit F).over U)).freeHomEquiv (e.hom ≫ H.map ψ) := by
    funext j
    apply sections_ext_of_terminal (H.obj ((colimit F).over U)).val
      (Over.mk (𝟙 W)) hT
    simp only [SheafOfModules.freeHomEquiv_comp_apply]
    rw [sectionsMap_eval]
    simp only [θ, Equiv.apply_symm_apply]
    refine Eq.trans (congrArg
      (ConcreteCategory.hom (m.val.app (op (Over.mk (𝟙 W)))))
      (sectionsOfTerminalValue_eval (H.obj ((F.obj i).over U)).val
        (Over.mk (𝟙 W)) hT (lift j))) ?_
    rw [SheafOfModules.freeHomEquiv_apply, sectionsMap_eval]
    change (ConcreteCategory.hom (m.val.app (op (Over.mk (𝟙 W)))) (lift j)) =
      (ConcreteCategory.hom ((H.map ψ).val.app (op (Over.mk (𝟙 W)))))
        ((ConcreteCategory.hom
          ((SheafOfModules.mapFree H gs.I η.hom).val.app (op (Over.mk (𝟙 W)))))
          ((SheafOfModules.freeSection j).eval (op (Over.mk (𝟙 W)))))
    have hgen : SheafOfModules.ιFree j ≫ ψ =
        ((colimit F).over U).unitHomEquiv.symm (gs.s j) := by
      rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply]
      simp [ψ]
    let one : (SheafOfModules.unit (R.over W)).val.obj
        (op (Over.mk (𝟙 W))) :=
      (1 : (R.over W).obj.obj (op (Over.mk (𝟙 W))))
    have hfree : (SheafOfModules.freeSection j).eval (op (Over.mk (𝟙 W))) =
        (ConcreteCategory.hom
          ((SheafOfModules.ιFree j).val.app (op (Over.mk (𝟙 W)))))
          one := rfl
    have hgmApp :
        (SheafOfModules.ιFree j).val.app (op (Over.mk (𝟙 W))) ≫
        (SheafOfModules.mapFree H gs.I η.hom).val.app (op (Over.mk (𝟙 W))) =
          (η.hom ≫ H.map (SheafOfModules.ιFree j)).val.app
            (op (Over.mk (𝟙 W))) := by
      simpa only [SheafOfModules.comp_val, PresheafOfModules.comp_app] using
        congrArg (fun f => f.val.app (op (Over.mk (𝟙 W))))
          (SheafOfModules.ιFree_mapFree H gs.I η.hom j)
    have hright :
        (ConcreteCategory.hom ((H.map ψ).val.app (op (Over.mk (𝟙 W)))))
          ((ConcreteCategory.hom
            ((SheafOfModules.mapFree H gs.I η.hom).val.app (op (Over.mk (𝟙 W)))))
            ((SheafOfModules.freeSection j).eval (op (Over.mk (𝟙 W))))) =
        (ConcreteCategory.hom ((colimit F).val.presheaf.map (homOfLE hWU).op))
          ((gs.s j).val (op (Over.mk (𝟙 U)))) := by
      rw [← ConcreteCategory.comp_apply, hfree, ← ConcreteCategory.comp_apply, ← Category.assoc,
        hgmApp, ← PresheafOfModules.comp_app, ← SheafOfModules.comp_val, Category.assoc,
        ← Functor.map_comp, hgen, SheafOfModules.comp_val, PresheafOfModules.comp_app,
        ConcreteCategory.comp_apply]
      let oneH : (H.obj (SheafOfModules.unit (R.over U))).val.obj
          (op (Over.mk (𝟙 W))) :=
        (1 : (R.over W).obj.obj (op (Over.mk (𝟙 W))))
      have hone : η.hom.val.app (op (Over.mk (𝟙 W))) one = oneH := by
        simp [η, SheafOfModules.overMapUnitIso, one, oneH]
        rfl
      rw [hone]
      dsimp [H, SheafOfModules.overMap, SheafOfModules.pushforward] at oneH ⊢
      have hval := sheaf_unitHomEquiv_symm_app_one
        ((colimit F).over U) (gs.s j)
        (op ((Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W))))
      have hval' :
          (ConcreteCategory.hom
            ((((colimit F).over U).unitHomEquiv.symm (gs.s j)).val.app
              (op ((Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W)))))) oneH =
        (gs.s j).val
          (op ((Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W)))) := hval
      have hrestr :
          (ConcreteCategory.hom ((colimit F).val.presheaf.map (homOfLE hWU).op))
            ((gs.s j).val (op (Over.mk (𝟙 U)))) =
              (gs.s j).val
                (op ((Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W)))) := by
        let g : (Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W)) ⟶ Over.mk (𝟙 U) :=
          Over.homMk (homOfLE hWU)
        have hp := (gs.s j).property g.op
        change (ConcreteCategory.hom
          ((colimit F).val.presheaf.map (homOfLE hWU).op))
          ((gs.s j).val (op (Over.mk (𝟙 U)))) =
            (gs.s j).val
              (op ((Over.map (homOfLE hWU)).obj (Over.mk (𝟙 W)))) at hp
        exact hp
      exact hval'.trans hrestr.symm
    exact (hlift j).trans hright.symm
  have hfac : θ ≫ m = e.hom ≫ H.map ψ :=
    (H.obj ((colimit F).over U)).freeHomEquiv.injective hfun
  have _ : Epi (θ ≫ m) := by rw [hfac]; infer_instance
  exact epi_of_epi θ m

omit [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U, HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u}]
  [∀ U, ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
private lemma stalkFunctor_preserves_mono (x : X) {M N : SheafOfModules.{u} R}
    (f : M ⟶ N) [Mono f] :
    Mono ((AlgebraicGeometry.SheafOfModules.stalkFunctor R x).map f) := by
  have hm : Mono ((SheafOfModules.toSheaf R).map f) :=
    CategoryTheory.preserves_mono_of_preservesLimit (SheafOfModules.toSheaf R) f
  have hs : Mono ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((SheafOfModules.toSheaf R).map f).hom) :=
    (TopCat.Presheaf.mono_iff_stalk_mono ((SheafOfModules.toSheaf R).map f)).mp hm x
  exact (ModuleCat.mono_iff_injective _).mpr fun _ _ h =>
    (AddCommGrpCat.mono_iff_injective _).mp hs h

omit [∀ U, HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u}]
  [∀ U, ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
private lemma colimit_ι_mono (F : I ⥤ SheafOfModules.{u} R)
    [∀ (i j : I) (f : i ⟶ j), Mono (F.map f)] (i : I) :
    Mono (colimit.ι F i) := by
  apply (SheafOfModules.toSheaf R).mono_of_mono_map
  apply (TopCat.Presheaf.mono_iff_stalk_mono _).mpr
  intro x
  let G := F ⋙ AlgebraicGeometry.SheafOfModules.stalkFunctor R x
  have _ : ∀ (j k : I) (f : j ⟶ k), Mono (G.map f) := fun _ _ f =>
    stalkFunctor_preserves_mono R x (F.map f)
  have _ : PreservesColimits (AlgebraicGeometry.SheafOfModules.stalkFunctor R x) :=
    AlgebraicGeometry.SheafOfModules.stalkFunctor_preservesColimits R x
  have hm : Mono ((AlgebraicGeometry.SheafOfModules.stalkFunctor R x).map (colimit.ι F i)) :=
    (isColimitOfPreserves (AlgebraicGeometry.SheafOfModules.stalkFunctor R x)
      (colimit.isColimit F)).mono_ι_app_of_isFiltered i
  exact (AddCommGrpCat.mono_iff_injective _).mpr ((ModuleCat.mono_iff_injective _).mp hm)

private lemma epi_overMap_of_generators_lifted_to_common_stage
    (F : I ⥤ SheafOfModules.{u} R) (U : Opens X) (x : X) (hx : x ∈ U)
    (gs : ((colimit F).over U).GeneratingSections)
    [Finite gs.I]
    (Wj : gs.I → Opens X) (hWjU : ∀ j, Wj j ≤ U) (hxWj : ∀ j, x ∈ Wj j)
    (ij : gs.I → I) (tj : ∀ j, (F.obj (ij j)).val.obj (op (Wj j)))
    (htj : ∀ j,
      (ConcreteCategory.hom (((SheafOfModules.toSheaf R).map
        (colimit.ι F (ij j))).hom.app (op (Wj j)))) (tj j) =
        (ConcreteCategory.hom ((colimit F).val.presheaf.map
          (homOfLE (hWjU j)).op)) ((gs.s j).val (op (Over.mk (𝟙 U))))) :
    ∃ (W : Opens X) (hWU : W ≤ U) (_hxW : x ∈ W) (k : I),
      Epi ((SheafOfModules.overMap R (homOfLE hWU)).map
        ((colimit.ι F k).over U)) := by
  let _ := Fintype.ofFinite gs.I
  let W : Opens X := U ⊓ ⨅ j, Wj j
  have hWU : W ≤ U := inf_le_left
  have hxW : x ∈ W := ⟨hx, show x ∈ ((⨅ j, Wj j : Opens X) : Set X) by
    rw [Opens.coe_iInf]
    exact Set.mem_iInter.mpr hxWj⟩
  have hWWj (j : gs.I) : W ≤ Wj j := le_trans inf_le_right (iInf_le _ j)
  obtain ⟨k, hik⟩ := exists_common_upper_bound (fun j : gs.I => ij j)
  let resj : ∀ j, (F.obj (ij j)).val.obj (op W) := fun j =>
    (show (F.obj (ij j)).val.obj (op W) from
      (((F.obj (ij j)).val.map (homOfLE (hWWj j)).op) (tj j)))
  let lift : gs.I → (F.obj k).val.obj (op W) := fun j =>
    ((F.map (homOfLE (hik j))).val.app (op W))
      (resj j)
  have hlift (j : gs.I) :
      ((colimit.ι F k).val.app (op W)) (lift j) =
        ((colimit F).val.map (homOfLE hWU).op)
          ((gs.s j).val (op (Over.mk (𝟙 U)))) := by
    have hcol := congrArg (fun q => q.val.app (op W))
      (colimit.w F (homOfLE (hik j)))
    have hcol' := congrArg (fun f => f (resj j)) hcol
    have hcol'' :
        (ConcreteCategory.hom (((colimit.ι F k).val.app (op W))))
            ((ConcreteCategory.hom (((F.map (homOfLE (hik j))).val.app (op W))))
              (resj j)) =
          (ConcreteCategory.hom (((colimit.ι F (ij j)).val.app (op W)))) (resj j) := by
      simpa only [SheafOfModules.comp_val, PresheafOfModules.comp_app,
        ConcreteCategory.comp_apply] using hcol'
    have hnat := PresheafOfModules.naturality_apply
      (colimit.ι F (ij j)).val (homOfLE (hWWj j)).op (tj j)
    have hnat' : ((colimit.ι F (ij j)).val.app (op W)) (resj j) =
        ((colimit F).val.map (homOfLE (hWWj j)).op)
          (((colimit.ι F (ij j)).val.app (op (Wj j))) (tj j)) := by
      simpa [resj] using hnat
    have htj' : ((colimit.ι F (ij j)).val.app (op (Wj j))) (tj j) =
        ((colimit F).val.map (homOfLE (hWjU j)).op)
          ((gs.s j).val (op (Over.mk (𝟙 U)))) := by
      change (ConcreteCategory.hom (((SheafOfModules.toSheaf R).map
        (colimit.ι F (ij j))).hom.app (op (Wj j)))) (tj j) = _
      exact htj j
    dsimp [lift]
    rw [hcol'', hnat', htj']
    change ((colimit F).val.map (homOfLE (hWWj j)).op)
        (((colimit F).val.map (homOfLE (hWjU j)).op)
          ((gs.s j).val (op (Over.mk (𝟙 U))))) =
      ((colimit F).val.map (homOfLE hWU).op)
        ((gs.s j).val (op (Over.mk (𝟙 U))))
    rw [← (colimit F).val.map_comp_apply
      (homOfLE (hWjU j)).op (homOfLE (hWWj j)).op
      ((gs.s j).val (op (Over.mk (𝟙 U))))]
    congr 1
  exact ⟨W, hWU, hxW, k,
    epi_overMap_of_generators_lift (R := R) F U W hWU gs k lift hlift⟩

omit [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}] in
private lemma epi_overFunctor_of_epi_overMap
    {M N : SheafOfModules.{u} R} (f : M ⟶ N)
    (U W : Opens X) (hWU : W ≤ U)
    (hE : Epi ((SheafOfModules.overMap R (homOfLE hWU)).map (f.over U))) :
    Epi ((SheafOfModules.overFunctor R W).map f) := by
  let e := SheafOfModules.overFunctorMap (R := R) (homOfLE hWU)
  have _ : Epi ((SheafOfModules.overFunctor R U ⋙
      SheafOfModules.overMap R (homOfLE hWU)).map f) := by
    simpa only [Functor.comp_map] using hE
  have _ : Epi (e.hom.app M) := inferInstance
  have hcomp : Epi (((SheafOfModules.overFunctor R U ⋙
      SheafOfModules.overMap R (homOfLE hWU)).map f) ≫ e.hom.app N) := by
    infer_instance
  rw [e.hom.naturality f] at hcomp
  exact epi_of_epi (e.hom.app M) ((SheafOfModules.overFunctor R W).map f)

private lemma exists_epi_overFunctor_near_point
    (F : I ⥤ SheafOfModules.{u} R)
    (σ : (colimit F).LocalGeneratorsData) (hσ : σ.IsFiniteType)
    (i : σ.I) (x : X) (hx : x ∈ σ.X i) :
    ∃ (W : Opens X) (_hWU : W ≤ σ.X i) (_hxW : x ∈ W) (k : I),
      Epi ((SheafOfModules.overFunctor R W).map (colimit.ι F k)) := by
  let U := σ.X i
  let gs := σ.generators i
  have hfinite : Finite gs.I := (hσ.isFiniteType i).finite
  let s : gs.I → (colimit F).val.presheaf.obj (op U) := fun j =>
    (gs.s j).val (op (Over.mk (𝟙 U)))
  choose Wj hWjU hxWj ij tj htj using fun j => exists_local_lift_from_stage (R := R) F U x hx (s j)
  obtain ⟨W, hWU, hxW, k, hE⟩ :=
    epi_overMap_of_generators_lifted_to_common_stage (R := R) F U x hx gs
      Wj hWjU hxWj ij tj htj
  exact ⟨W, hWU, hxW, k, epi_overFunctor_of_epi_overMap (R := R) (colimit.ι F k) U W hWU hE⟩

omit [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U, HasWeakSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u}]
  [∀ U, ((Opens.grothendieckTopology X).over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
private lemma epi_of_epi_overFunctor_open_cover
    (F G : SheafOfModules.{u} R) (f : F ⟶ G)
    {J : Type*} (U : J → Opens X) (hU : IsOpenCover U)
    (h_epi : ∀ j, Epi ((SheafOfModules.overFunctor R (U j)).map f)) : Epi f := by
  refine ⟨fun {Z} g k hgf => ?_⟩
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro V
  apply ModuleCat.hom_ext
  ext s
  apply TopCat.Presheaf.section_ext ((SheafOfModules.toSheaf R).obj Z) V.unop
  intro x hx
  obtain ⟨j, hxj⟩ := Set.mem_iUnion.mp (hU.iSup_set_eq_univ ▸ Set.mem_univ x)
  let W : Opens X := V.unop ⊓ U j
  have hxW : x ∈ W := ⟨hx, hxj⟩
  have hWV : W ≤ V.unop := inf_le_left
  have hWU : W ≤ U j := inf_le_right
  let sW := (G.val.map (homOfLE hWV).op) s
  have hgfU :
      (SheafOfModules.overFunctor R (U j)).map f ≫
          (SheafOfModules.overFunctor R (U j)).map g =
        (SheafOfModules.overFunctor R (U j)).map f ≫
          (SheafOfModules.overFunctor R (U j)).map k := by
    simpa only [Functor.map_comp] using congrArg
      (fun q => (SheafOfModules.overFunctor R (U j)).map q) hgf
  have _ : Epi ((SheafOfModules.overFunctor R (U j)).map f) := h_epi j
  have hgk : (SheafOfModules.overFunctor R (U j)).map g =
      (SheafOfModules.overFunctor R (U j)).map k :=
    (cancel_epi ((SheafOfModules.overFunctor R (U j)).map f)).mp hgfU
  have hlocal :
      (ConcreteCategory.hom (g.val.app (op W))) sW =
        (ConcreteCategory.hom (k.val.app (op W))) sW := by
    have hcomp := congrArg
      (fun q => q.val.app (op (Over.mk (homOfLE hWU)))) hgk
    have happ := congrArg (fun q => (ConcreteCategory.hom q) sW) hcomp
    change (ConcreteCategory.hom (g.val.app (op W))) sW =
      (ConcreteCategory.hom (k.val.app (op W))) sW at happ
    exact happ
  have hrestr :
      (ConcreteCategory.hom (Z.val.map (homOfLE hWV).op))
          ((ConcreteCategory.hom (g.val.app (op V.unop))) s) =
        (ConcreteCategory.hom (Z.val.map (homOfLE hWV).op))
          ((ConcreteCategory.hom (k.val.app (op V.unop))) s) := by
    have hgNat := PresheafOfModules.naturality_apply g.val
      (homOfLE hWV).op s
    have hkNat := PresheafOfModules.naturality_apply k.val
      (homOfLE hWV).op s
    dsimp [sW] at hlocal
    rw [← hgNat, hlocal, hkNat]
  change (TopCat.Presheaf.germ Z.val.presheaf V.unop x hx).hom
      ((ConcreteCategory.hom (g.val.app (op V.unop))) s) =
      (TopCat.Presheaf.germ Z.val.presheaf V.unop x hx).hom
      ((ConcreteCategory.hom (k.val.app (op V.unop))) s)
  rw [← TopCat.Presheaf.germ_res_apply Z.val.presheaf
      (homOfLE hWV) x hxW ((ConcreteCategory.hom (g.val.app (op V.unop))) s),
    ← TopCat.Presheaf.germ_res_apply Z.val.presheaf
      (homOfLE hWV) x hxW ((ConcreteCategory.hom (k.val.app (op V.unop))) s)]
  exact congrArg (fun z => (TopCat.Presheaf.germ Z.val.presheaf W x hxW).hom z) hrestr

/-- A finite type directed colimit of sheaves of modules on a quasi-compact space is the
quotient of one of its stages. -/
@[stacks 01BB "surjective stage"]
lemma exists_epi_to_colimit_of_isFiniteType [CompactSpace X]
    (F : I ⥤ SheafOfModules.{u} R)
    [SheafOfModules.IsFiniteType (colimit F)] :
    ∃ i : I, Epi (colimit.ι F i) := by
  classical
  obtain ⟨σ, hσ⟩ := SheafOfModules.IsFiniteType.exists_localGeneratorsData
    (colimit F)
  let A := Σ i : σ.I, (σ.X i : Set X)
  have hnear (a : A) :
      ∃ (W : Opens X) (hWU : W ≤ σ.X a.1) (hxW : a.2.1 ∈ W) (k : I),
        Epi ((SheafOfModules.overFunctor R W).map (colimit.ι F k)) :=
    exists_epi_overFunctor_near_point (R := R) F σ hσ a.1 a.2.1 a.2.2
  choose W hWU hxW k hE using hnear
  have hbase : IsOpenCover σ.X :=
    (Opens.coversTop_iff X σ.X).mp σ.coversTop
  have hWcover : IsOpenCover W := by
    refine IsOpenCover.mk (eq_top_iff.mpr fun x _ => ?_)
    obtain ⟨i, hxi⟩ := hbase.exists_mem x
    exact Opens.mem_iSup.mpr ⟨⟨i, ⟨x, hxi⟩⟩, hxW ⟨i, ⟨x, hxi⟩⟩⟩
  obtain ⟨t, hVcover⟩ := hWcover.exists_finite_of_compactSpace
  obtain ⟨k₀, hk₀⟩ :=
    exists_common_upper_bound (fun a : t => k a.1)
  have h_epi : ∀ a : t,
      Epi ((SheafOfModules.overFunctor R (W a.1)).map (colimit.ι F k₀)) := by
    intro a
    let H := SheafOfModules.overFunctor R (W a.1)
    have hik : k a.1 ≤ k₀ := hk₀ a
    have : Epi (H.map (F.map (homOfLE hik)) ≫ H.map (colimit.ι F k₀)) := by
      rw [← Functor.map_comp, colimit.w]
      exact hE a.1
    exact epi_of_epi (H.map (F.map (homOfLE hik))) (H.map (colimit.ι F k₀))
  exact ⟨k₀, epi_of_epi_overFunctor_open_cover (R := R) (F.obj k₀) (colimit F)
    (colimit.ι F k₀) _ hVcover h_epi⟩

/-- If the transition maps of a directed system of sheaves of modules on a quasi-compact space
are injective, a finite type colimit is already one of its stages. -/
@[stacks 01BB "injective transition maps"]
lemma exists_isIso_to_colimit_of_isFiniteType [CompactSpace X]
    (F : I ⥤ SheafOfModules.{u} R)
    [∀ (i j : I) (f : i ⟶ j), Mono (F.map f)]
    [SheafOfModules.IsFiniteType (colimit F)] :
    ∃ i : I, IsIso (colimit.ι F i) := by
  obtain ⟨i, hi⟩ := exists_epi_to_colimit_of_isFiniteType R F
  have := colimit_ι_mono R F i
  exact ⟨i, isIso_of_mono_of_epi _⟩

end Stacks.SheafOfModules

