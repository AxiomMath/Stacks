module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule

/-!
# The submodule a map into the structure sheaf multiplies out of a sheaf of modules

Let `R` be a sheaf of rings on a site, let `A` be a sheaf of `R`-modules equipped with a map
`φ : A ⟶ R` into the unit module, and let `M` be a sheaf of `R`-modules. The *image product*
`φ(A)·M` is the smallest sheaf submodule of `M` containing every local product `φ(z) • m` of a
section `z` of `A` with a section `m` of `M`.

The construction depends on `φ` only through its image on sections: two maps with the same
sectionwise range multiply out the same submodule
(`Stacks.SheafOfModules.imageProductSubmodule_congr_range`). The point of the file is that this
is true much more cheaply than it looks when the two maps are related by a *surjection*: if
`ψ : A ⟶ B` is an epimorphism of sheaves of modules then `φ ∘ ψ` and `φ` have the same image
product (`Stacks.SheafOfModules.imageProductSubmodule_comp_of_epi`), even though `ψ` is only
*locally* surjective on sections, because the membership condition defining a sheaf submodule
is local.

## Main definitions

* `Stacks.SheafOfModules.sectionsProductSubmodule`: the submodule `T·M` generated by a family
  `T` of sets of sections of `R`.
* `Stacks.SheafOfModules.imageProductSubmodule`: the submodule `φ(A)·M`, the case of the family
  of sectionwise ranges of `φ`.

## Main results

* `Stacks.SheafOfModules.smul_mem_imageProductSubmodule`: the generators lie in it.
* `Stacks.SheafOfModules.imageProductSubmodule_le`: its universal property — it is contained in
  any sheaf submodule containing the generators.
* `Stacks.SheafOfModules.imageProductSubmodule_comp_le`: precomposing `φ` with any map can only
  shrink the image product.
* `Stacks.SheafOfModules.imageProductSubmodule_comp_of_epi`: precomposing with an epimorphism
  does not change it.
* `Stacks.SheafOfModules.imageProductSubmodule_congr_range`: two maps with the same sectionwise
  range have the same image product.

## Implementation notes

The submodule is an infimum of sheaf submodules, not a sheafified image, so it exists with no
hypothesis on the site; the two sheafification hypotheses are needed only for the epimorphism
statement, which goes through
`Stacks.SheafOfModules.EpiMono.exists_covering_of_epi`, i.e. through the identification of
epimorphisms of sheaves of modules with the locally surjective morphisms.

The ring and the modules are in one universe `u`, as they must be: the unit module
`SheafOfModules.unit R` of a sheaf of rings `R : Sheaf J RingCat.{u}` has sections `R.obj.obj U`
and so lives in universe `u`, and a map `A ⟶ SheafOfModules.unit R` forces `A` there too.

## References

* [Stacks Project, Tag 01AH](https://stacks.math.columbia.edu/tag/01AH) — epimorphisms of
  sheaves of modules are the locally surjective morphisms.
-/

@[expose] public section

open CategoryTheory Opposite

universe v u₁ u

namespace Stacks.SheafOfModules

variable {C : Type u₁} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}

/-- The sheaf submodule `T·M` of `M` generated by the local products `a • m` of a section `a`
of `R` belonging to the family `T` with a section `m` of `M`: the infimum of the sheaf
submodules of `M` containing all such products. -/
noncomputable def sectionsProductSubmodule (T : ∀ U : Cᵒᵖ, Set (R.obj.obj U))
    (M : SheafOfModules.{u} R) : M.Submodule :=
  sInf { N : M.Submodule |
    ∀ (U : Cᵒᵖ) (a : R.obj.obj U), a ∈ T U → ∀ m : M.val.obj U, a • m ∈ N.obj U }

/-- **The universal property of `T·M`**: it is contained in every sheaf submodule containing the
products. -/
theorem sectionsProductSubmodule_le {T : ∀ U : Cᵒᵖ, Set (R.obj.obj U)}
    {M : SheafOfModules.{u} R} {N : M.Submodule}
    (hN : ∀ (U : Cᵒᵖ) (a : R.obj.obj U), a ∈ T U → ∀ m : M.val.obj U, a • m ∈ N.obj U) :
    sectionsProductSubmodule T M ≤ N :=
  sInf_le hN

/-- A section lying in every member of a set of sheaf submodules lies in its infimum. -/
private theorem mem_obj_sInf {M : SheafOfModules.{u} R} {S : Set M.Submodule} {U : Cᵒᵖ}
    {x : M.val.obj U} (h : ∀ N ∈ S, x ∈ N.obj U) : x ∈ (sInf S).obj U := by
  change _ ∈ (sInf ((fun N : M.Submodule => N.toSubmodule) '' S)).obj U
  simp only [PresheafOfModules.Submodule.sInf_obj, Submodule.mem_iInf]
  rintro _ ⟨N, hN, rfl⟩
  exact h N hN

/-- A product of a section of the family with a section of `M` lies in `T·M`. -/
theorem smul_mem_sectionsProductSubmodule (T : ∀ U : Cᵒᵖ, Set (R.obj.obj U))
    (M : SheafOfModules.{u} R) (U : Cᵒᵖ) {a : R.obj.obj U} (ha : a ∈ T U) (m : M.val.obj U) :
    a • m ∈ (sectionsProductSubmodule T M).obj U :=
  mem_obj_sInf fun _ hN => hN U a ha m

/-- Enlarging the family enlarges the submodule it multiplies out. -/
theorem sectionsProductSubmodule_mono {T T' : ∀ U : Cᵒᵖ, Set (R.obj.obj U)}
    (M : SheafOfModules.{u} R) (h : ∀ U : Cᵒᵖ, T U ⊆ T' U) :
    sectionsProductSubmodule T M ≤ sectionsProductSubmodule T' M :=
  sectionsProductSubmodule_le fun U _ ha m =>
    smul_mem_sectionsProductSubmodule T' M U (h U ha) m

/-- The sheaf submodule `φ(A)·M` of `M` generated by the local products `φ(z) • m` of a section
`z` of `A`, read in `R` through `φ`, with a section `m` of `M`: the infimum of the sheaf
submodules of `M` containing all such products. -/
noncomputable def imageProductSubmodule {A : SheafOfModules.{u} R}
    (φ : A ⟶ SheafOfModules.unit R) (M : SheafOfModules.{u} R) : M.Submodule :=
  sInf { N : M.Submodule |
    ∀ (U : Cᵒᵖ) (z : A.val.obj U) (m : M.val.obj U),
      (show R.obj.obj U from φ.val.app U z) • m ∈ N.obj U }

variable {A B : SheafOfModules.{u} R} {M : SheafOfModules.{u} R}

/-- **The universal property of the image product**: it is contained in every sheaf submodule
containing the products. -/
theorem imageProductSubmodule_le (φ : A ⟶ SheafOfModules.unit R) {N : M.Submodule}
    (hN : ∀ (U : Cᵒᵖ) (z : A.val.obj U) (m : M.val.obj U),
      (show R.obj.obj U from φ.val.app U z) • m ∈ N.obj U) :
    imageProductSubmodule φ M ≤ N :=
  sInf_le hN

/-- A product of a section of `A`, read in `R`, with a section of `M` lies in the image
product. -/
theorem smul_mem_imageProductSubmodule (φ : A ⟶ SheafOfModules.unit R) (M : SheafOfModules.{u} R)
    (U : Cᵒᵖ) (z : A.val.obj U) (m : M.val.obj U) :
    (show R.obj.obj U from φ.val.app U z) • m ∈ (imageProductSubmodule φ M).obj U :=
  mem_obj_sInf fun _ hN => hN U z m

/-- The image product is the product of the family of sectionwise ranges. -/
theorem imageProductSubmodule_eq_sectionsProductSubmodule (φ : A ⟶ SheafOfModules.unit R)
    (M : SheafOfModules.{u} R) :
    imageProductSubmodule φ M =
      sectionsProductSubmodule
        (fun U => Set.range fun z : A.val.obj U =>
          (show R.obj.obj U from φ.val.app U z)) M := by
  set T : ∀ U : Cᵒᵖ, Set (R.obj.obj U) := fun U =>
    Set.range fun z : A.val.obj U => (show R.obj.obj U from φ.val.app U z) with hT
  refine le_antisymm (imageProductSubmodule_le φ fun U z m =>
    smul_mem_sectionsProductSubmodule T M U (show _ ∈ T U from ⟨z, rfl⟩) m)
    (sectionsProductSubmodule_le fun U a ha m => ?_)
  rw [hT] at ha
  obtain ⟨z, rfl⟩ := ha
  exact smul_mem_imageProductSubmodule φ M U z m

/-- Membership in the image product depends on `φ` only through its sectionwise range: if every
value of `φ` is a value of `φ'`, then `φ(A)·M ≤ φ'(B)·M`. -/
theorem imageProductSubmodule_le_of_range_le {φ : A ⟶ SheafOfModules.unit R}
    {φ' : B ⟶ SheafOfModules.unit R} (M : SheafOfModules.{u} R)
    (h : ∀ (U : Cᵒᵖ) (z : A.val.obj U), ∃ y : B.val.obj U,
      (show R.obj.obj U from φ'.val.app U y) = (show R.obj.obj U from φ.val.app U z)) :
    imageProductSubmodule φ M ≤ imageProductSubmodule φ' M := by
  refine imageProductSubmodule_le φ fun U z m => ?_
  obtain ⟨y, hy⟩ := h U z
  rw [← hy]
  exact smul_mem_imageProductSubmodule φ' M U y m

/-- **Two maps with the same sectionwise range multiply out the same submodule.** -/
theorem imageProductSubmodule_congr_range {φ : A ⟶ SheafOfModules.unit R}
    {φ' : B ⟶ SheafOfModules.unit R} (M : SheafOfModules.{u} R)
    (h : ∀ U : Cᵒᵖ, Set.range (fun z : A.val.obj U => (show R.obj.obj U from φ.val.app U z)) =
      Set.range (fun y : B.val.obj U => (show R.obj.obj U from φ'.val.app U y))) :
    imageProductSubmodule φ M = imageProductSubmodule φ' M := by
  refine le_antisymm (imageProductSubmodule_le_of_range_le M fun U z => ?_)
    (imageProductSubmodule_le_of_range_le M fun U y => ?_)
  · obtain ⟨y, hy⟩ := (h U).le ⟨z, rfl⟩
    exact ⟨y, hy⟩
  · obtain ⟨z, hz⟩ := (h U).ge ⟨y, rfl⟩
    exact ⟨z, hz⟩

/-- Precomposing with a map of sheaves of modules can only shrink the image product: every
product `(ψ ≫ φ)(z) • m` is a product `φ(y) • m`. -/
theorem imageProductSubmodule_comp_le (ψ : A ⟶ B) (φ : B ⟶ SheafOfModules.unit R)
    (M : SheafOfModules.{u} R) :
    imageProductSubmodule (ψ ≫ φ) M ≤ imageProductSubmodule φ M :=
  imageProductSubmodule_le_of_range_le M fun U z => ⟨ψ.val.app U z, rfl⟩

variable [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **Precomposing with an epimorphism does not change the image product.** An epimorphism of
sheaves of modules is locally surjective, so every section `y` of `B` restricts, along the
arrows of a covering sieve, to a section coming from `A`; there the product `φ(y) • m`
restricts to a product `(ψ ≫ φ)(z) • m'`, which lies in `(ψ ≫ φ)(A)·M`. The membership
condition of a sheaf submodule is local, so `φ(y) • m` itself lies in `(ψ ≫ φ)(A)·M`. -/
theorem le_imageProductSubmodule_comp_of_epi (ψ : A ⟶ B) [Epi ψ]
    (φ : B ⟶ SheafOfModules.unit R) (M : SheafOfModules.{u} R) :
    imageProductSubmodule φ M ≤ imageProductSubmodule (ψ ≫ φ) M := by
  refine imageProductSubmodule_le φ fun U y m => ?_
  set N := imageProductSubmodule (ψ ≫ φ) M
  obtain ⟨S, hS, hsec⟩ := EpiMono.exists_covering_of_epi ψ (V := U.unop) y
  refine N.isSheaf _ (J.superset_covering (fun V g hg => ?_) hS)
  obtain ⟨z, hz⟩ := hsec g hg
  have hz' : ψ.val.app (op V) z = B.val.map g.op y := hz
  change M.val.map g.op
    ((show R.obj.obj U from φ.val.app U y) • m) ∈ N.obj (op V)
  rw [M.val.map_smul]
  have hnat : (show R.obj.obj (op V) from R.obj.map g.op (φ.val.app U y)) =
      (show R.obj.obj (op V) from φ.val.app (op V) (B.val.map g.op y)) :=
    (PresheafOfModules.naturality_apply φ.val g.op y).symm
  have hcomp : (show R.obj.obj (op V) from φ.val.app (op V) (B.val.map g.op y)) =
      (show R.obj.obj (op V) from (ψ ≫ φ).val.app (op V) z) := by
    rw [← hz']
    rfl
  rw [show (R.obj.map g.op (φ.val.app U y) : R.obj.obj (op V)) =
    (show R.obj.obj (op V) from (ψ ≫ φ).val.app (op V) z) from hnat.trans hcomp]
  exact smul_mem_imageProductSubmodule (ψ ≫ φ) M (op V) z (M.val.map g.op m)

/-- **Precomposing with an epimorphism does not change the image product.** -/
theorem imageProductSubmodule_comp_of_epi (ψ : A ⟶ B) [Epi ψ]
    (φ : B ⟶ SheafOfModules.unit R) (M : SheafOfModules.{u} R) :
    imageProductSubmodule (ψ ≫ φ) M = imageProductSubmodule φ M :=
  le_antisymm (imageProductSubmodule_comp_le ψ φ M)
    (le_imageProductSubmodule_comp_of_epi ψ φ M)

end Stacks.SheafOfModules

end
