module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
import StacksCore.Tactic.StacksAttribute

/-!
# Submodules of sheaves of modules

Stacks tags realised by Mathlib's complete lattice of sub-`O`-module sheaves, together with
the submodule sheaf generated by a family of local sections.

## Main definitions

* `SheafOfModules.Submodule.generatedBy`: the submodule sheaf generated by a family of local
  sections `s i` of a sheaf of modules, i.e. the smallest one whose sections over the chosen
  open include each `s i`.

## Main results

* `SheafOfModules.Submodule.mem_generatedBy`: each generating section is a section of the
  submodule sheaf it generates.
* `SheafOfModules.Submodule.generatedBy_le`: that submodule sheaf is the smallest one with
  this property.
* `SheafOfModules.Submodule.isLeast_generatedBy`: it is the unique least submodule sheaf
  containing the given local sections.

## Implementation notes

The generated submodule sheaf is defined as the infimum of all submodule sheaves containing
the given sections, rather than by sheafifying the presheaf of finite `O`-linear
combinations: the complete lattice of submodule sheaves already has that infimum, and the two
characterising properties below are what the construction is used for.

## References

* [Stacks Project, Lemma 17.4.1 (Tag 01AP)](https://stacks.math.columbia.edu/tag/01AP)
* [Stacks Project, Definition 17.4.2 (Tag 01AQ)](https://stacks.math.columbia.edu/tag/01AQ)
-/

@[expose] public section

open CategoryTheory Opposite

universe w v v₁ u₁ u

namespace SheafOfModules.Submodule

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{u}} {F : SheafOfModules.{v} R}
  {ι : Type w} (U : ι → Cᵒᵖ) (s : ∀ i, F.val.obj (U i))

/-- The submodule sheaf of `F` generated by a family of local sections `s i`, each a section
of `F` over the object `U i` of the site: the smallest submodule sheaf of `F` whose sections
over `U i` contain `s i` for every `i`. -/
@[stacks 01AQ "the subsheaf generated by the local sections s_i"]
noncomputable def generatedBy : F.Submodule :=
  sInf {G : F.Submodule | ∀ i, s i ∈ G.obj (U i)}

/-- Each generating section is a section of the submodule sheaf it generates. -/
@[stacks 01AQ "each s_i is a local section of the generated subsheaf"]
theorem mem_generatedBy (i : ι) : s i ∈ (generatedBy U s).obj (U i) := by
  change s i ∈ (sInf {G : F.Submodule | ∀ j, s j ∈ G.obj (U j)}).toSubmodule.obj (U i)
  rw [toSubmodule_sInf, PresheafOfModules.Submodule.sInf_obj]
  simp only [_root_.Submodule.mem_iInf, Set.mem_image, forall_exists_index, and_imp]
  rintro N G hG rfl
  exact hG i

/-- The submodule sheaf generated by the `s i` is contained in every submodule sheaf whose
sections contain them, so it is the smallest such. -/
@[stacks 01AQ "the generated subsheaf is the smallest one containing the s_i"]
theorem generatedBy_le {G : F.Submodule} (hG : ∀ i, s i ∈ G.obj (U i)) :
    generatedBy U s ≤ G :=
  sInf_le hG

/-- Given local sections `s i ∈ F(U i)` of a sheaf of modules `F`, there is a unique smallest
submodule sheaf of `F` whose sections over each `U i` contain `s i`: the submodule sheaf
`generatedBy U s` is the least element of the set of such submodule sheaves, and any least
element of that set equals it. -/
@[stacks 01AP "On any site with a sheaf of rings, which covers a ringed space `(X, O_X)` with
its opens; existence and uniqueness of the smallest sub-`O`-module sheaf containing the given
local sections."]
theorem isLeast_generatedBy :
    IsLeast {G : F.Submodule | ∀ i, s i ∈ G.obj (U i)} (generatedBy U s) ∧
      ∀ G : F.Submodule, IsLeast {G : F.Submodule | ∀ i, s i ∈ G.obj (U i)} G →
        G = generatedBy U s := by
  have h : IsLeast {G : F.Submodule | ∀ i, s i ∈ G.obj (U i)} (generatedBy U s) :=
    ⟨mem_generatedBy U s, fun _ hG => generatedBy_le U s hG⟩
  exact ⟨h, fun _ hG => hG.unique h⟩

end SheafOfModules.Submodule

end
