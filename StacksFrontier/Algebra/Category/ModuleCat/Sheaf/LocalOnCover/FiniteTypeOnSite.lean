module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocalOnCover.FiniteType
public import StacksFrontier.AlgebraicGeometry.Topologies.FiniteTypeFromGlobalGenerators
public import StacksFrontier.AlgebraicGeometry.Topologies.FiniteTypeOnSiteKernel
import StacksCore.Tactic.StacksAttribute

/-!
# Finite type on a site is local on a covering family

Stacks 03DN(5): let `𝓕` be a sheaf of `𝒪`-modules on a site with a final object `X`.  The
following are equivalent:

* (a) `𝓕` is of finite type;
* (b) there is a covering `{Xᵢ ⟶ X}` such that each restriction `𝓕|_{𝒞/Xᵢ}` is of finite type;
* (c) there is a covering `{Xᵢ ⟶ X}` such that each restriction `𝓕|_{𝒞/Xᵢ}` is globally
  generated by finitely many sections.

"Of finite type" is Stacks 03DL(5): every object of the site has a covering on whose members the
restricted module is generated by finitely many global sections.  This is
`SheafOfModules.IsFiniteTypeOnSite`, and it is the predicate used in (a) and (b) below.

## Main results

* `Stacks.SheafOfModules.isFiniteTypeOnSite_iff_exists_cover_isFiniteTypeOnSite`: (a) ⟺ (b).
* `Stacks.SheafOfModules.isFiniteTypeOnSite_iff_exists_cover_finite_generators`: (a) ⟺ (c).

## Implementation notes

The proofs pass through Mathlib's `SheafOfModules.IsFiniteType`, which asks for one family
covering the final object with finitely many generating sections on each member.  The two
directions of the comparison with `IsFiniteTypeOnSite` are
`Stacks.SheafOfModules.isFiniteType_of_isFiniteTypeOnSite` and
`Stacks.SheafOfModules.isFiniteTypeOnSite_of_isFiniteType`; the second is the content of the
proof of Stacks 03DN, restricting the generators of (c) along every object of the site.  The
equivalences for Mathlib's predicate are
`Stacks.SheafOfModules.isFiniteType_iff_exists_cover_isFiniteType` and
`Stacks.SheafOfModules.isFiniteType_iff_exists_cover_finite_generators`.

As there, the site need not have a final object: `GrothendieckTopology.CoversTop` expresses that a
family covers the final object without choosing one.

## References

* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory

namespace Stacks.SheafOfModules

universe u v w

/-- On a site whose slices carry the sheafification instances of the statements below, the
categorical finite type of Stacks 03DL(5) agrees with Mathlib's `SheafOfModules.IsFiniteType`. -/
private theorem isFiniteTypeOnSite_iff_isFiniteType_of_weakSheafify
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R)
    [∀ (U : C), HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ (U : C), (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}] :
    M.IsFiniteTypeOnSite ↔ M.IsFiniteType := by
  let (U : C) : HasSheafify (J.over U) AddCommGrpCat.{w} :=
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  exact ⟨isFiniteType_of_isFiniteTypeOnSite M, isFiniteTypeOnSite_of_isFiniteType M⟩

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R)
  [∀ (U : C), HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ (U : C), (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **Stacks 03DN(5), (a) ⟺ (b).** A sheaf of modules is of finite type in the sense of Stacks
03DL(5) if and only if there is a family covering the final object such that each restriction
to a member of it is of finite type in the same sense. -/
@[stacks 03DN "finite_type, (a) ⟺ (b)"]
theorem isFiniteTypeOnSite_iff_exists_cover_isFiniteTypeOnSite
    [∀ (U : C), ∀ (V : Over U),
      HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
    [∀ (U : C), ∀ (V : Over U),
      ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}] :
    M.IsFiniteTypeOnSite ↔
      ∃ (I : Type u) (U : I → C), J.CoversTop U ∧
        ∀ i : I, (M.over (U i)).IsFiniteTypeOnSite := by
  refine (isFiniteTypeOnSite_iff_isFiniteType_of_weakSheafify M).trans
    ((isFiniteType_iff_exists_cover_isFiniteType M).trans ?_)
  exact exists_congr fun I => exists_congr fun U => and_congr_right fun _ =>
    forall_congr' fun i =>
      (isFiniteTypeOnSite_iff_isFiniteType_of_weakSheafify (M.over (U i))).symm

/-- **Stacks 03DN(5), (a) ⟺ (c).** A sheaf of modules is of finite type in the sense of Stacks
03DL(5) if and only if there is a family covering the final object such that each restriction
to a member of it is generated by finitely many global sections. -/
@[stacks 03DN "finite_type, (a) ⟺ (c)"]
theorem isFiniteTypeOnSite_iff_exists_cover_finite_generators :
    M.IsFiniteTypeOnSite ↔
      ∃ (I : Type u) (U : I → C), J.CoversTop U ∧
        ∀ i : I, ∃ (σ : (M.over (U i)).GeneratingSections), σ.IsFiniteType :=
  (isFiniteTypeOnSite_iff_isFiniteType_of_weakSheafify M).trans
    (isFiniteType_iff_exists_cover_finite_generators M)

end Stacks.SheafOfModules

end
