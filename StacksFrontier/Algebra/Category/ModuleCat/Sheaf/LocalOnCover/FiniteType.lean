module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.CategoryTheory.Sites.CoversTop.Over
public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.CategoryTheory.Sites.Modules.Colimits
import StacksCore.Tactic.StacksAttribute

/-!
# Finite type of a sheaf of modules is local on a covering family

Stacks 03DN asserts that each of the local conditions of Stacks 03DL may be tested on the
members of any family covering the final object.  This file proves the clause for finite type:
a sheaf of modules on a site is of finite type exactly when its restrictions to the members of
some covering family are, and exactly when those restrictions are generated by finitely many
global sections.

The second equivalence is immediate from the definition, since a family of objects covering
the final object together with finite generating sections of the restriction to each member is
precisely a finite-type `SheafOfModules.LocalGeneratorsData`.  The first is the content: in
one direction, generating sections of `M.over U` have to be turned into *local* generators of
`M.over U`, which is done on the one-member covering family `{𝟙 U}` of the terminal object of
the slice, transporting the sections along the equivalence `Over.iteratedSliceEquiv` between
the iterated slice over `𝟙 U` and the slice over `U`; in the other direction the local
generators supplied on the iterated slices have to be glued, which is done by composing the
two coverings.

## Main results

* `Stacks.SheafOfModules.isFiniteType_iff_exists_cover_isFiniteType`: being of finite type is
  equivalent to being of finite type after restriction to the members of some covering family.
  This is the equivalence of conditions (a) and (b) of Stacks 03DN for finite type.
* `Stacks.SheafOfModules.isFiniteType_iff_exists_cover_finite_generators`: being of finite
  type is equivalent to the existence of finite families of generating global sections of
  those restrictions.  This is the equivalence of conditions (a) and (c).

## Implementation notes

The statements are made for a sheaf of rings on an arbitrary site rather than for the
structure sheaf of a bundled ringed site, which is the more general form and does not require
the site to have a final object: `GrothendieckTopology.CoversTop` expresses that a family
covers the final object without choosing one.  Finite type is Mathlib's
`SheafOfModules.IsFiniteType`, which is Stacks 03DL(5), so no predicate is introduced here.

`Stacks.SheafOfModules.bindLocalGeneratorsData` in
`StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Coherent` is the same gluing construction as the
private one used here, but stated with the object, morphism and module universes all equal and
with `HasSheafify` rather than `HasWeakSheafify` hypotheses, which is too special for the
statement proved here; the dedup owed is to generalise that one and delete this copy.
Generalising it in place is not done here because its own consumers fix the universes.

Transporting generating sections along the slice equivalences is Mathlib's
`SheafOfModules.GeneratingSections.map`, and left exactness of sheafification on the sites
involved comes from `AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective`.

## References

* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory

namespace Stacks.SheafOfModules

universe u v w

/-- Generating global sections of the restriction of `M` to `U` are local generators of that
restriction: the identity of `U` is a terminal object of the slice site over `U`, hence a
one-member covering family of it, and the sections transport to the iterated slice along
`Over.iteratedSliceEquiv`. -/
private noncomputable def localGeneratorsDataOfGenerators
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) (U : C)
    [HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [(J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ V : Over U, HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
    [∀ V : Over U, ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (G : (M.over U).GeneratingSections) :
    (M.over U).LocalGeneratorsData.{max u v} where
  I := PUnit.{max u v + 1}
  X _ := Over.mk (𝟙 U)
  coversTop W := by
    apply (J.over U).covering_of_eq_top
    ext Z f
    simp only [Sieve.mem_ofObjects_iff]
    constructor
    · intro _
      trivial
    · intro _
      exact ⟨PUnit.unit.{max u v + 1}, ⟨Over.mkIdTerminal.from Z⟩⟩
  generators _ := by
    let T : Over U := Over.mk (𝟙 U)
    have : HasSheafify ((J.over U).over T) AddCommGrpCat.{w} :=
      AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
    -- The two continuity instances are stated for `Over.iteratedSliceForward` and
    -- `Over.iteratedSliceBackward`; `Over.iteratedSliceEquiv` does not unfold to them for
    -- instance search, and its target topology is written over `U` rather than over `T.left`.
    have : (Over.iteratedSliceEquiv T).functor.IsContinuous ((J.over U).over T) (J.over U) :=
      inferInstanceAs (T.iteratedSliceForward.IsContinuous ((J.over U).over T) (J.over T.left))
    have : (Over.iteratedSliceEquiv T).inverse.IsContinuous (J.over U) ((J.over U).over T) :=
      inferInstanceAs (T.iteratedSliceBackward.IsContinuous (J.over T.left) ((J.over U).over T))
    let e := SheafOfModules.pushforwardPushforwardEquivalence (Over.iteratedSliceEquiv T)
      (S := (R.over U).over T) (R := R.over U) (𝟙 _) (𝟙 _)
      (by ext : 2; exact R.1.map_id _) (by ext : 2; exact R.1.map_id _)
    have hN : e.functor.obj (M.over U) ≅ (M.over U).over T := Iso.refl _
    have η : SheafOfModules.unit ((R.over U).over T) ≅
        e.functor.obj (SheafOfModules.unit (R.over U)) := Iso.refl _
    exact SheafOfModules.GeneratingSections.equivOfIso hN (G.map e.functor η)

/-- Local generators of the restrictions of `M` to the members of a covering family glue to
local generators of `M`: the composite of the two coverings covers, and the generators on an
iterated slice transport down to the base object along `Over.iteratedSliceEquiv`. -/
private noncomputable def bindLocalGeneratorsData
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R)
    [∀ (U : C), HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ (U : C), (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ (U : C) (V : Over U), HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
    [∀ (U : C) (V : Over U), ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}]
    {I : Type u} (U : I → C) (hU : J.CoversTop U)
    (D : ∀ i, (M.over (U i)).LocalGeneratorsData.{max u v}) :
    M.LocalGeneratorsData.{max u v} where
  I := Σ i, (D i).I
  X ij := ((D ij.1).X ij.2).left
  coversTop := hU.over (fun i => (D i).coversTop)
  generators ij := by
    let : HasSheafify (J.over ((D ij.1).X ij.2).left) AddCommGrpCat.{w} :=
      AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
    let e := SheafOfModules.pushforwardPushforwardEquivalence
      (Over.iteratedSliceEquiv ((D ij.1).X ij.2))
      (S := (R.over _).over _) (R := R.over _) (𝟙 _) (𝟙 _)
      (by ext : 2; exact R.1.map_id _) (by ext : 2; exact R.1.map_id _)
    exact (((D ij.1).generators ij.2).map e.inverse (.refl _)).ofEpi
      (e.fullyFaithfulFunctor.preimageIso
        (by exact e.counitIso.app ((M.over (U ij.1)).over ((D ij.1).X ij.2)))).hom

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R)
  [∀ (U : C), HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ (U : C), (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **Stacks 03DN, finite type.** A sheaf of modules is of finite type if and only if it is so
after restriction to each member of some covering family of the final object. -/
@[stacks 03DN "finite_type"]
theorem isFiniteType_iff_exists_cover_isFiniteType
    [∀ (U : C), ∀ (V : Over U),
      HasWeakSheafify ((J.over U).over V) AddCommGrpCat.{w}]
    [∀ (U : C), ∀ (V : Over U),
      ((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}] :
    M.IsFiniteType ↔
      ∃ (I : Type u) (U : I → C), J.CoversTop U ∧
        ∀ i : I, (M.over (U i)).IsFiniteType := by
  constructor
  · intro h
    obtain ⟨σ, hσ⟩ := h.exists_localGeneratorsData
    refine ⟨σ.I, σ.X, σ.coversTop, fun i => ?_⟩
    exact ⟨localGeneratorsDataOfGenerators M (σ.X i) (σ.generators i),
      ⟨fun _ => ⟨(hσ.isFiniteType i).finite⟩⟩⟩
  · rintro ⟨I, U, hU, hF⟩
    classical
    let D : ∀ i, (M.over (U i)).LocalGeneratorsData.{max u v} := fun i =>
      Classical.choose (hF i).exists_localGeneratorsData
    let data' := bindLocalGeneratorsData M U hU D
    have hdata' : data'.IsFiniteType := ⟨fun ij =>
      ⟨((Classical.choose_spec (hF ij.1).exists_localGeneratorsData).isFiniteType ij.2).finite⟩⟩
    exact ⟨data'.shrink, ⟨fun i => hdata'.isFiniteType i.2.choose⟩⟩

/-- **Stacks 03DN, finite type.** A sheaf of modules is of finite type if and only if it is
generated by finitely many global sections after restriction to each member of some covering
family of the final object. -/
@[stacks 03DN "finite_type"]
theorem isFiniteType_iff_exists_cover_finite_generators :
    M.IsFiniteType ↔
      ∃ (I : Type u) (U : I → C), J.CoversTop U ∧
        ∀ i : I, ∃ (σ : (M.over (U i)).GeneratingSections), σ.IsFiniteType := by
  constructor
  · intro h
    obtain ⟨σ, hσ⟩ := h.exists_localGeneratorsData
    exact ⟨σ.I, σ.X, σ.coversTop, fun i => ⟨σ.generators i, hσ.isFiniteType i⟩⟩
  · rintro ⟨I, U, hU, hF⟩
    let data : M.LocalGeneratorsData :=
      { I := I, X := U, coversTop := hU, generators := fun i => (hF i).choose }
    exact ⟨data, ⟨fun i => (hF i).choose_spec⟩⟩

end Stacks.SheafOfModules

end
