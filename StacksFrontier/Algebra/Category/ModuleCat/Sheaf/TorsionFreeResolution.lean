module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatIdealTorsionFree
public import StacksFrontier.Topology.Sheaves.Cohomology.KFlat.OnARingedSpace

/-!
# Termwise `I`-torsion-free resolutions of unbounded complexes

Let `(X, O_X)` be a ringed space and let `ι : I ⟶ O_X` be a sheaf of ideals which is locally
generated by a section that is a nonzerodivisor on `O_X`, the standing hypothesis of
Situation 0GT4 and condition (1) of [Stacks, Tag 0GT3]. Then every cochain complex of
`O_X`-modules receives a quasi-isomorphism from a complex all of whose terms are `I`-torsion
free.

## Main results

* `Stacks.IdealTorsion.exists_termwiseTorsionFree_quasiIso_of_isLocallyGeneratedByRegular`:
  termwise `I`-torsion-free resolutions exist for an ideal sheaf locally generated by a
  nonzerodivisor.
* `Stacks.IdealTorsion.exists_termwiseTorsionFree_quasiIso_of_isInvertible`: the same for an
  invertible ideal sheaf on a ringed space all of whose stalks are local rings.

## References

* [Stacks Project, Tag 0F8Q](https://stacks.math.columbia.edu/tag/0F8Q)
* [Stacks Project, Tag 06YF](https://stacks.math.columbia.edu/tag/06YF)
* [Stacks Project, Tag 0GT5](https://stacks.math.columbia.edu/tag/0GT5)
* [Stacks Project, Tag 0GT4](https://stacks.math.columbia.edu/tag/0GT4)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.IdealTorsion

variable (X : RingedSpace.{u})

/-- Let `ι : I ⟶ O_X` be a sheaf of ideals on a ringed space which is locally generated by a
section that is a nonzerodivisor on `O_X`. Then every cochain complex `G` of `O_X`-modules
receives a quasi-isomorphism `K ⟶ G` from a complex `K` all of whose terms are `I`-torsion
free. -/
public theorem exists_termwiseTorsionFree_quasiIso_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} (structureSheaf X.sheaf))
    (ι : I ⟶ SheafOfModules.unit (structureSheaf X.sheaf)) (hι : Mono ι)
    (hregl : IsLocallyGeneratedByRegular X ι) :
    ∀ G : CochainComplex (SheafOfModules.{u} (structureSheaf X.sheaf)) ℤ,
      ∃ (K : CochainComplex (SheafOfModules.{u} (structureSheaf X.sheaf)) ℤ) (p : K ⟶ G),
        (∀ n : ℤ, IsIdealTorsionFree X ι (K.X n)) ∧ QuasiIso p := by
  intro G
  obtain ⟨K, p, -, hflat, hq, -⟩ :=
    AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.exists_kFlatResolution X G
  exact ⟨K, p, fun n =>
    @isIdealTorsionFree_of_isFlat X I ι hι hregl (K.X n) (hflat n), hq⟩

/-- Let `ι : I ⟶ O_X` be an invertible sheaf of ideals on a ringed space all of whose stalks
`O_{X,x}` are local rings. Then every cochain complex of `O_X`-modules receives a
quasi-isomorphism from a complex of `I`-torsion-free `O_X`-modules. -/
public theorem exists_termwiseTorsionFree_quasiIso_of_isInvertible
    [∀ x : X.carrier, IsLocalRing
      (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x)]
    (I : SheafOfModules.{u} (structureSheaf X.sheaf))
    (ι : I ⟶ SheafOfModules.unit (structureSheaf X.sheaf)) (hι : Mono ι)
    (hI : Stacks.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X).property I) :
    ∀ G : CochainComplex (SheafOfModules.{u} (structureSheaf X.sheaf)) ℤ,
      ∃ (K : CochainComplex (SheafOfModules.{u} (structureSheaf X.sheaf)) ℤ) (p : K ⟶ G),
        (∀ n : ℤ, IsIdealTorsionFree X ι (K.X n)) ∧ QuasiIso p :=
  exists_termwiseTorsionFree_quasiIso_of_isLocallyGeneratedByRegular X I ι hι
    (@isLocallyGeneratedByRegular_of_isInvertible X inferInstance _ ι hι hI)

end Stacks.IdealTorsion

end
