module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Monoidal
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorPowerCoherence

/-!
# The braiding scalar of a locally cyclic sheaf of modules

Let `O` be a sheaf of commutative rings on a site and let `M` be a sheaf of `O`-modules. If every
object of the site has a covering on whose members the module of sections of `M` is generated by
a single section, then the braiding of `M` with itself is the identity. For a tensor power
`L^{⊗ n}` of an invertible sheaf `L` this gives `braidingScalar O hO L n = 𝟙`, the commutativity
constraint of [Stacks, Tag 01CU](https://stacks.math.columbia.edu/tag/01CU) in degrees `(n, n)`.
That identity is not a formal consequence of the symmetric monoidal axioms: the odd line in super
vector spaces has `β = -𝟙`.

## Main results

* `Stacks.SheafOfModules.tensorProduct_comm_eq_self_of_span_singleton`: the flip of `P ⊗_R P`
  is the identity when the `R`-module `P` is generated by one element.
* `Stacks.SheafOfModules.hom_ext_of_locally_eq`: two morphisms of presheaves of modules into a
  separated presheaf of modules which agree, on every section, after restriction along a
  covering, are equal.
* `Stacks.SheafOfModules.sheafify_map_eq_id_of_comp_toSheafify`: a presheaf endomorphism which
  fixes the sheafification unit sheafifies to the identity.
* `Stacks.SheafOfModules.tensorSheafBraiding_self_eq_refl_of_locally_eq`: the braiding of `M`
  with itself is the identity as soon as the presheaf braiding fixes every section locally.
* `Stacks.SheafOfModules.tensorSheafBraiding_self_eq_refl_of_locally_span_singleton`: the
  braiding of a locally cyclic sheaf of modules with itself is the identity.
* `Stacks.SheafOfModules.tensorSheafBraiding_self_eq_refl_of_isTrivial`: the same for a
  trivial sheaf of modules.
* `Stacks.SheafOfModules.braiding_hom_eq_tensorSheafBraiding`: the braiding of the monoidal
  structure on sheaves of modules, expressed through `tensorObjIso` and `tensorSheafBraiding`.
* `Stacks.SheafOfModules.braiding_self_hom_eq_id_of_locally_span_singleton` and
  `Stacks.SheafOfModules.braiding_self_hom_eq_id_of_isTrivial`: `β_ M M = 𝟙` for a locally
  cyclic, resp. trivial, sheaf of modules.
* `Stacks.SheafOfModules.TensorPower.braidingScalar_eq_id_of_locally_span_singleton` and
  `Stacks.SheafOfModules.TensorPower.braidingScalar_eq_id_of_isTrivial`: the braiding scalar of
  a locally cyclic, resp. trivial, tensor power is the identity.

## Implementation notes

The local-cyclicity hypothesis is written out in the statements; it is
`SheafOfModules.GeneratingSections` with a one-element index type, read off on sections.

Local cyclicity is not implied by invertibility on a general site: on the site with one object
and the trivial topology, an invertible module over `R = O(*)` need not be cyclic. The trace
argument of Tag 0B8N (b) does not remove the hypothesis, since the dual basis expansion
`x = ∑ ψ(x ⊗ y_i) x_i` it would use holds if and only if the braiding scalar is `𝟙`.

The sheaf condition is used only through `Presheaf.IsSheaf.isSeparated`, so the only hypotheses
on the site are `HasWeakSheafify` and `WEqualsLocallyBijective`.

`IsInvertible` here is `Stacks.SheafOfModules.IsInvertible`, not
`AlgebraicGeometry.SheafOfModules.IsInvertible`; the two are not identified.

## References

* [Stacks Project, Tag 01CU](https://stacks.math.columbia.edu/tag/01CU)
* [Stacks Project, Tag 01CV](https://stacks.math.columbia.edu/tag/01CV)
* [Stacks Project, Tag 0B8N](https://stacks.math.columbia.edu/tag/0B8N)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public section

open CategoryTheory MonoidalCategory Opposite

open scoped TensorProduct

universe v u w

namespace Stacks.SheafOfModules

/-- The flip of `P ⊗_R P` is the identity when the `R`-module `P` is generated by one element. -/
theorem tensorProduct_comm_eq_self_of_span_singleton {R : Type*} [CommRing R] {P : Type*}
    [AddCommGroup P] [Module R P] (e : P) (he : ∀ g : P, ∃ c : R, g = c • e)
    (z : P ⊗[R] P) : TensorProduct.comm R P P z = z := by
  induction z using TensorProduct.inductionOn with
  | tmul a b =>
      obtain ⟨c, rfl⟩ := he a
      obtain ⟨d, rfl⟩ := he b
      simp only [TensorProduct.comm_tmul, TensorProduct.smul_tmul', TensorProduct.tmul_smul,
        smul_smul]
  | add x y hx hy => rw [map_add, hx, hy]

/-- The braiding of a cyclic object of `ModuleCat R` with itself fixes every element. -/
theorem braiding_hom_apply_eq_self {R : Type w} [CommRing R] {P : ModuleCat.{w} R} (e : P)
    (he : ∀ g : P, ∃ c : R, g = c • e) (z : (P ⊗ P : ModuleCat.{w} R)) :
    ((β_ P P).hom).hom z = z :=
  tensorProduct_comm_eq_self_of_span_singleton e he z

section Separated

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Cᵒᵖ ⥤ RingCat.{w}}

/-- Two morphisms of presheaves of modules into a separated presheaf of modules which agree
locally on every section agree. -/
theorem hom_ext_of_locally_eq {A T : PresheafOfModules.{w} R}
    (hT : Presheaf.IsSeparated J T.presheaf) (φ ψ : A ⟶ T)
    (h : ∀ (X : Cᵒᵖ) (a : A.obj X), ∃ S ∈ J X.unop, ∀ ⦃V : C⦄ (f : V ⟶ X.unop), S.arrows f →
      φ.app (op V) (A.map f.op a) = ψ.app (op V) (A.map f.op a)) :
    φ = ψ := by
  refine PresheafOfModules.hom_ext fun X => ?_
  obtain ⟨U, rfl⟩ : ∃ U : C, X = op U := ⟨X.unop, rfl⟩
  refine ModuleCat.hom_ext (LinearMap.ext fun a => ?_)
  obtain ⟨S, hS, hloc⟩ := h (op U) a
  refine hT U S hS _ _ fun V f hf => ?_
  exact (PresheafOfModules.naturality_apply φ f.op a).symm.trans
    ((hloc f hf).trans (PresheafOfModules.naturality_apply ψ f.op a))

end Separated

attribute [local instance] monoidalCategoryPresheafOfModules symmetricCategoryPresheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  (O : Cᵒᵖ ⥤ CommRingCat.{w})
  (hO : Presheaf.IsSheaf J (Stacks.SheafOfModules.TensorSheafification.structureRingPresheaf O))
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
  [HasWeakSheafify J AddCommGrpCat.{w}]

/-- The sections of the structure sheaf form a commutative ring. -/
local instance commRingStructureSheafObjBraiding (X : Cᵒᵖ) :
    CommRing ((Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO).obj.obj X) :=
  inferInstanceAs (CommRing (O.obj X))

/-- The sheafification of a presheaf endomorphism `f` is the identity if `f` fixes the
sheafification unit. -/
theorem sheafify_map_eq_id_of_comp_toSheafify
    {P : PresheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO).obj}
      (f : P ⟶ P)
    (h : f ≫ Stacks.SheafOfModules.TensorSheafification.toSheafify O hO P =
      Stacks.SheafOfModules.TensorSheafification.toSheafify O hO P) :
    (Stacks.SheafOfModules.TensorSheafification.sheafify O hO).map f = 𝟙 _ := by
  refine ((Stacks.SheafOfModules.TensorSheafification.sheafifyAdjunction O hO).homEquiv P
    _).injective ?_
  have hnat := (Stacks.SheafOfModules.TensorSheafification.sheafifyAdjunction O hO).unit.naturality
    f
  have h' : f ≫ (Stacks.SheafOfModules.TensorSheafification.sheafifyAdjunction O hO).unit.app P =
      (Stacks.SheafOfModules.TensorSheafification.sheafifyAdjunction O hO).unit.app P := h
  simp only [Adjunction.homEquiv_unit, CategoryTheory.Functor.map_id, Functor.comp_obj,
    Category.comp_id]
  conv_rhs => rw [← h']
  exact hnat.symm

/-- The braiding of a sheaf of modules with itself is the identity as soon as the braiding of
the underlying presheaf fixes every section locally. -/
theorem tensorSheafBraiding_self_eq_refl_of_locally_eq
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (hM : ∀ (U : C) (t : (M.val ⊗ M.val).obj (op U)), ∃ S ∈ J U,
      ∀ ⦃V : C⦄ (f : V ⟶ U), S.arrows f →
        (braidingVal O hO M M).hom.app (op V) ((M.val ⊗ M.val).map f.op t) =
          (M.val ⊗ M.val).map f.op t) :
    tensorSheafBraiding O hO M M = Iso.refl _ := by
  refine Iso.ext ?_
  change (Stacks.SheafOfModules.TensorSheafification.sheafify O hO).map (braidingVal O hO M M).hom =
    𝟙 _
  refine sheafify_map_eq_id_of_comp_toSheafify O hO _ ?_
  refine hom_ext_of_locally_eq
    ((Stacks.SheafOfModules.TensorSheafification.sheafify O hO).obj (M.val ⊗
      M.val)).isSheaf.isSeparated _ _ fun X t => ?_
  obtain ⟨S, hS, hloc⟩ := hM X.unop t
  refine ⟨S, hS, fun V f hf => ?_⟩
  exact congrArg
    (fun z => (Stacks.SheafOfModules.TensorSheafification.toSheafify O hO (M.val ⊗ M.val)).app
      (op V) z) (hloc f hf)

/-- The braiding of a locally cyclic sheaf of modules with itself is the identity. Here
*locally cyclic* means that every object of the site has a covering on whose members the module
of sections of `M` is generated by a single section. -/
theorem tensorSheafBraiding_self_eq_refl_of_locally_span_singleton
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (hM : ∀ U : C, ∃ S ∈ J U,
      ∀ ⦃V : C⦄ (f : V ⟶ U), S.arrows f → ∃ e : M.val.obj (op V),
        ∀ g : M.val.obj (op V), ∃ c : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O
          hO).obj.obj (op V),
          g = c • e) :
    tensorSheafBraiding O hO M M = Iso.refl _ := by
  refine tensorSheafBraiding_self_eq_refl_of_locally_eq O hO M fun U t => ?_
  obtain ⟨S, hS, hcyc⟩ := hM U
  refine ⟨S, hS, fun V f hf => ?_⟩
  obtain ⟨e, he⟩ := hcyc f hf
  exact braiding_hom_apply_eq_self e he _

/-- The braiding of a trivial sheaf of modules with itself is the identity. -/
theorem tensorSheafBraiding_self_eq_refl_of_isTrivial
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) (hM :
      IsTrivial O hO M) :
    tensorSheafBraiding O hO M M = Iso.refl _ := by
  obtain ⟨φ⟩ := hM
  refine tensorSheafBraiding_self_eq_refl_of_locally_span_singleton O hO M fun U => ?_
  refine ⟨⊤, J.top_mem U, fun V f _ => ?_⟩
  have hinv : ∀ x : M.val.obj (op V),
      (φ.inv.val.app (op V)) ((φ.hom.val.app (op V)) x) = x := fun x => by
    have h : ((φ.hom ≫ φ.inv).val.app (op V)) x = ((𝟙 M : M ⟶ M).val.app (op V)) x := by
      rw [φ.hom_inv_id]
    exact h
  have key : ∀ c : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO).obj.obj (op V),
      (φ.inv.val.app (op V)) c
        = c • (φ.inv.val.app (op V)) (1 : (Stacks.SheafOfModules.TensorSheafification.structureSheaf
          O hO).obj.obj (op V)) :=
    fun c => (congrArg (fun z => (φ.inv.val.app (op V)) z) (mul_one c).symm).trans
      ((φ.inv.val.app (op V)).hom.map_smul c
        (1 : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO).obj.obj (op V)))
  exact ⟨(φ.inv.val.app (op V)) (1 : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O
    hO).obj.obj (op V)),
    fun g => ⟨_, (hinv g).symm.trans (key ((φ.hom.val.app (op V)) g))⟩⟩

section Monoidal

attribute [local instance] monoidalCategory braidedCategory

/-- The braiding of the monoidal structure on sheaves of modules is the sheafification
`tensorSheafBraiding` of the presheaf braiding, conjugated by the identifications
`tensorObjIso` of the monoidal tensor product with the tensor product sheaf. -/
theorem braiding_hom_eq_tensorSheafBraiding
    (F G : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) :
    (β_ F G).hom = (tensorObjIso O hO F G).hom ≫ (tensorSheafBraiding O hO F G).hom ≫
      (tensorObjIso O hO G F).inv := by
  have hnat : (β_ F G).hom =
      ((sheafifyValIso O hO F).inv ⊗ₘ (sheafifyValIso O hO G).inv) ≫
        (β_ ((sheafifyFunctor O hO).obj F.val) ((sheafifyFunctor O hO).obj G.val)).hom ≫
          ((sheafifyValIso O hO G).hom ⊗ₘ (sheafifyValIso O hO F).hom) := by
    rw [← BraidedCategory.braiding_naturality, ← Category.assoc,
      MonoidalCategory.tensorHom_comp_tensorHom, Iso.inv_hom_id, Iso.inv_hom_id,
      MonoidalCategory.id_tensorHom_id, Category.id_comp]
  have hβ : (β_ ((sheafifyFunctor O hO).obj F.val) ((sheafifyFunctor O hO).obj G.val)).hom =
      (sheafifyTensorIso O hO F.val G.val).hom ≫
        (sheafifyFunctor O hO).map (β_ F.val G.val).hom ≫
          (sheafifyTensorIso O hO G.val F.val).inv :=
    Localization.Monoidal.β_hom_app (sheafifyFunctor O hO) (localIso (J := J) O)
      (sheafifyUnitIso O hO) F.val G.val
  rw [hnat, hβ]
  simp only [tensorObjIso, Category.assoc]
  rfl

/-- The braiding `β_ M M` is the identity if `tensorSheafBraiding O hO M M` is. -/
private theorem braiding_self_hom_eq_id_of_tensorSheafBraiding_eq_refl
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (h : tensorSheafBraiding O hO M M = Iso.refl _) : (β_ M M).hom = 𝟙 (M ⊗ M) := by
  rw [braiding_hom_eq_tensorSheafBraiding O hO M M, h]
  change (tensorObjIso O hO M M).hom ≫ 𝟙 _ ≫ (tensorObjIso O hO M M).inv = _
  exact (congrArg (fun morphism => (tensorObjIso O hO M M).hom ≫ morphism)
    (Category.id_comp (tensorObjIso O hO M M).inv)).trans (tensorObjIso O hO M M).hom_inv_id

/-- The braiding `β_ M M` of a locally cyclic sheaf of modules with itself, for the monoidal
structure on sheaves of modules, is the identity. -/
theorem braiding_self_hom_eq_id_of_locally_span_singleton
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
    (hM : ∀ U : C, ∃ S ∈ J U,
      ∀ ⦃V : C⦄ (f : V ⟶ U), S.arrows f → ∃ e : M.val.obj (op V),
        ∀ g : M.val.obj (op V), ∃ c : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O
          hO).obj.obj (op V),
          g = c • e) :
    (β_ M M).hom = 𝟙 (M ⊗ M) := by
  exact braiding_self_hom_eq_id_of_tensorSheafBraiding_eq_refl O hO M
    (tensorSheafBraiding_self_eq_refl_of_locally_span_singleton O hO M hM)

/-- The braiding `β_ M M` of a trivial sheaf of modules with itself, for the monoidal structure
on sheaves of modules, is the identity. -/
theorem braiding_self_hom_eq_id_of_isTrivial
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO)) (hM :
      IsTrivial O hO M) :
    (β_ M M).hom = 𝟙 (M ⊗ M) := by
  exact braiding_self_hom_eq_id_of_tensorSheafBraiding_eq_refl O hO M
    (tensorSheafBraiding_self_eq_refl_of_isTrivial O hO M hM)

end Monoidal

namespace TensorPower

variable (L : SheafOfModules.{w} (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO))
  [IsInvertible O hO L] (n : ℤ)

/-- The braiding scalar of `L^{⊗ n}` is the identity when `L^{⊗ n}` is generated by one section
on a covering of every object. -/
theorem braidingScalar_eq_id_of_locally_span_singleton
    (h : ∀ U : C, ∃ S ∈ J U, ∀ ⦃V : C⦄ (f : V ⟶ U), S.arrows f →
      ∃ e : (tensorPower O hO L n).val.obj (op V),
        ∀ g : (tensorPower O hO L n).val.obj (op V),
          ∃ c : (Stacks.SheafOfModules.TensorSheafification.structureSheaf O hO).obj.obj (op V), g =
            c • e) :
    braidingScalar O hO L n = 𝟙 _ :=
  (tensorSheafBraiding_self_eq_refl_iff O hO L n).mp
    (tensorSheafBraiding_self_eq_refl_of_locally_span_singleton O hO _ h)

/-- The braiding scalar of a trivial tensor power is the identity. -/
theorem braidingScalar_eq_id_of_isTrivial (h : IsTrivial O hO (tensorPower O hO L n)) :
    braidingScalar O hO L n = 𝟙 _ :=
  (tensorSheafBraiding_self_eq_refl_iff O hO L n).mp
    (tensorSheafBraiding_self_eq_refl_of_isTrivial O hO _ h)

end TensorPower

end Stacks.SheafOfModules

end
