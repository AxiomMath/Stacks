open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

open Stacks.SheafOfModules.Invertible (tensorPowerEquivalence
  tensorRightFunctor_isEquivalence powSuccIso)

open Stacks.SheafOfModules.TensorStalkRingedSpace (ringStalk grpStalk stalkMapL tensorStalkIso)

universe u

namespace Stacks.IdealTorsion.Eta

variable (X : RingedSpace.{u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf
  (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))
local notation "𝒪" => SheafOfModules.unit Oₓ

/-! ## The comparison of Tag 0F8N as a short exact sequence -/

/-- The twisted torsion inclusion is killed by the comparison of Tag 0F8N. -/
public theorem idealPowerAnnihilator_comp_etaHomologyMap (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (m : ℤ) :
    idealPowerMap X I (m + 1)
          (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1).ι ≫
        etaHomologyMap X I ι F hF (m + 1) = 0 :=
  (etaHomologyMap_comp_eq_zero_iff X I ι F hF m _).mpr
    (idealPowerAnnihilator_incl_zero X I ι (F.homology (m + 1)) m)

/-- **The comparison of Tag 0F8N as a short exact sequence.**  The sequence

`I^{⊗ (m+1)} ⊗ H^{m+1}(F)[I] ⟶ I^{⊗ (m+1)} ⊗ H^{m+1}(F) ⟶ H^{m+1}(η_I F)`

is short exact: the first map is a monomorphism because twisting by an ideal power is an
equivalence, the second is an epimorphism by `etaHomologyMap_epi`, and the first is a kernel of
the second because `etaHomologyMap_comp_eq_zero_iff` identifies the maps killed by the second
with those killed by the ideal-power inclusion, whose kernel is the twisted torsion by
`idealPowerAnnihilatorIsKernel`.

This is the form of Tag 0F8N that an exact functor transports; the isomorphism itself is not,
because the quotient map `H^{m+1}(F) ↠ H^{m+1}(F)/H^{m+1}(F)[I]` is not an isomorphism. -/
public theorem shortExact_etaHomologyShortComplex (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (m : ℤ) :
    (ShortComplex.mk _ _
      (idealPowerAnnihilator_comp_etaHomologyMap X I ι F hF m)).ShortExact := by
  have : Mono (idealPowerMap X I (m + 1)
      (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1).ι) :=
    @Functor.PreservesMonomorphisms.preserves _ _ _ _
      (tensorPowerEquivalence X.sheaf.obj (Oₓ).property I (m + 1)).functor
      (Functor.preservesMonomorphisms_of_adjunction
        (tensorPowerEquivalence X.sheaf.obj (Oₓ).property I (m + 1)).symm.toAdjunction) _ _
      (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1).ι
      (SheafOfModules.Submodule.instMonoι
        (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1))
  have : Epi (etaHomologyMap X I ι F hF (m + 1)) := etaHomologyMap_epi X I ι F hF (m + 1)
  refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ ?_) inferInstance
    inferInstance
  refine KernelFork.IsLimit.ofι' _ _ ?_
  intro B b hb
  exact KernelFork.IsLimit.lift'
    (idealPowerAnnihilatorIsKernel X I ι (F.homology (m + 1)) m) b
    ((etaHomologyMap_comp_eq_zero_iff X I ι F hF m b).mp hb)

/-! ## The stalk form of Tag 0F8N -/

/-- **Stacks Project, Tag 0F8N, at a point.**  Let `x` be a point at which multiplication by the
ideal is injective on the twisted cohomology stalk `(I^{⊗ (m+1)} ⊗ H^{m+1}(F))_x` —
equivalently, at which the twisted `I`-torsion of `H^{m+1}(F)` has no germ, since by
`idealPowerAnnihilatorIsKernel` that torsion is the kernel of the ideal-power inclusion.  Then
the comparison of Tag 0F8N is bijective on stalks at `x`:

`(I^{⊗ (m+1)} ⊗ H^{m+1}(F))_x ≅ H^{m+1}(η_I F)_x`.

The stalk functor is exact, so it carries `shortExact_etaHomologyShortComplex` to a short exact
sequence of `O_{X,x}`-modules; the hypothesis makes the first map of that sequence vanish, which
is what turns the epimorphism on the right into an isomorphism. -/
public theorem bijective_stalkMap_etaHomologyMap (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (m : ℤ)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (m + 1) (F.homology (m + 1))).val
        (idealPowerTerm X I m (F.homology (m + 1))).val
        (idealPowerIncl X I ι m (F.homology (m + 1))).val x)) :
    Function.Bijective
      (stalkMapL X (idealPowerTerm X I (m + 1) (F.homology (m + 1))).val
        ((etaObj X I ι F hF).homology (m + 1)).val
        (etaHomologyMap X I ι F hF (m + 1)).val x) := by
  have hSx := (AlgebraicGeometry.SheafOfModules.shortExact_iff_stalkFunctor_map_shortExact
    (O := Oₓ)
    (ShortComplex.mk _ _ (idealPowerAnnihilator_comp_etaHomologyMap X I ι F hF m))).1
    (shortExact_etaHomologyShortComplex X I ι F hF m) x
  have : Mono ((AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x).map
      (idealPowerIncl X I ι m (F.homology (m + 1)))) :=
    (ModuleCat.mono_iff_injective _).2 hx
  have hzero : ((ShortComplex.mk _ _
      (idealPowerAnnihilator_comp_etaHomologyMap X I ι F hF m)).map
        (AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x)).f = 0 := by
    refine (cancel_mono ((AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x).map
      (idealPowerIncl X I ι m (F.homology (m + 1))))).mp (Eq.trans ?_ zero_comp.symm)
    -- Both sides are composites of images of the stalk functor, so the step is a ground
    -- equation rather than a rewrite: the first map of the short complex is the twisted
    -- torsion inclusion, which the ideal-power inclusion kills.
    exact ((AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x).map_comp _ _).symm.trans
      ((congrArg (AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x).map
          (idealPowerAnnihilator_incl_zero X I ι (F.homology (m + 1)) m)).trans
        ((AlgebraicGeometry.SheafOfModules.stalkFunctor Oₓ x).map_zero _ _))
  exact ⟨(ModuleCat.mono_iff_injective _).1 ((ShortComplex.exact_iff_mono _ hzero).1 hSx.exact),
    (ModuleCat.epi_iff_surjective _).1 hSx.epi_g⟩

/-- **Stacks Project, Tag 0F8N, at a point**, with the degree named `n` and its predecessor
`m` supplied separately.  This is `bijective_stalkMap_etaHomologyMap` with the arithmetic
`n = m + 1` turned into a hypothesis, so that a consumer working in degree `n` need not spell
the predecessor inside the types. -/
public theorem bijective_stalkMap_etaHomologyMap_of_eq (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (m n : ℤ) (hmn : m + 1 = n)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (m + 1) (F.homology n)).val
        (idealPowerTerm X I m (F.homology n)).val
        (idealPowerIncl X I ι m (F.homology n)).val x)) :
    Function.Bijective
      (stalkMapL X (idealPowerTerm X I n (F.homology n)).val
        ((etaObj X I ι F hF).homology n).val
        (etaHomologyMap X I ι F hF n).val x) := by
  subst hmn
  exact bijective_stalkMap_etaHomologyMap X I ι F hF x m hx

/-- **Stacks Project, Tag 0F8N, at a point**, in degree `n`.  This is
`bijective_stalkMap_etaHomologyMap` with the degree written as `n` and the predecessor as
`n - 1`. -/
public theorem bijective_stalkMap_etaHomologyMap' (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (n : ℤ)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x)) :
    Function.Bijective
      (stalkMapL X (idealPowerTerm X I n (F.homology n)).val
        ((etaObj X I ι F hF).homology n).val
        (etaHomologyMap X I ι F hF n).val x) :=
  bijective_stalkMap_etaHomologyMap_of_eq X I ι F hF x (n - 1) n (sub_add_cancel n 1) hx

/-- **The stalk form of the isomorphism of Tag 0F8N.**  Under the hypothesis of
`bijective_stalkMap_etaHomologyMap'` the comparison of Tag 0F8N is an `O_{X,x}`-linear
equivalence `(I^{⊗ n} ⊗ H^n(F))_x ≃ H^n(η_I F)_x`.  Its underlying map is the stalk of
`etaHomologyMap`, so by `etaHomologyMap_cycles` it sends the germ of a twisted cocycle `g ⊗ s`
to the class of the cocycle `g s` of `η_I F`. -/
public noncomputable def etaCohomologyStalkEquiv (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (n : ℤ)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x)) :
    grpStalk X (idealPowerTerm X I n (F.homology n)).val x ≃ₗ[ringStalk X x]
      grpStalk X ((etaObj X I ι F hF).homology n).val x :=
  LinearEquiv.ofBijective _ (bijective_stalkMap_etaHomologyMap' X I ι F hF x n hx)

/-- The equivalence of `etaCohomologyStalkEquiv` is the stalk of the comparison map of
Tag 0F8N. -/
@[simp]
public theorem etaCohomologyStalkEquiv_apply (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (n : ℤ)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x))
    (s : grpStalk X (idealPowerTerm X I n (F.homology n)).val x) :
    etaCohomologyStalkEquiv X I ι F hF x n hx s =
      stalkMapL X (idealPowerTerm X I n (F.homology n)).val
        ((etaObj X I ι F hF).homology n).val
        (etaHomologyMap X I ι F hF n).val x s :=
  rfl

/-! ## Finite free stalks and their rank -/

/-- **The stalk of a sheaf of modules is finite free of rank `r`.**  The stalk `M_x`, read as a
module over the stalk `O_{X,x}` of the structure sheaf through the comparison of Tag 01CB, is
isomorphic to `O_{X,x}^r`. -/
public def IsFiniteFreeStalkOfRank (M : SheafOfModules.{u} Oₓ) (x : X) (r : ℕ) : Prop :=
  Nonempty (grpStalk X M.val x ≃ₗ[ringStalk X x] (Fin r → ringStalk X x))

/-- A stalk which is finite free of rank `r` is a free `O_{X,x}`-module. -/
public theorem IsFiniteFreeStalkOfRank.free {M : SheafOfModules.{u} Oₓ} {x : X} {r : ℕ}
    (h : IsFiniteFreeStalkOfRank X M x r) :
    Module.Free (ringStalk X x) (grpStalk X M.val x) :=
  Module.Free.of_equiv h.some.symm

/-- A stalk which is finite free of rank `r` is a finite `O_{X,x}`-module. -/
public theorem IsFiniteFreeStalkOfRank.finite {M : SheafOfModules.{u} Oₓ} {x : X} {r : ℕ}
    (h : IsFiniteFreeStalkOfRank X M x r) :
    Module.Finite (ringStalk X x) (grpStalk X M.val x) :=
  Module.Finite.equiv h.some.symm

/-- Finite freeness of a given rank only depends on the `O_{X,x}`-linear isomorphism class of
the stalk. -/
public theorem IsFiniteFreeStalkOfRank.of_linearEquiv {M N : SheafOfModules.{u} Oₓ} {x : X}
    {r : ℕ} (h : IsFiniteFreeStalkOfRank X M x r)
    (e : grpStalk X M.val x ≃ₗ[ringStalk X x] grpStalk X N.val x) :
    IsFiniteFreeStalkOfRank X N x r :=
  ⟨e.symm.trans h.some⟩

/-- **The rank of a finite free stalk is well defined** as soon as the stalk `O_{X,x}` of the
structure sheaf is nonzero.  This is the hypothesis `O_{X,x} ≠ 0` of Tag 0GTA: a nontrivial
commutative ring satisfies the strong rank condition, so `O_{X,x}^r ≃ O_{X,x}^s` forces
`r = s`, while over the zero ring every module is free of every rank. -/
public theorem IsFiniteFreeStalkOfRank.rank_eq {M : SheafOfModules.{u} Oₓ} {x : X}
    [Nontrivial (ringStalk X x)] {r s : ℕ}
    (h : IsFiniteFreeStalkOfRank X M x r) (h' : IsFiniteFreeStalkOfRank X M x s) : r = s := by
  have e : (Fin r → ringStalk X x) ≃ₗ[ringStalk X x] (Fin s → ringStalk X x) :=
    h.some.symm.trans h'.some
  simpa only [Module.finrank_fin_fun] using e.finrank_eq

/-! ## Untwisting a stalk by an ideal power -/

/-- A stalk trivialization of the ideal, read off `IsFiniteFreeStalkOfRank X I x 1`. -/
public theorem nonempty_ideal_stalk_linearEquiv (I : SheafOfModules.{u} Oₓ) (x : X)
    (hI : IsFiniteFreeStalkOfRank X I x 1) :
    Nonempty (grpStalk X I.val x ≃ₗ[ringStalk X x] ringStalk X x) :=
  ⟨hI.some.trans (LinearEquiv.funUnique (Fin 1) (ringStalk X x) (ringStalk X x))⟩

/-- **On a locally ringed space the stalk of an invertible sheaf is free of rank one.**  This
discharges the hypothesis `IsFiniteFreeStalkOfRank X I x 1` whenever every stalk of the
structure sheaf is a local ring — in particular on a scheme.  It is the pointwise converse half
of Tag 0B8M, available here because the Picard group of a local ring is trivial.

Over a *general* ringed space the hypothesis cannot be removed: the converse of Tag 0B8M fails
there, an invertible sheaf having stalks that are invertible modules
(`Stacks.SheafOfModules.module_invertible_grpStalk`) but not necessarily free.  In
Situation 0GT4 the hypothesis is supplied instead by the ideal being locally generated by a
nonzerodivisor, which trivializes `I` on a neighbourhood of every point. -/
public theorem isFiniteFreeStalkOfRank_one_of_isLocalRing (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    [∀ z : X.carrier, IsLocalRing (ringStalk X z)] (x : X) :
    IsFiniteFreeStalkOfRank X I x 1 := by
  have hinv : Stacks.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X).property I :=
    inferInstanceAs (Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I)
  exact ⟨(Stacks.SheafOfModules.nonempty_grpStalk_linearEquiv X I x).some.trans
    (LinearEquiv.funUnique (Fin 1) (ringStalk X x) (ringStalk X x)).symm⟩

/-- **In Situation 0GT4 the stalk of the ideal is free of rank one, on an arbitrary ringed
space.**  An ideal sheaf locally generated by a section that is a nonzerodivisor has, at every
point, a generator of the stalk ideal — the germ of that section — and division by a generator
identifies `O_{X,x}` with `I_x`.

This is what `isFiniteFreeStalkOfRank_one_of_isLocalRing` gives on a locally ringed space; here
no hypothesis on the stalks of the structure sheaf is needed, because local generation by a
nonzerodivisor is a stronger input than invertibility and supplies the generator directly. It
discharges the hypothesis `IsFiniteFreeStalkOfRank X I x 1` of
`isFiniteFreeStalkOfRank_homology_leta` in Situation 0GT4. -/
public theorem isFiniteFreeStalkOfRank_one_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι) (x : X) :
    IsFiniteFreeStalkOfRank X I x 1 := by
  let : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I :=
    Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  obtain ⟨U, hxU, f, hgen, -⟩ := hregl x
  exact ⟨(nonempty_grpStalk_linearEquiv_of_generatesStalkIdeal X I ι x _
      (Stacks.IdealTorsion.generatesStalkIdeal_of_generatesIdealOn X ι U f hgen x hxU)).some.trans
    (LinearEquiv.funUnique (Fin 1) (ringStalk X x) (ringStalk X x)).symm⟩

/-- **Twisting by an ideal power preserves finite freeness and the rank at a stalk.**  If `I_x`
is free of rank one — which is what invertibility of `I` supplies in Situation 0GT4, where the
ideal is locally generated by a nonzerodivisor — then `(I^{⊗ n} ⊗ M)_x` is finite free of
rank `r` exactly when `M_x` is. -/
public theorem isFiniteFreeStalkOfRank_idealPowerTerm (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I] (x : X)
    (hI : IsFiniteFreeStalkOfRank X I x 1) (n : ℤ) (M : SheafOfModules.{u} Oₓ) (r : ℕ) :
    IsFiniteFreeStalkOfRank X (idealPowerTerm X I n M) x r ↔
      IsFiniteFreeStalkOfRank X M x r := by
  obtain ⟨eI⟩ := nonempty_ideal_stalk_linearEquiv X I x hI
  obtain ⟨e⟩ := nonempty_idealPowerTerm_stalkEquiv X I x eI n M
  exact ⟨fun h => h.of_linearEquiv X e, fun h => h.of_linearEquiv X e.symm⟩

/-! ## The rank of the cohomology of the décalage -/

/-- **The cohomology of the décalage is finite free of the same rank.**  At a point `x` where
multiplication by the ideal is injective on the twisted cohomology stalk, if
`(I^{⊗ n} ⊗ H^n(F))_x` is finite free of rank `r` over `O_{X,x}` then so is `H^n(η_I F)_x`.

This is the stalk form of Tag 0F8N applied to the rank predicate: the comparison of Tag 0F8N is
an isomorphism at `x`, and finite freeness of a fixed rank is an isomorphism invariant. -/
public theorem isFiniteFreeStalkOfRank_etaHomology (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (n : ℤ) (r : ℕ)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x))
    (hr : IsFiniteFreeStalkOfRank X (idealPowerTerm X I n (F.homology n)) x r) :
    IsFiniteFreeStalkOfRank X ((etaObj X I ι F hF).homology n) x r :=
  hr.of_linearEquiv X (etaCohomologyStalkEquiv X I ι F hF x n hx)

/-- **The cohomology of the décalage is finite free of the same rank, in the shape of
Tag 0GTA.**  Let `x` be a point at which the stalk `I_x` of the ideal is free of rank one — what
Situation 0GT4 supplies, the ideal being locally generated by a nonzerodivisor — and at which
multiplication by the ideal is injective on the twisted cohomology stalk.  If `H^n(F)_x` is
finite free of rank `r` over `O_{X,x}`, then so is `H^n(η_I F)_x`.

This is the whole mathematical content of Tag 0GTA at the level of complexes: by
`isFiniteFreeStalkOfRank_idealPowerTerm` the twist by `I^{⊗ n}` does not change finite freeness
or the rank at `x`, and by `etaCohomologyStalkEquiv` the twisted cohomology stalk is the
cohomology stalk of the décalage.  There is no constraint on the degree `n`, which may be
negative.  Together with `IsFiniteFreeStalkOfRank.rank_eq`, which needs `O_{X,x}` nonzero, this
says that the rank is unchanged.  What Tag 0GTA states in addition is the same assertion for
`Lη_I M` with `M` an object of the derived category, which needs the functor of Tag 0F8Q. -/
public theorem isFiniteFreeStalkOfRank_etaHomology_of_homology (I : SheafOfModules.{u} Oₓ)
    (ι : I ⟶ 𝒪) [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (x : X) (n : ℤ) (r : ℕ)
    (hI : IsFiniteFreeStalkOfRank X I x 1)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x))
    (hr : IsFiniteFreeStalkOfRank X (F.homology n) x r) :
    IsFiniteFreeStalkOfRank X ((etaObj X I ι F hF).homology n) x r :=
  isFiniteFreeStalkOfRank_etaHomology X I ι F hF x n r hx
    ((isFiniteFreeStalkOfRank_idealPowerTerm X I x hI n (F.homology n) r).2 hr)

/-! ## The rank of the cohomology of the derived décalage -/

section StandardDerivedCategory

attribute [local instance 10000] HasDerivedCategory.standard

/-- **Finite freeness of the cohomology of the derived décalage, for the functor `derivedEta`.**
Let `ι : I ⟶ O_X` be an invertible ideal sheaf admitting termwise `I`-torsion-free resolutions
`hres` of unbounded complexes, let `M` be an object of `D(O_X)` and let `x` be a point of `X` at
which `I_x` is free of rank one.  If the stalk `H^n(M)_x` is finite free of rank `r` over
`O_{X,x}`, then so is `H^n(Lη_I M)_x`.  The proof chooses such
a resolution `F` of `M`; then `derivedEta_iso` identifies `Lη_I M` with the class of the
chain-level décalage `η_I F`, and the statement is the complex-level
`isFiniteFreeStalkOfRank_etaHomology_of_homology` transported along
`DerivedCategory.homologyFunctorFactors`, which identifies the homology of `Q(G)` in the
derived category with the cohomology sheaf `H^n(G)` of the complex `G`.  The degree `n` may be
negative.

Injectivity of multiplication by the ideal on the twisted cohomology stalk, which the
complex-level statement needs, follows from the freeness of rank one of `I_x` together with the
finite freeness of `H^n(M)_x`, by `injective_stalkMapL_idealPowerIncl`.  The uniqueness of the
common rank over a nonzero `O_{X,x}` is `rank_homology_derivedEta_eq` below. -/
public theorem isFiniteFreeStalkOfRank_homology_leta (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [monoIncl : Mono ι]
    [invertibleIdeal : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hres : HasTorsionFreeResolutions X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ))
    (x : X) (n : ℤ) (r : ℕ)
    (hI : IsFiniteFreeStalkOfRank X I x 1)
    (hr : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj M) x r) :
    IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj
        ((@derivedEta X I ι monoIncl invertibleIdeal hres).obj M)) x r := by
  obtain ⟨G, ⟨e⟩⟩ := Functor.EssSurj.mem_essImage (F := DerivedCategory.Q) M
  obtain ⟨F, p, hF, hq⟩ := hres G
  have hiso : IsIso (DerivedCategory.Q.map p) :=
    Localization.inverts DerivedCategory.Q
      (HomologicalComplex.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)) p
      ((HomologicalComplex.mem_quasiIso_iff p).2 hq)
  have eM : DerivedCategory.Q.obj F ≅ M := (@asIso _ _ _ _ _ hiso) ≪≫ e
  have hr' : IsFiniteFreeStalkOfRank X (F.homology n) x r :=
    hr.of_linearEquiv X (moduleStalkIso X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).mapIso eM.symm ≪≫
        (DerivedCategory.homologyFunctorFactors (SheafOfModules.{u} Oₓ) n).app F) x)
  have hmain : IsFiniteFreeStalkOfRank X ((etaObj X I ι F hF).homology n) x r :=
    isFiniteFreeStalkOfRank_etaHomology_of_homology X I ι F hF x n r hI
      (injective_stalkMapL_idealPowerIncl X I ι (F.homology n) x (n - 1) r
        (nonempty_ideal_stalk_linearEquiv X I x hI).some hr'.some) hr'
  have eL : (@derivedEta X I ι monoIncl invertibleIdeal hres).obj M ≅
      DerivedCategory.Q.obj (etaObj X I ι F hF) :=
    (@derivedEta X I ι monoIncl invertibleIdeal hres).mapIso eM.symm ≪≫
      (@derivedEta_iso X I ι monoIncl invertibleIdeal hres).app
        (HomologicalComplex.liftObjectProperty (torsionFreeProperty X ι) F hF)
  exact hmain.of_linearEquiv X (moduleStalkIso X
    (((DerivedCategory.homologyFunctorFactors (SheafOfModules.{u} Oₓ) n).app
          (etaObj X I ι F hF)).symm ≪≫
      (DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).mapIso eL.symm) x)

/-- **Stacks Project, Tag 0GTA, in Situation 0GT4.**  Let
`ι : I ⟶ O_X` be an ideal sheaf locally generated by a section that is a nonzerodivisor on
`O_X`, let `M` be an object of `D(O_X)` and let `x` be a point of `X`.  If the stalk `H^n(M)_x`
is finite free of rank `r` over `O_{X,x}`, then so is `H^n(Lη_I M)_x`.

The proof applies `isFiniteFreeStalkOfRank_homology_leta`: the derived décalage is
`derivedEtaOfRegular`, the functor of Tag 0F8Q built from the situation, the torsion-free
resolutions are `torsionFreeResolutions_of_isLocallyGeneratedByRegular`, and the freeness of
rank one of `I_x` is `isFiniteFreeStalkOfRank_one_of_isLocallyGeneratedByRegular`.  The
invertibility of `I` comes from the implication (1) ⟹ (2) of Tag 0GT3.  The statement holds at
every point `x`, and the degree `n` may be negative. -/
@[stacks 0GTA "in Situation 0GT4: if H^n(M)_x is finite free of rank r over O_{X,x}, then so \
is H^n(Lη_I M)_x, where Lη_I is derivedEtaOfRegular, the functor of Tag 0F8Q for that \
situation; the uniqueness of the rank over a nonzero stalk is \
rank_homology_derivedEtaOfRegular_eq"]
public theorem isFiniteFreeStalkOfRank_homology_derivedEtaOfRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [monoIncl : Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ))
    (x : X) (n : ℤ) (r : ℕ)
    (hr : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj M) x r) :
    IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj
        ((@derivedEtaOfRegular X I ι monoIncl hregl).obj M)) x r := by
  let := Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  exact isFiniteFreeStalkOfRank_homology_leta X I ι
    (@torsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι monoIncl hregl) M x n r
    (isFiniteFreeStalkOfRank_one_of_isLocallyGeneratedByRegular X I ι hregl x) hr

/-- **The derived décalage does not change the rank**, in the generality of
`isFiniteFreeStalkOfRank_homology_leta`.  If `H^n(M)_x` is finite free of rank `r` and
`H^n(Lη_I M)_x` is finite free of rank `s`, then `s = r`: the previous statement makes
`H^n(Lη_I M)_x` finite free of rank `r` as well, and over a nonzero `O_{X,x}` the rank of a
finite free module is unique by `IsFiniteFreeStalkOfRank.rank_eq`.  This is the one place the
hypothesis `O_{X,x} ≠ 0` of Tag 0GTA is used.

Unlike `rank_homology_leta_eq` this speaks about the functor `derivedEta` directly, naming no
resolution of `M`, and so is read at the same model of the derived category as
`isFiniteFreeStalkOfRank_homology_leta`; it therefore composes with that statement, which the
resolution-level form does not. -/
public theorem rank_homology_derivedEta_eq (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [monoIncl : Mono ι]
    [invertibleIdeal : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hres : HasTorsionFreeResolutions X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ))
    (x : X) [Nontrivial (ringStalk X x)] (n : ℤ) (r s : ℕ)
    (hI : IsFiniteFreeStalkOfRank X I x 1)
    (hr : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj M) x r)
    (hs : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj
        ((@derivedEta X I ι monoIncl invertibleIdeal hres).obj M)) x s) :
    s = r :=
  hs.rank_eq X (isFiniteFreeStalkOfRank_homology_leta X I ι hres M x n r hI hr)

/-- **Stacks Project, Tag 0GTA, the clause "of the same rank", in Situation 0GT4 itself.**  Let
`ι : I ⟶ O_X` be an ideal sheaf locally generated by a section that is a nonzerodivisor on
`O_X`, let `M` be an object of `D(O_X)` and let `x` be a point of `X` at which the stalk
`O_{X,x}` is nonzero.  If `H^n(M)_x` is finite free of rank `r` and `H^n(Lη_I M)_x` is finite
free of rank `s`, then `s = r`.

Together with `isFiniteFreeStalkOfRank_homology_derivedEtaOfRegular` this is the complete source
statement: that statement supplies the finite
freeness of `H^n(Lη_I M)_x` at the rank of `H^n(M)_x`, and this one that no other rank is
possible, which is what makes "the same rank" a determinate assertion.  The nonvanishing of
`O_{X,x}` enters only here, through `IsFiniteFreeStalkOfRank.rank_eq`: over the zero ring every
module is free of every rank. -/
@[stacks 0GTA "the clause `of the same rank`, in Situation 0GT4: the ideal is locally generated \
by a nonzerodivisor and the derived décalage is derivedEtaOfRegular, the functor of Tag 0F8Q \
for that situation; the condition O_{X,x} ≠ 0 is Nontrivial on the stalk of the structure \
sheaf, and the finite freeness itself is isFiniteFreeStalkOfRank_homology_derivedEtaOfRegular"]
public theorem rank_homology_derivedEtaOfRegular_eq
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [monoIncl : Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ))
    (x : X) [Nontrivial (ringStalk X x)] (n : ℤ) (r s : ℕ)
    (hr : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj M) x r)
    (hs : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj
        ((@derivedEtaOfRegular X I ι monoIncl hregl).obj M)) x s) :
    s = r :=
  hs.rank_eq X (isFiniteFreeStalkOfRank_homology_derivedEtaOfRegular X I ι hregl M x n r hr)

end StandardDerivedCategory

/-- **The derived décalage does not change the rank**, the form of Tag 0GTA in which the
nonvanishing hypothesis `O_{X,x} ≠ 0` is used.  Under the hypotheses of
`isFiniteFreeStalkOfRank_homology_leta`, if `H^n(M)_x` is finite free of rank `r` and
`H^n(Lη_I M)_x` is finite free of rank `s`, then `s = r`: by the previous statement
`H^n(Lη_I M)_x` is also finite free of rank `r`, and over a nonzero `O_{X,x}` the rank of a
finite free module is unique by `IsFiniteFreeStalkOfRank.rank_eq`. -/
public theorem rank_homology_leta_eq (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (M LM : DerivedCategory (SheafOfModules.{u} Oₓ))
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (eM : DerivedCategory.Q.obj F ≅ M)
    (eL : LM ≅ DerivedCategory.Q.obj (etaObj X I ι F hF))
    (x : X) [Nontrivial (ringStalk X x)] (n : ℤ) (r s : ℕ)
    (hI : IsFiniteFreeStalkOfRank X I x 1)
    (hx : Function.Injective
      (stalkMapL X (idealPowerTerm X I (n - 1 + 1) (F.homology n)).val
        (idealPowerTerm X I (n - 1) (F.homology n)).val
        (idealPowerIncl X I ι (n - 1) (F.homology n)).val x))
    (hr : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj M) x r)
    (hs : IsFiniteFreeStalkOfRank X
      ((DerivedCategory.homologyFunctor (SheafOfModules.{u} Oₓ) n).obj LM) x s) :
    s = r :=
  hs.rank_eq X
    ((isFiniteFreeStalkOfRank_etaHomology_of_homology X I ι F hF x n r hI hx
