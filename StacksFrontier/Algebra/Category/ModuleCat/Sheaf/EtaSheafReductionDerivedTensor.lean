module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafBocksteinIsoInvariance
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafDerivedTensorModIdeal
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafReductionDerivedIsoRegular

import StacksCore.Tactic.StacksAttribute

/-!
# Tag 0GT9: `Lη_I M ⊗^L O_X/I ≅ H^•(M/I)` in `D(O_X)`

Let `(X, O_X)` be a ringed space and `I ⊂ O_X` an ideal sheaf which is locally generated by a
section that is a nonzerodivisor (Situation 0GT4).  For every object `M` of `D(O_X)` there is a
canonical isomorphism

`Lη_I M ⊗^L O_X/I ⟶ H^•(M/I)`

in `D(O_X)`, where `Lη_I` is the derived décalage of Tag 0F8Q, `⊗^L` the derived tensor product of
Tag 06YU, `O_X/I = I^0/I^1`, and `H^•(M/I)` the Bockstein complex of Tag 0GT8, with terms
`H^i(M ⊗^L I^i/I^{i+1})` and the Bockstein operators as differentials.

The proof follows the source.  Represent `M` by a K-flat complex `P` with flat, hence
`I`-torsion-free, terms.  Then `Lη_I M` is the class of `η_I P`, whose terms are again
`I`-torsion-free, so `Lη_I M ⊗^L O_X/I` is computed by the ordinary tensor product
`η_I P ⊗ O_X/I` (`derivedEtaTensorModIdealIso`).  Likewise each term
`H^i(M ⊗^L I^i/I^{i+1})` is `H^i(P ⊗ I^i/I^{i+1})`, and the Bockstein operator is the connecting
map of `0 → P ⊗ I^{i+1}/I^{i+2} → P ⊗ I^i/I^{i+2} → P ⊗ I^i/I^{i+1} → 0`
(`bocksteinComplexIsoChain`).  Between the two chain-level complexes the source's map
`s = f^i s' ↦ [f^i s']` is the morphism of complexes `Reduction.reductionComparisonChainMap`, a
quasi-isomorphism in Situation 0GT4 (`Reduction.reductionComparisonQIsoOfRegular`, which checks
it on stalks against Tag 0F7T).

## Main definitions

* `Stacks.IdealTorsion.ReductionDerived.reductionDerivedTensorIsoOfResolution`: the isomorphism
  read through a chosen K-flat representative with flat terms.
* `Stacks.IdealTorsion.ReductionDerived.reductionDerivedTensorIso`: **Tag 0GT9.**

## References

* [Stacks Project, Tag 0GT9](https://stacks.math.columbia.edu/tag/0GT9)
* [Stacks Project, Tag 0GT8](https://stacks.math.columbia.edu/tag/0GT8)
* [Stacks Project, Tag 0GT4](https://stacks.math.columbia.edu/tag/0GT4)
* [Stacks Project, Tag 0F8Q](https://stacks.math.columbia.edu/tag/0F8Q)
* [Stacks Project, Tag 0F7T](https://stacks.math.columbia.edu/tag/0F7T)
-/

@[expose] public section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

open Stacks.DerivedTensor.RingedSite (canonicalDerivedTensorProduct)

universe u

namespace Stacks.IdealTorsion.ReductionDerived

open Stacks.IdealTorsion.Bockstein Stacks.IdealTorsion.Reduction

variable (X : RingedSpace.{u, u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- **Every object of `D(O_X)` is represented by a K-flat complex with flat terms**, and in
Situation 0GT4 such terms are `I`-torsion-free (Tag 0GT5). -/
public theorem exists_kFlat_torsionFree_representative [HasDerivedCategory (SheafOfModules.{u} Oₓ)]
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) :
    ∃ (P : CochainComplex (SheafOfModules.{u} Oₓ) ℤ),
      AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.KFlat X P ∧
        (∀ k : ℤ, IsIdealTorsionFree X ι (P.X k)) ∧ Nonempty (DerivedCategory.Q.obj P ≅ M) := by
  obtain ⟨P, p, hPk, hflat, hq, -⟩ :=
    AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.exists_kFlatResolution X
      (DerivedCategory.Q.objPreimage M)
  have hι : Mono ι := inferInstance
  exact ⟨P, hPk, fun k =>
      @Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat X I ι hι hregl _ (hflat k),
    ⟨asIso (DerivedCategory.Q.map p) ≪≫ DerivedCategory.Q.objObjPreimageIso M⟩⟩

attribute [local instance] HasDerivedCategory.standard

/-- **The isomorphism of Tag 0GT9, read through a representative.**  For a K-flat complex `P` with
`I`-torsion-free terms and an isomorphism `e : Q P ≅ M`, the composite

`Lη_I M ⊗^L O_X/I ≅ Lη_I (Q P) ⊗^L O_X/I ≅ Q(η_I P ⊗ O_X/I) ≅ Q(H^•(P/I)) ≅ H^•(Q P/I)
  ≅ H^•(M/I)`,

whose middle arrow is the class of the source's morphism of complexes
`Reduction.reductionComparisonChainMap`. -/
public noncomputable def reductionDerivedTensorIsoOfResolution (I : SheafOfModules.{u} Oₓ)
    (ι : I ⟶ 𝒪) [Mono ι] (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    {M : DerivedCategory (SheafOfModules.{u} Oₓ)} (P : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hPk : AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.KFlat X P)
    (hP : ∀ k : ℤ, IsIdealTorsionFree X ι (P.X k)) (e : DerivedCategory.Q.obj P ≅ M) :
    haveI : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I :=
      Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
    ((canonicalDerivedTensorProduct X.sheaf).tensor.obj
        ((Stacks.IdealTorsion.Eta.derivedEtaOfRegular X I ι hregl).obj M)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u} Oₓ) 0).obj (powerQuotient X I ι 0)) ≅
      DerivedCategory.Q.obj (bocksteinComplex X I ι M) :=
  haveI : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I :=
    Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  ((canonicalDerivedTensorProduct X.sheaf).tensor.mapIso
      ((Stacks.IdealTorsion.Eta.derivedEtaOfRegular X I ι hregl).mapIso e.symm)).app _ ≪≫
    derivedEtaTensorModIdealIso X I ι hregl P hP ≪≫
    reductionComparisonQIsoOfRegular X I ι hregl P hP ≪≫
    DerivedCategory.Q.mapIso (bocksteinComplexIsoChain X I ι P hPk hP).symm ≪≫
    DerivedCategory.Q.mapIso (bocksteinComplexMapIso X I ι e)

/-- **Stacks Project, Tag 0GT9.**  In Situation 0GT4 — `(X, O_X)` a ringed space and
`ι : I ⟶ O_X` an ideal sheaf locally generated by a section that is a nonzerodivisor — for every
object `M` of `D(O_X)` there is a canonical isomorphism

`Lη_I M ⊗^L O_X/I ≅ H^•(M/I)`

in `D(O_X)`.  Here `Lη_I = Eta.derivedEtaOfRegular X I ι hregl` is the derived décalage of
Tag 0F8Q, `⊗^L` is the derived tensor product of Tag 06YU, `O_X/I` is `powerQuotient X I ι 0`,
the quotient `I^0/I^1`, placed in degree `0`, and `H^•(M/I) = bocksteinComplex X I ι M` is the
complex of Tag 0GT8, with terms `H^i(M ⊗^L I^i/I^{i+1})` and the Bockstein operators as
differentials.  The isomorphism is the one of the source's proof,
`reductionDerivedTensorIsoOfResolution`, read through a K-flat representative of `M` with flat
terms: there it is the class of the morphism of complexes
`η_I P ⊗ O_X/I ⟶ H^•(P/I)`, `s = f^i s' ↦ [f^i s']`. -/
@[stacks 0GT9 "In Situation 0GT4, for every M in D(O_X): the isomorphism \
Lη_I M ⊗^L O_X/I ≅ H^•(M/I) in D(O_X), Lη_I of 0F8Q, ⊗^L of 06YU, O_X/I = I^0/I^1, and \
H^•(M/I) the 0GT8 complex of derived Bockstein maps, induced by the source's chain map"]
public noncomputable def reductionDerivedTensorIso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) :
    haveI : Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I :=
      Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
    ((canonicalDerivedTensorProduct X.sheaf).tensor.obj
        ((Stacks.IdealTorsion.Eta.derivedEtaOfRegular X I ι hregl).obj M)).obj
        ((DerivedCategory.singleFunctor (SheafOfModules.{u} Oₓ) 0).obj (powerQuotient X I ι 0)) ≅
      DerivedCategory.Q.obj (bocksteinComplex X I ι M) :=
  reductionDerivedTensorIsoOfResolution X I ι hregl
    (exists_kFlat_torsionFree_representative X I ι hregl M).choose
    (exists_kFlat_torsionFree_representative X I ι hregl M).choose_spec.1
    (exists_kFlat_torsionFree_representative X I ι hregl M).choose_spec.2.1
    (exists_kFlat_torsionFree_representative X I ι hregl M).choose_spec.2.2.some

end Stacks.IdealTorsion.ReductionDerived

end
