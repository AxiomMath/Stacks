module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafDerived
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatIdealTorsionFree
public import StacksFrontier.Topology.Sheaves.Cohomology.KFlat.OnARingedSpace
import StacksCore.Tactic.StacksAttribute

/-!
# Termwise `I`-torsion-free resolutions of unbounded complexes

Let `(X, O_X)` be a ringed space and `ι : I ⟶ O_X` an ideal sheaf which is locally generated by
a section that is a nonzerodivisor on `O_X`.  Every cochain complex of `O_X`-modules then
receives a quasi-isomorphism from a complex whose terms are `I`-torsion free: a resolution with
flat terms exists, and a flat module is `I`-torsion free.  For an invertible ideal sheaf on a
ringed space whose stalks are local rings the hypothesis on `ι` is automatic.

This is the first step in the construction of the derived décalage `Lη_I` on `D(O_X)`, and the
condition on which `Stacks.IdealTorsion.Eta.derivedEta` and its two companions are stated.

## Main results

* `Stacks.IdealTorsion.Eta.hasTorsionFreeResolutions_of_isLocallyGeneratedByRegular`: termwise
  `I`-torsion-free resolutions exist when `I` is locally generated by a nonzerodivisor.
* `Stacks.IdealTorsion.Eta.hasTorsionFreeResolutions_of_isInvertible`: the same for an
  invertible ideal sheaf on a ringed space whose stalks are local rings.

## Implementation notes

The resolution is the one of Tag 06YS on a ringed space, whose terms are flat; only its
flatness and the quasi-isomorphism are used, not its K-flatness nor the termwise surjectivity
of the augmentation.  That a flat module is `I`-torsion free is
`Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat`, the third criterion of Tag 0GT5.

The monomorphy of `ι` is passed explicitly rather than synthesized: two spellings of the
structure sheaf of rings meet here — the one the décalage is written at and the one the
torsion-free predicate is written at — and although they are the same sheaf, identifying them
unfolds `CategoryTheory.sheafCompose`, which does not unfold at the transparency at which
instances are found.

## References

* [Stacks Project, Tag 0F8Q](https://stacks.math.columbia.edu/tag/0F8Q)
* [Stacks Project, Tag 06YS](https://stacks.math.columbia.edu/tag/06YS)
* [Stacks Project, Tag 0GT5](https://stacks.math.columbia.edu/tag/0GT5)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.IdealTorsion.Eta

variable (X : RingedSpace.{u})

/-- **Termwise `I`-torsion-free resolutions exist.**  For an ideal sheaf locally generated by a
nonzerodivisor, every cochain complex of `O_X`-modules receives a quasi-isomorphism from a
complex of `I`-torsion-free `O_X`-modules.  This is the first step of the proof of
[Stacks, Tag 0F8Q]: a resolution with flat terms exists by Tag 06YS, and a flat module is
`I`-torsion free by the third criterion of Tag 0GT5. -/
@[stacks 0F8Q "the existence of termwise I-torsion-free resolutions of unbounded complexes, \
the first step of the proof"]
public theorem hasTorsionFreeResolutions_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} (structureSheaf X.sheaf))
    (ι : I ⟶ SheafOfModules.unit (structureSheaf X.sheaf)) (hι : Mono ι)
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι) :
    HasTorsionFreeResolutions X ι := by
  intro G
  obtain ⟨K, p, -, hflat, hq, -⟩ :=
    AlgebraicGeometry.RingedSpace.KFlatDerivedPullback.exists_kFlatResolution X G
  exact ⟨K, p, fun n =>
    @Stacks.IdealTorsion.isIdealTorsionFree_of_isFlat X I ι hι hregl (K.X n) (hflat n), hq⟩

/-- **Termwise `I`-torsion-free resolutions exist for an invertible ideal sheaf.**  On a ringed
space whose stalks are local rings an invertible ideal sheaf is locally generated by a
nonzerodivisor, so every cochain complex of `O_X`-modules receives a quasi-isomorphism from a
complex of `I`-torsion-free modules. -/
@[stacks 0F8Q "the existence of termwise I-torsion-free resolutions of unbounded complexes for \
an invertible ideal sheaf on a ringed space whose stalks are local rings"]
public theorem hasTorsionFreeResolutions_of_isInvertible
    [∀ x : X.carrier, IsLocalRing
      (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x)]
    (I : SheafOfModules.{u} (structureSheaf X.sheaf))
    (ι : I ⟶ SheafOfModules.unit (structureSheaf X.sheaf)) (hι : Mono ι)
    (hI : Stacks.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X).property I) :
    HasTorsionFreeResolutions X ι :=
  hasTorsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι hι
    (@Stacks.IdealTorsion.isLocallyGeneratedByRegular_of_isInvertible X inferInstance _ ι hι hI)

end Stacks.IdealTorsion.Eta

end
