module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocallyFreePowers
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorPowerPresentation
import StacksCore.Tactic.StacksAttribute

/-!
# Local generation and finite type for the tensor powers of a sheaf of modules

Let `(X, 𝒪_X)` be a ringed space and `F` a sheaf of `𝒪_X`-modules. If `F` is locally generated by
sections then so is each tensor power `Tⁿ F`, and if `F` is of finite type then so is each `Tⁿ F`.
More generally, on any site, an epimorphism `free I ⟶ M` induces an epimorphism from a free sheaf
of modules onto every tensor power of `M`, on an index type which is finite whenever `I` is.

## Main definitions

* `Stacks.SheafOfModules.localGeneratorsDataTensorPiece`: the local generators of the degree-`n`
  piece of the tensor algebra of `F` built from local generators of `F`, on the same covering.

## Main results

* `Stacks.SheafOfModules.exists_epi_free_tensorPower`: an epimorphism onto `M` from a free sheaf
  of modules induces one onto every tensor power of `M`.
* `Stacks.SheafOfModules.exists_generatingSections_tensorPower` and
  `exists_generatingSections_tensorPower_over`: generating sections of `M` give generating
  sections of every tensor power of `M`, globally and over an object of the site, finitely many
  when the given ones are finitely many.
* `Stacks.SheafOfModules.nonempty_localGeneratorsData_tensorPower`: each tensor power of a sheaf
  of modules locally generated by sections is locally generated by sections.
* `Stacks.SheafOfModules.isFiniteType_tensorPower`: each tensor power of a sheaf of modules of
  finite type is of finite type.

## References

* [Stacks Project, Tag 01CE](https://stacks.math.columbia.edu/tag/01CE)
* [Stacks Project, Tag 01CK](https://stacks.math.columbia.edu/tag/01CK)
* [Stacks Project, Section 17.21](https://stacks.math.columbia.edu/tag/01CF)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf AlgebraicGeometry
  TopologicalSpace

universe v u w

namespace Stacks.SheafOfModules

section Site

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  {Osharp : Sheaf J CommRingCat.{w}}
  [HasSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

open _root_.SheafOfModules in
/-- An epimorphism onto `M` from a free sheaf of modules induces one onto every tensor power of
`M`, from a free sheaf of modules on an index type which is finite as soon as the given one is. -/
theorem exists_epi_free_tensorPower
    {M : _root_.SheafOfModules.{w} (toRingCat J Osharp)} (I : Type w)
    {p : free (R := toRingCat J Osharp) I ⟶ M} (hp : Epi p) (n : ℕ) :
    ∃ (K : Type w) (g : free (R := toRingCat J Osharp) K ⟶
      _root_.SheafOfModules.tensorPower J M n), Epi g ∧ (Finite I → Finite K) := by
  induction n with
  | zero =>
    exact ⟨PUnit.{w + 1},
      (Limits.coproductUniqueIso
        (fun _ : PUnit.{w + 1} => _root_.SheafOfModules.unit (toRingCat J Osharp))).hom,
      inferInstanceAs (Epi (Limits.coproductUniqueIso
        (fun _ : PUnit.{w + 1} => _root_.SheafOfModules.unit (toRingCat J Osharp))).hom),
      fun _ => inferInstanceAs (Finite PUnit.{w + 1})⟩
  | succ m ih =>
    match m, ih with
    | 0, _ => exact ⟨I, p, hp, id⟩
    | (m + 1), ih =>
      obtain ⟨K, g, hg, hK⟩ := ih
      have := hp
      have := hg
      refine ⟨I × K, (freeTensorFreeIsoRight J I K).inv ≫
          (tensorSheafRight J (free (R := toRingCat J Osharp) K)).map p ≫
            tensorSheafRightMapLeft J M g,
        epi_comp' (IsIso.epi_of_iso _) (epi_comp' ((tensorSheafRight J _).map_epi p)
          ((tensorSheafLeft J M).map_epi g)), fun h => ?_⟩
      have := hK h
      exact inferInstanceAs (Finite (I × K))

/-- Generating sections of `M` give generating sections of every tensor power of `M`, finitely
many when the given ones are finitely many. -/
theorem exists_generatingSections_tensorPower
    {M : _root_.SheafOfModules.{w} (toRingCat J Osharp)} (σ : M.GeneratingSections) (n : ℕ) :
    ∃ τ : (_root_.SheafOfModules.tensorPower J M n).GeneratingSections,
      (Finite σ.I → Finite τ.I) := by
  obtain ⟨K, g, hg, hK⟩ := exists_epi_free_tensorPower J σ.I (p := σ.π) inferInstance n
  have := hg
  exact ⟨(_root_.SheafOfModules.free.generatingSections K).ofEpi g, hK⟩

section Over

variable [∀ U : C, (J.over U).HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  [∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- Generating sections of `F` over an object `U` of the site give generating sections of every
tensor power of `F` over that same `U`, finitely many when the given ones are finitely many. -/
theorem exists_generatingSections_tensorPower_over (U : C)
    {F : _root_.SheafOfModules.{w} (toRingCat J Osharp)} (σ : (F.over U).GeneratingSections)
    (n : ℕ) :
    ∃ τ : ((_root_.SheafOfModules.tensorPower J F n).over U).GeneratingSections,
      (Finite σ.I → Finite τ.I) := by
  obtain ⟨τ, hτ⟩ :=
    exists_generatingSections_tensorPower (J.over U) (Osharp := Osharp.over U) σ n
  exact ⟨(_root_.SheafOfModules.GeneratingSections.equivOfIso (tensorPowerOverIso F U n)) τ, hτ⟩

end Over

end Site

/-! ### Clauses (1) and (2) of Tag 01CK for the tensor powers -/

section Conclusion

universe t

variable {X : AlgebraicGeometry.RingedSpace.{t, t}}
  (F : _root_.SheafOfModules.{t} (structureSheafRing X))
  (A : _root_.SheafOfModules.TensorExteriorSymmetricAlgebras
    (Opens.grothendieckTopology X.carrier) F)

/-- Generating sections of `F` over an open give generating sections of the degree-`n` piece of
the tensor algebra of `F` over that same open, finitely many when the given ones are finitely
many. -/
theorem exists_generatingSections_tensorPiece_over (U : Opens X.carrier)
    (σ : (F.over U).GeneratingSections) (n : ℕ) :
    ∃ τ : ((A.tensor.piece (n : ℤ)).over U).GeneratingSections, (Finite σ.I → Finite τ.I) := by
  obtain ⟨τ, hτ⟩ := exists_generatingSections_tensorPower_over
    (Opens.grothendieckTopology X.carrier) (Osharp := X.sheaf) U σ n
  exact ⟨(_root_.SheafOfModules.GeneratingSections.equivOfIso
    ((_root_.SheafOfModules.overFunctor (structureSheafRing X) U).mapIso
      (A.tensorPieceIso n)).symm) τ, hτ⟩

/-- The local generators of the degree-`n` piece of the tensor algebra of `F` built from local
generators of `F`, on the same covering. -/
noncomputable def localGeneratorsDataTensorPiece
    (q : F.LocalGeneratorsData.{t, t, t, t}) (n : ℕ) :
    (A.tensor.piece (n : ℤ)).LocalGeneratorsData.{t, t, t, t} where
  I := q.I
  X := q.X
  coversTop := q.coversTop
  generators := fun i =>
    (exists_generatingSections_tensorPiece_over F A (q.X i) (q.generators i) n).choose

/-- `Stacks.SheafOfModules.localGeneratorsDataTensorPiece` is of finite type when the given local
generators are. -/
instance localGeneratorsDataTensorPiece_isFiniteType
    (q : F.LocalGeneratorsData.{t, t, t, t}) (n : ℕ) [h : q.IsFiniteType] :
    (localGeneratorsDataTensorPiece F A q n).IsFiniteType where
  isFiniteType i :=
    have hfin : Finite (q.generators i).I := (h.isFiniteType i).finite
    ⟨(exists_generatingSections_tensorPiece_over F A (q.X i)
      (q.generators i) n).choose_spec hfin⟩

/-- Each tensor power of a sheaf of modules locally generated by sections on a ringed space is
locally generated by sections, on the same covering. -/
@[stacks 01CK "tensor powers of a module locally generated by sections"]
theorem nonempty_localGeneratorsData_tensorPower
    (hF : Nonempty (F.LocalGeneratorsData.{t, t, t, t})) (n : ℕ) :
    Nonempty ((A.tensor.piece (n : ℤ)).LocalGeneratorsData.{t, t, t, t}) :=
  ⟨localGeneratorsDataTensorPiece F A hF.some n⟩

/-- Each tensor power of a sheaf of modules of finite type on a ringed space is of finite
type. -/
@[stacks 01CK "tensor powers of a module of finite type"]
theorem isFiniteType_tensorPower [hF : _root_.SheafOfModules.IsFiniteType.{t, t, t} F] (n : ℕ) :
    _root_.SheafOfModules.IsFiniteType.{t, t, t} (A.tensor.piece (n : ℤ)) := by
  obtain ⟨q, hq⟩ := _root_.SheafOfModules.IsFiniteType.exists_localGeneratorsData F
  exact ⟨localGeneratorsDataTensorPiece F A q n,
    localGeneratorsDataTensorPiece_isFiniteType F A q n (h := hq)⟩

end Conclusion

end Stacks.SheafOfModules

end
