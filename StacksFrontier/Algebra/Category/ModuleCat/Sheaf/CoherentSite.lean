theorem isFiniteType_kernel_over_of_isCoherent {M : SheafOfModules.{t} R} [IsCoherent M]
    (U : C) {K : SheafOfModules.{t} (R.over U)} (hK : K.IsFiniteType) (f : K ⟶ M.over U) :
