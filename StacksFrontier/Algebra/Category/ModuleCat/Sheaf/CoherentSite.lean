/-- The local step of `isFiniteType_kernel_over_of_isCoherent`. -/
theorem isFiniteType_kernel_over_aux {M : SheafOfModules.{t} R} [IsCoherent M]
    (U : C) {K : SheafOfModules.{t} (R.over U)} (f : K ⟶ M.over U) (Z : Over U)
    (σ : (K.over Z).GeneratingSections) [Finite σ.I] :
    ((kernel f).over Z).IsFiniteType :=
  have key : (kernel (f.over Z)).IsFiniteType :=
    isFiniteType_kernel_overOver U Z σ (f.over Z) fun _ σ' hσ' g =>
      have := hσ'
      isFiniteType_kernel_of_generatingSections Z.left σ' g
  isFiniteType_of_iso (overKernelIso f Z).symm key

