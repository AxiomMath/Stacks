/-- **The slice-local step, once and for all.** The kernel of a morphism into `(M.over U).over Z`
out of a sheaf of modules with finitely many generating sections is of finite type as soon as
the same holds for morphisms into `M.over Z.left`.

This is the transport along `overOverEquivalence U Z` that every coherence argument on a slice
site needs, isolated so that it is performed once. -/
theorem isFiniteType_kernel_overOver {M : SheafOfModules.{t} R} (U : C) (Z : Over U)
    {N : SheafOfModules.{t} ((R.over U).over Z)} (σ : N.GeneratingSections) [Finite σ.I]
    (φ : N ⟶ (M.over U).over Z)
    (hZ : ∀ (N' : SheafOfModules.{t} (R.over Z.left)) (σ' : N'.GeneratingSections),
      Finite σ'.I → ∀ g : N' ⟶ M.over Z.left, (kernel g).IsFiniteType) :
    (kernel φ).IsFiniteType := by
  let e := overOverEquivalence (R := R) U Z
  have h3 : (kernel (e.inverse.map φ)).IsFiniteType := by
    have hfin : Finite (σ.map e.inverse (Iso.refl (unit (R.over Z.left)))).I :=
      inferInstanceAs (Finite σ.I)
    have h2 := hZ _ (σ.map e.inverse (Iso.refl (unit (R.over Z.left)))) hfin
      (e.inverse.map φ ≫ (overOverIso M U Z).hom)
    exact isFiniteType_of_iso
      (M := kernel (e.inverse.map φ ≫ (overOverIso M U Z).hom))
      (N := kernel (e.inverse.map φ))
      (kernel.mapIso _ (e.inverse.map φ) (Iso.refl _) (overOverIso M U Z).symm (by simp)) h2
  have h4 : (e.inverse.obj (kernel φ)).IsFiniteType :=
    isFiniteType_of_iso (PreservesKernel.iso e.inverse φ).symm h3
  exact isFiniteType_of_overOverEquivalence_inverse U Z h4

