/-- **Coherence is local on the base, over an arbitrary site.** A sheaf of modules whose
restriction to each member of a covering family of the terminal object is coherent is coherent.

Both conditions of Stacks 01BV are checked by gluing: finite type by
`LocalKernel.isFiniteType_of_coversTop` on the base, and the kernel condition over an object `U`
by the same gluing on the slice site at
`U`, over the covering family of those objects of `Over U` that admit a morphism to a member of
the given covering family. -/
theorem isCoherent_of_coversTop (M : SheafOfModules.{t} R) {I : Type u} (V : I → C)
    (hV : J.CoversTop V) (hM : ∀ i, IsCoherent (M.over (V i))) : IsCoherent M where
  isFiniteType := LocalKernel.isFiniteType_of_coversTop M V hV fun i => (hM i).isFiniteType
  kernel_isFiniteType U A hA φ := by
    have := hA
    have hcover : (J.over U).CoversTop
        (Subtype.val : { Z : Over U // ((kernel φ).over Z).IsFiniteType } → Over U) := by
      intro Y
      refine (J.over U).superset_covering ?_
        ((Over.forget U).cover_lift (J.over U) J (hV Y.left))
      intro Z g hg
      obtain ⟨i, ⟨h⟩⟩ := (Sieve.mem_ofObjects_iff _ ((Over.forget U).map g)).1 hg
      have := hM i
      exact (Sieve.mem_ofObjects_iff _ g).2
        ⟨⟨Z, isFiniteType_kernel_over_of_hom U φ Z h⟩, ⟨𝟙 Z⟩⟩
    exact LocalKernel.isFiniteType_of_coversTop (kernel φ) Subtype.val hcover fun i => i.2

omit [HasBinaryProducts C]
  [HasSheafify J AddCommGrpCat.{t}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- Coherence is *equivalent* to coherence of the restrictions to the members of a covering
family: nothing is lost by checking coherence locally. -/
theorem isCoherent_iff_forall_isCoherent_over {M : SheafOfModules.{t} R} {I : Type u}
    (V : I → C) (hV : J.CoversTop V) :
    IsCoherent M ↔ ∀ i, IsCoherent (M.over (V i)) :=
  ⟨fun h i => have := h; isCoherent_over (V i), isCoherent_of_coversTop M V hV⟩

omit [HasBinaryProducts C]
  [HasSheafify J AddCommGrpCat.{t}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- **A sheaf of modules that is locally a finite type subsheaf of a coherent sheaf of modules is
coherent.** This is Stacks 01BY (1) in the local form in which the proofs of Stacks 01CK and
01CQ invoke it, now over an arbitrary site. -/
theorem isCoherent_of_coversTop_of_mono (M : SheafOfModules.{t} R) {I : Type u} (V : I → C)
    (hV : J.CoversTop V) (P : I → SheafOfModules.{t} R) (hP : ∀ i, IsCoherent (P i))
    (hft : ∀ i, (M.over (V i)).IsFiniteType)
    (ι : ∀ i, M.over (V i) ⟶ (P i).over (V i)) (hι : ∀ i, Mono (ι i)) : IsCoherent M :=
  isCoherent_of_coversTop M V hV fun i =>
    have := hP i
    have := hι i
    have : IsCoherent ((P i).over (V i)) := isCoherent_over (V i)
    isCoherent_of_mono (ι i) (hft i)

end Closure

/-! ### Comparison with the space-level coherence predicates -/

section Space

variable {X : Type u} [TopologicalSpace X]
  {R : Sheaf (Opens.grothendieckTopology X) RingCat.{u}}

/-- **The site-level predicate supersedes the space-level one.** On the site of opens of a
topological space `IsCoherent` is `Stacks.SheafOfModules.IsCoherent`: the two classes have
literally the same two fields, so the comparison is field-by-field. -/
theorem isCoherent_iff_isCoherent_opens {M : SheafOfModules.{u} R} :
    IsCoherent.{u, u, u} M ↔ Stacks.SheafOfModules.IsCoherent M := by
  refine ⟨fun h => ⟨h.1, h.2⟩, fun h => ?_⟩
  constructor
  · exact h.1
  · exact h.2

/-- **`IsCoherentOn M W` is coherence on the slice site at `W`.** This is the identification that
the implementation notes of
`StacksFrontier.Algebra.Category.ModuleCat.Sheaf.CoherenceClosure` describe as the structurally
better fix, and it is what makes the slice-local step of a Section 17.21 coherence proof free:
a local description of `M` on `W` is a statement about `M.over W` on the site `Over W`, and the
closure theory above applies to it verbatim.

The forward direction is the transport `isFiniteType_kernel_overOver` along
`overOverEquivalence W Z`; the backward direction is the same transport read through the functor
of that equivalence, `isFiniteType_kernel_of_generatingSections_overOver`. -/
theorem isCoherentOn_iff_isCoherent_over {M : SheafOfModules.{u} R} (W : Opens X) :
    Stacks.SheafOfModules.IsCoherentOn M W ↔ IsCoherent.{u, u, u} (M.over W) := by
  constructor
  · intro hW
    constructor
    · exact (hW W le_rfl).1
    intro Z A hA φ
    have := hA
    have hfin : Finite (free.generatingSections (R := (R.over W).over Z) A).I :=
      inferInstanceAs (Finite A)
    exact isFiniteType_kernel_overOver W Z (free.generatingSections A) φ
      fun N' σ' hσ' g => (hW Z.left (leOfHom Z.hom)).2 N' σ' hσ' g
  · intro hW W' hW'
    have := hW
    refine ⟨?_, fun N σ hσ g => ?_⟩
    · have h1 : ((M.over W).over (Over.mk (homOfLE hW'))).IsFiniteType :=
        isFiniteType_over_of_isFiniteType (Over.mk (homOfLE hW')) IsCoherent.isFiniteType
      have h2 := isFiniteType_overOverEquivalence_inverse_obj W (Over.mk (homOfLE hW')) h1
      exact isFiniteType_of_iso.{u, u, u} (overOverIso M W (Over.mk (homOfLE hW'))) h2
    · have := hσ
      exact isFiniteType_kernel_of_generatingSections_overOver W
        (Over.mk (homOfLE hW')) σ g

/-- **Coherence is local on the base, in the form the Section 17.21 proofs need it.** A sheaf of
modules on a ringed space whose restriction to each member of an open covering is coherent on the
corresponding slice site is coherent, for the space-level predicate of
`StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Coherent`. -/
theorem isCoherent_opens_of_coversTop (M : SheafOfModules.{u} R) {I : Type u} (V : I → Opens X)
    (hV : (Opens.grothendieckTopology X).CoversTop V)
    (hM : ∀ i, IsCoherent.{u, u, u} (M.over (V i))) : Stacks.SheafOfModules.IsCoherent M :=
  isCoherent_iff_isCoherent_opens.1 (isCoherent_of_coversTop M V hV hM)

/-- The restriction of a coherent sheaf of modules on a ringed space to an open is coherent on
the slice site at that open. -/
theorem isCoherent_over_of_isCoherent_opens {M : SheafOfModules.{u} R}
    (hM : Stacks.SheafOfModules.IsCoherent M) (W : Opens X) : IsCoherent.{u, u, u} (M.over W) :=
  have := isCoherent_iff_isCoherent_opens.2 hM
  isCoherent_over W

/-- **A sheaf of modules that is locally the cokernel of a map between finite direct sums of
copies of a coherent sheaf of modules is coherent.**

This is the shape in which Stacks Section 17.21 ends the proofs of 01CE and 01CK: a finite
presentation of one factor presents the tensor product, or a power, locally as such a cokernel,
and the conclusion "and the result for coherent sheaves then follows from Lemma 01BY" is this
lemma. It is the cokernel counterpart of
`Stacks.SheafOfModules.isCoherent_of_locallyKernelFiniteCoproduct`, which is the second
assertion of 01CQ. -/
theorem isCoherent_opens_of_locallyCokernelFiniteCoproduct {M G : SheafOfModules.{u} R}
    (hG : Stacks.SheafOfModules.IsCoherent G)
    (h : ∀ x : X, ∃ U : Opens X, x ∈ U ∧ ∃ (m n : ℕ)
      (f : (∐ fun _ : Fin m => G.over U) ⟶ (∐ fun _ : Fin n => G.over U)),
        Nonempty (M.over U ≅ cokernel f)) :
    Stacks.SheafOfModules.IsCoherent M := by
  choose U hU m n f ε using h
  have hV : (Opens.grothendieckTopology X).CoversTop U := by
    refine (Opens.coversTop_iff X U).2 (TopologicalSpace.IsOpenCover.mk ?_)
    ext y
    simpa using ⟨y, hU y⟩
  refine isCoherent_opens_of_coversTop M U hV fun x => ?_
  have hGx : IsCoherent.{u, u, u} (G.over (U x)) := isCoherent_over_of_isCoherent_opens hG (U x)
  have hm : IsCoherent.{u, u, u} (∐ fun _ : Fin (m x) => G.over (U x)) :=
    isCoherent_sigma (R := R.over (U x)) _ fun _ => hGx
  have hn : IsCoherent.{u, u, u} (∐ fun _ : Fin (n x) => G.over (U x)) :=
    isCoherent_sigma (R := R.over (U x)) _ fun _ => hGx
  have hck : IsCoherent.{u, u, u} (cokernel (f x)) := isCoherent_cokernel (R := R.over (U x)) _
  exact isCoherent_of_iso (R := R.over (U x)) (ε x).some.symm

end Space

end Stacks.SheafOfModules.Site

end
