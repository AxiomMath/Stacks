@[expose] public section

open CategoryTheory Limits Opposite TopologicalSpace SheafOfModules ZeroObject

universe t v u v' u'

namespace Stacks.SheafOfModules.Site

/-! ### Transport of finite type along an equivalence of sites -/

section Transport

variable {C : Type u} [Category.{v} C] {D : Type u'} [Category.{v'} D]
  {J : GrothendieckTopology C} {K : GrothendieckTopology D}
  {R : Sheaf J RingCat.{t}} {S : Sheaf K RingCat.{t}}
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ Y : D, HasSheafify (K.over Y) AddCommGrpCat.{t}]
  [∀ Y : D, (K.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]

/-- Local generators of a sheaf of modules, pushed forward along a continuous and cocontinuous
functor of sites: the covering family is the family of all objects of the source site admitting
a morphism into a member of the original covering family, and the generators are the original
generators restricted along that morphism. -/
noncomputable def localGeneratorsDataPushforward
    (G : D ⥤ C) [G.IsContinuous K J] [G.IsCocontinuous K J]
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{t} K J).obj R)
    (η : (SheafOfModules.pushforward φ).obj (unit R) ≅ unit S)
    [∀ Y : D, (Over.post G (X := Y)).IsContinuous (K.over Y) (J.over _)]
    (h : ∀ (Y : D) (Z : C) (f : G.obj Y ⟶ Z),
      PreservesColimitsOfSize.{t, t} <|
      SheafOfModules.pushforward.{t} (R := R.over Z)
        (F := Over.post (X := Y) G ⋙ Over.map f)
        (((Over.forget Y).sheafPushforwardContinuous RingCat.{t} (K.over Y) K).map φ))
    {M : SheafOfModules.{t} R} (P : M.LocalGeneratorsData) :
    ((SheafOfModules.pushforward φ).obj M).LocalGeneratorsData where
  I := Σ (Y : D) (i : P.I), G.obj Y ⟶ P.X i
  X i := i.1
  coversTop Y := by
    refine K.superset_covering ?_ <| G.cover_lift K _ (P.coversTop (G.obj Y))
    intro Z g ⟨i, ⟨v⟩⟩
    exact ⟨⟨Z, i, v⟩, ⟨𝟙 _⟩⟩
  generators i := by
    letI overS : SheafOfModules.{t} S ⥤ SheafOfModules.{t} (S.over i.1) :=
      SheafOfModules.pushforward (𝟙 _)
    letI G' := Over.post (X := i.1) G ⋙ Over.map i.2.2
    letI ψ : S.over i.1 ⟶
        (G'.sheafPushforwardContinuous RingCat.{t} (K.over i.1) (J.over (P.X i.2.1))).obj
          (R.over (P.X i.2.1)) :=
      ((Over.forget i.1).sheafPushforwardContinuous RingCat.{t} (K.over i.1) K).map φ
    letI e : (SheafOfModules.pushforward ψ).obj (unit (R.over (P.X i.2.1))) ≅
        unit (S.over i.1) := overS.mapIso η
    haveI : PreservesColimitsOfSize.{t, t, _} (SheafOfModules.pushforward ψ) := h _ _ _
    exact (P.generators i.2.1).map (SheafOfModules.pushforward ψ) e.symm

/-- Gluing the pushed-forward generators keeps them finite. -/
lemma localGeneratorsDataPushforward_isFiniteType
    (G : D ⥤ C) [G.IsContinuous K J] [G.IsCocontinuous K J]
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{t} K J).obj R)
    (η : (SheafOfModules.pushforward φ).obj (unit R) ≅ unit S)
    [∀ Y : D, (Over.post G (X := Y)).IsContinuous (K.over Y) (J.over _)]
    (h : ∀ (Y : D) (Z : C) (f : G.obj Y ⟶ Z),
      PreservesColimitsOfSize.{t, t} <|
      SheafOfModules.pushforward.{t} (R := R.over Z)
        (F := Over.post (X := Y) G ⋙ Over.map f)
        (((Over.forget Y).sheafPushforwardContinuous RingCat.{t} (K.over Y) K).map φ))
    {M : SheafOfModules.{t} R} (P : M.LocalGeneratorsData) [P.IsFiniteType] :
    (localGeneratorsDataPushforward G φ η h P).IsFiniteType where
  isFiniteType := by
    rintro ⟨Y, j, f⟩
    have : (P.generators j).IsFiniteType :=
      SheafOfModules.LocalGeneratorsData.IsFiniteType.isFiniteType j
    exact ⟨by change Finite (P.generators j).I; infer_instance⟩

/-- Being of finite type transports along the restriction of sheaves of modules induced by an
equivalence of sites. -/
theorem isFiniteType_pushforward [HasPullbacks C] [HasPullbacks D]
    (G : D ⥤ C) [G.IsContinuous K J] [G.IsCocontinuous K J] [G.IsLeftAdjoint] [G.IsEquivalence]
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{t} K J).obj R) [IsIso φ]
    (η : (SheafOfModules.pushforward φ).obj (unit R) ≅ unit S)
    {M : SheafOfModules.{t} R} [M.IsFiniteType] :
    ((SheafOfModules.pushforward φ).obj M).IsFiniteType := by
  classical
  have (Y : D) : (Over.post (X := Y) G).IsContinuous (K.over Y) (J.over _) :=
    (Functor.isContinuous_iff_coverPreserving).2
      ((CoverPreserving.of_isContinuous G K J).overPost Y)
  obtain ⟨P, hP⟩ := SheafOfModules.IsFiniteType.exists_localGeneratorsData M
  have h : ∀ (Y : D) (Z : C) (f : G.obj Y ⟶ Z),
      PreservesColimitsOfSize.{t, t} <|
      SheafOfModules.pushforward.{t} (R := R.over Z)
        (F := Over.post (X := Y) G ⋙ Over.map f)
        (((Over.forget Y).sheafPushforwardContinuous RingCat.{t} (K.over Y) K).map φ) := by
    intro Y Z f
    let G' := Over.post (X := Y) G ⋙ Over.map f
    have : G'.IsContinuous (K.over Y) (J.over Z) :=
      Functor.isContinuous_comp _ _ _ (J.over _) _
    have : G'.IsCocontinuous (K.over Y) (J.over Z) := isCocontinuous_comp _ _ _ (J.over _)
    let a : S.over Y ⟶
        (G'.sheafPushforwardContinuous RingCat.{t} (K.over Y) (J.over Z)).obj (R.over Z) :=
      ((Over.forget Y).sheafPushforwardContinuous RingCat.{t} (K.over Y) K).map φ
    have : IsIso a := by dsimp only [a]; apply Functor.map_isIso
    have : (Over.post (X := Y) G).IsLeftAdjoint := inferInstance
    have : (Over.map f).IsLeftAdjoint := inferInstance
    have : G'.IsLeftAdjoint := by dsimp [G']; infer_instance
    have : (SheafOfModules.pushforward a).IsLeftAdjoint :=
      SheafOfModules.isLeftAdjoint_pushforward_of_isIso a
    infer_instance
  have hQ : (localGeneratorsDataPushforward G φ η h P).IsFiniteType :=
    have : P.IsFiniteType := hP
    localGeneratorsDataPushforward_isFiniteType G φ η h P
  refine { exists_localGeneratorsData := ?_ }
  exact Exists.intro (localGeneratorsDataPushforward G φ η h P).shrink
    ⟨fun i => hQ.isFiniteType i.2.choose⟩

end Transport

/-! ### Restriction to an object of the site -/

section Restriction

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}

/-- Restriction to an object of the site preserves monomorphisms: on sections it is a
reindexing, so it preserves injectivity. -/
theorem over_mono {M N : SheafOfModules.{t} R} (p : M ⟶ N) [Mono p] (U : C) :
    Mono (p.over U) := by
  refine (SheafOfModules.forget (R.over U)).mono_of_mono_map (f := p.over U) ?_
  apply PresheafOfModules.mono_of_injective
  intro V
  exact PresheafOfModules.injective_of_mono ((SheafOfModules.forget R).map p) _

/-- A sheaf of modules is of finite type if the objects over which its restriction is generated by
finitely many sections cover the site. -/
private theorem isFiniteType_of_coversTop_generatingSections
    [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
    [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}] {M : SheafOfModules.{t} R}
    (hcover : J.CoversTop (Subtype.val :
      { V : C // ∃ ρ : (M.over V).GeneratingSections, Finite ρ.I } → C)) : M.IsFiniteType := by
  refine { exists_localGeneratorsData := ?_ }
  exact Exists.intro
    { I := { V : C // ∃ ρ : (M.over V).GeneratingSections, Finite ρ.I }
      X := Subtype.val
      coversTop := hcover
      generators := fun i => i.2.choose } ⟨fun i => ⟨i.2.choose_spec⟩⟩

section Sheafify

variable [HasBinaryProducts C]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]

omit [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- Restriction to an object of the site preserves zero objects. -/
theorem over_isZero {M : SheafOfModules.{t} R} (hM : IsZero M) (U : C) :
    IsZero (M.over U) :=
  Functor.map_isZero (SheafOfModules.pushforward.{t} (𝟙 (R.over U))) hM

/-- Being of finite type is invariant under isomorphism. -/
theorem isFiniteType_of_iso {M N : SheafOfModules.{t} R} (e : M ≅ N) (hM : M.IsFiniteType) :
    N.IsFiniteType :=
  isFiniteType_of_epi e.hom hM

variable [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]

/-- A sheaf of modules generated by finitely many global sections is of finite type: the
trivial covering of the site witnesses it. -/
theorem isFiniteType_of_generatingSections {M : SheafOfModules.{t} R}
    (G : M.GeneratingSections) [G.IsFiniteType] : M.IsFiniteType :=
  by refine { exists_localGeneratorsData := ?_ }
     exact Exists.intro G.localGeneratorsData
       { isFiniteType := fun _ => ⟨inferInstanceAs (Finite G.I)⟩ }

/-- The empty family generates a zero sheaf of modules. -/
noncomputable def zeroGeneratingSections {M : SheafOfModules.{t} R} (hM : IsZero M) :
    M.GeneratingSections where
  I := PEmpty.{t + 1}
  s := fun x => x.elim
  epi := ⟨fun g h _ => hM.eq_of_src g h⟩

/-- The empty family of generating sections of a zero sheaf of modules is finite. -/
instance {M : SheafOfModules.{t} R} (hM : IsZero M) :
    (zeroGeneratingSections hM).IsFiniteType where
  finite := inferInstanceAs (Finite PEmpty.{t + 1})

/-- A zero sheaf of modules is of finite type. -/
theorem isFiniteType_of_isZero {M : SheafOfModules.{t} R} (hM : IsZero M) : M.IsFiniteType :=
  isFiniteType_of_generatingSections (zeroGeneratingSections hM)

/-- Restriction to an object of the site preserves kernels. -/
noncomputable def overKernelIso {M N : SheafOfModules.{t} R} (φ : M ⟶ N) (V : C) :
    (kernel φ).over V ≅ kernel (φ.over V) :=
  PreservesKernel.iso (overFunctor.{t} R V) φ

/-- A kernel fork restricts to a kernel fork: restriction to an object of the site is additive
and preserves kernels. -/
noncomputable def isLimitKernelForkOver {M N P : SheafOfModules.{t} R} {f : M ⟶ N} {g : N ⟶ P}
    {hfg : f ≫ g = 0} (hf : IsLimit (KernelFork.ofι f hfg)) (V : C) :
    IsLimit (KernelFork.ofι (f.over V)
      (show (f.over V) ≫ (g.over V) = 0 by
        rw [← Functor.map_comp, hfg, Functor.map_zero])) :=
  KernelFork.mapIsLimit _ hf (overFunctor.{t} R V)

/-- Restriction to an object of the site preserves short exact sequences. -/
private theorem shortExact_over {S : ShortComplex (SheafOfModules.{t} R)} (hS : S.ShortExact)
    (V : C) : (ShortComplex.mk (S.f.over V) (S.g.over V)
      (by rw [← Functor.map_comp, S.zero, Functor.map_zero])).ShortExact :=
  have := hS.mono_f
  have := hS.epi_g
  { exact := ShortComplex.exact_of_f_is_kernel _
      (isLimitKernelForkOver (hfg := S.zero) hS.fIsKernel V)
    mono_f := over_mono S.f V
    epi_g := LocalKernel.over_epi S.g V }

/-- If the kernel of `p ≫ f` is of finite type and `p` is an epimorphism, then the kernel of
`f` is of finite type: it is the image of the former under the induced morphism. -/
theorem isFiniteType_kernel_of_epi_comp {M N P : SheafOfModules.{t} R} (p : M ⟶ N) [Epi p]
    (f : N ⟶ P) (h : (kernel (p ≫ f)).IsFiniteType) : (kernel f).IsFiniteType := by
  let km := kernel.map (p ≫ f) f p (𝟙 _) (by simp)
  have : Epi km := epi_kernelMap_of_epi p f
  exact isFiniteType_of_epi km h

end Sheafify

end Restriction

/-! ### The iterated slice site -/

section IteratedSlice

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}

/-- The equivalence between sheaves of modules on the slice site of `C` at `Z.left` and sheaves
of modules on the slice site of the slice site of `C` at `U` at `Z`, induced by
`Over.iteratedSliceEquiv`. -/
noncomputable def overOverEquivalence (U : C) (Z : Over U) :
    SheafOfModules.{t} (R.over Z.left) ≌ SheafOfModules.{t} ((R.over U).over Z) :=
  SheafOfModules.pushforwardPushforwardEquivalence (Over.iteratedSliceEquiv Z)
    (S := (R.over U).over Z) (R := R.over Z.left) (𝟙 _) (𝟙 _)
    (by ext : 2; exact R.1.map_id _) (by ext : 2; exact R.1.map_id _)

/-- Restricting `M` first to `U` and then to `Z` is restricting it to `Z.left`, read through
`overOverEquivalence`. -/
noncomputable def overOverIso (M : SheafOfModules.{t} R) (U : C) (Z : Over U) :
    (overOverEquivalence U Z (R := R)).inverse.obj ((M.over U).over Z) ≅ M.over Z.left :=
  (overOverEquivalence U Z).fullyFaithfulFunctor.preimageIso
    ((overOverEquivalence U Z).counitIso.app ((M.over U).over Z))

variable [HasFiniteWidePullbacks C]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), HasSheafify ((J.over Y).over Z) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), ((J.over Y).over Z).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}]

omit [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- Being of finite type transports from the slice site at `Z.left` to the iterated slice site
at `Z`. -/
theorem isFiniteType_of_overOverEquivalence_inverse (U : C) (Z : Over U)
    {N : SheafOfModules.{t} ((R.over U).over Z)}
    (h : ((overOverEquivalence U Z (R := R)).inverse.obj N).IsFiniteType) : N.IsFiniteType := by
  have := h
  have h2 : ((overOverEquivalence U Z (R := R)).functor.obj
      ((overOverEquivalence U Z (R := R)).inverse.obj N)).IsFiniteType :=
    isFiniteType_pushforward (G := (Over.iteratedSliceEquiv Z).functor) (𝟙 _) (Iso.refl _)
  have h3 : (((overOverEquivalence U Z (R := R)).inverse ⋙
      (overOverEquivalence U Z (R := R)).functor).obj N).IsFiniteType := h2
  exact isFiniteType_of_iso ((overOverEquivalence U Z (R := R)).counitIso.app N) h3

omit [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- Being of finite type transports from the iterated slice site at `Z` down to the slice site
at `Z.left`. -/
theorem isFiniteType_overOverEquivalence_inverse_obj (U : C) (Z : Over U)
    {N : SheafOfModules.{t} ((R.over U).over Z)} (h : N.IsFiniteType) :
    ((overOverEquivalence U Z (R := R)).inverse.obj N).IsFiniteType :=
  have := h
  isFiniteType_pushforward (G := (Over.iteratedSliceEquiv Z).inverse) (𝟙 _) (Iso.refl _)

/-- Finitely many generating sections of `M.over Z.left` are finitely many generating sections of
`(M.over U).over Z`, read through `overOverEquivalence`. -/
noncomputable def generatingSectionsOverOver (M : SheafOfModules.{t} R) (U : C) (Z : Over U)
    (ρ : (M.over Z.left).GeneratingSections) : ((M.over U).over Z).GeneratingSections :=
  ρ.map (overOverEquivalence U Z).functor (Iso.refl _)

/-- `generatingSectionsOverOver M U Z ρ` is indexed by a finite type when `ρ` is. -/
instance finite_generatingSectionsOverOver (M : SheafOfModules.{t} R) (U : C) (Z : Over U)
    (ρ : (M.over Z.left).GeneratingSections) [Finite ρ.I] :
    Finite (generatingSectionsOverOver M U Z ρ).I :=
  inferInstanceAs (Finite ρ.I)

variable [HasBinaryProducts C] [HasPullbacks C]
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]

omit [HasFiniteWidePullbacks C] [HasBinaryProducts C]
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- **Restriction to an object of the site preserves being of finite type.** The covering family
witnessing it consists of all objects of the slice site over which the restriction is generated
by finitely many sections; cocontinuity of `Over.forget U` lifts the original covering family of
the base to one of the slice site. -/
theorem isFiniteType_over_of_isFiniteType (U : C) {M : SheafOfModules.{t} R}
    (hM : M.IsFiniteType) : (M.over U).IsFiniteType := by
  classical
  obtain ⟨σ, hσ⟩ := hM.exists_localGeneratorsData
  have hcover : (J.over U).CoversTop (Subtype.val :
      { Z : Over U // ∃ ρ : ((M.over U).over Z).GeneratingSections, Finite ρ.I } → Over U) := by
    intro Y
    refine (J.over U).superset_covering ?_
      ((Over.forget U).cover_lift (J.over U) J (σ.coversTop Y.left))
    intro Z g hg
    obtain ⟨i, ⟨h⟩⟩ := (Sieve.mem_ofObjects_iff _ ((Over.forget U).map g)).1 hg
    have hfin : Finite (σ.generators i).I := (hσ.isFiniteType i).finite
    refine (Sieve.mem_ofObjects_iff _ g).2 ⟨⟨Z, ?_⟩, ⟨𝟙 Z⟩⟩
    exact ⟨generatingSectionsOverOver M U Z
      (generatingSectionsOfEpi (restrictFreeHom h (σ.generators i).π)), inferInstance⟩
  exact isFiniteType_of_coversTop_generatingSections hcover

end IteratedSlice

/-! ### Finite type is closed under extensions over a site -/

section Extension

variable {C : Type u} [Category.{v} C] [HasFiniteWidePullbacks C] [HasBinaryProducts C]
  [HasPullbacks C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]

omit [HasFiniteWidePullbacks C] [HasPullbacks C] in
/-- Over an object carrying finitely many generating sections of `S.X₁` together with lifts of
the generating sections of `S.X₃`, the middle term of a short exact sequence is generated by
finitely many sections. -/
lemma exists_generatingSections_X₂ {S : ShortComplex (SheafOfModules.{t} R)} (hS : S.ShortExact)
    (τ : S.X₃.GeneratingSections) [Finite τ.I] (V : C) {A : Type t} [Finite A]
    (p : free A ⟶ S.X₁.over V) [Epi p]
    (υ : τ.I → (unit (R.over V) ⟶ S.X₂.over V))
    (hυ : ∀ k, υ k ≫ S.g.over V =
      (show unit (R.over V) ⟶ S.X₃.over V from (ιFree k ≫ τ.π).over V)) :
    ∃ ρ : (S.X₂.over V).GeneratingSections, Finite ρ.I := by
  have hb : FiniteTypeKernel.betaOf (R := R) V υ ≫ S.g.over V =
      (mapFreeIso (overFunctor R V) τ.I (FiniteTypeKernel.unitOverIso V)).hom ≫ (τ.π).over V :=
    FiniteTypeKernel.betaOf_spec S.g V τ.π υ hυ
  have : Epi ((τ.π).over V) := LocalKernel.over_epi _ V
  have : Epi (FiniteTypeKernel.betaOf (R := R) V υ ≫ S.g.over V) := by
    rw [hb]; infer_instance
  have : Epi (freeSumHom (p ≫ S.f.over V) (FiniteTypeKernel.betaOf (R := R) V υ)) :=
    epi_freeSumHom (isColimitCokernelCoforkOver hS.gIsCokernel V) p _
  exact ⟨generatingSectionsOfEpi
    (freeSumHom (p ≫ S.f.over V) (FiniteTypeKernel.betaOf (R := R) V υ)),
    inferInstanceAs (Finite (A ⊕ τ.I))⟩

omit [HasFiniteWidePullbacks C] in
/-- **Stacks Project, Tag 01B7, second assertion, over an arbitrary site** in the case where the
quotient is generated by finitely many global sections: the middle term of a short exact
sequence whose first term is of finite type and whose third term is generated by finitely many
global sections is of finite type. -/
theorem isFiniteType_X₂_of_generatingSections {S : ShortComplex (SheafOfModules.{t} R)}
    (hS : S.ShortExact) (h₁ : S.X₁.IsFiniteType) (τ : S.X₃.GeneratingSections) [Finite τ.I] :
    S.X₂.IsFiniteType := by
  classical
  obtain ⟨σ, hσ⟩ := h₁.exists_localGeneratorsData
  have hepi : Epi S.g := hS.epi_g
  have hcover : J.CoversTop (Subtype.val :
      { V : C // ∃ ρ : (S.X₂.over V).GeneratingSections, Finite ρ.I } → C) := by
    intro Y
    choose T hT hlift using fun k : τ.I =>
      FiniteTypeKernel.exists_lift_over_of_epi S.g (ιFree k ≫ τ.π) Y
    refine J.superset_covering ?_ (J.intersection_covering
      (FiniteTypeKernel.iInf_mem J _ hT) (σ.coversTop Y))
    intro V g hg
    obtain ⟨hg₁, hg₂⟩ := hg
    rw [FiniteTypeKernel.iInf_apply] at hg₁
    obtain ⟨i, ⟨h⟩⟩ := (Sieve.mem_ofObjects_iff _ g).1 hg₂
    choose υ hυ using fun k => hlift k g (hg₁ k)
    have hfin : Finite (σ.generators i).I := (hσ.isFiniteType i).finite
    exact (Sieve.mem_ofObjects_iff _ g).2
      ⟨⟨V, exists_generatingSections_X₂ hS τ V (restrictFreeHom h (σ.generators i).π) υ hυ⟩,
        ⟨𝟙 V⟩⟩
  exact isFiniteType_of_coversTop_generatingSections hcover

omit [HasFiniteWidePullbacks C] in
/-- The pullback of a short exact sequence along a morphism out of a finite free sheaf of modules
is of finite type as soon as the sub-object is: it is an extension of the finite free sheaf by
that sub-object. -/
theorem isFiniteType_pullback_of_shortExact {S : ShortComplex (SheafOfModules.{t} R)}
    (hS : S.ShortExact) (h₁ : S.X₁.IsFiniteType) {I : Type t} [Finite I] (ψ : free I ⟶ S.X₃) :
    (pullback ψ S.g).IsFiniteType := by
  have hepi : Epi S.g := hS.epi_g
  have hmono : Mono S.f := hS.mono_f
  have hw : (0 : S.X₁ ⟶ free I) ≫ ψ = S.f ≫ S.g := by rw [zero_comp, S.zero]
  have hzero : pullback.lift (0 : S.X₁ ⟶ free I) S.f hw ≫ pullback.fst ψ S.g = 0 :=
    pullback.lift_fst _ _ _
  have hT : (ShortComplex.mk (pullback.lift (0 : S.X₁ ⟶ free I) S.f hw)
      (pullback.fst ψ S.g) hzero).ShortExact :=
    { exact := ShortComplex.exact_of_f_is_kernel _
        (isLimitKernelForkPullbackFst ψ S.g hS.fIsKernel _ hzero (pullback.lift_snd _ _ _))
      mono_f := mono_of_mono_fac (pullback.lift_snd (0 : S.X₁ ⟶ free I) S.f hw)
      epi_g := inferInstance }
  have : Finite (free.generatingSections (R := R) I).I := inferInstanceAs (Finite I)
  exact isFiniteType_X₂_of_generatingSections hT h₁ (free.generatingSections I)

variable [∀ (Y : C) (Z : Over Y), HasSheafify ((J.over Y).over Z) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), ((J.over Y).over Z).WEqualsLocallyBijective AddCommGrpCat.{t}]

/-- **Stacks Project, Tag 01B7, second assertion, over an arbitrary site.** The middle term of a
short exact sequence of sheaves of modules whose outer terms are of finite type is of finite
type.

The space-level `isFiniteType_middle_of_shortExact` shrinks an open neighbourhood of a point and
so has no analogue here. Instead the sequence is restricted to each member of a covering family
over which `S.X₃` is generated by finitely many sections; there
`isFiniteType_X₂_of_generatingSections` applies, and `LocalKernel.isFiniteType_of_coversTop`
glues. -/
theorem isFiniteType_X₂_of_shortExact {S : ShortComplex (SheafOfModules.{t} R)}
    (hS : S.ShortExact) (h₁ : S.X₁.IsFiniteType) (h₃ : S.X₃.IsFiniteType) :
    S.X₂.IsFiniteType := by
  obtain ⟨σ, hσ⟩ := h₃.exists_localGeneratorsData
  refine LocalKernel.isFiniteType_of_coversTop S.X₂ σ.X σ.coversTop fun i => ?_
  have hfin : Finite (σ.generators i).I := (hσ.isFiniteType i).finite
  have hX₁ : (S.X₁.over (σ.X i)).IsFiniteType :=
    isFiniteType_over_of_isFiniteType (σ.X i) h₁
  exact isFiniteType_X₂_of_generatingSections (shortExact_over hS (σ.X i)) hX₁ (σ.generators i)

end Extension

/-! ### Coherent sheaves of modules on a site -/

section Coherent

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}
  [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), HasWeakSheafify ((J.over Y).over Z) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), ((J.over Y).over Z).WEqualsLocallyBijective AddCommGrpCat.{t}]

/-- A sheaf of modules `M` on a site is *coherent* if

1. `M` is of finite type, and
2. for every object `U` of the site and every finite index type `I`, the kernel of every
   `R|_U`-module map `free I ⟶ M|_U` — equivalently, of the associated map of every finite
   family of sections of `M` over `U` — is of finite type.

This is the predicate of Stacks 01BV with the site of opens of a topological space replaced by
an arbitrary site. -/
class IsCoherent (M : SheafOfModules.{t} R) : Prop where
  /-- A coherent sheaf of modules is of finite type. -/
  isFiniteType : M.IsFiniteType
  /-- The kernel of the associated map of any finite family of sections over any object of the
  site is of finite type. -/
  kernel_isFiniteType : ∀ (U : C) (I : Type t) (_ : Finite I)
    (φ : (free I : SheafOfModules.{t} (R.over U)) ⟶ M.over U), (kernel φ).IsFiniteType

attribute [instance] IsCoherent.isFiniteType

/-- Coherence as a property of objects of the category of sheaves of modules on a site. -/
abbrev coherentModules (R : Sheaf J RingCat.{t}) : ObjectProperty (SheafOfModules.{t} R) :=
  fun M => IsCoherent M

/-- The full subcategory of coherent sheaves of modules on a site, denoted `Coh(O_X)` in the
source. -/
abbrev CoherentModules (R : Sheaf J RingCat.{t}) := (coherentModules R).FullSubcategory

/-- The underlying sheaf of modules of an object of `CoherentModules R` is coherent. -/
instance (M : CoherentModules R) : IsCoherent M.obj := M.property

end Coherent

/-! ### The closure properties of coherence on a site -/

section Closure

variable {C : Type u} [Category.{v} C] [HasFiniteWidePullbacks C] [HasBinaryProducts C]
  [HasPullbacks C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{t}}
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{t}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), HasSheafify ((J.over Y).over Z) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y), ((J.over Y).over Z).WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}]

omit [HasBinaryProducts C] [HasPullbacks C]
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- A map out of a free module into a subsheaf has the same kernel as its composite into the
ambient sheaf, so finiteness of the latter kernel transfers to the former. -/
theorem isFiniteType_kernel_of_mono {M N : SheafOfModules.{t} R} (ι : N ⟶ M) [Mono ι]
    (U : C) {I : Type t} (φ : (free I : SheafOfModules.{t} (R.over U)) ⟶ N.over U)
    (h : (kernel (φ ≫ ι.over U)).IsFiniteType) : (kernel φ).IsFiniteType :=
  have : Mono (ι.over U) := over_mono ι U
  isFiniteType_of_iso (kernelCompMono φ (ι.over U)) h

omit [HasBinaryProducts C] [HasPullbacks C]
  [HasSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- **Stacks Project, Tag 01BY (1), over a site.** A finite type subsheaf of a coherent sheaf of
modules is coherent. -/
theorem isCoherent_of_mono {M N : SheafOfModules.{t} R} (ι : N ⟶ M) [Mono ι]
    [IsCoherent M] (hN : N.IsFiniteType) : IsCoherent N where
  isFiniteType := hN
  kernel_isFiniteType U I hI φ :=
    isFiniteType_kernel_of_mono ι U φ (IsCoherent.kernel_isFiniteType U I hI (φ ≫ ι.over U))

omit [HasPullbacks C]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    HasSheafify (((J.over Y).over Z).over W) AddCommGrpCat.{t}]
  [∀ (Y : C) (Z : Over Y) (W : Over Z),
    (((J.over Y).over Z).over W).WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- A zero sheaf of modules is coherent: it is of finite type, and every map into its
restriction is zero, so the kernels in question are the finite free modules themselves. -/
theorem isCoherent_of_isZero {M : SheafOfModules.{t} R} (hM : IsZero M) : IsCoherent M where
  isFiniteType := isFiniteType_of_isZero hM
  kernel_isFiniteType U I hI φ := by
    have hφ : φ = 0 := (over_isZero hM U).eq_zero_of_tgt φ
    rw [hφ]
    exact isFiniteType_of_iso
      (M := (free I : SheafOfModules.{t} (R.over U)))
      (N := kernel (0 : (free I : SheafOfModules.{t} (R.over U)) ⟶ M.over U))
      kernelZeroIsoSource.symm (LocalKernel.isFiniteType_free I)

/-- The zero sheaf of modules is coherent. -/
instance : (coherentModules R).ContainsZero where
  exists_zero := ⟨0, isZero_zero _, isCoherent_of_isZero (isZero_zero _)⟩

/-- A sheaf of modules isomorphic to a coherent one is coherent. -/
instance : (coherentModules R).IsClosedUnderIsomorphisms where
  of_iso {M N} e hM :=
    have : IsCoherent M := hM
    isCoherent_of_mono (M := M) (N := N) e.inv (isFiniteType_of_iso e IsCoherent.isFiniteType)

