/-- **Stacks Project, Tag 01BY (2), over a site.** The kernel of a morphism from a sheaf of
modules of finite type to a coherent sheaf of modules is of finite type. -/
theorem isFiniteType_kernel_of_isCoherent {M N : SheafOfModules.{t} R} (hM : M.IsFiniteType)
    [IsCoherent N] (φ : M ⟶ N) : (kernel φ).IsFiniteType := by
  obtain ⟨σ, hσ⟩ := hM.exists_localGeneratorsData
  refine LocalKernel.isFiniteType_of_coversTop (kernel φ) σ.X σ.coversTop fun i => ?_
  have hfin : Finite (σ.generators i).I := (hσ.isFiniteType i).finite
  have h1 : (kernel ((σ.generators i).π ≫ φ.over (σ.X i))).IsFiniteType :=
    IsCoherent.kernel_isFiniteType (σ.X i) (σ.generators i).I hfin _
  have h2 : (kernel (φ.over (σ.X i))).IsFiniteType :=
    isFiniteType_kernel_of_epi_comp (σ.generators i).π (φ.over (σ.X i)) h1
  exact isFiniteType_of_iso (M := kernel (φ.over (σ.X i)))
    (N := (kernel φ).over (σ.X i)) (overKernelIso φ (σ.X i)).symm h2

