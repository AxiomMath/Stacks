/-- The form in which the previous lemma is used: a morphism of the site `h : Y ⟶ Y'` transports
the kernel condition from `M.over Y'` down to `M.over Y`. -/
theorem isFiniteType_kernel_of_generatingSections_of_hom {M : SheafOfModules.{t} R} {Y Y' : C}
    (h : Y ⟶ Y') [IsCoherent (M.over Y')]
    {N : SheafOfModules.{t} (R.over Y)} (σ : N.GeneratingSections) [Finite σ.I]
    (g : N ⟶ M.over Y) : (kernel g).IsFiniteType :=
  isFiniteType_kernel_of_generatingSections_overOver Y' (Over.mk h) σ g

