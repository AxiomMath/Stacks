theorem isCoherent_of_iso {M N : SheafOfModules.{t} R} (e : M ≅ N) [IsCoherent M] :
    IsCoherent N :=
  (coherentModules R).prop_of_iso e inferInstance

/-- **Stacks Project, Tag 01BY (3), cokernels, over a site.** The cokernel of a morphism of
coherent sheaves of modules is coherent.

