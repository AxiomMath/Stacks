/-- Coherence of `M.over U` controls the kernels of morphisms into `M.over Z.left`, for every
object `Z` of the slice site at `U`: the datum is carried across `overOverEquivalence U Z` by its
*functor* rather than by its inverse. -/
theorem isFiniteType_kernel_of_generatingSections_overOver {M : SheafOfModules.{t} R} (U : C)
    (Z : Over U) [IsCoherent (M.over U)]
    {N : SheafOfModules.{t} (R.over Z.left)} (σ : N.GeneratingSections) [Finite σ.I]
    (g : N ⟶ M.over Z.left) : (kernel g).IsFiniteType := by
  let e := overOverEquivalence (R := R) U Z
  let ρ : e.functor.obj (M.over Z.left) ⟶ (M.over U).over Z :=
    e.functor.map (overOverIso M U Z).inv ≫ (e.counitIso.app ((M.over U).over Z)).hom
  have hρ : IsIso ρ := by
    have : IsIso (e.functor.map (overOverIso M U Z).inv) := inferInstance
    exact IsIso.comp_isIso
  have hfin : Finite (σ.map e.functor (Iso.refl (unit ((R.over U).over Z)))).I :=
    inferInstanceAs (Finite σ.I)
  have hk : (kernel (e.functor.map g ≫ ρ)).IsFiniteType :=
    isFiniteType_kernel_of_generatingSections Z
      (σ.map e.functor (Iso.refl (unit ((R.over U).over Z)))) (e.functor.map g ≫ ρ)
  have hk2 : (kernel (e.functor.map g)).IsFiniteType :=
    isFiniteType_of_iso (kernelCompMono (e.functor.map g) ρ) hk
  have hk3 : (e.functor.obj (kernel g)).IsFiniteType :=
    isFiniteType_of_iso (PreservesKernel.iso e.functor g).symm hk2
  exact isFiniteType_of_iso (e.unitIso.app (kernel g)).symm
    (isFiniteType_overOverEquivalence_inverse_obj U Z hk3)

