/-- **Stacks Project, Tag 01BY (3), kernels, over a site.** The kernel of a morphism of coherent
sheaves of modules is coherent. -/
theorem isCoherent_kernel {M N : SheafOfModules.{t} R} [IsCoherent M] [IsCoherent N]
    (φ : M ⟶ N) : IsCoherent (kernel φ) :=
  isCoherent_of_mono (kernel.ι φ)
    (isFiniteType_kernel_of_isCoherent IsCoherent.isFiniteType φ)

/-- **Stacks Project, Tag 01BY (4), over a site.** The middle term of a short exact sequence of
sheaves of modules whose outer terms are coherent is coherent. -/
theorem isCoherent_X₂_of_shortExact {S : ShortComplex (SheafOfModules.{t} R)} (hS : S.ShortExact)
    (h₁ : IsCoherent S.X₁) (h₃ : IsCoherent S.X₃) : IsCoherent S.X₂ := by
  have := h₁
  have := h₃
  have := hS.mono_f
  refine { isFiniteType := ?_, kernel_isFiniteType := ?_ }
  · exact isFiniteType_X₂_of_shortExact hS IsCoherent.isFiniteType IsCoherent.isFiniteType
  intro U I hI φ
  -- restriction to `U` keeps `S.f` a kernel of `S.g`, so `S.X₁.over U` is the kernel there
  have hfk := isLimitKernelForkOver (hfg := S.zero) hS.fIsKernel U
  have hmono : Mono (S.f.over U) := over_mono S.f U
  let e : kernel (S.g.over U) ≅ S.X₁.over U :=
    IsLimit.conePointUniqueUpToIso (kernelIsKernel (S.g.over U)) hfk
  have he : e.hom ≫ S.f.over U = kernel.ι (S.g.over U) :=
    IsLimit.conePointUniqueUpToIso_hom_comp (kernelIsKernel (S.g.over U)) hfk
      WalkingParallelPair.zero
  -- `δ` compares the kernel of `φ ≫ S.g.over U`, of finite type by coherence of `S.X₃`,
  -- with `S.X₁.over U`
  have hq : (kernel (φ ≫ S.g.over U)).IsFiniteType :=
    IsCoherent.kernel_isFiniteType U I hI (φ ≫ S.g.over U)
  let δ : kernel (φ ≫ S.g.over U) ⟶ S.X₁.over U :=
    kernel.map (φ ≫ S.g.over U) (S.g.over U) φ (𝟙 _) (by simp) ≫ e.hom
  have hδ : δ ≫ S.f.over U = kernel.ι (φ ≫ S.g.over U) ≫ φ := by
    rw [show δ = kernel.map (φ ≫ S.g.over U) (S.g.over U) φ (𝟙 _) (by simp) ≫ e.hom from rfl,
      Category.assoc, he]
    exact kernel.lift_ι _ _ _
  -- and its kernel is the kernel of `φ`
  have hδft : (kernel δ).IsFiniteType := isFiniteType_kernel_over_of_isCoherent U hq δ
  exact isFiniteType_of_iso (M := kernel δ) (N := kernel φ)
    ((kernelCompMono δ (S.f.over U)).symm ≪≫ kernelIsoOfEq hδ ≪≫
      kernelCompIsoOfFactorsThrough (kernel.ι (φ ≫ S.g.over U)) φ
        (kernel.lift (φ ≫ S.g.over U) (kernel.ι φ) (by rw [← Category.assoc]; simp))
        (kernel.lift_ι _ _ _)) hδft

/-- **Stacks Project, Tag 01BY (3), cokernels, over a site.** The third term of a short exact
sequence of sheaves of modules whose first two terms are coherent is coherent.

The second condition of coherence is checked by pulling the sequence back along
`ψ : free I ⟶ S.X₃.over U`: the pullback `Q` is an extension of `free I` by `S.X₁.over U`, hence
of finite type, the kernel of `ψ` is the kernel of the second projection `Q ⟶ S.X₂.over U`, and
that kernel is of finite type because `S.X₂` is coherent. -/
theorem isCoherent_X₃_of_shortExact {S : ShortComplex (SheafOfModules.{t} R)} (hS : S.ShortExact)
    (h₁ : IsCoherent S.X₁) (h₂ : IsCoherent S.X₂) : IsCoherent S.X₃ := by
  have := h₁
  have := h₂
  have hepi : Epi S.g := hS.epi_g
  have hmonof : Mono S.f := hS.mono_f
  constructor
  · exact isFiniteType_of_epi (M := S.X₂) (N := S.X₃) S.g (IsCoherent.isFiniteType (M := S.X₂))
  intro U I hI ψ
  have hX₁ : (S.X₁.over U).IsFiniteType :=
    isFiniteType_over_of_isFiniteType U IsCoherent.isFiniteType
  -- the pullback of `ψ` along it is of finite type
  have hQ : (pullback ψ (S.g.over U)).IsFiniteType :=
    isFiniteType_pullback_of_shortExact (shortExact_over hS U) hX₁ ψ
  -- and the kernel of its second projection, which is the kernel of `ψ`, is of finite type
  have hj : pullback.lift (kernel.ι ψ) (0 : kernel ψ ⟶ S.X₂.over U) (by simp) ≫
      pullback.snd ψ (S.g.over U) = 0 := pullback.lift_snd _ _ _
  have hker : (kernel (pullback.snd ψ (S.g.over U))).IsFiniteType :=
    isFiniteType_kernel_over_of_isCoherent U hQ (pullback.snd ψ (S.g.over U))
  exact isFiniteType_of_iso (M := kernel (pullback.snd ψ (S.g.over U))) (N := kernel ψ)
    (IsLimit.conePointUniqueUpToIso (kernelIsKernel (pullback.snd ψ (S.g.over U)))
      (isLimitKernelForkPullbackSnd (S.g.over U) (hi := kernel.condition ψ) (kernelIsKernel ψ) _
        (pullback.lift_fst _ _ _) hj)) hker

/-- The cokernel of a morphism of coherent sheaves of modules is coherent. -/
instance coherentModules_isClosedUnderCokernels :
    (coherentModules R).IsClosedUnderCokernels where
  cokernels_le := by
    rintro _ ⟨φ, k, hk, hφ⟩
    have h₁ : IsCoherent _ := hφ.1
    have h₂ : IsCoherent _ := hφ.2
    -- the image of `φ` is a finite type subsheaf of a coherent sheaf, hence coherent
    have hft : (Abelian.image φ).IsFiniteType :=
      isFiniteType_of_epi (N := Abelian.image φ) (Abelian.factorThruImage φ)
        IsCoherent.isFiniteType
    have himg : IsCoherent (Abelian.image φ) := isCoherent_of_mono (Abelian.image.ι φ) hft
    have hse : (ShortComplex.kernelSequence (cokernel.π φ)).ShortExact :=
      { exact := ShortComplex.kernelSequence_exact _
        mono_f := inferInstance
        epi_g := inferInstanceAs (Epi (cokernel.π φ)) }
    refine (coherentModules R).prop_of_iso
      (IsColimit.coconePointUniqueUpToIso (cokernelIsCokernel φ) hk) ?_
    exact isCoherent_X₃_of_shortExact hse himg h₂

