/-- The local step of `isCoherent_of_coversTop`: over an object `Z` of the slice site at `U`
admitting a morphism to an object `Y` on which `M` is coherent, the kernel of a map out of a
finite free module into `M.over U` restricts to a sheaf of modules of finite type. -/
theorem isFiniteType_kernel_over_of_hom {M : SheafOfModules.{t} R} (U : C) {A : Type t}
    [Finite A] (φ : (free A : SheafOfModules.{t} (R.over U)) ⟶ M.over U) (Z : Over U) {Y : C}
    (h : Z.left ⟶ Y) [IsCoherent (M.over Y)] : ((kernel φ).over Z).IsFiniteType := by
  let τ : ((free A : SheafOfModules.{t} (R.over U)).over Z).GeneratingSections :=
    (free.generatingSections (R := R.over U) A).map (overFunctor (R.over U) Z) (by rfl)
  have hfin : Finite τ.I := inferInstanceAs (Finite A)
  have key : (kernel (φ.over Z)).IsFiniteType :=
    isFiniteType_kernel_overOver U Z τ (φ.over Z) fun _ σ' hσ' g =>
      have := hσ'
      isFiniteType_kernel_of_generatingSections_of_hom h σ' g
  exact isFiniteType_of_iso (overKernelIso φ Z).symm key

