/-- **Coherence restricts to a slice site.** If `M` is coherent then so is its restriction to any
object of the site. This is what makes `IsCoherent` hereditary, and it is the replacement for the
slice-free predicate `Stacks.SheafOfModules.IsCoherentOn`. -/
theorem isCoherent_over {M : SheafOfModules.{t} R} [IsCoherent M] (U : C) :
    IsCoherent (M.over U) where
  isFiniteType := isFiniteType_over_of_isFiniteType U IsCoherent.isFiniteType
  kernel_isFiniteType Z A hA φ := by
    have := hA
    have hfin : Finite (free.generatingSections (R := (R.over U).over Z) A).I :=
      inferInstanceAs (Finite A)
    exact isFiniteType_kernel_overOver U Z (free.generatingSections A) φ fun _ σ' hσ' g =>
      have := hσ'
      isFiniteType_kernel_of_generatingSections Z.left σ' g

