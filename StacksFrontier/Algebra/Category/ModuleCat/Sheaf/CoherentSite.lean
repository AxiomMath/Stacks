theorem isCoherent_cokernel {M N : SheafOfModules.{t} R} [IsCoherent M] [IsCoherent N]
    (φ : M ⟶ N) : IsCoherent (cokernel φ) :=
  (coherentModules R).prop_cokernel φ inferInstance inferInstance

