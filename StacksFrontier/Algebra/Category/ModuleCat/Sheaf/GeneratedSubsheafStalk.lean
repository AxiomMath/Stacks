module

public import Mathlib.Algebra.Category.ModuleCat.Stalk
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Submodule
import StacksCore.Tactic.StacksAttribute

/-!
# The stalk of the subsheaf generated by a family of local sections

Let `(X, R)` be a ringed space, `F` a sheaf of `R`-modules and `s i ∈ F(U i)` a family of
local sections. Stacks 01AR computes the stalk at a point `x` of the smallest subsheaf of
`F` containing the family: it is the `R_x`-submodule of `F_x` spanned by the germs `(s i)_x`
for those `i` with `x ∈ U i`.

The inclusion of the span is immediate, since the subsheaf contains each `s i`. For the other
inclusion one exhibits, for an arbitrary `R_x`-submodule `P ⊆ F_x`, a subsheaf of `F` whose
sections over an open `V` containing `x` are the sections whose germ at `x` lies in `P` (and
all of `F(V)` when `x ∉ V`); this is `stalkSpanSubsheaf`. Taking `P` to be the span of the
germs, that subsheaf contains the family, hence contains the generated subsheaf by
minimality, and therefore every germ of a section of the generated subsheaf lies in `P`.

## Main results

* `Stacks.SheafOfModules.generated_subsheaf_stalk_eq_span`: the germs of the local sections of
  the smallest subsheaf containing the family span exactly the submodule generated by the
  germs of the family.
* `Stacks.SheafOfModules.le_stalkSpanSubsheaf_iff`: taking the germs at `x` of the local
  sections of a subsheaf is left adjoint to `stalkSpanSubsheaf x`; so `stalkSpanSubsheaf x P`
  is the largest subsheaf of `F` all of whose germs at `x` lie in `P`.
* `Stacks.SheafOfModules.subsheafStalkSubmodule_stalkSpanSubsheaf`: the germs at `x` of the
  local sections of `stalkSpanSubsheaf x P` are exactly `P`.
* `Stacks.SheafOfModules.exists_subsheafStalkSubmodule_eq`: every `R_x`-submodule of the stalk
  `F_x` is the submodule of germs at `x` of the local sections of some subsheaf of `F`.

## Implementation notes

Subsheaves of modules are Mathlib's `SheafOfModules.Submodule`, whose sections over an open
`U` are `N.obj U` and whose order is the sectionwise order; "the smallest subsheaf containing
the family" is expressed by the two hypotheses `hcontains` and `hminimal` rather than by a
construction, so the statement is independent of how that subsheaf is built. The stalk of a
subsheaf is described inside the stalk of `F` as the set of germs of its local sections,
which avoids packaging the subsheaf separately as a sheaf of modules.

The germ map is used here through `germSection`, the function `F(U) → F_x` taking a section to
its germ, rather than through `TopCat.Presheaf.germ` of the underlying presheaf of abelian
groups. The two are the same function, but only the first has `F(U)` as its *syntactic*
domain: the underlying presheaf of abelian groups has `(forget₂ ModuleCat AddCommGrpCat).obj
(F.val.obj U)` there, so a sum or a scalar multiple of sections formed in `F(U)` is not visible
as a sum or a scalar multiple of elements of the presheaf's value, and the rewrites by
`map_add` and `PresheafOfModules.germ_ringCat_smul` do not fire. Phrasing the three facts used
about germs — additivity (`germSection_add`), semilinearity (`germSection_smul`) and
compatibility with restriction (`germSection_res`) — for `germSection` makes them applicable
as they stand.

## References

* [Stacks Project, Tag 01AR](https://stacks.math.columbia.edu/tag/01AR)
* [Stacks Project, Tag 01AP](https://stacks.math.columbia.edu/tag/01AP), the generated
  subsheaf.
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite

namespace Stacks.SheafOfModules

variable {X : TopCat} {R : Sheaf (Opens.grothendieckTopology X) RingCat}
  {F : SheafOfModules R}

/-- The germ at `x` of a section of `F` over an open `U` containing `x`, as a function on the
module of sections `F(U)`. -/
noncomputable def germSection (U : Opens X) (x : X) (hU : x ∈ U) :
    F.val.obj (op U) → (show X.Presheaf Ab from F.val.presheaf).stalk x :=
  fun a ↦ (show X.Presheaf Ab from F.val.presheaf).germ U x hU a

/-- The germ of the zero section is zero. -/
lemma germSection_zero (U : Opens X) (x : X) (hU : x ∈ U) :
    germSection (F := F) U x hU 0 = 0 :=
  map_zero _

/-- Taking germs at `x` is additive. -/
lemma germSection_add (U : Opens X) (x : X) (hU : x ∈ U)
    (a b : F.val.obj (op U)) :
    germSection U x hU (a + b) = germSection U x hU a + germSection U x hU b :=
  map_add _ _ _

/-- Taking germs at `x` is semilinear over the germ map of the sheaf of rings. -/
lemma germSection_smul (U : Opens X) (x : X) (hU : x ∈ U)
    (r : R.obj.obj (op U)) (a : F.val.obj (op U)) :
    germSection U x hU (r • a) =
      (show X.Presheaf RingCat from R.obj).germ U x hU r • germSection U x hU a :=
  PresheafOfModules.germ_ringCat_smul F.val x U hU r a

/-- Taking germs at `x` is compatible with restriction to a smaller open containing `x`. -/
lemma germSection_res {U V : Opens X} (i : V ⟶ U) (x : X) (hV : x ∈ V)
    (a : F.val.obj (op U)) :
    germSection V x hV (F.val.map i.op a) = germSection U x (i.le hV) a :=
  TopCat.Presheaf.germ_res_apply F.val.presheaf i x hV a

/-- For an `R_x`-submodule `P` of the stalk `F_x`, the sections over an open `U` whose germ at
`x` lies in `P` — all of `F(U)` when `x ∉ U`. -/
noncomputable def stalkSpanSubmodule (U : Opens X) (x : X)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    Submodule (R.obj.obj (op U)) (F.val.obj (op U)) := by
  classical
  by_cases hU : x ∈ U
  · exact
      { carrier := {a | germSection U x hU a ∈ P}
        zero_mem' := by
          change germSection U x hU 0 ∈ P
          rw [germSection_zero]
          exact P.zero_mem
        add_mem' := by
          intro a b ha hb
          change germSection U x hU a ∈ P at ha
          change germSection U x hU b ∈ P at hb
          change germSection U x hU (a + b) ∈ P
          rw [germSection_add]
          exact P.add_mem ha hb
        smul_mem' := by
          intro r a ha
          change germSection U x hU a ∈ P at ha
          change germSection U x hU (r • a) ∈ P
          rw [germSection_smul]
          exact P.smul_mem _ ha }
  · exact ⊤

/-- The family `stalkSpanSubmodule` is stable under restriction, hence is a submodule of the
underlying presheaf of modules of `F`. -/
noncomputable def stalkSpanPresheafSubmodule
    (x : X) (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    PresheafOfModules.Submodule F.val where
  obj U := stalkSpanSubmodule (unop U) x P
  map {U V} i := by
    classical
    intro a ha
    by_cases hV : x ∈ unop V
    · have hU : x ∈ unop U := i.unop.le hV
      simp only [stalkSpanSubmodule, hU] at ha
      change (F.val.map i a) ∈ stalkSpanSubmodule (unop V) x P
      simp only [stalkSpanSubmodule, hV]
      change germSection (unop V) x hV (F.val.map i.unop.op a) ∈ P
      rw [germSection_res]
      exact ha
    · change (F.val.map i a) ∈ stalkSpanSubmodule (unop V) x P
      rw [show stalkSpanSubmodule (unop V) x P = ⊤ by simp [stalkSpanSubmodule, hV]]
      trivial

/-- `stalkSpanPresheafSubmodule` is a subsheaf: membership is a condition on the germ at a
single point, hence local. -/
noncomputable def stalkSpanSubsheaf (x : X)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) : F.Submodule where
  toSubmodule := stalkSpanPresheafSubmodule x P
  isSheaf := by
    classical
    intro U a hU
    change a ∈ stalkSpanSubmodule (unop U) x P
    by_cases hx : x ∈ unop U
    · obtain ⟨V, f, hf, hxV⟩ := hU x hx
      have ha : F.val.map f.op a ∈ stalkSpanSubmodule V x P := hf
      simp only [stalkSpanSubmodule, hxV] at ha
      have ha' : germSection V x hxV (F.val.map f.op a) ∈ P := ha
      rw [germSection_res f x hxV a] at ha'
      simp only [stalkSpanSubmodule, hx]
      exact ha'
    · rw [show stalkSpanSubmodule (unop U) x P = ⊤ by simp [stalkSpanSubmodule, hx]]
      trivial

/-- The germs at `x` of the local sections of a subsheaf `G ⊆ F` form an `R_x`-submodule of
the stalk `F_x`. -/
noncomputable def subsheafStalkSubmodule (G : F.Submodule) (x : X) :
    Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x) where
  carrier := {t | ∃ (V : Opens X) (hxV : x ∈ V) (a : F.val.obj (op V)),
    a ∈ G.obj (op V) ∧ germSection V x hxV a = t}
  zero_mem' :=
    ⟨⊤, Set.mem_univ x, 0, (G.obj _).zero_mem, germSection_zero ⊤ x (Set.mem_univ x)⟩
  add_mem' := by
    rintro t₁ t₂ ⟨V, hxV, a, ha, rfl⟩ ⟨W, hxW, b, hb, rfl⟩
    let Z : Opens X := V ⊓ W
    let iV : Z ⟶ V := homOfLE inf_le_left
    let iW : Z ⟶ W := homOfLE inf_le_right
    have hxZ : x ∈ Z := ⟨hxV, hxW⟩
    let av : G.obj (op Z) := ⟨F.val.map iV.op a, G.map_mem iV.op ha⟩
    let bw : G.obj (op Z) := ⟨F.val.map iW.op b, G.map_mem iW.op hb⟩
    have h₁ : germSection Z x hxZ av.1 = germSection V x hxV a :=
      germSection_res iV x hxZ a
    have h₂ : germSection Z x hxZ bw.1 = germSection W x hxW b :=
      germSection_res iW x hxZ b
    refine ⟨Z, hxZ, ↑(av + bw), (av + bw).property, ?_⟩
    change germSection Z x hxZ (av.1 + bw.1) = _
    rw [germSection_add, h₁, h₂]
  smul_mem' := by
    intro r t ht
    obtain ⟨V, hxV, a, ha, rfl⟩ := ht
    obtain ⟨W, hxW, q, hq⟩ :=
      (show X.Presheaf RingCat from R.obj).exists_germ_eq r
    let Z : Opens X := W ⊓ V
    let iW : Z ⟶ W := homOfLE inf_le_left
    let iV : Z ⟶ V := homOfLE inf_le_right
    have hxZ : x ∈ Z := ⟨hxW, hxV⟩
    let av : G.obj (op Z) := ⟨F.val.map iV.op a, G.map_mem iV.op ha⟩
    let qz : R.obj.obj (op Z) := R.obj.map iW.op q
    have h₁ : (show X.Presheaf RingCat from R.obj).germ Z x hxZ qz = r :=
      (TopCat.Presheaf.germ_res_apply R.obj iW x hxZ q).trans hq
    have h₂ : germSection Z x hxZ av.1 = germSection V x hxV a :=
      germSection_res iV x hxZ a
    refine ⟨Z, hxZ, ↑(qz • av), (qz • av).property, ?_⟩
    change germSection Z x hxZ (qz • av.1) = _
    rw [germSection_smul, h₁, h₂]

/-- A section over an open containing `x` lies in `stalkSpanSubmodule U x P` exactly when its
germ at `x` lies in `P`. -/
lemma mem_stalkSpanSubmodule_iff {U : Opens X} {x : X} (hU : x ∈ U)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) (a : F.val.obj (op U)) :
    a ∈ stalkSpanSubmodule U x P ↔ germSection U x hU a ∈ P := by
  classical
  simp only [stalkSpanSubmodule, hU]
  exact Iff.rfl

/-- Away from `x` the condition on germs is empty: `stalkSpanSubmodule U x P` is all of
`F(U)` when `x ∉ U`. -/
lemma stalkSpanSubmodule_eq_top {U : Opens X} {x : X} (hU : x ∉ U)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    stalkSpanSubmodule (F := F) U x P = ⊤ := by
  classical
  simp [stalkSpanSubmodule, hU]

/-- An element of the stalk `F_x` lies in `subsheafStalkSubmodule G x` exactly when it is the
germ at `x` of a local section of `G`. -/
lemma mem_subsheafStalkSubmodule_iff (G : F.Submodule) (x : X)
    (t : (show X.Presheaf Ab from F.val.presheaf).stalk x) :
    t ∈ subsheafStalkSubmodule G x ↔
      ∃ (V : Opens X) (hxV : x ∈ V) (a : F.val.obj (op V)),
        a ∈ G.obj (op V) ∧ germSection V x hxV a = t :=
  Iff.rfl

/-- The germ at `x` of a local section of `G` lies in the stalk of `G`. -/
lemma germSection_mem_subsheafStalkSubmodule {G : F.Submodule} {V : Opens X} {x : X}
    (hxV : x ∈ V) {a : F.val.obj (op V)} (ha : a ∈ G.obj (op V)) :
    germSection V x hxV a ∈ subsheafStalkSubmodule G x :=
  ⟨V, hxV, a, ha, rfl⟩

/-- Passing to germs at `x` is monotone in the subsheaf. -/
lemma subsheafStalkSubmodule_le_subsheafStalkSubmodule {G₁ G₂ : F.Submodule} (h : G₁ ≤ G₂)
    (x : X) : subsheafStalkSubmodule G₁ x ≤ subsheafStalkSubmodule G₂ x := by
  rintro t ⟨V, hxV, a, ha, rfl⟩
  exact ⟨V, hxV, a, h (op V) ha, rfl⟩

/-- A section lies in `stalkSpanSubmodule U x P` once its germ lies in `P` whenever `x ∈ U`. -/
private lemma mem_stalkSpanSubmodule_of {U : Opens X} {x : X}
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) {a : F.val.obj (op U)}
    (h : ∀ hU : x ∈ U, germSection U x hU a ∈ P) : a ∈ stalkSpanSubmodule U x P := by
  by_cases hU : x ∈ U
  · exact (mem_stalkSpanSubmodule_iff hU P a).2 (h hU)
  · rw [stalkSpanSubmodule_eq_top hU]
    trivial

/-- **`stalkSpanSubsheaf x` is right adjoint to taking germs at `x`.** A subsheaf of `F` is
contained in `stalkSpanSubsheaf x P` exactly when every germ at `x` of a local section of it
lies in `P`; so `stalkSpanSubsheaf x P` is the largest subsheaf of `F` whose stalk at `x` is
contained in `P`. -/
lemma le_stalkSpanSubsheaf_iff (G : F.Submodule) (x : X)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    G ≤ stalkSpanSubsheaf x P ↔ subsheafStalkSubmodule G x ≤ P := by
  classical
  constructor
  · rintro h t ⟨V, hxV, a, ha, rfl⟩
    exact (mem_stalkSpanSubmodule_iff hxV P a).1 (h (op V) ha)
  · intro h V a ha
    exact mem_stalkSpanSubmodule_of P fun hxV =>
      h (germSection_mem_subsheafStalkSubmodule hxV ha)

/-- **Spreading a submodule of a stalk out to a subsheaf.** The germs at `x` of the local
sections of `stalkSpanSubsheaf x P` are exactly the elements of `P`: every element of `P` is
the germ of some section of `F`, and that section lies in `stalkSpanSubsheaf x P` precisely
because its germ does. -/
theorem subsheafStalkSubmodule_stalkSpanSubsheaf (x : X)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    subsheafStalkSubmodule (stalkSpanSubsheaf (F := F) x P) x = P := by
  refine le_antisymm ((le_stalkSpanSubsheaf_iff _ x P).1 le_rfl) fun t ht => ?_
  obtain ⟨V, hxV, a₀, ha₀⟩ := (show X.Presheaf Ab from F.val.presheaf).exists_germ_eq t
  let a : F.val.obj (op V) := a₀
  have ha : germSection (F := F) V x hxV a = t := ha₀
  refine ⟨V, hxV, a, ?_, ha⟩
  change a ∈ stalkSpanSubmodule V x P
  rwa [mem_stalkSpanSubmodule_iff hxV, ha]

/-- **Every submodule of a stalk is the stalk of a subsheaf.** For an `R_x`-submodule `P` of
the stalk `F_x` there is a subsheaf `G ⊆ F` whose germs at `x` are exactly the elements of
`P`. -/
theorem exists_subsheafStalkSubmodule_eq (x : X)
    (P : Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
      ((show X.Presheaf Ab from F.val.presheaf).stalk x)) :
    ∃ G : F.Submodule, subsheafStalkSubmodule G x = P :=
  ⟨stalkSpanSubsheaf x P, subsheafStalkSubmodule_stalkSpanSubsheaf x P⟩

/-- **Stacks 01AR.** Let `G` be the smallest subsheaf of `F` containing local sections
`s i ∈ F(U i)`. At a point `x`, the set of germs of local sections of `G`, viewed in the
stalk of `F`, is the `R_x`-submodule spanned by the germs `(s i)_x` for which `x ∈ U i`. -/
@[stacks 01AR]
theorem generated_subsheaf_stalk_eq_span {ι : Type*}
    (U : ι → (Opens X)ᵒᵖ) (s : ∀ i, F.val.obj (U i))
    (G : F.Submodule) (hcontains : ∀ i, s i ∈ G.obj (U i))
    (hminimal : ∀ G' : F.Submodule,
      (∀ i, s i ∈ G'.obj (U i)) → G ≤ G')
    (x : X) :
    {t : (show X.Presheaf Ab from F.val.presheaf).stalk x |
      ∃ (V : Opens X) (hxV : x ∈ V) (a : F.val.obj (op V)),
        a ∈ G.obj (op V) ∧
          (show X.Presheaf Ab from F.val.presheaf).germ V x hxV a = t} =
      (Submodule.span ((show X.Presheaf RingCat from R.obj).stalk x)
        {t | ∃ (i : ι) (hxi : x ∈ unop (U i)),
          (show X.Presheaf Ab from F.val.presheaf).germ
            (unop (U i)) x hxi (s i) = t} :
        Submodule ((show X.Presheaf RingCat from R.obj).stalk x)
          ((show X.Presheaf Ab from F.val.presheaf).stalk x)) := by
  classical
  ext t
  constructor
  · rintro ⟨V, hxV, a, ha, rfl⟩
    let P := Submodule.span ((show X.Presheaf RingCat from R.obj).stalk x)
      {t | ∃ (i : ι) (hxi : x ∈ unop (U i)),
        (show X.Presheaf Ab from F.val.presheaf).germ
          (unop (U i)) x hxi (s i) = t}
    let H := stalkSpanSubsheaf (R := R) (F := F) x P
    have hsH : ∀ i, s i ∈ H.obj (U i) := fun i =>
      mem_stalkSpanSubmodule_of P fun hxi => Submodule.subset_span ⟨i, hxi, rfl⟩
    exact (le_stalkSpanSubsheaf_iff G x P).1 (hminimal H hsH) ⟨V, hxV, a, ha, rfl⟩
  · intro ht
    change t ∈ subsheafStalkSubmodule G x
    refine Submodule.span_le.mpr ?_ ht
    rintro y ⟨i, hxi, rfl⟩
    exact ⟨unop (U i), hxi, s i, hcontains i, rfl⟩

/-- **Stacks 01AR, as an equality of submodules of the stalk.** The stalk at `x` of the
smallest subsheaf of `F` containing local sections `s i ∈ F(U i)` is the `R_x`-submodule of
`F_x` spanned by the germs `(s i)_x` for which `x ∈ U i`. -/
theorem subsheafStalkSubmodule_eq_span {ι : Type*}
    (U : ι → (Opens X)ᵒᵖ) (s : ∀ i, F.val.obj (U i))
    (G : F.Submodule) (hcontains : ∀ i, s i ∈ G.obj (U i))
    (hminimal : ∀ G' : F.Submodule,
      (∀ i, s i ∈ G'.obj (U i)) → G ≤ G')
    (x : X) :
    subsheafStalkSubmodule G x =
      Submodule.span ((show X.Presheaf RingCat from R.obj).stalk x)
        {t | ∃ (i : ι) (hxi : x ∈ unop (U i)),
          germSection (unop (U i)) x hxi (s i) = t} :=
  SetLike.coe_injective
    (generated_subsheaf_stalk_eq_span U s G hcontains hminimal x)

end Stacks.SheafOfModules

end
