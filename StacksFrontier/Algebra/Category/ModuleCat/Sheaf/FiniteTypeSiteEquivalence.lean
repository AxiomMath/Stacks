module

public import Mathlib.CategoryTheory.Sites.Equivalence
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SiteEquivalenceTransport
public import StacksFrontier.AlgebraicGeometry.Topologies.ModuleTypesOnSite

/-!
# Finite type is carried along an equivalence of ringed sites

Let `e : C' ≌ C` be an equivalence of categories which is continuous in both directions for
topologies `J'` and `J`, and let `R` be a sheaf of rings on `(C, J)`. A sheaf of `R`-modules of
finite type — locally on a covering of the site generated by finitely many sections — is carried
by the reindexing equivalence `Stacks.SheafOfModules.reindexEquivalence` to a sheaf of modules of
finite type over the transported sheaf of rings.

## Main results

* `Stacks.SheafOfModules.isDenseSubsite_inverse_of_isContinuous`: an equivalence continuous in
  both directions is an equivalence of sites.
* `Stacks.SheafOfModules.isFiniteType_reindex`: **reindexing along an equivalence of sites
  preserves finite type.**

## References

* [Stacks Project, Tag 03DM](https://stacks.math.columbia.edu/tag/03DM)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory Opposite

universe u v w m

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {C' : Type u} [Category.{v} C']
  {J : GrothendieckTopology C} {J' : GrothendieckTopology C'}

/-- The left adjoint of a continuous functor is cocontinuous. -/
private theorem isCocontinuous_of_adjunction {D : Type u} [Category.{v} D]
    {K : GrothendieckTopology D} {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G)
    [G.IsContinuous K J] : F.IsCocontinuous J K :=
  (adj.isCocontinuous_iff_coverPreserving J K).2 (CoverPreserving.of_isContinuous _ _ _)

/-- **An equivalence of categories which is continuous in both directions is an equivalence of
sites**: its inverse exhibits the target as a dense subsite of the source. -/
theorem isDenseSubsite_inverse_of_isContinuous (e : C' ≌ C)
    [e.functor.IsContinuous J' J] [e.inverse.IsContinuous J J'] :
    e.inverse.IsDenseSubsite J J' :=
  have : e.inverse.IsCocontinuous J J' :=
    isCocontinuous_of_adjunction (G := e.functor) e.symm.toAdjunction
  have : e.functor.IsCocontinuous J' J := isCocontinuous_of_adjunction e.toAdjunction
  Equivalence.isDenseSubsite_inverse_of_isCocontinuous J' J e

/-- **Reindexing along an equivalence of sites preserves finite type.** If a sheaf of
`R`-modules is generated, on the members of a covering family of `C`, by finitely many sections,
so is its reindexing along `e : C' ≌ C` over the transported sheaf of rings. -/
theorem isFiniteType_reindex (e : C' ≌ C) [e.functor.IsContinuous J' J]
    [e.inverse.IsContinuous J J'] (R : Sheaf J RingCat.{w}) (M : SheafOfModules.{m} R)
    (h : PresheafOfModules.IsFiniteType J M.val) :
    PresheafOfModules.IsFiniteType J'
      ((reindexEquivalence.{w, m} (J' := J') e R).functor.obj M).val := by
  have : e.functor.IsCocontinuous J' J := isCocontinuous_of_adjunction e.toAdjunction
  obtain ⟨I, U, hU, hgen⟩ := h.exists_generators
  refine ⟨⟨I, fun i => e.inverse.obj (U i), fun V' => ?_, fun i => ?_⟩⟩
  · refine J'.superset_covering ?_ (e.functor.cover_lift J' J (hU (e.functor.obj V')))
    rintro W g ⟨i, ⟨a⟩⟩
    exact ⟨i, ⟨(e.unitIso.app W).hom ≫ e.inverse.map a⟩⟩
  · obtain ⟨n, s, hs⟩ := hgen i
    refine ⟨n, fun k => M.val.map (e.counit.app (U i)).op (s k), fun V' f t => ?_⟩
    obtain ⟨S, hS, hloc⟩ := hs (e.functor.obj V') (e.functor.map f ≫ e.counit.app (U i)) t
    refine ⟨S.functorPullback e.functor, e.functor.cover_lift J' J hS, fun W' g hg => ?_⟩
    obtain ⟨a, ha⟩ := hloc (e.functor.obj W') (e.functor.map g) hg
    refine ⟨a, Eq.trans ?_ ha⟩
    refine Finset.sum_congr rfl fun k _ => ?_
    change a k • M.val.map (e.functor.map (g ≫ f)).op (M.val.map (e.counit.app (U i)).op (s k)) =
      a k • M.val.map (e.functor.map g ≫ e.functor.map f ≫ e.counit.app (U i)).op (s k)
    congr 1
    rw [← PresheafOfModules.map_comp_apply, ← op_comp, Functor.map_comp, Category.assoc]

end Stacks.SheafOfModules

end
