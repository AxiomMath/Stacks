/-!
# The derived décalage of an invertible ideal

In Situation 0GT4 the Berthelot–Ogus operator `η_I` is defined on complexes of `I`-torsion-free
`O_X`-modules.  This file descends it to an additive endofunctor `Lη_I` of the unbounded derived
category `D(O_X)`, which is Tag 0F8Q.

The descent rests on `D(O_X)` being the localization of the complexes of `I`-torsion-free
modules at the quasi-isomorphisms, which in turn rests on every complex of `O_X`-modules
admitting a quasi-isomorphism from a complex of `I`-torsion-free modules.  That existence
statement is `HasTorsionFreeResolutions`.

Each construction therefore comes in two forms.  `derivedEtaOfRegular` and its two companions
are Tag 0F8Q itself: they assume Situation 0GT4 — `I` locally generated by a section that is a
nonzerodivisor on `O_X` — and nothing else, the resolutions being *supplied* from that
hypothesis by `torsionFreeResolutions_of_isLocallyGeneratedByRegular`, which is proved from
Tag 06YF and Tag 0GT5.  `derivedEta`, `derivedEta_iso` and `derivedEta_additive` instead take
the resolutions as an explicit hypothesis `hres`, *assuming* what the former prove.

The assuming form is not redundant, and this is the mathematical content of the split: the
pullback and ideal-transport results apply `Lη_I` to an ideal for which `hres` is available but
local generation by a nonzerodivisor is not.  The pullback of a nonzerodivisor along a morphism
of ringed spaces need not be a nonzerodivisor — that needs flatness of the morphism — so those
results genuinely cannot be stated with Situation 0GT4's hypothesis in place of `hres`.

## References

* [Stacks Project, Tag 0F8Q](https://stacks.math.columbia.edu/tag/0F8Q)
* [Stacks Project, Tag 0F8P](https://stacks.math.columbia.edu/tag/0F8P)
* [Stacks Project, Tag 0GSL](https://stacks.math.columbia.edu/tag/0GSL)
* [Stacks Project, Tag 06YF](https://stacks.math.columbia.edu/tag/06YF)
* [Stacks Project, Tag 0GT5](https://stacks.math.columbia.edu/tag/0GT5)
-/

@[expose] public section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe u

namespace Stacks.IdealTorsion.Eta

attribute [local instance] HasDerivedCategory.standard

variable (X : RingedSpace.{u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- The inclusion of `I`-torsion-free modules is additive. -/
private instance torsionFreeIota_additive {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    ((torsionFreeProperty X ι).ι).Additive := inferInstance

/-- The homotopy-category inclusion is additive. -/
private instance torsionFreeHomotopy_additive' {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    ((torsionFreeProperty X ι).ι.mapHomotopyCategory (ComplexShape.up ℤ)).Additive :=
  inferInstance

/-- The homotopy category of complexes of `I`-torsion-free `O_X`-modules, included into the
homotopy category of all complexes of `O_X`-modules. -/
public noncomputable def torsionFreeHomotopy {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    HomotopyCategory (TorsionFreeModule X ι) (ComplexShape.up ℤ) ⥤
      HomotopyCategory (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ) :=
  (torsionFreeProperty X ι).ι.mapHomotopyCategory (ComplexShape.up ℤ)

/-- The inclusion of the homotopy category of `I`-torsion-free complexes is additive. -/
private instance torsionFreeHomotopy_additive {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopy X ι).Additive := by
  dsimp only [torsionFreeHomotopy]; infer_instance

/-- The inclusion of the homotopy category of `I`-torsion-free complexes is full. -/
private instance torsionFreeHomotopy_full {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopy X ι).Full := by
  dsimp only [torsionFreeHomotopy]; infer_instance

/-- The inclusion of the homotopy category of `I`-torsion-free complexes is faithful. -/
private instance torsionFreeHomotopy_faithful {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopy X ι).Faithful := by
  dsimp only [torsionFreeHomotopy]; infer_instance

/-- The inclusion of the homotopy category of `I`-torsion-free complexes commutes with shifts. -/
private noncomputable instance torsionFreeHomotopy_commShift {I : SheafOfModules.{u} Oₓ}
    (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopy X ι).CommShift ℤ := by
  dsimp only [torsionFreeHomotopy]; infer_instance

/-- The inclusion of the homotopy category of `I`-torsion-free complexes is triangulated. -/
private instance torsionFreeHomotopy_isTriangulated {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopy X ι).IsTriangulated := by
  dsimp only [torsionFreeHomotopy]; infer_instance

/-- The quasi-isomorphisms of complexes of `I`-torsion-free `O_X`-modules: the morphisms which
become quasi-isomorphisms of complexes of `O_X`-modules. -/
public def torsionFreeQuasiIso {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    MorphismProperty (CochainComplex (TorsionFreeModule X ι) ℤ) :=
  (HomologicalComplex.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)).inverseImage
    (torsionFreeComplex X ι)

/-- The quasi-isomorphisms of `K(O_X)` between complexes of `I`-torsion-free modules. -/
public def torsionFreeHomotopyQuasiIso {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    MorphismProperty (HomotopyCategory (TorsionFreeModule X ι) (ComplexShape.up ℤ)) :=
  (HomotopyCategory.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)).inverseImage
    (torsionFreeHomotopy X ι)

/-- Complexes of `I`-torsion-free modules, viewed in `D(O_X)`. -/
public noncomputable def torsionFreeToDerived {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    CochainComplex (TorsionFreeModule X ι) ℤ ⥤ DerivedCategory (SheafOfModules.{u} Oₓ) :=
  torsionFreeComplex X ι ⋙ DerivedCategory.Q

/-- **Termwise `I`-torsion-free resolutions.**  Every complex of `O_X`-modules receives a
quasi-isomorphism from a complex of `I`-torsion-free `O_X`-modules.  This is Tag 06YF — every
complex receives one from a complex with flat terms — combined with the stalkwise criterion of
Tag 0GT5 — a flat module is `I`-torsion-free.  In Situation 0GT4 it holds, by
`torsionFreeResolutions_of_isLocallyGeneratedByRegular`; it is named here so that the
localization statements below can be read off from it alone. -/
public def HasTorsionFreeResolutions {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) : Prop :=
  ∀ G : CochainComplex (SheafOfModules.{u} Oₓ) ℤ,
    ∃ (K : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (p : K ⟶ G),
      (∀ n : ℤ, IsIdealTorsionFree X ι (K.X n)) ∧ QuasiIso p

/-- In Situation 0GT4 — `I` locally generated by a section that is a nonzerodivisor on `O_X` —
termwise `I`-torsion-free resolutions of unbounded complexes exist.  This is
`Stacks.IdealTorsion.exists_termwiseTorsionFree_quasiIso_of_isLocallyGeneratedByRegular`, read
at the spelling of `HasTorsionFreeResolutions`. -/
public lemma torsionFreeResolutions_of_isLocallyGeneratedByRegular (I : SheafOfModules.{u} Oₓ)
    (ι : I ⟶ 𝒪) [monoIncl : Mono ι] (hregl : IsLocallyGeneratedByRegular X ι) :
    HasTorsionFreeResolutions X ι :=
  Stacks.IdealTorsion.exists_termwiseTorsionFree_quasiIso_of_isLocallyGeneratedByRegular
    X I ι monoIncl hregl

/-- Passing from complexes of `I`-torsion-free modules to `D(O_X)` factors through the homotopy
category. -/
private noncomputable def torsionFreeFactors {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    torsionFreeToDerived X ι ≅
      HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ) ⋙
        torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh :=
  (Functor.isoWhiskerLeft (torsionFreeComplex X ι)
      (DerivedCategory.quotientCompQhIso (SheafOfModules.{u} Oₓ))).symm ≪≫
    Functor.isoWhiskerRight
      (Functor.mapHomotopyCategoryFactors (torsionFreeProperty X ι).ι
        (ComplexShape.up ℤ)).symm DerivedCategory.Qh ≪≫
    Functor.associator _ _ _

/-- The homotopy-category inclusion sends the image of a chain map to the image of its
inclusion. -/
private lemma torsionFreeHomotopy_map {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {Y Z : CochainComplex (TorsionFreeModule X ι) ℤ} (f : Y ⟶ Z) :
    (torsionFreeHomotopy X ι).map
        ((HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ)).map f) =
      (HomotopyCategory.quotient (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)).map
        ((torsionFreeComplex X ι).map f) :=
  Functor.mapHomotopyCategory_map (torsionFreeProperty X ι).ι f

/-- Homotopy equivalences of complexes of `I`-torsion-free modules are quasi-isomorphisms. -/
private lemma homotopyEquivalences_le_torsionFreeQuasiIso {I : SheafOfModules.{u} Oₓ}
    (ι : I ⟶ 𝒪) :
    HomologicalComplex.homotopyEquivalences (TorsionFreeModule X ι) (ComplexShape.up ℤ) ≤
      torsionFreeQuasiIso X ι := by
  intro Y Z f hf
  have h1 : IsIso ((HomotopyCategory.quotient (TorsionFreeModule X ι)
      (ComplexShape.up ℤ)).map f) :=
    HomotopyCategory.quotient_inverts_homotopyEquivalences _ _ _ hf
  have h2 : IsIso ((HomotopyCategory.quotient (SheafOfModules.{u} Oₓ)
      (ComplexShape.up ℤ)).map ((torsionFreeComplex X ι).map f)) := by
    rw [← torsionFreeHomotopy_map X ι f]
    exact ((torsionFreeHomotopy X ι).mapIso (@asIso _ _ _ _ _ h1)).isIso_hom
  have h3 := (HomologicalComplex.isIso_quotient_map_iff_homotopyEquivalences
    ((torsionFreeComplex X ι).map f)).1 h2
  show QuasiIso ((torsionFreeComplex X ι).map f)
  exact _root_.homotopyEquivalences_le_quasiIso _ _ _ h3

/-- **The derived category is the localization of complexes of `I`-torsion-free modules.**
Granted termwise `I`-torsion-free resolutions, passing from complexes of `I`-torsion-free
`O_X`-modules to `D(O_X)` is the localization at the quasi-isomorphisms.  This is Tag 0GSL
applied to the full triangulated subcategory of `K(O_X)` spanned by the complexes of
`I`-torsion-free modules, composed with the passage to the homotopy category. -/
public lemma isLocalization_torsionFreeHomotopy {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (hres : HasTorsionFreeResolutions X ι) :
    (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh).IsLocalization
      (torsionFreeHomotopyQuasiIso X ι) := by
  let Iot := torsionFreeHomotopy X ι
  let W := HomotopyCategory.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)
  let P : ObjectProperty (HomotopyCategory (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)) :=
    Iot.essImage
  let _ : P.IsTriangulated := by dsimp only [P]; infer_instance
  let Φ : LocalizerMorphism (W.inverseImage P.ι) W := { functor := P.ι, map := le_rfl }
  have hW : W.IsSaturated :=
    (HomotopyCategory.isSaturated_subcategoryAcyclic_and_quasiIso_and_kernel_eq
      (DerivedCategory.Qh (C := SheafOfModules.{u} Oₓ))).2.1.1
  let _ : W.IsCompatibleWithTriangulation := by
    dsimp only [W]
    rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
    infer_instance
  let _ : Φ.HasLeftResolutions := by
    intro Y
    obtain ⟨K, q, htf, hq⟩ := hres Y.as
    let K' := HomologicalComplex.liftObjectProperty (torsionFreeProperty X ι) K htf
    let Y' := (HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ)).obj K'
    let e : Iot.obj Y' ≅
        (HomotopyCategory.quotient (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)).obj K :=
      Iso.refl _
    let YP : P.FullSubcategory := ⟨Iot.obj Y', ⟨Y', ⟨Iso.refl _⟩⟩⟩
    let a : P.ι.obj YP ⟶ Y := e.hom ≫ (HomotopyCategory.quotient _ _).map q
    refine ⟨⟨a, ?_⟩⟩
    dsimp only [a]
    refine (HomotopyCategory.quasiIso _ _).comp_mem _ _ ?_
      ((HomotopyCategory.quotient_map_mem_quasiIso_iff q).2 hq)
    show W (𝟙 _)
    exact W.id_mem _
  have hΦ :=
    (P.isSaturated_and_isCompatibleWithTriangulation_inverseImage_ι_and_isLocalizedEquivalence
      W hW).2.2
  let _ : Φ.IsLocalizedEquivalence := hΦ inferInstance
  let _ : (P.ι ⋙ DerivedCategory.Qh).IsLocalization (W.inverseImage P.ι) := by
    show (Φ.functor ⋙ DerivedCategory.Qh).IsLocalization (W.inverseImage P.ι)
    exact CategoryTheory.LocalizerMorphism.IsLocalizedEquivalence.isLocalization
      Φ DerivedCategory.Qh
  let E : HomotopyCategory (TorsionFreeModule X ι) (ComplexShape.up ℤ) ≌ P.FullSubcategory :=
    Iot.toEssImage.asEquivalence
  let J : E.symm.functor ⋙ Iot ≅ P.ι :=
    CategoryTheory.Functor.isoWhiskerLeft E.inverse (Functor.toEssImageCompι Iot).symm ≪≫
      (Functor.associator _ _ _).symm ≪≫
      CategoryTheory.Functor.isoWhiskerRight E.counitIso P.ι ≪≫
      P.ι.leftUnitor
  let WT := W.inverseImage Iot
  have hLoc : (Iot ⋙ DerivedCategory.Qh).IsLocalization WT := by
    apply CategoryTheory.Functor.IsLocalization.of_equivalence_source
      (P.ι ⋙ DerivedCategory.Qh) (W.inverseImage P.ι)
      (Iot ⋙ DerivedCategory.Qh) WT E.symm
    · intro Y Z g hg
      apply (W.inverseImage Iot).le_isoClosure
      exact (W.arrow_mk_iso_iff
        (((Functor.mapArrowFunctor _ _).mapIso J).app (Arrow.mk g))).2 hg
    · intro Y Z g hg
      show IsIso (DerivedCategory.Qh.map (Iot.map g))
      exact Localization.inverts DerivedCategory.Qh W _ hg
    · exact CategoryTheory.Functor.isoWhiskerRight J DerivedCategory.Qh
  exact hLoc

/-- The quasi-isomorphisms of `K(O_X)` between complexes of `I`-torsion-free modules have a left
calculus of fractions: they are the morphisms whose cone is acyclic. -/
public lemma hasLeftCalculusOfFractions_torsionFreeHomotopyQuasiIso
    {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    (torsionFreeHomotopyQuasiIso X ι).HasLeftCalculusOfFractions := by
  let : (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh).IsTriangulated :=
    { map_distinguished := fun triangle distinguished ↦
        isomorphic_distinguished _
          (DerivedCategory.Qh.map_distinguished _
            ((torsionFreeHomotopy X ι).map_distinguished triangle distinguished)) _
          ((Functor.mapTriangleCompIso (torsionFreeHomotopy X ι)
            DerivedCategory.Qh).app triangle) }
  have hWT : torsionFreeHomotopyQuasiIso X ι =
      (MorphismProperty.isomorphisms (DerivedCategory (SheafOfModules.{u} Oₓ))).inverseImage
        (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh) := by
    ext source target morphism
    show HomotopyCategory.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)
        ((torsionFreeHomotopy X ι).map morphism) ↔
      IsIso (DerivedCategory.Qh.map ((torsionFreeHomotopy X ι).map morphism))
    exact (DerivedCategory.isIso_Qh_map_iff _).symm
  rw [hWT]
  exact (Functor.isSaturated_and_isCompatibleWithTriangulation_inverseImage_isomorphisms
    (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh)).1.hasLeftCalculusOfFractions

/-- **The derived category is the localization of complexes of `I`-torsion-free modules.**
Granted termwise `I`-torsion-free resolutions, passing from complexes of `I`-torsion-free
`O_X`-modules to `D(O_X)` is the localization at the quasi-isomorphisms. -/
public lemma isLocalization_torsionFreeToDerived {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (hres : HasTorsionFreeResolutions X ι) :
    (torsionFreeToDerived X ι).IsLocalization (torsionFreeQuasiIso X ι) := by
  have hloc := isLocalization_torsionFreeHomotopy X ι hres
  have hcomp : ((HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ)) ⋙
      (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh)).IsLocalization
      (torsionFreeQuasiIso X ι) := by
    refine CategoryTheory.Functor.IsLocalization.comp _ _
      (HomologicalComplex.homotopyEquivalences (TorsionFreeModule X ι) (ComplexShape.up ℤ))
      (torsionFreeHomotopyQuasiIso X ι) (torsionFreeQuasiIso X ι) ?_
      (homotopyEquivalences_le_torsionFreeQuasiIso X ι) ?_
    · rw [← MorphismProperty.IsInvertedBy.iff_of_iso _ (torsionFreeFactors X ι)]
      intro Y Z f hf
      have hq : QuasiIso ((torsionFreeComplex X ι).map f) := hf
      show IsIso (DerivedCategory.Q.map ((torsionFreeComplex X ι).map f))
      infer_instance
    · intro Y Z f hf
      obtain ⟨g, rfl⟩ := (HomotopyCategory.quotient (TorsionFreeModule X ι)
        (ComplexShape.up ℤ)).map_surjective f
      refine MorphismProperty.map_mem_map _ _ _ ?_
      have hf' : HomotopyCategory.quasiIso (SheafOfModules.{u} Oₓ) (ComplexShape.up ℤ)
          ((HomotopyCategory.quotient (SheafOfModules.{u} Oₓ)
            (ComplexShape.up ℤ)).map ((torsionFreeComplex X ι).map g)) := by
        rw [← torsionFreeHomotopy_map X ι g]
        exact hf
      exact (HomotopyCategory.quotient_map_mem_quasiIso_iff _).1 hf'
  have hcomp' := hcomp
  exact CategoryTheory.Functor.IsLocalization.of_equivalence_target
    (L := HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ) ⋙
      (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh)) _ _
    (CategoryTheory.Equivalence.refl) (Functor.rightUnitor _ ≪≫ (torsionFreeFactors X ι).symm)

/-- The décalage of a quasi-isomorphism of complexes of `I`-torsion-free modules becomes
invertible in `D(O_X)`: this is Tag 0F8P. -/
public lemma etaFunctor_inverts (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I] :
    (torsionFreeQuasiIso X ι).IsInvertedBy
      (etaFunctor X I ι ⋙ DerivedCategory.Q) := by
  intro Y Z f hf
  have hq : QuasiIso ((torsionFreeComplex X ι).map f) := hf
  have h : QuasiIso (etaMap X I ι ((torsionFreeComplex X ι).map f)
      (torsionFreeComplex_torsionFree X ι Y) (torsionFreeComplex_torsionFree X ι Z)) :=
    quasiIso_etaMap X I ι ((torsionFreeComplex X ι).map f)
      (torsionFreeComplex_torsionFree X ι Y) (torsionFreeComplex_torsionFree X ι Z) hq
  show IsIso (DerivedCategory.Q.map ((etaFunctor X I ι).map f))
  have h' : QuasiIso ((etaFunctor X I ι).map f) := h
  infer_instance

/-- **The derived décalage, with the torsion-free resolutions assumed.**  Granted termwise
`I`-torsion-free resolutions, there is a functor `Lη_I : D(O_X) ⥤ D(O_X)` whose value on an
object represented by a complex `F` of `I`-torsion-free `O_X`-modules is the class of the
décalage `η_I F`, and likewise on morphisms; `derivedEta_iso` records that comparison and
`derivedEta_additive` the additivity.  The functor is *not* exact: it does not take
distinguished triangles to distinguished triangles, and no such statement is made here.

This is the general form, taking `hres` as an argument.  In Situation 0GT4 the resolutions are
supplied rather than assumed, and that form — `derivedEtaOfRegular`, which is what Tag 0F8Q
asserts — is below.  This form exists because the pullback and ideal-transport results apply
`Lη_I` to ideals, such as the pullback of `I` along a morphism of ringed spaces, for which the
resolutions are available but local generation by a nonzerodivisor is not. -/
public noncomputable def derivedEta (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (hres : HasTorsionFreeResolutions X ι) :
    DerivedCategory (SheafOfModules.{u} Oₓ) ⥤ DerivedCategory (SheafOfModules.{u} Oₓ) :=
  let := isLocalization_torsionFreeToDerived X ι hres
  Localization.lift (etaFunctor X I ι ⋙ DerivedCategory.Q) (etaFunctor_inverts X I ι)
    (torsionFreeToDerived X ι)

/-- **The comparison with the chain-level décalage, with the resolutions assumed.**  On an
object of `D(O_X)` represented by a complex `F` of `I`-torsion-free `O_X`-modules, and on
morphisms of such complexes, the derived décalage is the class of the chain-level décalage
`η_I F`.  As for `derivedEta` this is the general form; the form asserted by Tag 0F8Q, in which
the resolutions are supplied from Situation 0GT4's hypothesis, is `derivedEtaOfRegular_iso`. -/
public noncomputable def derivedEta_iso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (hres : HasTorsionFreeResolutions X ι) :
    torsionFreeToDerived X ι ⋙ derivedEta X I ι hres ≅
      etaFunctor X I ι ⋙ DerivedCategory.Q :=
  let := isLocalization_torsionFreeToDerived X ι hres
  Localization.fac (etaFunctor X I ι ⋙ DerivedCategory.Q) (etaFunctor_inverts X I ι)
    (torsionFreeToDerived X ι)

/-- **The derived décalage is additive, with the resolutions assumed.**  As for `derivedEta`
this is the general form; the form asserted by Tag 0F8Q, in which the resolutions are supplied
from Situation 0GT4's hypothesis, is `derivedEtaOfRegular_additive`. -/
public instance derivedEta_additive (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)).property I]
    (hres : HasTorsionFreeResolutions X ι) :
    (derivedEta X I ι hres).Additive := by
  have hloc := isLocalization_torsionFreeHomotopy X ι hres
  have hfrac := hasLeftCalculusOfFractions_torsionFreeHomotopyQuasiIso X ι
  let _ : (torsionFreeHomotopy X ι).Additive := by
    dsimp only [torsionFreeHomotopy]; infer_instance
  let _ : (torsionFreeHomotopy X ι).Full := by
    dsimp only [torsionFreeHomotopy]; infer_instance
  let _ : (torsionFreeHomotopy X ι).Faithful := by
    dsimp only [torsionFreeHomotopy]; infer_instance
  let _ : (torsionFreeHomotopy X ι).CommShift ℤ := by
    dsimp only [torsionFreeHomotopy]; infer_instance
  let _ : (torsionFreeHomotopy X ι).IsTriangulated := by
    dsimp only [torsionFreeHomotopy]; infer_instance
  rw [Localization.functor_additive_iff (torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh)
    (torsionFreeHomotopyQuasiIso X ι)]
  have hadd := Stacks.IdealTorsion.Eta.etaFunctor_additive X I ι
  have hF : (etaFunctor X I ι ⋙ DerivedCategory.Q).Additive := inferInstance
  have h : (torsionFreeToDerived X ι ⋙ derivedEta X I ι hres).Additive :=
    Functor.additive_of_iso (derivedEta_iso X I ι hres).symm
  have h' : (HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ) ⋙
      ((torsionFreeHomotopy X ι ⋙ DerivedCategory.Qh) ⋙ derivedEta X I ι hres)).Additive :=
    Functor.additive_of_iso
      (Functor.isoWhiskerRight (torsionFreeFactors X ι) (derivedEta X I ι hres))
  exact Functor.additive_of_full_essSurj_comp
    (HomotopyCategory.quotient (TorsionFreeModule X ι) (ComplexShape.up ℤ)) _

/-! ### The derived décalage in Situation 0GT4

The three declarations below are the operator of Tag 0F8Q under Situation 0GT4's own hypotheses:
`I ⊂ O_X` an ideal sheaf which is locally generated by a section that is a nonzerodivisor on
`O_X`.  Nothing further is assumed.  The termwise `I`-torsion-free resolutions are supplied by
`torsionFreeResolutions_of_isLocallyGeneratedByRegular` and the invertibility of `I` by the
implication (1) ⟹ (2) of Tag 0GT3, which holds on every ringed space; so neither appears as a
hypothesis.  The general forms above, which take the resolutions as an argument, remain the
ones to use for an ideal that is not known to be locally generated by a nonzerodivisor. -/

/-- **Stacks Project, Tag 0F8Q.**  In Situation 0GT4 — `I ⊂ O_X` an ideal sheaf locally
generated by a section that is a nonzerodivisor on `O_X` — there is an additive functor
`Lη_I : D(O_X) ⥤ D(O_X)` whose value on an object represented by a complex `F` of
`I`-torsion-free `O_X`-modules is the class of the décalage `η_I F`, and likewise on morphisms;
`derivedEtaOfRegular_iso` records that comparison and `derivedEtaOfRegular_additive` the
additivity.  The functor is *not* exact: it does not take distinguished triangles to
distinguished triangles, and no such statement is made here.

The termwise `I`-torsion-free resolutions on which the construction rests are supplied by
`hregl`, not assumed.  The form that assumes them, `derivedEta`, is the one to use for an ideal
whose resolutions are available without local generation by a nonzerodivisor — as happens for
the pullback of `I` along a morphism of ringed spaces, and in the comparison of two ideals. -/
@[stacks 0F8Q]
public noncomputable def derivedEtaOfRegular (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι) :
    DerivedCategory (SheafOfModules.{u} Oₓ) ⥤ DerivedCategory (SheafOfModules.{u} Oₓ) :=
  let := Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  derivedEta X I ι (torsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι hregl)

/-- **Stacks Project, Tag 0F8Q.**  In Situation 0GT4, on an object of `D(O_X)` represented by a
complex `F` of `I`-torsion-free `O_X`-modules, and on morphisms of such complexes, the derived
décalage is the class of the chain-level décalage `η_I F`.  The form of this comparison that
assumes the torsion-free resolutions is `derivedEta_iso`. -/
@[stacks 0F8Q "the comparison with the chain-level décalage"]
public noncomputable def derivedEtaOfRegular_iso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] (hregl : IsLocallyGeneratedByRegular X ι) :
    letI := Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
    torsionFreeToDerived X ι ⋙ derivedEtaOfRegular X I ι hregl ≅
      etaFunctor X I ι ⋙ DerivedCategory.Q :=
  let := Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  derivedEta_iso X I ι (torsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι hregl)

/-- **Stacks Project, Tag 0F8Q.**  In Situation 0GT4 the derived décalage is additive.  The
form of this statement that assumes the torsion-free resolutions is `derivedEta_additive`. -/
@[stacks 0F8Q "additivity"]
public instance derivedEtaOfRegular_additive (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : IsLocallyGeneratedByRegular X ι) :
    (derivedEtaOfRegular X I ι hregl).Additive :=
  let := Stacks.IdealTorsion.isInvertible_of_isLocallyGeneratedByRegular X ι hregl
  derivedEta_additive X I ι (torsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι hregl)

end Stacks.IdealTorsion.Eta

