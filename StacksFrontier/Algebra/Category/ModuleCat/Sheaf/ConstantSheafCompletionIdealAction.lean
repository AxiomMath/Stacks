module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ConstantSheafCompletionQuotient
import StacksCore.Tactic.StacksAttribute

/-!
# The completed constant sheaf modulo the ideal it is completed at

Let `J` be a Grothendieck topology on `C`, let `R` be a Noetherian commutative ring and let `I`
be an ideal of `R`. Tag 093M identifies the quotient of the completed constant sheaf
`R̲^∧ = lim (R/Iⁿ)̲` by the ideal `I` with the constant sheaf `(R/I)̲`. This file proves that
identification, and the equality `I · R̲^∧ = I̲^∧` of subsheaves of `R̲^∧` on which it rests.

The ideal multiple `I · R̲^∧` is the image of the map `∐_{f ∈ I} R̲^∧ ⟶ R̲^∧` whose component at
`f` is multiplication by `f`; this file works with that map rather than with its image, so the
quotient `R̲^∧/I R̲^∧` is its cokernel.

The argument is the source's. On every object `U` of the site, the sections of `I̲^∧` inside
`Γ(U, R̲^∧)` are exactly `I · Γ(U, R̲^∧)`: the short exact sequence
`0 → I̲^∧ → R̲^∧ → (R/I)̲ → 0` of
`StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ConstantSheafCompletionQuotient` identifies those
sections with the kernel of `Γ(U, R̲^∧) ⟶ Γ(U, (R/I)̲)`, and that kernel is `I · Γ(U, R̲^∧)`
because `Γ(U, R̲^∧)` is the `I`-adic completion of `Γ(U, R̲)`, where the statement is the
Artin-Rees theorem `AdicCompletion.pow_smul_top_eq_ker_eval`. Consequently the map
`∐_{f ∈ I} R̲^∧ ⟶ I̲^∧` through which the ideal multiplication factors is an epimorphism, which
is the surjectivity the source obtains from a second application of Tag 02N1, and the two
cokernels agree.

## Main definitions

* `Stacks.ConstantSheaf.idealSmulMap`: the map `∐_{f ∈ I} F ⟶ F` of multiplication by the
  elements of `I`, whose image is the ideal multiple `I · F`.
* `Stacks.ConstantSheaf.completedConstantIdealSheafLift`: the factorisation of
  `idealSmulMap` for `F = R̲^∧` through `I̲^∧ ⟶ R̲^∧`.
* `Stacks.ConstantSheaf.completedConstantSheaf_quotientByIdealSmul`: the isomorphism
  `R̲^∧/I R̲^∧ ≅ (R/I)̲`.

## Main results

* `Stacks.ConstantSheaf.ker_sections_completedConstantSheafπ`: the kernel of
  `Γ(U, R̲^∧) ⟶ Γ(U, (R/Iⁿ)̲)` is `Iⁿ · Γ(U, R̲^∧)`.
* `Stacks.ConstantSheaf.range_sections_completedConstantIdealSheafInclusion`: **Stacks 093M**,
  `I̲^∧(U) = I · R̲^∧(U)` for every object `U`.
* `Stacks.ConstantSheaf.epi_completedConstantIdealSheafLift`: **Stacks 093M**, the elements of
  `I` generate `I̲^∧` over `R̲^∧`, i.e. `I · R̲^∧ = I̲^∧`.
* `Stacks.ConstantSheaf.completedConstantSheaf_quotientByIdealSmul` and
  `Stacks.ConstantSheaf.completedConstantSheaf_quotientByIdealSmul_hom_comp`: **Stacks 093M**,
  the identification `R̲^∧/I R̲^∧ = (R/I)̲`, by an isomorphism carrying the cokernel projection
  to the canonical map `R̲^∧ ⟶ (R/I)̲`.

## Implementation notes

The remaining identification of Tag 093M, `R̲^∧/I̲ · R̲^∧ = (R/I)̲`, is not proved here. The
product `I̲ · R̲^∧` of the constant ideal sheaf with `R̲^∧` is the image of
`I̲ ⊗_{R̲} R̲^∧ ⟶ R̲^∧`, which needs `R̲^∧` as a sheaf of modules over the constant sheaf of
rings `R̲` — available as
`Stacks.ConstantSheaf.completedConstantSheafOverConstantRing` — together with a tensor product
of sheaves of modules over a sheaf of rings and the multiplication map on it, which the project
does not have. The subsheaf `I · R̲^∧` of the present file is the one generated by the elements
of the ideal `I` of `R` acting on `R̲^∧`, which is the `I \underline{\Lambda}^\wedge` of the
source.

Noetherianness of `R` is used, through `AdicCompletion.pow_smul_top_eq_ker_eval`, which needs
`I` to be finitely generated.

## References

* [Stacks Project, Tag 093M](https://stacks.math.columbia.edu/tag/093M)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace Stacks.AdicCompletion

/-- A linear map whose composite with an injection is an evaluation of an adic completion, read
through an isomorphism of its source with that completion, has the `n`-th power of the ideal
times its source as kernel. This is the Artin-Rees theorem
`AdicCompletion.pow_smul_top_eq_ker_eval` transported along such an isomorphism. -/
theorem ker_eq_pow_smul_top_of_equiv {R : Type w} [CommRing R] [IsNoetherianRing R] (I : Ideal R)
    {A : Type w} [AddCommGroup A] [Module R A] {S : Type w} [AddCommGroup S] [Module R S]
    (n : ℕ) (σ : A ≃ₗ[R] AdicCompletion I S) {Q : Type w} [AddCommGroup Q] [Module R Q]
    (g : A →ₗ[R] Q) (t : (S ⧸ (I ^ n • ⊤ : Submodule R S)) →ₗ[R] Q)
    (ht : Function.Injective t)
    (hval : ∀ x, g x = t (AdicCompletion.eval I S n (σ x))) :
    LinearMap.ker g = (I ^ n) • (⊤ : Submodule R A) := by
  have hmap : Submodule.map (↑σ : A →ₗ[R] AdicCompletion I S)
      ((I ^ n) • (⊤ : Submodule R A)) = (I ^ n) • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  ext x
  have hiff : σ x ∈ (I ^ n) • (⊤ : Submodule R (AdicCompletion I S)) ↔
      x ∈ (I ^ n) • (⊤ : Submodule R A) := by
    rw [← hmap, Submodule.mem_map_equiv, LinearEquiv.symm_apply_apply]
  rw [LinearMap.mem_ker, hval x, ← hiff,
    AdicCompletion.pow_smul_top_eq_ker_eval (IsNoetherian.noetherian I), LinearMap.mem_ker]
  exact ⟨fun hx => ht (by rw [hx, map_zero]), fun hx => by rw [hx, map_zero]⟩

end Stacks.AdicCompletion

namespace Stacks.Sheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- A morphism of sheaves which is zero on the sections over every object of the site is zero. -/
theorem hom_eq_zero_of_sections {A : Type*} [Category A] [Preadditive A]
    {X Y : CategoryTheory.Sheaf J A} (f : X ⟶ Y)
    (h : ∀ U : C, ((sheafSections J A).obj (op U)).map f = 0) : f = 0 :=
  CategoryTheory.Sheaf.hom_ext (NatTrans.ext (funext fun U => h U.unop))

end Stacks.Sheaf

namespace Stacks.ConstantSheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable {R : Type w} [CommRing R] (I : Ideal R)

/-- The identification `R/I¹ = R/I` is an isomorphism. -/
theorem bijective_adicQuotientOneMap : Function.Bijective (adicQuotientOneMap I).hom := by
  constructor
  · rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
    intro x hx
    induction x using Submodule.Quotient.induction_on with
    | _ a =>
      have ha : a ∈ I := (Submodule.Quotient.mk_eq_zero _).1 (LinearMap.mem_ker.1 hx)
      exact (Submodule.Quotient.mk_eq_zero _).2 (by simpa using ha)
  · intro y
    induction y using Submodule.Quotient.induction_on with
    | _ a => exact ⟨Submodule.Quotient.mk a, rfl⟩

/-- The identification `R/I¹ ⟶ R/I` is an isomorphism of `R`-modules. -/
instance isIso_adicQuotientOneMap : IsIso (adicQuotientOneMap I) :=
  (ConcreteCategory.isIso_iff_bijective _).2 (bijective_adicQuotientOneMap I)

/-! ### Multiplication by an ideal on a sheaf of modules -/

section Smul

variable [HasWeakSheafify J (ModuleCat.{w} R)]

/-- A scalar acting as zero on all sections of a sheaf of modules acts as zero on the sheaf. -/
theorem smul_id_eq_zero_of_sections (F : Sheaf J (ModuleCat.{w} R)) (r : R)
    (hr : ∀ (U : Cᵒᵖ) (y : (((sheafSections J (ModuleCat.{w} R)).obj U).obj F : ModuleCat.{w} R)),
      r • y = 0) : r • 𝟙 F = 0 := by
  refine Stacks.Sheaf.hom_eq_zero_of_sections J _ fun U => ?_
  rw [Functor.map_smul, CategoryTheory.Functor.map_id]
  exact ModuleCat.hom_ext (LinearMap.ext (hr (op U)))

/-- A scalar annihilating a module acts as zero on the constant sheaf it generates. -/
theorem smul_id_constantSheaf_eq_zero (M : ModuleCat.{w} R) (r : R) (hr : ∀ m : M, r • m = 0) :
    r • 𝟙 ((constantSheaf J (ModuleCat.{w} R)).obj M) = 0 :=
  smul_id_eq_zero_of_sections J _ r
    fun U y => smul_constantSections_eq_zero J U.unop M r hr y

/-- Sheaves of `R`-modules have coproducts indexed by an ideal of `R`. -/
instance hasColimitsOfShapeIdeal [HasSheafify J (ModuleCat.{w} R)] :
    HasColimitsOfShape (Discrete I) (Sheaf J (ModuleCat.{w} R)) :=
  CategoryTheory.Sheaf.instHasColimitsOfShape (K := Discrete I)

variable [HasSheafify J (ModuleCat.{w} R)]

/-- Multiplication by the elements of the ideal `I`, as a single map
`∐_{f ∈ I} F ⟶ F` whose component at `f` is multiplication by `f`. Its image is the ideal
multiple `I · F`, and its cokernel is `F/I F`. -/
noncomputable def idealSmulMap (F : Sheaf J (ModuleCat.{w} R)) :
    (∐ fun _ : I => F) ⟶ F :=
  Sigma.desc fun f => (f : R) • 𝟙 F

/-- The component of `idealSmulMap` at `f ∈ I` is multiplication by `f`. -/
@[simp]
theorem sigma_ι_comp_idealSmulMap (F : Sheaf J (ModuleCat.{w} R)) (f : I) :
    Sigma.ι (fun _ : I => F) f ≫ idealSmulMap J I F = (f : R) • 𝟙 F :=
  colimit.ι_desc _ _

/-- A map out of `F` killed by every element of `I` kills the ideal multiple `I · F`. -/
theorem idealSmulMap_comp_of_smul_id_eq_zero (F G : Sheaf J (ModuleCat.{w} R))
    (g : F ⟶ G) (hg : ∀ f : I, (f : R) • 𝟙 G = 0) :
    idealSmulMap J I F ≫ g = 0 := by
  refine Sigma.hom_ext _ _ fun f => ?_
  rw [comp_zero, ← Category.assoc, sigma_ι_comp_idealSmulMap, Linear.smul_comp,
    Category.id_comp, ← Category.comp_id g, ← Linear.comp_smul, hg f, comp_zero]

/-- Every element of `I` acts as zero on `(R/I)̲`, so the canonical map `R̲^∧ ⟶ (R/I)̲` kills
the ideal multiple `I · R̲^∧`. -/
theorem idealSmulMap_comp_completedConstantSheafResidueMap :
    idealSmulMap J I (completedConstantSheaf J I) ≫ completedConstantSheafResidueMap J I = 0 := by
  refine idealSmulMap_comp_of_smul_id_eq_zero J I _ _ _ fun f => ?_
  refine smul_id_constantSheaf_eq_zero J (ModuleCat.of R (R ⧸ I)) (f : R) fun m => ?_
  induction m using Submodule.Quotient.induction_on with
  | _ a => exact (Submodule.Quotient.mk_eq_zero _).2 (I.mul_mem_right a f.2)

end Smul

/-! ### The sections of the completed ideal sheaf are the ideal times the sections -/

section Sections

variable [IsNoetherianRing R] [HasSheafify J (ModuleCat.{w} R)] [HasWeakSheafify J (Type w)]
  [J.PreservesSheafification (forget (ModuleCat.{w} R))]
  [J.HasSheafCompose (forget (ModuleCat.{w} R))]

private theorem sectionsIso_hom_comp_eval_aux (U : C) (n : ℕᵒᵖ)
    [PreservesLimitsOfShape ℕᵒᵖ ((sheafSections J (ModuleCat.{w} R)).obj (op U))] :
    ((preservesLimitIso ((sheafSections J (ModuleCat.{w} R)).obj (op U))
          (adicQuotientSheafSystem J I)).hom ≫
        (HasLimit.isoOfNatIso (asIso (sectionsTowerComparison J I U))).symm.hom ≫
        ((limit.isLimit (quotientTower I ((constantSections J U (R := R)).obj
            (ModuleCat.of R R)))).conePointUniqueUpToIso
          (adicCompletionIsLimit I ((constantSections J U (R := R)).obj
            (ModuleCat.of R R)))).hom) ≫
      (adicCompletionCone I ((constantSections J U (R := R)).obj (ModuleCat.of R R))).π.app n ≫
        (sectionsTowerComparison J I U).app n =
      ((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (limit.π (adicQuotientSheafSystem J I) n) := by
  have h1 : ((limit.isLimit (quotientTower I ((constantSections J U (R := R)).obj
          (ModuleCat.of R R)))).conePointUniqueUpToIso
        (adicCompletionIsLimit I ((constantSections J U (R := R)).obj
          (ModuleCat.of R R)))).hom ≫
      (adicCompletionCone I ((constantSections J U (R := R)).obj (ModuleCat.of R R))).π.app n ≫
        (sectionsTowerComparison J I U).app n =
      limit.π (quotientTower I ((constantSections J U (R := R)).obj (ModuleCat.of R R))) n ≫
        (sectionsTowerComparison J I U).app n := by
    rw [← Category.assoc]
    exact congrArg (fun g => g ≫ (sectionsTowerComparison J I U).app n)
      (IsLimit.conePointUniqueUpToIso_hom_comp _ _ n)
  have h5 : (asIso (sectionsTowerComparison J I U)).inv.app n ≫
      (sectionsTowerComparison J I U).app n = 𝟙 _ :=
    (asIso (sectionsTowerComparison J I U)).inv_hom_id_app n
  have h2 : (HasLimit.isoOfNatIso (asIso (sectionsTowerComparison J I U))).symm.hom ≫
      limit.π (quotientTower I ((constantSections J U (R := R)).obj (ModuleCat.of R R))) n ≫
        (sectionsTowerComparison J I U).app n =
      limit.π (adicQuotientSheafSystem J I ⋙
        (sheafSections J (ModuleCat.{w} R)).obj (op U)) n := by
    rw [← Category.assoc, Iso.symm_hom, HasLimit.isoOfNatIso_inv_π, Category.assoc, h5,
      Category.comp_id]
  simp only [Category.assoc, h1, h2]
  exact preservesLimitIso_hom_π _ _ n

/-- The identification of `Γ(U, R̲^∧)` with the `I`-adic completion of `Γ(U, R̲)` carries the
evaluation at level `n` of the completion to the projection of `R̲^∧` onto `(R/Iⁿ)̲`, read
through the level-`n` tower comparison. -/
theorem sectionsIso_hom_comp_eval (U : C) (n : ℕᵒᵖ) :
    (completedConstantSheafSectionsIso J I U).hom ≫ ModuleCat.ofHom
        (AdicCompletion.eval I ((constantSections J U (R := R)).obj (ModuleCat.of R R)) n.unop) ≫
        (sectionsTowerComparison J I U).app n =
      ((sheafSections J (ModuleCat.{w} R)).obj (op U)).map (completedConstantSheafπ J I n) :=
  have : PreservesLimitsOfShape ℕᵒᵖ ((sheafSections J (ModuleCat.{w} R)).obj (op U)) :=
    preservesLimitsOfShape_of_natIso
      (sheafSectionsNatIsoEvaluation (J := J) (A := ModuleCat.{w} R) (X := U)).symm
  sectionsIso_hom_comp_eval_aux J I U n

/-- The kernel of `Γ(U, R̲^∧) ⟶ Γ(U, (R/Iⁿ)̲)` is `Iⁿ · Γ(U, R̲^∧)`. This is the Artin-Rees
theorem for the `I`-adic completion of `Γ(U, R̲)`, transported along
`completedConstantSheafSectionsIso`. -/
theorem ker_sections_completedConstantSheafπ (U : C) (n : ℕ) :
    LinearMap.ker (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (completedConstantSheafπ J I (op n))).hom =
      (I ^ n) • (⊤ : Submodule R (((sheafSections J (ModuleCat.{w} R)).obj (op U)).obj
        (completedConstantSheaf J I))) :=
  Stacks.AdicCompletion.ker_eq_pow_smul_top_of_equiv I n
    (completedConstantSheafSectionsIso J I U).toLinearEquiv _
    ((sectionsTowerComparison J I U).app (op n)).hom
    (bijective_sectionsTowerComparison_app J I U (op n)).injective fun x =>
      (LinearMap.congr_fun (congrArg ModuleCat.Hom.hom
        (sectionsIso_hom_comp_eval J I U (op n))) x).symm

/-- The kernel of `Γ(U, R̲^∧) ⟶ Γ(U, (R/I)̲)` is `I · Γ(U, R̲^∧)`. -/
theorem ker_sections_completedConstantSheafResidueMap (U : C) :
    LinearMap.ker (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (completedConstantSheafResidueMap J I)).hom =
      I • (⊤ : Submodule R (((sheafSections J (ModuleCat.{w} R)).obj (op U)).obj
        (completedConstantSheaf J I))) := by
  have hinj : Function.Injective
      (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        ((constantSheaf J (ModuleCat.{w} R)).map (adicQuotientOneMap I))).hom :=
    ((ConcreteCategory.isIso_iff_bijective _).1 inferInstance).injective
  have hmc : ((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (completedConstantSheafResidueMap J I) =
      ((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          (completedConstantSheafπ J I (op 1)) ≫
        ((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          ((constantSheaf J (ModuleCat.{w} R)).map (adicQuotientOneMap I)) := by
    rw [← Functor.map_comp]
    rfl
  rw [hmc, ModuleCat.hom_comp, LinearMap.ker_comp_of_ker_eq_bot _ (LinearMap.ker_eq_bot.2 hinj),
    ker_sections_completedConstantSheafπ J I U 1, pow_one]

/-- On every object `U` of the site the sections of the completed constant ideal sheaf inside
`Γ(U, R̲^∧)` are exactly `I · Γ(U, R̲^∧)`. -/
@[stacks 093M "I Λ̂(U) = Î(U) on every object"]
theorem range_sections_completedConstantIdealSheafInclusion (U : C) :
    LinearMap.range (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (completedConstantIdealSheafInclusion J I)).hom =
      I • (⊤ : Submodule R (((sheafSections J (ModuleCat.{w} R)).obj (op U)).obj
        (completedConstantSheaf J I))) := by
  have hex : LinearMap.range (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
      (completedConstantIdealSheafInclusion J I)).hom =
      LinearMap.ker (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
        (completedConstantSheafResidueMap J I)).hom :=
    (ShortComplex.moduleCat_exact_iff_range_eq_ker _).1
      (shortExact_map_completedConstantIdealShortComplex_sections J I U).exact
  rw [hex, ker_sections_completedConstantSheafResidueMap]

/-! ### The identification `Λ̂/IΛ̂ = (Λ/I)̲` -/

/-- The factorisation of the ideal multiplication map `∐_{f ∈ I} R̲^∧ ⟶ R̲^∧` through the
completed constant ideal sheaf, which contains the ideal multiple `I · R̲^∧`. -/
noncomputable def completedConstantIdealSheafLift :
    (∐ fun _ : I => completedConstantSheaf J I) ⟶ completedConstantIdealSheaf J I :=
  haveI : Mono (completedConstantIdealShortComplex J I).f :=
    (shortExact_completedConstantIdealShortComplex J I).mono_f
  (shortExact_completedConstantIdealShortComplex J I).exact.lift
    (idealSmulMap J I (completedConstantSheaf J I))
    (idealSmulMap_comp_completedConstantSheafResidueMap J I)

omit [IsNoetherianRing R] in
/-- Composing `completedConstantIdealSheafLift` with the inclusion `I̲^∧ ⟶ R̲^∧` recovers the
ideal multiplication map `∐_{f ∈ I} R̲^∧ ⟶ R̲^∧`. -/
@[simp]
theorem completedConstantIdealSheafLift_comp_inclusion :
    completedConstantIdealSheafLift J I ≫ completedConstantIdealSheafInclusion J I =
      idealSmulMap J I (completedConstantSheaf J I) :=
  have : Mono (completedConstantIdealShortComplex J I).f :=
    (shortExact_completedConstantIdealShortComplex J I).mono_f
  (shortExact_completedConstantIdealShortComplex J I).exact.lift_f _ _

omit [IsNoetherianRing R] in
/-- A map out of `I̲^∧` killing the image of `∐_{f ∈ I} R̲^∧` has a kernel whose sections over `U`
contain, inside `Γ(U, R̲^∧)`, the ideal multiple `I · Γ(U, R̲^∧)`. -/
theorem smul_top_le_map_ker_of_completedConstantIdealSheafLift_comp_eq_zero
    {Z : Sheaf J (ModuleCat.{w} R)} (h : completedConstantIdealSheaf J I ⟶ Z)
    (hh : completedConstantIdealSheafLift J I ≫ h = 0) (U : C) :
    I • (⊤ : Submodule R (((sheafSections J (ModuleCat.{w} R)).obj (op U)).obj
        (completedConstantSheaf J I))) ≤
      Submodule.map (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          (completedConstantIdealSheafInclusion J I)).hom
        (LinearMap.ker (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map h).hom) := by
  refine Submodule.smul_le.2 fun r hr y _ => ?_
  have hcomp : ∀ {Z' : Sheaf J (ModuleCat.{w} R)} (g : completedConstantIdealSheaf J I ⟶ Z') (y),
      (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map g).hom
          ((((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
            (Sigma.ι (fun _ : I => completedConstantSheaf J I) ⟨r, hr⟩ ≫
              completedConstantIdealSheafLift J I)).hom y) =
        (((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          (Sigma.ι (fun _ : I => completedConstantSheaf J I) ⟨r, hr⟩ ≫
            completedConstantIdealSheafLift J I ≫ g)).hom y := fun g y => by
    rw [← ModuleCat.comp_apply, ← Functor.map_comp, Category.assoc]
  refine ⟨(((sheafSections J (ModuleCat.{w} R)).obj (op U)).map
    (Sigma.ι (fun _ : I => completedConstantSheaf J I) ⟨r, hr⟩ ≫
      completedConstantIdealSheafLift J I)).hom y, LinearMap.mem_ker.2 ?_, ?_⟩
  · rw [hcomp, hh, comp_zero, Functor.map_zero]
    rfl
  · rw [hcomp, completedConstantIdealSheafLift_comp_inclusion, sigma_ι_comp_idealSmulMap,
      Functor.map_smul, CategoryTheory.Functor.map_id]
    rfl

/-- The elements of `I` generate the completed constant ideal sheaf over the completed constant
sheaf: the factorisation of `∐_{f ∈ I} R̲^∧ ⟶ R̲^∧` through `I̲^∧` is an epimorphism, i.e.
`I · R̲^∧ = I̲^∧` as subsheaves of `R̲^∧`. -/
@[stacks 093M "I Λ̂ = Î"]
instance epi_completedConstantIdealSheafLift : Epi (completedConstantIdealSheafLift J I) := by
  refine (Preadditive.epi_iff_cancel_zero _).2 fun Z h hh => ?_
  refine Stacks.Sheaf.hom_eq_zero_of_sections J _ fun U => ?_
  refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  obtain ⟨x', hx', he⟩ :=
    smul_top_le_map_ker_of_completedConstantIdealSheafLift_comp_eq_zero J I h hh U
      ((range_sections_completedConstantIdealSheafInclusion J I U).le
        (LinearMap.mem_range_self _ x))
  obtain rfl := (ModuleCat.mono_iff_injective _).1
    (shortExact_map_completedConstantIdealShortComplex_sections J I U).mono_f he
  exact LinearMap.mem_ker.1 hx'

/-- The canonical isomorphism `R̲^∧/I R̲^∧ ≅ (R/I)̲` from the quotient of the completed constant
sheaf by the ideal it is completed at to the constant sheaf of the quotient ring. -/
@[stacks 093M "Λ̂/IΛ̂ = (Λ/I)̲"]
noncomputable def completedConstantSheaf_quotientByIdealSmul :
    cokernel (idealSmulMap J I (completedConstantSheaf J I)) ≅
      (constantSheaf J (ModuleCat.{w} R)).obj (ModuleCat.of R (R ⧸ I)) :=
  cokernelIsoOfEq (completedConstantIdealSheafLift_comp_inclusion J I).symm ≪≫
    cokernelEpiComp (completedConstantIdealSheafLift J I)
      (completedConstantIdealSheafInclusion J I) ≪≫
    completedConstantSheaf_quotientByCompletedIdeal J I

/-- The isomorphism `R̲^∧/I R̲^∧ ≅ (R/I)̲` carries the cokernel projection to the canonical map
`R̲^∧ ⟶ (R/I)̲`. -/
@[stacks 093M "Λ̂/IΛ̂ = (Λ/I)̲"]
theorem completedConstantSheaf_quotientByIdealSmul_hom_comp :
    cokernel.π (idealSmulMap J I (completedConstantSheaf J I)) ≫
        (completedConstantSheaf_quotientByIdealSmul J I).hom =
      completedConstantSheafResidueMap J I := by
  rw [completedConstantSheaf_quotientByIdealSmul, Iso.trans_hom, Iso.trans_hom,
    ← Category.assoc, ← Category.assoc, π_comp_cokernelIsoOfEq_hom, cokernelEpiComp_hom,
    cokernel.π_desc, completedConstantSheaf_quotientByCompletedIdeal_hom_comp]

end Sections

