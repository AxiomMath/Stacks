* [Stacks Project, Tag 03CH](https://stacks.math.columbia.edu/tag/03CH)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open Stacks.LocalizedDenseSubsite

universe w u v

namespace Stacks.Sheaves.SpecialCocontinuous

variable {C : Type u} [Category.{v} C] {D : Type u} [Category.{v} D]
  (J : GrothendieckTopology C) (K : GrothendieckTopology D)
  (G : C ⥤ D) [G.IsDenseSubsite J K] [G.IsCocontinuous J K]
  (R : Sheaf K RingCat.{w})
  [∀ (U : C) (X : (Over (G.obj U))ᵒᵖ),
    HasLimitsOfShape (StructuredArrow X (Over.post (X := U) G).op) AddCommGrpCat.{w}]
  [∀ V : D, HasWeakSheafify (K.over V) AddCommGrpCat.{w}]
  [∀ V : D, (K.over V).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- A cofan of global sections exhibiting `F.over V` as free stays a cofan exhibiting the
restriction of `F` to the slice at `W` as free, after `sliceRestriction`. -/
private noncomputable def isColimitCofanSliceRestriction {B : Type*} (F : SheafOfModules.{w} R)
    (W : C) (V : D) (a : G.obj W ⟶ V)
    [PreservesColimitsOfShape (Discrete B) (sliceRestriction J K G R W V a)]
    (ι : B → (SheafOfModules.unit (R.over V) ⟶ F.over V))
    (hc : IsColimit (Cofan.mk (F.over V) ι)) :
    IsColimit (Cofan.mk
      (((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).over W)
      fun b ↦ (sliceRestrictionUnitIso J K G R W V a).inv ≫
        (sliceRestriction J K G R W V a).map (ι b) ≫
          (sliceRestrictionObjIso J K G R W V a F).hom) :=
  (Stacks.Sheaves.GlobalTypeComparison.isColimitCofanMap
      (sliceRestriction J K G R W V a) (sliceRestrictionUnitIso J K G R W V a) ι
      hc).ofIsoColimit
    (Cocone.ext (sliceRestrictionObjIso J K G R W V a F) (by rintro ⟨⟩; simp))

/-- **The special cocontinuous case of Stacks 03DM for the clause 03DL (1): local freeness.**  A
sheaf of modules on a site is locally free if and only if its restriction to a dense subsite
along a cocontinuous functor is locally free over the restricted structure sheaf.  The clause
for an arbitrary equivalence of ringed topoi is
`AlgebraicGeometry.RingedToposHom.isLocallyFreeOnSite_iff_pullbackModules`.

Freeness is the condition of being a coproduct of copies of the structure sheaf, so it is
preserved by the localized restriction, which preserves colimits and matches the structure
sheaves, and reflected by the localized Comparison Lemma, which is in addition fully
faithful. -/
theorem isLocallyFreeOnSite_iff (F : SheafOfModules.{w} R) :
    F.IsLocallyFreeOnSite ↔
      ((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).IsLocallyFreeOnSite := by
  refine forall_exists_cover_iff J K G R (F := F)
    (fun V M ↦ ∃ (B : Type w) (ι : ∀ _ : B, SheafOfModules.unit (R.over V) ⟶ M),
      Nonempty (IsColimit (Cofan.mk M ι)))
    (fun W M ↦ ∃ (B : Type w) (ι : ∀ _ : B, SheafOfModules.unit
        ((Stacks.DenseSubsiteModules.ringRestriction J K G R).over W) ⟶ M),
      Nonempty (IsColimit (Cofan.mk M ι))) ?_ ?_
  · rintro W V a ⟨B, ι, ⟨hc⟩⟩
    exact ⟨B, _, ⟨isColimitCofanSliceRestriction J K G R F W V a ι hc⟩⟩
  · rintro W ⟨B, ι, ⟨hc⟩⟩
    exact ⟨B, _, ⟨Stacks.Sheaves.GlobalTypeComparison.isColimitCofanOfMap
      (sliceEquivalence J K G R W).functor (sliceEquivalenceUnitIso J K G R W)
      (F := F.over (G.obj W)) ι hc⟩⟩

/-- **The special cocontinuous case of Stacks 03DM for the clause 03DL (2): finite local
freeness.**  A sheaf of modules on a site is finite locally free if and only if its restriction
to a dense subsite along a cocontinuous functor is finite locally free over the restricted
structure sheaf.  The clause for an arbitrary equivalence of ringed topoi is
`AlgebraicGeometry.RingedToposHom.isFiniteLocallyFreeOnSite_iff_pullbackModules`.

The index type of the finite free cofan is unchanged by either comparison, so the rank is
unchanged as well; `SheafOfModules.isFiniteFree_iff_exists_isColimit` is what turns finite
freeness into such a cofan, the ring and module universes here agreeing. -/
theorem isFiniteLocallyFreeOnSite_iff (F : SheafOfModules.{w} R) :
    F.IsFiniteLocallyFreeOnSite ↔
      ((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).IsFiniteLocallyFreeOnSite := by
  refine forall_exists_cover_iff J K G R (F := F)
    (fun V M ↦ SheafOfModules.IsFiniteFree (R.over V) M)
    (fun W M ↦ SheafOfModules.IsFiniteFree
      ((Stacks.DenseSubsiteModules.ringRestriction J K G R).over W) M) ?_ ?_
  · intro W V a h
    obtain ⟨n, ι, ⟨hc⟩⟩ := (SheafOfModules.isFiniteFree_iff_exists_isColimit _ _).1 h
    have _ : PreservesColimitsOfSize.{0, 0} (sliceRestriction J K G R W V a) :=
      preservesColimitsOfSize_shrink _
    exact (SheafOfModules.isFiniteFree_iff_exists_isColimit _ _).2
      ⟨n, _, ⟨isColimitCofanSliceRestriction J K G R F W V a ι hc⟩⟩
  · intro W h
    exact (Stacks.Sheaves.GlobalTypeComparison.isFiniteFree_iff
      (sliceEquivalence J K G R W).functor (sliceEquivalenceUnitIso J K G R W)
      (F.over (G.obj W))).2 h

variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **The special cocontinuous case of Stacks 03DM for the clause 03DL (3): local generation by
sections.**  A sheaf of modules on a site is locally generated by sections if and only if its
restriction to a dense subsite along a cocontinuous functor is locally generated by sections
over the restricted structure sheaf.  The clause for an arbitrary equivalence of ringed topoi is
`AlgebraicGeometry.RingedToposHom.isLocallyGeneratedBySectionsOnSite_iff_pullbackModules`.

A generating family of global sections is carried forward by
`SheafOfModules.GeneratingSections.map`, which needs only colimit preservation and the
comparison of the structure sheaves, and back by
`Stacks.Sheaves.GlobalTypeComparison.generatingSectionsOfMap`; the index type is unchanged by
both.  The covering of an object is recorded in the clause as a family covering the terminal
object of the slice site, and
`Stacks.LocalizedDenseSubsite.forall_exists_coversTop_iff_forall_exists_ofArrows` rewrites that
as a family of arrows generating a covering sieve, which is the form the covering transport
takes. -/
theorem isLocallyGeneratedBySectionsOnSite_iff (F : SheafOfModules.{w} R) :
    F.IsLocallyGeneratedBySectionsOnSite ↔
      ((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj
        F).IsLocallyGeneratedBySectionsOnSite := by
  let _ : ∀ V : D, HasSheafify (K.over V) AddCommGrpCat.{w} :=
    fun _ ↦ AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  let _ : ∀ U : C, HasSheafify (J.over U) AddCommGrpCat.{w} :=
    fun _ ↦ AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  refine Iff.trans (forall_exists_coversTop_iff_forall_exists_ofArrows K
      (fun V ↦ Nonempty ((F.over V).GeneratingSections)))
    (Iff.trans ?_ (forall_exists_coversTop_iff_forall_exists_ofArrows J
      (fun W ↦ Nonempty
        ((((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).over
          W).GeneratingSections))).symm)
  refine forall_exists_cover_iff J K G R (F := F)
    (fun V M ↦ Nonempty M.GeneratingSections) (fun W M ↦ Nonempty M.GeneratingSections) ?_ ?_
  · rintro W V a ⟨σ⟩
    exact ⟨SheafOfModules.GeneratingSections.equivOfIso
      (sliceRestrictionObjIso J K G R W V a F)
      (σ.map (sliceRestriction J K G R W V a)
        (sliceRestrictionUnitIso J K G R W V a).symm)⟩
  · rintro W ⟨σ⟩
    exact ⟨Stacks.Sheaves.GlobalTypeComparison.generatingSectionsOfMap
      (sliceEquivalence J K G R W).functor (sliceEquivalenceUnitIso J K G R W)
      (F := F.over (G.obj W)) σ⟩

/-- **The special cocontinuous case of Stacks 03DM for the clause 03DL (6): quasi-coherence.**  A
sheaf of modules on a site is quasi-coherent if and only if its restriction to a dense subsite
along a cocontinuous functor is quasi-coherent over the restricted structure sheaf.  The clause
for an arbitrary equivalence of ringed topoi is
`AlgebraicGeometry.RingedToposHom.isQuasicoherentOnSite_iff_pullbackModules`.

The forward implication is `Stacks.SheafOfModules.isQuasicoherentOnSite_restriction`, which holds
for any continuous cocontinuous functor of sites.  The reverse one is the localization of
Section 03DG: a quasi-coherent datum for the restricted module is transported along the family of
inverses of the localized Comparison Lemmas, which is exactly a
`Stacks.SheafOfModules.QuasicoherentData.MapData` for the inverse of the Comparison Lemma, and
`Stacks.SheafOfModules.isQuasicoherentOnSite_of_forall_mapData` then concludes.  The images of
the covering family of the datum again cover the final object by
`Stacks.LocalizedDenseSubsite.coversTop_map`.

The slices of the subsite are asked to be essentially small in the universe of the module
sections, which is what turns quasi-coherence on the site back into a quasi-coherent datum
whose presentations are indexed in that universe; the sites of the source are small, so this is
no restriction on the source statement. -/
theorem isQuasicoherentOnSite_iff
    [∀ X : Dᵒᵖ, HasLimitsOfShape (StructuredArrow X G.op) AddCommGrpCat.{w}]
    [∀ W : C, EssentiallySmall.{w} (Over W)]
    (F : SheafOfModules.{w} R) :
    F.IsQuasicoherentOnSite ↔
      ((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).IsQuasicoherentOnSite := by
  refine ⟨fun h ↦ Stacks.SheafOfModules.isQuasicoherentOnSite_restriction G R F h, fun h ↦ ?_⟩
  let e := Stacks.DenseSubsiteModules.moduleRestrictionEquivalence J K G R
  refine SheafOfModules.IsQuasicoherentOnSite.of_iso (e.unitIso.app F).symm
    (Stacks.SheafOfModules.isQuasicoherentOnSite_of_forall_mapData
      (F := e.inverse) (M := e.functor.obj F)
      (SheafOfModules.IsQuasicoherentOnSite.of_iso
        (moduleRestrictionEquivalenceObjIso J K G R F).symm h) fun q ↦ ?_)
  exact
    { I := q.I
      X := fun i ↦ G.obj (q.X i)
      coversTop := coversTop_map J K G q.X q.coversTop
      index := fun i ↦ i
      functor := fun i ↦ (sliceEquivalence J K G R (q.X i)).inverse
      preservesColimits := fun _ ↦ inferInstance
      unitIso := fun i ↦ (sliceEquivalence J K G R (q.X i)).unitIso.app
            (SheafOfModules.unit (R.over (G.obj (q.X i)))) ≪≫
          (sliceEquivalence J K G R (q.X i)).inverse.mapIso
            (sliceEquivalenceUnitIso J K G R (q.X i))
      overIso := fun i ↦
        (sliceEquivalence J K G R (q.X i)).inverse.mapIso
              ((SheafOfModules.overFunctor
                    (Stacks.DenseSubsiteModules.ringRestriction J K G R) (q.X i)).mapIso
                  (moduleRestrictionEquivalenceObjIso J K G R F) ≪≫
                (sliceEquivalenceObjIso J K G R (q.X i) F).symm) ≪≫
            ((sliceEquivalence J K G R (q.X i)).unitIso.app
              (F.over (G.obj (q.X i)))).symm ≪≫
          (SheafOfModules.overFunctor R (G.obj (q.X i))).mapIso (e.unitIso.app F) }

omit [∀ (U : C) (X : (Over (G.obj U))ᵒᵖ),
    HasLimitsOfShape (StructuredArrow X (Over.post (X := U) G).op) AddCommGrpCat.{w}]
  [∀ V : D, HasWeakSheafify (K.over V) AddCommGrpCat.{w}]
  [∀ V : D, (K.over V).WEqualsLocallyBijective AddCommGrpCat.{w}]
  [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
  [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}] in
/-- **Stacks 03DM for the clause 03DL (8): coherence is intrinsic.**  A sheaf of modules on a
site is coherent if and only if its restriction to a dense subsite along a cocontinuous functor
is coherent over the restricted structure sheaf.

Coherence is two conditions, and both are instances of the sectionwise finite-type condition, so
both travel by `Stacks.DenseSubsiteModules.isFiniteType_pushforward₀_iff`: the module itself is
of finite type, and so is the presheaf of relations among every finite family of sections on
every slice site.  The relations presheaf needs no comparison of its own, because restricting
the sections of the module along `G` and then taking relations over an object `U` of `C` is, on
the nose, taking relations over `G.obj U` and restricting along `Over.post G`.

The clause for an arbitrary equivalence of ringed topoi is
`AlgebraicGeometry.RingedToposHom.isCoherentOnSite_iff_pullbackModules`, which carries this one
along the *one-sided* factorization of Stacks 03CR: coherence is the one clause of Stacks 03DL
which does not travel along the bottom arrow of the two-sided square, so a dense subsite
inclusion is the only side of a replacement it can be read across, and the statement below is
what that reduction consumes.

The source handles the two conditions in the same order, and the asymmetry of its argument
survives here.  In the forward direction every object at which the relations condition is asked
is an object `U` of `C`, so the condition is read at `G.obj U` and transported down.  In the
reverse direction it is asked at an arbitrary object `V` of `D`, which the hypothesis cannot see;
the objects of the slice over `V` which are images of `G` cover it, since `G` is cover dense, and
the relations among a family of sections over `V` restricted to such an image are the relations
among the restricted family, so the condition descends by
`Stacks.SheafOfModules.relations_isFiniteType_of_coversTop`.  That is the source's own
"replacing `V` by `V'`" step, and it is the reason this clause is not an instance of the covering
transport that carries the other clauses. -/
theorem isCoherentOnSite_iff (F : SheafOfModules.{w} R) :
    F.IsCoherentOnSite ↔
      ((Stacks.DenseSubsiteModules.moduleRestriction J K G R).obj F).IsCoherentOnSite := by
  refine ⟨fun h ↦ ⟨Stacks.DenseSubsiteModules.isFiniteType_pushforward₀ J K G F.val h.isFiniteType,
      fun W n s ↦ Stacks.DenseSubsiteModules.isFiniteType_pushforward₀ (J.over W) (K.over (G.obj W))
        (Over.post (X := W) G) (PresheafOfModules.relations F.val (U := G.obj W) s)
        (h.kernel_isFiniteType (G.obj W) n s)⟩,
    fun h ↦ ⟨Stacks.DenseSubsiteModules.isFiniteType_of_pushforward₀ J K G F.val h.isFiniteType,
      fun V n s ↦ ?_⟩⟩
  refine Stacks.SheafOfModules.relations_isFiniteType_of_coversTop F s
    (fun j : Σ W : C, G.obj W ⟶ V ↦ Over.mk j.2) (fun Z ↦ ?_) ?_
  · have _ := Functor.IsDenseSubsite.isCoverDense J K G
    rw [K.mem_over_iff]
    refine K.superset_covering ?_ (G.is_cover_of_isCoverDense K Z.left)
    rintro T c ⟨⟨W, lift, mp, fac⟩⟩
    rw [Sieve.overEquiv_iff, Sieve.mem_ofObjects_iff]
    refine ⟨⟨W, mp ≫ Z.hom⟩, ⟨Over.homMk lift ?_⟩⟩
    change lift ≫ mp ≫ Z.hom = c ≫ Z.hom
    rw [← Category.assoc, fac]
  · rintro ⟨W, b⟩
    exact Stacks.DenseSubsiteModules.isFiniteType_of_pushforward₀ (J.over W)
      (K.over (G.obj W)) (Over.post (X := W) G)
      (PresheafOfModules.relations F.val (U := G.obj W)
        (fun j ↦ F.val.restrictₛₗ b.op (s j)))
      (h.kernel_isFiniteType W n (fun j ↦ F.val.restrictₛₗ b.op (s j)))

end Stacks.Sheaves.SpecialCocontinuous

end
