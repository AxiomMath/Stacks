/-!
# The universe lift of sheaves of modules preserves injective objects

Let `(C, J)` be a site which is essentially small relative to a universe `z`, and let `R` be a
sheaf of rings on it with values in `RingCat.{z}`. The universe lift
`Stacks.SheafOfModules.moduleULift : Mod_z(R) ⥤ Mod_{max z t}(R)` is fully faithful and exact,
and its essential image consists of the sheaves of modules with `z`-small sections
(`Stacks.SheafOfModules.moduleULift_essImage_iff`). This file proves that it also preserves
injective objects.

## The argument

Every section `m` of a sheaf of modules `N` lies in a subsheaf with `z`-small sections: the local
closure of the presheaf submodule spanned by the restrictions of `m`
(`Stacks.SheafOfModules.small_localClosure_obj`). The span is `z`-small because the
hom-sets of the site and the rings are, and the local closure stays `z`-small because a section
of it is determined by the family of its restrictions that lie in the span, over the objects of a
`z`-small model of the site (`Stacks.SheafOfModules.small_sheafify_obj_of_essentiallySmall`).

Consequently the lift of a separator `G₀` of `Mod_z(R)` is a separator of `Mod_{max z t}(R)`
(`Stacks.SheafOfModules.isSeparator_moduleULift_obj`): a morphism killed by every map out of the
lift of `G₀` is killed on the subsheaf with small sections through any given section, because
that subsheaf and the image there of the morphism come from `Mod_z(R)`.

Every subobject of the lift of `G₀` has `z`-small sections, a monomorphism being sectionwise
injective, so it comes from `Mod_z(R)` too; hence the lift of an injective object of `Mod_z(R)`
has the right lifting property with respect to the inclusions of the subobjects of the separator,
and in a Grothendieck abelian category that is the right lifting property with respect to all
monomorphisms (`CategoryTheory.IsGrothendieckAbelian.generatingMonomorphisms_rlp`), that is,
injectivity. This is Baer's criterion, in the form Mathlib proves it.

## Main results

* `Stacks.SheafOfModules.small_sheafify_obj_of_essentiallySmall`: a subfunctor with small sections
  of a separated presheaf on an essentially small site generates a subsheaf with small sections.
* `Stacks.SheafOfModules.submoduleGeneratedBy`: the presheaf submodule spanned by the
  restrictions of a section.
* `Stacks.SheafOfModules.isSeparator_moduleULift_obj`: the lift of a separator is a separator.
* `Stacks.SheafOfModules.injective_moduleULift_obj`: the lift of an injective object is injective.
* `Stacks.SheafOfModules.preservesInjectiveObjects_moduleULift`: the same, as an instance-shaped
  statement.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe t z u₁ v₁ w₁

namespace Stacks.SheafOfModules

/-! ### Subsheaves generated by small subfunctors -/

section Smallness

variable {C : Type u₁} [Category.{v₁} C] (J : GrothendieckTopology C) {F : Cᵒᵖ ⥤ Type w₁}

/-- **A subfunctor with small sections generates a subsheaf with small sections, on an
essentially small site.** A section of the subsheaf generated by `G` is determined by the family
of its restrictions that lie in `G`, because that family is defined on a covering sieve and the
ambient presheaf is separated; and it is enough to know that family over the objects of a small
model of the site, every object being isomorphic to one of them.

This is `Stacks.NoncommChangeOfRings.Silver.small_sheafify_obj` with the hypothesis that the site
be small replaced by essential smallness. -/
theorem small_sheafify_obj_of_essentiallySmall (G : Subfunctor F)
    (hF : Presieve.IsSeparated J F) [∀ Y : Cᵒᵖ, Small.{z} (G.obj Y)] [EssentiallySmall.{z} C]
    (X : Cᵒᵖ) : Small.{z} ((G.sheafify J).obj X) := by
  let e := equivSmallModel.{z} C
  refine small_of_injective (f := fun s : ((G.sheafify J).obj X) ↦
    (fun (Y : SmallModel.{z} C) (f : e.inverse.obj Y ⟶ X.unop) ↦
      {x : G.obj (op (e.inverse.obj Y)) | x.1 = F.map f.op s.1})) ?_
  intro s s' h
  refine Subtype.ext ((hF _ s.2).ext fun Y f hf ↦ ?_)
  let i : e.inverse.obj (e.functor.obj Y) ≅ Y := e.unitIso.symm.app Y
  have hf' : F.map (i.hom ≫ f).op s.1 ∈ G.obj (op (e.inverse.obj (e.functor.obj Y))) := by
    rw [op_comp, F.map_comp, types_comp_apply]
    exact G.map i.hom.op hf
  have h₂ : ({x : G.obj (op (e.inverse.obj (e.functor.obj Y))) |
      x.1 = F.map (i.hom ≫ f).op s.1} : Set _) =
      {x : G.obj (op (e.inverse.obj (e.functor.obj Y))) | x.1 = F.map (i.hom ≫ f).op s'.1} :=
    congrFun (congrFun h (e.functor.obj Y)) (i.hom ≫ f)
  have h₃ : (⟨F.map (i.hom ≫ f).op s.1, hf'⟩ : G.obj (op (e.inverse.obj (e.functor.obj Y)))) ∈
      ({x : G.obj (op (e.inverse.obj (e.functor.obj Y))) |
        x.1 = F.map (i.hom ≫ f).op s'.1} : Set _) := by
    rw [← h₂]
    rfl
  have h₄ := congrArg (F.map i.inv.op) h₃
  simp only [← Functor.map_comp_apply, ← op_comp] at h₄
  rwa [Iso.inv_hom_id_assoc] at h₄

end Smallness

/-! ### The subsheaf generated by a section -/

section Generation

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{z}}

/-- **The presheaf submodule spanned by the restrictions of a section** `m` of `M` over `U`: over
`X` it is the span of the restrictions of `m` along all arrows `U ⟶ X` of `Cᵒᵖ`. -/
def submoduleGeneratedBy (M : PresheafOfModules.{w₁} R.obj) {U : Cᵒᵖ}
    (m : M.obj U) : M.Submodule where
  obj X := Submodule.span (R.obj.obj X) (Set.range fun g : U ⟶ X => M.map g m)
  map {X Y} f := by
    rw [Submodule.span_le]
    rintro _ ⟨g, rfl⟩
    change M.map f (M.map g m) ∈ Submodule.span (R.obj.obj Y)
      (Set.range fun g : U ⟶ Y => M.map g m)
    rw [← PresheafOfModules.map_comp_apply]
    exact Submodule.subset_span ⟨g ≫ f, rfl⟩

end Generation

/-! ### Subsheaves with small sections -/

section SmallSubsheaves

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{z}}
  [EssentiallySmall.{z} C]

/-- The span of the restrictions of a section has `z`-small sections: it is spanned by a family
indexed by a hom-set of the site, over a ring of sections in `Type z`. -/
instance small_submoduleGeneratedBy_obj (M : PresheafOfModules.{w₁} R.obj) {U : Cᵒᵖ} (m : M.obj U)
    (X : Cᵒᵖ) : Small.{z} ((submoduleGeneratedBy M m).obj X) :=
  have : Small.{z} (U ⟶ X) := LocallySmall.hom_small U X
  have : Small.{z} (Set.range fun g : U ⟶ X => M.map g m) := small_range _
  Submodule.small_span _

/-- **The local closure of a presheaf submodule with small sections has small sections**, on an
essentially small site: its underlying subfunctor is the subsheaf generated by the submodule
(`Stacks.SheafOfModules.small_sheafify_obj_of_essentiallySmall`). -/
theorem small_localClosure_obj (M : _root_.SheafOfModules.{w₁} R) (P : M.val.Submodule)
    [hP : ∀ X, Small.{z} (P.obj X)] (X : Cᵒᵖ) : Small.{z} ((localClosure M P).obj X) := by
  have : ∀ Y, Small.{z} (P.toSubfunctor.obj Y) := fun Y => hP Y
  have := small_sheafify_obj_of_essentiallySmall.{z} J P.toSubfunctor
    (isSheaf_forgetPresheaf M).isSeparated X
  exact small_of_injective (f := fun s : (localClosure M P).obj X =>
    (⟨s.1, s.2⟩ : (P.toSubfunctor.sheafify J).obj X)) fun s s' h =>
      Subtype.ext (congrArg Subtype.val h)

omit [EssentiallySmall.{z, v₁, u₁} C] in
/-- A section lies in the local closure of the span of its restrictions. -/
theorem mem_localClosure_submoduleGeneratedBy (M : _root_.SheafOfModules.{w₁} R) {U : Cᵒᵖ}
    (m : M.val.obj U) : m ∈ (localClosure M (submoduleGeneratedBy M.val m)).obj U :=
  J.superset_covering (fun Y g _ => by
    change M.val.map g.op m ∈ (submoduleGeneratedBy M.val m).obj (op Y)
    exact Submodule.subset_span ⟨g.op, rfl⟩) (J.top_mem U.unop)

/-- The sectionwise range of a morphism out of a sheaf of modules with `z`-small sections has
`z`-small sections. -/
instance small_presheafRangeSubmodule_obj {M N : _root_.SheafOfModules.{w₁} R} (f : M ⟶ N)
    [∀ X, Small.{z} (M.val.obj X)] (X : Cᵒᵖ) :
    Small.{z} ((presheafRangeSubmodule f.val).obj X) :=
  small_of_surjective (f := fun x : M.val.obj X => (⟨f.val.app X x, x, rfl⟩ :
    (presheafRangeSubmodule f.val).obj X)) fun ⟨_, x, hx⟩ => ⟨x, Subtype.ext hx⟩

end SmallSubsheaves

/-! ### The lift of a separator is a separator -/

section Separator

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{z}}
  [EssentiallySmall.{z} C]

omit [EssentiallySmall.{z, v₁, u₁} C] in
/-- A submodule of a sheaf of modules with `z`-small sections lies in the essential image of the
universe lift. -/
theorem essImage_toSheafOfModules (M : _root_.SheafOfModules.{max z t} R) (P : M.Submodule)
    [∀ X, Small.{z} (P.obj X)] : (moduleULift.{t, z} R).essImage P.toSheafOfModules :=
  (moduleULift_essImage_iff R _).2 fun X => inferInstanceAs (Small.{z} (P.obj X))

/-- **The universe lift of a separator is a separator.** Let `φ : N ⟶ N'` be a morphism of
sheaves of modules at the larger universe killed by every map out of the lift of a separator
`G₀`, and let `m` be a section of `N`. The local closure `N₀` of the span of `m` has small
sections, hence is the lift of a sheaf of modules at universe `z`; so is the local closure of the
range of `N₀ ⟶ N ⟶ N'`, through which that composite factors. The factored map is therefore the
lift of a map at universe `z` killed by every map out of `G₀`, so it vanishes, and with it `φ` at
`m`. -/
theorem isSeparator_moduleULift_obj {G₀ : _root_.SheafOfModules.{z} R} (hG : IsSeparator G₀) :
    IsSeparator ((moduleULift.{t, z} R).obj G₀) := by
  have hff := moduleULiftFullyFaithful.{t, z} R
  rw [Preadditive.isSeparator_iff]
  intro N N' φ hφ
  have key : ∀ (X : Cᵒᵖ) (m : N.val.obj X), φ.val.app X m = 0 := by
    intro X m
    let P₁ := localClosure N (submoduleGeneratedBy N.val m)
    have : ∀ Y, Small.{z} (P₁.obj Y) := small_localClosure_obj N _
    obtain ⟨N₀, ⟨e₁⟩⟩ := essImage_toSheafOfModules N P₁
    let i := e₁.hom ≫ P₁.ι
    have hmem := mem_localClosure_submoduleGeneratedBy N m
    let x := e₁.inv.val.app X ⟨m, hmem⟩
    let ψ := i ≫ φ
    have : ∀ Y, Small.{z} (((moduleULift.{t, z} R).obj N₀).val.obj Y) := fun Y =>
      small_ulift (N₀.val.obj Y)
    let P₂ := localClosure N' (presheafRangeSubmodule ψ.val)
    have : ∀ Y, Small.{z} (P₂.obj Y) := small_localClosure_obj N' _
    obtain ⟨N₁, ⟨e₂⟩⟩ := essImage_toSheafOfModules N' P₂
    let ψ₁ := toLocalClosureRange ψ ≫ e₂.inv
    have hψ : ψ = ψ₁ ≫ e₂.hom ≫ P₂.ι := by
      simp only [ψ₁, Category.assoc, Iso.inv_hom_id_assoc]
      exact (toLocalClosureRange_ι ψ).symm
    have hψ₂ : hff.preimage ψ₁ = 0 := by
      refine (Preadditive.isSeparator_iff G₀).1 hG _ fun h₀ => ?_
      apply hff.map_injective
      rw [Functor.map_comp, hff.map_preimage, Functor.map_zero, ← cancel_mono (e₂.hom ≫ P₂.ι),
        zero_comp, Category.assoc, ← hψ]
      exact (Category.assoc _ _ _).symm.trans (hφ _)
    have hψ0 : ψ = 0 := by
      rw [hψ, ← hff.map_preimage ψ₁, hψ₂, Functor.map_zero, zero_comp]
    have hm : m = i.val.app X x := by
      change m = P₁.ι.val.app X ((e₁.inv ≫ e₁.hom).val.app X ⟨m, hmem⟩)
      rw [Iso.inv_hom_id]
      rfl
    rw [hm]
    exact congrArg (fun k : _ ⟶ N' => k.val.app X x) hψ0
  exact _root_.SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun X => by
    ext m
    exact key X m)

end Separator

/-! ### The lift of an injective object is injective -/

section Injective

variable {C : Type u₁} [Category.{v₁} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{z}}
  [EssentiallySmall.{z} C]
  [HasSheafify J AddCommGrpCat.{max z t}] [J.WEqualsLocallyBijective AddCommGrpCat.{max z t}]
  [IsGrothendieckAbelian.{max z t} (_root_.SheafOfModules.{max z t} R)]

/-- **The universe lift of an injective sheaf of modules is injective** (Baer's criterion). In
the Grothendieck abelian category of sheaves of modules at the larger universe, injectivity is the
right lifting property against the inclusions of the subobjects of a separator
(`CategoryTheory.IsGrothendieckAbelian.generatingMonomorphisms_rlp`), and the lift of a separator
`G₀` of `Mod_z(R)` is one (`Stacks.SheafOfModules.isSeparator_moduleULift_obj`). A subobject of
the lift of `G₀` has small sections, a monomorphism being sectionwise injective, so it is the lift
of a subobject of `G₀`, and the lifting problem is the lift of one at universe `z`, which the
injectivity of `I` solves. -/
@[sga "4 V 0.5" "Clause d), special case", sga "4 V 0.5.2" "special case"]
theorem injective_moduleULift_obj {G₀ : _root_.SheafOfModules.{z} R} (hG : IsSeparator G₀)
    (I : _root_.SheafOfModules.{z} R) [Injective I] :
    Injective ((moduleULift.{t, z} R).obj I) := by
  have hff := moduleULiftFullyFaithful.{t, z} R
  have : (moduleULift.{t, z} R).Faithful := hff.faithful
  rw [injective_iff_rlp_monomorphisms_zero,
    ← IsGrothendieckAbelian.generatingMonomorphisms_rlp (isSeparator_moduleULift_obj.{t} hG)]
  rintro _ _ _ ⟨A⟩
  have : ∀ Y, Small.{z} ((A : _root_.SheafOfModules.{max z t} R).val.obj Y) := fun Y =>
    have : Small.{z} (((moduleULift.{t, z} R).obj G₀).val.obj Y) := small_ulift (G₀.val.obj Y)
    small_of_injective (injective_app_of_mono A.arrow Y)
  obtain ⟨A₀, ⟨eA⟩⟩ := (moduleULift_essImage_iff R (A : _root_.SheafOfModules.{max z t} R)).2
    this
  let j : A₀ ⟶ G₀ := hff.preimage (eA.hom ≫ A.arrow)
  have : Mono j := (moduleULift.{t, z} R).mono_of_mono_map (by
    rw [hff.map_preimage]
    infer_instance)
  refine ⟨fun {f g} sq => ⟨⟨⟨(moduleULift.{t, z} R).map
    (Injective.factorThru (hff.preimage (eA.hom ≫ f)) j), ?_,
      (isZero_zero _).eq_of_tgt _ _⟩⟩⟩⟩
  rw [← cancel_epi eA.hom, ← Category.assoc, ← hff.map_preimage (eA.hom ≫ A.arrow),
    ← Functor.map_comp, Injective.comp_factorThru, hff.map_preimage]

/-- **The universe lift of sheaves of modules preserves injective objects**, on an essentially
small site whose sheaves of modules at the larger universe form a Grothendieck abelian
category. -/
theorem preservesInjectiveObjects_moduleULift [HasSeparator (_root_.SheafOfModules.{z} R)] :
    (moduleULift.{t, z} R).PreservesInjectiveObjects :=
  ⟨fun {I} _ => injective_moduleULift_obj.{t} (isSeparator_separator _) I⟩

end Injective

end Stacks.SheafOfModules

end
