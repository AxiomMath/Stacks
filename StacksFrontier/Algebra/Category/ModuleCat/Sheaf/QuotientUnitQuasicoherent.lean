module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.UnitFinitePresentationSite

/-!
# Quotients of the sheaf of rings by a locally generated submodule are quasi-coherent

Let `R` be a sheaf of rings on a site and `f : M ⟶ unit R` a morphism of sheaves of
`R`-modules into the sheaf of rings regarded as a module over itself. If `M` is generated by
sections, then `cokernel f` has a global presentation: the single section `1` generates it, and
the generators of `M` generate the relations. Consequently, if `M` is only *locally* generated
by sections, then `cokernel f` is quasi-coherent.

## Main definitions

* `Stacks.SheafOfModules.presentationCokernelToUnit` is the presentation of `cokernel f`
  attached to a family of generating sections of `M`.

## Main results

* `Stacks.SheafOfModules.isQuasicoherent_cokernel_toUnit`: the quotient of the sheaf of rings
  by a locally generated sheaf of modules is quasi-coherent.

## References

* [Stacks Project, Tag 01BD](https://stacks.math.columbia.edu/tag/01BD)
* [Stacks Project, Tag 01IN](https://stacks.math.columbia.edu/tag/01IN)
-/

@[expose] public noncomputable section

open CategoryTheory Limits SheafOfModules

universe u

namespace Stacks.SheafOfModules

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **The presentation of a quotient of the sheaf of rings by a generated sheaf of modules.**
For `f : M ⟶ unit R` and a family of sections generating `M`, the quotient `cokernel f` is
presented by the single generator `1` with the generators of `M` as relations. -/
def presentationCokernelToUnit {M : SheafOfModules.{u} R} (f : M ⟶ unit R)
    (G : M.GeneratingSections) : (cokernel f).Presentation := by
  refine presentationOfIsCokernelFree (G.π ≫ f ≫ Site.freePUnitIso.inv)
    (Site.freePUnitIso.hom ≫ cokernel.π f) (by simp) ?_
  refine CokernelCofork.IsColimit.ofπ _ _ (fun {W} k hk ↦ ?_) ?_ ?_
  · refine cokernel.desc f (Site.freePUnitIso.inv ≫ k) ?_
    refine (cancel_epi G.π).1 ?_
    simpa only [Category.assoc, comp_zero] using hk
  · intro W k hk
    simp only [Category.assoc, cokernel.π_desc, Iso.hom_inv_id_assoc]
  · intro W k hk m hm
    refine (cancel_epi (cokernel.π f)).1 ((cancel_epi Site.freePUnitIso.hom).1 (hm.trans ?_))
    simp only [cokernel.π_desc, Iso.hom_inv_id_assoc]

section Over

variable [HasBinaryProducts C] [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{u}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **The quotient of the sheaf of rings by a locally generated sheaf of modules is
quasi-coherent.** For `f : M ⟶ unit R` with `M` locally generated by sections, `cokernel f` is
quasi-coherent. -/
theorem isQuasicoherent_cokernel_toUnit {M : SheafOfModules.{u} R} (f : M ⟶ unit R)
    (G : M.LocalGeneratorsData) : (cokernel f).IsQuasicoherent := by
  let G' := G.shrink
  refine ⟨⟨{ I := G'.I, X := G'.X, coversTop := G'.coversTop, presentation := fun i ↦ ?_ }⟩⟩
  have : (overFunctor R (G'.X i)).PreservesZeroMorphisms := ⟨by intros; ext; rfl⟩
  exact (presentationCokernelToUnit (f.over (G'.X i)) (G'.generators i)).ofIsIso
    (PreservesCokernel.iso (overFunctor R (G'.X i)) f).inv

end Over

end Stacks.SheafOfModules

end
