module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatNeighbourhoodTensorUnit
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SheafificationTensor
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SheafTensorUnitSmul
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.RestrictScalars
public import StacksFrontier.CategoryTheory.Sites.Modules.IdealSubsheafLocal
public import StacksFrontier.AlgebraicGeometry.RestrictScalarsColimits.Basic

/-!
# The image of `ℐ ⊗_𝒪 𝒪'` in `𝒪'`

Let `φ : 𝒪 ⟶ 𝒪'` be a homomorphism of sheaves of commutative rings on a site and `ℐ ⊂ 𝒪` a sheaf
of ideals. Tensoring the inclusion `ℐ ⟶ 𝒪` with `𝒪'` over `𝒪` and composing with `𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'`
gives a map `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪'` of `𝒪`-modules. This file proves that its image is the sheaf of
ideals `ℐ𝒪'` generated by `φ(ℐ)`, and hence that `𝒪'/ℐ𝒪'` is the cokernel of
`ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪'`. No flatness is needed.

## Main definitions

* `Stacks.Sheaves.FlatNeighbourhood.extendIdealPresheaf`: the presheaf of ideals
  `U ↦ φ(ℐ(U))𝒪'(U)`.
* `Stacks.Sheaves.FlatNeighbourhood.unitRingMap`: `φ` read as a map `𝒪 ⟶ 𝒪'` of `𝒪`-modules.
* `Stacks.Sheaves.FlatNeighbourhood.tensorIdealUnitMap`: `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'`.
* `Stacks.Sheaves.FlatNeighbourhood.tensorIdealMap`: its factorization `ℐ ⊗_𝒪 𝒪' ⟶ ℐ𝒪'`.
* `Stacks.Sheaves.FlatNeighbourhood.cokernelTensorIdealIso`: `coker(ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪')`
  is `𝒪'/ℐ𝒪'`, read as an `𝒪`-module.

## Main results

* `Stacks.Sheaves.FlatNeighbourhood.extendIdeal_eq_sheafify`: `ℐ𝒪'` consists of the sections
  of `𝒪'` lying locally in `φ(ℐ)𝒪'`.
* `Stacks.Sheaves.FlatNeighbourhood.sheafTensorRight_map_comp_unitIso_unit_tmul`: for `f : F ⟶ 𝒪`,
  `F ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` sends `x ⊗ g` to `f(x) · g`; `tensorIdealUnitMap_unit_tmul` is the
  case `f = ℐ ⟶ 𝒪`.
* `Stacks.Sheaves.FlatNeighbourhood.tensorUnitMap_comp_unitIso_hom`: `x ↦ x ⊗ 1` followed by
  `𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` is `φ`.
* `Stacks.Sheaves.FlatNeighbourhood.tensorIdealMap_comp_ι`: `tensorIdealMap` followed by the
  inclusion `ℐ𝒪' ⟶ 𝒪'` is `tensorIdealUnitMap`.
* `Stacks.Sheaves.FlatNeighbourhood.epi_tensorIdealMap`: `tensorIdealMap` is an epimorphism, so
  the image of `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪'` is exactly `ℐ𝒪'`.
* `Stacks.Sheaves.FlatNeighbourhood.π_comp_cokernelTensorIdealIso_hom`: the identification of
  the cokernels is compatible with the projections from `𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory
open TensorProduct

universe u

open AlgebraicGeometry AlgebraicGeometry.SheafOfModules

namespace Stacks.Sheaves.FlatNeighbourhood

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasSheafify J AddCommGrpCat.{u}]
  {O O' : Sheaf J CommRingCat.{u}} (φ : O ⟶ O')
  (I : _root_.SheafOfModules.Submodule
    (_root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O)))

/-- The presheaf of ideals `U ↦ φ(ℐ(U))𝒪'(U)` of `𝒪'`. -/
def extendIdealPresheaf :
    (_root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O')).val.Submodule where
  obj U := Ideal.map (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app U).hom
    (I.obj U)
  map {U V} g := by
    intro z hz
    have key : Ideal.map
        (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app U).hom (I.obj U) ≤
        Ideal.comap ((Stacks.SheafOfModules.Tensor.ringSheaf O').obj.map g).hom (Ideal.map
          (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app V).hom
            (I.obj V)) := by
      refine Ideal.map_le_iff_le_comap.2 fun x hx ↦ ?_
      have h2 : (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app V).hom
          (((Stacks.SheafOfModules.Tensor.ringSheaf O).obj.map g).hom x) ∈
          Ideal.map (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app V).hom
            (I.obj V) := Ideal.mem_map_of_mem _ (I.map g hx)
      have h3 := NatTrans.naturality_apply
        ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom g x
      change _ ∈ _
      exact (congrArg (· ∈ _) h3).mp h2
    exact key hz

omit [J.WEqualsLocallyBijective AddCommGrpCat] [HasSheafify J AddCommGrpCat] in
/-- The image of a section of `ℐ` lies in `φ(ℐ)𝒪'`. -/
theorem mem_extendIdealPresheaf_obj {U : Cᵒᵖ}
    {x : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj U}
    (hx : x ∈ I.obj U) :
    (((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ).hom.app U).hom x ∈
      (extendIdealPresheaf φ I).obj U :=
  Ideal.mem_map_of_mem _ hx

omit [J.WEqualsLocallyBijective AddCommGrpCat] [HasSheafify J AddCommGrpCat] in
/-- `φ(ℐ)𝒪'` is contained in `ℐ𝒪'`, objectwise. -/
theorem extendIdealPresheaf_le :
    extendIdealPresheaf φ I ≤
      (RingedSite.extendIdeal ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ)
        I).toSubmodule := fun U ↦
  Ideal.map_le_iff_le_comap.2 fun x hx ↦ RingedSite.mem_extendIdeal_of_mem _ I U x hx

omit [J.WEqualsLocallyBijective AddCommGrpCat] [HasSheafify J AddCommGrpCat] in
/-- **`ℐ𝒪'` consists of the sections of `𝒪'` lying locally in `φ(ℐ)𝒪'`.** -/
theorem extendIdeal_eq_sheafify :
    RingedSite.extendIdeal ((sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ) I =
      Stacks.SheafOfModules.Submodule.sheafify (extendIdealPresheaf φ I) := by
  refine le_antisymm (RingedSite.extendIdeal_le _ I _ fun U x hx ↦ ?_) ?_
  · exact Stacks.PresheafOfModules.Submodule.le_sheafify (J := J) (extendIdealPresheaf φ I) U
      (mem_extendIdealPresheaf_obj φ I hx)
  · exact _root_.SheafOfModules.Submodule.le_iff.2 fun U x hx ↦
      Stacks.SheafOfModules.mem_of_sieveOfSection_mem _ (extendIdealPresheaf_le φ I) hx

section Tensor

attribute [local instance_reducible] CategoryTheory.sheafCompose PresheafOfModules.unit

/-- The map `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` of `𝒪`-modules. -/
def tensorIdealUnitMap :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).obj I.toSheafOfModules ⟶
      RestrictedRingModule φ :=
  (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule φ))).map I.ι ≫
    (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom

/-- For a map `f : F ⟶ 𝒪`, the composite `F ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` sends the elementary
tensor `x ⊗ g` of the presheaf tensor product to `f(x) · g`. -/
theorem sheafTensorRight_map_comp_unitIso_unit_tmul
    {F : _root_.SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf O)}
    (f : F ⟶ _root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O)) (X : Cᵒᵖ)
    (x : F.val.obj X) (g : (RestrictedRingModule φ).val.obj X) :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).map f ≫
      (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom).val.app X
        (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf O).obj)).unit.app
            (MonoidalCategoryStruct.tensorObj F.val
              (RestrictedRingModule φ).val)).app X (x ⊗ₜ[O.obj.obj X] g)) =
      (show (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X from f.val.app X x) • g := by
  let P : PresheafOfModules (Stacks.SheafOfModules.Tensor.ringSheaf O).obj ⥤
      PresheafOfModules (Stacks.SheafOfModules.Tensor.ringSheaf O).obj :=
    PresheafOfModules.tensorRight (O := O.obj) (RestrictedRingModule φ).val
  let adj := PresheafOfModules.sheafificationAdjunction
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf O).obj)
  let Sh := PresheafOfModules.sheafification (R := Stacks.SheafOfModules.Tensor.ringSheaf O)
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf O).obj)
  let G := RestrictedRingModule φ
  let unitor := (PresheafOfModulesOfCommRing.monoidalCategoryStruct (R := O.obj)).leftUnitor G.val
  have h1 : (Sh.map (P.map f.val)).val.app X
      ((adj.unit.app (P.obj F.val)).app X (x ⊗ₜ[O.obj.obj X] g)) =
      (adj.unit.app (P.obj (_root_.SheafOfModules.unit
        (Stacks.SheafOfModules.Tensor.ringSheaf O)).val)).app X
          ((f.val.app X x) ⊗ₜ[O.obj.obj X] g) :=
    (congrArg (fun ψ ↦ ψ.app X (x ⊗ₜ[O.obj.obj X] g))
      (adj.unit.naturality (P.map f.val))).symm
  have h2 : (Sh.map unitor.hom).val.app X
      ((adj.unit.app (P.obj (_root_.SheafOfModules.unit
        (Stacks.SheafOfModules.Tensor.ringSheaf O)).val)).app X
          ((f.val.app X x) ⊗ₜ[O.obj.obj X] g)) =
      (adj.unit.app G.val).app X (unitor.hom.app X ((f.val.app X x) ⊗ₜ[O.obj.obj X] g)) :=
    (congrArg (fun ψ ↦ ψ.app X ((f.val.app X x) ⊗ₜ[O.obj.obj X] g))
      (adj.unit.naturality unitor.hom)).symm
  have h3 : (adj.counit.app G).val.app X ((adj.unit.app G.val).app X
      (unitor.hom.app X ((f.val.app X x) ⊗ₜ[O.obj.obj X] g))) =
      unitor.hom.app X ((f.val.app X x) ⊗ₜ[O.obj.obj X] g) :=
    congrArg (fun ψ ↦ ψ.app X (unitor.hom.app X ((f.val.app X x) ⊗ₜ[O.obj.obj X] g)))
      (adj.right_triangle_components G)
  change (adj.counit.app G).val.app X ((Sh.map unitor.hom).val.app X
    ((Sh.map (P.map f.val)).val.app X
      ((adj.unit.app (P.obj F.val)).app X (x ⊗ₜ[O.obj.obj X] g)))) = _
  rw [h1, h2, h3]
  rfl

/-- On an elementary tensor `x ⊗ g` of the presheaf tensor product, `tensorIdealUnitMap` is
`x · g`. -/
theorem tensorIdealUnitMap_unit_tmul (X : Cᵒᵖ) (x : I.toSheafOfModules.val.obj X)
    (g : (RestrictedRingModule φ).val.obj X) :
    (tensorIdealUnitMap φ I).val.app X
        (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf O).obj)).unit.app
            (MonoidalCategoryStruct.tensorObj I.toSheafOfModules.val
              (RestrictedRingModule φ).val)).app X (x ⊗ₜ[O.obj.obj X] g)) =
      (show (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj X from I.ι.val.app X x) • g :=
  sheafTensorRight_map_comp_unitIso_unit_tmul φ I.ι X x g

/-- The map `𝒪 ⟶ 𝒪'` of sheaves of rings underlying `φ`. -/
abbrev ringSheafMap :
    Stacks.SheafOfModules.Tensor.ringSheaf O ⟶ Stacks.SheafOfModules.Tensor.ringSheaf O' :=
  (sheafCompose J (forget₂ CommRingCat.{u} RingCat.{u})).map φ

/-- The sheaf of ideals `ℐ𝒪'` of `𝒪'`. -/
abbrev extendedIdeal :
    _root_.SheafOfModules.Submodule
      (_root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O')) :=
  RingedSite.extendIdeal (ringSheafMap φ) I

/-- The unit of the sheafification of the presheaf tensor product `ℐ ⊗_𝒪 𝒪'`. -/
abbrev tensorIdealSheafifyUnit :=
  (PresheafOfModules.sheafificationAdjunction
    (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf O).obj)).unit.app
    (MonoidalCategoryStruct.tensorObj I.toSheafOfModules.val (RestrictedRingModule φ).val)

omit [J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasSheafify J AddCommGrpCat.{u}] in
/-- Membership in `ℐ𝒪'` is invariant under equality of sections. -/
theorem mem_extendedIdeal_of_eq {Y : Cᵒᵖ}
    {z w : (_root_.SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf O')).val.obj Y}
    (h : z = w)
    (hw : w ∈ (extendedIdeal φ I).obj Y) : z ∈ (extendedIdeal φ I).obj Y :=
  h ▸ hw

/-- On the image of the presheaf tensor product, `tensorIdealUnitMap` takes values in `ℐ𝒪'`. -/
theorem tensorIdealUnitMap_unit_mem (Y : Cᵒᵖ)
    (u : (MonoidalCategoryStruct.tensorObj I.toSheafOfModules.val
      (RestrictedRingModule φ).val).obj Y) :
    (tensorIdealUnitMap φ I).val.app Y ((tensorIdealSheafifyUnit φ I).app Y u) ∈
      (extendedIdeal φ I).obj Y := by
  induction u using TensorProduct.inductionOn with
  | add a b ha hb =>
    exact mem_extendedIdeal_of_eq φ I
      ((congrArg _ (map_add _ a b)).trans (map_add _ _ _)) (add_mem ha hb)
  | tmul x g =>
    have hx : (ringSheafMap φ).hom.app Y (I.ι.val.app Y x) ∈ (extendedIdeal φ I).obj Y :=
      RingedSite.mem_extendIdeal_of_mem _ I Y _ x.2
    exact mem_extendedIdeal_of_eq φ I ((tensorIdealUnitMap_unit_tmul φ I Y x g).trans
      (mul_comm (show O'.obj.obj Y from (ringSheafMap φ).hom.app Y (I.ι.val.app Y x))
        (show O'.obj.obj Y from g)))
      (((extendedIdeal φ I).obj Y).smul_mem (show O'.obj.obj Y from g) hx)

/-- **`ℐ ⊗_𝒪 𝒪' ⟶ 𝒪'` takes values in `ℐ𝒪'`.** -/
theorem tensorIdealUnitMap_mem (X : Cᵒᵖ)
    (t : ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).obj I.toSheafOfModules).val.obj X) :
    (tensorIdealUnitMap φ I).val.app X t ∈ (extendedIdeal φ I).obj X := by
  refine (extendedIdeal φ I).isSheaf _ (J.superset_covering ?_
    (Presheaf.imageSieve_mem J ((PresheafOfModules.toPresheaf _).map
      (tensorIdealSheafifyUnit φ I)) t))
  rintro Y f ⟨u, hu⟩
  exact mem_extendedIdeal_of_eq φ I
    ((PresheafOfModules.naturality_apply (tensorIdealUnitMap φ I).val f.op t).symm.trans
      (congrArg _ hu.symm)) (tensorIdealUnitMap_unit_mem φ I _ u)

/-- `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪'` composed with `𝒪' ⟶ 𝒪'/ℐ𝒪'` vanishes. -/
theorem tensorIdealUnitMap_comp_restrictScalars_map_π :
    tensorIdealUnitMap φ I ≫ (_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).map
      (cokernel.π (extendedIdeal φ I).ι) = 0 := by
  refine (_root_.SheafOfModules.forget _).map_injective
    (PresheafOfModules.hom_ext fun X ↦ ModuleCat.hom_ext (LinearMap.ext fun t ↦ ?_))
  exact congrArg (fun k ↦ k.val.app X ⟨_, tensorIdealUnitMap_mem φ I X t⟩)
    (cokernel.condition (extendedIdeal φ I).ι)

/-- **`ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` factors through `ℐ𝒪'`.** -/
def tensorIdealMap :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).obj I.toSheafOfModules ⟶
      (_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).obj
        (extendedIdeal φ I).toSheafOfModules :=
  Abelian.monoLift ((_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).map
    (extendedIdeal φ I).ι) (tensorIdealUnitMap φ I)
      ((congrArg (tensorIdealUnitMap φ I ≫ ·)
        (PreservesCokernel.π_iso_hom
          (_root_.SheafOfModules.restrictScalars (ringSheafMap φ))
          (extendedIdeal φ I).ι).symm).trans
        ((Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ (PreservesCokernel.iso
            (_root_.SheafOfModules.restrictScalars (ringSheafMap φ))
            (extendedIdeal φ I).ι).hom)
            (tensorIdealUnitMap_comp_restrictScalars_map_π φ I)).trans zero_comp)))

/-- `tensorIdealMap` followed by the inclusion `ℐ𝒪' ⟶ 𝒪'` is `tensorIdealUnitMap`. -/
@[reassoc (attr := simp)]
theorem tensorIdealMap_comp_ι :
    tensorIdealMap φ I ≫ (_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).map
      (extendedIdeal φ I).ι = tensorIdealUnitMap φ I :=
  Abelian.monoLift_comp _ _ _

/-- Every section of `φ(ℐ)𝒪'` is the image of a section of the presheaf tensor product
`ℐ ⊗_𝒪 𝒪'`. -/
theorem exists_tensorIdealUnitMap_unit_eq (Y : Cᵒᵖ)
    {z : (Stacks.SheafOfModules.Tensor.ringSheaf O').obj.obj Y}
    (hz : z ∈ (extendIdealPresheaf φ I).obj Y) :
    ∃ u : (MonoidalCategoryStruct.tensorObj I.toSheafOfModules.val
        (RestrictedRingModule φ).val).obj Y,
      (show (Stacks.SheafOfModules.Tensor.ringSheaf O').obj.obj Y from
        (tensorIdealUnitMap φ I).val.app Y ((tensorIdealSheafifyUnit φ I).app Y u)) = z := by
  suffices h : ∀ c : (Stacks.SheafOfModules.Tensor.ringSheaf O').obj.obj Y,
      ∃ u : (MonoidalCategoryStruct.tensorObj I.toSheafOfModules.val
          (RestrictedRingModule φ).val).obj Y,
        (show (Stacks.SheafOfModules.Tensor.ringSheaf O').obj.obj Y from
          (tensorIdealUnitMap φ I).val.app Y ((tensorIdealSheafifyUnit φ I).app Y u)) = c * z by
    obtain ⟨u, hu⟩ := h 1
    exact ⟨u, hu.trans (one_mul z)⟩
  change z ∈ Ideal.span _ at hz
  induction hz using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    intro c
    exact ⟨⟨a, ha⟩ ⊗ₜ[O.obj.obj Y] (show (RestrictedRingModule φ).val.obj Y from c),
      (tensorIdealUnitMap_unit_tmul φ I Y ⟨a, ha⟩ _).trans (mul_comm _ c)⟩
  | zero =>
    intro c
    exact ⟨0, ((congrArg _ (map_zero _)).trans (map_zero _)).trans (mul_zero c).symm⟩
  | add x y _ _ hx hy =>
    intro c
    obtain ⟨u₁, h₁⟩ := hx c
    obtain ⟨u₂, h₂⟩ := hy c
    exact ⟨u₁ + u₂, ((congrArg _ (map_add _ u₁ u₂)).trans (map_add _ _ _)).trans
      ((congrArg₂ (· + ·) h₁ h₂).trans (mul_add c x y).symm)⟩
  | smul a x _ hx =>
    intro c
    obtain ⟨u, hu⟩ := hx (c * a)
    exact ⟨u, hu.trans (mul_assoc c a x)⟩

/-- **The factor `ℐ ⊗_𝒪 𝒪' ⟶ ℐ𝒪'` is an epimorphism.** -/
instance epi_tensorIdealMap : Epi (tensorIdealMap φ I) := by
  rw [Stacks.SheafOfModules.EpiMono.epi_iff_isLocallySurjective]
  constructor
  intro U s
  have hs : (s : (extendedIdeal φ I).obj (Opposite.op U)).1 ∈
      (Stacks.SheafOfModules.Submodule.sheafify (extendIdealPresheaf φ I)).obj (Opposite.op U) := by
    rw [← extendIdeal_eq_sheafify]
    exact s.2
  obtain ⟨S, hS, hSx⟩ := Stacks.PresheafOfModules.Submodule.mem_sheafify_iff.1 hs
  refine J.superset_covering (fun Y f hf ↦ ?_) hS
  obtain ⟨u, hu⟩ := exists_tensorIdealUnitMap_unit_eq φ I _ (hSx f hf)
  exact ⟨(tensorIdealSheafifyUnit φ I).app _ u, Subtype.ext
    ((congrArg (fun k ↦ k.val.app _ ((tensorIdealSheafifyUnit φ I).app _ u))
      (tensorIdealMap_comp_ι φ I)).trans hu)⟩

/-- **`coker(ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪') ≅ 𝒪'/ℐ𝒪'`**, as `𝒪`-modules: the cokernel of the tensor product
of the inclusion `ℐ ⟶ 𝒪` with `𝒪'` is the quotient of `𝒪'` by the sheaf of ideals generated by
`φ(ℐ)`. -/
def cokernelTensorIdealIso :
    cokernel ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).map I.ι) ≅
      (_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).obj
        (cokernel (extendedIdeal φ I).ι) :=
  (@cokernelCompIsIso _ _ _ _ _ _ _
    (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom inferInstance
    (sheafTensorRightUnitIso O (RestrictedRingModule φ)).isIso_hom).symm ≪≫
    cokernelIsoOfEq (tensorIdealMap_comp_ι φ I).symm ≪≫
    cokernelEpiComp _ _ ≪≫
    (PreservesCokernel.iso (_root_.SheafOfModules.restrictScalars (ringSheafMap φ))
      (extendedIdeal φ I).ι).symm

/-- `cokernelTensorIdealIso` is compatible with the projections: through `𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'`, the
projection onto the cokernel of `ℐ ⊗_𝒪 𝒪' ⟶ 𝒪 ⊗_𝒪 𝒪'` is the projection `𝒪' ⟶ 𝒪'/ℐ𝒪'`. -/
@[reassoc (attr := simp)]
theorem π_comp_cokernelTensorIdealIso_hom :
    cokernel.π ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).map I.ι) ≫
        (cokernelTensorIdealIso φ I).hom =
      (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom ≫
        (_root_.SheafOfModules.restrictScalars (ringSheafMap φ)).map
          (cokernel.π (extendedIdeal φ I).ι) := by
  let tensorArrow := ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
    (RestrictedRingModule φ)).map I.ι
  let unitIso := sheafTensorRightUnitIso O (RestrictedRingModule φ)
  let restriction := _root_.SheafOfModules.restrictScalars (ringSheafMap φ)
  let inclusion := restriction.map (extendedIdeal φ I).ι
  let unitCokernelIso := @cokernelCompIsIso _ _ _ _ _ _ tensorArrow unitIso.hom
    inferInstance unitIso.isIso_hom
  let equalityIso := cokernelIsoOfEq (tensorIdealMap_comp_ι φ I).symm
  let epiIso := cokernelEpiComp (tensorIdealMap φ I) inclusion
  let comparisonIso := PreservesCokernel.iso restriction (extendedIdeal φ I).ι
  have unitProjection : cokernel.π tensorArrow ≫ unitCokernelIso.inv =
      unitIso.hom ≫ cokernel.π (tensorArrow ≫ unitIso.hom) := cokernel.π_desc _ _ _
  have equalityProjection : cokernel.π (tensorArrow ≫ unitIso.hom) ≫ equalityIso.hom =
      cokernel.π (tensorIdealMap φ I ≫ inclusion) :=
    π_comp_cokernelIsoOfEq_hom (tensorIdealMap_comp_ι φ I).symm
  have epiProjection : cokernel.π (tensorIdealMap φ I ≫ inclusion) ≫ epiIso.hom =
      cokernel.π inclusion := cokernel.π_desc _ _ _
  have comparisonProjection : cokernel.π inclusion ≫ comparisonIso.inv =
      restriction.map (cokernel.π (extendedIdeal φ I).ι) :=
    (congrArg (cokernel.π inclusion ≫ ·)
      (PreservesCokernel.iso_inv restriction (extendedIdeal φ I).ι)).trans
      (π_comp_cokernelComparison (extendedIdeal φ I).ι restriction)
  change cokernel.π tensorArrow ≫ unitCokernelIso.inv ≫ equalityIso.hom ≫ epiIso.hom ≫
      comparisonIso.inv = unitIso.hom ≫ restriction.map (cokernel.π (extendedIdeal φ I).ι)
  rw [reassoc_of% unitProjection]
  erw [Category.assoc, ← Category.assoc (cokernel.π _), equalityProjection,
    ← Category.assoc (cokernel.π _), epiProjection, comparisonProjection]

/-- **`φ : 𝒪 ⟶ 𝒪'` read as a map of `𝒪`-modules** `𝒪 ⟶ 𝒪'`, the target viewed as an `𝒪`-module by
restriction of scalars. -/
def unitRingMap : RingModule O ⟶ RestrictedRingModule φ :=
  ⟨PresheafOfModules.homMk
      { app := fun V ↦ AddCommGrpCat.ofHom ((ringSheafMap φ).hom.app V).hom.toAddMonoidHom
        naturality := by
          intro V W g
          apply AddCommGrpCat.hom_ext
          ext r
          exact NatTrans.naturality_apply (ringSheafMap φ).hom g r }
      fun V r m ↦ map_mul ((ringSheafMap φ).hom.app V).hom r m⟩

omit [J.WEqualsLocallyBijective AddCommGrpCat.{u}] [HasSheafify J AddCommGrpCat.{u}] in
/-- `unitRingMap φ` is `φ` on sections. -/
theorem unitRingMap_val_app (V : Cᵒᵖ) (r : (Stacks.SheafOfModules.Tensor.ringSheaf O).obj.obj V) :
    (unitRingMap φ).val.app V r = (φ.hom.app V).hom r := rfl

/-- **`x ↦ x ⊗ 1` followed by `𝒪 ⊗_𝒪 𝒪' ≅ 𝒪'` is `φ`.** -/
theorem tensorUnitMap_comp_unitIso_hom :
    (tensorUnitMap φ (RingModule O)).val ≫
      (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom =
      unitRingMap φ := by
  refine (_root_.SheafOfModules.forget _).map_injective
    (PresheafOfModules.hom_ext fun X ↦ ModuleCat.hom_ext (LinearMap.ext fun x ↦ ?_))
  have h := sheafTensorRight_map_comp_unitIso_unit_tmul φ (𝟙 (RingModule O)) X x
    (restrictedOne φ X)
  have e : (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} O).flip.obj
      (RestrictedRingModule φ))).map
      (𝟙 (RingModule O)) ≫ (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom =
      (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom :=
    (congrArg (· ≫ (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom)
      (CategoryTheory.Functor.map_id _ _)).trans (Category.id_comp _)
  change (sheafTensorRightUnitIso O (RestrictedRingModule φ)).hom.val.app X
    ((tensorUnitMap φ (RingModule O)).val.val.app X x) = (φ.hom.app X).hom x
  rw [(tensorUnitMap φ (RingModule O)).property X x]
  exact (congrArg (fun k ↦ (k.val.app X) (tensorUnitSection φ (RingModule O) X x))
    e.symm).trans (h.trans (mul_one ((φ.hom.app X).hom x)))

end Tensor

end Stacks.Sheaves.FlatNeighbourhood

