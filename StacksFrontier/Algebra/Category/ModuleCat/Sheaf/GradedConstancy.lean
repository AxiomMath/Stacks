module

public import Mathlib.Algebra.Module.Shrink
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.RingTheory.MvPolynomial.Homogeneous
public import Mathlib.RingTheory.Polynomial.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ConstantSheafHom
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.QuotientOfConstantSheaf

/-!
# Uniform constancy of a graded sheaf of modules generated in degree zero

Let `(C, J)` be a site with a terminal object `T` not covered by the empty sieve, `Λ` a
Noetherian ring and `B 0, B 1, …` sheaves of `Λ`-modules with maps `ψ j : B n ⟶ B (n + 1)`,
`j < k`, which commute with each other. Suppose `B 0` is the constant sheaf on a finitely
generated module `M` and every `B n` is generated by the images of `B 0` under the composites
of `n` of the maps `ψ j`. Then there is a single object `U₀`, not covered by the empty sieve,
over which *every* `B n` is the constant sheaf on a finitely generated module.

This is the uniform part of the proof of Stacks 09BU: there `B n` is the sheaf
`IⁿF / Iⁿ⁺¹F` and `ψ j` is multiplication by the `j`-th generator of `I`, so that `⨁ₙ B n` is a
module over the Noetherian ring `⨁ₙ Iⁿ / Iⁿ⁺¹`, a quotient of a polynomial ring in `k`
variables.

The proof never forms the direct sum as a sheaf. Over each object `W`, the polynomial ring
`Λ[X₁, …, X_k]` acts on the product `∏ₙ B n (W)` of the sections, `X_j` by `ψ j`
(`Stacks.ConstantSheaf.gradedPolyAct`), and a choice of generators `m₁, …, m_q` of `M` gives a
map from `q`-tuples of polynomials to `∏ₙ B n (W)` whose kernel is a submodule of a Noetherian
module over the polynomial ring (`Stacks.ConstantSheaf.gradedKernel`). These kernels grow along
the morphisms of the site, so they are maximal at some `U₀`
(`Stacks.ConstantSheaf.exists_eq_of_isNoetherian`), and constant above it. In degree `n` this
says that the kernel of the map from the constant sheaf on `q`-tuples of polynomials onto `B n`
over `U₀` is constant, so `B n` is the constant sheaf on the quotient
(`Stacks.ConstantSheaf.nonempty_constantSheaf_quotient_iso`), which is finitely generated because
only the homogeneous parts of degree `n` matter.

## Main definitions

* `Stacks.ConstantSheaf.gradedPolyAct`: a polynomial acting on `∏ₙ Vₙ` through commuting
  degree-raising maps.
* `Stacks.ConstantSheaf.gradedKernel`: the kernel of the evaluation of `q`-tuples of polynomials
  at `q` elements of degree zero, a submodule over the polynomial ring.
* `Stacks.ConstantSheaf.pathHom`: the composite of the maps `ψ` along a word.

## Main results

* `Stacks.ConstantSheaf.gradedEval_apply_eq_zero_iff`: the degree `n` part of the evaluation
  kills a tuple exactly when its degree `n` homogeneous part lies in the kernel.
* `Stacks.ConstantSheaf.exists_constantSheaf_iso_overPullback_of_graded`: the uniform constancy
  statement above.

## Implementation notes

The generation hypothesis is stated as a cancellation property: a morphism out of `B n` which
vanishes on the images of all composites of `n` maps `ψ j` vanishes. This is what the quotients
of a sheaf by the powers of an ideal supply directly
(`Stacks.ModuleSheaf.IsQuotientBy.eq_zero_of_kernelLift_comp_eq_zero`), and it is preserved by
every left adjoint.

## References

* [Stacks Project, Tag 09BU](https://stacks.math.columbia.edu/tag/09BU)
* [Stacks Project, Tag 09BH](https://stacks.math.columbia.edu/tag/09BH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

namespace Stacks.ConstantSheaf

section Algebra

variable {Λ : Type*} [CommRing Λ] {V : ℕ → Type*} [∀ n, AddCommGroup (V n)] [∀ n, Module Λ (V n)]
  {r : ℕ} (ψ : Fin r → ∀ n, V n →ₗ[Λ] V (n + 1))

/-- The degree-raising endomorphism of `∏ₙ Vₙ` given by `ψ j` in each degree. -/
def gradedShift (j : Fin r) : ((n : ℕ) → V n) →ₗ[Λ] ((n : ℕ) → V n) :=
  LinearMap.pi fun n => match n with
    | 0 => 0
    | m + 1 => ψ j m ∘ₗ LinearMap.proj m

/-- The degree `0` component of `gradedShift ψ j x` is zero. -/
@[simp] theorem gradedShift_apply_zero (j : Fin r) (x : (n : ℕ) → V n) :
    gradedShift ψ j x 0 = 0 := rfl

/-- The degree `m + 1` component of `gradedShift ψ j x` is `ψ j m` applied to `x m`. -/
@[simp] theorem gradedShift_apply_succ (j : Fin r) (x : (n : ℕ) → V n) (m : ℕ) :
    gradedShift ψ j x (m + 1) = ψ j m (x m) := rfl

variable {ψ} in
/-- If the maps `ψ i` and `ψ j` commute in every degree, then the shifts `gradedShift ψ i` and
`gradedShift ψ j` commute. -/
theorem gradedShift_commute (hψ : ∀ i j n x, ψ j (n + 1) (ψ i n x) = ψ i (n + 1) (ψ j n x))
    (i j : Fin r) : gradedShift ψ i * gradedShift ψ j = gradedShift ψ j * gradedShift ψ i := by
  ext x n
  rcases n with _ | _ | n
  · rfl
  · simp
  · simp [hψ]

variable (hψ : ∀ i j n x, ψ j (n + 1) (ψ i n x) = ψ i (n + 1) (ψ j n x))

/-- The commutative algebra of endomorphisms generated by the shifts. -/
abbrev shiftAlgebra : Subalgebra Λ (Module.End Λ ((n : ℕ) → V n)) :=
  Algebra.adjoin Λ (Set.range (gradedShift ψ))

/-- The commutative ring structure of `shiftAlgebra`. -/
abbrev shiftAlgebraCommRing : CommRing (shiftAlgebra ψ) := Algebra.adjoinCommRingOfComm Λ (by
  rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
  exact gradedShift_commute hψ i j)

/-- A polynomial in `r` variables acting on `∏ₙ Vₙ`, the `j`-th variable by `gradedShift ψ j`. -/
def gradedPolyAct (p : MvPolynomial (Fin r) Λ) : Module.End Λ ((n : ℕ) → V n) :=
  letI := shiftAlgebraCommRing ψ hψ
  ((MvPolynomial.aeval fun j => (⟨gradedShift ψ j, Algebra.subset_adjoin ⟨j, rfl⟩⟩ :
    shiftAlgebra ψ)) p : shiftAlgebra ψ)

/-- `gradedPolyAct` is multiplicative. -/
theorem gradedPolyAct_mul (p q : MvPolynomial (Fin r) Λ) :
    gradedPolyAct ψ hψ (p * q) = gradedPolyAct ψ hψ p * gradedPolyAct ψ hψ q := by
  let := shiftAlgebraCommRing ψ hψ
  simp only [gradedPolyAct, map_mul]
  rfl

/-- `gradedPolyAct` is additive. -/
theorem gradedPolyAct_add (p q : MvPolynomial (Fin r) Λ) :
    gradedPolyAct ψ hψ (p + q) = gradedPolyAct ψ hψ p + gradedPolyAct ψ hψ q := by
  let := shiftAlgebraCommRing ψ hψ
  simp only [gradedPolyAct, map_add]
  rfl

/-- `gradedPolyAct` commutes with scalar multiplication by `Λ`. -/
theorem gradedPolyAct_smul (a : Λ) (p : MvPolynomial (Fin r) Λ) :
    gradedPolyAct ψ hψ (a • p) = a • gradedPolyAct ψ hψ p := by
  let := shiftAlgebraCommRing ψ hψ
  simp only [gradedPolyAct, map_smul]
  rfl

/-- The variable `X j` acts by `gradedShift ψ j`. -/
theorem gradedPolyAct_X (j : Fin r) : gradedPolyAct ψ hψ (MvPolynomial.X j) = gradedShift ψ j := by
  let := shiftAlgebraCommRing ψ hψ
  simp only [gradedPolyAct, MvPolynomial.aeval_X]

/-- The constant polynomial `C a` acts as multiplication by `a`. -/
theorem gradedPolyAct_C (a : Λ) : gradedPolyAct ψ hψ (MvPolynomial.C a) = a • 1 := by
  let := shiftAlgebraCommRing ψ hψ
  simp only [gradedPolyAct, MvPolynomial.aeval_C]
  rfl

/-- The actions of any two polynomials commute. -/
theorem gradedPolyAct_comm (p q : MvPolynomial (Fin r) Λ) :
    gradedPolyAct ψ hψ p * gradedPolyAct ψ hψ q = gradedPolyAct ψ hψ q * gradedPolyAct ψ hψ p := by
  rw [← gradedPolyAct_mul, mul_comm, gradedPolyAct_mul]


/-- `x` is concentrated in degree `d`. -/
def IsConcentratedIn (x : (n : ℕ) → V n) (d : ℕ) : Prop := ∀ n, n ≠ d → x n = 0

variable {ψ} in
/-- A shift raises the degree of concentration by one. -/
theorem isConcentratedIn_gradedShift {x : (n : ℕ) → V n} {d : ℕ} (hx : IsConcentratedIn x d)
    (j : Fin r) : IsConcentratedIn (gradedShift ψ j x) (d + 1) := by
  intro n hn
  rcases n with _ | n
  · rfl
  · simp [hx n (by omega)]

/-- The `e`-th power of a shift raises the degree of concentration by `e`. -/
theorem isConcentratedIn_pow_gradedShift {x : (n : ℕ) → V n} {d : ℕ} (hx : IsConcentratedIn x d)
    (j : Fin r) (e : ℕ) : IsConcentratedIn ((gradedShift ψ j ^ e) x) (d + e) := by
  induction e with
  | zero => simpa using hx
  | succ e ih => rw [pow_succ', Module.End.mul_apply]; exact isConcentratedIn_gradedShift ih j

/-- The constant polynomial `1` acts as the identity. -/
private theorem gradedPolyAct_one : gradedPolyAct ψ hψ 1 = 1 := by
  rw [← MvPolynomial.C_1, gradedPolyAct_C, one_smul]

/-- `gradedPolyAct` carries powers to powers. -/
theorem gradedPolyAct_pow (p : MvPolynomial (Fin r) Λ) (e : ℕ) :
    gradedPolyAct ψ hψ (p ^ e) = gradedPolyAct ψ hψ p ^ e := by
  induction e with
  | zero =>
    rw [pow_zero, pow_zero, gradedPolyAct_one]
  | succ e ih => rw [pow_succ, gradedPolyAct_mul, ih, pow_succ]

/-- A monomial of degree `α.degree` carries an element concentrated in degree `d` to one
concentrated in degree `d + α.degree`. -/
theorem isConcentratedIn_gradedPolyAct_monomial {x : (n : ℕ) → V n} {d : ℕ}
    (hx : IsConcentratedIn x d) (α : Fin r →₀ ℕ) (b : Λ) :
    IsConcentratedIn (gradedPolyAct ψ hψ (MvPolynomial.monomial α b) x) (d + α.degree) := by
  induction α using Finsupp.induction generalizing x d with
  | zero =>
    rw [MvPolynomial.monomial_zero', gradedPolyAct_C]
    intro n hn
    simp [hx n (by simpa using hn)]
  | single_add j e α hj he ih =>
    rw [MvPolynomial.monomial_single_add, gradedPolyAct_mul, Module.End.mul_apply,
      gradedPolyAct_pow, gradedPolyAct_X]
    have := isConcentratedIn_pow_gradedShift ψ (ih hx) j e
    convert this using 1
    rw [map_add, Finsupp.degree_single]
    omega

/-- The zero polynomial acts as zero. -/
theorem gradedPolyAct_zero : gradedPolyAct ψ hψ 0 = 0 := by
  rw [← MvPolynomial.C_0, gradedPolyAct_C, zero_smul]

/-- The shift of an element `z` placed in degree `n` is `ψ j n z` placed in degree `n + 1`. -/
theorem gradedShift_single (j : Fin r) (n : ℕ) (z : V n) :
    gradedShift ψ j (Pi.single n z) = Pi.single (n + 1) (ψ j n z) := by
  funext m
  rcases m with _ | m
  · simp
  · rw [gradedShift_apply_succ]
    by_cases h : m = n
    · subst h; simp
    · rw [Pi.single_eq_of_ne h, Pi.single_eq_of_ne (by omega), map_zero]

/-- The composite of the maps `ψ` along a word `w` of length `n`. -/
def gradedPath : ∀ {n : ℕ}, (Fin n → Fin r) → (V 0 →ₗ[Λ] V n)
  | 0, _ => LinearMap.id
  | n + 1, w => ψ (w (Fin.last n)) n ∘ₗ gradedPath (Fin.init w)

/-- The monomial `∏ i, X (w i)` carries `z` in degree `0` to `gradedPath ψ w z` in degree `n`. -/
theorem gradedPolyAct_prod_X_single {n : ℕ} (w : Fin n → Fin r) (z : V 0) :
    gradedPolyAct ψ hψ (∏ i, MvPolynomial.X (w i)) (Pi.single 0 z) =
      Pi.single n (gradedPath ψ w z) := by
  induction n with
  | zero =>
    rw [Finset.univ_eq_empty, Finset.prod_empty, gradedPolyAct_one]
    rfl
  | succ n ih =>
    rw [Fin.prod_univ_castSucc, mul_comm, gradedPolyAct_mul, Module.End.mul_apply,
      gradedPolyAct_X]
    have := ih (Fin.init w)
    simp only [Fin.init] at this
    rw [this, gradedShift_single]
    rfl

/-- A sum of two elements concentrated in degree `d` is concentrated in degree `d`. -/
theorem IsConcentratedIn.add {x y : (n : ℕ) → V n} {d : ℕ} (hx : IsConcentratedIn x d)
    (hy : IsConcentratedIn y d) : IsConcentratedIn (x + y) d := fun n hn => by
  simp [hx n hn, hy n hn]

/-- An element placed in degree `d` is concentrated in degree `d`. -/
theorem isConcentratedIn_single (d : ℕ) (z : V d) : IsConcentratedIn (Pi.single d z) d :=
  fun _ hn => Pi.single_eq_of_ne hn _

/-- For `z` in degree `0`, the degree `n` component of `p` applied to `z` depends only on the
degree `n` homogeneous component of `p`, which carries `z` to an element concentrated in
degree `n`. -/
theorem gradedPolyAct_homogeneousComponent (p : MvPolynomial (Fin r) Λ) (n : ℕ) (z : V 0) :
    gradedPolyAct ψ hψ p (Pi.single 0 z) n =
        gradedPolyAct ψ hψ (MvPolynomial.homogeneousComponent n p) (Pi.single 0 z) n ∧
      IsConcentratedIn
        (gradedPolyAct ψ hψ (MvPolynomial.homogeneousComponent n p) (Pi.single 0 z)) n := by
  induction p using MvPolynomial.induction_on' with
  | monomial u a =>
    have hmem : MvPolynomial.monomial u a ∈
        MvPolynomial.homogeneousSubmodule (Fin r) Λ u.degree :=
      MvPolynomial.isHomogeneous_monomial a rfl
    have hc := isConcentratedIn_gradedPolyAct_monomial ψ hψ (isConcentratedIn_single 0 z) u a
    rw [zero_add] at hc
    rw [MvPolynomial.homogeneousComponent_of_mem hmem]
    split_ifs with h
    · subst h; exact ⟨rfl, hc⟩
    · rw [gradedPolyAct_zero]
      exact ⟨hc n h, fun _ _ => rfl⟩
  | add p q hp hq =>
    rw [map_add, gradedPolyAct_add, gradedPolyAct_add]
    exact ⟨by simp only [LinearMap.add_apply, Pi.add_apply, hp.1, hq.1], hp.2.add hq.2⟩

variable {q : ℕ}

/-- The `Λ`-linear map `(f₁, …, f_q) ↦ ∑ₐ fₐ · yₐ` from `q`-tuples of polynomials, where a
polynomial acts on `∏ₙ Vₙ` by `gradedPolyAct` and `yₐ` sits in degree `0`. -/
def gradedEval (y : Fin q → V 0) :
    (Fin q → MvPolynomial (Fin r) Λ) →ₗ[Λ] ((n : ℕ) → V n) where
  toFun f := ∑ a, gradedPolyAct ψ hψ (f a) (Pi.single 0 (y a))
  map_add' f g := by
    simp only [Pi.add_apply, gradedPolyAct_add, LinearMap.add_apply, Finset.sum_add_distrib]
  map_smul' c f := by
    simp only [Pi.smul_apply, gradedPolyAct_smul, LinearMap.smul_apply, Finset.smul_sum,
      RingHom.id_apply]

/-- `gradedEval ψ hψ y f` is `∑ₐ fₐ · yₐ`. -/
theorem gradedEval_apply (y : Fin q → V 0) (f : Fin q → MvPolynomial (Fin r) Λ) :
    gradedEval ψ hψ y f = ∑ a, gradedPolyAct ψ hψ (f a) (Pi.single 0 (y a)) := rfl

/-- `gradedEval` is linear over the polynomial ring, which acts on `∏ₙ Vₙ` by
`gradedPolyAct`. -/
theorem gradedEval_polySmul (y : Fin q → V 0) (p : MvPolynomial (Fin r) Λ)
    (f : Fin q → MvPolynomial (Fin r) Λ) :
    gradedEval ψ hψ y (p • f) = gradedPolyAct ψ hψ p (gradedEval ψ hψ y f) := by
  simp only [gradedEval_apply, Pi.smul_apply, smul_eq_mul, gradedPolyAct_mul, map_sum,
    Module.End.mul_apply]

/-- The kernel of `gradedEval`, a submodule over the polynomial ring. -/
def gradedKernel (y : Fin q → V 0) :
    Submodule (MvPolynomial (Fin r) Λ) (Fin q → MvPolynomial (Fin r) Λ) where
  carrier := {f | gradedEval ψ hψ y f = 0}
  add_mem' {f g} hf hg := by simp_all [map_add]
  zero_mem' := map_zero _
  smul_mem' p f hf := by
    simp only [Set.mem_setOf_eq] at hf ⊢
    rw [gradedEval_polySmul, hf, map_zero]

/-- A tuple lies in `gradedKernel` exactly when `gradedEval` kills it. -/
theorem mem_gradedKernel {y : Fin q → V 0} {f : Fin q → MvPolynomial (Fin r) Λ} :
    f ∈ gradedKernel ψ hψ y ↔ gradedEval ψ hψ y f = 0 := Iff.rfl

/-- The degree `n` component of `gradedEval ψ hψ y f` depends only on the degree `n` homogeneous
components of `f`, whose evaluation is concentrated in degree `n`. -/
theorem gradedEval_apply_homogeneousComponent (y : Fin q → V 0)
    (f : Fin q → MvPolynomial (Fin r) Λ) (n : ℕ) :
    gradedEval ψ hψ y f n =
        gradedEval ψ hψ y (fun a => MvPolynomial.homogeneousComponent n (f a)) n ∧
      IsConcentratedIn (gradedEval ψ hψ y
        (fun a => MvPolynomial.homogeneousComponent n (f a))) n := by
  simp only [gradedEval_apply, Finset.sum_apply]
  refine ⟨Finset.sum_congr rfl fun a _ =>
    (gradedPolyAct_homogeneousComponent ψ hψ (f a) n (y a)).1, ?_⟩
  refine Finset.sum_induction _ (fun x => IsConcentratedIn x n) (fun _ _ h h' => h.add h')
    (fun _ _ => rfl) fun a _ => (gradedPolyAct_homogeneousComponent ψ hψ (f a) n (y a)).2

/-- **The degree `n` part of the kernel.** The `n`-th component of `gradedEval` kills `f`
exactly when the degree `n` homogeneous components of `f` lie in `gradedKernel`. -/
theorem gradedEval_apply_eq_zero_iff (y : Fin q → V 0) (f : Fin q → MvPolynomial (Fin r) Λ)
    (n : ℕ) : gradedEval ψ hψ y f n = 0 ↔
      (fun a => MvPolynomial.homogeneousComponent n (f a)) ∈ gradedKernel ψ hψ y := by
  obtain ⟨h1, h2⟩ := gradedEval_apply_homogeneousComponent ψ hψ y f n
  rw [mem_gradedKernel, h1]
  refine ⟨fun h => funext fun m => ?_, fun h => by rw [h]; rfl⟩
  by_cases hm : m = n
  · subst hm; exact h
  · exact h2 m hm

section Naturality

variable {V' : ℕ → Type*} [∀ n, AddCommGroup (V' n)] [∀ n, Module Λ (V' n)]
  {ψ' : Fin r → ∀ n, V' n →ₗ[Λ] V' (n + 1)}
  (hψ' : ∀ i j n x, ψ' j (n + 1) (ψ' i n x) = ψ' i (n + 1) (ψ' j n x))
  (ρ : ∀ n, V n →ₗ[Λ] V' n) (hρ : ∀ j n x, ρ (n + 1) (ψ j n x) = ψ' j n (ρ n x))

include hρ in
/-- Degreewise maps `ρ` intertwining `ψ` with `ψ'` intertwine the polynomial actions. -/
theorem gradedPolyAct_naturality (p : MvPolynomial (Fin r) Λ) (x : (n : ℕ) → V n) :
    (fun n => ρ n (gradedPolyAct ψ hψ p x n)) =
      gradedPolyAct ψ' hψ' p (fun n => ρ n (x n)) := by
  induction p using MvPolynomial.induction_on generalizing x with
  | C a =>
    funext n
    simp [gradedPolyAct_C]
  | add p p' hp hp' =>
    funext n
    have h1 := congrFun (hp x) n
    have h2 := congrFun (hp' x) n
    simp only [gradedPolyAct_add, LinearMap.add_apply, Pi.add_apply, map_add] at h1 h2 ⊢
    rw [h1, h2]
  | mul_X p j hp =>
    rw [gradedPolyAct_mul, gradedPolyAct_mul, Module.End.mul_apply, Module.End.mul_apply,
      gradedPolyAct_X, gradedPolyAct_X, hp]
    congr 1
    funext n
    rcases n with _ | n
    · simp
    · simp [hρ]

include hρ in
/-- Degreewise maps `ρ` intertwining `ψ` with `ψ'` carry the evaluation at `y` to the
evaluation at the images `ρ 0 (y a)`. -/
theorem gradedEval_naturality (y : Fin q → V 0) (f : Fin q → MvPolynomial (Fin r) Λ) :
    (fun n => ρ n (gradedEval ψ hψ y f n)) =
      gradedEval ψ' hψ' (fun a => ρ 0 (y a)) f := by
  have hs (z : V 0) : (fun n => ρ n ((Pi.single 0 z : (n : ℕ) → V n) n)) =
      (Pi.single 0 (ρ 0 z) : (n : ℕ) → V' n) := by
    funext n
    by_cases hn : n = 0
    · subst hn; simp
    · simp [Pi.single_eq_of_ne hn]
  funext n
  simp only [gradedEval_apply, Finset.sum_apply, map_sum]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [← hs, ← gradedPolyAct_naturality ψ hψ hψ' ρ hρ]

include hρ in
/-- Degreewise maps `ρ` intertwining `ψ` with `ψ'` enlarge the kernel: `gradedKernel` at `y`
is contained in `gradedKernel` at the images `ρ 0 (y a)`. -/
theorem gradedKernel_le (y : Fin q → V 0) :
    gradedKernel ψ hψ y ≤ gradedKernel ψ' hψ' (fun a => ρ 0 (y a)) := fun f hf => by
  rw [mem_gradedKernel] at hf ⊢
  rw [← gradedEval_naturality ψ hψ hψ' ρ hρ, hf]
  funext n
  exact map_zero _

end Naturality

end Algebra

section Finite

variable {Λ : Type*} [CommRing Λ] {r q : ℕ}

/-- The homogeneous polynomials of degree `n` in finitely many variables form a finitely
generated module. -/
instance (n : ℕ) : Module.Finite Λ (MvPolynomial.homogeneousSubmodule (Fin r) Λ n) := by
  have h : MvPolynomial.homogeneousSubmodule (Fin r) Λ n =
      MvPolynomial.restrictSupport Λ {d : Fin r →₀ ℕ | d.degree = n} := by
    rw [MvPolynomial.homogeneousSubmodule_eq_finsupp_supported]
    rfl
  have : Finite {d : Fin r →₀ ℕ | d.degree = n} :=
    ((Finsupp.finite_of_degree_le (σ := Fin r) n).subset fun d hd => le_of_eq hd).to_subtype
  rw [h]
  exact Module.Finite.of_basis (MvPolynomial.basisRestrictSupport Λ _)

/-- A quotient of `q`-tuples of polynomials in which every tuple is congruent to its degree `n`
homogeneous part is finitely generated. -/
theorem finite_quotient_of_sub_homogeneousComponent_mem (n : ℕ)
    (N : Submodule Λ (Fin q → MvPolynomial (Fin r) Λ))
    (hN : ∀ f : Fin q → MvPolynomial (Fin r) Λ,
      f - (fun a => MvPolynomial.homogeneousComponent n (f a)) ∈ N) :
    Module.Finite Λ ((Fin q → MvPolynomial (Fin r) Λ) ⧸ N) := by
  let i : (Fin q → MvPolynomial.homogeneousSubmodule (Fin r) Λ n) →ₗ[Λ]
      (Fin q → MvPolynomial (Fin r) Λ) :=
    LinearMap.pi fun a => (MvPolynomial.homogeneousSubmodule (Fin r) Λ n).subtype ∘ₗ
      LinearMap.proj a
  refine Module.Finite.of_surjective (N.mkQ ∘ₗ i) fun x => ?_
  obtain ⟨f, rfl⟩ := N.mkQ_surjective x
  refine ⟨fun a => ⟨MvPolynomial.homogeneousComponent n (f a),
    MvPolynomial.homogeneousComponent_mem n (f a)⟩, ?_⟩
  simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply]
  rw [Submodule.Quotient.eq]
  convert N.neg_mem (hN f) using 1
  rw [neg_sub]
  rfl

end Finite

section Sheaf

universe w v u r

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) {Λ : Type r} [CommRing Λ]

/-- The canonical map to the sections of a constant sheaf is compatible with restriction. -/
theorem constSection_comp_map (M : ModuleCat.{max u v w} Λ) {W W' : C} (g : W' ⟶ W) :
    constSection J M W ≫ ((constantSheaf J (ModuleCat.{max u v w} Λ)).obj M).obj.map g.op =
      constSection J M W' := by
  have h := (toSheafify J ((Functor.const Cᵒᵖ).obj M)).naturality g.op
  simp only [Functor.const_obj_map] at h
  exact h.symm.trans (Category.id_comp _)

/-- The comparison `Stacks.ConstantSheaf.overPullbackConstantSheafIso` carries the canonical
map to the sections of the constant sheaf on the slice site to the canonical map to the sections
of the constant sheaf, over every object of the slice. -/
theorem constSection_comp_overPullbackConstantSheafIso (X : C) (M : ModuleCat.{max u v w} Λ)
    (W : Over X) :
    constSection (J.over X) M W ≫
        ((overPullbackConstantSheafIso J (ModuleCat.{max u v w} Λ) X).hom.app M).hom.app
          (op W) = constSection J M W.left := by
  let g : W ⟶ Over.mk (𝟙 X) := Over.homMk W.hom
  have nat :=
    ((overPullbackConstantSheafIso J (ModuleCat.{max u v w} Λ) X).hom.app M).hom.naturality g.op
  have h0 := toSheafify_overPullbackConstantSheafIso J (ModuleCat.{max u v w} Λ) X M
  rw [← constSection_comp_map (J.over X) M g, Category.assoc, nat, ← Category.assoc]
  change (toSheafify (J.over X) ((Functor.const (Over X)ᵒᵖ).obj M)).app (op (Over.mk (𝟙 X))) ≫
        ((overPullbackConstantSheafIso J (ModuleCat.{max u v w} Λ) X).hom.app M).hom.app
          (op (Over.mk (𝟙 X))) ≫ _ = _ at *
  refine Eq.trans ?_ (constSection_comp_map J M g.left)
  exact (Category.assoc _ _ _).symm.trans (congrArg (· ≫ _) h0)

/-- Two morphisms out of a constant sheaf agree as soon as they agree on the constant sections
over a terminal object. -/
theorem constantSheaf_hom_ext {T : C} (hT : IsTerminal T) {M : ModuleCat.{max u v w} Λ}
    {G : Sheaf J (ModuleCat.{max u v w} Λ)}
    {f g : (constantSheaf J (ModuleCat.{max u v w} Λ)).obj M ⟶ G}
    (h : ∀ x : M, (f.hom.app (op T)).hom ((constSection J M T).hom x) =
      (g.hom.app (op T)).hom ((constSection J M T).hom x)) : f = g := by
  apply ((constantSheafAdj J (ModuleCat.{max u v w} Λ) hT).homEquiv _ _).injective
  rw [constantSheafAdj_homEquiv_apply, constantSheafAdj_homEquiv_apply]
  ext x
  exact h x

section Path

variable {D : Type*} [Category D] {B : ℕ → D} {k : ℕ}

/-- The composite of the maps `ψ` along a word `w` of length `n`, from `B 0` to `B n`. -/
def pathHom (ψ : Fin k → ∀ n, B n ⟶ B (n + 1)) : ∀ {n : ℕ}, (Fin n → Fin k) → (B 0 ⟶ B n)
  | 0, _ => 𝟙 _
  | n + 1, w => pathHom ψ (Fin.init w) ≫ ψ (w (Fin.last n)) n

/-- A functor carries composites along words to composites along words. -/
theorem pathHom_map {D' : Type*} [Category D'] (L : D ⥤ D') (ψ : Fin k → ∀ n, B n ⟶ B (n + 1))
    {n : ℕ} (w : Fin n → Fin k) :
    pathHom (B := fun n => L.obj (B n)) (fun j n => L.map (ψ j n)) w = L.map (pathHom ψ w) := by
  induction n with
  | zero => exact (L.map_id _).symm
  | succ n ih =>
    show pathHom (B := fun n => L.obj (B n)) (fun j n => L.map (ψ j n)) (Fin.init w) ≫ _ = _
    rw [ih]
    exact (L.map_comp _ _).symm

variable [Preadditive D] {D' : Type*} [Category D'] [Preadditive D']

/-- **Generation by composites along words is preserved by left adjoints.** If every morphism
out of `B n` killing all composites along words of length `n` vanishes, the same holds for the
images under a left adjoint whose right adjoint preserves zero morphisms. -/
theorem pathHom_generates_map {L : D ⥤ D'} {R : D' ⥤ D} [R.PreservesZeroMorphisms]
    (adj : L ⊣ R) (ψ : Fin k → ∀ n, B n ⟶ B (n + 1)) {n : ℕ}
    (hgen : ∀ {Z : D} (g : B n ⟶ Z), (∀ w : Fin n → Fin k, pathHom ψ w ≫ g = 0) → g = 0)
    {Z : D'} (g : L.obj (B n) ⟶ Z)
    (hg : ∀ w : Fin n → Fin k,
      pathHom (B := fun n => L.obj (B n)) (fun j n => L.map (ψ j n)) w ≫ g = 0) : g = 0 := by
  apply (adj.homEquiv _ _).injective
  rw [adj.homEquiv_apply, adj.homEquiv_apply, Functor.map_zero, comp_zero]
  refine hgen _ fun w => ?_
  have h := congrArg (fun φ => adj.unit.app (B 0) ≫ R.map φ) (hg w)
  simp only [pathHom_map, Functor.map_comp, Functor.map_zero, comp_zero] at h
  have hn := adj.unit.naturality (pathHom ψ w)
  simp only [Functor.id_map, Functor.comp_map] at hn
  rw [← Category.assoc, hn, Category.assoc]
  simpa using h

/-- **Generation is preserved by a right adjoint on the essential image of a fully faithful left
adjoint.** -/
theorem pathHom_generates_map_of_isIso_counit {L : D' ⥤ D} {R : D ⥤ D'} [L.Faithful]
    [L.PreservesZeroMorphisms] (adj : L ⊣ R) (ψ : Fin k → ∀ n, B n ⟶ B (n + 1)) {n : ℕ}
    [IsIso (adj.counit.app (B 0))] [IsIso (adj.counit.app (B n))]
    (hgen : ∀ {Z : D} (g : B n ⟶ Z), (∀ w : Fin n → Fin k, pathHom ψ w ≫ g = 0) → g = 0)
    {Z : D'} (g : R.obj (B n) ⟶ Z)
    (hg : ∀ w : Fin n → Fin k,
      pathHom (B := fun n => R.obj (B n)) (fun j n => R.map (ψ j n)) w ≫ g = 0) : g = 0 := by
  apply L.map_injective
  rw [L.map_zero]
  have h0 := hgen (inv (adj.counit.app (B n)) ≫ L.map g) fun w => by
    have h := congrArg L.map (hg w)
    rw [pathHom_map, L.map_comp, L.map_zero] at h
    have hn := adj.counit.naturality (pathHom ψ w)
    simp only [Functor.id_map, Functor.comp_map] at hn
    rw [← cancel_epi (adj.counit.app (B 0)), comp_zero, ← Category.assoc, ← hn,
      Category.assoc, IsIso.hom_inv_id_assoc]
    exact h
  rw [← cancel_epi (inv (adj.counit.app (B n))), h0, comp_zero]

end Path

variable {J} {B : ℕ → Sheaf J (ModuleCat.{max u v w} Λ)} {k : ℕ}

/-- On sections over `W`, the composite `pathHom ψ w` is the composite `gradedPath` of the maps
induced by `ψ` on sections. -/
theorem pathHom_app (ψ : Fin k → ∀ n, B n ⟶ B (n + 1)) {n : ℕ} (w : Fin n → Fin k) (W : C)
    (x : (B 0).obj.obj (op W)) :
    ((pathHom ψ w).hom.app (op W)).hom x =
      gradedPath (fun j n => ((ψ j n).hom.app (op W)).hom) w x := by
  induction n with
  | zero => rfl
  | succ n ih =>
    show ((ψ (w (Fin.last n)) n).hom.app (op W)).hom
      (((pathHom ψ (Fin.init w)).hom.app (op W)).hom x) = _
    rw [ih]
    rfl

/-- **Uniform constancy of a graded sheaf generated in degree zero.** -/
theorem exists_constantSheaf_iso_overPullback_of_graded [IsNoetherianRing Λ] [UnivLE.{r, max u v w}]
    {T : C}
    (hT : IsTerminal T) (hT₀ : (⊥ : Sieve T) ∉ J T) (ψ : Fin k → ∀ n, B n ⟶ B (n + 1))
    (hψ : ∀ i j n, ψ i n ≫ ψ j (n + 1) = ψ j n ≫ ψ i (n + 1))
    (hgen : ∀ (n : ℕ) {Z : Sheaf J (ModuleCat.{max u v w} Λ)} (g : B n ⟶ Z),
      (∀ w : Fin n → Fin k, pathHom ψ w ≫ g = 0) → g = 0)
    (M : ModuleCat.{max u v w} Λ) [Module.Finite Λ M]
    (c : (constantSheaf J (ModuleCat.{max u v w} Λ)).obj M ≅ B 0) :
    ∃ U₀ : C, (⊥ : Sieve U₀) ∉ J U₀ ∧ ∀ n, ∃ E : ModuleCat.{max u v w} Λ,
      Module.Finite Λ E ∧ Nonempty ((constantSheaf (J.over U₀) (ModuleCat.{max u v w} Λ)).obj E ≅
        (J.overPullback (ModuleCat.{max u v w} Λ) U₀).obj (B n)) := by
  classical
  obtain ⟨q, m, hm⟩ := Module.Finite.exists_fin (R := Λ) (M := M)
  let ψW (W : C) (j : Fin k) (n : ℕ) :
      (B n).obj.obj (op W) →ₗ[Λ] (B (n + 1)).obj.obj (op W) := ((ψ j n).hom.app (op W)).hom
  have hψW (W : C) (i j : Fin k) (n : ℕ) (x : (B n).obj.obj (op W)) :
      ψW W j (n + 1) (ψW W i n x) = ψW W i (n + 1) (ψW W j n x) :=
    congrArg (fun f => (f.hom.app (op W)).hom x) (hψ i j n)
  let τ (W : C) : M →ₗ[Λ] (B 0).obj.obj (op W) :=
    (c.hom.hom.app (op W)).hom ∘ₗ (constSection J M W).hom
  let y (W : C) (a : Fin q) : (B 0).obj.obj (op W) := τ W (m a)
  let Φ (W : C) := gradedEval (ψW W) (hψW W) (y W)
  let ρ {W W' : C} (g : W' ⟶ W) (n : ℕ) : (B n).obj.obj (op W) →ₗ[Λ] (B n).obj.obj (op W') :=
    ((B n).obj.map g.op).hom
  have hρ {W W' : C} (g : W' ⟶ W) (j : Fin k) (n : ℕ) (x : (B n).obj.obj (op W)) :
      ρ g (n + 1) (ψW W j n x) = ψW W' j n (ρ g n x) :=
    (congrArg (fun f => f.hom x) ((ψ j n).hom.naturality g.op)).symm
  have hy {W W' : C} (g : W' ⟶ W) (a : Fin q) : ρ g 0 (y W a) = y W' a := by
    have h1 := congrArg (fun f => f.hom (m a)) (constSection_comp_map J M g)
    have h2 := congrArg (fun f => f.hom ((constSection J M W).hom (m a)))
      (c.hom.hom.naturality g.op)
    simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply] at h1 h2
    show ((B 0).obj.map g.op).hom ((c.hom.hom.app (op W)).hom ((constSection J M W).hom (m a))) =
      (c.hom.hom.app (op W')).hom ((constSection J M W').hom (m a))
    rw [← h1, ← h2]
  have hΦ {W W' : C} (g : W' ⟶ W) (f : Fin q → MvPolynomial (Fin k) Λ) (n : ℕ) :
      ρ g n (Φ W f n) = Φ W' f n := by
    simpa only [hy g] using
      congrFun (gradedEval_naturality (ψW W) (hψW W) (hψW W') (ρ g) (hρ g) (y W) f) n
  have hmono {W W' : C} (g : W' ⟶ W) :
      gradedKernel (ψW W) (hψW W) (y W) ≤ gradedKernel (ψW W') (hψW W') (y W') := by
    simpa only [hy g] using gradedKernel_le (ψW W) (hψW W) (hψW W') (ρ g) (hρ g) (y W)
  obtain ⟨U₀, f₀, hU₀, hmax⟩ := exists_eq_of_isNoetherian J T hT₀
    (fun {W} _ => gradedKernel (ψW W) (hψW W) (y W)) (fun _ g => hmono g)
  refine ⟨U₀, hU₀, fun n => ?_⟩
  let D := Fin q → MvPolynomial (Fin k) Λ
  let eD := Shrink.linearEquiv.{max u v w} Λ D
  let Dl : ModuleCat.{max u v w} Λ := ModuleCat.of Λ (Shrink.{max u v w} D)
  let φ : Dl ⟶ (B n).obj.obj (op T) :=
    ModuleCat.ofHom ((LinearMap.proj n ∘ₗ Φ T) ∘ₗ eD.toLinearMap)
  let P : (constantSheaf J (ModuleCat.{max u v w} Λ)).obj Dl ⟶ B n :=
    ((constantSheafAdj J (ModuleCat.{max u v w} Λ) hT).homEquiv _ _).symm φ
  have hP (W : C) (a : Dl) :
      (P.hom.app (op W)).hom ((constSection J Dl W).hom a) = Φ W (eD a) n := by
    have h1 : constSection J Dl T ≫ P.hom.app (op T) = φ :=
      (constantSheafAdj_homEquiv_apply J _ hT Dl (B n) P).symm.trans
        (Equiv.apply_symm_apply _ _)
    rw [← constSection_comp_map J Dl (hT.from W)]
    have h2 := congrArg (fun f => f.hom a) (constSection J Dl T ≫= P.hom.naturality (hT.from W).op)
    simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply] at h2
    show (P.hom.app (op W)).hom ((((constantSheaf J _).obj Dl).obj.map (hT.from W).op).hom
      ((constSection J Dl T).hom a)) = _
    rw [h2, ← hΦ (hT.from W)]
    have h3 := congrArg (fun f => f.hom a) h1
    simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply] at h3
    show ρ (hT.from W) n ((P.hom.app (op T)).hom ((constSection J Dl T).hom a)) = _
    rw [h3]
    rfl
  have hPepi : Epi P := by
    refine Preadditive.epi_of_cancel_zero P fun {Z} g hg => hgen n g fun w => ?_
    let Lq := Fin q → Λ
    let eq := Shrink.linearEquiv.{max u v w} Λ Lq
    let Λq : ModuleCat.{max u v w} Λ := ModuleCat.of Λ (Shrink.{max u v w} Lq)
    let π : Λq ⟶ M := ModuleCat.ofHom (Fintype.linearCombination Λ m ∘ₗ eq.toLinearMap)
    have hπ : Function.Surjective π := by
      intro x
      have hx : x ∈ LinearMap.range (Fintype.linearCombination Λ m) := by
        rw [Fintype.range_linearCombination, hm]
        trivial
      obtain ⟨l, rfl⟩ := hx
      exact ⟨eq.symm l, by simp [π]⟩
    have : Epi π := (ModuleCat.epi_iff_surjective π).2 hπ
    have : (constantSheaf J (ModuleCat.{max u v w} Λ)).IsLeftAdjoint :=
      ⟨_, ⟨constantSheafAdj J _ hT⟩⟩
    let X : MvPolynomial (Fin k) Λ := ∏ i, MvPolynomial.X (w i)
    let θ : Λq ⟶ Dl := ModuleCat.ofHom (eD.symm.toLinearMap ∘ₗ
      (LinearMap.pi fun a => LinearMap.smulRight (LinearMap.proj a) X) ∘ₗ eq.toLinearMap)
    have key : (constantSheaf J _).map π ≫ c.hom ≫ pathHom ψ w =
        (constantSheaf J _).map θ ≫ P := by
      refine constantSheaf_hom_ext J hT fun l => ?_
      have nat {X Y : ModuleCat.{max u v w} Λ} (f : X ⟶ Y) (x : X) :
          (((constantSheaf J _).map f).hom.app (op T)).hom ((constSection J X T).hom x) =
            (constSection J Y T).hom (f.hom x) :=
        (congrArg (fun g => g.hom x) (toSheafify_const_naturality_app J _ f (op T))).symm
      simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, ModuleCat.hom_comp,
        LinearMap.comp_apply]
      show _ = (P.hom.app (op T)).hom ((((constantSheaf J _).map θ).hom.app (op T)).hom
        ((constSection J Λq T).hom l))
      show ((pathHom ψ w).hom.app (op T)).hom ((c.hom.hom.app (op T)).hom
        ((((constantSheaf J _).map π).hom.app (op T)).hom ((constSection J Λq T).hom l))) = _
      rw [nat π, nat θ]
      have e1 : ((pathHom ψ w).hom.app (op T)).hom ((c.hom.hom.app (op T)).hom
          ((constSection J M T).hom (π.hom l))) = ∑ a, (eq l a) • gradedPath (ψW T) w (y T a) := by
        rw [pathHom_app]
        simp only [π, ModuleCat.hom_ofHom, LinearMap.comp_apply, Fintype.linearCombination_apply,
          map_sum, map_smul]
        rfl
      have e2 : (P.hom.app (op T)).hom ((constSection J Dl T).hom (θ.hom l)) =
          ∑ a, (eq l a) • gradedPath (ψW T) w (y T a) := by
        rw [hP]
        simp only [θ, Φ, ModuleCat.hom_ofHom, LinearMap.comp_apply, LinearEquiv.coe_coe,
          LinearEquiv.apply_symm_apply, gradedEval_apply, X, Finset.sum_apply]
        refine Finset.sum_congr rfl fun a _ => ?_
        show gradedPolyAct (ψW T) (hψW T) (eq l a • X) (Pi.single 0 (y T a)) n = _
        rw [gradedPolyAct_smul, LinearMap.smul_apply, gradedPolyAct_prod_X_single, Pi.smul_apply,
          Pi.single_eq_same]
      exact e1.trans e2.symm
    have : Epi ((constantSheaf J (ModuleCat.{max u v w} Λ)).map π ≫ c.hom) := epi_comp _ _
    rw [← cancel_epi ((constantSheaf J (ModuleCat.{max u v w} Λ)).map π ≫ c.hom), comp_zero,
      Category.assoc, ← Category.assoc c.hom, ← Category.assoc, key, Category.assoc, hg,
      comp_zero]
  have : (J.overPullback (ModuleCat.{max u v w} Λ) U₀).IsLeftAdjoint :=
    ⟨_, ⟨(Over.forget U₀).sheafAdjunctionCocontinuous _ (J.over U₀) J⟩⟩
  let p : (constantSheaf (J.over U₀) (ModuleCat.{max u v w} Λ)).obj Dl ⟶
      (J.overPullback (ModuleCat.{max u v w} Λ) U₀).obj (B n) :=
    (overPullbackConstantSheafIso J _ U₀).hom.app Dl ≫
      (J.overPullback (ModuleCat.{max u v w} Λ) U₀).map P
  have : Epi p := epi_comp _ _
  have hp (W : Over U₀) (a : Dl) :
      (p.hom.app (op W)).hom ((constSection (J.over U₀) Dl W).hom a) = Φ W.left (eD a) n := by
    have h := congrArg (fun f => f.hom a) (constSection_comp_overPullbackConstantSheafIso J U₀ Dl W)
    show (P.hom.app (op W.left)).hom ((((overPullbackConstantSheafIso J _ U₀).hom.app Dl).hom.app
      (op W)).hom ((constSection (J.over U₀) Dl W).hom a)) = _
    have h' : (((overPullbackConstantSheafIso J _ U₀).hom.app Dl).hom.app (op W)).hom
        ((constSection (J.over U₀) Dl W).hom a) = (constSection J Dl W.left).hom a := h
    rw [h', hP]
  let N₀ : Submodule Λ D := LinearMap.ker (LinearMap.proj n ∘ₗ Φ U₀)
  let N : Submodule Λ Dl := N₀.comap eD.toLinearMap
  have hbot (W : Over U₀) (hW : (⊥ : Sieve W) ∉ (J.over U₀) W) : (⊥ : Sieve W.left) ∉ J W.left := by
    rwa [GrothendieckTopology.mem_over_iff, map_bot] at hW
  obtain ⟨e⟩ := nonempty_constantSheaf_quotient_iso (J.over U₀) Dl N _ p
    (fun W a ha => by
      rw [hp, ← hΦ W.hom, show Φ U₀ (eD a) n = 0 from ha]
      exact map_zero _)
    (fun W hW a ha => by
      rw [hp] at ha
      show Φ U₀ (eD a) n = 0
      have ha' : Φ W.left (eD a) n = 0 := ha
      rw [gradedEval_apply_eq_zero_iff] at ha' ⊢
      rwa [← hmax W.hom (hbot W hW)])
  refine ⟨ModuleCat.of Λ (Dl ⧸ N), ?_, ⟨e⟩⟩
  have hfin : Module.Finite Λ (D ⧸ N₀) := by
    refine finite_quotient_of_sub_homogeneousComponent_mem n N₀ fun f => ?_
    show Φ U₀ (f - _) n = 0
    rw [map_sub, Pi.sub_apply, (gradedEval_apply_homogeneousComponent _ _ _ f n).1, sub_self]
  exact Module.Finite.equiv
    (Submodule.Quotient.equiv N N₀ eD (Submodule.map_comap_eq_of_surjective eD.surjective _)).symm

end Sheaf

end Stacks.ConstantSheaf

