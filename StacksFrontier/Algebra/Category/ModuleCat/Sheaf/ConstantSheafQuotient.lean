/-!
# Quotients of a constant sheaf of modules by a constant ideal

Let `J` be a Grothendieck topology on `C`, let `R` be a Noetherian commutative ring and let
`I` be an ideal of `R`. The quotient of the constant sheaf `R̲` by the ideal `I` is the constant
sheaf `(R/I)̲`, for either reading of "quotient by `I`": the cokernel of the constant inclusion
`I̲ ⟶ R̲`, or the cokernel of the subsheaf of `R̲` generated by `I`, i.e. of the image of that
inclusion. On every object `U` of `C`, the range of `Γ(U, I̲) ⟶ Γ(U, R̲)` is `I · Γ(U, R̲)`.

## Main results

* `Stacks.ConstantSheaf.constantSheaf_idealAction_sections`: on every object, the image of the
  constant ideal is the ideal acting on sections of the constant ring sheaf.
* `Stacks.ConstantSheaf.constantSheaf_idealAction_sections_of_fg`: the same statement for a
  finitely generated ideal over an arbitrary commutative ring.
* `Stacks.ConstantSheaf.constantSheaf_quotientByConstantIdeal` and
  `Stacks.ConstantSheaf.constantSheaf_quotientByConstantIdeal_hom_comp`: the quotient by the
  constant ideal sheaf is the constant sheaf of `R/I`, by an isomorphism carrying the cokernel
  projection to the constant sheaf of `R ⟶ R/I`.
* `Stacks.ConstantSheaf.constantSheaf_quotientByIdealAction` and
  `Stacks.ConstantSheaf.constantSheaf_quotientByIdealAction_hom_comp`: the same for the
  quotient by the image ideal subsheaf.

## References

* [Stacks Project, Tag 093M](https://stacks.math.columbia.edu/tag/093M)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace Stacks.ConstantSheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable {R : Type w} [CommRing R] [IsNoetherianRing R] (I : Ideal R)
variable [HasSheafify J (ModuleCat.{w} R)]

/-- Multiplication by `i : I` on sections of the constant sheaf on `R'` factors through `I`. -/
private theorem map_toSpanSingleton_comp_map_subtype {R' : Type w} [CommRing R']
    [HasWeakSheafify J (ModuleCat.{w} R')] (I' : Ideal R')
    (U : C) (i : I') :
    (constantSections J U (R := R')).map (ModuleCat.ofHom (LinearMap.toSpanSingleton R' I' i)) ≫
        (constantSections J U).map (ModuleCat.ofHom I'.subtype) =
      (i : R') • 𝟙 ((constantSections J U).obj (ModuleCat.of R' R')) := by
  have hlin : I'.subtype.comp (LinearMap.toSpanSingleton R' I' i) =
      (i : R') • (LinearMap.id : R' →ₗ[R'] R') := by
    ext
    simp [LinearMap.toSpanSingleton_apply]
  have hsmul : ModuleCat.ofHom ((i : R') • (LinearMap.id : R' →ₗ[R'] R')) =
      (i : R') • (𝟙 (ModuleCat.of R' R')) := by ext; rfl
  rw [← Functor.map_comp, ← ModuleCat.ofHom_comp, hlin, hsmul, Functor.map_smul]
  simp

/-- The ideal `I'` acting on the sections of the constant sheaf on `R'` lies in the range of the
sections of the constant inclusion `I̲' ⟶ R̲'`. -/
private theorem ideal_smul_top_le_range_map_subtype {R' : Type w} [CommRing R']
    [HasWeakSheafify J (ModuleCat.{w} R')] (I' : Ideal R')
    (U : C) :
    I' • (⊤ : Submodule R' ((constantSections J U (R := R')).obj (ModuleCat.of R' R'))) ≤
      LinearMap.range ((constantSections J U).map (ModuleCat.ofHom I'.subtype)).hom :=
  Submodule.smul_le.mpr fun i hi s _ ↦ LinearMap.mem_range.mpr
    ⟨((constantSections J U).map
      (ModuleCat.ofHom (LinearMap.toSpanSingleton R' I' ⟨i, hi⟩))).hom s, by
    simpa only [ModuleCat.comp_apply, ModuleCat.hom_smul, ModuleCat.hom_id,
      LinearMap.smul_apply, LinearMap.id_apply] using LinearMap.congr_fun
        (congrArg ModuleCat.Hom.hom (map_toSpanSingleton_comp_map_subtype J I' U ⟨i, hi⟩)) s⟩

section Sections

variable [HasWeakSheafify J (Type w)]
  [J.PreservesSheafification (forget (ModuleCat.{w} R))]
  [J.HasSheafCompose (forget (ModuleCat.{w} R))]

/-- The image of the constant ideal sheaf on each object is the ideal acting on sections of the
constant ring sheaf. -/
@[stacks 093M "sections of the ideal subsheaf"]
theorem constantSheaf_idealAction_sections (U : C) :
    LinearMap.range
      ((constantSheaf J (ModuleCat.{w} R) ⋙
        (sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          (ModuleCat.ofHom I.subtype)).hom =
      I • (⊤ : Submodule R
        ((constantSheaf J (ModuleCat.{w} R) ⋙
          (sheafSections J (ModuleCat.{w} R)).obj (op U)).obj (ModuleCat.of R R))) := by
  let H := constantSections J U (R := R)
  let S := H.obj (ModuleCat.of R R)
  let T := H.obj (ModuleCat.of R I)
  let f : ModuleCat.of R I ⟶ ModuleCat.of R R := ModuleCat.ofHom I.subtype
  let m : T ⟶ S := H.map f
  have : Module.Finite R I := Module.Finite.of_fg (IsNoetherian.noetherian I)
  have : Module.FinitePresentation R I := Module.finitePresentation_of_finite R I
  let c := tensorComparison J (ModuleCat.of R R) (ModuleCat.of R I)
    (ModuleCat.of R I) (TensorProduct.lid R I) U
  have hc : Function.Bijective c.1 :=
    bijective_tensorComparison J (ModuleCat.of R R) (ModuleCat.of R I)
      (ModuleCat.of R I) (TensorProduct.lid R I) U
  have hlid (i : I) : (TensorProduct.lid R (I : Type w)).toLinearMap.comp
      ((TensorProduct.mk R (ModuleCat.of R R) (ModuleCat.of R I)).flip i) =
      LinearMap.toSpanSingleton R I i := by
    ext
    simp [TensorProduct.lid_tmul, LinearMap.toSpanSingleton_apply]
  have hpure (s : S) (i : I) : m.hom (c.1 (s ⊗ₜ[R] i)) = (i : R) • s := by
    rw [c.2 s i, hlid i]
    simpa only [ModuleCat.comp_apply, ModuleCat.hom_smul, ModuleCat.hom_id,
      LinearMap.smul_apply, LinearMap.id_apply] using
        LinearMap.congr_fun (congrArg ModuleCat.Hom.hom
          (map_toSpanSingleton_comp_map_subtype J I U i)) s
  have hleft : LinearMap.range m.hom ≤ I • (⊤ : Submodule R S) := by
    rintro _ ⟨t, rfl⟩
    obtain ⟨z, rfl⟩ := hc.surjective t
    induction z using TensorProduct.inductionOn with
    | add z z' hz hz' => simpa using add_mem hz hz'
    | tmul s i =>
      rw [hpure]
      exact Submodule.smul_mem_smul i.2 (by simp)
  exact le_antisymm hleft (ideal_smul_top_le_range_map_subtype J I U)

omit [IsNoetherianRing R] in
/-- For a finitely generated ideal `I` of a commutative ring `R`, on every object the image of
the sections of the constant sheaf on `I` is the ideal `I` acting on the sections of the constant
sheaf on `R`. -/
theorem constantSheaf_idealAction_sections_of_fg (hI : I.FG) (U : C) :
    LinearMap.range
      ((constantSheaf J (ModuleCat.{w} R) ⋙
        (sheafSections J (ModuleCat.{w} R)).obj (op U)).map
          (ModuleCat.ofHom I.subtype)).hom =
      I • (⊤ : Submodule R
        ((constantSheaf J (ModuleCat.{w} R) ⋙
          (sheafSections J (ModuleCat.{w} R)).obj (op U)).obj (ModuleCat.of R R))) := by
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  have hgI : ∀ j, g j ∈ I := fun j ↦ by
    rw [← hg]
    exact Submodule.subset_span (Set.mem_range_self j)
  let H := constantSections J U (R := R)
  let S := H.obj (ModuleCat.of R R)
  let f : ModuleCat.of R I ⟶ ModuleCat.of R R := ModuleCat.ofHom I.subtype
  let φ : (Fin n → R) →ₗ[R] R :=
    ∑ j : Fin n, g j • (LinearMap.proj j : (Fin n → R) →ₗ[R] R)
  have hφ : ∀ c : Fin n → R, φ c = ∑ j : Fin n, g j * c j := fun c ↦ by
    simp [φ, LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.proj_apply]
  have hφmem : ∀ c : Fin n → R, φ c ∈ I := fun c ↦ by
    rw [hφ]
    exact Ideal.sum_mem _ fun j _ ↦ Ideal.mul_mem_right _ _ (hgI j)
  let ql : (Fin n → R) →ₗ[R] I := LinearMap.codRestrict I φ hφmem
  have hsub : I.subtype.comp ql = φ := LinearMap.subtype_comp_codRestrict _ _ _
  let q : ModuleCat.of R (Fin n → R) ⟶ ModuleCat.of R I := ModuleCat.ofHom ql
  let pj : Fin n → (ModuleCat.of R (Fin n → R) ⟶ ModuleCat.of R R) :=
    fun j ↦ ModuleCat.ofHom (LinearMap.proj j)
  have hqsurj : Function.Surjective q.hom := by
    intro i
    have hi : (i : R) ∈ Submodule.span R (Set.range g) := by rw [hg]; exact i.2
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hi
    refine ⟨c, Subtype.ext ?_⟩
    rw [show ((q.hom c : I) : R) = φ c from LinearMap.congr_fun hsub c, hφ, ← hc]
    exact Finset.sum_congr rfl fun j _ ↦ by rw [smul_eq_mul, mul_comm]
  have hqf : q ≫ f = ∑ j : Fin n, g j • pj j := by
    apply ModuleCat.hom_ext
    rw [ModuleCat.hom_comp, ModuleCat.hom_sum]
    change I.subtype.comp ql = _
    rw [hsub]
    exact Finset.sum_congr rfl fun j _ ↦ rfl
  have hleft : LinearMap.range (H.map f).hom ≤ I • (⊤ : Submodule R S) := by
    rintro _ ⟨t, rfl⟩
    obtain ⟨y, rfl⟩ := surjective_constantSections_map J q hqsurj U t
    have hmap : H.map q ≫ H.map f = ∑ j : Fin n, g j • H.map (pj j) := by
      rw [← Functor.map_comp, hqf, CategoryTheory.Functor.map_sum]
      exact Finset.sum_congr rfl fun j _ ↦ CategoryTheory.Functor.map_smul _ _ _
    have hval : (H.map f).hom ((H.map q).hom y) =
        ∑ j : Fin n, g j • (H.map (pj j)).hom y := by
      simpa only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply,
        ModuleCat.hom_sum, ModuleCat.hom_smul, LinearMap.sum_apply, LinearMap.smul_apply]
        using LinearMap.congr_fun
          (congrArg (fun ψ : H.obj (ModuleCat.of R (Fin n → R)) ⟶ S ↦ ψ.hom) hmap) y
    rw [hval]
    exact Submodule.sum_mem _ fun j _ ↦ Submodule.smul_mem_smul (hgI j) Submodule.mem_top
  exact le_antisymm hleft (ideal_smul_top_le_range_map_subtype J I U)

end Sections

/-- The canonical isomorphism from the quotient by the constant ideal sheaf to the constant sheaf
of the quotient ring. -/
@[stacks 093M "quotient by the constant ideal sheaf"]
noncomputable def constantSheaf_quotientByConstantIdeal :
    let f := (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.subtype)
    cokernel f ≅ (constantSheaf J (ModuleCat.{w} R)).obj (ModuleCat.of R (R ⧸ I)) := by
  dsimp
  let F := constantSheaf J (ModuleCat.{w} R)
  let f₀ : ModuleCat.of R I ⟶ ModuleCat.of R R := ModuleCat.ofHom I.subtype
  have : PreservesColimit (parallelPair f₀ 0) F := by
    dsimp only [F, constantSheaf]
    infer_instance
  let f := F.map f₀
  have hr : LinearMap.range f₀.hom = I := by simp [f₀]
  let qIso : cokernel f₀ ≅ ModuleCat.of R (R ⧸ I) :=
    (ModuleCat.cokernelIsoRangeQuotient f₀) ≪≫ (Submodule.quotEquivOfEq _ _ hr).toModuleIso
  let cokerIso : cokernel f ≅ F.obj (cokernel f₀) :=
    (cokernelIsCokernel f).coconePointUniqueUpToIso
      (isColimitOfHasCokernelOfPreservesColimit F f₀)
  exact cokerIso ≪≫ F.mapIso qIso

omit [IsNoetherianRing R] in
/-- The quotient isomorphism intertwines the cokernel projection with the constant sheaf of the
ring quotient map. -/
@[stacks 093M "quotient by the constant ideal sheaf"]
theorem constantSheaf_quotientByConstantIdeal_hom_comp :
    let f := (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.subtype)
    cokernel.π f ≫ (constantSheaf_quotientByConstantIdeal J I).hom =
      (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.mkQ) := by
  dsimp [constantSheaf_quotientByConstantIdeal]
  let F := constantSheaf J (ModuleCat.{w} R)
  let f₀ : ModuleCat.of R I ⟶ ModuleCat.of R R := ModuleCat.ofHom I.subtype
  let f := F.map f₀
  have hr : LinearMap.range f₀.hom = I := by simp [f₀]
  have : PreservesColimit (parallelPair f₀ 0) F := by
    dsimp only [F, constantSheaf]
    infer_instance
  let qIso : cokernel f₀ ≅ ModuleCat.of R (R ⧸ I) :=
    (ModuleCat.cokernelIsoRangeQuotient f₀) ≪≫ (Submodule.quotEquivOfEq _ _ hr).toModuleIso
  let hpres := isColimitOfHasCokernelOfPreservesColimit F f₀
  change cokernel.π f ≫
      ((cokernelIsCokernel f).coconePointUniqueUpToIso hpres ≪≫ F.mapIso qIso).hom =
    F.map (ModuleCat.ofHom I.mkQ)
  rw [Iso.trans_hom, Functor.mapIso_hom, ← Category.assoc]
  have hquot' : cokernel.π f ≫
      ((cokernelIsCokernel f).coconePointUniqueUpToIso hpres).hom =
        F.map (cokernel.π f₀) := by
    simpa using IsColimit.comp_coconePointUniqueUpToIso_hom
      (cokernelIsCokernel f) hpres WalkingParallelPair.one
  have hmodule : cokernel.π f₀ ≫ qIso.hom = ModuleCat.ofHom I.mkQ := by
    dsimp only [qIso]
    rw [Iso.trans_hom, ← Category.assoc, ModuleCat.cokernel_π_cokernelIsoRangeQuotient_hom,
      LinearEquiv.toModuleIso_hom, ← ModuleCat.ofHom_comp]
    apply ModuleCat.hom_ext
    ext
    change ((ModuleCat.Hom.hom f₀).range.quotEquivOfEq I hr)
        (Submodule.Quotient.mk (1 : R)) = Submodule.Quotient.mk (1 : R)
    rw [Submodule.quotEquivOfEq_mk]
  rw [hquot', ← Functor.map_comp, hmodule]

/-- The canonical isomorphism from the quotient by the image ideal subsheaf, equivalently the
ideal generated by `I` in the constant ring sheaf, to the constant sheaf of the quotient ring. -/
@[stacks 093M "quotient by the ideal subsheaf"]
noncomputable def constantSheaf_quotientByIdealAction :
    let f := (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.subtype)
    cokernel (image.ι f) ≅
      (constantSheaf J (ModuleCat.{w} R)).obj (ModuleCat.of R (R ⧸ I)) := by
  dsimp
  exact cokernelImageι _ ≪≫ constantSheaf_quotientByConstantIdeal J I

omit [IsNoetherianRing R] in
/-- The image-ideal quotient isomorphism intertwines its quotient projection with the constant
sheaf of the ring quotient map. -/
@[stacks 093M "quotient by the ideal subsheaf"]
theorem constantSheaf_quotientByIdealAction_hom_comp :
    let f := (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.subtype)
    cokernel.π (image.ι f) ≫ (constantSheaf_quotientByIdealAction J I).hom =
      (constantSheaf J (ModuleCat.{w} R)).map (ModuleCat.ofHom I.mkQ) := by
  dsimp [constantSheaf_quotientByIdealAction]
  simpa [cokernelImageι_hom] using constantSheaf_quotientByConstantIdeal_hom_comp J I

end Stacks.ConstantSheaf
