* [Stacks Project, Tag 0F7T](https://stacks.math.columbia.edu/tag/0F7T)
-/

@[expose] public section

attribute [local instance_reducible] TopCat.Sheaf CategoryTheory.sheafCompose
  AlgebraicGeometry.SheafedSpace.sheaf
  Stacks.SheafOfModules.TensorSheafification.structureSheaf

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

open Stacks.SheafOfModules.TensorStalkRingedSpace (ringStalk grpStalk)

universe u

namespace Stacks.IdealTorsion.Reduction

open Stacks.IdealTorsion.Eta

attribute [local instance 10000] HasDerivedCategory.standard

variable (X : RingedSpace.{u, u})

local notation "Oₓ" =>
  (Stacks.SheafOfModules.Tensor.ringSheaf
    (CategoryTheory.ObjectProperty.FullSubcategory.mk X.presheaf X.IsSheaf))
local notation "𝒪" => SheafOfModules.unit Oₓ

/-! ### The generator of the stalk ideal in Situation 0GT4 -/

/-- **In Situation 0GT4 the stalk ideal has a generator which is a nonzerodivisor, at every point
of an arbitrary ringed space.**  A neighbourhood on which the ideal is generated by a
nonzerodivisor trivializes the stalk of the ideal
(`Eta.isFiniteFreeStalkOfRank_one_of_isLocallyGeneratedByRegular`), and a trivialization produces
the generator together with its nonzerodivisor property
(`Eta.exists_generatesStalkIdeal_mem_nonZeroDivisors`).

This is `exists_stalkGenerator` with the hypothesis `[∀ z : X, IsLocalRing (X.presheaf.stalk z)]`
removed and replaced by the situation's own condition (1) of Tag 0GT3.  That hypothesis is not a
weakening of anything: it was needed only to get freeness of rank one out of invertibility
alone, which is the direction of Tag 0GT3 that fails over a general ringed space. -/
public theorem exists_stalkGenerator_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι) (x : X) :
    ∃ f : ringStalk X x,
      GeneratesStalkIdeal X ι x f ∧ f ∈ nonZeroDivisors (ringStalk X x) :=
  exists_generatesStalkIdeal_mem_nonZeroDivisors X I ι x
    (nonempty_ideal_stalk_linearEquiv X I x
      (isFiniteFreeStalkOfRank_one_of_isLocallyGeneratedByRegular X I ι hregl x)).some

/-! ### The stalkwise comparison square holds -/

/-- The stalkwise comparison square holds as soon as every stalk ideal has a generator which is a
nonzerodivisor. -/
private theorem hasStalkBocksteinSquare_of_forall_stalkGenerator
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k))
    (h : ∀ x : X, ∃ f : ringStalk X x,
      GeneratesStalkIdeal X ι x f ∧ f ∈ nonZeroDivisors (ringStalk X x)) :
    HasStalkBocksteinSquare X I ι F hF := by
  intro x
  obtain ⟨f, hgen, hf⟩ := h x
  exact ⟨f, hgen, hf, isSMulRegular_stalkComplex X I ι F hF x f hgen,
    fun n => map_reductionComparison_comp_bocksteinChainStalkTermIso X I ι F hF x f hgen hf
      (isSMulRegular_stalkComplex X I ι F hF x f hgen) n⟩

/-- **Tag 0GT9's stalkwise comparison square, in Situation 0GT4.**  The square itself is
`map_reductionComparison_comp_bocksteinChainStalkTermIso`; the generator and its two regularity
properties come from `exists_stalkGenerator_of_isLocallyGeneratedByRegular` and
`isSMulRegular_stalkComplex`.

This is the first inhabitant of `HasStalkBocksteinSquare`, and with it every statement of this
development that was conditional on that predicate becomes unconditional in the source's own
situation. -/
public theorem hasStalkBocksteinSquare_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    HasStalkBocksteinSquare X I ι F hF :=
  hasStalkBocksteinSquare_of_forall_stalkGenerator X I ι F hF
    (exists_stalkGenerator_of_isLocallyGeneratedByRegular X I ι hregl)

/-- **Tag 0GT9's stalkwise comparison square under condition (2) of Tag 0GT3, on a space whose
structure-sheaf stalks are local rings** — in particular on every scheme.  There the generator
comes from `exists_stalkGenerator` instead, invertibility of the ideal being enough once the
stalks are local. -/
public theorem hasStalkBocksteinSquare_of_isLocalRing
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    [∀ z : X, IsLocalRing (X.presheaf.stalk z)]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    HasStalkBocksteinSquare X I ι F hF :=
  hasStalkBocksteinSquare_of_forall_stalkGenerator X I ι F hF (exists_stalkGenerator X I ι)

/-! ### The chain-level conclusions, unconditionally -/

/-- **Tag 0GT9's comparison of complexes is a quasi-isomorphism**, in Situation 0GT4. -/
public theorem quasiIso_reductionComparisonChainMap_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    QuasiIso (reductionComparisonChainMap X I ι F hF) :=
  quasiIso_reductionComparisonChainMap_of_hasStalkBocksteinSquare X I ι F hF
    (hasStalkBocksteinSquare_of_isLocallyGeneratedByRegular X I ι hregl F hF)

/-- **The kernel complex of `EtaSheafReductionQuasiIso.lean` is acyclic**, in Situation 0GT4.
This is the form in which the development recorded Tag 0GT9's remaining obligation at the level
of complexes. -/
public theorem acyclic_reductionComparisonKernel_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    (reductionComparisonKernel X I ι F hF).Acyclic :=
  acyclic_reductionComparisonKernel_of_hasStalkBocksteinSquare X I ι F hF
    (hasStalkBocksteinSquare_of_isLocallyGeneratedByRegular X I ι hregl F hF)

/-! ### The tag's conclusion in `D(O_X)` -/

/-- **Stacks Project, Tag 0GT9.**  In Situation 0GT4, on a complex `F` of `I`-torsion-free
`O_X`-modules, the canonical arrow

`η_I F ⊗ O_X/I ⟶ H^•(F/I)`

of `D(O_X)` is invertible.  The inputs are those of the situation: the ideal is locally generated
by a nonzerodivisor and `F` is termwise `I`-torsion-free, which is what Lemma 20.55.6 provides for
an arbitrary object of `D(O_X)`. -/
@[stacks 0GT9 "in Situation 0GT4: the canonical arrow of D(O_X) is invertible"]
public theorem isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    IsIso (reductionComparisonQ X I ι F hF) :=
  (isIso_reductionComparisonQ_iff_quasiIso X I ι F hF).2
    (quasiIso_reductionComparisonChainMap_of_isLocallyGeneratedByRegular X I ι hregl F hF)

/-- **Stacks Project, Tag 0GT9.**  The canonical isomorphism

`η_I F ⊗ O_X/I ≅ H^•(F/I)` in `D(O_X)`,

in Situation 0GT4, as an explicit isomorphism.  This is the tag's own
conclusion: "there is a canonical isomorphism".

The forward map is `DerivedCategory.Q.map` of the named chain map `reductionComparisonChainMap`,
and `reductionComparisonQIsoOfRegular_hom` says so by `rfl`. -/
@[stacks 0GT9 "in Situation 0GT4: the canonical isomorphism in D(O_X)"]
public noncomputable def reductionComparisonQIsoOfRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    DerivedCategory.Q.obj (etaModIdealComplex X I ι F hF) ≅
      DerivedCategory.Q.obj (bocksteinChainComplex X I ι F hF) :=
  reductionComparisonQIso X I ι F hF
    (quasiIso_reductionComparisonChainMap_of_isLocallyGeneratedByRegular X I ι hregl F hF)

/-- The forward map of Tag 0GT9's isomorphism is the canonical arrow, by `rfl`.  This is what
makes it *the* canonical isomorphism rather than some isomorphism between the two objects. -/
@[simp] public theorem reductionComparisonQIsoOfRegular_hom
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)) :
    (reductionComparisonQIsoOfRegular X I ι hregl F hF).hom =
      reductionComparisonQ X I ι F hF := rfl

/-! ### The tag's own quantifier: an arbitrary object of `D(O_X)` -/

/-- **Every complex of `O_X`-modules has a termwise `I`-torsion-free representative on which
Tag 0GT9's canonical arrow is invertible**, in Situation 0GT4.

The statements above quantify over a complex `F` that is termwise `I`-torsion-free, whereas the
tag quantifies over an object `M` of `D(O_X)`.  The source's proof opens by replacing `M` by
such a representative, citing Lemma 20.55.6 (Tag 0F8Q); here that replacement is
`Eta.torsionFreeResolutions_of_isLocallyGeneratedByRegular`, which derives the existence of the
representative from Situation 0GT4's own hypothesis.  So `hF` in the statements above costs
nothing: `hregl` already supplies it. -/
public theorem exists_torsionFree_isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (G : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) :
    ∃ (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (p : F ⟶ G)
      (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)),
      QuasiIso p ∧ IsIso (reductionComparisonQ X I ι F hF) := by
  obtain ⟨F, p, hF, hq⟩ :=
    torsionFreeResolutions_of_isLocallyGeneratedByRegular X I ι hregl G
  exact ⟨F, p, hF, hq,
    isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular X I ι hregl F hF⟩

/-- **Stacks Project, Tag 0GT9, at the tag's own quantifier.**  In Situation 0GT4, for an
arbitrary object `M` of `D(O_X)` there is a complex `F` of `I`-torsion-free `O_X`-modules with
`Q F ≅ M` on which the canonical arrow

`η_I F ⊗ O_X/I ⟶ H^•(F/I)`

is invertible.  This is the tag read with its own "let `M` be an object of `D(O_X)`": the
representative is produced by the proof.  Its existence is
`Eta.torsionFreeResolutions_of_isLocallyGeneratedByRegular` composed with the essential
surjectivity of `DerivedCategory.Q`, and the invertibility is
`isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular`. -/
@[stacks 0GT9 "in Situation 0GT4, for an arbitrary object of D(O_X): a termwise \
I-torsion-free representative exists and the canonical arrow is invertible on it"]
public theorem exists_isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular
    (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.sheaf.obj (Oₓ).property I]
    (hregl : Stacks.IdealTorsion.IsLocallyGeneratedByRegular X ι)
    (M : DerivedCategory (SheafOfModules.{u} Oₓ)) :
    ∃ (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
      (hF : ∀ k : ℤ, IsIdealTorsionFree X ι (F.X k)),
      Nonempty (DerivedCategory.Q.obj F ≅ M) ∧ IsIso (reductionComparisonQ X I ι F hF) := by
  obtain ⟨F, p, hF, hq, hiso⟩ :=
    exists_torsionFree_isIso_reductionComparisonQ_of_isLocallyGeneratedByRegular X I ι hregl
      (DerivedCategory.Q.objPreimage M)
  exact ⟨F, hF,
    ⟨asIso (DerivedCategory.Q.map p) ≪≫ DerivedCategory.Q.objObjPreimageIso M⟩, hiso⟩

end Stacks.IdealTorsion.Reduction

end
