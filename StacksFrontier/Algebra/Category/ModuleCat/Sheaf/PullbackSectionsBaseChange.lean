@[expose] public section

open CategoryTheory Opposite PresheafOfModules

universe v w u v₁ u₁ u₂

namespace CategoryTheory.Adjunction

variable {C : Type*} [Category C] {D : Type*} [Category D] {F F' : C ⥤ D} {G : D ⥤ C}

/-- The canonical comparison of two left adjoints of one functor intertwines their adjoint
transposes: a morphism `θ : X ⟶ G.obj Y` has the same transpose through either adjunction,
once the two left adjoints are identified. Mathlib records the compatibility of
`Adjunction.leftAdjointUniq` with the units and the counits; this is the compatibility with
the hom-set bijections. -/
theorem leftAdjointUniq_hom_app_homEquiv_symm (adj1 : F ⊣ G) (adj2 : F' ⊣ G) {X : C} {Y : D}
    (θ : X ⟶ G.obj Y) :
    (leftAdjointUniq adj1 adj2).hom.app X ≫ (adj2.homEquiv X Y).symm θ =
      (adj1.homEquiv X Y).symm θ := by
  rw [homEquiv_counit, homEquiv_counit, ← Category.assoc,
    ← (leftAdjointUniq adj1 adj2).hom.naturality θ, Category.assoc,
    leftAdjointUniq_hom_app_counit]

end CategoryTheory.Adjunction

namespace Stacks.NoncommChangeOfRings

/-! ### The ring-theoretic input: base change along a surjection -/

section Surjective

variable {A : Type u₁} {B : Type u₂} [Ring A] [Ring B] {f : A →+* B}
  {M : Type v} [AddCommGroup M] [Module A M]

/-- If `f : A →+* B` is surjective then every pure tensor of `B ⊗_A M` is of the form
`1 ⊗ m`: the scalar can be absorbed into the second factor. -/
theorem objTmul_eq_of_surjective (hf : Function.Surjective f) (b : B) (m : M) :
    ∃ m' : M, tmul f b m = tmul f 1 m' := by
  obtain ⟨a, rfl⟩ := hf b
  exact ⟨a • m, by rw [← tmul_smul, one_mul]⟩

variable {N : Type w} [AddCommGroup N] [Module B N]

/-- **A map out of a base change along a surjection has the same image as the semilinear map
it descends.** Every value of `desc f ψ` is a value of `ψ`; the converse inclusion is
`desc_ι`. This is the whole content of the surjectivity transfer below. -/
theorem exists_apply_eq_desc_apply (hf : Function.Surjective f) (ψ : M →ₛₗ[f] N)
    (x : BaseChange f M) : ∃ m : M, desc f ψ x = ψ m := by
  refine induction_on f (motive := fun x => ∃ m : M, desc f ψ x = ψ m) x ⟨0, ?_⟩
    (fun b m => ?_) (fun x y ⟨m, hm⟩ ⟨m', hm'⟩ => ⟨m + m', ?_⟩)
  · rw [map_zero, map_zero]
  · obtain ⟨m', hm'⟩ := objTmul_eq_of_surjective hf b m
    exact ⟨m', by rw [hm', desc_tmul, one_smul]⟩
  · rw [map_add, hm, hm', map_add]

/-- If `f` is surjective and every value of `f` is a value of `g`, then `g` is surjective. -/
private theorem surjective_of_forall_exists_apply_eq {X Y Z : Type*} {f : X → Z} {g : Y → Z}
    (hf : Function.Surjective f) (h : ∀ x, ∃ y, f x = g y) : Function.Surjective g := fun z => by
  obtain ⟨x, rfl⟩ := hf z
  exact (h x).imp fun _ => Eq.symm

/-- A map out of a base change along a surjection is surjective exactly when the semilinear
map it descends is. -/
theorem surjective_desc_iff (hf : Function.Surjective f) (ψ : M →ₛₗ[f] N) :
    Function.Surjective (desc f ψ) ↔ Function.Surjective ψ := by
  refine ⟨fun h => surjective_of_forall_exists_apply_eq h (exists_apply_eq_desc_apply hf ψ),
    fun h n => ?_⟩
  obtain ⟨m, hm⟩ := h n
  exact ⟨ι f m, by rw [desc_ι, hm]⟩

end Surjective

namespace Presheaf

variable {C : Type u₁} [Category.{v₁} C] {R R' : Cᵒᵖ ⥤ RingCat.{u}} (α : R ⟶ R')

/-! ### The sections of the pullback -/

section Sections

variable (M : PresheafOfModules.{max u v} R)

/-- The canonical map from the base change of the sections of `M` over `V` to the sections
over `V` of Mathlib's `PresheafOfModules.pullback`, i.e.
`R'(V) ⊗_{R(V)} M(V) ⟶ (f^*M)(V)`. It is an isomorphism; see `pullbackObjIso`. -/
noncomputable def toPullbackObj (V : Cᵒᵖ) :
    (NoncommChangeOfRings.extendScalars (α.app V).hom).obj (M.obj V) ⟶
      ((PresheafOfModules.pullback.{max u v} (overId α)).obj M).obj V :=
  Hom.app ((extendScalarsIsoPullback.{v} α).hom.app M) V

/-- **The sections of `PresheafOfModules.pullback` over an object are a base change of the
sections.** For a morphism `α : R ⟶ R'` of presheaves of rings and a presheaf of `R`-modules
`M`, the sections of the pullback of `M` along the identity functor of `C` over an object `V`
are `R'(V) ⊗_{R(V)} M(V)`. No hypothesis on `α`, on `M` or on `C` is needed: Mathlib's
pullback is a left adjoint, and the objectwise base change is one too. -/
noncomputable def pullbackObjIso (V : Cᵒᵖ) :
    ((PresheafOfModules.pullback.{max u v} (overId α)).obj M).obj V ≅
      (NoncommChangeOfRings.extendScalars (α.app V).hom).obj (M.obj V) :=
  ((PresheafOfModules.evaluation.{max u v} R' V).mapIso
    ((extendScalarsIsoPullback.{v} α).app M)).symm

@[simp]
lemma pullbackObjIso_inv (V : Cᵒᵖ) :
    (pullbackObjIso.{v} α M V).inv = toPullbackObj.{v} α M V := rfl

instance isIso_toPullbackObj (V : Cᵒᵖ) : IsIso (toPullbackObj.{v} α M V) :=
  inferInstanceAs (IsIso (pullbackObjIso.{v} α M V).inv)

/-- Every section of the pullback over `V` comes from the base change of the sections. -/
theorem surjective_toPullbackObj (V : Cᵒᵖ) :
    Function.Surjective (toPullbackObj.{v} α M V) := fun t =>
  ⟨(pullbackObjIso.{v} α M V).hom t,
    ConcreteCategory.congr_hom (pullbackObjIso.{v} α M V).hom_inv_id t⟩

end Sections

/-! ### The adjoint transpose on sections -/

section Transpose

variable {M : PresheafOfModules.{max u v} R} {N : PresheafOfModules.{max u v} R'}
  (θ : M ⟶ (PresheafOfModules.restrictScalars.{max u v} α).obj N)

/-- The adjoint transpose of `θ : M ⟶ (restrictScalars α).obj N` through Mathlib's
pullback-pushforward adjunction: the comparison map `f^*M ⟶ N` out of the pullback. -/
noncomputable def pullbackTranspose :
    (PresheafOfModules.pullback.{max u v} (overId α)).obj M ⟶ N :=
  ((PresheafOfModules.pullbackPushforwardAdjunction.{max u v} (overId α)).homEquiv M N).symm θ

/-- The adjoint transpose through the objectwise adjunction is the objectwise adjoint
transpose. The hom-set bijection of an `Adjunction` is derived from its unit and counit, so
this is not the defining equation of `extendScalarsAdjunction` but a consequence of
`Adjunction.mkOfHomEquiv_homEquiv`. -/
lemma extendScalarsAdjunction_homEquiv_symm_app (V : Cᵒᵖ) :
    Hom.app (((extendScalarsAdjunction.{v} α).homEquiv M N).symm θ) V =
      transposeApp α θ V := by
  simp only [extendScalarsAdjunction, Adjunction.mkOfHomEquiv_homEquiv]
  rfl

/-- The comparison map out of Mathlib's pullback, precomposed with the identification of the
sections as a base change, is the objectwise adjoint transpose. -/
lemma toPullbackObj_comp_pullbackTranspose (V : Cᵒᵖ) :
    toPullbackObj.{v} α M V ≫ Hom.app (pullbackTranspose.{v} α θ) V =
      transposeApp α θ V := by
  have h := Adjunction.leftAdjointUniq_hom_app_homEquiv_symm (extendScalarsAdjunction.{v} α)
    (PresheafOfModules.pullbackPushforwardAdjunction.{max u v} (overId α)) θ
  have h2 := congrArg (fun g => Hom.app g V) h
  rw [PresheafOfModules.comp_app] at h2
  exact h2.trans (extendScalarsAdjunction_homEquiv_symm_app.{v} α θ V)

/-- **The adjoint transpose of `θ`, computed on the pure tensors of the sections**: the
comparison map `f^*M ⟶ N` carries the section `b ⊗ m` of the pullback to `b • θ(m)`. This is
the computation rule that Mathlib's abstract left adjoint does not supply. -/
lemma transpose_toPullbackObj_objTmul (V : Cᵒᵖ) (b : R'.obj V) (m : M.obj V) :
    Hom.app (pullbackTranspose.{v} α θ) V
        (toPullbackObj.{v} α M V (NoncommChangeOfRings.objTmul (α.app V).hom b m)) =
      b • NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V) m := by
  rw [← ModuleCat.comp_apply, toPullbackObj_comp_pullbackTranspose]
  exact NoncommChangeOfRings.homEquiv_symm_apply_objTmul _ _ _ _

/-- The comparison map out of the pullback, on the pure tensor `1 ⊗ m`, is `θ(m)`. -/
lemma transpose_toPullbackObj_objTmul_one (V : Cᵒᵖ) (m : M.obj V) :
    Hom.app (pullbackTranspose.{v} α θ) V
        (toPullbackObj.{v} α M V (NoncommChangeOfRings.objTmul (α.app V).hom 1 m)) =
      NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V) m := by
  rw [transpose_toPullbackObj_objTmul, one_smul]

/-! ### Surjectivity of the comparison map forces surjectivity of its transpose -/

/-- **The comparison map out of the pullback has the same image as the map it is the transpose
of**, over any object where `α` is surjective on sections. Every value of the comparison map
`f^*M ⟶ N` over `V` is already a value of `θ` over `V`.

Without the hypothesis on `α` the image of the comparison map is only the *submodule
generated* by the image of `θ`, which is what
`PresheafOfModules.range_homEquivSymm_app_eq_generatedSubmodule` says for an arbitrary functor
of sites. This is the collapse of that submodule to the image, which happens exactly when the
scalars of the target are already scalars of the source. -/
theorem exists_apply_eq_transpose_apply {V : Cᵒᵖ} (hα : Function.Surjective (α.app V).hom)
    (t : ((PresheafOfModules.pullback.{max u v} (overId α)).obj M).obj V) :
    ∃ m : M.obj V, Hom.app (pullbackTranspose.{v} α θ) V t =
      NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V) m := by
  obtain ⟨x, rfl⟩ := surjective_toPullbackObj.{v} α M V t
  obtain ⟨m, hm⟩ := NoncommChangeOfRings.exists_apply_eq_desc_apply hα
    (NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V)) x
  refine ⟨m, ?_⟩
  rw [← ModuleCat.comp_apply, toPullbackObj_comp_pullbackTranspose]
  exact hm

/-- **A surjective comparison map forces the map it is the transpose of to be surjective.**
If `α` is surjective on sections over `V` and the comparison map `f^*M ⟶ N` out of the
pullback is surjective on sections over `V`, then so is `θ` itself. This is the implication
"surjectivity of `c_f` gives surjectivity of the `f`-map" of [Stacks, Tag 07JN], for a change
of rings on a fixed site; the surjectivity of `α` is the surjectivity of
`𝒪_{T'}(W') ⟶ 𝒪_T(f^{-1}W')` that the source's closed immersion supplies over an affine. -/
theorem surjective_of_surjective_transpose {V : Cᵒᵖ}
    (hα : Function.Surjective (α.app V).hom)
    (hc : Function.Surjective (Hom.app (pullbackTranspose.{v} α θ) V)) :
    Function.Surjective (NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V)) := by
  exact surjective_of_forall_exists_apply_eq hc (exists_apply_eq_transpose_apply.{v} α θ hα)

/-- Conversely, a surjective `θ` has a surjective comparison map: the comparison map factors
`θ` through the unit `m ↦ 1 ⊗ m`. No hypothesis on `α` is needed here. -/
theorem surjective_transpose_of_surjective {V : Cᵒᵖ}
    (hθ : Function.Surjective (NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V))) :
    Function.Surjective (Hom.app (pullbackTranspose.{v} α θ) V) := by
  intro n
  obtain ⟨m, hm⟩ := hθ n
  exact ⟨toPullbackObj.{v} α M V (NoncommChangeOfRings.objTmul (α.app V).hom 1 m),
    by rw [transpose_toPullbackObj_objTmul_one, hm]⟩

/-! ### A comparison isomorphism exhibits the sections as a base change -/

/-- **A module with a comparison isomorphism has its sections a base change.** If the
comparison map `f^*M ⟶ N` out of the pullback is an isomorphism — the defining property of a
crystal, for instance — then the sections of `N` over an object `V` are
`R'(V) ⊗_{R(V)} M(V)`. -/
noncomputable def objIsoOfIsIso [IsIso (pullbackTranspose.{v} α θ)] (V : Cᵒᵖ) :
    (NoncommChangeOfRings.extendScalars (α.app V).hom).obj (M.obj V) ≅ N.obj V :=
  (asIso (toPullbackObj.{v} α M V)).trans
    ((PresheafOfModules.evaluation.{max u v} R' V).mapIso
      (asIso (pullbackTranspose.{v} α θ)))

/-- The identification of the sections of `N` as a base change carries the pure tensor
`b ⊗ m` to `b • θ(m)`. -/
lemma objIsoOfIsIso_hom_objTmul [IsIso (pullbackTranspose.{v} α θ)] (V : Cᵒᵖ)
    (b : R'.obj V) (m : M.obj V) :
    (objIsoOfIsIso.{v} α θ V).hom (NoncommChangeOfRings.objTmul (α.app V).hom b m) =
      b • NoncommChangeOfRings.ofRestrict (α.app V).hom (Hom.app θ V) m := by
  rw [← transpose_toPullbackObj_objTmul]
  rfl

end Transpose

/-! ### The local statement -/

section Site

variable {J : GrothendieckTopology C} {M : PresheafOfModules.{max u v} R}
  {N : PresheafOfModules.{max u v} R'}
  (θ : M ⟶ (PresheafOfModules.restrictScalars.{max u v} α).obj N)

/-- **A locally surjective comparison map forces the map it is the transpose of to be locally
surjective.** For a Grothendieck topology `J` on `C`, if `α` is surjective on sections over
every object and the comparison map `f^*M ⟶ N` out of the pullback is locally surjective,
then `θ` is locally surjective. Since sheafification preserves local surjectivity, this is
the form in which the statement applies to a comparison map of *sheaves* of modules, where
the sections of the pullback are only the sheafification of a base change. -/
theorem isLocallySurjective_of_isLocallySurjective_transpose
    (hα : ∀ V : Cᵒᵖ, Function.Surjective (α.app V).hom)
    [Presheaf.IsLocallySurjective J
      ((PresheafOfModules.toPresheaf R').map (pullbackTranspose.{v} α θ))] :
    Presheaf.IsLocallySurjective J ((PresheafOfModules.toPresheaf R).map θ) where
  imageSieve_mem {U} s := by
    refine J.superset_covering ?_
      (Presheaf.imageSieve_mem J
        ((PresheafOfModules.toPresheaf R').map (pullbackTranspose.{v} α θ)) (U := op U) s)
    rintro V i ⟨t, ht⟩
    obtain ⟨m, hm⟩ := exists_apply_eq_transpose_apply.{v} α θ (hα (op V)) t
    exact ⟨m, hm.symm.trans ht⟩

end Site

end Presheaf

end Stacks.NoncommChangeOfRings
