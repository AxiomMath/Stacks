module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FreeDifferentialGradedAlgebra

/-!
# Triangular derivation data on the free graded algebra

Let `(C, O)` be a ringed site and let `𝒮 : I → SheafOfGradedSets J` be a family of sheaves of
graded sets indexed by an ordered set `I`, the *levels*. The source's tower

`A₀ = O⟨S₀⟩ ⟶ A₁ = O⟨S₀ ⨿ S₁⟩ ⟶ ⋯`, `A = colim Aᵢ = O⟨⨿ᵢ Sᵢ⟩`,

has a differential prescribed on the generators by maps `δᵢ₊₁ : Sᵢ₊₁ ⟶ Aᵢ`: the differential of a
generator of level `i + 1` is a local section of the subalgebra generated by the letters of level
at most `i`, that is of level *strictly below* `i + 1`, and the generators of level `0` are
closed. This file names that condition for a single derivation datum on `O⟨⨿ᵢ Sᵢ⟩`.

## Main definitions

* `Stacks.SheafOfGradedSets.WordBelow k w`: every letter of the word `w` has level `< k`.
* `SheafOfModules.IsPresBelow 𝒮 k a`: every word in the support of the presentation element `a`
  has all its letters of level `< k`.
* `SheafOfModules.IsLocallyBelow 𝒮 k z`: the local section `z` of `O⟨S⟩` is, locally on the site,
  the image of a presentation element all of whose words have their letters of level `< k`. This
  is the statement that `z` is a local section of `O⟨⨿_{j < k} S_j⟩` inside `O⟨⨿ⱼ Sⱼ⟩`.
* `SheafOfModules.DerivationDatum.IsTriangular δ`: the prescribed value `δ(x)` on every letter
  `x` of level `k` is locally below `k`. This is the source's condition that `δₖ` lands in
  `A_{k-1}`.

## Main results

* `SheafOfModules.isLocallyBelow_algToSheaf`: the image of a presentation element below `k` is
  locally below `k`.
* `SheafOfModules.IsLocallyBelow.zero`, `.add`, `.smul`, `.zsmul`, `.restrict`: the sections
  locally below `k` form a sub-presheaf of modules.

## Implementation notes

The source's level-`0` generators are closed. Here a letter of the least level `k` has `δ(x)`
locally below `k`, i.e. locally a multiple of the empty word; when it is zero this is the
source's situation, so the condition here is the source's one or more general.

## References

* [Stacks Project, Tag 0FU1](https://stacks.math.columbia.edu/tag/0FU1)
* [Stacks Project, Tag 0FU2](https://stacks.math.columbia.edu/tag/0FU2)
-/
@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite

universe t v u

namespace Stacks.SheafOfGradedSets

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [HasWeakSheafify J (Type t)] {I : Type t} {𝒮 : I → SheafOfGradedSets.{t} J}

/-- Every letter of the word `w` has level strictly below `k`. -/
def WordBelow [LT I] (k : I) {U : Cᵒᵖ} (w : Word 𝒮 U) : Prop := ∀ x ∈ w, x.1 < k

/-- The empty word is below every level. -/
@[simp] theorem wordBelow_nil [LT I] (k : I) {U : Cᵒᵖ} : WordBelow k ([] : Word 𝒮 U) :=
  fun _ h => absurd h List.not_mem_nil

/-- The word `x :: w` is below `k` if and only if `x` has level `< k` and `w` is below `k`. -/
theorem wordBelow_cons [LT I] (k : I) {U : Cᵒᵖ} (x : Letter 𝒮 U) (w : Word 𝒮 U) :
    WordBelow k (x :: w : Word 𝒮 U) ↔ x.1 < k ∧ WordBelow k w := by
  simp [WordBelow]

/-- A concatenation `w ++ w'` is below `k` if and only if both `w` and `w'` are below `k`. -/
theorem wordBelow_append [LT I] (k : I) {U : Cᵒᵖ} (w w' : Word 𝒮 U) :
    WordBelow k (w ++ w' : Word 𝒮 U) ↔ WordBelow k w ∧ WordBelow k w' := by
  simp only [WordBelow, List.mem_append]
  exact ⟨fun h => ⟨fun x hx => h x (Or.inl hx), fun x hx => h x (Or.inr hx)⟩,
    fun h x hx => hx.elim (h.1 x) (h.2 x)⟩

/-- Restricting a word along `f` does not change whether it is below `k`. -/
@[simp] theorem wordBelow_wordMap [LT I] (k : I) {U V : Cᵒᵖ} (f : U ⟶ V) (w : Word 𝒮 U) :
    WordBelow k (wordMap f w) ↔ WordBelow k w := by
  simp only [WordBelow, wordMap, List.mem_map, forall_exists_index, and_imp,
    forall_apply_eq_imp_iff₂]

end Stacks.SheafOfGradedSets

namespace SheafOfModules

open Stacks Stacks.SheafOfGradedSets

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{t} RingCat.{t})]
  {Osharp : Sheaf J CommRingCat.{t}}
  [HasWeakSheafify J (Type t)] [HasWeakSheafify J AddCommGrpCat.{t}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{t}]
  {I : Type t} [LT I] (𝒮 : I → SheafOfGradedSets.{t} J)

/-- A presentation element of degree `n` is *below `k`* when every word in its support has all
its letters of level strictly below `k`. -/
def IsPresBelow (k : I) {n : ℤ} {U : Cᵒᵖ} (a : algSections Osharp 𝒮 n U) : Prop :=
  ∀ w ∈ a.support, WordBelow k w.1

variable {𝒮}

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- A presentation element is below `k` if and only if it is supported on the words below `k`. -/
theorem isPresBelow_iff_mem_supported (k : I) {n : ℤ} {U : Cᵒᵖ} (a : algSections Osharp 𝒮 n U) :
    IsPresBelow 𝒮 k a ↔
      a ∈ Finsupp.supported (secRing Osharp U) (secRing Osharp U)
        {w : WordIdx 𝒮 n U | WordBelow k w.1} := by
  rw [Finsupp.mem_supported]
  exact ⟨fun h w hw => h w hw, fun h w hw => h hw⟩

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- The zero presentation element is below every level. -/
theorem IsPresBelow.zero (k : I) {n : ℤ} {U : Cᵒᵖ} :
    IsPresBelow 𝒮 k (0 : algSections Osharp 𝒮 n U) := by
  intro w hw
  simp at hw

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- A sum of presentation elements below `k` is below `k`. -/
theorem IsPresBelow.add {k : I} {n : ℤ} {U : Cᵒᵖ} {a b : algSections Osharp 𝒮 n U}
    (ha : IsPresBelow 𝒮 k a) (hb : IsPresBelow 𝒮 k b) : IsPresBelow 𝒮 k (a + b) := by
  rw [isPresBelow_iff_mem_supported] at ha hb ⊢
  exact Submodule.add_mem _ ha hb

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- A scalar multiple of a presentation element below `k` is below `k`. -/
theorem IsPresBelow.smul {k : I} {n : ℤ} {U : Cᵒᵖ} (r : secRing Osharp U)
    {a : algSections Osharp 𝒮 n U} (ha : IsPresBelow 𝒮 k a) : IsPresBelow 𝒮 k (r • a) := by
  rw [isPresBelow_iff_mem_supported] at ha ⊢
  exact Submodule.smul_mem _ r ha

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- The presentation element `r • w` on a single word `w` below `k` is below `k`. -/
theorem isPresBelow_algOf {k : I} {n : ℤ} {U : Cᵒᵖ} (w : WordIdx 𝒮 n U)
    (hw : WordBelow k w.1) (r : secRing Osharp U) :
    IsPresBelow 𝒮 k (algOf (Osharp := Osharp) 𝒮 n w r) := by
  classical
  intro w' hw'
  rw [algOf, Finsupp.mem_support_iff, Finsupp.single_apply] at hw'
  by_cases h : w = w'
  · exact h ▸ hw
  · exact absurd (ite_eq_right h) hw'

omit [HasWeakSheafify J AddCommGrpCat.{t}] [J.WEqualsLocallyBijective AddCommGrpCat.{t}] in
/-- The restriction along `f` of a presentation element below `k` is below `k`. -/
theorem IsPresBelow.algRestrict {k : I} {n : ℤ} {U V : Cᵒᵖ} (f : U ⟶ V)
    {a : algSections Osharp 𝒮 n U} (ha : IsPresBelow 𝒮 k a) :
    IsPresBelow 𝒮 k (SheafOfModules.algRestrict 𝒮 n f a) := by
  classical
  have key : ∀ b : algSections Osharp 𝒮 n U, IsPresBelow 𝒮 k b →
      IsPresBelow 𝒮 k (SheafOfModules.algRestrict 𝒮 n f b) := by
    intro b
    induction b using Finsupp.induction with
    | zero => intro _; rw [map_zero]; exact IsPresBelow.zero k
    | single_add w r b hw hr ih =>
      intro hb
      have hw' : WordBelow k w.1 := hb w (by
        rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_eq_same,
          Finsupp.notMem_support_iff.mp hw, add_zero]
        exact hr)
      have hb' : IsPresBelow 𝒮 k b := by
        intro w' hw''
        refine hb w' ?_
        rw [Finsupp.mem_support_iff, Finsupp.add_apply, Finsupp.single_apply]
        have hne : w ≠ w' := fun h => hw (h ▸ hw'')
        rw [ite_eq_right hne, zero_add]
        exact Finsupp.mem_support_iff.mp hw''
      rw [map_add]
      refine IsPresBelow.add ?_ (ih hb')
      show IsPresBelow 𝒮 k (SheafOfModules.algRestrict 𝒮 n f (algOf 𝒮 n w r))
      rw [algRestrict_algOf]
      exact isPresBelow_algOf _ ((wordBelow_wordMap k f w.1).2 hw') _
  exact key a ha

variable (𝒮) in
/-- A local section `z` of the degree-`n` piece of `O⟨S⟩` is *locally below `k`* when, locally
on the site, it is the image of a presentation element all of whose words have their letters of
level strictly below `k`: `z` is a local section of `O⟨⨿_{j < k} S_j⟩` inside `O⟨⨿ⱼ Sⱼ⟩`. -/
def IsLocallyBelow (k : I) {n : ℤ} {U : Cᵒᵖ}
    (z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U) : Prop :=
  ∃ S : Sieve U.unop, S ∈ J U.unop ∧ ∀ ⦃V : C⦄ (f : V ⟶ U.unop), S f →
    ∃ a : algSections Osharp 𝒮 n (op V), IsPresBelow 𝒮 k a ∧
      (algToSheaf 𝒮 n).app (op V) a = Stacks.sectionRestrict (algPiece 𝒮 n).val f.op z

/-- **The image of a presentation element below `k` is locally below `k`.** -/
theorem isLocallyBelow_algToSheaf {k : I} {n : ℤ} {U : Cᵒᵖ} {a : algSections Osharp 𝒮 n U}
    (ha : IsPresBelow 𝒮 k a) : IsLocallyBelow 𝒮 k ((algToSheaf 𝒮 n).app U a) := by
  refine ⟨⊤, J.top_mem _, fun V f _ => ⟨SheafOfModules.algRestrict 𝒮 n f.op a,
    ha.algRestrict f.op, ?_⟩⟩
  exact (algToSheaf_naturality 𝒮 n f.op a).symm

/-- A local section which is the image of a presentation element below `k` is locally below
`k`. -/
theorem isLocallyBelow_of_eq_algToSheaf {k : I} {n : ℤ} {U : Cᵒᵖ}
    {z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U} {a : algSections Osharp 𝒮 n U}
    (ha : IsPresBelow 𝒮 k a) (hz : (algToSheaf 𝒮 n).app U a = z) : IsLocallyBelow 𝒮 k z :=
  hz ▸ isLocallyBelow_algToSheaf ha

namespace IsLocallyBelow

/-- The zero section is locally below every level. -/
theorem zero (k : I) {n : ℤ} {U : Cᵒᵖ} :
    IsLocallyBelow 𝒮 k (0 : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U) :=
  isLocallyBelow_of_eq_algToSheaf (IsPresBelow.zero k) (map_zero _)

/-- A sum of sections locally below `k` is locally below `k`. -/
theorem add {k : I} {n : ℤ} {U : Cᵒᵖ} {z z' : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U}
    (hz : IsLocallyBelow 𝒮 k z) (hz' : IsLocallyBelow 𝒮 k z') :
    IsLocallyBelow 𝒮 k (z + z') := by
  obtain ⟨S, hS, h⟩ := hz
  obtain ⟨S', hS', h'⟩ := hz'
  refine ⟨S ⊓ S', J.intersection_covering hS hS', fun V f hf => ?_⟩
  obtain ⟨a, ha, hfa⟩ := h f hf.1
  obtain ⟨a', ha', hfa'⟩ := h' f hf.2
  refine ⟨a + a', ha.add ha', ?_⟩
  refine (map_add (algToSheafAdd 𝒮 n (op V)) a a').trans ?_
  rw [algToSheafAdd_apply, algToSheafAdd_apply, hfa, hfa']
  exact (map_add _ z z').symm

/-- A multiple of a section locally below `k` by a section of `O` is locally below `k`. -/
theorem smul {k : I} {n : ℤ} {U : Cᵒᵖ} (r : secRing Osharp U)
    {z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U} (hz : IsLocallyBelow 𝒮 k z) :
    IsLocallyBelow 𝒮 k (r • z) := by
  obtain ⟨S, hS, h⟩ := hz
  refine ⟨S, hS, fun V f hf => ?_⟩
  obtain ⟨a, ha, hfa⟩ := h f hf
  refine ⟨(toRingCat J Osharp).obj.map f.op r • a, ha.smul _, ?_⟩
  refine (((algToSheaf 𝒮 n).app (op V)).hom.map_smul _ a).trans ?_
  refine (congrArg (fun y => (toRingCat J Osharp).obj.map f.op r • y) hfa).trans ?_
  exact (Stacks.sectionRestrict_smul (algPiece (Osharp := Osharp) 𝒮 n).val f.op r z).symm

/-- An integer multiple of a section locally below `k` is locally below `k`. -/
theorem zsmul {k : I} {n : ℤ} {U : Cᵒᵖ} (m : ℤ)
    {z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U} (hz : IsLocallyBelow 𝒮 k z) :
    IsLocallyBelow 𝒮 k (m • z) := by
  rw [← Int.cast_smul_eq_zsmul (secRing Osharp U)]
  exact hz.smul _

/-- The negative of a section locally below `k` is locally below `k`. -/
theorem neg {k : I} {n : ℤ} {U : Cᵒᵖ}
    {z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U} (hz : IsLocallyBelow 𝒮 k z) :
    IsLocallyBelow 𝒮 k (-z) := by
  simpa using hz.zsmul (-1)

/-- The restriction along `g` of a section locally below `k` is locally below `k`. -/
theorem restrict {k : I} {n : ℤ} {U W : Cᵒᵖ} (g : U ⟶ W)
    {z : (algPiece (Osharp := Osharp) 𝒮 n).val.obj U} (hz : IsLocallyBelow 𝒮 k z) :
    IsLocallyBelow 𝒮 k (Stacks.sectionRestrict (algPiece 𝒮 n).val g z) := by
  obtain ⟨S, hS, h⟩ := hz
  refine ⟨S.pullback g.unop, J.pullback_stable g.unop hS, fun V f hf => ?_⟩
  obtain ⟨a, ha, hfa⟩ := h (f ≫ g.unop) hf
  exact ⟨a, ha, hfa.trans (Stacks.sectionRestrict_comp _ g f.op z)⟩

end IsLocallyBelow

variable (𝒮) in
/-- A derivation datum is **triangular** when the prescribed value `δ(x)` on every letter `x`
is locally below the level of `x`: the differential of a generator of level `k` is a local
section of the subalgebra generated by the letters of level strictly below `k`. This is the
source's condition that `δₖ : Sₖ ⟶ A_{k-1} = O⟨S₀ ⨿ ⋯ ⨿ S_{k-1}⟩`. -/
def DerivationDatum.IsTriangular (δ : DerivationDatum (Osharp := Osharp) 𝒮) : Prop :=
  ∀ (U : Cᵒᵖ) (x : Letter 𝒮 U), IsLocallyBelow 𝒮 x.1 (δ.app U x)

end SheafOfModules

end
