@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry

universe u v

namespace Stacks.RegularSequence

variable (X : RingedSpace.{u}) {r : ℕ} (f : Fin r → X.presheaf.obj (op (⊤ : Opens X)))

/-- The germs at `x` of a finite family of global sections of the structure sheaf. -/
noncomputable def germSequence (x : X) : Fin r → X.presheaf.stalk x :=
  fun i ↦ X.presheaf.germ (⊤ : Opens X) x trivial (f i)

/-- The ideal in the stalk at `x` generated by the germs of the global sections strictly
preceding `f i`. -/
noncomputable def precedingGermIdeal (i : Fin r) (x : X) : Ideal (X.presheaf.stalk x) :=
  Ideal.span (Set.range fun j : Fin i.val ↦
    germSequence X f x ⟨j.val, j.isLt.trans i.isLt⟩)

/-- The germ at `x` of the restriction of `f i` to an open neighbourhood of `x` is the germ of
`f i`. -/
@[simp]
theorem germ_res_top_eq_germSequence (i : Fin r) {x : X} {U : Opens X} (hx : x ∈ U) :
    X.presheaf.germ U x hx (X.presheaf.map (homOfLE le_top).op (f i)) = germSequence X f x i :=
  X.presheaf.germ_res_apply (homOfLE le_top) x hx (f i)

section Quotient

variable (Q : TopCat.Sheaf CommRingCat.{u} X)
  (q : ∀ U : Opens X, X.presheaf.obj (op U) →+* Q.presheaf.obj (op U))
  (hq : ∀ (U V : Opens X) (hVU : V ≤ U) (s : X.presheaf.obj (op U)),
    Q.presheaf.map (homOfLE hVU).op (q U s) = q V (X.presheaf.map (homOfLE hVU).op s))

/-- A family of ring maps on sections commuting with the restrictions `homOfLE h`, assembled
into a morphism of presheaves of commutative rings. Every morphism of `(Opens X)ᵒᵖ` is such a
restriction, so no further naturality is needed. -/
def quotientPresheafHom : X.presheaf ⟶ Q.presheaf where
  app U := CommRingCat.ofHom (q U.unop)
  naturality U V g := by
    ext s
    have h : V.unop ≤ U.unop := leOfHom g.unop
    have hg : g = (homOfLE h).op :=
      Quiver.Hom.unop_inj (homOfLE_leOfHom g.unop).symm
    subst hg
    exact (hq U.unop V.unop h s).symm

/-- On sections over `U`, `quotientPresheafHom` is the given map `q U`. -/
@[simp]
theorem quotientPresheafHom_app (U : Opens X) (s : X.presheaf.obj (op U)) :
    (quotientPresheafHom X Q q hq).app (op U) s = q U s :=
  rfl

/-- The ring homomorphism on stalks at `x` induced by a sectionwise quotient map. -/
noncomputable def stalkQuotientHom (x : X) :
    X.presheaf.stalk x →+* Q.presheaf.stalk x :=
  ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map
    (quotientPresheafHom X Q q hq)).hom

/-- `stalkQuotientHom` sends the germ of a section `s` to the germ of `q U s`. -/
@[simp]
theorem stalkQuotientHom_germ {x : X} (U : Opens X) (hx : x ∈ U)
    (s : X.presheaf.obj (op U)) :
    stalkQuotientHom X Q q hq x (X.presheaf.germ U x hx s) =
      Q.presheaf.germ U x hx (q U s) :=
  TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx _ s

/-- `stalkQuotientHom` sends the germ of `f i` to the germ of the global section `q ⊤ (f i)`. -/
theorem stalkQuotientHom_germSequence (i : Fin r) (x : X) :
    stalkQuotientHom X Q q hq x (germSequence X f x i) =
      Q.presheaf.germ (⊤ : Opens X) x trivial (q ⊤ (f i)) :=
  stalkQuotientHom_germ X Q q hq (⊤ : Opens X) trivial (f i)

/-- Under the identification of `exists_stalkRingEquiv_quotient`, an endomorphism of the sheaf
quotient induced by multiplication by `f i` becomes multiplication by the class of the germ of
`f i`. Only the sectionwise formula for the endomorphism is used: it is not assumed additive,
natural, or a morphism of sheaves. -/
theorem germ_mul_eq_germSequence_mul (i : Fin r) {x : X}
    (m : ∀ U : Opens X, Q.presheaf.obj (op U) → Q.presheaf.obj (op U))
    (hm : ∀ (U : Opens X) (s : X.presheaf.obj (op U)),
      m U (q U s) = q U (X.presheaf.map (homOfLE le_top).op (f i) * s))
    (e : Q.presheaf.stalk x ≃+* (X.presheaf.stalk x ⧸ precedingGermIdeal X f i x))
    (he : ∀ (U : Opens X) (hx : x ∈ U) (s : X.presheaf.obj (op U)),
      e (Q.presheaf.germ U x hx (q U s)) =
        Ideal.Quotient.mk (precedingGermIdeal X f i x) (X.presheaf.germ U x hx s))
    (U : Opens X) (hx : x ∈ U) (s : X.presheaf.obj (op U)) :
    e (Q.presheaf.germ U x hx (m U (q U s))) =
      Ideal.Quotient.mk (precedingGermIdeal X f i x) (germSequence X f x i) *
        e (Q.presheaf.germ U x hx (q U s)) := by
  rw [hm, he, he, ← map_mul, map_mul, germ_res_top_eq_germSequence]

variable (i : Fin r)
  (hsurj : ∀ (U : Opens X) (s : Q.presheaf.obj (op U)) (y : X), y ∈ U →
    ∃ (V : Opens X) (_ : y ∈ V) (hVU : V ≤ U) (t : X.presheaf.obj (op V)),
      q V t = Q.presheaf.map (homOfLE hVU).op s)
  (hker : ∀ (U : Opens X) (s : X.presheaf.obj (op U)),
    q U s = 0 ↔ IsLocallyInPrecedingIdeal X f i U s)

include hsurj in
/-- If the sectionwise map is locally surjective, the induced map on stalks is surjective. -/
theorem stalkQuotientHom_surjective (x : X) :
    Function.Surjective (stalkQuotientHom X Q q hq x) := by
  intro t
  obtain ⟨U, hxU, s, rfl⟩ := Q.presheaf.exists_germ_eq t
  obtain ⟨V, hxV, hVU, u, hu⟩ := hsurj U s x hxU
  exact ⟨X.presheaf.germ V x hxV u, by
    rw [stalkQuotientHom_germ, hu, Q.presheaf.germ_res_apply]⟩

include hker in
/-- If the kernel of each sectionwise map consists of the sections locally in the ideal generated
by the sections preceding `f i`, then the kernel of the induced map on stalks at `x` is
`precedingGermIdeal X f i x`. -/
theorem ker_stalkQuotientHom (x : X) :
    RingHom.ker (stalkQuotientHom X Q q hq x) = precedingGermIdeal X f i x := by
  apply le_antisymm
  · intro a ha
    obtain ⟨U, hxU, s, rfl⟩ := X.presheaf.exists_germ_eq a
    rw [RingHom.mem_ker, stalkQuotientHom_germ] at ha
    obtain ⟨W, hxW, iWU, iWU', hW⟩ :=
      Q.presheaf.germ_eq x hxU hxU (q U s) 0 (by simpa using ha)
    have hzero : q W (X.presheaf.map iWU.op s) = 0 := by
      have hle : W ≤ U := leOfHom iWU
      have hiWU : iWU = homOfLE hle := (homOfLE_leOfHom iWU).symm
      rw [hiWU] at hW ⊢
      rw [← hq U W hle, hW, map_zero]
    obtain ⟨V, hxV, hVW, a, hav⟩ := (hker W _).mp hzero x hxW
    have hgerm : X.presheaf.germ U x hxU s =
        ∑ j : Fin i.val, X.presheaf.germ V x hxV (a j) *
          germSequence X f x ⟨j.val, j.isLt.trans i.isLt⟩ := by
      have := congrArg (X.presheaf.germ V x hxV) hav
      rw [X.presheaf.germ_res_apply, X.presheaf.germ_res_apply] at this
      simpa only [map_sum, map_mul, germ_res_top_eq_germSequence] using this
    rw [hgerm, precedingGermIdeal, ← Ideal.submodule_span_eq]
    exact Submodule.sum_mem _ fun j _ ↦
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · intro a ha
    rw [precedingGermIdeal, ← Ideal.submodule_span_eq,
      Submodule.mem_span_range_iff_exists_fun] at ha
    obtain ⟨c, rfl⟩ := ha
    have hgen : ∀ j : Fin i.val,
        stalkQuotientHom X Q q hq x (germSequence X f x ⟨j.val, j.isLt.trans i.isLt⟩) = 0 := by
      intro j
      rw [stalkQuotientHom_germSequence, (hker ⊤ _).mpr
        (isLocallyInPrecedingIdeal_self X f i j), map_zero]
    rw [RingHom.mem_ker, map_sum]
    exact Finset.sum_eq_zero fun j _ ↦ by
      rw [smul_eq_mul, map_mul, hgen j, mul_zero]

include hq hsurj hker in
/-- The stalk at `x` of a sheaf quotient of `O_X` by the ideal sheaf generated by the global
sections strictly preceding `f i` is the quotient of the stalk `O_{X,x}` by the ideal generated
by the germs of those sections. The displayed equation specifies the isomorphism on germs of
local sections, so this identifies *the canonical map* rather than merely asserting that the
two rings are isomorphic. -/
theorem exists_stalkRingEquiv_quotient (x : X) :
    ∃ e : Q.presheaf.stalk x ≃+* (X.presheaf.stalk x ⧸ precedingGermIdeal X f i x),
      ∀ (U : Opens X) (hx : x ∈ U) (s : X.presheaf.obj (op U)),
        e (Q.presheaf.germ U x hx (q U s)) =
          Ideal.Quotient.mk (precedingGermIdeal X f i x) (X.presheaf.germ U x hx s) := by
  refine ⟨(RingHom.quotientKerEquivOfSurjective
    (stalkQuotientHom_surjective X Q q hq hsurj x)).symm.trans
    (Ideal.quotEquivOfEq (ker_stalkQuotientHom X f Q q hq i hker x)), fun U hx s ↦ ?_⟩
  rw [RingEquiv.trans_apply, ← stalkQuotientHom_germ X Q q hq U hx s,
    RingHom.quotientKerEquivOfSurjective_symm_apply, Ideal.quotEquivOfEq_mk]

end Quotient

section QuasiRegular

/-- The ring-level quasi-regularity map with its source written literally as the polynomial
algebra `(R/J)[T₁, …, T_r]`. The canonical class of `1` identifies this with the
tensor-product source used by `quasiRegularCanonicalMap`. -/
noncomputable def polynomialQuasiRegularCanonicalMap {R : Type*} [CommRing R] {c : ℕ}
    (g : Fin c → R) :
    MvPolynomial (Fin c) (qrRbar g) →ₗ[qrRbar g] Target R g :=
  (quasiRegularCanonicalMap (M := R) g).comp
    ((TensorProduct.mk (qrRbar g) _ _).flip
      ((Submodule.quotEquivOfEq (Jid g : Submodule R R)
        (Jid g • (⊤ : Submodule R R)) (by simp) : qrRbar g →ₗ[R] qrMbar R g) 1))

/-- Quasi-regularity is local. A morphism of sheaves of commutative rings whose stalk maps are,
under given identifications of the stalks, the ring-level quasi-regularity maps of the germ
sequences is an isomorphism exactly when each of those ring-level maps is bijective. -/
theorem isIso_iff_bijective_polynomialQuasiRegularCanonicalMap
    (P A : TopCat.Sheaf CommRingCat.{u} X) (φ : P ⟶ A)
    (pIso : ∀ x : X, P.presheaf.stalk x ≅
      CommRingCat.of (MvPolynomial (Fin r) (qrRbar (germSequence X f x))))
    (aIso : ∀ x : X, AddCommGrpCat.of (A.presheaf.stalk x) ≅
      AddCommGrpCat.of (Target (X.presheaf.stalk x) (germSequence X f x)))
    (hstalk : ∀ (x : X) (p : P.presheaf.stalk x),
      (aIso x).hom ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map φ.hom p) =
        polynomialQuasiRegularCanonicalMap (germSequence X f x) ((pIso x).hom p)) :
    IsIso φ ↔ ∀ x : X,
      Function.Bijective (polynomialQuasiRegularCanonicalMap (germSequence X f x)) := by
  rw [TopCat.Presheaf.isIso_iff_stalkFunctor_map_iso]
  refine forall_congr' fun x ↦ ?_
  have hfactor : ((polynomialQuasiRegularCanonicalMap (germSequence X f x) : _ → _) ∘
      (pIso x).hom) = (aIso x).hom ∘
        ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map φ.hom) :=
    funext fun p ↦ (hstalk x p).symm
  have hp : Function.Bijective ((pIso x).hom) :=
    ConcreteCategory.bijective_of_isIso _
  have ha : Function.Bijective ((aIso x).hom) :=
    ConcreteCategory.bijective_of_isIso _
  rw [ConcreteCategory.isIso_iff_bijective]
  exact ⟨fun h ↦ (Function.Bijective.of_comp_iff _ hp).mp (hfactor ▸ ha.comp h),
    fun h ↦ (Function.Bijective.of_comp_iff' ha _).mp (hfactor ▸ h.comp hp)⟩

end QuasiRegular

/-! ### The Koszul complex of a sequence and change of base ring

Everything in this section is commutative algebra: it describes how the degree-`n` part of the
Koszul complex of a finite sequence in `R` behaves under a ring homomorphism `R →+* S`. -/

section BaseChange

open scoped ExteriorAlgebra

universe u₁ u₂ u₃

variable {A : Type u₁} [CommRing A] {B : Type u₂} [CommRing B] {r : ℕ}

/-- The canonical basis of the `n`-th exterior power of `Aʳ`, indexed by the `n`-element subsets
of `Fin r`; its value at `s` is the wedge of the standard basis vectors indexed by `s`, taken in
increasing order. The index type does not depend on `A`, which is what makes it possible to
compare exterior powers over different rings. -/
noncomputable abbrev wedgeBasis (A : Type u₁) [CommRing A] (r n : ℕ) :
    Module.Basis ↑(Set.powersetCard (Fin r) n) A (⋀[A]^n (Fin r → A)) :=
  Module.Basis.exteriorPower n (Pi.basisFun A (Fin r))

/-- The basis vector of `wedgeBasis A r n` indexed by `t` is the wedge of the standard basis
vectors indexed by the elements of `t` in increasing order. -/
theorem wedgeBasis_apply (A : Type u₁) [CommRing A] (r n : ℕ)
    (t : ↑(Set.powersetCard (Fin r) n)) :
    wedgeBasis A r n t = exteriorPower.ιMulti A n
      (fun j => Pi.single ((Set.powersetCard.ofFinEmbEquiv.symm t) j) (1 : A)) := by
  rw [exteriorPower.basis_apply]
  simp only [exteriorPower.ιMulti_family, Function.comp_def, Pi.basisFun_apply]

/-- Change of base ring on the `n`-th exterior power of a free module of rank `r`, defined in the
canonical basis: the coefficients are transported by `ρ`. It is additive and `ρ`-semilinear, and
`extBase_ιMulti` identifies it as the map sending a wedge of vectors to the wedge of their
images. -/
noncomputable def extBase (ρ : A →+* B) (r n : ℕ) :
    (⋀[A]^n (Fin r → A)) →+ (⋀[B]^n (Fin r → B)) where
  toFun y := ∑ t : ↑(Set.powersetCard (Fin r) n),
    ρ ((wedgeBasis A r n).repr y t) • (wedgeBasis B r n) t
  map_zero' := by simp
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]

/-- `extBase ρ r n y` is the combination of basis wedges over `B` whose coefficients are the
images under `ρ` of the coefficients of `y`. -/
theorem extBase_apply (ρ : A →+* B) (n : ℕ) (y : ⋀[A]^n (Fin r → A)) :
    extBase ρ r n y = ∑ t : ↑(Set.powersetCard (Fin r) n),
      ρ ((wedgeBasis A r n).repr y t) • (wedgeBasis B r n) t := rfl

/-- The coefficients of `extBase ρ r n y` in the canonical basis are the images under `ρ` of
those of `y`. -/
@[simp]
theorem extBase_repr (ρ : A →+* B) (n : ℕ) (y : ⋀[A]^n (Fin r → A))
    (t : ↑(Set.powersetCard (Fin r) n)) :
    (wedgeBasis B r n).repr (extBase ρ r n y) t = ρ ((wedgeBasis A r n).repr y t) := by
  rw [extBase_apply, Module.Basis.repr_sum_self]

/-- Change of base ring is `ρ`-semilinear. -/
theorem extBase_smul (ρ : A →+* B) (n : ℕ) (c : A) (y : ⋀[A]^n (Fin r → A)) :
    extBase ρ r n (c • y) = ρ c • extBase ρ r n y := by
  refine (wedgeBasis B r n).repr.injective (Finsupp.ext fun t => ?_)
  simp [extBase_repr]

/-- Change of base ring takes an `A`-combination of basis wedges to the corresponding
`B`-combination. -/
theorem extBase_sum_smul (ρ : A →+* B) (n : ℕ)
    (c : ↑(Set.powersetCard (Fin r) n) → A) :
    extBase ρ r n (∑ t, c t • wedgeBasis A r n t) =
      ∑ t, ρ (c t) • wedgeBasis B r n t := by
  rw [extBase_apply]
  exact Finset.sum_congr rfl fun t _ => by
    rw [Module.Basis.repr_sum_self (wedgeBasis A r n) c]

/-- Change of base ring sends a wedge of vectors to the wedge of their images under `ρ`. -/
theorem extBase_ιMulti (ρ : A →+* B) (n : ℕ) (v : Fin n → (Fin r → A)) :
    extBase ρ r n (exteriorPower.ιMulti A n v) =
      exteriorPower.ιMulti B n (fun a i => ρ (v a i)) := by
  refine (wedgeBasis B r n).repr.injective (Finsupp.ext fun t => ?_)
  rw [extBase_repr, exteriorPower.basis_repr_apply, exteriorPower.basis_repr_apply,
    exteriorPower.ιMultiDual_apply_ιMulti, exteriorPower.ιMultiDual_apply_ιMulti,
    RingHom.map_det]
  simp only [Module.Basis.coord_apply, Pi.basisFun_repr, RingHom.mapMatrix_apply]
  congr 1

/-- Change of base ring along the identity is the identity. -/
theorem extBase_id (n : ℕ) (y : ⋀[A]^n (Fin r → A)) :
    extBase (RingHom.id A) r n y = y := by
  rw [extBase_apply]
  exact (wedgeBasis A r n).sum_repr y

/-- Change of base ring along `ρ` followed by `ρ'` is change of base ring along `ρ'.comp ρ`. -/
theorem extBase_comp {C : Type u₃} [CommRing C] (ρ : A →+* B) (ρ' : B →+* C) (n : ℕ)
    (y : ⋀[A]^n (Fin r → A)) :
    extBase ρ' r n (extBase ρ r n y) = extBase (ρ'.comp ρ) r n y := by
  refine (wedgeBasis C r n).repr.injective (Finsupp.ext fun t => ?_)
  simp [extBase_repr]

/-- Change of base ring takes a wedge of standard basis vectors to the wedge of the standard
basis vectors with the same indices. -/
theorem extBase_ιMulti_single (ρ : A →+* B) (n : ℕ) (i : Fin n → Fin r) :
    extBase ρ r n (exteriorPower.ιMulti A n fun j => Pi.single (i j) (1 : A)) =
      exteriorPower.ιMulti B n fun j => Pi.single (i j) (1 : B) := by
  rw [extBase_ιMulti]
  congr 1
  funext a k
  by_cases hk : k = i a
  · subst hk
    simp
  · simp [hk]

/-- Every element of an exterior power of a finite free module is a combination of wedges of
standard basis vectors. -/
theorem exists_sum_smul_ιMulti (n : ℕ) (y : ⋀[A]^n (Fin r → A)) :
    ∃ (c : ↑(Set.powersetCard (Fin r) n) → A)
      (v : ↑(Set.powersetCard (Fin r) n) → Fin n → (Fin r → A)),
      y = ∑ t, c t • exteriorPower.ιMulti A n (v t) := by
  refine ⟨fun t => (wedgeBasis A r n).repr y t,
    fun t j => Pi.single ((Set.powersetCard.ofFinEmbEquiv.symm t) j) (1 : A), ?_⟩
  simp only [← wedgeBasis_apply]
  exact ((wedgeBasis A r n).sum_repr y).symm

/-- The Koszul differential on a wedge of `n + 1` vectors. -/
theorem koszulD_ιMulti {M : Type u₁} [AddCommGroup M] [Module A M]
    (φ : Module.Dual A M) (n : ℕ) (v : Fin (n + 1) → M) :
    Koszul.d φ n (exteriorPower.ιMulti A (n + 1) v) =
      ∑ k : Fin (n + 1), ((-1 : A) ^ (k : ℕ) * φ (v k)) •
        exteriorPower.ιMulti A n (fun j => v (k.succAbove j)) := by
  refine Subtype.ext ?_
  rw [Koszul.d_apply_coe, exteriorPower.ιMulti_apply_coe, Koszul.contraction_ιMulti]
  push_cast
  simp [exteriorPower.ιMulti_apply_coe, Function.comp_def]

/-- The Koszul differential of a sequence commutes with change of base ring. -/
theorem extBase_koszulD (ρ : A →+* B) (g : Fin r → A) (n : ℕ)
    (y : ⋀[A]^(n + 1) (Fin r → A)) :
    extBase ρ r n (Koszul.d (Koszul.seqDual g) n y) =
      Koszul.d (Koszul.seqDual fun i => ρ (g i)) n (extBase ρ r (n + 1) y) := by
  obtain ⟨c, v, rfl⟩ := exists_sum_smul_ιMulti (n + 1) y
  simp only [map_sum, LinearMap.map_smul, extBase_smul, extBase_ιMulti]
  refine Finset.sum_congr rfl fun t _ => ?_
  congr 1
  rw [koszulD_ιMulti, koszulD_ιMulti, map_sum]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [extBase_smul, extBase_ιMulti]
  congr 1
  simp [Koszul.seqDual_apply, map_sum]

end BaseChange

/-! ### The stalk of the Koszul complex of a sequence of global sections -/

section StalkComparison

open scoped ExteriorAlgebra

/-- The underlying presheaf of abelian groups of a presheaf of `O_X`-modules, retyped as a
presheaf on the carrier of `X`. This is the form in which Mathlib's `TopCat.Presheaf.stalk` and
its `O_{X,x}`-module structure are found by instance search. -/
noncomputable abbrev abVal
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat)) :
    TopCat.Presheaf AddCommGrpCat.{u} X.carrier :=
  M.presheaf

/-- The germ at `x` of a section of a presheaf of `O_X`-modules, bundled as an additive map out
of `M.obj (op U)`. The bundling matters: the sums that occur below are formed with the module
structure on `M.obj (op U)`, and `rw` does not interchange that with the one on
`(abVal X M).obj (op U)`, even though the two are equal. -/
noncomputable def germHom
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {x : X} (U : Opens X) (hx : x ∈ U) : M.obj (op U) →+ (abVal X M).stalk x where
  toFun s := (abVal X M).germ U x hx s
  map_zero' := map_zero _
  map_add' a c := map_add _ a c

/-- Restriction of a section of a presheaf of `O_X`-modules, bundled as an additive map. -/
noncomputable def resHom
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {U V : Opens X} (h : V ≤ U) : M.obj (op U) →+ M.obj (op V) where
  toFun s := M.map (homOfLE h).op s
  map_zero' := map_zero _
  map_add' a c := map_add _ a c

variable {X}

/-- `germHom X M U hx` is the germ map of `abVal X M`. -/
theorem germHom_apply
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {x : X} (U : Opens X) (hx : x ∈ U) (s : M.obj (op U)) :
    germHom X M U hx s = (abVal X M).germ U x hx s := rfl

/-- `resHom X M h` is the restriction map `M.map (homOfLE h).op`. -/
theorem resHom_apply
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {U V : Opens X} (h : V ≤ U) (s : M.obj (op U)) :
    resHom X M h s = M.map (homOfLE h).op s := rfl

/-- The germ of `a • s` is the germ of `a` times the germ of `s`. -/
theorem germHom_smul (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {x : X} (U : Opens X) (hx : x ∈ U) (a : X.presheaf.obj (op U)) (s : M.obj (op U)) :
    germHom X M U hx (a • s) = (X.presheaf.germ U x hx).hom a • germHom X M U hx s :=
  PresheafOfModules.germ_smul M x U hx a s

/-- The restriction of `a • s` is the restriction of `a` times the restriction of `s`. -/
theorem resHom_smul (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {U V : Opens X} (h : V ≤ U) (a : X.presheaf.obj (op U)) (s : M.obj (op U)) :
    resHom X M h (a • s) = (X.presheaf.map (homOfLE h).op).hom a • resHom X M h s :=
  PresheafOfModules.map_smul M (homOfLE h).op a s

/-- The germ of a restriction of `s` is the germ of `s`. -/
theorem germHom_resHom (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {x : X} {U V : Opens X} (h : V ≤ U) (hx : x ∈ V) (s : M.obj (op U)) :
    germHom X M V hx (resHom X M h s) = germHom X M U (h hx) s :=
  (abVal X M).germ_res_apply (homOfLE h) x hx s

/-- Every element of the stalk is the germ of a section over some open neighbourhood. -/
theorem exists_germHom_eq
    (M : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
    {x : X} (m : (abVal X M).stalk x) :
    ∃ (U : Opens X) (hx : x ∈ U) (s : M.obj (op U)), germHom X M U hx s = m := by
  obtain ⟨U, hx, s, hs⟩ := (abVal X M).exists_germ_eq m
  exact ⟨U, hx, s, hs⟩

variable (X)

/-- Restriction on sections of the structure sheaf, as a ring homomorphism. -/
noncomputable abbrev resRing {U V : Opens X} (h : V ≤ U) :
    X.presheaf.obj (op U) →+* X.presheaf.obj (op V) :=
  (X.presheaf.map (homOfLE h).op).hom

/-- The germ map on sections of the structure sheaf, as a ring homomorphism. -/
noncomputable abbrev germRing {x : X} (U : Opens X) (hx : x ∈ U) :
    X.presheaf.obj (op U) →+* X.presheaf.stalk x :=
  (X.presheaf.germ U x hx).hom

/-- The germ map takes a standard basis vector to the standard basis vector. -/
theorem germRing_pi_single {x : X} (U : Opens X) (hx : x ∈ U) (k : Fin r) :
    (fun j : Fin r => germRing X U hx
        ((Pi.single k (1 : X.presheaf.obj (op U)) : Fin r → X.presheaf.obj (op U)) j)) =
      Pi.single k (1 : X.presheaf.stalk x) := by
  funext j
  by_cases hj : j = k
  · subst hj
    simp
  · simp [hj]

/-- The restriction to `U` of a sequence of global sections of the structure sheaf. -/
noncomputable def resSequence (U : Opens X) : Fin r → X.presheaf.obj (op U) :=
  fun i => X.presheaf.map (homOfLE le_top).op (f i)

/-- The germs at `x` of the restricted sequence `resSequence X f U` are `germSequence X f x`. -/
theorem germRing_resSequence {x : X} (U : Opens X) (hx : x ∈ U) :
    (fun i => germRing X U hx (resSequence X f U i)) = germSequence X f x :=
  funext fun i => germ_res_top_eq_germSequence X f i hx

variable (E : ℕ → PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat))
  (ξ : ∀ (n : ℕ) (U : Opens X), (E n).obj (op U) ≃ₗ[X.presheaf.obj (op U)]
    (⋀[X.presheaf.obj (op U)]^n (Fin r → X.presheaf.obj (op U))))
  (b : ∀ n : ℕ, (Fin n → Fin r) → (E n).obj (op (⊤ : Opens X)))

/-- The increasing tuple of indices attached to an `n`-element subset of `Fin r`. -/
noncomputable abbrev wedgeIndex (n : ℕ) (t : ↑(Set.powersetCard (Fin r) n)) : Fin n → Fin r :=
  fun j => (Set.powersetCard.ofFinEmbEquiv.symm t) j

/-- The restriction to `U` of the degree-`n` exterior product of the generators indexed by `i`. -/
noncomputable def wedgeSection (n : ℕ) (i : Fin n → Fin r) (U : Opens X) : (E n).obj (op U) :=
  resHom X (E n) (le_top : U ≤ ⊤) (b n i)

/-- The germ at `x` of the degree-`n` exterior product of the generators indexed by `i`. -/
noncomputable def wedgeGerm (n : ℕ) (i : Fin n → Fin r) (x : X) : (abVal X (E n)).stalk x :=
  germHom X (E n) (⊤ : Opens X) trivial (b n i)

/-- The germ at `x` of `wedgeSection X E b n i U` is `wedgeGerm X E b n i x`. -/
theorem germHom_wedgeSection (n : ℕ) (i : Fin n → Fin r) {x : X} (U : Opens X) (hx : x ∈ U) :
    germHom X (E n) U hx (wedgeSection X E b n i U) = wedgeGerm X E b n i x :=
  germHom_resHom (E n) le_top hx (b n i)

/-- The restriction of `wedgeSection X E b n i U` to `V` is `wedgeSection X E b n i V`. -/
theorem resHom_wedgeSection (n : ℕ) (i : Fin n → Fin r) {U V : Opens X} (h : V ≤ U) :
    resHom X (E n) h (wedgeSection X E b n i U) = wedgeSection X E b n i V := by
  rw [wedgeSection, wedgeSection, resHom_apply, resHom_apply, resHom_apply,
    ← PresheafOfModules.map_comp_apply]
  exact PresheafOfModules.congr_map_apply (E n) (Subsingleton.elim _ _) _

variable (hξ : ∀ (n : ℕ) (U : Opens X) (i : Fin n → Fin r),
  ξ n U (wedgeSection X E b n i U) =
    exteriorPower.ιMulti (X.presheaf.obj (op U)) n
      (fun j => Pi.single (i j) (1 : X.presheaf.obj (op U))))

include hξ

/-- The sectionwise comparison takes the canonical basis wedge indexed by `t` to the exterior
product of the generators indexed by `t`, written in increasing order. -/
theorem symm_wedgeBasis (n : ℕ) (U : Opens X) (t : ↑(Set.powersetCard (Fin r) n)) :
    (ξ n U).symm (wedgeBasis (X.presheaf.obj (op U)) r n t) =
      wedgeSection X E b n (wedgeIndex n t) U := by
  rw [wedgeBasis_apply, ← hξ n U, LinearEquiv.symm_apply_apply]

/-- The sectionwise comparison, applied to a combination of basis wedges. -/
theorem symm_sum_smul_wedgeBasis (n : ℕ) (U : Opens X)
    (c : ↑(Set.powersetCard (Fin r) n) → X.presheaf.obj (op U)) :
    (ξ n U).symm (∑ t, c t • wedgeBasis (X.presheaf.obj (op U)) r n t) =
      ∑ t, c t • wedgeSection X E b n (wedgeIndex n t) U := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun t _ => by rw [map_smul, symm_wedgeBasis X E ξ b hξ]

omit hξ

/-- The comparison map from the degree-`n` part of the ring-level Koszul complex of the germ
sequence to the stalk of `E n`: the `O_{X,x}`-linear map taking the canonical basis wedge
indexed by `t` to the germ of the exterior product of the generators indexed by `t`. -/
noncomputable def toStalk (n : ℕ) (x : X) :
    (⋀[X.presheaf.stalk x]^n (Fin r → X.presheaf.stalk x)) →ₗ[X.presheaf.stalk x]
      (abVal X (E n)).stalk x :=
  (wedgeBasis (X.presheaf.stalk x) r n).constr (X.presheaf.stalk x)
    fun t => wedgeGerm X E b n (wedgeIndex n t) x

/-- `toStalk` sends the basis wedge indexed by `t` to the germ of the exterior product of the
generators indexed by `t`. -/
@[simp]
theorem toStalk_wedgeBasis (n : ℕ) (x : X) (t : ↑(Set.powersetCard (Fin r) n)) :
    toStalk X E b n x (wedgeBasis (X.presheaf.stalk x) r n t) =
      wedgeGerm X E b n (wedgeIndex n t) x :=
  (wedgeBasis (X.presheaf.stalk x) r n).constr_basis _ _ t

include hξ in
/-- Change of base ring along a germ map, applied to a combination of basis wedges. -/
theorem toStalk_extBase_sum (n : ℕ) {x : X} (U : Opens X) (hx : x ∈ U)
    (c : ↑(Set.powersetCard (Fin r) n) → X.presheaf.obj (op U)) :
    toStalk X E b n x (extBase (germRing X U hx) r n
        (∑ t, c t • wedgeBasis (X.presheaf.obj (op U)) r n t)) =
      germHom X (E n) U hx
        ((ξ n U).symm (∑ t, c t • wedgeBasis (X.presheaf.obj (op U)) r n t)) := by
  rw [extBase_sum_smul, map_sum, symm_sum_smul_wedgeBasis X E ξ b hξ, map_sum]
  exact Finset.sum_congr rfl fun t _ => by
    rw [map_smul, toStalk_wedgeBasis, germHom_smul, germHom_wedgeSection X E b]

include hξ in
/-- **The comparison formula.** The stalk comparison is compatible with change of base ring along
a germ map: an element of the exterior power over `O_X(U)` is sent, after passing to germs, to the
germ of the corresponding section of `E n`. -/
theorem toStalk_extBase (n : ℕ) {x : X} (U : Opens X) (hx : x ∈ U)
    (y : ⋀[X.presheaf.obj (op U)]^n (Fin r → X.presheaf.obj (op U))) :
    toStalk X E b n x (extBase (germRing X U hx) r n y) =
      germHom X (E n) U hx ((ξ n U).symm y) := by
  have h := toStalk_extBase_sum X E ξ b hξ n U hx
    ((wedgeBasis (X.presheaf.obj (op U)) r n).repr y)
  rwa [(wedgeBasis (X.presheaf.obj (op U)) r n).sum_repr y] at h

include hξ in
/-- Restriction of sections corresponds, under the sectionwise comparison, to change of base ring
along the restriction map. Applied to a combination of basis wedges. -/
theorem resHom_symm_sum (n : ℕ) {U V : Opens X} (h : V ≤ U)
    (c : ↑(Set.powersetCard (Fin r) n) → X.presheaf.obj (op U)) :
    resHom X (E n) h
        ((ξ n U).symm (∑ t, c t • wedgeBasis (X.presheaf.obj (op U)) r n t)) =
      (ξ n V).symm (extBase (resRing X h) r n
        (∑ t, c t • wedgeBasis (X.presheaf.obj (op U)) r n t)) := by
  rw [extBase_sum_smul, symm_sum_smul_wedgeBasis X E ξ b hξ,
    symm_sum_smul_wedgeBasis X E ξ b hξ, map_sum]
  exact Finset.sum_congr rfl fun t _ => by
    rw [resHom_smul, resHom_wedgeSection X E b]

include hξ in
/-- Restriction of sections corresponds, under the sectionwise comparison, to change of base ring
along the restriction map. -/
theorem resHom_symm (n : ℕ) {U V : Opens X} (h : V ≤ U)
    (y : ⋀[X.presheaf.obj (op U)]^n (Fin r → X.presheaf.obj (op U))) :
    resHom X (E n) h ((ξ n U).symm y) =
      (ξ n V).symm (extBase (resRing X h) r n y) := by
  have hh := resHom_symm_sum X E ξ b hξ n h ((wedgeBasis (X.presheaf.obj (op U)) r n).repr y)
  rwa [(wedgeBasis (X.presheaf.obj (op U)) r n).sum_repr y] at hh

omit hξ

/-- Every element of the ring-level Koszul module over the stalk comes, by change of base ring,
from an element over some open neighbourhood. -/
theorem exists_extBase_eq (n : ℕ) {x : X}
    (y : ⋀[X.presheaf.stalk x]^n (Fin r → X.presheaf.stalk x)) :
    ∃ (U : Opens X) (hx : x ∈ U)
      (y' : ⋀[X.presheaf.obj (op U)]^n (Fin r → X.presheaf.obj (op U))),
      extBase (germRing X U hx) r n y' = y := by
  classical
  choose W hW a ha using fun t : ↑(Set.powersetCard (Fin r) n) =>
    X.presheaf.exists_germ_eq ((wedgeBasis (X.presheaf.stalk x) r n).repr y t)
  have hmem : x ∈ (⨅ t, W t : Opens X) := by
    simpa only [← SetLike.mem_coe, Opens.coe_iInf, Set.mem_iInter] using hW
  refine ⟨⨅ t, W t, hmem,
    ∑ t, resRing X (iInf_le _ t) (a t) •
      wedgeBasis (X.presheaf.obj (op (⨅ t, W t))) r n t, ?_⟩
  rw [extBase_sum_smul, ← (wedgeBasis (X.presheaf.stalk x) r n).sum_repr y]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [← ha t]
  congr 1
  exact X.presheaf.germ_res_apply (homOfLE (iInf_le _ t)) x hmem (a t)

include hξ

/-- The comparison `toStalk` is surjective. -/
theorem toStalk_surjective (n : ℕ) (x : X) : Function.Surjective (toStalk X E b n x) := by
  intro m
  obtain ⟨U, hx, s, hs⟩ := exists_germHom_eq (E n) m
  refine ⟨extBase (germRing X U hx) r n (ξ n U s), ?_⟩
  rwa [toStalk_extBase X E ξ b hξ, LinearEquiv.symm_apply_apply]

/-- The comparison `toStalk` is injective. -/
theorem toStalk_injective (n : ℕ) (x : X) : Function.Injective (toStalk X E b n x) := by
  rw [injective_iff_map_eq_zero]
  intro y hy
  obtain ⟨U, hx, y', rfl⟩ := exists_extBase_eq X n y
  rw [toStalk_extBase X E ξ b hξ, germHom_apply] at hy
  obtain ⟨W, hxW, iWU, iWU', hW⟩ :=
    (abVal X (E n)).germ_eq x hx hx ((ξ n U).symm y') 0 (by rwa [map_zero])
  have hle : W ≤ U := leOfHom iWU
  have hres : resHom X (E n) hle ((ξ n U).symm y') = 0 := by
    rw [resHom_apply, show (homOfLE hle : W ⟶ U) = iWU from Subsingleton.elim _ _,
      show ((E n).map iWU.op) ((ξ n U).symm y') =
        ((abVal X (E n)).map iWU.op) ((ξ n U).symm y') from rfl, hW]
    exact map_zero _
  rw [resHom_symm X E ξ b hξ] at hres
  have hzero : extBase (resRing X hle) r n y' = 0 := by
    have h := congrArg (ξ n W) hres
    rwa [LinearEquiv.apply_symm_apply, map_zero] at h
  have hgerm : ∀ t, germRing X U hx ((wedgeBasis (X.presheaf.obj (op U)) r n).repr y' t) = 0 := by
    intro t
    have h1 := congrArg (fun z => (wedgeBasis (X.presheaf.obj (op W)) r n).repr z t) hzero
    simp only [extBase_repr, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h1
    rw [← X.presheaf.germ_res_apply (homOfLE hle) x hxW
      ((wedgeBasis (X.presheaf.obj (op U)) r n).repr y' t)]
    rw [show X.presheaf.map (homOfLE hle).op
      ((wedgeBasis (X.presheaf.obj (op U)) r n).repr y' t) = 0 from h1]
    exact map_zero _
  rw [extBase_apply]
  exact Finset.sum_eq_zero fun t _ => by rw [hgerm t, zero_smul]

/-- The comparison `toStalk` is bijective. -/
theorem toStalk_bijective (n : ℕ) (x : X) : Function.Bijective (toStalk X E b n x) :=
  ⟨toStalk_injective X E ξ b hξ n x, toStalk_surjective X E ξ b hξ n x⟩

/-- **The stalk of the Koszul complex, degreewise.** The degree-`n` part of the ring-level Koszul
complex of the sequence of germs is canonically the stalk of `E n`: the comparison
`toStalk` is an isomorphism of `O_{X,x}`-modules. -/
noncomputable def stalkEquiv (n : ℕ) (x : X) :
    (⋀[X.presheaf.stalk x]^n (Fin r → X.presheaf.stalk x)) ≃ₗ[X.presheaf.stalk x]
      (abVal X (E n)).stalk x :=
  LinearEquiv.ofBijective (toStalk X E b n x) (toStalk_bijective X E ξ b hξ n x)

/-- The underlying map of `stalkEquiv` is `toStalk`. -/
@[simp]
theorem stalkEquiv_apply (n : ℕ) (x : X)
    (y : ⋀[X.presheaf.stalk x]^n (Fin r → X.presheaf.stalk x)) :
    stalkEquiv X E ξ b hξ n x y = toStalk X E b n x y := rfl

/-- The comparison sends a wedge of standard basis vectors to the germ of the corresponding
exterior product of generators. This is the degree-`n` case of the characterization: in degree
zero it is the unit, and in degree one the individual generators. -/
theorem toStalk_ιMulti (n : ℕ) {x : X} (i : Fin n → Fin r) :
    toStalk X E b n x (exteriorPower.ιMulti (X.presheaf.stalk x) n
        (fun j => Pi.single (i j) (1 : X.presheaf.stalk x))) = wedgeGerm X E b n i x := by
  refine (congrArg (toStalk X E b n x)
    (extBase_ιMulti_single (germRing X (⊤ : Opens X) trivial) n i).symm).trans ?_
  erw [toStalk_extBase X E ξ b hξ, ← hξ n (⊤ : Opens X) i, LinearEquiv.symm_apply_apply,
    germHom_wedgeSection X E b]

/-- **The characterizing formula for the comparison.** A scalar multiple of an exterior product
of generators has, for germ at `x`, the corresponding multiple of the wedge of standard basis
vectors over `O_{X,x}`, with the scalar replaced by its germ. -/
theorem stalkEquiv_symm_germHom_smul_wedgeSection (n : ℕ) {x : X} (U : Opens X) (hx : x ∈ U)
    (a : X.presheaf.obj (op U)) (i : Fin n → Fin r) :
    (stalkEquiv X E ξ b hξ n x).symm
        (germHom X (E n) U hx (a • wedgeSection X E b n i U)) =
      germRing X U hx a • exteriorPower.ιMulti (X.presheaf.stalk x) n
        (fun j => Pi.single (i j) (1 : X.presheaf.stalk x)) := by
  rw [LinearEquiv.symm_apply_eq, stalkEquiv_apply, germHom_smul,
    germHom_wedgeSection X E b, map_smul, toStalk_ιMulti X E ξ b hξ]

variable (D : ∀ n : ℕ, E (n + 1) ⟶ E n)

/-- The map induced on stalks by a morphism of presheaves of modules. -/
noncomputable def stalkHom {M N : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat)}
    (φ : M ⟶ N) (x : X) : (abVal X M).stalk x →+ (abVal X N).stalk x :=
  ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
    ((PresheafOfModules.toPresheaf _).map φ)).hom

omit hξ in
/-- The map induced on stalks by `φ` sends the germ of `s` to the germ of `φ.app (op U) s`. -/
theorem stalkHom_germHom
    {M N : PresheafOfModules.{u} (X.presheaf ⋙ forget₂ CommRingCat RingCat)}
    (φ : M ⟶ N) {x : X} (U : Opens X) (hx : x ∈ U) (s : M.obj (op U)) :
    stalkHom X φ x (germHom X M U hx s) = germHom X N U hx (φ.app (op U) s) :=
  TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx
    ((PresheafOfModules.toPresheaf _).map φ) s

variable (hD : ∀ (n : ℕ) (U : Opens X) (s : (E (n + 1)).obj (op U)),
  ξ n U ((D n).app (op U) s) =
    Koszul.d (Koszul.seqDual (resSequence X f U)) n (ξ (n + 1) U s))

include hξ hD in
/-- **The differentials match.** The map induced on stalks by `D n` is, under the comparison, the
degree-`n` Koszul differential of the sequence of germs. -/
theorem stalkHom_toStalk (n : ℕ) {x : X}
    (y : ⋀[X.presheaf.stalk x]^(n + 1) (Fin r → X.presheaf.stalk x)) :
    stalkHom X (D n) x (toStalk X E b (n + 1) x y) =
      toStalk X E b n x (Koszul.d (Koszul.seqDual (germSequence X f x)) n y) := by
  obtain ⟨U, hx, y', rfl⟩ := exists_extBase_eq X (n + 1) y
  rw [toStalk_extBase X E ξ b hξ, stalkHom_germHom, ← germRing_resSequence X f U hx,
    ← extBase_koszulD, toStalk_extBase X E ξ b hξ]
  refine congrArg (germHom X (E n) U hx) ?_
  rw [LinearEquiv.eq_symm_apply, hD n U ((ξ (n + 1) U).symm y'),
    LinearEquiv.apply_symm_apply]

include hξ hD in
/-- The map induced on stalks by `D n` is `O_{X,x}`-linear. -/
theorem stalkHom_smul (n : ℕ) (x : X) (c : X.presheaf.stalk x)
    (m : (abVal X (E (n + 1))).stalk x) :
    stalkHom X (D n) x (c • m) = c • stalkHom X (D n) x m := by
  obtain ⟨y, rfl⟩ := toStalk_surjective X E ξ b hξ (n + 1) x m
  rw [← map_smul, stalkHom_toStalk X f E ξ b hξ D hD, stalkHom_toStalk X f E ξ b hξ D hD,
    map_smul, map_smul]

/-- The map induced on stalks by `D n`, as an `O_{X,x}`-linear map. -/
noncomputable def stalkD (n : ℕ) (x : X) :
    (abVal X (E (n + 1))).stalk x →ₗ[X.presheaf.stalk x] (abVal X (E n)).stalk x where
  toFun := stalkHom X (D n) x
  map_add' := map_add _
  map_smul' c m := stalkHom_smul X f E ξ b hξ D hD n x c m

/-- The underlying map of `stalkD` is `stalkHom X (D n) x`. -/
@[simp]
theorem stalkD_apply (n : ℕ) (x : X) (m : (abVal X (E (n + 1))).stalk x) :
    stalkD X f E ξ b hξ D hD n x m = stalkHom X (D n) x m := rfl

include hξ hD in
/-- Two consecutive maps induced on stalks by the differentials compose to zero. -/
theorem stalkD_comp_stalkD (n : ℕ) (x : X) :
    (stalkD X f E ξ b hξ D hD n x).comp (stalkD X f E ξ b hξ D hD (n + 1) x) = 0 := by
  refine LinearMap.ext fun m => ?_
  obtain ⟨y, rfl⟩ := toStalk_surjective X E ξ b hξ (n + 2) x m
  rw [LinearMap.comp_apply, stalkD_apply, stalkD_apply, stalkHom_toStalk X f E ξ b hξ D hD,
    stalkHom_toStalk X f E ξ b hξ D hD]
  have : Koszul.d (Koszul.seqDual (germSequence X f x)) n
      (Koszul.d (Koszul.seqDual (germSequence X f x)) (n + 1) y) = 0 :=
    congrFun (congrArg (fun g : _ →ₗ[X.presheaf.stalk x] _ => (g : _ → _))
      (Koszul.d_comp_d (Koszul.seqDual (germSequence X f x)) n)) y
  rw [this, map_zero, LinearMap.zero_apply]

/-- The complex of stalks at `x`: in degree `n` the stalk of `E n`, with the maps induced on
stalks by the `D n`. -/
noncomputable def stalkComplex (x : X) : ChainComplex (ModuleCat.{u} (X.presheaf.stalk x)) ℕ :=
  ChainComplex.of (fun n => ModuleCat.of (X.presheaf.stalk x) ((abVal X (E n)).stalk x))
    (fun n => ModuleCat.ofHom (stalkD X f E ξ b hξ D hD n x))
    fun n => by
      apply ModuleCat.hom_ext
      rw [ModuleCat.hom_comp, ModuleCat.hom_ofHom, ModuleCat.hom_ofHom, ModuleCat.hom_zero,
        stalkD_comp_stalkD]

/-- The differential of `stalkComplex` from degree `n + 1` to degree `n` is `stalkD … n x`. -/
theorem stalkComplex_d (x : X) (n : ℕ) :
    (stalkComplex X f E ξ b hξ D hD x).d (n + 1) n =
      ModuleCat.ofHom (stalkD X f E ξ b hξ D hD n x) :=
  ChainComplex.of_d (fun n => ModuleCat.of (X.presheaf.stalk x) ((abVal X (E n)).stalk x))
    (fun n => ModuleCat.ofHom (stalkD X f E ξ b hξ D hD n x)) n

include hξ hD in
/-- **The stalk of the Koszul complex is the Koszul complex of the germs.** The complex of stalks
at `x`, whose differentials are the maps induced on stalks by the `D n`, is isomorphic to the
ring-level Koszul complex of the sequence of germs, degreewise by the comparison `toStalk`. -/
noncomputable def seqComplexIsoStalkComplex (x : X) :
    Koszul.seqComplex (germSequence X f x) ≅ stalkComplex X f E ξ b hξ D hD x :=
  HomologicalComplex.Hom.isoOfComponents
    (fun n => (stalkEquiv X E ξ b hξ n x).toModuleIso) (by
      intro i j hij
      obtain rfl : j + 1 = i := hij
      rw [stalkComplex_d, Koszul.seqComplex_d]
      exact ModuleCat.hom_ext (LinearMap.ext fun y => stalkHom_toStalk X f E ξ b hξ D hD j y))

end StalkComparison

end Stacks.RegularSequence
