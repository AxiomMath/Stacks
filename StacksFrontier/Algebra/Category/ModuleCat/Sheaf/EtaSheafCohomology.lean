/-! ## Situation 0GT4 -/

variable (X : RingedSpace.{u})

local notation "Oₓ" => (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- **Situation 0GT4.** A sheaf of ideals `ι : I ⟶ O_X` on a ringed space which is locally
generated by a nonzerodivisor: every point has an open neighbourhood `U` carrying a section `f`
of `I` which generates `I|_U` and acts injectively on `O_U`. -/
@[stacks 0GT4]
public structure Situation where
  /-- The ideal sheaf. -/
  I : SheafOfModules.{u} (structureSheafRing X)
  /-- Its inclusion into the structure sheaf. -/
  ι : I ⟶ SheafOfModules.unit (structureSheafRing X)
  /-- The inclusion is a monomorphism: `I` is a *sub*sheaf of `O_X`. -/
  [mono : Mono ι]
  /-- Condition (1) of Tag 0GT3: locally, `I` is generated by a nonzerodivisor. -/
  locally_principal : ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U) (f : I.val.obj (Opposite.op U)),
    GeneratesIdealOn X U f ∧
      IsGeneratorRegularOn X ι
        (SheafOfModules.unit
          (structureSheafRing X)) U f

attribute [instance] Situation.mono

section Multiplication

open MonoidalCategory Opposite
open scoped TensorProduct

/-- The ideal map, with its target spelled as the monoidal unit of presheaves of modules over
`Oₓ`.  The two spellings agree definitionally, but only a declared type reaches the implicit
argument of `◁` and `▷`, which is where the monoidal structure to be used is read off. -/
private def idealUnit {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪) :
    I.val ⟶ 𝟙_ (PresheafOfModules.{u} (Oₓ).obj) :=
  ι.val

/-- Multiplication `M ⊗ I ⟶ M` by the ideal, induced by `ι : I ⟶ O_X`. -/
private noncomputable def idealMultiplication {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).obj M ⟶ M :=
  ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map
      (M.val ◁ ι.val ≫ (ρ_ M.val).hom) ≫
    ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).counit.app M

/-- On sections of the presheaf tensor product, multiplication by the ideal is the presheaf
multiplication. -/
private lemma toSheafify_idealMultiplication {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
          (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ≫
        (idealMultiplication X ι M).val =
      M.val ◁ ι.val ≫ (ρ_ M.val).hom := by
  have h := (((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).homEquiv
    (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) M).apply_symm_apply
    (M.val ◁ ι.val ≫ (ρ_ M.val).hom)
  exact h

/-- Multiplication by the ideal is natural in the module. -/
private lemma idealMultiplication_natural {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N) :
    ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).map f ≫
        idealMultiplication X ι N =
      idealMultiplication X ι M ≫ f := by
  have hmon := multiply_naturality I.val ι.val f.val
  -- The rest is the adjunction.  Each step is a ground equation fed to `congrArg`, because the
  -- composite `toSheafify … ≫ (…).val` is type-correct only at `default` transparency: the unit
  -- lands in the right adjoint applied to the sheafification, while `.val` reads the underlying
  -- presheaf of modules, and these are the same object spelled differently.
  apply (((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).homEquiv
    (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) N).injective
  change ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
        (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ≫
      ((((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map (f.val ▷ I.val)).val ≫
        (idealMultiplication X ι N).val) =
    ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
        (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ≫
      ((idealMultiplication X ι M).val ≫ f.val)
  exact (Category.assoc _ _ _).symm.trans
    ((congrArg (fun morphism => morphism ≫ (idealMultiplication X ι N).val)
      ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit_naturality
        (f.val ▷ I.val))).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun morphism => (f.val ▷ I.val) ≫ morphism)
            (toSheafify_idealMultiplication X ι N)).trans
              (hmon.trans
                ((congrArg (fun morphism => morphism ≫ f.val)
                  (toSheafify_idealMultiplication X ι M).symm).trans
                    (Category.assoc _ _ _))))))

/-- Multiplication by the ideal composed with a map is zero exactly when the map kills every
product of a local section of the ideal with a local section of the source. -/
private lemma idealMultiplication_comp_zero_iff {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N) :
    idealMultiplication X ι M ≫ f = 0 ↔
      ∀ (U : (Opens X)ᵒᵖ) (a : I.val.obj U) (s : M.val.obj U),
        (N.val.obj U).isModule.toSMul.smul
          (idealSection X ι U a) ((f.val.app U).hom s) = 0 := by
  let S := (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let adj := (PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let raw : (M.val ⊗ I.val) ⟶ N.val := (M.val ◁ ι.val ≫ (ρ_ M.val).hom) ≫ f.val
  have he : idealMultiplication X ι M ≫ f = (adj.homEquiv _ _).symm raw :=
    (adj.homEquiv_naturality_right_symm (M.val ◁ ι.val ≫ (ρ_ M.val).hom) f).symm
  have hz : (adj.homEquiv (M.val ⊗ I.val) N).symm 0 = 0 := by
    change S.map (0 : (M.val ⊗ I.val) ⟶ N.val) ≫ adj.counit.app N = 0
    exact (congrArg (fun k => k ≫ adj.counit.app N)
      (Functor.map_zero S (M.val ⊗ I.val) N.val)).trans zero_comp
  have key : idealMultiplication X ι M ≫ f = 0 ↔ raw = 0 := by
    rw [he]
    refine ⟨fun h => (adj.homEquiv (M.val ⊗ I.val) N).symm.injective (h.trans hz.symm),
      fun h => ?_⟩
    rw [h]
    exact hz
  rw [key]
  refine ⟨fun h U a s => ?_, fun h => ?_⟩
  · have h' := congrArg (fun g => (g.app U).hom (s ⊗ₜ[(Oₓ).obj.obj U] a)) h
    change (f.val.app U).hom
      ((M.val.obj U).isModule.toSMul.smul (idealSection X ι U a) s) = 0 at h'
    exact ((f.val.app U).hom.map_smulₛₗ (idealSection X ι U a) s).symm.trans h'
  · apply PresheafOfModules.hom_ext
    intro U
    apply ModuleCat.hom_ext
    change ((raw.app U).hom :
      (M.val.obj U ⊗[(Oₓ).obj.obj U] I.val.obj U) →ₗ[(Oₓ).obj.obj U] N.val.obj U) = 0
    refine TensorProduct.ext' (R := (Oₓ).obj.obj U)
      (σ₁₂ := RingHom.id ((Oₓ).obj.obj U)) ?_
    intro s a
    change (f.val.app U).hom
      ((M.val.obj U).isModule.toSMul.smul (idealSection X ι U a) s) = 0
    exact ((f.val.app U).hom.map_smulₛₗ (idealSection X ι U a) s).trans (h U a s)

/-! ### Multiplying by the ideal after twisting -/

/-- Sheafifying a twofold presheaf tensor product by the ideal agrees with two successive sheaf
tensor products by the ideal. -/
private noncomputable def tensorDoubleComparison {I : SheafOfModules.{u} Oₓ}
    (M : SheafOfModules.{u} Oₓ) :
    ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).obj
      ((M.val ⊗ I.val) ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ≅
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).obj
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).obj M) :=
  -- The `IsIso` argument is supplied rather than searched for: its statement is at the spelling
  -- of the sheafification of a twofold presheaf tensor product, while the asserted isomorphism
  -- is at the spelling of two successive sheaf tensor products.  These agree definitionally but
  -- not at `instances` transparency, which is where instance search runs.
  @asIso _ _ _ _ (((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map
      (((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
        (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ▷ I.val))
    (isIso_sheafify_map_whiskerRight X.presheaf (Oₓ).property
      (((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
        (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj)) I.val
      (isIso_sheafify_map_toSheafify X.presheaf (Oₓ).property
        (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj)))

attribute [local implicit_reducible] tensorDoubleComparison idealMultiplication

set_option maxHeartbeats 1000000 in
-- the `rfl` steps and ground equations unfold sheafification of the presheaf tensor product
/-- The comparison of a twofold tensor product, followed by multiplying the outer factor into
the sheafified twofold tensor product, is the sheafification of the presheaf multiplication. -/
private lemma tensorDoubleComparison_multiplication {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    (tensorDoubleComparison X (I := I) M).hom ≫
        idealMultiplication X ι
          (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).obj M) =
      ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map
        ((M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ◁ ι.val ≫
          (ρ_ (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj)).hom) := by
  let S := (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let adj := (PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let P : PresheafOfModules.{u} (Oₓ).obj := M.val ⊗ I.val
  let unit : P ⟶ (S.obj P).val := adj.unit.app P
  let counit : S.obj (S.obj P).val ⟶ S.obj P := adj.counit.app (S.obj P)
  let multiplication : P ⊗ I.val ⟶ P := P ◁ idealUnit X ι ≫ (ρ_ P).hom
  let sheafifiedMultiplication : (S.obj P).val ⊗ I.val ⟶ (S.obj P).val :=
    (S.obj P).val ◁ idealUnit X ι ≫ (ρ_ (S.obj P).val).hom
  have comparisonHom : (tensorDoubleComparison X (I := I) M).hom = S.map (unit ▷ I.val) := rfl
  have multiplicationHom : idealMultiplication X ι
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf).flip.obj I).obj M) =
      S.map sheafifiedMultiplication ≫ counit := rfl
  refine (congrArg (fun comparison => comparison ≫ idealMultiplication X ι
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      X.sheaf).flip.obj I).obj M))
    comparisonHom).trans ?_
  refine (congrArg (S.map (unit ▷ I.val) ≫ ·) multiplicationHom).trans ?_
  -- The unit `η` has its target spelled through the right adjoint rather than as `(S.obj P).val`,
  -- so `η ▷ I.val` is type-correct only at `default` transparency and no rewrite can match on
  -- it.  Each step is therefore a ground equation, where elaboration runs at that transparency.
  have triangle : S.map unit ≫ counit = 𝟙 _ := adj.left_triangle_components P
  have naturality : (unit ▷ I.val) ≫ sheafifiedMultiplication = multiplication ≫ unit :=
    multiply_naturality I.val (idealUnit X ι) unit
  exact (Category.assoc (S.map (unit ▷ I.val)) (S.map sheafifiedMultiplication) counit).symm.trans
    ((congrArg (fun morphism => morphism ≫ counit)
      (S.map_comp (unit ▷ I.val) sheafifiedMultiplication).symm).trans
        ((congrArg (fun morphism => S.map morphism ≫ counit) naturality).trans
          ((congrArg (fun morphism => morphism ≫ counit)
            (S.map_comp multiplication unit)).trans
              ((Category.assoc (S.map multiplication) (S.map unit) counit).trans
                ((congrArg (S.map multiplication ≫ ·) triangle).trans (Category.comp_id _))))))

/-- The comparison of a twofold tensor product, followed by twisting multiplication by the
ideal, is the sheafification of the twisted presheaf multiplication. -/
private lemma tensorDoubleComparison_map_multiplication {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    (tensorDoubleComparison X (I := I) M).hom ≫
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).map
          (idealMultiplication X ι M) =
      ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map
        ((M.val ◁ ι.val ≫ (ρ_ M.val).hom) ▷ I.val) := by
  let S := (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let η := ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).unit.app)
    (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj)
  change S.map (η ▷ I.val) ≫ S.map ((idealMultiplication X ι M).val ▷ I.val) = _
  -- As above, `η ▷ I.val` is type-correct only at `default` transparency.
  exact (S.map_comp (η ▷ I.val) ((idealMultiplication X ι M).val ▷ I.val)).symm.trans
    (congrArg S.map
      ((comp_whiskerRight η (idealMultiplication X ι M).val I.val).symm.trans
        (congrArg (fun k => k ▷ I.val) (toSheafify_idealMultiplication X ι M))))

/-- Multiplication by the ideal composed with a map is zero exactly when the same holds after
twisting both by the ideal. -/
private lemma idealMultiplication_tensor_zero_iff {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N) :
    idealMultiplication X ι
        (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).obj M) ≫
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).map f = 0 ↔
      idealMultiplication X ι M ≫ f = 0 := by
  let S := (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I
  have : T.IsEquivalence := tensorRightFunctor_isEquivalence X.presheaf (Oₓ).property I
  let e := tensorDoubleComparison X (I := I) M
  let σ : ((M.val ⊗ I.val) ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ⟶
      ((M.val ⊗ I.val) ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) :=
    (α_ M.val I.val I.val).hom ≫ (M.val ◁ (β_ I.val I.val).hom) ≫
      (α_ M.val I.val I.val).inv
  have hσ : IsIso σ := by dsimp [σ]; infer_instance
  have ht : T.map (idealMultiplication X ι M ≫ f) =
      e.inv ≫ S.map σ ≫ e.hom ≫ idealMultiplication X ι (T.obj M) ≫ T.map f := by
    apply (cancel_epi e.hom).mp
    simp only [← Category.assoc, Iso.hom_inv_id, Category.id_comp, Functor.map_comp]
    rw [tensorDoubleComparison_map_multiplication]
    -- Interchanging the two copies of the ideal and then multiplying is multiplying first and
    -- then tensoring, which is `swap_multiply`.  It is fed in as a term, with the ideal map
    -- spelled through `idealUnit` so that the monoidal structure it is read in is the one on
    -- presheaves of modules over `Oₓ` rather than over the sheafification spelling of it.
    have multiplication : S.map σ ≫ (e.hom ≫ idealMultiplication X ι (T.obj M)) =
        S.map ((M.val ◁ idealUnit X ι ≫ (ρ_ M.val).hom) ▷ I.val) := by
      refine (congrArg (S.map σ ≫ ·)
        (tensorDoubleComparison_multiplication X ι M)).trans ?_
      refine (S.map_comp σ
        ((M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj) ◁ idealUnit X ι ≫
          (ρ_ (M.val ⊗ I.val : PresheafOfModules.{u} (Oₓ).obj)).hom)).symm.trans ?_
      refine congrArg S.map ?_
      refine ((Category.assoc _ _ _).trans
        (congrArg ((α_ M.val I.val I.val).hom ≫ ·) (Category.assoc _ _ _))).trans ?_
      exact swap_multiply M.val I.val I.val (idealUnit X ι)
    exact (congrArg (fun morphism => morphism ≫ T.map f) multiplication).symm.trans
      ((Category.assoc _ _ _).trans (congrArg (S.map σ ≫ ·) (Category.assoc _ _ _)))
  constructor
  · intro h
    apply T.map_injective
    have zeroComposite : e.inv ≫ S.map σ ≫ e.hom ≫
        (0 : T.obj (T.obj M) ⟶ T.obj N) = 0 := by simp only [comp_zero]
    exact ht.trans ((congrArg (fun morphism => e.inv ≫ S.map σ ≫ e.hom ≫ morphism) h).trans
      (zeroComposite.trans (T.map_zero _ _).symm))
  · intro h
    have h' := congrArg T.map h
    rw [ht, Functor.map_zero] at h'
    have : IsIso (S.map σ) := Functor.map_isIso S σ
    have : Epi (e.inv ≫ S.map σ ≫ e.hom) := inferInstance
    apply (cancel_epi (e.inv ≫ S.map σ ≫ e.hom)).mp
    simpa only [Category.assoc, comp_zero] using h'

/-- Being killed by multiplication by the ideal is invariant under isomorphism of the source
and target of the map. -/
private lemma idealMultiplication_comp_iso_zero_iff {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N M' N' : SheafOfModules.{u} Oₓ}
    (eM : M ≅ M') (eN : N ≅ N') (f : M ⟶ N) (f' : M' ⟶ N')
    (h : f ≫ eN.hom = eM.hom ≫ f') :
    idealMultiplication X ι M' ≫ f' = 0 ↔ idealMultiplication X ι M ≫ f = 0 := by
  let T := (Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I
  have he : T.map eM.hom ≫ idealMultiplication X ι M' ≫ f' =
      (idealMultiplication X ι M ≫ f) ≫ eN.hom := by
    rw [← Category.assoc, idealMultiplication_natural, Category.assoc, ← h, ← Category.assoc]
  constructor
  · intro hf'
    apply (cancel_mono eN.hom).mp
    rw [← he, hf', comp_zero, zero_comp]
  · intro hf
    apply (cancel_epi (T.map eM.hom)).mp
    rw [he, hf, zero_comp, comp_zero]

/-- Multiplication by the ideal composed with a map is zero exactly when the same holds after
twisting both by an arbitrary integer power of the ideal. -/
private lemma idealMultiplication_power_zero_iff {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N) (n : ℤ) :
    idealMultiplication X ι (idealPowerTerm X I n M) ≫ idealPowerMap X I n f = 0 ↔
      idealMultiplication X ι M ≫ f = 0 := by
  let _ : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
      X.sheaf).flip.obj I).IsEquivalence :=
    tensorRightFunctor_isEquivalence X.presheaf (Oₓ).property I
  let P (k : ℤ) := idealMultiplication X ι (idealPowerTerm X I k M) ≫
    idealPowerMap X I k f = 0
  have step (k : ℤ) : P (k + 1) ↔ P k := by
    -- The naturality square of the successor comparison is supplied through a hole, so that its
    -- expected type is known before it is elaborated: the tensor-power equivalence and the
    -- integer iterate of the right-tensoring autoequivalence agree only definitionally.
    refine (idealMultiplication_comp_iso_zero_iff X ι
      (powSuccIso ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf).flip.obj I).asEquivalence k M)
      (powSuccIso ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf).flip.obj I).asEquivalence k N)
      (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).map
        (idealPowerMap X I k f))
      (idealPowerMap X I (k + 1) f) ?_).trans
      (idealMultiplication_tensor_zero_iff X ι (idealPowerMap X I k f))
    exact powSuccIso_natural
      ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf).flip.obj I).asEquivalence k f
  change P n ↔ P 0
  induction n using Int.induction_on with
  | zero => rfl
  | succ k ih => exact (step k).trans ih
  | pred k ih =>
    have h := step (-(k : ℤ) - 1)
    rw [sub_add_cancel] at h
    exact h.symm.trans ih

/-! ### The annihilator subsheaf as a kernel -/

/-- A section annihilated locally by a section of the ideal is annihilated by it: the two sides
of the equation are sections of a sheaf, so it is enough to check it on a cover. -/
private lemma smul_eq_zero_of_locally {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) {U : (Opens X)ᵒᵖ} (t : M.val.obj U) (a : I.val.obj U)
    (S : Sieve (unop U)) (hS : S ∈ Opens.grothendieckTopology X (unop U))
    (hloc : ∀ ⦃W : Opens X⦄ (h : W ⟶ unop U), S.arrows h →
      (M.val.obj (op W)).isModule.toSMul.smul
        (idealSection X ι (op W) ((I.val.map h.op).hom a)) ((M.val.map h.op).hom t) = 0) :
    (M.val.obj U).isModule.toSMul.smul (idealSection X ι U a) t = 0 := by
  have hM : Presieve.IsSheaf (Opens.grothendieckTopology X)
      (M.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (Presheaf.isSheaf_comp_of_isSheaf _ _ _ M.isSheaf)
  refine (hM S hS).isSeparatedFor.ext ?_
  intro W h hh
  change (M.val.map h.op).hom ((M.val.obj U).isModule.toSMul.smul
    (idealSection X ι U a) t) = (M.val.map h.op).hom 0
  have ha : idealSection X ι (op W) ((I.val.map h.op).hom a) =
      ((Oₓ).obj.map h.op).hom (idealSection X ι U a) :=
    congrArg (fun k => k.hom a) (ι.val.naturality h.op)
  -- The scalar lives in the stalk-calculus spelling of the structure sheaf while
  -- `PresheafOfModules.map_smul` is stated at the tensor-power spelling, so the two scalar
  -- actions agree only at `default` transparency and the chain is written as terms.
  exact ((M.val.map_smul h.op (idealSection X ι U a) t).trans
    ((congrArg (fun scalar => (M.val.obj (op W)).isModule.toSMul.smul scalar
      ((M.val.map h.op).hom t)) ha.symm).trans (hloc h hh))).trans
    (map_zero (M.val.map h.op).hom).symm

/-- The predicate cutting out the sections annihilated by the ideal: every restriction of the
section is annihilated by every local section of the ideal.  Restriction along the identity is
*not* among the conditions, which is what keeps the development free of the identification of
`M.val.map (𝟙 U)` with the identity; the annihilation of the section itself is recovered from
`smul_eq_zero_of_isAnnihilated` by a local-to-global step on the maximal cover. -/
private def IsAnnihilated {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) {U : (Opens X)ᵒᵖ} (s : M.val.obj U) : Prop :=
  ∀ (V : (Opens X)ᵒᵖ) (g : U ⟶ V) (a : I.val.obj V),
    (M.val.obj V).isModule.toSMul.smul (idealSection X ι V a) ((M.val.map g).hom s) = 0

/-- An annihilated section is itself annihilated by every local section of the ideal: the
maximal sieve on `U` is a cover, and on each of its members the assertion is one of the
conditions defining `IsAnnihilated`. -/
private lemma smul_eq_zero_of_isAnnihilated {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) {U : (Opens X)ᵒᵖ} {s : M.val.obj U}
    (hs : IsAnnihilated X ι M s) (a : I.val.obj U) :
    (M.val.obj U).isModule.toSMul.smul (idealSection X ι U a) s = 0 :=
  smul_eq_zero_of_locally X ι M s a ⊤
    ((Opens.grothendieckTopology X).top_mem (unop U))
    fun W h _ => hs (op W) h.op ((I.val.map h.op).hom a)

/-- The subsheaf of sections annihilated by the ideal, as a subsheaf of `M`. -/
private noncomputable def annihilatedSubsheaf {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) : M.Submodule := by
  let N : M.val.Submodule :=
    { obj := fun U =>
        { carrier := {s | IsAnnihilated X ι M s}
          zero_mem' := by
            intro V g a
            let scalar : (Oₓ).obj.obj V := idealSection X ι V a
            change scalar • ((M.val.map g).hom 0 : M.val.obj V) = 0
            rw [map_zero (M.val.map g).hom, smul_zero]
          add_mem' := by
            intro s t hs ht V g a
            let scalar : (Oₓ).obj.obj V := idealSection X ι V a
            change scalar • ((M.val.map g).hom (s + t) : M.val.obj V) = 0
            exact (congrArg (fun value : M.val.obj V => scalar • value)
              ((M.val.map g).hom.map_add s t)).trans
                ((smul_add scalar _ _).trans
                  ((congrArg₂ (· + ·) (hs V g a) (ht V g a)).trans (zero_add _)))
          smul_mem' := by
            intro r s hs V g a
            let scalar : (Oₓ).obj.obj V := idealSection X ι V a
            have annihilated : scalar • ((M.val.map g).hom s : M.val.obj V) = 0 := hs V g a
            change scalar • ((M.val.map g).hom (r • s) : M.val.obj V) = 0
            rw [M.val.map_smul g r s, smul_smul, mul_comm, ← smul_smul, annihilated, smul_zero] }
      map := by
        intro U V g s hs W h a
        rw [PresheafOfModules.restrictₛₗ_apply, ← M.val.map_comp_apply]
        exact hs W (g ≫ h) a }
  refine { toSubmodule := N, isSheaf := ?_ }
  intro U s hs V g a
  let t : M.val.obj V := M.val.map g s
  refine smul_eq_zero_of_locally X ι M t a
    ((N.toSubfunctor.sieveOfSection s).pullback g.unop)
    ((Opens.grothendieckTopology X).pullback_stable g.unop hs) ?_
  intro W h hh
  have hmem : M.val.map (g ≫ h.op) s ∈ N.obj (op W) := hh
  exact (congrArg (fun sectionValue => (M.val.obj (op W)).isModule.toSMul.smul
      (idealSection X ι (op W) ((I.val.map h.op).hom a)) sectionValue)
    (M.val.map_comp_apply g h.op s).symm).trans
    (smul_eq_zero_of_isAnnihilated X ι M hmem ((I.val.map h.op).hom a))

/-- Membership in the annihilator subsheaf, unfolded. -/
private lemma mem_annihilatedSubsheaf {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) {U : (Opens X)ᵒᵖ} {s : M.val.obj U} :
    s ∈ (annihilatedSubsheaf X ι M).obj U ↔ IsAnnihilated X ι M s :=
  Iff.rfl

/-- The first ideal-power annihilator subsheaf of Tag 0GT5 is the annihilator subsheaf. -/
private lemma annihilator_eq {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    idealPowerAnnihilatorSubsheaf X ι M 1 = annihilatedSubsheaf X ι M := by
  let lattice : CompleteLattice M.Submodule := SheafOfModules.Submodule.instCompleteLattice
  apply @le_antisymm _ lattice.toPartialOrder _ _
  · apply @sSup_le _ lattice.toCompleteSemilatticeSup _ _
    intro N hN U s hs
    refine (mem_annihilatedSubsheaf X ι M).mpr fun V g a => ?_
    have h := hN U s hs (unop V) (leOfHom g.unop) (fun _ => a)
    rw [show (homOfLE (leOfHom g.unop)).op = g from Subsingleton.elim _ _] at h
    change (M.val.obj V).isModule.toSMul.smul
      (∏ _ : Fin 1, idealSection X ι V a) ((M.val.map g).hom s) = 0 at h
    exact (congrArg (fun coefficient => (M.val.obj V).isModule.toSMul.smul
      coefficient ((M.val.map g).hom s))
        (Fin.prod_univ_one (fun _ => idealSection X ι V a))).symm.trans h
  · apply @le_sSup _ lattice.toCompleteSemilatticeSup
    intro U s hs V hVU a
    have h := ((mem_annihilatedSubsheaf X ι M).mp hs) (op V) (homOfLE hVU).op (a 0)
    change (M.val.obj (op V)).isModule.toSMul.smul
      (∏ index : Fin 1, idealSection X ι (op V) (a index))
        ((M.val.map (homOfLE hVU).op).hom s) = 0
    exact (congrArg (fun coefficient => (M.val.obj (op V)).isModule.toSMul.smul
      coefficient ((M.val.map (homOfLE hVU).op).hom s))
        (Fin.prod_univ_one (fun index => idealSection X ι (op V) (a index)))).trans h

/-- The inclusion of the annihilator subsheaf is killed by multiplication by the ideal. -/
private lemma idealMultiplication_annihilator {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    (M : SheafOfModules.{u} Oₓ) :
    idealMultiplication X ι (idealPowerAnnihilatorSubsheaf X ι M 1).toSheafOfModules ≫
      (idealPowerAnnihilatorSubsheaf X ι M 1).ι = 0 := by
  rw [annihilator_eq]
  exact (idealMultiplication_comp_zero_iff X ι (annihilatedSubsheaf X ι M).ι).mpr fun U a s =>
    smul_eq_zero_of_isAnnihilated X ι M ((mem_annihilatedSubsheaf X ι M).mp s.property) a

/-- The sections of a map killed by multiplication by the ideal land in the annihilator
subsheaf. -/
private lemma annihilatorLift_mem {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N)
    (hf : idealMultiplication X ι M ≫ f = 0) (U : (Opens X)ᵒᵖ) (s : M.val.obj U) :
    (f.val.app U).hom s ∈ (idealPowerAnnihilatorSubsheaf X ι N 1).toSubmodule.obj U := by
  rw [annihilator_eq X ι N]
  refine (mem_annihilatedSubsheaf X ι N).mpr fun V g a => ?_
  refine Eq.trans ?_ ((idealMultiplication_comp_zero_iff X ι f).mp hf V a (M.val.map g s))
  exact congrArg (fun sectionValue => (N.val.obj V).isModule.toSMul.smul
    (idealSection X ι V a) sectionValue)
    (PresheafOfModules.naturality_apply f.val g s).symm

/-- A map killed by multiplication by the ideal factors through the annihilator subsheaf. -/
private noncomputable def annihilatorLift {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N)
    (hf : idealMultiplication X ι M ≫ f = 0) :
    M ⟶ (idealPowerAnnihilatorSubsheaf X ι N 1).toSheafOfModules :=
  let annihilator : N.Submodule := idealPowerAnnihilatorSubsheaf X ι N 1
  ⟨{ app := fun U => ConcreteCategory.ofHom (C := ModuleCat ((Oₓ).obj.obj U))
        (X := M.val.obj U) (Y := annihilator.toSheafOfModules.val.obj U)
        ((f.val.app U).hom.codRestrict
        (annihilator.toSubmodule.obj U)
        (annihilatorLift_mem X ι f hf U))
     naturality := by
       intro U V g
       apply ModuleCat.hom_ext
       apply LinearMap.ext
       intro s
       apply Subtype.ext
       exact PresheafOfModules.naturality_apply f.val g s }⟩

/-- The factorization through the annihilator subsheaf recovers the original map. -/
private lemma annihilatorLift_ι {I : SheafOfModules.{u} Oₓ} (ι : I ⟶ 𝒪)
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N)
    (hf : idealMultiplication X ι M ≫ f = 0) :
    annihilatorLift X ι f hf ≫ (idealPowerAnnihilatorSubsheaf X ι N 1).ι = f := by
  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro U
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro s
  rfl

/-! ### The inclusion of ideal powers as multiplication by the ideal -/

/-- The ideal-power inclusion is the successor comparison followed by multiplication by the
ideal. -/
private lemma idealPowerIncl_eq_mul (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (n : ℤ) (M : SheafOfModules.{u} Oₓ) :
    idealPowerIncl X I ι n M =
      (idealPowerSuccNatIso X I n).inv.app M ≫
        idealMultiplication X ι (idealPowerTerm X I n M) := by
  -- What is left is the identity `𝟙 A ⊗ₘ ι = A ◁ ι` under sheafification, reassociated past
  -- the counit.  The composite `(A ◁ ι.val) ≫ (ρ_ A).hom` is type-correct only at `default`
  -- transparency, so the two steps are assembled as terms.
  have hA := ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map_comp
    ((idealPowerTerm X I n M).val ◁ ι.val) (ρ_ (idealPowerTerm X I n M).val).hom
  have hcounit := (congrArg (fun k => k ≫
      ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).counit.app
        (idealPowerTerm X I n M)) hA).trans
    ((Category.assoc _ _ _).trans
      (congrArg (fun k => ((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map k ≫
          (((PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).map
              (ρ_ (idealPowerTerm X I n M).val).hom ≫
            ((PresheafOfModules.sheafificationAdjunction.{u} (R := Oₓ) (𝟙 (Oₓ).obj))).counit.app
              (idealPowerTerm X I n M)))
        (id_tensorHom (idealPowerTerm X I n M).val ι.val).symm))
  refine congrArg ((idealPowerSuccNatIso X I n).inv.app M ≫ ·) ?_
  refine (congrArg (fun morphism => morphism ≫
    (tensorProductRightUnitor X.presheaf (Oₓ).property (idealPowerTerm X I n M)).hom)
    (Stacks.SheafOfModules.Tensor.sheafTensor_uncurry_map X.sheaf
      (𝟙 (idealPowerTerm X I n M)) ι)).trans ?_
  refine Eq.trans ?_ hcounit.symm
  apply congrArg (fun morphism => morphism ≫
    (tensorProductRightUnitor X.presheaf (Oₓ).property (idealPowerTerm X I n M)).hom)
  apply congrArg (PresheafOfModules.sheafification.{u} (R := Oₓ) (𝟙 (Oₓ).obj)).map
  apply PresheafOfModules.hom_ext
  intro siteObject
  apply ModuleCat.hom_ext
  apply TensorProduct.ext'
  intro leftSection rightSection
  rfl

/-- `I^{⊗ (n+1)} ⊗ f` composed with the inclusion of ideal powers is zero exactly when
multiplication by the ideal kills `f`. -/
private lemma idealPowerMap_comp_incl_zero_iff (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    {M N : SheafOfModules.{u} Oₓ} (f : M ⟶ N) (n : ℤ) :
    idealPowerMap X I (n + 1) f ≫ idealPowerIncl X I ι n N = 0 ↔
      idealMultiplication X ι M ≫ f = 0 := by
  have h : (idealPowerSuccNatIso X I n).hom.app M ≫
        idealPowerMap X I (n + 1) f ≫ idealPowerIncl X I ι n N =
      idealMultiplication X ι (idealPowerTerm X I n M) ≫ idealPowerMap X I n f := by
    rw [idealPowerIncl_eq_mul, ← Category.assoc, ← Category.assoc]
    rw [show (idealPowerSuccNatIso X I n).hom.app M ≫ idealPowerMap X I (n + 1) f =
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).flip.obj I).map
          (idealPowerMap X I n f) ≫
          (idealPowerSuccNatIso X I n).hom.app N from
      ((idealPowerSuccNatIso X I n).hom.naturality f).symm]
    simp only [Category.assoc]
    exact (congrArg (((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u}
        X.sheaf).flip.obj I).map (idealPowerMap X I n f) ≫ ·)
        ((idealPowerSuccNatIso X I n).hom_inv_id_app_assoc N
          (idealMultiplication X ι (idealPowerTerm X I n N)))).trans
        (idealMultiplication_natural X ι (idealPowerMap X I n f))
  have : IsIso ((idealPowerSuccNatIso X I n).hom.app M) :=
    ((idealPowerSuccNatIso X I n).app M).isIso_hom
  rw [← cancel_epi ((idealPowerSuccNatIso X I n).hom.app M), comp_zero, h]
  exact idealMultiplication_power_zero_iff X ι f n

/-- **The twisted torsion subsheaf is a kernel.**  The inclusion of the `I`-torsion subsheaf of
`M`, twisted by `I^{⊗ (n+1)}`, is killed by the inclusion of the next ideal power. -/
public theorem idealPowerAnnihilator_incl_zero (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (n : ℤ) :
    idealPowerMap X I (n + 1) (idealPowerAnnihilatorSubsheaf X ι M 1).ι ≫
      idealPowerIncl X I ι n M = 0 :=
  (idealPowerMap_comp_incl_zero_iff X I ι _ n).mpr (idealMultiplication_annihilator X ι M)

/-- **The twisted torsion subsheaf is the kernel of the ideal-power inclusion.**  The twisted
inclusion `I^{⊗ (n+1)} ⊗ M[I] ⟶ I^{⊗ (n+1)} ⊗ M` is a kernel of
`I^{⊗ (n+1)} ⊗ M ⟶ I^{⊗ n} ⊗ M`. -/
@[no_expose]
public noncomputable def idealPowerAnnihilatorIsKernel (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (M : SheafOfModules.{u} Oₓ) (n : ℤ) :
    IsLimit (KernelFork.ofι
      (idealPowerMap X I (n + 1) (idealPowerAnnihilatorSubsheaf X ι M 1).ι)
      (idealPowerAnnihilator_incl_zero X I ι M n)) := by
  let E : SheafOfModules.{u} Oₓ ≌ SheafOfModules.{u} Oₓ :=
    tensorPowerEquivalence X.presheaf (Oₓ).property I (n + 1)
  let annihilator : M.Submodule := idealPowerAnnihilatorSubsheaf X ι M 1
  have : Mono annihilator.ι := inferInstance
  have _hm : Mono (idealPowerMap X I (n + 1)
      (idealPowerAnnihilatorSubsheaf X ι M 1).ι) := E.functor.map_mono annihilator.ι
  refine KernelFork.IsLimit.ofι' _ _ ?_
  intro A a ha
  let a' : E.inverse.obj A ⟶ M := E.functor.preimage ((E.counitIso.app A).hom ≫ a)
  have he : E.functor.map a' = (E.counitIso.app A).hom ≫ a := E.functor.map_preimage _
  have ha' : idealMultiplication X ι (E.inverse.obj A) ≫ a' = 0 := by
    refine (idealPowerMap_comp_incl_zero_iff X I ι a' n).mp ?_
    change E.functor.map a' ≫ _ = 0
    rw [he, Category.assoc, ha, comp_zero]
  refine ⟨(E.counitIso.app A).inv ≫ E.functor.map (annihilatorLift X ι a' ha'), ?_⟩
  change ((E.counitIso.app A).inv ≫ E.functor.map (annihilatorLift X ι a' ha')) ≫
    E.functor.map _ = a
  exact (Category.assoc _ _ _).trans
    ((congrArg ((E.counitIso.app A).inv ≫ ·)
      ((E.functor.map_comp (annihilatorLift X ι a' ha') annihilator.ι).symm.trans
        ((congrArg E.functor.map (annihilatorLift_ι X ι a' ha')).trans he))).trans
          ((E.counitIso.app A).inv_hom_id_assoc a))

end Multiplication

/-! ## The cocycles of the décalage

In degree `n` a cocycle of `η_I F` is a section of `I^{⊗ n} ⊗ F^n` killed by the differential:
the defining condition of `(η_I F)^n` — that the differential land in the next ideal power — is
automatic for such a section, because `0` lies in every subsheaf.  So the cocycle sheaf of
`η_I F` in degree `n` is `I^{⊗ n} ⊗ Z^n(F)`. -/

section Cocycles

/-- The twisted differential kills the twisted inclusion of cocycles. -/
private lemma idealPowerMap_iCycles_d (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (n : ℤ) :
    idealPowerMap X I n (F.iCycles n) ≫ idealPowerMap X I n (F.d n (n + 1)) = 0 := by
  rw [← idealPowerMap_comp, HomologicalComplex.iCycles_d, idealPowerMap_zero]

/-- The twisted cocycles of `F` map to the degree-`n` décalage term: the twisted inclusion of
cocycles is a section of `I^{⊗ n} ⊗ F^n` whose differential is `0`, hence lies in the next ideal
power.  This is the map `g ⊗ s ↦ g s` of the source. -/
private noncomputable def etaCyclesTerm (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (n : ℤ) :
    idealPowerTerm X I n (F.cycles n) ⟶ etaTerm X I ι F n :=
  pullback.lift (idealPowerMap X I n (F.iCycles n)) 0 (by
    rw [idealPowerMap_iCycles_d]
    simp)

/-- On the first projection of the defining fibre product, `etaCyclesTerm` is the twisted
inclusion of cocycles. -/
private lemma etaCyclesTerm_fst (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (n : ℤ) :
    etaCyclesTerm X I ι F n ≫ pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1))) =
      idealPowerMap X I n (F.iCycles n) :=
  pullback.lift_fst _ _ _

/-- On the second projection of the defining fibre product, `etaCyclesTerm` is zero. -/
private lemma etaCyclesTerm_snd (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (n : ℤ) :
    etaCyclesTerm X I ι F n ≫ pullback.snd (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1))) = 0 :=
  pullback.lift_snd _ _ _

/-! The degree-`n` term of `η_I F` is a categorical fibre product, whose definition this module
may not unfold.  Consequently a composite that mixes `(η_I F).X n` with the projections of that
fibre product is type-correct only at `default` transparency, and no rewrite can act on it.  The
proofs below therefore do their rewriting in statements phrased purely through
`etaDifferentialData`, where every object is an `etaTerm`, and cross to `η_I F` either with
`simpa only [etaObj, CochainComplex.of_d]` or through chains of ground equations. -/

/-- The differential of `η_I F` is the one recorded by `etaDifferentialData`. -/
public lemma etaObj_d_eq (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaObj X I ι F hF).d n (n + 1) = (etaDifferentialData X I ι F hF).d n := by
  simp only [etaObj, CochainComplex.of_d]

/-- The differential of `etaDifferentialData` is zero on the second projection of the next
fibre product. -/
private lemma etaDifferentialData_d_snd (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaDifferentialData X I ι F hF).d n ≫
        pullback.snd (idealPowerMap X I (n + 1) (F.d (n + 1) (n + 1 + 1)))
          (idealPowerIncl X I ι (n + 1) (F.X (n + 1 + 1))) = 0 := by
  rw [← (etaDifferentialData X I ι F hF).d_fst (n + 1), ← Category.assoc,
    (etaDifferentialData X I ι F hF).d_comp_d n, zero_comp]

/-- The twisted cocycles of `F` land in the cocycles of `η_I F`. -/
private noncomputable def etaCyclesMap (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerTerm X I n (F.cycles n) ⟶ (etaObj X I ι F hF).cycles n := by
  have hq' : etaCyclesTerm X I ι F n ≫ (etaDifferentialData X I ι F hF).d n = 0 := by
    apply pullback.hom_ext
    · rw [Category.assoc, (etaDifferentialData X I ι F hF).d_fst n, etaCyclesTerm_snd,
        zero_comp]
    · rw [Category.assoc, etaDifferentialData_d_snd, comp_zero, zero_comp]
  have hq : etaCyclesTerm X I ι F n ≫ (etaObj X I ι F hF).d n (n + 1) = 0 :=
    (congrArg (fun k => etaCyclesTerm X I ι F n ≫ k) (etaObj_d_eq X I ι F hF n)).trans hq'
  exact HomologicalComplex.liftCycles (etaObj X I ι F hF)
    (etaCyclesTerm X I ι F n) (n + 1) (by simp) hq

/-- `etaCyclesMap`, followed by the inclusion of cocycles, is `etaCyclesTerm`. -/
private lemma etaCyclesMap_iCycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    etaCyclesMap X I ι F hF n ≫ (etaObj X I ι F hF).iCycles n = etaCyclesTerm X I ι F n := by
  unfold etaCyclesMap
  exact HomologicalComplex.liftCycles_i _ _ _ _ _

/-- `etaCyclesMap`, followed by the inclusion of cocycles and a map out of the degree-`n` term, is
`etaCyclesTerm` followed by that map. -/
private lemma etaCyclesMap_iCycles_comp (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) {B : SheafOfModules.{u} Oₓ} (p : etaTerm X I ι F n ⟶ B) :
    etaCyclesMap X I ι F hF n ≫ (etaObj X I ι F hF).iCycles n ≫ p = etaCyclesTerm X I ι F n ≫ p :=
  (Category.assoc _ _ _).symm.trans
    (congrArg (fun k => k ≫ p) (etaCyclesMap_iCycles X I ι F hF n))

/-- The twisted inclusion of cocycles exhibits `I^{⊗ n} ⊗ Z^n(F)` as a kernel of
`I^{⊗ n} ⊗ d^n`: twisting by an ideal power is an equivalence, hence preserves kernels. -/
private noncomputable def idealPowerCyclesIsKernel (I : SheafOfModules.{u} Oₓ)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (n : ℤ) :
    IsLimit (KernelFork.ofι (idealPowerMap X I n (F.iCycles n))
      (idealPowerMap_iCycles_d X I F n)) :=
  let E := (tensorPowerEquivalence X.presheaf (Oₓ).property I n).functor
  (isLimitMapConeForkEquiv' E (F.iCycles_d n (n + 1)))
    (isLimitOfPreserves E (F.cyclesIsKernel n (n + 1) (by simp)))

/-- A cocycle of `η_I F` has second component zero. -/
private lemma etaCycles_iCycles_snd (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaObj X I ι F hF).iCycles n ≫ pullback.snd (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1))) = 0 :=
  ((congrArg (fun k => (etaObj X I ι F hF).iCycles n ≫ k)
        (etaObj_d_fst X I ι F hF n).symm).trans
      (Category.assoc _ _ _).symm).trans
    ((congrArg (fun k => k ≫ pullback.fst
          (idealPowerMap X I (n + 1) (F.d (n + 1) (n + 1 + 1)))
          (idealPowerIncl X I ι (n + 1) (F.X (n + 1 + 1))))
        (HomologicalComplex.iCycles_d (etaObj X I ι F hF) n (n + 1))).trans zero_comp)

/-- The inclusion of the cocycles of `η_I F`, followed by the first projection of the defining
fibre product, is killed by the twisted differential. -/
private lemma etaCycles_fst_comp_d (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    ((etaObj X I ι F hF).iCycles n ≫
        pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1)))) ≫
      idealPowerMap X I n (F.d n (n + 1)) = 0 :=
  (Category.assoc _ _ _).trans
    ((congrArg (fun k => (etaObj X I ι F hF).iCycles n ≫ k) pullback.condition).trans
      ((Category.assoc _ _ _).symm.trans
        ((congrArg (fun k => k ≫ idealPowerIncl X I ι n (F.X (n + 1)))
            (etaCycles_iCycles_snd X I ι F hF n)).trans zero_comp)))

/-- **The cocycles of the décalage.**  In degree `n` the cocycle sheaf of `η_I F` is the ideal
power `I^{⊗ n}` applied to the cocycle sheaf of `F`. -/
@[no_expose]
public noncomputable def etaCyclesIso (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerTerm X I n (F.cycles n) ≅ (etaObj X I ι F hF).cycles n := by
  let v := (idealPowerCyclesIsKernel X I F n).lift
    (KernelFork.ofι ((etaObj X I ι F hF).iCycles n ≫
      pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
        (idealPowerIncl X I ι n (F.X (n + 1)))) (etaCycles_fst_comp_d X I ι F hF n))
  have hv : v ≫ idealPowerMap X I n (F.iCycles n) =
      (etaObj X I ι F hF).iCycles n ≫
        pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1))) :=
    (idealPowerCyclesIsKernel X I F n).fac _ WalkingParallelPair.zero
  refine ⟨etaCyclesMap X I ι F hF n, v, ?_, ?_⟩
  · have _hm : Mono (idealPowerMap X I n (F.iCycles n)) :=
      mono_of_isLimit_fork (idealPowerCyclesIsKernel X I F n)
    apply (cancel_mono (idealPowerMap X I n (F.iCycles n))).mp
    refine ((Category.assoc _ _ _).trans ?_).trans (Category.id_comp _).symm
    refine (congrArg (fun k => etaCyclesMap X I ι F hF n ≫ k) hv).trans ?_
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1)))) (etaCyclesMap_iCycles X I ι F hF n)).trans
        (etaCyclesTerm_fst X I ι F n))
  · apply (cancel_mono ((etaObj X I ι F hF).iCycles n)).mp
    have key : v ≫ etaCyclesTerm X I ι F n = (etaObj X I ι F hF).iCycles n := by
      apply pullback.hom_ext
      · exact ((Category.assoc _ _ _).trans
          (congrArg (fun k => v ≫ k) (etaCyclesTerm_fst X I ι F n))).trans hv
      · exact ((Category.assoc _ _ _).trans
          ((congrArg (fun k => v ≫ k) (etaCyclesTerm_snd X I ι F n)).trans comp_zero)).trans
          (etaCycles_iCycles_snd X I ι F hF n).symm
    exact ((Category.assoc _ _ _).trans
      ((congrArg (fun k => v ≫ k) (etaCyclesMap_iCycles X I ι F hF n)).trans key)).trans
      (Category.id_comp ((etaObj X I ι F hF).iCycles n)).symm

/-- The comparison of cocycle sheaves, followed by the inclusion of cocycles and the first
projection of the defining fibre product, is the twisted inclusion of cocycles.  This is the
assertion that the comparison sends `g ⊗ s` to `g s`. -/
public theorem etaCyclesIso_hom_fst (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaCyclesIso X I ι F hF n).hom ≫ (etaObj X I ι F hF).iCycles n ≫
        pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1))) =
      idealPowerMap X I n (F.iCycles n) :=
  (etaCyclesMap_iCycles_comp X I ι F hF n _).trans (etaCyclesTerm_fst X I ι F n)

/-- The comparison of cocycle sheaves, followed by the inclusion of cocycles and the second
projection of the defining fibre product, is zero. -/
public theorem etaCyclesIso_hom_snd (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaCyclesIso X I ι F hF n).hom ≫ (etaObj X I ι F hF).iCycles n ≫
        pullback.snd (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1))) = 0 :=
  (etaCyclesMap_iCycles_comp X I ι F hF n _).trans (etaCyclesTerm_snd X I ι F n)

end Cocycles

/-! ## The cohomology sheaves of the décalage

Under the comparison of cocycle sheaves, the coboundaries of `η_I F` in degree `n + 1` are the
image of `I^{⊗ n} ⊗ F^n`, that is of the *previous* ideal power applied to the cocycles — which
is the categorical form of "`f` times a cocycle is a coboundary".  So the kernel of the induced
map on cohomology is the kernel of the inclusion of ideal powers, namely the twisted
`I`-torsion. -/

section Homology

/-- The twisted module `I^{⊗ (n+1)} ⊗ F^n` maps to the degree-`n` décalage term: its image in
`I^{⊗ n} ⊗ F^n` is the inclusion of the next ideal power, and its differential already lies in
`I^{⊗ (n+1)} ⊗ F^{n+1}`. -/
private noncomputable def idealPowerToEta (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (n : ℤ) :
    idealPowerTerm X I (n + 1) (F.X n) ⟶ etaTerm X I ι F n :=
  pullback.lift (idealPowerIncl X I ι n (F.X n))
    (idealPowerMap X I (n + 1) (F.d n (n + 1)))
    (idealPowerIncl_natural X I ι n (F.d n (n + 1)))

/-- The comparison of cocycle sheaves carries the twisted coboundary map of `F` to the
coboundary map of `η_I F`, after the shift of ideal power recorded by `idealPowerToEta`. -/
private lemma idealPowerToCycles_etaCycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerMap X I (n + 1) (F.toCycles n (n + 1)) ≫ etaCyclesMap X I ι F hF (n + 1) =
      idealPowerToEta X I ι F n ≫ (etaObj X I ι F hF).toCycles n (n + 1) := by
  apply (cancel_mono ((etaObj X I ι F hF).iCycles (n + 1))).mp
  have hl : (idealPowerMap X I (n + 1) (F.toCycles n (n + 1)) ≫
        etaCyclesMap X I ι F hF (n + 1)) ≫ (etaObj X I ι F hF).iCycles (n + 1) =
      idealPowerMap X I (n + 1) (F.toCycles n (n + 1)) ≫ etaCyclesTerm X I ι F (n + 1) :=
    (Category.assoc _ _ _).trans
      (congrArg (fun k => idealPowerMap X I (n + 1) (F.toCycles n (n + 1)) ≫ k)
        (etaCyclesMap_iCycles X I ι F hF (n + 1)))
  have hr : (idealPowerToEta X I ι F n ≫ (etaObj X I ι F hF).toCycles n (n + 1)) ≫
        (etaObj X I ι F hF).iCycles (n + 1) =
      idealPowerToEta X I ι F n ≫ (etaObj X I ι F hF).d n (n + 1) :=
    (Category.assoc _ _ _).trans
      (congrArg (fun k => idealPowerToEta X I ι F n ≫ k)
        (HomologicalComplex.toCycles_i (etaObj X I ι F hF) n (n + 1)))
  refine hl.trans (Eq.trans ?_ hr.symm)
  have hd : idealPowerToEta X I ι F n ≫ (etaObj X I ι F hF).d n (n + 1) =
      idealPowerToEta X I ι F n ≫ (etaDifferentialData X I ι F hF).d n :=
    congrArg (fun k => idealPowerToEta X I ι F n ≫ k) (etaObj_d_eq X I ι F hF n)
  refine Eq.trans ?_ hd.symm
  apply pullback.hom_ext
  · simp only [Category.assoc]
    rw [(etaDifferentialData X I ι F hF).d_fst n, etaCyclesTerm_fst,
      show idealPowerToEta X I ι F n ≫ pullback.snd
          (idealPowerMap X I n (F.d n (n + 1))) (idealPowerIncl X I ι n (F.X (n + 1))) =
          idealPowerMap X I (n + 1) (F.d n (n + 1)) from pullback.lift_snd _ _ _,
      ← idealPowerMap_comp, HomologicalComplex.toCycles_i]
  · rw [Category.assoc, Category.assoc, etaCyclesTerm_snd, comp_zero,
      etaDifferentialData_d_snd, comp_zero]

/-- The twisted coboundary map of `F` is killed by the projection to the cohomology of
`η_I F`. -/
private lemma idealPowerToCycles_etaHomology (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerMap X I n (F.toCycles (n - 1) n) ≫
      etaCyclesMap X I ι F hF n ≫ (etaObj X I ι F hF).homologyπ n = 0 := by
  have hz (m : ℤ) : idealPowerMap X I (m + 1) (F.toCycles m (m + 1)) ≫
      etaCyclesMap X I ι F hF (m + 1) ≫ (etaObj X I ι F hF).homologyπ (m + 1) = 0 :=
    (Category.assoc _ _ _).symm.trans
      ((congrArg (fun k => k ≫ (etaObj X I ι F hF).homologyπ (m + 1))
          (idealPowerToCycles_etaCycles X I ι F hF m)).trans
        ((Category.assoc _ _ _).trans
          ((congrArg (fun k => idealPowerToEta X I ι F m ≫ k)
              (HomologicalComplex.toCycles_comp_homologyπ (etaObj X I ι F hF) m (m + 1))).trans
            comp_zero)))
  have h := hz (n - 1)
  rwa [sub_add_cancel] at h

/-- The map `I^{⊗ n} ⊗ H^n(F) ⟶ H^n(η_I F)` induced by the comparison of cocycle sheaves,
together with the equation characterizing it. -/
private noncomputable def etaHomologyMapLift (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    { f : idealPowerTerm X I n (F.homology n) ⟶ (etaObj X I ι F hF).homology n //
      idealPowerMap X I n (F.homologyπ n) ≫ f =
        etaCyclesMap X I ι F hF n ≫ (etaObj X I ι F hF).homologyπ n } :=
  let E := (tensorPowerEquivalence X.presheaf (Oₓ).property I n).functor
  let hc := (isColimitMapCoconeCoforkEquiv' E (F.toCycles_comp_homologyπ (n - 1) n))
    (isColimitOfPreserves E (F.homologyIsCokernel (n - 1) n (by simp)))
  CokernelCofork.IsColimit.desc' hc
    (etaCyclesMap X I ι F hF n ≫ (etaObj X I ι F hF).homologyπ n)
    (idealPowerToCycles_etaHomology X I ι F hF n)

/-- **The map on cohomology.**  The map `I^{⊗ n} ⊗ H^n(F) ⟶ H^n(η_I F)` of the source: on a
twisted cocycle `g ⊗ s` it is the class of the cocycle `g s` of `η_I F`. -/
@[no_expose]
public noncomputable def etaHomologyMap (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerTerm X I n (F.homology n) ⟶ (etaObj X I ι F hF).homology n :=
  (etaHomologyMapLift X I ι F hF n).1

/-- **The map on cohomology, on cocycles.**  Composed with the twisted projection to cohomology,
`etaHomologyMap` is the comparison of cocycle sheaves followed by the projection to the
cohomology of `η_I F`.  Together with `etaCyclesIso_hom_fst` this says that a twisted cocycle
`g ⊗ s` is sent to the class of `g s`. -/
public theorem etaHomologyMap_cycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    idealPowerMap X I n (F.homologyπ n) ≫ etaHomologyMap X I ι F hF n =
      (etaCyclesIso X I ι F hF n).hom ≫ (etaObj X I ι F hF).homologyπ n :=
  (etaHomologyMapLift X I ι F hF n).2

/-- The map on cohomology is an epimorphism: it factors the projection to the cohomology of
`η_I F` through an isomorphism of cocycle sheaves. -/
public lemma etaHomologyMap_epi (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    Epi (etaHomologyMap X I ι F hF n) :=
  epi_of_epi_fac (etaHomologyMap_cycles X I ι F hF n)

/-- The inverse comparison of cocycle sheaves, followed by the twisted inclusion of cocycles, is
the inclusion of the cocycles of `η_I F` into the ambient ideal power. -/
private lemma etaCyclesIso_inv_iCycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    (etaCyclesIso X I ι F hF n).inv ≫ idealPowerMap X I n (F.iCycles n) =
      (etaObj X I ι F hF).iCycles n ≫
        pullback.fst (idealPowerMap X I n (F.d n (n + 1)))
          (idealPowerIncl X I ι n (F.X (n + 1))) :=
  (Iso.inv_comp_eq _).mpr (etaCyclesIso_hom_fst X I ι F hF n).symm

/-- **The coboundaries of the décalage.**  Under the comparison of cocycle sheaves, a coboundary
of `η_I F` in degree `m + 1` lies in the image of the *previous* ideal power applied to the
cocycles of `F`. -/
private lemma etaBoundary_idealPowerIncl (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (m : ℤ) :
    (etaObj X I ι F hF).toCycles m (m + 1) ≫ (etaCyclesIso X I ι F hF (m + 1)).inv ≫
        idealPowerIncl X I ι m (F.cycles (m + 1)) =
      pullback.fst (idealPowerMap X I m (F.d m (m + 1)))
          (idealPowerIncl X I ι m (F.X (m + 1))) ≫
        idealPowerMap X I m (F.toCycles m (m + 1)) := by
  let powerEquivalence : SheafOfModules.{u} Oₓ ≌ SheafOfModules.{u} Oₓ :=
    tensorPowerEquivalence X.presheaf (Oₓ).property I m
  have cyclesIsMono : Mono (F.iCycles (m + 1)) := HomologicalComplex.instMonoICycles F (m + 1)
  have _hm : Mono (idealPowerMap X I m (F.iCycles (m + 1))) :=
    @Functor.map_mono _ _ _ _ powerEquivalence.functor inferInstance _ _ _ cyclesIsMono
  apply (cancel_mono (idealPowerMap X I m (F.iCycles (m + 1)))).mp
  have hR : (pullback.fst (idealPowerMap X I m (F.d m (m + 1)))
          (idealPowerIncl X I ι m (F.X (m + 1))) ≫
        idealPowerMap X I m (F.toCycles m (m + 1))) ≫
      idealPowerMap X I m (F.iCycles (m + 1)) =
      pullback.snd (idealPowerMap X I m (F.d m (m + 1)))
          (idealPowerIncl X I ι m (F.X (m + 1))) ≫
        idealPowerIncl X I ι m (F.X (m + 1)) := by
    rw [Category.assoc, ← idealPowerMap_comp, HomologicalComplex.toCycles_i,
      pullback.condition]
  have hinner : (etaObj X I ι F hF).toCycles m (m + 1) ≫
        ((etaObj X I ι F hF).iCycles (m + 1) ≫
          pullback.fst (idealPowerMap X I (m + 1) (F.d (m + 1) (m + 1 + 1)))
            (idealPowerIncl X I ι (m + 1) (F.X (m + 1 + 1)))) =
      pullback.snd (idealPowerMap X I m (F.d m (m + 1)))
        (idealPowerIncl X I ι m (F.X (m + 1))) :=
    ((Category.assoc _ _ _).symm.trans
        (congrArg (fun k => k ≫ pullback.fst
            (idealPowerMap X I (m + 1) (F.d (m + 1) (m + 1 + 1)))
            (idealPowerIncl X I ι (m + 1) (F.X (m + 1 + 1))))
          (HomologicalComplex.toCycles_i (etaObj X I ι F hF) m (m + 1)))).trans
      (etaObj_d_fst X I ι F hF m)
  refine Eq.trans ?_ hR.symm
  rw [Category.assoc, Category.assoc, idealPowerIncl_natural X I ι m (F.iCycles (m + 1)),
    ← Category.assoc ((etaCyclesIso X I ι F hF (m + 1)).inv),
    etaCyclesIso_inv_iCycles X I ι F hF (m + 1)]
  exact (Category.assoc _ _ _).symm.trans
    (congrArg (fun k => k ≫ idealPowerIncl X I ι m (F.X (m + 1))) hinner)

/-- A twisted cocycle `y` whose image under the inclusion of the next ideal power is the twisted
coboundary of `b` gives a point of the pullback defining the term of `η_I F` in degree `m`. -/
private lemma idealPowerMap_d_eq_of_toCycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ) (m : ℤ) {B : SheafOfModules.{u} Oₓ}
    (b : B ⟶ idealPowerTerm X I m (F.X m))
    (y : B ⟶ idealPowerTerm X I (m + 1) (F.cycles (m + 1)))
    (hb : y ≫ idealPowerIncl X I ι m (F.cycles (m + 1)) =
      b ≫ idealPowerMap X I m (F.toCycles m (m + 1))) :
    b ≫ idealPowerMap X I m (F.d m (m + 1)) =
      (y ≫ idealPowerMap X I (m + 1) (F.iCycles (m + 1))) ≫
        idealPowerIncl X I ι m (F.X (m + 1)) := by
  rw [Category.assoc, ← idealPowerIncl_natural, ← Category.assoc, hb, Category.assoc,
    ← idealPowerMap_comp, HomologicalComplex.toCycles_i]

/-- A twisted cocycle `q ≫ z` of `F` which is a coboundary after including the next ideal power
is, under the comparison of cocycle sheaves, a coboundary of `η_I F`. -/
private lemma exists_etaToCycles_eq_of_toCycles (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪)
    [Mono ι] [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n)) (m : ℤ) {A' B : SheafOfModules.{u} Oₓ}
    (z : A' ⟶ idealPowerTerm X I (m + 1) (F.cycles (m + 1))) (q : B ⟶ A')
    (b : B ⟶ idealPowerTerm X I m (F.X m))
    (hb : q ≫ z ≫ idealPowerIncl X I ι m (F.cycles (m + 1)) =
      b ≫ idealPowerMap X I m (F.toCycles m (m + 1))) :
    ∃ c : B ⟶ etaTerm X I ι F m,
      q ≫ z ≫ (etaCyclesIso X I ι F hF (m + 1)).hom =
        c ≫ (etaObj X I ι F hF).toCycles m (m + 1) := by
  let K : CochainComplex (SheafOfModules.{u} Oₓ) ℤ := etaObj X I ι F hF
  have hbt : b ≫ idealPowerMap X I m (F.d m (m + 1)) =
      (q ≫ z ≫ idealPowerMap X I (m + 1) (F.iCycles (m + 1))) ≫
        idealPowerIncl X I ι m (F.X (m + 1)) :=
    (idealPowerMap_d_eq_of_toCycles X I ι F m b (q ≫ z)
      ((Category.assoc _ _ _).trans hb)).trans
      (congrArg (· ≫ idealPowerIncl X I ι m (F.X (m + 1))) (Category.assoc _ _ _))
  let c : B ⟶ etaTerm X I ι F m :=
    pullback.lift b (q ≫ z ≫ idealPowerMap X I (m + 1) (F.iCycles (m + 1))) hbt
  refine ⟨c, ?_⟩
  apply (cancel_mono (K.iCycles (m + 1))).mp
  have hL : (q ≫ z ≫ (etaCyclesIso X I ι F hF (m + 1)).hom) ≫ K.iCycles (m + 1) =
      q ≫ z ≫ etaCyclesTerm X I ι F (m + 1) :=
    ((Category.assoc _ _ _).trans
      (congrArg (fun k => q ≫ k) (Category.assoc _ _ _))).trans
      (congrArg (fun k => q ≫ z ≫ k) (etaCyclesMap_iCycles X I ι F hF (m + 1)))
  have hR : (c ≫ K.toCycles m (m + 1)) ≫ K.iCycles (m + 1) =
      c ≫ (etaDifferentialData X I ι F hF).d m :=
    (Category.assoc _ _ _).trans
      ((congrArg (fun k => c ≫ k)
          (HomologicalComplex.toCycles_i K m (m + 1))).trans
        (congrArg (fun k => c ≫ k) (etaObj_d_eq X I ι F hF m)))
  refine hL.trans (Eq.trans ?_ hR.symm)
  apply pullback.hom_ext (C := SheafOfModules.{u} Oₓ)
    (f := idealPowerMap X I (m + 1) (F.d (m + 1) (m + 1 + 1)))
    (g := idealPowerIncl X I ι (m + 1) (F.X (m + 1 + 1)))
  · simp only [Category.assoc]
    rw [(etaDifferentialData X I ι F hF).d_fst m,
      show c ≫ pullback.snd (idealPowerMap X I m (F.d m (m + 1)))
          (idealPowerIncl X I ι m (F.X (m + 1))) =
        q ≫ z ≫ idealPowerMap X I (m + 1) (F.iCycles (m + 1)) from pullback.lift_snd _ _ _,
      etaCyclesTerm_fst]
  · simp only [Category.assoc]
    rw [etaCyclesTerm_snd, comp_zero, comp_zero, etaDifferentialData_d_snd, comp_zero]

/-- **The kernel of the map on cohomology.**  A map into `I^{⊗ (m+1)} ⊗ H^{m+1}(F)` is killed by
the map to the cohomology of `η_I F` exactly when it is killed by the inclusion of the next
ideal power — that is, exactly when it factors through the twisted `I`-torsion. -/
public theorem etaHomologyMap_comp_eq_zero_iff (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (m : ℤ)
    {A : SheafOfModules.{u} Oₓ}
    (a : A ⟶ idealPowerTerm X I (m + 1) (F.homology (m + 1))) :
    a ≫ etaHomologyMap X I ι F hF (m + 1) = 0 ↔
      a ≫ idealPowerIncl X I ι m (F.homology (m + 1)) = 0 := by
  let E : SheafOfModules.{u} Oₓ ⥤ SheafOfModules.{u} Oₓ :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I m).functor
  let E' : SheafOfModules.{u} Oₓ ⥤ SheafOfModules.{u} Oₓ :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I (m + 1)).functor
  have : E.IsEquivalence :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I m).isEquivalence_functor
  have : E'.IsEquivalence :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I (m + 1)).isEquivalence_functor
  let K : CochainComplex (SheafOfModules.{u} Oₓ) ℤ := etaObj X I ι F hF
  have homologyIsEpi : Epi (F.homologyπ (m + 1)) := HomologicalComplex.instEpiHomologyπ F (m + 1)
  have _he : Epi (idealPowerMap X I (m + 1) (F.homologyπ (m + 1))) :=
    @Functor.map_epi _ _ _ _ E' inferInstance _ _ _ homologyIsEpi
  obtain ⟨A', p, hp, z, hz⟩ := surjective_up_to_refinements_of_epi
    (idealPowerMap X I (m + 1) (F.homologyπ (m + 1))) a
  have hleft : p ≫ a ≫ etaHomologyMap X I ι F hF (m + 1) =
      (z ≫ (etaCyclesIso X I ι F hF (m + 1)).hom) ≫ K.homologyπ (m + 1) := by
    rw [← Category.assoc, hz, Category.assoc, etaHomologyMap_cycles, Category.assoc]
  have hright : p ≫ a ≫ idealPowerIncl X I ι m (F.homology (m + 1)) =
      (z ≫ idealPowerIncl X I ι m (F.cycles (m + 1))) ≫
        idealPowerMap X I m (F.homologyπ (m + 1)) := by
    rw [← Category.assoc, hz, Category.assoc, ← idealPowerIncl_natural, Category.assoc]
  rw [← cancel_epi p, comp_zero, hleft, ← cancel_epi p, comp_zero, hright]
  -- The two cokernel presentations are fed in as terms: `Cofork.π` of a `CokernelCofork.ofπ`
  -- is the projection only definitionally, so no rewrite can match on it.
  refine Iff.trans (CokernelCofork.IsColimit.comp_π_eq_zero_iff_up_to_refinements
    (K.homologyIsCokernel m (m + 1) (by simp)) _) ?_
  refine Iff.trans ?_ (CokernelCofork.IsColimit.comp_π_eq_zero_iff_up_to_refinements
    ((isColimitMapCoconeCoforkEquiv' E (F.toCycles_comp_homologyπ m (m + 1)))
      (isColimitOfPreserves E (F.homologyIsCokernel m (m + 1) (by simp)))) _).symm
  constructor
  · rintro ⟨B, q, hq, b, hb⟩
    refine ⟨B, q, hq, b ≫ pullback.fst (idealPowerMap X I m (F.d m (m + 1)))
      (idealPowerIncl X I ι m (F.X (m + 1))), ?_⟩
    have hb' : q ≫ z = b ≫ K.toCycles m (m + 1) ≫ (etaCyclesIso X I ι F hF (m + 1)).inv := by
      simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id] using
        congrArg (fun t => t ≫ (etaCyclesIso X I ι F hF (m + 1)).inv) hb
    exact (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ idealPowerIncl X I ι m (F.cycles (m + 1))) hb').trans
        ((Category.assoc _ _ _).trans
          ((congrArg (b ≫ ·) ((Category.assoc _ _ _).trans
            (etaBoundary_idealPowerIncl X I ι F hF m))).trans
              (Category.assoc _ _ _).symm)))
  · rintro ⟨B, q, hq, b, hb⟩
    obtain ⟨c, hc⟩ := exists_etaToCycles_eq_of_toCycles X I ι F hF m z q b hb
    exact ⟨B, q, hq, c, hc⟩

/-- **Stacks Project, Tag 0F8N** in degree `m + 1`, with the equation characterizing the
comparison.  The twisted torsion is the kernel of the map on cohomology, which is an
epimorphism, so the twisted quotient of cohomology by its torsion is its image. -/
private noncomputable def etaCohomologyIsoSuccLift (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (m : ℤ) :
    { e : idealPowerTerm X I (m + 1)
        (cokernel (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1).ι) ≅
        (etaObj X I ι F hF).homology (m + 1) //
      idealPowerMap X I (m + 1)
          (cokernel.π (idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1).ι) ≫ e.hom =
        etaHomologyMap X I ι F hF (m + 1) } := by
  let E : SheafOfModules.{u} Oₓ ⥤ SheafOfModules.{u} Oₓ :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I (m + 1)).functor
  have : E.IsEquivalence :=
    (tensorPowerEquivalence X.presheaf (Oₓ).property I (m + 1)).isEquivalence_functor
  let Ann : (F.homology (m + 1)).Submodule :=
    idealPowerAnnihilatorSubsheaf X ι (F.homology (m + 1)) 1
  let i := idealPowerMap X I (m + 1) Ann.ι
  let f := etaHomologyMap X I ι F hF (m + 1)
  have hc {B : SheafOfModules.{u} Oₓ} (b : B ⟶ idealPowerTerm X I (m + 1) (F.homology (m + 1))) :
      b ≫ f = 0 ↔ b ≫ idealPowerIncl X I ι m (F.homology (m + 1)) = 0 :=
    etaHomologyMap_comp_eq_zero_iff X I ι F hF m b
  have hi : i ≫ f = 0 :=
    (hc i).mpr (idealPowerAnnihilator_incl_zero X I ι (F.homology (m + 1)) m)
  have _hm : Mono i := E.map_mono _
  let hk : IsLimit (KernelFork.ofι i hi) := by
    refine KernelFork.IsLimit.ofι' _ _ ?_
    intro B b hb
    exact KernelFork.IsLimit.lift'
      (idealPowerAnnihilatorIsKernel X I ι (F.homology (m + 1)) m) b ((hc b).mp hb)
  let S := ShortComplex.mk i f hi
  have hS : S.Exact := S.exact_of_f_is_kernel hk
  have _hepi : Epi f := etaHomologyMap_epi X I ι F hF (m + 1)
  let h₁ := (isColimitMapCoconeCoforkEquiv' E (cokernel.condition Ann.ι))
    (isColimitOfPreserves E (cokernelIsCokernel Ann.ι))
  let h₂ := hS.gIsCokernel
  exact ⟨h₁.coconePointUniqueUpToIso h₂,
    h₁.comp_coconePointUniqueUpToIso_hom h₂ WalkingParallelPair.one⟩

/-- **Stacks Project, Tag 0F8N**, with the equation characterizing the comparison. -/
private noncomputable def etaCohomologyIsoLift (I : SheafOfModules.{u} Oₓ) (ι : I ⟶ 𝒪) [Mono ι]
    [Stacks.SheafOfModules.IsInvertible X.presheaf (Oₓ).property I]
    (F : CochainComplex (SheafOfModules.{u} Oₓ) ℤ)
    (hF : ∀ n : ℤ, IsIdealTorsionFree X ι (F.X n))
    (n : ℤ) :
    { e : idealPowerTerm X I n
        (cokernel (idealPowerAnnihilatorSubsheaf X ι (F.homology n) 1).ι) ≅
        (etaObj X I ι F hF).homology n //
