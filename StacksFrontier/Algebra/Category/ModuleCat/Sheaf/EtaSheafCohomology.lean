          (cokernel.π (idealPowerAnnihilatorSubsheaf X ι (F.homology n) 1).ι) ≫ e.hom =
        etaHomologyMap X I ι F hF n } := by
  have h := etaCohomologyIsoSuccLift X I ι F hF (n - 1)
  rw [sub_add_cancel] at h
  exact h

/-- **Stacks Project, Tag 0F8N.**  In Situation 0GT4, for a complex `F` of `I`-torsion-free
