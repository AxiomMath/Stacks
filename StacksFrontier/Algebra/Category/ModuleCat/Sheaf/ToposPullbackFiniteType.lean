-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace Stacks.Sheaves.LocalGeneration

universe v u v' u' w w'

/-- **If `M` is of finite type then the ℕ-indexed family of sheaves of locally spanning tuples
of `M` is jointly locally inhabited**: every object of the site is covered by objects over which
`M` is spanned, locally, by `r` sections for some `r`.

The number `r` of sections varies over the covering family supplied by
`SheafOfModules.LocalGeneratorsData`, which is why the conclusion is the joint statement for
the whole family rather than local surjectivity of one `generatingTupleSheaf M r` onto the
terminal sheaf; no coproduct over ℕ is formed. -/
theorem jointlyLocallyInhabited_generatingTupleSheaf
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} R) [M.IsFiniteType] :
    Stacks.Topos.JointlyLocallyInhabited J (fun r : ℕ => generatingTupleSheaf M r) := by
  obtain ⟨σ, hσ⟩ := _root_.SheafOfModules.IsFiniteType.exists_localGeneratorsData M
  intro U
  refine J.superset_covering ?_ (σ.coversTop U)
  rintro V g ⟨i, ⟨h⟩⟩
  have := (hσ.isFiniteType i).finite
  obtain ⟨r, ⟨e⟩⟩ := Finite.exists_equiv_fin (σ.generators i).I
  exact ⟨r, ⟨(generatingTupleSheaf M r).obj.map h.op
    ⟨fun j => ((σ.generators i).s (e.symm j)).val (Opposite.op (Over.mk (𝟙 (σ.X i)))),
      locallySpans_of_generatingSections_over M (σ.generators i) r e⟩⟩⟩

/-- **Extension of scalars preserves local generation by finitely many sections.**  Extension of
scalars is a left adjoint of restriction of scalars, so it carries a generating family to a
generating family indexed by an equivalent type, and it commutes with restriction to a slice
site.

This is the `Finite` index variant of
`Stacks.Sheaves.LocalGeneration.extendScalars_isLocallyGeneratedBy`, in which the number of
generators is a fixed natural number. -/
theorem extendScalars_exists_finite_generators
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {A₁ A₂ : Cᵒᵖ ⥤ CommRingCat.{w}} (θ : A₁ ⟶ A₂)
    (h₁ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₁))
    (h₂ : Presheaf.IsSheaf J (Stacks.PresheafOfModules.ChangeOfRings.ringPresheaf A₂))
    [HasWeakSheafify J AddCommGrpCat.{w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
    [∀ U : C, (J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : SheafOfModules.{w} (RingedToposModules.commRingSheaf J A₁ h₁))
    (hM : ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (SheafOfModules.over M V).GeneratingSections, σ.IsFiniteType) :
    ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (SheafOfModules.over
        ((RingedToposModules.extendScalars J θ h₁ h₂).obj M) V).GeneratingSections,
        σ.IsFiniteType := by
  intro U
  obtain ⟨T, hT⟩ := hM U
  refine ⟨T, ?_⟩
  intro V g hg
  obtain ⟨σ, hσ⟩ := hT V g hg
  have : Finite σ.I := hσ.finite
  obtain ⟨τ, ⟨d⟩⟩ := generatingSections_leftAdjoint_restrictScalars
    (RingedToposModules.commRingSheafMap (J.over V) (Functor.whiskerLeft (Over.forget V).op θ)
      ((RingedToposModules.commRingSheaf J A₁ h₁).over V).property
      ((RingedToposModules.commRingSheaf J A₂ h₂).over V).property)
    (RingedToposModules.extendRestrictScalarsAdjunction (J.over V)
      (Functor.whiskerLeft (Over.forget V).op θ)
      ((RingedToposModules.commRingSheaf J A₁ h₁).over V).property
      ((RingedToposModules.commRingSheaf J A₂ h₂).over V).property)
    (SheafOfModules.over M V) σ
  exact ⟨τ.equivOfIso (extendScalarsOverIso θ h₁ h₂ V M), ⟨Finite.of_equiv _ d.symm⟩⟩

end Stacks.Sheaves.LocalGeneration

namespace Stacks.SheafOfModules

universe v u w

/-- **The local criterion for finite type.**  A sheaf of modules that is generated by finitely
many global sections on each member of some covering of each object of the site is of finite
type.

This is the per-object form of
`Stacks.SheafOfModules.isFiniteType_iff_exists_cover_finite_generators`: the covering family it
is applied to is the family of *all* objects of the site over which the restriction of `M` has
finitely many generating sections. -/
theorem isFiniteType_of_locally_finite_generators
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}}
    [∀ V : C, HasWeakSheafify (J.over V) AddCommGrpCat.{w}]
    [∀ V : C, (J.over V).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (M : _root_.SheafOfModules.{w} R)
    (hM : ∀ U : C, ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : (M.over V).GeneratingSections, σ.IsFiniteType) :
    M.IsFiniteType := by
  rw [isFiniteType_iff_exists_cover_finite_generators]
  refine ⟨{V : C // ∃ σ : (M.over V).GeneratingSections, σ.IsFiniteType}, Subtype.val,
    ?_, fun i => i.2⟩
  intro U
  obtain ⟨T, hT⟩ := hM U
  exact J.superset_covering (fun Z g hg => ⟨⟨Z, hT Z g hg⟩, ⟨𝟙 Z⟩⟩) T.2

end Stacks.SheafOfModules

namespace Stacks.Sheaves.FiniteType

open Stacks.Sheaves.LocalGeneration Stacks.Topos

universe v u v' u' w w'

/-- **The inverse-image half of Stacks 03DO for the clause 03DL(5).**  If `M` is a sheaf of
`R`-modules of finite type on the target site, then every object `U` of the source site has a
covering on whose members the inverse image of `M` of Stacks 03D2 is generated by finitely many
global sections.

The covering is the one `Stacks.Topos.exists_cover_inverseImage_sections` produces for the
ℕ-indexed family of sheaves of locally spanning tuples of `M`, so no colimit over ℕ is formed;
see the module documentation. -/
theorem exists_cover_finite_generators_inverseImage
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {D : Type u'} [Category.{v'} D] {K : GrothendieckTopology D}
    [J.HasSheafCompose (forget RingCat.{w})]
    [K.HasSheafCompose (forget RingCat.{w'})]
    [J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [K.HasSheafCompose (forget AddCommGrpCat.{w'})]
    [∀ Z : C, HasWeakSheafify (J.over Z) AddCommGrpCat.{w}]
    [∀ Z : C, (J.over Z).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ Z : D, HasWeakSheafify (K.over Z) AddCommGrpCat.{w'}]
    [∀ Z : D, (K.over Z).WEqualsLocallyBijective AddCommGrpCat.{w'}]
    (f : MorphismOfTopoi (Sheaf J (Type w)) (Sheaf K (Type w')))
    (R : Sheaf K RingCat.{w'}) (P : ToposPullback.PullbackModuleData J K f R)
    (M : SheafOfModules.{w'} R) [M.IsFiniteType] (U : C) :
    ∃ T : J.Cover U, ∀ (V : C) (g : V ⟶ U), T g →
      ∃ σ : ((P.moduleFunctor.obj M).over V).GeneratingSections, σ.IsFiniteType := by
  obtain ⟨T, hT⟩ := exists_cover_inverseImage_sections f
    (fun r : ℕ => generatingTupleSheaf M r)
    (jointlyLocallyInhabited_generatingTupleSheaf M) U
  refine ⟨T, fun V g hg => ?_⟩
  obtain ⟨r, ⟨p⟩⟩ := hT V g hg
  obtain ⟨σ, ⟨e⟩⟩ := exists_generatingSections_over_of_locallySpans (P.moduleFunctor.obj M) _
    (pullback_generatingTuple_locallySpans f R P M r p)
  exact ⟨σ, ⟨Finite.of_equiv _ e.symm⟩⟩

/-- **Stacks 03DO for the clause 03DL(5): pullback preserves finite type.**  The pullback
`f^*F = O_C ⊗_{f⁻¹O_D} f⁻¹F` of Stacks 03D6(2) of a sheaf of `O_D`-modules of finite type along
a morphism of ringed topoi `(f, f♯) : (Sh(C), O_C) ⟶ (Sh(D), O_D)` is of finite type.

The two factors are `exists_cover_finite_generators_inverseImage`, which produces a covering of
each object of the source site carrying finitely many generating sections of `f⁻¹F`, and
`Stacks.Sheaves.LocalGeneration.extendScalars_exists_finite_generators`, which carries those
sections across extension of scalars along `f⁻¹O_D ⟶ O_C`; the result is assembled by
`Stacks.SheafOfModules.isFiniteType_of_locally_finite_generators`. -/
@[stacks 03DO "part (5), finite type: for an arbitrary morphism of ringed topoi"]
theorem pullbackModules_isFiniteType
    {X : AlgebraicGeometry.RingedTopos.{v, u, w}}
    {Y : AlgebraicGeometry.RingedTopos.{v', u', w}}
    [X.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
    [Y.J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
    [X.J.HasSheafCompose (forget RingCat.{w})]
    [Y.J.HasSheafCompose (forget RingCat.{w})]
    [X.J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [Y.J.HasSheafCompose (forget AddCommGrpCat.{w})]
    [HasWeakSheafify X.J AddCommGrpCat.{w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : X.C, HasWeakSheafify (X.J.over U) AddCommGrpCat.{w}]
    [∀ U : Y.C, HasWeakSheafify (Y.J.over U) AddCommGrpCat.{w}]
    [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : Y.C, (Y.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (f : Stacks.Sheaves.RingedToposModules.RingedToposHom X Y)
    (F : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))
    (hF : F.IsFiniteType) :
    ((f.pullbackModules).obj F).IsFiniteType := by
  have := hF
  have hP := exists_cover_finite_generators_inverseImage f.toToposHom
    (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)
    (ToposPullback.pullbackModule X.J Y.J f.toToposHom
      (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) F
  exact Stacks.SheafOfModules.isFiniteType_of_locally_finite_generators _
    (extendScalars_exists_finite_generators (RingedToposModules.fSharpCommRing f)
      (ToposPushforward.inverseImageRingSheaf f.toToposHom
        (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)).property
      (Stacks.SheafOfModules.Tensor.ringSheaf X.O).property _ hP)

end Stacks.Sheaves.FiniteType

end
