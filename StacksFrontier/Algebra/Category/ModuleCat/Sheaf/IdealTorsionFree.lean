module

public import Mathlib.Algebra.Category.Grp.EpiMono
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorStalkRingedSpace
public import StacksFrontier.Topology.Sheaves.Modules.LocallyFree
import StacksCore.Tactic.StacksAttribute

/-!
# Torsion freeness with respect to an invertible ideal sheaf

Let `(X, O_X)` be a ringed space and let `I ⟶ O_X` be an ideal sheaf which is locally generated
by a nonzerodivisor. For a sheaf of `O_X`-modules `F`, Stacks 0GT5 lists five equivalent ways of
saying that `F` has no `I`-torsion:

* the subsheaf `F[I]` of sections annihilated by `I` is zero;
* `F[I^n]` is zero for every `n ≥ 1`;
* the multiplication map `I ⊗ F ⟶ F` is injective;
* multiplication by every local generator of `I` is injective on sections;
* every stalk generator of `I` is a nonzerodivisor on the corresponding stalk of `F`.

## Main definitions

* `Stacks.IdealTorsion.idealPowerAnnihilatorSubsheaf`: the subsheaf of sections annihilated by
  a power of the ideal.
* `Stacks.IdealTorsion.IsIdealTorsionFree` and
  `Stacks.IdealTorsion.IsIdealPowerTorsionFree`: vanishing of that subsheaf for the first
  power, respectively for every positive power.
* `Stacks.IdealTorsion.GeneratesIdealOn`: a section of the ideal generates it on an open set.
* `Stacks.IdealTorsion.IsGeneratorRegularOn` and
  `Stacks.IdealTorsion.IsStalkwiseGeneratorRegular`: injectivity of multiplication by a local
  generator, respectively nonzerodivisibility of a stalk generator.
* `Stacks.IdealTorsion.idealTensorMultiplication`: the multiplication map `I ⊗ F ⟶ F`.

## Main results

* `Stacks.IdealTorsion.idealTorsionFree_tfae`: the five characterisations are equivalent.

## Implementation notes

An ideal sheaf is represented by a monomorphism `i : I ⟶ O_X`. The standing hypothesis of the
source — that `I` is locally generated by a nonzerodivisor — is represented by asking `I` to be
finite locally free of rank one (`AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank _ 1`)
with `i` a monomorphism; in particular `I` is then invertible, by Stacks 0B8M.

The annihilator subsheaves are genuine `SheafOfModules.Submodule`s of `F`: their sections over
`U` are the sections annihilated by all local products of sections of the ideal. Generation on
an open set means generation after restriction to every smaller open, and likewise injectivity
of multiplication is stated on all smaller opens; both are the local conditions the
equivalences actually use, and stating them only on `U` itself would not be stable under
restriction.

The tensor product of sheaves of modules is
`Stacks.SheafOfModules.Tensor.sheafTensor`, the sheafification of
the sectionwise tensor product, and the stalk of a tensor product is computed through
`Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso`.

## References

* [Stacks Project, Tag 0GT5](https://stacks.math.columbia.edu/tag/0GT5)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
  TopologicalSpace Opposite

universe u

namespace Stacks.IdealTorsion

variable (X : RingedSpace.{u})

local notation "Oₓ" => structureSheafRing X
local notation "𝒪" => SheafOfModules.unit Oₓ

/-- The ambient structure-sheaf section represented by a section of the ideal. -/
@[implicit_reducible]
public noncomputable def idealSection {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    (U : (Opens X)ᵒᵖ) (a : I.val.obj U) : (Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj U
      :=
  (i.val.app U).hom a

private lemma idealSection_smul {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    (U : (Opens X)ᵒᵖ) (r : (Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj U) (a : I.val.obj
      U) :
    idealSection X i U (r • a) = r • idealSection X i U a := by
  show (i.val.app U).hom (r • a) = r • (i.val.app U).hom a
  exact map_smul (i.val.app U).hom r a

/-- Restricting a section of the ideal and then viewing it in the structure sheaf agrees with
restricting its image in the structure sheaf. -/
public lemma idealSection_naturality {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    {U V : Opens X} (g : op U ⟶ op V) (a : I.val.obj (op U)) :
    idealSection X i (op V) ((I.val.map g).hom a) =
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map g).hom (idealSection X i (op U) a) :=
        by
  have hh := congrArg (fun q => q.hom a) (i.val.naturality g)
  dsimp [idealSection, ModuleCat.restrictScalars, ModuleCat.RestrictScalars.obj',
    ModuleCat.of] at hh ⊢
  exact hh

/-- Restricting a section of the ideal along `W ≤ U` and viewing it in the structure sheaf agrees
with restricting its restriction along `V ≤ U` further along `W ≤ V`. -/
private lemma idealSection_map_trans {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    {U V W : Opens X} (hWV : W ≤ V) (hVU : V ≤ U) (f : I.val.obj (op U)) :
    idealSection X i (op W) ((I.val.map (homOfLE (hWV.trans hVU)).op).hom f) =
      ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map (homOfLE hWV).op).hom
        (idealSection X i (op V) ((I.val.map (homOfLE hVU).op).hom f)) := by
  have hc := congrArg (fun q => q.hom (idealSection X i (op U) f))
    (congrArg (Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map
      (Subsingleton.elim (homOfLE (hWV.trans hVU)).op ((homOfLE hVU).op ≫ (homOfLE hWV).op)))
  rw [Functor.map_comp] at hc
  rw [idealSection_naturality, idealSection_naturality]
  simpa only [CategoryTheory.comp_apply] using hc

/-- The germ in the stalk of the structure sheaf of the ambient section of a restricted section of
the ideal is the germ of the ambient section of the unrestricted section. -/
private lemma ringGerm_idealSection_map {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    {U V : Opens X} (hVU : V ≤ U) (x : X) (hx : x ∈ V) (f : I.val.obj (op U)) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hx
        (idealSection X i (op V) ((I.val.map (homOfLE hVU).op).hom f)) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U (hVU hx)
        (idealSection X i (op U) f) := by
  dsimp [Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm]
  rw [idealSection_naturality X i (homOfLE hVU).op f]
  exact X.presheaf.germ_res_apply (homOfLE hVU) x hx _

/-- The actual subsheaf `F[I^n]` of sections annihilated by the `n`-th power
of the ideal. Products of local sections generate the sheaf-theoretic power.
We take the largest submodule subsheaf satisfying the annihilation condition. -/
@[sga "7 VIII 2.1.14" "n = 1"]
public noncomputable def idealPowerAnnihilatorSubsheaf
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (n : ℕ) : F.Submodule := by
  letI : CompleteLattice F.Submodule :=
    SheafOfModules.Submodule.instCompleteLattice
  exact sSup { N | ∀ (U : (Opens X)ᵒᵖ) (s : F.val.obj U),
    s ∈ N.toSubmodule.obj U →
      ∀ (V : Opens X) (hVU : V ≤ unop U) (a : Fin n → I.val.obj (op V)),
        (∏ k, idealSection X i (op V) (a k)) •
          (F.val.map (homOfLE hVU).op).hom s = 0 }

/-- The annihilator subsheaf `F[I]` is zero. -/
public def IsIdealTorsionFree
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) : Prop :=
  idealPowerAnnihilatorSubsheaf X i F 1 = ⊥

/-- All positive ideal-power annihilator subsheaves `F[I^n]` are zero. -/
public def IsIdealPowerTorsionFree
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) : Prop :=
  ∀ n : ℕ, 1 ≤ n → idealPowerAnnihilatorSubsheaf X i F n = ⊥

/-- A section `f` of `I` over `U` generates the restriction of `I` to `U`.
The quantification over all `V ⊆ U` is the sheafwise, rather than merely
sectionwise-on-`U`, assertion. -/
public def GeneratesIdealOn
    {I : SheafOfModules.{u} Oₓ} (U : Opens X) (f : I.val.obj (op U)) : Prop :=
  ∀ (V : Opens X) (hVU : V ≤ U) (a : I.val.obj (op V)),
    ∃ r : X.presheaf.obj (op V),
      a = r • (I.val.map (homOfLE hVU).op).hom f

/-- Multiplication by the image of `f : I(U)` is injective on the restriction
`F|_U`. -/
public def IsGeneratorRegularOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    (F : SheafOfModules.{u} Oₓ) (U : Opens X) (f : I.val.obj (op U)) : Prop :=
  ∀ (V : Opens X) (hVU : V ≤ U), Function.Injective fun s : F.val.obj (op V) ↦
    idealSection X i (op V) ((I.val.map (homOfLE hVU).op).hom f) • s

/-- The elements of the stalk ideal `I_x ⊆ O_{X,x}`. -/
public noncomputable def stalkIdeal
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (x : X) :
    Set (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x) :=
  {a | ∃ (U : Opens X) (hxU : x ∈ U) (s : I.val.obj (op U)),
    Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU (idealSection X i (op U) s) = a}

/-- An element of `O_{X,x}` generates the stalk ideal `I_x`. -/
public def GeneratesStalkIdeal
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (x : X)
    (f : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x) : Prop :=
  f ∈ stalkIdeal X i x ∧
    ∀ a ∈ stalkIdeal X i x, ∃ r : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x, a = r
      * f

/-- Every generator of `I_x` is a nonzerodivisor on `F_x`. -/
public def IsStalkwiseGeneratorRegular
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) : Prop :=
  ∀ (x : X) (f : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x), GeneratesStalkIdeal X
    i x f →
    Function.Injective fun s : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x ↦ f •
      s

private noncomputable def tensorUnitIso (F : SheafOfModules.{u} Oₓ) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (𝒪)).obj (F)) ≅ F := by
  letI : MonoidalCategory (PresheafOfModules.{u} (Stacks.SheafOfModules.TensorStalkRingedSpace.O X))
    :=
    PresheafOfModules.monoidalCategory
  let e : (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (𝒪)).obj (F)) ≅ F := by
    change (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyFunctor X).obj
      ((SheafOfModules.unit Oₓ).val ⊗ F.val) ≅ F
    letI : IsIso
        (PresheafOfModules.sheafificationAdjunction (𝟙 (Oₓ).obj)).counit := by
      infer_instance
    exact (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyFunctor X).mapIso (λ_ F.val) ≪≫
      (asIso (PresheafOfModules.sheafificationAdjunction (𝟙 (Oₓ).obj)).counit).app F
  exact e

/-- The canonical multiplication map `I ⊗ F ⟶ F`. -/
public noncomputable def idealTensorMultiplication
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) :
    (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (I)).obj (F)) ⟶ F := by
  letI : MonoidalCategory (PresheafOfModules.{u} (Stacks.SheafOfModules.TensorStalkRingedSpace.O X))
    :=
    PresheafOfModules.monoidalCategory
  let e : ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj 𝒪).obj F ≅ F := by
    change (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyFunctor X).obj
      ((SheafOfModules.unit Oₓ).val ⊗ F.val) ≅ F
    letI : IsIso (PresheafOfModules.sheafificationAdjunction (𝟙 (Oₓ).obj)).counit :=
      inferInstance
    exact (Stacks.SheafOfModules.TensorStalkRingedSpace.sheafifyFunctor X).mapIso (λ_ F.val) ≪≫
      (asIso (PresheafOfModules.sheafificationAdjunction (𝟙 (Oₓ).obj)).counit).app F
  exact (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).map (X := I) (Y := 𝒪) i).app F ≫
        ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj 𝒪).map (X := F) (Y := F) (𝟙 F)) ≫ e.hom

private lemma stalkMapL_comp
    (F G H : SheafOfModules.{u} Oₓ) (f : F ⟶ G) (g : G ⟶ H) (x : X) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val H.val (f ≫ g).val x =
      (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X G.val H.val g.val x).comp
        (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val G.val f.val x) := by
  ext m
  show ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((PresheafOfModules.toPresheaf (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map
        (f.val ≫ g.val))).hom m =
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
      ((PresheafOfModules.toPresheaf (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map
        g.val)).hom
      (((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map
        ((PresheafOfModules.toPresheaf (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map
          f.val)).hom m)
  simp only [Functor.map_comp]
  rfl

private lemma idealTensorMultiplication_stalk_factor
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (x : X) :
    (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
      ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (I)).obj (F))).val F.val
      (idealTensorMultiplication X i F).val x).comp
        (@LinearEquiv.toLinearMap _ _ _ _ _ _ _ _ _ _ _ _ _
          (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X
            (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
              ⟨X.presheaf, X.IsSheaf⟩).obj I).obj F).val x)
          (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x I F).symm) =
      (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
        ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (𝒪)).obj (F))).val F.val
        (tensorUnitIso X F).hom.val x).comp
        ((@LinearEquiv.toLinearMap _ _ _ _ _ _ _ _ _ _ _ _ _
          (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule X
            (((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
              ⟨X.presheaf, X.IsSheaf⟩).obj 𝒪).obj F).val x)
          (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x 𝒪 F).symm).comp
          (TensorProduct.map
            (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit
              Oₓ).val i.val x)
            (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val F.val (𝟙 F.val) x))) :=
              by
  have hnat := Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso_natural X x I F 𝒪 F i (𝟙
    F)
  refine LinearMap.ext fun z => ?_
  let T := Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} ⟨X.presheaf, X.IsSheaf⟩
  let TI := Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x I F
  let TO := Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x 𝒪 F
  let qT := TensorProduct.map
    (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit
      Oₓ).val i.val x)
    (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val F.val (𝟙 F.val) x)
  let eX := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X ((T.obj 𝒪).obj F).val F.val
    (tensorUnitIso X F).hom.val x
  let φ := (T.map (X := I) (Y := 𝒪) i).app F ≫ (T.obj 𝒪).map (X := F) (Y := F) (𝟙 F)
  let M := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X ((T.obj I).obj F).val
    ((T.obj 𝒪).obj F).val φ.val x
  have composition := stalkMapL_comp X ((T.obj I).obj F) ((T.obj 𝒪).obj F) F φ
    (tensorUnitIso X F).hom x
  have hz' : qT z = TO (M (TI.symm z)) :=
    (congrArg qT (TI.apply_symm_apply z)).symm.trans (congrArg (fun f => f (TI.symm z)) hnat)
  have hz'' : TO.symm (qT z) = M (TI.symm z) :=
    (congrArg TO.symm hz').trans (TO.symm_apply_apply _)
  show (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X ((T.obj I).obj F).val F.val
      (idealTensorMultiplication X i F).val x) (TI.symm z) = eX (TO.symm (qT z))
  exact (congrArg (fun morphism => morphism (TI.symm z)) composition).trans
    (congrArg eX hz''.symm)

/-- The stalk map of a monomorphism of sheaves of modules is injective. -/
protected lemma stalkMapL_injective_of_mono
    {F G : SheafOfModules.{u} Oₓ} (f : F ⟶ G) [Mono f] (x : X) :
    Function.Injective (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val G.val f.val
      x) := by
  let T := SheafOfModules.toSheaf Oₓ
  show Function.Injective
    ((TopCat.Presheaf.stalkFunctor AddCommGrpCat.{u} x).map (T.map f).1).hom
  exact (AddCommGrpCat.mono_iff_injective _).mp
    ((TopCat.Presheaf.mono_iff_stalk_mono (T.map f)).mp (Functor.map_mono T f) x)

/-- Every submodule subsheaf whose sections are killed, after any restriction, by all `n`-fold
products of sections of the ideal lies in `idealPowerAnnihilatorSubsheaf`. -/
public lemma le_idealPowerAnnihilatorSubsheaf
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (n : ℕ) (N : F.Submodule)
    (hN : ∀ (U : (Opens X)ᵒᵖ) (s : F.val.obj U), s ∈ N.toSubmodule.obj U →
      ∀ (V : Opens X) (hVU : V ≤ unop U) (a : Fin n → I.val.obj (op V)),
        (∏ k, idealSection X i (op V) (a k)) •
          (F.val.map (homOfLE hVU).op).hom s = 0) :
    N ≤ idealPowerAnnihilatorSubsheaf X i F n :=
  le_sSup hN

private lemma idealPowerAnnihilatorSubsheaf_le
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (n : ℕ) (N : F.Submodule)
    (hN : ∀ N' : F.Submodule,
      (∀ (U : (Opens X)ᵒᵖ) (s : F.val.obj U), s ∈ N'.toSubmodule.obj U →
        ∀ (V : Opens X) (hVU : V ≤ unop U) (a : Fin n → I.val.obj (op V)),
          (∏ k, idealSection X i (op V) (a k)) •
            (F.val.map (homOfLE hVU).op).hom s = 0) → N' ≤ N) :
    idealPowerAnnihilatorSubsheaf X i F n ≤ N :=
  sSup_le hN

/-- The subsheaf of sections of `F` killed, after any restriction, by every section of the
ideal. -/
public noncomputable def idealAnnihilatedSubsheaf
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) :
    F.Submodule := by
  let N : F.val.Submodule :=
    { obj := fun U =>
        { carrier := {s | ∀ (V : Opens X) (hVU : V ≤ unop U) (a : I.val.obj (op V)),
            idealSection X i (op V) a •
              (F.val.map (homOfLE hVU).op).hom s = 0}
          zero_mem' := by
            intro V hVU a
            simp only [map_zero, smul_zero]
          add_mem' := by
            intro s t hs ht V hVU a
            rw [map_add, smul_add, hs V hVU a, ht V hVU a, add_zero]
          smul_mem' := by
            intro r s hs V hVU a
            change idealSection X i (op V) a •
              F.val.restrictₛₗ (homOfLE hVU).op (r • s) = 0
            rw [(F.val.restrictₛₗ (homOfLE hVU).op).map_smulₛₗ]
            have hs' := hs V hVU a
            change idealSection X i (op V) a •
              F.val.restrictₛₗ (homOfLE hVU).op s = 0 at hs'
            change idealSection X i (op V) a •
              (((structureSheafRing X).obj.map
                (homOfLE hVU).op).hom r •
                F.val.restrictₛₗ (homOfLE hVU).op s) = 0
            rw [smul_comm, hs', smul_zero] }
      map := by
        intro U V f s hs W g a
        have hVU : unop V ≤ unop U := leOfHom f.unop
        have hWU : W ≤ unop U := le_trans g hVU
        have h := hs W hWU a
        have hcomp : (homOfLE hWU).op = f ≫ (homOfLE g).op := Subsingleton.elim _ _
        have hmap : (F.val.presheaf.map (homOfLE hWU).op).hom s =
            (F.val.presheaf.map (homOfLE g).op).hom
              ((F.val.presheaf.map f).hom s) := by
          rw [hcomp, Functor.map_comp]
          rfl
        change idealSection X i (op W) a •
          (F.val.presheaf.map (homOfLE g).op).hom
            ((F.val.presheaf.map f).hom s) = 0
        rw [← hmap]
        exact h }
  refine { toSubmodule := N, isSheaf := ?_ }
  intro U s hs V f a
  change idealSection X i (op V) a •
    F.val.restrictₛₗ (homOfLE f).op s = 0
  let S := N.toSubfunctor.sieveOfSection s
  have hF : Presieve.IsSheaf (Opens.grothendieckTopology X)
      (F.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (Presheaf.isSheaf_comp_of_isSheaf _ _ _ (SheafOfModules.isSheaf F))
  have hsep := (hF (S.pullback (homOfLE f))
    ((Opens.grothendieckTopology X).pullback_stable (homOfLE f) hs)).isSeparatedFor
  let t₁ : (F.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat).obj (op V) :=
    idealSection X i (op V) a • F.val.restrictₛₗ (homOfLE f).op s
  let t₂ : (F.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat).obj (op V) := 0
  have hzero : t₁ = t₂ := by
    refine hsep.ext (t₁ := t₁) (t₂ := t₂) ?_
    intro W g hg
    change F.val.restrictₛₗ g.op (idealSection X i (op V) a •
      F.val.restrictₛₗ (homOfLE f).op s) =
      F.val.restrictₛₗ g.op 0
    rw [map_zero, (F.val.restrictₛₗ g.op).map_smulₛₗ]
    change ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map g.op).hom (idealSection X i (op
      V) a) •
      F.val.map g.op ((F.val.map (homOfLE f).op).hom s) = 0
    have hmem : F.val.map g.op ((F.val.map (homOfLE f).op).hom s) ∈ N.obj (op W) := by
      change (F.val.presheaf.map g.op).hom
        ((F.val.presheaf.map (homOfLE f).op).hom s) ∈ N.toSubfunctor.obj (op W)
      have hg' : (F.val.presheaf.map ((g ≫ homOfLE f).op)).hom s ∈
          N.toSubfunctor.obj (op W) := by
        convert hg using 1
        rfl
      have hcomp : (g ≫ homOfLE f).op = (homOfLE f).op ≫ g.op := Subsingleton.elim _ _
      rw [hcomp, Functor.map_comp] at hg'
      exact hg'
    have hz := hmem W le_rfl ((I.val.map g.op).hom a)
    have hia : idealSection X i (op W) ((I.val.map g.op).hom a) =
        ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map g.op).hom (idealSection X i (op V)
          a) := idealSection_naturality X i g.op a
    rw [hia] at hz
    let sW : F.val.obj (op W) :=
      (F.val.map g.op).hom ((F.val.map (homOfLE f).op).hom s)
    let fId := (X.presheaf.map (𝟙 (op W))).hom
    have hfId : fId = RingHom.id _ := by simp [fId]
    let eF := ModuleCat.restrictScalarsId'App fId hfId (F.val.obj (op W))
    have hkill₀ :
        ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map g.op).hom (idealSection X i (op V)
          a) •
          eF.inv sW = 0 := by
      have hid : (homOfLE (le_rfl : W ≤ W)).op = 𝟙 (op W) := Subsingleton.elim _ _
      rw [hid] at hz
      simp only [eF, sW, fId, hfId, PresheafOfModules.map_id,
        ModuleCat.restrictScalarsId'_inv_app, ModuleCat.restrictScalars.smul_def] at hz ⊢
      with_unfolding_all exact hz
    have hkill₁ := congrArg eF.hom hkill₀
    rw [map_zero, map_smul] at hkill₁
    have eF_hom_id
        (z : (ModuleCat.restrictScalars fId).obj (F.val.obj (op W))) :
        eF.hom z = z := rfl
    rw [eF_hom_id] at hkill₁
    have eF_inv_id (z : F.val.obj (op W)) : eF.inv z = z := rfl
    rw [eF_inv_id] at hkill₁
    convert hkill₁ using 1 <;> rfl
  exact hzero

/-- The sections killed by the ideal lie in the annihilator subsheaf `F[I]` of the first power
of the ideal. -/
public lemma idealAnnihilatedSubsheaf_le_sup
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) :
    idealAnnihilatedSubsheaf X i F ≤ idealPowerAnnihilatorSubsheaf X i F 1 := by
  apply le_idealPowerAnnihilatorSubsheaf
  intro U s hs V hVU a
  dsimp [idealAnnihilatedSubsheaf] at hs
  change ∀ (W : Opens X) (hWV : W ≤ unop U) (b : I.val.obj (op W)),
      idealSection X i (op W) b •
        (F.val.map (homOfLE hWV).op).hom s = 0 at hs
  simpa [Fin.prod_univ_succ] using hs V hVU (a 0)

/-- The zero submodule of `F`, as a submodule subsheaf. -/
public noncomputable def zeroSubsheaf (F : SheafOfModules.{u} Oₓ) : F.Submodule := by
  refine { toSubmodule := ⊥, isSheaf := ?_ }
  intro U s hs
  let S := (⊥ : F.val.Submodule).toSubfunctor.sieveOfSection s
  have hF : Presieve.IsSheaf (Opens.grothendieckTopology X)
      (F.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      (Presheaf.isSheaf_comp_of_isSheaf _ _ _ (SheafOfModules.isSheaf F))
  have hsep := (hF S hs).isSeparatedFor
  let s' : (F.val.presheaf ⋙ CategoryTheory.forget AddCommGrpCat).obj U := s
  have hz : s' = 0 := by
    refine hsep.ext (t₁ := s') (t₂ := 0) ?_
    intro V f hf
    have hmem : (F.val.presheaf.map f.op).hom s ∈ (⊥ : F.val.Submodule).obj (op V) := by
      convert hf using 1
      rfl
    have hzero : (F.val.presheaf.map f.op).hom s = 0 := (Submodule.mem_bot _).mp hmem
    change (F.val.presheaf.map f.op).hom s = (F.val.presheaf.map f.op).hom 0
    simpa only [map_zero] using hzero
  exact (Submodule.mem_bot _).mpr hz

private lemma exists_ideal_trivialization_near
    {I : SheafOfModules.{u} Oₓ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1]
    (x : X) :
    ∃ (U : Opens X), x ∈ U ∧
      Nonempty (I.over U ≅ SheafOfModules.unit ((Oₓ).over U)) := by
  have hI : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1 := inferInstance
  obtain ⟨q, hq, hrank⟩ := hI.exists_isFiniteLocallyFreeOfRankData
  have hxcover : x ∈ ⨆ j, q.X j := by
    have hc := (Opens.coversTop_iff X q.X).mp q.coversTop
    rw [hc]
    trivial
  rw [TopologicalSpace.Opens.mem_iSup] at hxcover
  obtain ⟨j, hxj⟩ := hxcover
  let U := q.X j
  let _ : IsIso (q.generators j).π := hq.isIso j
  let eIndex : (q.generators j).I ≃ PUnit.{u + 1} :=
    (hrank j).some.trans (Equiv.equivPUnit _)
  let eFree := (SheafOfModules.freeFunctor (R := (Oₓ).over U)).mapIso eIndex.toIso
  let eUnit : SheafOfModules.free (R := (Oₓ).over U) PUnit ≅
      SheafOfModules.unit ((Oₓ).over U) :=
    Limits.coproductUniqueIso (fun _ : PUnit => SheafOfModules.unit ((Oₓ).over U))
  let eU : I.over U ≅ SheafOfModules.unit ((Oₓ).over U) :=
    (asIso (q.generators j).π).symm ≪≫ eFree ≪≫ eUnit
  exact ⟨U, hxj, ⟨eU⟩⟩

private noncomputable def idealBasisSection {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      : Opens X)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U)) :
    I.val.obj (op U) :=
  (e.inv.val.app (op (Over.mk (𝟙 U)))).hom
    (show ↑(((structureSheafRing X).over U).obj.obj
      (op (Over.mk (𝟙 U)))) from 1)

private lemma idealBasisSection_res {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      V : Opens X)
    (hVU : V ≤ U)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U)) :
    (I.val.map (homOfLE hVU).op).hom (idealBasisSection U e) =
      (e.inv.val.app (op (Over.mk (homOfLE hVU)))).hom
        (((SheafOfModules.unit ((structureSheafRing
          X).over U)).val.map
          (Over.homMk (homOfLE hVU)).op).hom
          (show ↑(((structureSheafRing X).over
            U).obj.obj
            (op (Over.mk (𝟙 U)))) from 1)) := by
  let v : Over U := Over.mk (homOfLE hVU)
  let top : Over U := Over.mk (𝟙 U)
  let f : v ⟶ top := Over.homMk (homOfLE hVU)
  have hnat := e.inv.val.naturality f.op
  have hsec := congrArg (fun g => g.hom
    (show ↑((SheafOfModules.unit ((structureSheafRing
      X).over U)).val.obj
      (op top)) from
      (1 : ↑(((structureSheafRing X).over U).obj.obj
        (op top))))) hnat
  rw [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_comp, LinearMap.comp_apply] at hsec
  show ((I.over U).val.map f.op).hom
      ((e.inv.val.app (op top)).hom
        (show ↑((SheafOfModules.unit
          ((structureSheafRing X).over U)).val.obj
          (op top)) from
          (1 : ↑(((structureSheafRing X).over
            U).obj.obj (op top))))) = _
  exact hsec.symm

private lemma unitOverMapOne {X : RingedSpace.{u}} (U V : Opens X) (hVU : V ≤ U) :
    (((SheafOfModules.unit ((structureSheafRing X).over
      U)).val.map
      (Over.homMk (homOfLE hVU)).op).hom
      (show ↑((SheafOfModules.unit ((structureSheafRing
        X).over U)).val.obj
        (op (Over.mk (𝟙 U)))) from
        (1 : ↑(((structureSheafRing X).over U).obj.obj
          (op (Over.mk (𝟙 U))))))) =
      (show ↑((SheafOfModules.unit ((structureSheafRing
        X).over U)).val.obj
        (op (Over.mk (homOfLE hVU)))) from
        (1 : ↑((structureSheafRing X).obj.obj (op V))))
          := by
  show ((PresheafOfModules.unit ((structureSheafRing
    X).over U).obj).map
    (Over.homMk (homOfLE hVU)).op).hom
      (1 : ↑(((structureSheafRing X).over U).obj.obj
        (op (Over.mk (𝟙 U))))) =
    (1 : ↑(((structureSheafRing X).over U).obj.obj
      (op (Over.mk (homOfLE hVU)))) )
  rw [PresheafOfModules.unit_map_one]

private lemma idealBasisSection_hom_res_one {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      V : Opens X)
    (hVU : V ≤ U)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U)) :
    (e.hom.val.app (op (Over.mk (homOfLE hVU)))).hom
      ((I.val.map (homOfLE hVU).op).hom (idealBasisSection U e)) =
      (show ↑((SheafOfModules.unit
        ((structureSheafRing X).over U)).val.obj
          (op (Over.mk (homOfLE hVU)))) from
        (1 : ↑((structureSheafRing X).obj.obj (op V))))
          := by
  rw [idealBasisSection_res U V hVU e, unitOverMapOne U V hVU]
  let u : ((SheafOfModules.unit
      ((structureSheafRing X).over U)).val.obj
        (op (Over.mk (homOfLE hVU)))) :=
    show ↑((SheafOfModules.unit
      ((structureSheafRing X).over U)).val.obj
        (op (Over.mk (homOfLE hVU)))) from
      (1 : ↑(((structureSheafRing X).over U).obj.obj
        (op (Over.mk (homOfLE hVU)))))
  have h := congrArg (fun q => (q.val.app (op (Over.mk (homOfLE hVU)))).hom u)
    e.inv_hom_id
  show (e.hom.val.app (op (Over.mk (homOfLE hVU)))).hom
      ((e.inv.val.app (op (Over.mk (homOfLE hVU)))).hom u) = u
  exact h

private lemma idealBasisSection_generates {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      : Opens X)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U)) :
    GeneratesIdealOn X U (idealBasisSection U e) := by
  intro V hVU a
  let v : Over U := Over.mk (homOfLE hVU)
  let top : Over U := Over.mk (𝟙 U)
  let f : v ⟶ top := Over.homMk (homOfLE hVU)
  let a' : (I.over U).val.obj (op v) := a
  let ev := SheafOfModules.evaluation
    (R := (structureSheafRing X).over U) (op v)
  let r' : ↑(((structureSheafRing X).over U).obj.obj
    (op v)) :=
    (e.hom.val.app (op v)).hom a'
  let r : ↑(X.presheaf.obj (op V)) := r'
  refine ⟨r, ?_⟩
  have hIso : IsIso (ev.map e.hom) := Functor.map_isIso ev e.hom
  have hinj : Function.Injective (ev.map e.hom).hom :=
    ModuleCat.mono_iff_injective _ |>.mp (by infer_instance)
  have hinjApp : Function.Injective ((e.hom.val.app (op v)).hom) := hinj
  let uTop : ↑((SheafOfModules.unit
      ((structureSheafRing X).over U)).val.obj (op
        top)) :=
    (1 : ↑(((structureSheafRing X).over U).obj.obj (op
      top)))
  let uV : ↑((SheafOfModules.unit
      ((structureSheafRing X).over U)).val.obj (op v)) :=
    (1 : ↑((structureSheafRing X).obj.obj (op V)))
  have hmap : ((SheafOfModules.unit
      ((structureSheafRing X).over U)).val.map
        f.op).hom uTop = uV := unitOverMapOne U V hVU
  have hunit : (e.hom.val.app (op v)).hom ((e.inv.val.app (op v)).hom uV) = uV := by
    have h := congrArg (fun φ => (φ.val.app (op v)).hom uV) e.inv_hom_id
    exact h
  have hb' : (I.val.map (homOfLE hVU).op).hom (idealBasisSection U e) =
      (e.inv.val.app (op v)).hom uV := by
    rw [idealBasisSection_res U V hVU e, hmap]
  show a = r • (I.val.map (homOfLE hVU).op).hom (idealBasisSection U e)
  rw [hb']
  apply hinjApp
  show (e.hom.val.app (op v)).hom a' =
    (e.hom.val.app (op v)).hom (r' • (e.inv.val.app (op v)).hom uV)
  rw [map_smul, hunit]
  show r' = r' * 1
  simp

/-- The germ at `x` of the restriction of a section to `V` is the germ of the section. -/
lemma grpGerm_res {X : RingedSpace.{u}}
    (F : SheafOfModules.{u} (structureSheafRing X))
    (U V : Opens X) (hVU : V ≤ U) (x : X) (hxV : x ∈ V)
    (s : F.val.obj (op U)) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hxV
        ((F.val.map (homOfLE hVU).op).hom s) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x U (hVU hxV) s := by
  show (TopCat.Presheaf.germ (C := AddCommGrpCat.{u}) F.val.presheaf V x hxV).hom
      ((F.val.presheaf.map (homOfLE hVU).op).hom
        ((PresheafOfModules.presheaf_obj_coe (M := F.val) (op U)).symm ▸ s)) = _
  rw [TopCat.Presheaf.germ_res_apply (C := AddCommGrpCat.{u}) F.val.presheaf
    (homOfLE hVU) x hxV _]
  rfl

private lemma idealBasisSection_spans_stalk {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      : Opens X)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U))
    (x : X) (hxU : x ∈ U) :
    ∀ m : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X I.val x,
      ∃ r : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x,
        m = r • Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x U hxU
          (idealBasisSection U e) := by
  intro m
  obtain ⟨V, hxV, a, ha⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat.{u}) I.val.presheaf m
  let W : Opens X := V ⊓ U
  have hxW : x ∈ W := ⟨hxV, hxU⟩
  let aW : I.val.obj (op W) := (I.val.map (homOfLE inf_le_left).op).hom a
  let fW : I.val.obj (op W) :=
    (I.val.map (homOfLE inf_le_right).op).hom (idealBasisSection U e)
  obtain ⟨r, hr⟩ := idealBasisSection_generates U e W inf_le_right aW
  have hres : Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x W hxW aW = m :=
    (grpGerm_res I V W inf_le_left x hxW a).trans ha
  have hr' : aW = r • fW := by
    show aW = r • (I.val.map (homOfLE inf_le_right).op).hom (idealBasisSection U e)
    exact hr
  refine ⟨Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW r, ?_⟩
  rw [← hres, hr', Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul]
  show (Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW r) •
      (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x W hxW
        ((I.val.map (homOfLE inf_le_right).op).hom (idealBasisSection U e))) = _
  rw [grpGerm_res I U W inf_le_right x hxW (idealBasisSection U e)]

open scoped TensorProduct

private lemma grpGerm_eq_of_grpGerm_smul_eq
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (U : Opens X) (f : I.val.obj (op U))
    (hreg : IsGeneratorRegularOn X i F U f)
    {Z : Opens X} (hZU : Z ≤ U) (x : X) (hxZ : x ∈ Z) (sZ tZ : F.val.obj (op Z))
    (hprod :
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ
          (idealSection X i (op Z) ((I.val.map (homOfLE hZU).op).hom f) • sZ) =
        Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ
          (idealSection X i (op Z) ((I.val.map (homOfLE hZU).op).hom f) • tZ)) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ sZ =
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ tZ := by
  let fZ : I.val.obj (op Z) := (I.val.map (homOfLE hZU).op).hom f
  obtain ⟨Y, hxY, iY₁, iY₂, heq⟩ :=
    TopCat.Presheaf.germ_eq (C := AddCommGrpCat.{u}) F.val.presheaf
      x hxZ hxZ (idealSection X i (op Z) fZ • sZ)
      (idealSection X i (op Z) fZ • tZ) hprod
  have hYZ : Y ≤ Z := leOfHom iY₁
  have hYU : Y ≤ U := le_trans hYZ hZU
  let sY : F.val.obj (op Y) := F.val.restrictₛₗ (homOfLE hYZ).op sZ
  let tY : F.val.obj (op Y) := F.val.restrictₛₗ (homOfLE hYZ).op tZ
  have hresprod :
      F.val.restrictₛₗ (homOfLE hYZ).op (idealSection X i (op Z) fZ • sZ) =
        F.val.restrictₛₗ (homOfLE hYZ).op (idealSection X i (op Z) fZ • tZ) := by
    rwa [show iY₁.op = (homOfLE hYZ).op from Subsingleton.elim _ _] at heq
  have hresprod' :
      idealSection X i (op Y) ((I.val.map (homOfLE hYU).op).hom f) • sY =
        idealSection X i (op Y) ((I.val.map (homOfLE hYU).op).hom f) • tY := by
    rw [(F.val.restrictₛₗ (homOfLE hYZ).op).map_smulₛₗ,
      (F.val.restrictₛₗ (homOfLE hYZ).op).map_smulₛₗ] at hresprod
    have hnat : idealSection X i (op Y)
        ((I.val.map (homOfLE hYU).op).hom f) =
        ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map (homOfLE hYZ).op).hom
          (idealSection X i (op Z) fZ) := idealSection_map_trans X i hYZ hZU f
    -- `hresprod` carries the restriction map at the `Oₓ.obj` spelling of the presheaf of rings,
    -- `hnat` at `TensorStalkRingedSpace.O X`. The two are the same functor, but `rw` matches
    -- syntactically, so the equation is restated at the spelling `hresprod` uses.
    have hnat' : idealSection X i (op Y) ((I.val.map (homOfLE hYU).op).hom f) =
        ((structureSheafRing X).obj.map (homOfLE hYZ).op).hom
          (idealSection X i (op Z) fZ) := hnat
    rwa [← hnat'] at hresprod
  calc
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Y hxY sY :=
      (grpGerm_res F Z Y hYZ x hxY sZ).symm
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Y hxY tY := by
      rw [hreg Y hYU hresprod']
    _ = _ := grpGerm_res F Z Y hYZ x hxY tZ

private lemma stalkSmul_injective_of_generatorRegularOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (U : Opens X) (f : I.val.obj (op U))
    (hreg : IsGeneratorRegularOn X i F U f)
    (x : X) (hxU : x ∈ U) :
    Function.Injective fun m : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x ↦
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU (idealSection X i (op U) f) •
        m := by
  intro m n hmn
  obtain ⟨V, hxV, s, hs⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat.{u}) F.val.presheaf m
  obtain ⟨W, hxW, t, ht⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat.{u}) F.val.presheaf n
  let Z : Opens X := U ⊓ V ⊓ W
  have hxZ : x ∈ Z := ⟨⟨hxU, hxV⟩, hxW⟩
  have hZU : Z ≤ U := le_trans inf_le_left inf_le_left
  have hZV : Z ≤ V := le_trans inf_le_left inf_le_right
  have hZW : Z ≤ W := inf_le_right
  let fZ : I.val.obj (op Z) :=
    (I.val.map (homOfLE hZU).op).hom f
  let sV : F.val.obj (op V) :=
    (PresheafOfModules.presheaf_obj_coe (M := F.val) (op V)).symm ▸ s
  let tW : F.val.obj (op W) :=
    (PresheafOfModules.presheaf_obj_coe (M := F.val) (op W)).symm ▸ t
  let sZ : F.val.obj (op Z) := (F.val.map (homOfLE hZV).op).hom sV
  let tZ : F.val.obj (op Z) := (F.val.map (homOfLE hZW).op).hom tW
  have hs' : Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hxV sV = m := by
    convert hs using 1
    rfl
  have ht' : Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x W hxW tW = n := by
    convert ht using 1
    rfl
  have hscalar := ringGerm_idealSection_map X i hZU x hxZ f
  have hprod :
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ (idealSection X i (op Z)
        fZ • sZ) =
        Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ (idealSection X i (op
          Z) fZ • tZ) := by
    rw [Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul,
      Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul, hscalar,
      grpGerm_res F V Z hZV x hxZ s, grpGerm_res F W Z hZW x hxZ t, hs', ht']
    exact hmn
  calc
    m = Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ sZ :=
      ((grpGerm_res F V Z hZV x hxZ sV).trans hs').symm
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x Z hxZ tZ :=
      grpGerm_eq_of_grpGerm_smul_eq X i F U f hreg hZU x hxZ sZ tZ hprod
    _ = n := (grpGerm_res F W Z hZW x hxZ tW).trans ht'

private lemma eq_zero_of_smul_idealBasisSection_res_eq_zero {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U Y : Opens X) (hYU : Y ≤ U)
    (e : I.over U ≅ SheafOfModules.unit ((structureSheafRing X).over U))
    (a : X.presheaf.obj (op Y))
    (h : a • (I.val.map (homOfLE hYU).op).hom (idealBasisSection U e) = 0) : a = 0 := by
  let a' : ↑(((structureSheafRing X).over U).obj.obj (op (Over.mk (homOfLE hYU)))) := a
  let f' : (I.over U).val.obj (op (Over.mk (homOfLE hYU))) :=
    (I.val.map (homOfLE hYU).op).hom (idealBasisSection U e)
  have hcoeff : (e.hom.val.app (op (Over.mk (homOfLE hYU)))).hom (a' • f') = 0 :=
    (congrArg (e.hom.val.app (op (Over.mk (homOfLE hYU)))).hom h).trans (map_zero _)
  rw [map_smul, idealBasisSection_hom_res_one U Y hYU e] at hcoeff
  change a' * 1 = 0 at hcoeff
  have h' : a' = 0 := by simpa only [mul_one] using hcoeff
  exact h'

private lemma idealBasisSection_stalk_smul_injective {X : RingedSpace.{u}}
    {I : SheafOfModules.{u} (structureSheafRing X)} (U
      : Opens X)
    (e : I.over U ≅ SheafOfModules.unit
      ((structureSheafRing X).over U))
    (x : X) (hxU : x ∈ U) :
    Function.Injective fun r : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x =>
      r • Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x U hxU (idealBasisSection U
        e) := by
  let g := Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x U hxU (idealBasisSection U
    e)
  have hker : ∀ r : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x, r • g = 0 → r = 0 :=
    by
    intro r hr
    obtain ⟨V, hxV, a, ha⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf r
    let W : Opens X := U ⊓ V
    have hxW : x ∈ W := ⟨hxU, hxV⟩
    let aW := (X.presheaf.map (homOfLE (show W ≤ V from inf_le_right)).op).hom a
    let fW := (I.val.map (homOfLE (show W ≤ U from inf_le_left)).op).hom
      (idealBasisSection U e)
    have haW : Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW aW = r :=
      (X.presheaf.germ_res_apply (homOfLE inf_le_right) x hxW a).trans ha
    have hfW : Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x W hxW fW = g :=
      grpGerm_res I U W inf_le_left x hxW _
    have hz : Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x W hxW (aW • fW) =
        Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x W hxW 0 := by
      have h := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul X I.val x W hxW
        aW fW
      rw [haW, hfW, hr] at h
      rw [map_zero]
      with_unfolding_all exact h
    obtain ⟨Y, hxY, j, j', hj⟩ :=
      TopCat.Presheaf.germ_eq (C := AddCommGrpCat) I.val.presheaf x hxW hxW
        (aW • fW) 0 hz
    have hYW : Y ≤ W := j.le
    have hYU : Y ≤ U := hYW.trans inf_le_left
    let aY := (X.presheaf.map j.op).hom aW
    let fY := (I.val.map (homOfLE hYU).op).hom (idealBasisSection U e)
    have hcomp : (homOfLE (show W ≤ U from inf_le_left)).op ≫ j.op = (homOfLE hYU).op :=
      Subsingleton.elim _ _
    have hres : (I.val.map j.op).hom fW = fY :=
      (I.val.map_comp_apply (homOfLE (show W ≤ U from inf_le_left)).op j.op
          (idealBasisSection U e)).symm.trans
        (PresheafOfModules.congr_map_apply (M := I.val) hcomp (idealBasisSection U e))
    have hzero : aY • fY = 0 := by
      change I.val.restrictₛₗ j.op (aW • fW) = I.val.restrictₛₗ j'.op 0 at hj
      rw [← hres]
      have h1 := (I.val.restrictₛₗ j.op).map_smulₛₗ aW fW
      have h2 : I.val.restrictₛₗ j'.op (0 : I.val.obj (op W)) = 0 := map_zero _
      with_unfolding_all exact h1.symm.trans (hj.trans h2)
    have haY : aY = 0 := eq_zero_of_smul_idealBasisSection_res_eq_zero U Y hYU e aY hzero
    rw [← haW]
    have heq := X.presheaf.germ_res_apply j x hxY aW
    change Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x Y hxY aY =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW aW at heq
    rw [← heq, haY, map_zero]
  intro r s hrs
  refine sub_eq_zero.mp (hker _ ?_)
  rwa [sub_smul, sub_eq_zero]

/-- The stalk at `x` of the structure sheaf viewed as a module over itself is the local ring
at `x`, as an isomorphism of additive groups: both are the same filtered colimit, computed in
`AddCommGrpCat` and in `CommRingCat` respectively. -/
noncomputable def unitStalkAddEquiv (x : X) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X (SheafOfModules.unit Oₓ).val x ≃+
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x :=
  (preservesColimitIso (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
    ((OpenNhds.inclusion x).op ⋙ X.presheaf)).symm.addCommGroupIsoToAddEquiv

/-- `unitStalkAddEquiv` carries the germ of a section of the unit module to the germ of the
corresponding section of the structure sheaf. -/
lemma unitStalkAddEquiv_germ (x : X) (U : Opens X) (hxU : x ∈ U)
    (r : X.presheaf.obj (op U)) :
    unitStalkAddEquiv X x
      (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X (SheafOfModules.unit Oₓ).val x U hxU
        r) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU r := by
  have h := ι_preservesColimitIso_inv (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
    ((OpenNhds.inclusion x).op ⋙ X.presheaf) (op ⟨U, hxU⟩)
  exact congrArg (fun q => q.hom r) h

/-- The stalk at `x` of the structure sheaf viewed as a module over itself is the local ring
at `x`, as a linear isomorphism: the scalar action on the stalk of the structure sheaf is
multiplication. -/
noncomputable def unitStalkLinearEquiv (x : X) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X (SheafOfModules.unit Oₓ).val x ≃ₗ[
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
        Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x := by
  refine { __ := unitStalkAddEquiv X x, map_smul' := ?_ }
  intro r m
  obtain ⟨U, hxU, s, rfl⟩ :=
    TopCat.Presheaf.exists_germ_eq (C := AddCommGrpCat) (SheafOfModules.unit Oₓ).val.presheaf m
  obtain ⟨V, hxV, t, rfl⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf r
  let W : Opens X := U ⊓ V
  have hxW : x ∈ W := ⟨hxU, hxV⟩
  have hs := grpGerm_res (SheafOfModules.unit Oₓ) U W inf_le_left x hxW s
  have ht := X.presheaf.germ_res_apply (homOfLE (show W ≤ V from inf_le_right)) x hxW t
  change unitStalkAddEquiv X x
    (Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hxV t •
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X (SheafOfModules.unit Oₓ).val x U hxU s)
        =
    Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hxV t * unitStalkAddEquiv X x
      (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X (SheafOfModules.unit Oₓ).val x U hxU
        s)
  change Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW
      ((X.presheaf.map (homOfLE inf_le_right).op).hom t) =
    Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hxV t at ht
  rw [← hs, ← ht]
  let tW : X.presheaf.obj (op W) :=
    (X.presheaf.map (homOfLE (show W ≤ V from inf_le_right)).op).hom t
  let sW : (SheafOfModules.unit Oₓ).val.obj (op W) :=
    ((SheafOfModules.unit Oₓ).val.map (homOfLE (show W ≤ U from inf_le_left)).op).hom s
  let sWr : X.presheaf.obj (op W) := sW
  have h1 := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul X
    (SheafOfModules.unit Oₓ).val x W hxW tW sW
  have h2 := unitStalkAddEquiv_germ X x W hxW (tW * sWr)
  have h3 := unitStalkAddEquiv_germ X x W hxW sWr
  have hchain := ((congrArg (unitStalkAddEquiv X x) h1.symm).trans
      (h2.trans (map_mul (Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW) tW
        sWr))).trans
    (congrArg (fun z ↦ Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW tW * z)
      h3.symm)
  with_unfolding_all exact hchain

private lemma unitStalkLinearEquiv_germ (x : X) (U : Opens X) (hxU : x ∈ U)
    (r : X.presheaf.obj (op U)) :
    unitStalkLinearEquiv X x
      (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X (SheafOfModules.unit Oₓ).val x U hxU
        r) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU r :=
  unitStalkAddEquiv_germ X x U hxU r

private lemma tensorMap_injective_iff_smul
    {R M P N : Type*} [CommSemiring R] [AddCommMonoid M] [Module R M]
    [AddCommMonoid P] [Module R P] [AddCommMonoid N] [Module R N]
    (q : M →ₗ[R] P) (e : R ≃ₗ[R] M) (d : P ≃ₗ[R] R) :
    Function.Injective (TensorProduct.map q (LinearMap.id : N →ₗ[R] N)) ↔
      Function.Injective fun n : N => d (q (e 1)) • n := by
  let E : N ≃ₗ[R] M ⊗[R] N :=
    (TensorProduct.lid R N).symm.trans (TensorProduct.congr e (LinearEquiv.refl R N))
  let D : P ⊗[R] N ≃ₗ[R] N :=
    (TensorProduct.congr d (LinearEquiv.refl R N)).trans (TensorProduct.lid R N)
  let Q := TensorProduct.map q (LinearMap.id : N →ₗ[R] N)
  have h (n : N) : D (Q (E n)) = d (q (e 1)) • n := by
    simp [D, E, Q]
  refine ⟨fun hQ m n hmn => ?_, fun hscalar z w hzw => ?_⟩
  · apply E.injective
    apply hQ
    apply D.injective
    show D (Q (E m)) = D (Q (E n))
    simpa only [h] using hmn
  · obtain ⟨m, rfl⟩ := E.surjective z
    obtain ⟨n, rfl⟩ := E.surjective w
    apply congrArg E
    apply hscalar
    simpa only [← h] using congrArg D hzw

private lemma stalkMapL_id (F : SheafOfModules.{u} Oₓ) (x : X) :
    Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X F.val F.val (𝟙 F.val) x = LinearMap.id
      := by
  ext m
  show ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
    ((PresheafOfModules.toPresheaf (Stacks.SheafOfModules.TensorStalkRingedSpace.O X)).map (𝟙
      F.val))).hom m = m
  simp
  rfl

private lemma tensorStalkMap_injective_iff
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ) (x : X) :
    Function.Injective (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
      ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (I)).obj (F))).val F.val
      (idealTensorMultiplication X i F).val x) ↔
    Function.Injective (TensorProduct.map
      (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit Oₓ).val
        i.val x)
      (LinearMap.id : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x →ₗ[
        Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
          Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x)) := by
  let TI := Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x I F
  let TO := Stacks.SheafOfModules.TensorStalkRingedSpace.tensorStalkIso X x (SheafOfModules.unit Oₓ)
    F
  let E := Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (𝒪)).obj (F))).val F.val
    (tensorUnitIso X F).hom.val x
  have hE : Function.Injective E :=
    @IdealTorsion.stalkMapL_injective_of_mono X _ F (tensorUnitIso X F).hom
      (@IsIso.mono_of_iso _ _ _ _ (tensorUnitIso X F).hom
        (tensorUnitIso X F).isIso_hom) x
  have hfac := idealTensorMultiplication_stalk_factor X i F x
  rw [stalkMapL_id] at hfac
  constructor
  · intro hm z w hzw
    apply TI.symm.injective
    apply hm
    exact (congrArg (fun f => f z) hfac).trans
      ((congrArg (fun t => E (TO.symm t)) hzw).trans (congrArg (fun f => f w) hfac).symm)
  · intro hQ z w hzw
    apply TI.injective
    apply hQ
    apply TO.symm.injective
    apply hE
    have hfz := congrArg (fun f => f (TI z)) hfac
    have hfw := congrArg (fun f => f (TI w)) hfac
    simp only [TI, LinearMap.comp_apply, LinearEquiv.coe_coe,
      LinearEquiv.symm_apply_apply] at hfz hfw
    exact hfz.symm.trans (hzw.trans hfw)

private lemma basis_stalk_tensorMap_injective_iff
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (U : Opens X) (e : I.over U ≅ SheafOfModules.unit ((Oₓ).over U))
    (x : X) (hxU : x ∈ U) :
    Function.Injective (TensorProduct.map
      (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit Oₓ).val
        i.val x)
      (LinearMap.id : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x →ₗ[
        Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
          Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x)) ↔
    Function.Injective fun m : Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x =>
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU (idealSection X i (op U)
        (idealBasisSection U e)) • m := by
  let g := Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X I.val x U hxU (idealBasisSection U
    e)
  let b : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x
    →ₗ[Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x]
      Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X I.val x :=
    { toFun := fun r => r • g
      map_add' := fun r s => add_smul r s g
      map_smul' := fun r s => mul_smul r s g }
  have hb : Function.Bijective b :=
    ⟨idealBasisSection_stalk_smul_injective U e x hxU,
      fun m => (idealBasisSection_spans_stalk U e x hxU m).imp fun _ => Eq.symm⟩
  let B := LinearEquiv.ofBijective b hb
  have h := tensorMap_injective_iff_smul
    (N := Stacks.SheafOfModules.TensorStalkRingedSpace.grpStalk X F.val x)
    (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit Oₓ).val
      i.val x)
    B (unitStalkLinearEquiv X x)
  have hB : B 1 = g := by
    show (1 : Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x) • g = g
    exact one_smul _ _
  have ha : unitStalkLinearEquiv X x
      (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X I.val (SheafOfModules.unit Oₓ).val
        i.val x g) =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU
        (idealSection X i (op U) (idealBasisSection U e)) :=
    (congrArg (unitStalkLinearEquiv X x) (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL_germ X _ _ i.val x U hxU _)).trans
      (unitStalkLinearEquiv_germ X x U hxU _)
  rwa [hB, ha] at h

private lemma isIdealTensorMultiplication_mono_of_generatorRegularOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1]
    (F : SheafOfModules.{u} Oₓ)
    (hreg : ∀ (U : Opens X) (f : I.val.obj (op U)),
      GeneratesIdealOn X U f → IsGeneratorRegularOn X i F U f) :
    Mono (idealTensorMultiplication X i F) := by
  let T := SheafOfModules.toSheaf Oₓ
  apply T.mono_of_mono_map
  apply (TopCat.Presheaf.mono_iff_stalk_mono (T.map (idealTensorMultiplication X i F))).2
  intro x
  apply (AddCommGrpCat.mono_iff_injective _).mpr
  show Function.Injective (Stacks.SheafOfModules.TensorStalkRingedSpace.stalkMapL X
    ((((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u}
      ⟨X.presheaf, X.IsSheaf⟩).obj (I)).obj (F))).val F.val
    (idealTensorMultiplication X i F).val x)
  rw [tensorStalkMap_injective_iff]
  obtain ⟨U, hxU, ⟨e⟩⟩ := exists_ideal_trivialization_near (X := X) (I := I) x
  rw [basis_stalk_tensorMap_injective_iff X i F U e x hxU]
  exact stalkSmul_injective_of_generatorRegularOn X i F U _
    (hreg U _ (idealBasisSection_generates U e)) x hxU

private lemma injective_smul_pow_of_injective {R M : Type*} [CommSemiring R]
    [AddCommMonoid M] [Module R M] (a : R)
    (ha : Function.Injective fun x : M ↦ a • x) (n : ℕ) :
    Function.Injective fun x : M ↦ a ^ n • x := by
  induction n with
  | zero => exact fun x y h => by simpa using h
  | succ n ih =>
      intro x y h
      apply ha
      apply ih
      simpa [pow_succ, mul_smul] using h

private lemma restrictScalars_original_smul {R S : Type*} [Ring R] [Ring S]
    (f : R →+* S) (M : ModuleCat S) (r : S) (m : M) :
    (letI : Module S ((ModuleCat.restrictScalars f).obj M) :=
      ModuleCat.instModuleCarrierObjRestrictScalars
     r • (show (ModuleCat.restrictScalars f).obj M from m)) =
      (M.smul r).hom m :=
  rfl

private lemma isGeneratorRegularOn_of_isIdealTorsionFree
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    (F : SheafOfModules.{u} Oₓ) (h : IsIdealTorsionFree X i F)
    (U : Opens X) (f : I.val.obj (op U)) (hgen : GeneratesIdealOn X U f) :
    IsGeneratorRegularOn X i F U f := by
  have hNbot : idealAnnihilatedSubsheaf X i F = ⊥ := by
    refine le_antisymm ?_ bot_le
    rw [← h]
    exact idealAnnihilatedSubsheaf_le_sup X i F
  intro V hVU s t hst
  let fV : I.val.obj (op V) := (I.val.map (homOfLE hVU).op).hom f
  have hkillV : idealSection X i (op V) fV • (s - t) = 0 := by
    rw [smul_sub]
    exact sub_eq_zero.mpr hst
  have hmem : s - t ∈ (idealAnnihilatedSubsheaf X i F).toSubmodule.obj (op V) := by
    dsimp [idealAnnihilatedSubsheaf]
    show ∀ (W : Opens X) (hWV : W ≤ V) (a : I.val.obj (op W)),
      idealSection X i (op W) a •
        (F.val.map (homOfLE hWV).op).hom (s - t) = 0
    intro W hWV a
    have hWU : W ≤ U := le_trans hWV hVU
    let fW : I.val.obj (op W) := (I.val.map (homOfLE hWU).op).hom f
    let dW := (F.val.map (homOfLE hWV).op).hom (s - t)
    obtain ⟨r, hr⟩ := hgen W hWU a
    have hkillW : idealSection X i (op W)
          fW • dW = 0 := by
      have hm := congrArg (fun z => (F.val.map (homOfLE hWV).op).hom z) hkillV
      rw [map_zero, map_smul] at hm
      have hscalar : idealSection X i (op W)
          fW =
          ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map (homOfLE hWV).op).hom
            (idealSection X i (op V) fV) := idealSection_map_trans X i hWV hVU f
      have hm' : ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map (homOfLE hWV).op).hom
          (idealSection X i (op V) fV) • (show F.val.obj (op W) from dW) = 0 := by
        convert hm using 1 <;> rfl
      rwa [← hscalar] at hm'
    let r' : (Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj (op W) := r
    have hr'' : a = r' • fW := by
      convert hr using 1
      rfl
    rw [hr'', idealSection_smul X i (op W) r' fW, smul_eq_mul, mul_smul, hkillW, smul_zero]
  have hmemBot : s - t ∈ (⊥ : F.Submodule).toSubmodule.obj (op V) := by
    rwa [← hNbot]
  have hzero : s - t = 0 := by
    let Z := zeroSubsheaf (X := X) F
    have hZ : s - t ∈ Z.toSubmodule.obj (op V) :=
      (SheafOfModules.Submodule.le_iff.mp
        (bot_le : (⊥ : F.Submodule) ≤ Z) (op V)) hmemBot
    change s - t ∈ (⊥ : F.val.Submodule).obj (op V) at hZ
    exact (Submodule.mem_bot _).mp hZ
  exact sub_eq_zero.mp hzero

private lemma exists_generatesIdealOn_near
    {I : SheafOfModules.{u} Oₓ}
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1]
    (V : Opens X) (x : X) (hx : x ∈ V) :
    ∃ (W : Opens X) (_ : W ≤ V), x ∈ W ∧ ∃ fW : I.val.obj (op W), GeneratesIdealOn X W fW := by
  obtain ⟨U₀, hx₀, ⟨e⟩⟩ := exists_ideal_trivialization_near (X := X) (I := I) x
  let fOver : V ⊓ U₀ ⟶ U₀ := homOfLE inf_le_right
  let eW : I.over (V ⊓ U₀) ≅ SheafOfModules.unit ((Oₓ).over (V ⊓ U₀)) :=
    ((SheafOfModules.overFunctorMap (R := Oₓ) fOver).app I).symm ≪≫
      (SheafOfModules.overMap (R := Oₓ) fOver).mapIso e ≪≫
        SheafOfModules.overMapUnitIso (R := Oₓ) fOver
  exact ⟨V ⊓ U₀, inf_le_left, ⟨hx, hx₀⟩, _, idealBasisSection_generates _ eW⟩

private lemma injective_idealSection_smul_of_isGeneratorRegularOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (W : Opens X) (fW : I.val.obj (op W)) (hreg : IsGeneratorRegularOn X i F W fW) :
    Function.Injective fun t : F.val.obj (op W) ↦ idealSection X i (op W) fW • t := by
  let fId := (X.presheaf.map (𝟙 (op W))).hom
  have hfId : fId = RingHom.id _ := by simp [fId]
  let eI := ModuleCat.restrictScalarsId'App fId hfId (I.val.obj (op W))
  have hI : eI.inv fW = fW := rfl
  have hinj₁ : Function.Injective fun t : F.val.obj (op W) ↦
      idealSection X i (op W) (eI.inv fW) • t := by
    simpa [eI, IsGeneratorRegularOn, PresheafOfModules.map_id,
      ModuleCat.restrictScalarsId'_inv_app] using hreg W le_rfl
  simpa [hI] using hinj₁

private lemma idealSection_pow_smul_eq_zero
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (W : Opens X) (fW : I.val.obj (op W)) (n : ℕ) (sW : F.val.obj (op W))
    (hN : ∀ (V : Opens X) (hVU : V ≤ unop (op W)) (a : Fin n → I.val.obj (op V)),
      (∏ k, idealSection X i (op V) (a k)) • (F.val.map (homOfLE hVU).op).hom sW = 0) :
    idealSection X i (op W) fW ^ n • sW = 0 := by
  have hkill := hN W le_rfl (fun _ : Fin n => fW)
  let fId := (X.presheaf.map (𝟙 (op W))).hom
  have hfId : fId = RingHom.id _ := by simp [fId]
  let eF := ModuleCat.restrictScalarsId'App fId hfId (F.val.obj (op W))
  rw [show (homOfLE (le_rfl : W ≤ W)).op = 𝟙 (op W) from Subsingleton.elim _ _] at hkill
  have hkill₁ := congrArg eF.hom hkill
  have eF_hom_id
      (z : (ModuleCat.restrictScalars fId).obj (F.val.obj (op W))) :
      eF.hom z = z := rfl
  simp only [eF_hom_id] at hkill₁
  show ((F.val.obj (op W)).smul (idealSection X i (op W) fW ^ n)).hom sW = 0
  have hmap : (F.val.map (𝟙 (op W))).hom sW = sW := by
    simp [PresheafOfModules.map_id, ModuleCat.restrictScalarsId'_inv_app]
    rfl
  rw [hmap] at hkill₁
  -- The restriction map is named at `O X`, the presheaf of rings itself, rather than at
  -- `Oₓ.obj`: the two are the same functor, but the product below is elaborated at the
  -- domain of this map, and a goal is keyed into the typeclass discrimination tree with
  -- only `@[reducible]` definitions unfolded, so at the `Oₓ.obj` spelling commutativity
  -- of the section ring is never retrieved.
  rw [restrictScalars_original_smul
    ((Stacks.SheafOfModules.TensorStalkRingedSpace.O X).map (𝟙 (op W))).hom
    (F.val.obj (op W))
    (∏ k : Fin n, idealSection X i (op W) fW) sW] at hkill₁
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin] at hkill₁
  convert hkill₁ using 1
  rfl

private lemma isIdealPowerTorsionFree_of_isGeneratorRegularOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1]
    (F : SheafOfModules.{u} Oₓ)
    (hreg : ∀ (U : Opens X) (f : I.val.obj (op U)),
      GeneratesIdealOn X U f → IsGeneratorRegularOn X i F U f) :
    IsIdealPowerTorsionFree X i F := by
  intro n hn
  refine le_antisymm ?_ bot_le
  apply idealPowerAnnihilatorSubsheaf_le X i F n ⊥
  intro N hN
  apply SheafOfModules.Submodule.le_iff.mpr
  intro U
  show N.toSubmodule.obj U ≤ (⊥ : F.Submodule).toSubmodule.obj U
  intro s hs
  have hzero : s = 0 := by
    apply TopCat.Presheaf.IsSheaf.section_ext F.isSheaf
    intro x hx
    obtain ⟨W, hWU, hxW, fW, hgen⟩ := exists_generatesIdealOn_near X (I := I) (unop U) x hx
    have hinjPow := injective_smul_pow_of_injective (idealSection X i (op W) fW)
      (injective_idealSection_smul_of_isGeneratorRegularOn X i F W fW (hreg W fW hgen)) n
    let sW : F.val.obj (op W) := (F.val.map (homOfLE hWU).op).hom s
    have hkill₂ := idealSection_pow_smul_eq_zero X i F W fW n sW
      (hN (op W) sW (N.toSubmodule.map (homOfLE hWU).op hs))
    have hsW : sW = 0 := by
      apply hinjPow
      show idealSection X i (op W) fW ^ n • sW =
        idealSection X i (op W) fW ^ n • (0 : F.val.obj (op W))
      rwa [smul_zero]
    refine ⟨W, hWU, hxW, ?_⟩
    let s' : ↑(F.val.presheaf.obj U) :=
      (PresheafOfModules.presheaf_obj_coe (M := F.val) U).symm ▸ s
    have hmap_s : (F.val.presheaf.map (homOfLE hWU).op).hom s' =
        (F.val.map (homOfLE hWU).op).hom s := rfl
    have hmap_0 : (F.val.presheaf.map (homOfLE hWU).op).hom 0 =
        (F.val.map (homOfLE hWU).op).hom 0 := rfl
    show (F.val.presheaf.map (homOfLE hWU).op).hom s' =
      (F.val.presheaf.map (homOfLE hWU).op).hom 0
    rw [hmap_s, hmap_0, map_zero]
    exact hsW
  rw [hzero]
  exact Submodule.zero_mem _

/-- **The germ of a generating section of the ideal generates the stalk ideal.**  Every element
of the stalk ideal is the germ of the ambient section of some local section of the ideal; on the
intersection with the generating section's open that section is a multiple of the generator, and
germs turn the multiple into a multiple in the stalk.  This is the sectionwise-to-stalkwise step
of Tag 0GT5. -/
public theorem generatesStalkIdeal_of_generatesIdealOn
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (U : Opens X)
    (f : I.val.obj (op U)) (hgen : GeneratesIdealOn X U f)
    (x : X) (hxU : x ∈ U) :
    GeneratesStalkIdeal X i x
      (Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU (idealSection X i (op U) f))
        := by
  let g := Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU (idealSection X i (op U)
    f)
  refine ⟨⟨U, hxU, f, rfl⟩, ?_⟩
  rintro a ⟨V, hxV, b, hb⟩
  let W : Opens X := V ⊓ U
  have hxW : x ∈ W := ⟨hxV, hxU⟩
  let bW : I.val.obj (op W) :=
    (I.val.map (homOfLE inf_le_left).op).hom b
  let fW : I.val.obj (op W) :=
    (I.val.map (homOfLE inf_le_right).op).hom f
  obtain ⟨r, hr⟩ := hgen W inf_le_right bW
  let r' : (Stacks.SheafOfModules.TensorStalkRingedSpace.O X).obj (op W) := r
  have hr' : bW = r' • fW := by
    convert hr using 1
    rfl
  refine ⟨Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW r, ?_⟩
  calc
    a = Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hxV (idealSection X i (op V)
      b) := hb.symm
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW (idealSection X i (op W)
      bW) := by
      exact (ringGerm_idealSection_map X i inf_le_left x hxW b).symm
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW r' *
            Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW (idealSection X i (op
              W) fW) := by
      rw [hr', idealSection_smul, smul_eq_mul]
      simp [Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm]
    _ = Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x W hxW r * g := by
      exact congrArg _ (ringGerm_idealSection_map X i inf_le_right x hxW f)

/-- If every stalk generator of the ideal is a nonzerodivisor on the stalks of `F`, then
multiplication by every local generator of the ideal is injective. -/
private lemma isGeneratorRegularOn_of_isStalkwiseGeneratorRegular
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) (F : SheafOfModules.{u} Oₓ)
    (h : IsStalkwiseGeneratorRegular X i F) (U : Opens X) (f : I.val.obj (op U))
    (hgen : GeneratesIdealOn X U f) : IsGeneratorRegularOn X i F U f := by
  intro V hVU s t hst
  apply TopCat.Presheaf.IsSheaf.section_ext F.isSheaf
  intro x hx
  have hxU : x ∈ U := hVU hx
  let fV : I.val.obj (op V) := (I.val.map (homOfLE hVU).op).hom f
  let fx := Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x U hxU
    (idealSection X i (op U) f)
  have hfx := generatesStalkIdeal_of_generatesIdealOn X i U f hgen x hxU
  have hinj := h x fx hfx
  have hscalar := ringGerm_idealSection_map X i hVU x hx f
  have hmulV : Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hx
        (idealSection X i (op V) fV) •
        Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hx s =
      Stacks.SheafOfModules.TensorStalkRingedSpace.ringGerm X x V hx
        (idealSection X i (op V) fV) •
        Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hx t := by
    rw [← Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul X F.val x V hx
      (idealSection X i (op V) fV) s,
      ← Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule_germ_smul X F.val x V hx
      (idealSection X i (op V) fV) t]
    exact congrArg (Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hx) hst
  have hmul : fx • Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hx s =
      fx • Stacks.SheafOfModules.TensorStalkRingedSpace.grpGerm X F.val x V hx t := by
    rwa [hscalar] at hmulV
  have hstalk := hinj hmul
  obtain ⟨W, hxW, iWV₁, iWV₂, heq⟩ :=
    TopCat.Presheaf.germ_eq (C := AddCommGrpCat.{u}) F.val.presheaf
      x hx hx s t hstalk
  refine ⟨W, iWV₁.le, hxW, ?_⟩
  have hi : iWV₁ = iWV₂ := Subsingleton.elim _ _
  convert heq using 1 <;> congr 1

/-- **Stacks Project, Tag 0GT5.** For an ideal sheaf locally generated by a
nonzerodivisor, the following are equivalent: `F[I] = 0`; `F[I^n] = 0` for every
`n ≥ 1`; multiplication `I ⊗ F ⟶ F` is injective; multiplication by every local
generator is injective; and every stalk generator is a nonzerodivisor on the stalk of
`F`. -/
@[stacks 0GT5]
public theorem idealTorsionFree_tfae
    {I : SheafOfModules.{u} Oₓ} (i : I ⟶ 𝒪) [Mono i]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank (C := Opens X)
      (J := Opens.grothendieckTopology X) I 1]
    (F : SheafOfModules.{u} Oₓ) :
    List.TFAE [
      IsIdealTorsionFree X i F,
      IsIdealPowerTorsionFree X i F,
      Mono (idealTensorMultiplication X i F),
      ∀ (U : Opens X) (f : I.val.obj (op U)),
        GeneratesIdealOn X U f → IsGeneratorRegularOn X i F U f,
      IsStalkwiseGeneratorRegular X i F] := by
  tfae_have 1 → 4 := isGeneratorRegularOn_of_isIdealTorsionFree X i F
  tfae_have 4 → 2 := isIdealPowerTorsionFree_of_isGeneratorRegularOn X i F
  tfae_have 2 → 1 := fun h => h 1 le_rfl
  tfae_have 4 → 3 := isIdealTensorMultiplication_mono_of_generatorRegularOn X i F
  tfae_have 3 → 5 := by
    intro h x f hf
    obtain ⟨U, hxU, ⟨e⟩⟩ := exists_ideal_trivialization_near (X := X) (I := I) x
    have hg := (basis_stalk_tensorMap_injective_iff X i F U e x hxU).mp
      ((tensorStalkMap_injective_iff X i F x).mp
        (@IdealTorsion.stalkMapL_injective_of_mono X _ F (idealTensorMultiplication X i F) h x))
    obtain ⟨r, hr⟩ := hf.2 _ ⟨U, hxU, idealBasisSection U e, rfl⟩
    intro m n hmn
    change f • m = f • n at hmn
    apply hg
    show _ • m = _ • n
    rw [hr, mul_smul, mul_smul, hmn]
  tfae_have 5 → 4 := isGeneratorRegularOn_of_isStalkwiseGeneratorRegular X i F
  tfae_finish

end Stacks.IdealTorsion
