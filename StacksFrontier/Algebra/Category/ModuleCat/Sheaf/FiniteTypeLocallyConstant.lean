module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocallyConstantSerreClass
public import StacksFrontier.CategoryTheory.Sites.LocallyConstant.Defs

/-!
# Sheaves of modules of finite type which are locally constant

Let `(C, J)` be a site and `Λ` a ring. A sheaf of `Λ`-modules `F` is *of finite type*
(Stacks 03DL (5)) when every object `U` has a covering `{Vᵢ ⟶ U}` such that each `F|_{Vᵢ}` is
generated by finitely many global sections (Stacks 03DE (5)), that is, receives an epimorphism
from a finite direct sum `⊕ⱼ₌₁ⁿ Λ̲ = (Λ^{⊕n})̲` of copies of the constant sheaf `Λ̲`. This file
proves that, for `Λ` Noetherian, `F` is of finite type and locally constant exactly when every
object has a covering on whose members `F` is the constant sheaf on a finitely generated
`Λ`-module, which is `Stacks.ConstantSheaf.IsFiniteTypeLocallyConstantModuleSheaf`.

## Main definitions

* `Stacks.ConstantSheaf.IsGeneratedByFiniteSections`: there is an epimorphism `E̲ ⟶ F` from the
  constant sheaf on a finitely generated module `E`.
* `Stacks.ConstantSheaf.IsFiniteTypeModuleSheaf`: locally on the site, `F` is generated by
  finitely many global sections.

## Main results

* `Stacks.ConstantSheaf.isFiniteTypeModuleSheaf_and_isLocallyConstant_iff`: over a Noetherian
  ring, `F` is of finite type and locally constant if and only if it is locally the constant
  sheaf on a finitely generated module.

## Implementation notes

The module universe is `max u v w`, which contains the site universes, so that sheafification
exists and every instance needed is found by search; the ring universe `r` is independent. Since
`Λ` itself need not live in the module universe, generation by finitely many sections is phrased
as an epimorphism from `E̲` for a finitely generated `E`, rather than from `(Λ^{⊕n})̲`. The two
agree: `n` generators of `E` give a surjection `Λ^{⊕n} ⟶ E`, whose constant sheaf map is an
epimorphism, and conversely `Λ^{⊕n}` is finitely generated whenever it is a module of the
universe. Global sections of `F|_V` are morphisms from `Λ̲`, by the adjunction between the
constant sheaf and sections over the terminal object `𝟙 V` of the slice site `C/V`.

Mathlib's `SheafOfModules.IsFiniteType` is the same condition for a sheaf of modules over a sheaf
of rings. A sheaf of `Λ`-modules is one over `Λ̲`
(`Stacks.ConstantSheaf.constantSheafModuleEquivalence`), but that equivalence asks the ring and the
modules to share a universe, which the coefficient universes of the étale site do not, so the
condition is stated here on `Sheaf J (ModuleCat Λ)`.

The converse direction is the substance. Suppose `F|_Y ≅ M̲` and `ξ : E̲ ⟶ M̲` is an
epimorphism with `E` finitely generated, hence finitely presented as `Λ` is Noetherian. Then `ξ`
is locally the constant sheaf map `ψ̲` of a module map `ψ : E ⟶ M`
(`Stacks.ConstantSheaf.exists_cover_app_eq_constantSheaf_map`, the engine of Tag 093S). There
`ψ̲` is an epimorphism, so for the inclusion `ι : im ψ ⟶ M` the map `ι̲` is an epimorphism, and it
is a monomorphism because the constant sheaf functor is left exact. Hence `M̲ ≅ (im ψ)̲` with
`im ψ` finitely generated. No case distinction on empty objects of the site is needed.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 03DE](https://stacks.math.columbia.edu/tag/03DE)
* [Stacks Project, Tag 093Q](https://stacks.math.columbia.edu/tag/093Q)
* [Stacks Project, Tag 093S](https://stacks.math.columbia.edu/tag/093S)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Stacks.ConstantSheaf

universe v u w r

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable (Λ : Type r) [Ring Λ]

/-- **Generated by finitely many global sections** (Stacks 03DE (5)). A sheaf of `Λ`-modules is
generated by finitely many global sections when it receives an epimorphism from the constant
sheaf on a finitely generated `Λ`-module. Choosing `n` generators of that module, this is an
epimorphism from `(Λ^{⊕n})̲ = ⊕ⱼ₌₁ⁿ Λ̲`, i.e. `n` global sections generating the sheaf. -/
def IsGeneratedByFiniteSections (F : Sheaf J (ModuleCat.{max u v w} Λ)) : Prop :=
  ∃ (E : ModuleCat.{max u v w} Λ) (_ : ModuleCat.isFG Λ E)
    (π : (constantSheaf J (ModuleCat.{max u v w} Λ)).obj E ⟶ F), Epi π

/-- **Of finite type** (Stacks 03DL (5)). A sheaf of `Λ`-modules is of finite type when every
object of the site has a covering family on each member of which the restricted sheaf is
generated by finitely many global sections. -/
def IsFiniteTypeModuleSheaf (F : Sheaf J (ModuleCat.{max u v w} Λ)) : Prop :=
  ∀ U : C, ∃ (I : Type (max u v)) (V : I → C) (f : ∀ i, V i ⟶ U),
    Sieve.ofArrows V f ∈ J U ∧ ∀ i,
      IsGeneratedByFiniteSections.{v, max u v, w} (J.over (V i)) Λ
        ((J.overPullback (ModuleCat.{max u v w} Λ) (V i)).obj F)

variable {J Λ}

/-- A sheaf which is locally the constant sheaf on a finitely generated module is locally
constant. -/
theorem isLocallyConstant_of_isFiniteTypeLocallyConstantModuleSheaf
    {F : Sheaf J (ModuleCat.{max u v w} Λ)}
    (hF : IsFiniteTypeLocallyConstantModuleSheaf.{v, u, w} J Λ F) :
    IsLocallyConstant J F where
  exists_cover U := by
    obtain ⟨I, V, f, hcov, h⟩ := hF U
    exact ⟨I, V, f, hcov, fun i => (h i).elim fun E ⟨_, ⟨e⟩⟩ => ⟨⟨E, ⟨e⟩⟩⟩⟩

/-- A sheaf which is locally the constant sheaf on a finitely generated module is of finite
type: on each trivializing object the trivialization itself is the required epimorphism. -/
theorem isFiniteTypeModuleSheaf_of_isFiniteTypeLocallyConstantModuleSheaf
    {F : Sheaf J (ModuleCat.{max u v w} Λ)}
    (hF : IsFiniteTypeLocallyConstantModuleSheaf.{v, u, w} J Λ F) :
    IsFiniteTypeModuleSheaf J Λ F := by
  intro U
  obtain ⟨I, V, f, hcov, h⟩ := hF U
  exact ⟨I, V, f, hcov, fun i => (h i).elim fun E ⟨hE, ⟨e⟩⟩ => ⟨E, hE, e.hom, inferInstance⟩⟩

/-- Restriction along a morphism of slice sites preserves epimorphisms: it is a left adjoint,
because `Over.map q` is cocontinuous. -/
theorem epi_overMapPullback_map {Y W : C} (q : Y ⟶ W)
    {G H : Sheaf (J.over W) (ModuleCat.{max u v w} Λ)} (π : G ⟶ H) [Epi π] :
    Epi ((J.overMapPullback (ModuleCat.{max u v w} Λ) q).map π) := by
  have := ((Over.map q).sheafAdjunctionCocontinuous (ModuleCat.{max u v w} Λ)
    (J.over Y) (J.over W)).isLeftAdjoint
  infer_instance

variable [IsNoetherianRing Λ]

/-- **The key step.** If `F|_Y ≅ M̲` and some constant sheaf on a finitely generated module maps
epimorphically onto `M̲`, then `Y` is covered by objects over which `F` is the constant sheaf on a
finitely generated module. -/
theorem trivSieve_mem_of_epi {F : Sheaf J (ModuleCat.{max u v w} Λ)} {Y₀ : C}
    (P M : ModuleCat.{max u v w} Λ) (hP : ModuleCat.isFG Λ P)
    (ξ : (constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).obj P ⟶
      (constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).obj M) [Epi ξ]
    (α : (constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).obj M ≅
      (J.overPullback (ModuleCat.{max u v w} Λ) Y₀).obj F) :
    trivSieve J Λ F Y₀ ∈ J Y₀ := by
  have hfin : Module.Finite Λ (P : Type (max u v w)) := hP
  have : Module.FinitePresentation Λ (P : Type (max u v w)) :=
    Module.finitePresentation_of_finite Λ _
  obtain ⟨I, V, g, hcov, hloc⟩ :=
    exists_cover_app_eq_constantSheaf_map (J.over Y₀) P M ξ (Over.mk (𝟙 Y₀))
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows] at hcov
  refine J.superset_covering ?_ hcov
  rw [Sieve.generate_le_iff]
  rintro Z p ⟨i⟩
  obtain ⟨ψ, hψ⟩ := hloc i
  show IsConstantFGOver J Λ (V i).left F
  have hres : (J.overMapPullback (ModuleCat.{max u v w} Λ) (V i).hom).map ξ =
      (J.overMapPullback (ModuleCat.{max u v w} Λ) (V i).hom).map
        ((constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).map ψ) :=
    Sheaf.hom_ext (NatTrans.ext (funext fun T =>
      hψ ((Over.map (V i).hom).obj T.unop) (Over.homMk T.unop.hom)))
  -- over `(V i).left`, the restriction of `ξ` is the constant sheaf map of `ψ`
  have hψepi : Epi ((constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map ψ) := by
    have h₁ := epi_overMapPullback_map (J := J) (Λ := Λ) (V i).hom ξ
    rw [hres] at h₁
    have e : (constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map ψ =
        (mapPullbackConstantSheafApp J (ModuleCat.{max u v w} Λ) (V i).hom P).hom ≫
          (J.overMapPullback (ModuleCat.{max u v w} Λ) (V i).hom).map
            ((constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).map ψ) ≫
          (mapPullbackConstantSheafApp J (ModuleCat.{max u v w} Λ) (V i).hom M).inv := by
      rw [← Category.assoc, ← mapPullbackConstantSheafApp_naturality, Category.assoc,
        Iso.hom_inv_id, Category.comp_id]
    rw [e]
    infer_instance
  -- factor `ψ` through its image, which is finitely generated
  let N : ModuleCat.{max u v w} Λ := ModuleCat.of Λ (LinearMap.range ψ.hom)
  let ι : N ⟶ M := ModuleCat.ofHom (LinearMap.range ψ.hom).subtype
  let π' : P ⟶ N := ModuleCat.ofHom ψ.hom.rangeRestrict
  have hfac : ψ = π' ≫ ι := by ext x; rfl
  have hN : ModuleCat.isFG Λ N := by
    rw [ModuleCat.isFG_iff]
    exact Module.Finite.range ψ.hom
  have hιmono : Mono ι := (ModuleCat.mono_iff_injective _).2 Subtype.val_injective
  have hepi : Epi ((constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map ι) := by
    rw [hfac, Functor.map_comp] at hψepi
    exact epi_of_epi ((constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map π') _
  have : IsIso ((constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map ι) :=
    isIso_of_mono_of_epi _
  exact ⟨N, hN, ⟨asIso ((constantSheaf (J.over (V i).left) (ModuleCat.{max u v w} Λ)).map ι) ≪≫
    restrictTrivIso J Λ (V i).hom M α⟩⟩

/-- **Finite type and locally constant.** Over a Noetherian ring, a sheaf of `Λ`-modules is of
finite type (Stacks 03DL (5)) and locally constant (Stacks 093Q (2)) if and only if every object
of the site has a covering on whose members it is the constant sheaf on a finitely generated
`Λ`-module. -/
theorem isFiniteTypeModuleSheaf_and_isLocallyConstant_iff
    (F : Sheaf J (ModuleCat.{max u v w} Λ)) :
    IsFiniteTypeModuleSheaf J Λ F ∧ IsLocallyConstant J F ↔
      IsFiniteTypeLocallyConstantModuleSheaf.{v, u, w} J Λ F := by
  refine ⟨fun ⟨hft, hlc⟩ => ?_, fun hF =>
    ⟨isFiniteTypeModuleSheaf_of_isFiniteTypeLocallyConstantModuleSheaf hF,
      isLocallyConstant_of_isFiniteTypeLocallyConstantModuleSheaf hF⟩⟩
  rw [isFiniteTypeLocallyConstantModuleSheaf_iff_trivSieve_mem]
  intro U
  obtain ⟨I, V, f, hcov, hconst⟩ := hlc.exists_cover U
  obtain ⟨I', V', f', hcov', hgen⟩ := hft U
  refine trivSieve_mem_of_cover (J.intersection_covering hcov hcov') ?_
  rintro Y₀ g ⟨⟨_, a, _, ⟨i⟩, rfl⟩, ⟨_, a', _, ⟨i'⟩, hg⟩⟩
  obtain ⟨M, ⟨e⟩⟩ := (hconst i).mem_essImage
  obtain ⟨E, hE, π, hπ⟩ := hgen i'
  let α := restrictTrivIso J Λ a M e
  let πY : (constantSheaf (J.over Y₀) (ModuleCat.{max u v w} Λ)).obj E ⟶
      (J.overPullback (ModuleCat.{max u v w} Λ) Y₀).obj F :=
    (mapPullbackConstantSheafApp J (ModuleCat.{max u v w} Λ) a' E).hom ≫
      (J.overMapPullback (ModuleCat.{max u v w} Λ) a').map π
  have : Epi πY :=
    @epi_comp _ _ _ _ _ _ inferInstance _ (epi_overMapPullback_map (J := J) (Λ := Λ) a' π)
  have : Epi (πY ≫ α.inv) := epi_comp _ _
  exact trivSieve_mem_of_epi E M hE (πY ≫ α.inv) α

end Stacks.ConstantSheaf

end
