module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.LinearAlgebra.Quotient.Basic
import StacksCore.Tactic.StacksAttribute

/-!
# The colimit of a system of modules as a quotient of the direct sum

For a system `(M_i, μ_ij)` of modules over a preordered set `I`, the quotient
`(⨁ i, M i) / Q`, where `Q` is generated by the elements `ι_i x - ι_j (μ_ij x)`, together with
the maps `φ_i = π ∘ ι_i`, is the colimit of the system (Stacks Lemma 10.8.2, tag 00D5).

## Main definitions

* `Module.colimitRelations`: the submodule `Q`.
* `Module.ColimitQuotient`: the quotient `(⨁ i, M i) / Q`.
* `Module.ColimitQuotient.of`: the maps `φ_i`.

## Main results

* `Module.ColimitQuotient.of_comp`: `φ_j ∘ μ_ij = φ_i`.
* `Module.ColimitQuotient.existsUnique_comp_eq`: the universal property of the colimit.
-/

namespace Module

section ColimitQuotient

variable {R : Type*} [Ring R] {ι : Type*} [Preorder ι] [DecidableEq ι] (M : ι → Type*)
  [(i : ι) → AddCommGroup (M i)] [(i : ι) → Module R (M i)]
  (μ : (i j : ι) → i ≤ j → M i →ₗ[R] M j)

/-- The submodule `Q` of `⨁ i, M i` generated by the elements `ι_i x - ι_j (μ_ij x)`,
for `i ≤ j` and `x ∈ M i`. -/
public def colimitRelations : Submodule R (DirectSum ι M) :=
  Submodule.span R {z | ∃ (i j : ι) (h : i ≤ j) (x : M i),
    z = DirectSum.lof R ι M i x - DirectSum.lof R ι M j (μ i j h x)}

/-- The quotient module `(⨁ i, M i) / Q` of Stacks Lemma 10.8.2. -/
public abbrev ColimitQuotient : Type _ := DirectSum ι M ⧸ colimitRelations M μ

/-- The map `φ_i = π ∘ ι_i : M i → (⨁ i, M i) / Q`. -/
public def ColimitQuotient.of (i : ι) : M i →ₗ[R] ColimitQuotient M μ :=
  (colimitRelations M μ).mkQ ∘ₗ DirectSum.lof R ι M i

variable {M μ}

/-- The maps `φ_i` are compatible with the transition maps: `φ_j ∘ μ_ij = φ_i`. -/
public theorem ColimitQuotient.of_comp {i j : ι} (h : i ≤ j) :
    ColimitQuotient.of M μ j ∘ₗ μ i j h = ColimitQuotient.of M μ i := by
  ext x
  simp only [ColimitQuotient.of, LinearMap.coe_comp, Function.comp_apply, Submodule.mkQ_apply]
  rw [eq_comm, Submodule.Quotient.eq]
  exact Submodule.subset_span ⟨i, j, h, x, rfl⟩

/-- **Stacks Lemma 10.8.2**: for a system `(M_i, μ_ij)` of modules over a preordered set `I`,
the quotient `(⨁ i, M i) / Q` together with the maps `φ_i = π ∘ ι_i` is the colimit:
for every module `Y` and maps `ψ_i : M_i → Y` with `ψ_j ∘ μ_ij = ψ_i`, there is a unique
`g : (⨁ i, M i) / Q → Y` with `g ∘ φ_i = ψ_i` for all `i`. The compatibility
`φ_j ∘ μ_ij = φ_i` is `ColimitQuotient.of_comp`. -/
@[stacks 00D5 "The identities `μ_ii = id` and `μ_ik = μ_jk ∘ μ_ij` of a system are not needed."]
public theorem ColimitQuotient.existsUnique_comp_eq {Y : Type*} [AddCommGroup Y] [Module R Y]
    (ψ : (i : ι) → M i →ₗ[R] Y) (hψ : ∀ (i j : ι) (h : i ≤ j), ψ j ∘ₗ μ i j h = ψ i) :
    ∃! g : ColimitQuotient M μ →ₗ[R] Y, ∀ i, g ∘ₗ ColimitQuotient.of M μ i = ψ i := by
  have hQ : colimitRelations M μ ≤ LinearMap.ker (DirectSum.toModule R ι Y ψ) := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨i, j, h, x, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, DirectSum.toModule_lof, sub_eq_zero]
    exact (LinearMap.congr_fun (hψ i j h) x).symm
  refine ⟨(colimitRelations M μ).liftQ _ hQ, fun i ↦ ?_, fun g hg ↦ ?_⟩
  · ext x
    simp [ColimitQuotient.of]
  · refine Submodule.linearMap_qext _ (DirectSum.linearMap_ext R fun i ↦ ?_)
    ext x
    simpa [ColimitQuotient.of] using LinearMap.congr_fun (hg i) x

end ColimitQuotient

end Module
