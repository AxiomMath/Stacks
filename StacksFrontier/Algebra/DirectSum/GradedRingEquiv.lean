module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.DirectSum.Ring

/-!
# A degreewise family of additive equivalences that respects the graded multiplication

A family of additive equivalences `A i ≃+ B i` assembles to an additive equivalence
`(⨁ i, A i) ≃+ ⨁ i, B i`. **This file gives the condition under which it is a ring
equivalence**: it is enough that the family respects the graded multiplication degreewise, because
`DirectSum.of_mul_of` reduces multiplicativity to homogeneous elements.

## Main definitions

* `DirectSum.gradedCongr`: the assembled additive equivalence.
* `DirectSum.gradedCongrRingEquiv`: **the resulting ring equivalence**, given degreewise
  multiplicativity.

## Main results

* `DirectSum.gradedCongr_of`: the assembled equivalence on a homogeneous element.
* `DirectSum.gradedCongr_mul_of_gMul`: **the assembled equivalence is multiplicative** as soon as
  the family is, degreewise.

## Implementation notes

**Why not `DirectSum.congrAddEquiv`.** Mathlib's `DirectSum.congrAddEquiv` carries a scalar ring
`R` with `[∀ i, Module R (A i)]` and `[∀ i, Module R (B i)]`, and `R` is an implicit argument that
the conclusion does not determine. So every use leaves `Module ?R (A i)` to instance search with
`?R` a metavariable, which does not fail — it runs until the heartbeat budget is gone. On
the graded ring of homogeneous sections of a symmetric algebra, a single application exceeds the
default budget. `DirectSum.gradedCongr` is the same map built from `DirectSum.map`, which needs
only `AddCommMonoid`, so there is no scalar ring to guess.

**Why this is a separate file.** The double induction over `DirectSum.induction_on` is run once
here, where the types are abstract and the rewrites are therefore cheap. Run at the point of use
the same proof costs a `whnf` timeout as soon as the degreewise types are large — which they are
whenever the grading comes from sections of a sheaf, where each index is a composite of functors.

`map_one` is not a hypothesis. A multiplicative equivalence of monoids preserves the unit, so
`RingEquiv` is already determined by the additive equivalence together with multiplicativity.
-/

@[expose] public section

open scoped DirectSum

namespace DirectSum

variable {ι : Type*} [DecidableEq ι]
  {A : ι → Type*} [∀ i, AddCommMonoid (A i)]
  {B : ι → Type*} [∀ i, AddCommMonoid (B i)]
  (e : ∀ i, A i ≃+ B i)

/-- **Direct sums of degreewise isomorphic additive monoids are isomorphic**: the additive
equivalence `(⨁ i, A i) ≃+ ⨁ i, B i` acting as `e i` in each degree `i`. This is
`DirectSum.congrAddEquiv` without its scalar ring; see the implementation notes for why the
scalar ring has to go. -/
def gradedCongr : (⨁ i, A i) ≃+ ⨁ i, B i where
  toFun := DirectSum.map fun i => (e i).toAddMonoidHom
  invFun := DirectSum.map fun i => (e i).symm.toAddMonoidHom
  map_add' := map_add (DirectSum.map fun i => (e i).toAddMonoidHom)
  left_inv x := by
    induction x using DirectSum.induction_on with
    | zero => simp
    | of i a => rw [map_of, map_of]; simp
    | add a b ha hb => rw [map_add, map_add, ha, hb]
  right_inv y := by
    induction y using DirectSum.induction_on with
    | zero => simp
    | of i b => rw [map_of, map_of]; simp
    | add a b ha hb => rw [map_add, map_add, ha, hb]

/-- `DirectSum.gradedCongr e` sends the homogeneous element `of A i x` to `of B i (e i x)`. -/
@[simp]
theorem gradedCongr_of (i : ι) (x : A i) : gradedCongr e (of A i x) = of B i (e i x) :=
  map_of (fun i => (e i).toAddMonoidHom) i x

section Mul

variable [AddMonoid ι] [GNonUnitalNonAssocSemiring A] [GNonUnitalNonAssocSemiring B]

/-- **A degreewise family of additive equivalences that respects the graded multiplication
assembles to a multiplicative map of the direct sums.** Both sides are generated by their
homogeneous elements, so `DirectSum.of_mul_of` reduces the statement to the hypothesis. -/
theorem gradedCongr_mul_of_gMul
    (hmul : ∀ (i j : ι) (x : A i) (y : A j),
      e (i + j) (GradedMonoid.GMul.mul x y) = GradedMonoid.GMul.mul (e i x) (e j y))
    (a b : ⨁ i, A i) :
    gradedCongr e (a * b) = gradedCongr e a * gradedCongr e b := by
  induction a using DirectSum.induction_on with
  | zero => simp
  | of i x =>
      induction b using DirectSum.induction_on with
      | zero => simp
      | of j y => rw [of_mul_of, gradedCongr_of, gradedCongr_of, gradedCongr_of, of_mul_of, hmul]
      | add y y' hy hy' => rw [mul_add, map_add, map_add, hy, hy', mul_add]
  | add x x' hx hx' => rw [add_mul, map_add, map_add, hx, hx', add_mul]

end Mul

section Semiring

variable [AddMonoid ι] [GSemiring A] [GSemiring B]

/-- **The ring equivalence of direct sums attached to a degreewise family of additive
equivalences that respects the graded multiplication.** -/
def gradedCongrRingEquiv
    (hmul : ∀ (i j : ι) (x : A i) (y : A j),
      e (i + j) (GradedMonoid.GMul.mul x y) = GradedMonoid.GMul.mul (e i x) (e j y)) :
    (⨁ i, A i) ≃+* ⨁ i, B i :=
  { gradedCongr e with map_mul' := gradedCongr_mul_of_gMul e hmul }

/-- The ring equivalence `DirectSum.gradedCongrRingEquiv e hmul` acts as
`DirectSum.gradedCongr e`. -/
@[simp]
theorem gradedCongrRingEquiv_apply
    (hmul : ∀ (i j : ι) (x : A i) (y : A j),
      e (i + j) (GradedMonoid.GMul.mul x y) = GradedMonoid.GMul.mul (e i x) (e j y))
    (a : ⨁ i, A i) :
    gradedCongrRingEquiv e hmul a = gradedCongr e a :=
  rfl

end Semiring

end DirectSum

end
