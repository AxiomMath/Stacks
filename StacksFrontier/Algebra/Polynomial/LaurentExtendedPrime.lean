module

public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import Mathlib.RingTheory.Algebraic.Basic
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Integral
public import Mathlib.RingTheory.Polynomial.Basic
public import StacksFrontier.Algebra.Polynomial.Laurent

/-!
# The generic point of a fibre of `Spec R[T, T⁻¹] ⟶ Spec R`

Let `R` be a commutative ring and `𝔭` a prime of `R`.  The extension `𝔮 = 𝔭 R[T, T⁻¹]` is a prime
of the Laurent polynomial ring lying over `𝔭`, and it is contained in every prime lying over `𝔭`:
it is the generic point of the fibre of `Spec R[T, T⁻¹] ⟶ Spec R` over `𝔭`.  This file proves that
the local homomorphism `R_𝔭 ⟶ R[T, T⁻¹]_𝔮` has the properties of clause (7) of Stacks 0EQG: it
carries the maximal ideal onto the maximal ideal, and the residue field extension
`κ(𝔭) ⊆ κ(𝔮)` is purely transcendental of transcendence degree one, generated by the image of
`T`.

## Main definitions

* `LaurentPolynomial.extendedPrime`: the prime `𝔭 R[T, T⁻¹]`.
* `IsLocalRing.IsTranscendentalOneLocalHom`: a local homomorphism of local rings which carries the
  maximal ideal onto the maximal ideal and whose residue field extension is generated by one
  transcendental element.

## Main results

* `LaurentPolynomial.isTranscendentalOneLocalHom_localRingHom`: the property for
  `R_𝔭 ⟶ R[T, T⁻¹]_𝔮`.
* `IsLocalRing.IsTranscendentalOneLocalHom.of_comm`: the property is transported along a
  commuting square whose sides carry maximal ideals onto maximal ideals and are bijective on
  residue fields.
-/

@[expose] public noncomputable section

open IsLocalRing Polynomial

universe u

namespace IsLocalRing

/-- A local homomorphism `f : A ⟶ B` of local rings is *transcendental of degree one* when
`𝔪_A B = 𝔪_B` and the residue field `κ(B)` is generated over `κ(A)` by a single transcendental
element, i.e. is a purely transcendental extension of transcendence degree one. -/
structure IsTranscendentalOneLocalHom {A B : Type*} [CommRing A] [CommRing B] [IsLocalRing A]
    [IsLocalRing B] (f : A →+* B) : Prop where
  /-- The homomorphism `f` is local. -/
  isLocalHom : IsLocalHom f
  /-- The maximal ideal of `A` generates the maximal ideal of `B`. -/
  map_maximalIdeal : Ideal.map f (maximalIdeal A) = maximalIdeal B
  /-- The residue field of `B` is generated over that of `A` by one transcendental element. -/
  exists_transcendental :
    letI := (@ResidueField.map _ _ _ _ _ _ f isLocalHom).toAlgebra
    ∃ t : ResidueField B, Transcendental (ResidueField A) t ∧
      IntermediateField.adjoin (ResidueField A) {t} = ⊤

/-- A generator of a field extension which is transcendental is carried to one along a commuting
square of isomorphisms of fields. -/
theorem transcendental_adjoin_of_ringEquiv {K L K' L' : Type*} [Field K] [Field L] [Field K']
    [Field L'] [Algebra K L] [Algebra K' L'] (eK : K ≃+* K') (eL : L ≃+* L')
    (h : ∀ k, eL (algebraMap K L k) = algebraMap K' L' (eK k)) {t : L}
    (ht : Transcendental K t) (hadj : IntermediateField.adjoin K {t} = ⊤) :
    Transcendental K' (eL t) ∧ IntermediateField.adjoin K' {eL t} = ⊤ := by
  have hcomp : ((eL : L →+* L').comp (algebraMap K L)).comp (eK.symm : K' →+* K) =
      algebraMap K' L' := RingHom.ext fun k => by simp [h]
  constructor
  · rw [transcendental_iff] at ht ⊢
    intro g hg
    have h0 : Polynomial.aeval t (g.map (eK.symm : K' →+* K)) = 0 := by
      apply eL.injective
      rw [map_zero, Polynomial.aeval_def, ← RingEquiv.coe_toRingHom, Polynomial.hom_eval₂,
        Polynomial.eval₂_map, RingEquiv.coe_toRingHom, hcomp, ← Polynomial.aeval_def, hg]
    have h3 := congrArg (Polynomial.map (eK : K →+* K')) (ht _ h0)
    rwa [Polynomial.map_map, show (eK : K →+* K').comp (eK.symm : K' →+* K) = RingHom.id K' from
      RingHom.ext fun k => by simp, Polynomial.map_id, Polynomial.map_zero] at h3
  · set F' := IntermediateField.adjoin K' {eL t}
    let F : IntermediateField K L :=
      { (F'.toSubfield.comap (eL : L →+* L')) with
        algebraMap_mem' := fun k => by
          show eL (algebraMap K L k) ∈ F'
          rw [h]
          exact F'.algebraMap_mem _ }
    have hle : IntermediateField.adjoin K {t} ≤ F := by
      rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      exact IntermediateField.subset_adjoin K' {eL t} rfl
    rw [hadj] at hle
    rw [eq_top_iff]
    intro y _
    obtain ⟨x, rfl⟩ := eL.surjective y
    exact hle IntermediateField.mem_top

/-- **The property is transported along a commuting square** whose sides carry maximal ideals
onto maximal ideals and are bijective on residue fields. -/
theorem IsTranscendentalOneLocalHom.of_comm {A B A' B' : Type*} [CommRing A] [CommRing B]
    [CommRing A'] [CommRing B'] [IsLocalRing A] [IsLocalRing B] [IsLocalRing A']
    [IsLocalRing B'] (f : A →+* B) (f' : A' →+* B') (a : A →+* A') (b : B →+* B')
    [IsLocalHom f'] [IsLocalHom a] [IsLocalHom b]
    (hcomm : b.comp f = f'.comp a)
    (ha : Ideal.map a (maximalIdeal A) = maximalIdeal A')
    (hb : Ideal.map b (maximalIdeal B) = maximalIdeal B')
    (ha' : Function.Bijective (ResidueField.map a))
    (hb' : Function.Bijective (ResidueField.map b))
    (hf : IsTranscendentalOneLocalHom f) : IsTranscendentalOneLocalHom f' where
  isLocalHom := inferInstance
  map_maximalIdeal := by
    rw [← ha, Ideal.map_map, ← hcomm, ← Ideal.map_map, hf.map_maximalIdeal, hb]
  exists_transcendental := by
    have := hf.isLocalHom
    obtain ⟨t, ht, hadj⟩ := hf.exists_transcendental
    let := (ResidueField.map f).toAlgebra
    let := (ResidueField.map f').toAlgebra
    have hres : ∀ k, (ResidueField.map b) (ResidueField.map f k) =
        ResidueField.map f' (ResidueField.map a k) := by
      intro k
      obtain ⟨k, rfl⟩ := residue_surjective k
      simp only [ResidueField.map_residue]
      exact congrArg (residue B') (RingHom.congr_fun hcomm k)
    exact ⟨_, transcendental_adjoin_of_ringEquiv (RingEquiv.ofBijective _ ha')
      (RingEquiv.ofBijective _ hb') hres ht hadj⟩

/-- A bijective local homomorphism carries the maximal ideal onto the maximal ideal. -/
theorem map_maximalIdeal_of_bijective {A A' : Type*} [CommRing A] [CommRing A'] [IsLocalRing A]
    [IsLocalRing A'] (a : A →+* A') (ha : Function.Bijective a) :
    Ideal.map a (maximalIdeal A) = maximalIdeal A' :=
  IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv (RingEquiv.ofBijective a ha))

/-- A bijective local homomorphism is bijective on residue fields. -/
theorem bijective_residueFieldMap_of_bijective {A A' : Type*} [CommRing A] [CommRing A']
    [IsLocalRing A] [IsLocalRing A'] (a : A →+* A') [IsLocalHom a] (ha : Function.Bijective a) :
    Function.Bijective (ResidueField.map a) := by
  refine ⟨(ResidueField.map a).injective, fun y => ?_⟩
  obtain ⟨y, rfl⟩ := residue_surjective y
  obtain ⟨x, rfl⟩ := ha.2 y
  exact ⟨residue A x, ResidueField.map_residue a x⟩

/-- The property is transported along a commuting square of bijective local homomorphisms. -/
theorem IsTranscendentalOneLocalHom.of_comm_of_bijective {A B A' B' : Type*} [CommRing A]
    [CommRing B] [CommRing A'] [CommRing B'] [IsLocalRing A] [IsLocalRing B] [IsLocalRing A']
    [IsLocalRing B'] (f : A →+* B) (f' : A' →+* B') (a : A →+* A') (b : B →+* B')
    [IsLocalHom f'] [IsLocalHom a] [IsLocalHom b]
    (hcomm : b.comp f = f'.comp a) (ha : Function.Bijective a) (hb : Function.Bijective b)
    (hf : IsTranscendentalOneLocalHom f) : IsTranscendentalOneLocalHom f' :=
  hf.of_comm f f' a b hcomm (map_maximalIdeal_of_bijective a ha)
    (map_maximalIdeal_of_bijective b hb)
    (bijective_residueFieldMap_of_bijective a ha) (bijective_residueFieldMap_of_bijective b hb)

/-- A bijective ring homomorphism is local. -/
theorem isLocalHom_of_bijective {A A' : Type*} [CommRing A] [CommRing A'] (a : A →+* A')
    (ha : Function.Bijective a) : IsLocalHom a :=
  ⟨fun x hx => by
    have h := hx.map (RingEquiv.ofBijective a ha).symm
    rwa [show (RingEquiv.ofBijective a ha).symm (a x) = x from
      (RingEquiv.ofBijective a ha).symm_apply_apply x] at h⟩

/-- The property survives precomposition with a bijective homomorphism. -/
theorem IsTranscendentalOneLocalHom.comp_bijective {A B A' : Type*} [CommRing A] [CommRing B]
    [CommRing A'] [IsLocalRing A] [IsLocalRing B] [IsLocalRing A'] (f : A →+* B)
    (e : A' →+* A) (he : Function.Bijective e) (hf : IsTranscendentalOneLocalHom f) :
    IsTranscendentalOneLocalHom (f.comp e) := by
  have := hf.isLocalHom
  have := isLocalHom_of_bijective e he
  let e' : A →+* A' := (RingEquiv.ofBijective e he).symm
  have : IsLocalHom e' := isLocalHom_of_bijective e' (RingEquiv.ofBijective e he).symm.bijective
  refine hf.of_comm_of_bijective f (f.comp e) e' (RingHom.id B) ?_
    (RingEquiv.ofBijective e he).symm.bijective Function.bijective_id
  ext x
  show f x = f (e ((RingEquiv.ofBijective e he).symm x))
  exact congrArg f ((RingEquiv.ofBijective e he).apply_symm_apply x).symm

/-- The property survives postcomposition with a bijective homomorphism. -/
theorem IsTranscendentalOneLocalHom.bijective_comp {A B B' : Type*} [CommRing A] [CommRing B]
    [CommRing B'] [IsLocalRing A] [IsLocalRing B] [IsLocalRing B'] (f : A →+* B)
    (e : B →+* B') (he : Function.Bijective e) (hf : IsTranscendentalOneLocalHom f) :
    IsTranscendentalOneLocalHom (e.comp f) :=
  have := hf.isLocalHom
  have := isLocalHom_of_bijective e he
  hf.of_comm_of_bijective f (e.comp f) (RingHom.id A) e rfl Function.bijective_id he

end IsLocalRing

namespace LaurentPolynomial

variable {R : Type u} [CommRing R] (p : Ideal R) [p.IsPrime]

/-- The extension `𝔭 R[T, T⁻¹]` of a prime of `R` to the Laurent polynomial ring. -/
def extendedPrime : Ideal (LaurentPolynomial R) :=
  p.map (algebraMap R (LaurentPolynomial R))

/-- The structure map `R ⟶ R[T, T⁻¹]` factors as `R ⟶ R[X] ⟶ R[T, T⁻¹]`. -/
theorem algebraMap_eq_comp :
    algebraMap R (LaurentPolynomial R) =
      (algebraMap (Polynomial R) (LaurentPolynomial R)).comp Polynomial.C :=
  RingHom.ext fun r => (Polynomial.toLaurent_C r).symm

omit [p.IsPrime] in
/-- The extended prime `𝔭 R[T, T⁻¹]` is the extension of `𝔭 R[X]` along `R[X] ⟶ R[T, T⁻¹]`. -/
theorem extendedPrime_eq :
    extendedPrime p =
      (p.map Polynomial.C).map (algebraMap (Polynomial R) (LaurentPolynomial R)) := by
  rw [extendedPrime, Ideal.map_map, ← algebraMap_eq_comp]

/-- No power of `X` lies in `𝔭 R[X]`. -/
theorem disjoint_powers_X :
    Disjoint ((Submonoid.powers (X : Polynomial R) : Submonoid (Polynomial R)) : Set (Polynomial R))
      (p.map Polynomial.C : Ideal (Polynomial R)) := by
  rw [Set.disjoint_left]
  rintro _ ⟨n, rfl⟩ h
  have := (Ideal.mem_map_C_iff.1 h) n
  rw [Polynomial.coeff_X_pow_self] at this
  exact (Ideal.IsPrime.ne_top ‹p.IsPrime›) ((Ideal.eq_top_iff_one p).2 this)

/-- The extended prime `𝔭 R[T, T⁻¹]` is a prime ideal. -/
instance extendedPrime_isPrime : (extendedPrime p).IsPrime := by
  rw [extendedPrime_eq]
  exact IsLocalization.isPrime_of_isPrime_disjoint (Submonoid.powers X) _ _
    Ideal.isPrime_map_C_of_isPrime (disjoint_powers_X p)

/-- The extended prime, pulled back to the polynomial ring, is `𝔭 R[X]`. -/
theorem comap_extendedPrime_polynomial :
    (extendedPrime p).comap (algebraMap (Polynomial R) (LaurentPolynomial R)) =
      p.map Polynomial.C := by
  rw [extendedPrime_eq]
  exact IsLocalization.under_map_of_isPrime_disjoint (Submonoid.powers X) _
    Ideal.isPrime_map_C_of_isPrime (disjoint_powers_X p)

/-- **The extended prime lies over `𝔭`.** -/
theorem comap_extendedPrime : (extendedPrime p).comap (algebraMap R (LaurentPolynomial R)) = p := by
  rw [algebraMap_eq_comp, ← Ideal.comap_comap, comap_extendedPrime_polynomial]
  ext r
  rw [Ideal.mem_comap, Ideal.mem_map_C_iff]
  refine ⟨fun h => by simpa using h 0, fun h n => ?_⟩
  rw [Polynomial.coeff_C]
  split_ifs
  · exact h
  · exact p.zero_mem

omit [p.IsPrime] in
/-- **The extended prime is contained in every prime lying over `𝔭`**: it is the generic point of
the fibre. -/
theorem extendedPrime_le (Q : Ideal (LaurentPolynomial R))
    (hQ : Q.comap (algebraMap R (LaurentPolynomial R)) = p) : extendedPrime p ≤ Q := by
  rw [extendedPrime, Ideal.map_le_iff_le_comap, hQ]

/-! ### The local homomorphism at the generic point of the fibre -/

/-- The local homomorphism `R_𝔭 ⟶ R[T, T⁻¹]_𝔮` at the extended prime `𝔮 = 𝔭 R[T, T⁻¹]`. -/
abbrev extendedPrimeLocalRingHom :
    Localization.AtPrime p →+* Localization.AtPrime (extendedPrime p) :=
  Localization.localRingHom p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
    (comap_extendedPrime p).symm

/-- `𝔪_{R_𝔭} R[T, T⁻¹]_𝔮 = 𝔪_{R[T, T⁻¹]_𝔮}`. -/
theorem map_maximalIdeal_extendedPrimeLocalRingHom :
    Ideal.map (extendedPrimeLocalRingHom p) (maximalIdeal (Localization.AtPrime p)) =
      maximalIdeal (Localization.AtPrime (extendedPrime p)) := by
  rw [← Localization.AtPrime.map_eq_maximalIdeal (I := p), Ideal.map_map,
    ← Localization.AtPrime.map_eq_maximalIdeal (I := extendedPrime p)]
  have : (extendedPrimeLocalRingHom p).comp (algebraMap R (Localization.AtPrime p)) =
      (algebraMap (LaurentPolynomial R) (Localization.AtPrime (extendedPrime p))).comp
        (algebraMap R (LaurentPolynomial R)) :=
    RingHom.ext fun r => Localization.localRingHom_to_map p (extendedPrime p)
      (algebraMap R (LaurentPolynomial R)) (comap_extendedPrime p).symm r
  rw [this, ← Ideal.map_map]
  rfl

/-- The composite `R[T, T⁻¹] ⟶ κ(𝔮)`. -/
abbrev toExtendedPrimeResidueField : LaurentPolynomial R →+* (extendedPrime p).ResidueField :=
  algebraMap (LaurentPolynomial R) (extendedPrime p).ResidueField

/-- A Laurent polynomial vanishes in `κ(𝔮)` if and only if it lies in `𝔮`. -/
theorem toExtendedPrimeResidueField_eq_zero_iff (x : LaurentPolynomial R) :
    toExtendedPrimeResidueField p x = 0 ↔ x ∈ extendedPrime p := by
  rw [← RingHom.mem_ker, Ideal.ker_algebraMap_residueField]

/-- The image of `T` in the residue field `κ(𝔮)`. -/
abbrev extendedPrimeGenerator : (extendedPrime p).ResidueField :=
  toExtendedPrimeResidueField p (T 1)

/-- The image in `κ(𝔮)` of a polynomial `h` is `h` evaluated at the image of `T`, with
coefficients mapped to `κ(𝔮)`. -/
theorem toExtendedPrimeResidueField_toLaurent (h : Polynomial R) :
    toExtendedPrimeResidueField p (Polynomial.toLaurent h) =
      Polynomial.eval₂ ((toExtendedPrimeResidueField p).comp LaurentPolynomial.C)
        (extendedPrimeGenerator p) h := by
  rw [← Polynomial.coe_eval₂RingHom, ← RingHom.comp_apply]
  congr 1
  refine Polynomial.ringHom_ext (fun a => ?_) ?_ <;> simp

/-- The map `κ(𝔭) ⟶ κ(𝔮)` sends the residue of `r : R` to the image of the constant `C r`. -/
theorem residueFieldMap_algebraMap (r : R) :
    Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
        (comap_extendedPrime p).symm (algebraMap R p.ResidueField r) =
      toExtendedPrimeResidueField p (LaurentPolynomial.C r) := by
  rw [Ideal.ResidueField.map_algebraMap]
  rfl

/-- **The image of `T` in `κ(𝔮)` is transcendental over `κ(𝔭)`.** -/
theorem transcendental_extendedPrimeGenerator :
    letI := (Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
      (comap_extendedPrime p).symm).toAlgebra
    Transcendental p.ResidueField (extendedPrimeGenerator p) := by
  let := (Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
    (comap_extendedPrime p).symm).toAlgebra
  rw [transcendental_iff]
  intro g hg
  rw [Polynomial.aeval_def] at hg
  have hN := IsLocalization.integerNormalization_eval₂_eq_zero (nonZeroDivisors (R ⧸ p))
    (algebraMap p.ResidueField (extendedPrime p).ResidueField) g hg
  obtain ⟨h, hh⟩ := Polynomial.map_surjective (Ideal.Quotient.mk p) Ideal.Quotient.mk_surjective
    (IsLocalization.integerNormalization (nonZeroDivisors (R ⧸ p)) g)
  rw [← hh, Polynomial.eval₂_map] at hN
  have hcomp : ((algebraMap p.ResidueField (extendedPrime p).ResidueField).comp
      (algebraMap (R ⧸ p) p.ResidueField)).comp (Ideal.Quotient.mk p) =
      (toExtendedPrimeResidueField p).comp LaurentPolynomial.C := by
    refine RingHom.ext fun r => ?_
    show Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
        (comap_extendedPrime p).symm (algebraMap R p.ResidueField r) = _
    rw [residueFieldMap_algebraMap]
    rfl
  rw [hcomp, ← toExtendedPrimeResidueField_toLaurent, toExtendedPrimeResidueField_eq_zero_iff,
    ← Ideal.mem_comap] at hN
  change h ∈ (extendedPrime p).comap (algebraMap (Polynomial R) (LaurentPolynomial R)) at hN
  rw [comap_extendedPrime_polynomial] at hN
  have hzero : IsLocalization.integerNormalization (nonZeroDivisors (R ⧸ p)) g = 0 := by
    rw [← hh]
    ext n
    rw [Polynomial.coeff_map, Polynomial.coeff_zero, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_C_iff.1 hN n
  exact IsFractionRing.integerNormalization_eq_zero_iff.1 hzero

/-- **The image of `T` generates `κ(𝔮)` over `κ(𝔭)`.** -/
theorem adjoin_extendedPrimeGenerator :
    letI := (Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
      (comap_extendedPrime p).symm).toAlgebra
    IntermediateField.adjoin p.ResidueField {extendedPrimeGenerator p} = ⊤ := by
  let := (Ideal.ResidueField.map p (extendedPrime p) (algebraMap R (LaurentPolynomial R))
    (comap_extendedPrime p).symm).toAlgebra
  set F := IntermediateField.adjoin p.ResidueField {extendedPrimeGenerator p}
  have hgen : extendedPrimeGenerator p ∈ F := IntermediateField.subset_adjoin _ _ rfl
  have himage : ∀ x : LaurentPolynomial R, toExtendedPrimeResidueField p x ∈ F := by
    intro x
    induction x using LaurentPolynomial.induction_on' with
    | add a b ha hb =>
      rw [map_add]
      exact F.add_mem ha hb
    | C_mul_T n a =>
      rw [map_mul]
      refine F.mul_mem ?_ ?_
      · rw [← residueFieldMap_algebraMap]
        exact F.algebraMap_mem _
      · have h1 : ∀ k : ℕ, toExtendedPrimeResidueField p (T k) = extendedPrimeGenerator p ^ k :=
          fun k => by rw [← map_pow, T_pow, mul_one]
        have hT : toExtendedPrimeResidueField p (T n) = extendedPrimeGenerator p ^ n := by
          rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
          · rw [zpow_natCast, h1]
          · rw [zpow_neg, zpow_natCast, ← h1 k]
            refine eq_inv_of_mul_eq_one_left ?_
            rw [← map_mul, ← T_add, neg_add_cancel, T_zero, map_one]
        rw [hT]
        exact zpow_mem hgen n
  rw [eq_top_iff]
  rintro y -
  obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective y
  obtain ⟨x, s, rfl⟩ := IsLocalization.exists_mk'_eq (extendedPrime p).primeCompl y
  have hs : toExtendedPrimeResidueField p s ≠ 0 := by
    rw [Ne, toExtendedPrimeResidueField_eq_zero_iff]
    exact s.2
  have : IsLocalRing.residue _ (IsLocalization.mk' (Localization.AtPrime (extendedPrime p)) x s) =
      toExtendedPrimeResidueField p x / toExtendedPrimeResidueField p s := by
    rw [eq_div_iff hs]
    show IsLocalRing.residue _ (IsLocalization.mk' _ x s) *
      IsLocalRing.residue _ (algebraMap _ _ (s : LaurentPolynomial R)) =
        IsLocalRing.residue _ (algebraMap _ _ x)
    rw [← map_mul, IsLocalization.mk'_spec]
  rw [this]
  exact F.div_mem (himage x) (himage s)

/-- **The local homomorphism `R_𝔭 ⟶ R[T, T⁻¹]_𝔮` at the generic point of the fibre carries the
maximal ideal onto the maximal ideal, and its residue field extension is generated by the image of
`T`, which is transcendental.** -/
theorem isTranscendentalOneLocalHom_extendedPrimeLocalRingHom :
    IsTranscendentalOneLocalHom (extendedPrimeLocalRingHom p) where
  isLocalHom := inferInstance
  map_maximalIdeal := map_maximalIdeal_extendedPrimeLocalRingHom p
  exists_transcendental :=
    ⟨extendedPrimeGenerator p, transcendental_extendedPrimeGenerator p,
      adjoin_extendedPrimeGenerator p⟩

/-- **`R_𝔭 ⟶ R[T, T⁻¹]_𝔮` at the generic point `𝔮 = 𝔭 R[T, T⁻¹]` of the fibre**, for any spelling
of the structure map and of the contraction of `𝔮`. -/
theorem isTranscendentalOneLocalHom_localRingHom (φ : R →+* LaurentPolynomial R)
    (hφ : φ = algebraMap R (LaurentPolynomial R)) (p' : Ideal R) [p'.IsPrime]
    (h : p' = (extendedPrime p).comap φ) :
    IsTranscendentalOneLocalHom (Localization.localRingHom p' (extendedPrime p) φ h) := by
  subst hφ
  obtain rfl := h.trans (comap_extendedPrime p)
  exact isTranscendentalOneLocalHom_extendedPrimeLocalRingHom _

end LaurentPolynomial
