module

public import StacksFrontier.Algebra.MvPolynomial.HomogeneousOfScaling
public import Mathlib.RingTheory.AdjoinRoot
public import Mathlib.RingTheory.Norm.Basic
public import Mathlib.Algebra.Polynomial.Degree.Lemmas
public import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
public import Mathlib.LinearAlgebra.Matrix.Charpoly.Minpoly
public import Mathlib.RingTheory.PowerBasis
public import Mathlib.Algebra.MvPolynomial.Monad

/-!
# Multiplicative polynomial functions on `ℤ[X]` are norms

Let `D : ℤ[X] → ℤ` be multiplicative, with `D c = c ^ N` on constants (`N` even), and polynomial
in the coefficients: for every `m` there is `P_m ∈ ℚ[r_0, …, r_m]` with
`D (∑ r_k X^k) = P_m (r)`. This is the situation of the degree `D (R) = deg R(α)` of the
endomorphisms `R(α)` of an abelian variety of dimension `g`, `N = 2 g`, generated by one
endomorphism `α` ([Mumford, Abelian varieties, §19, Theorem 4]).

This file proves that theorem: `χ (t) = D (X - t)` is a monic polynomial of degree `N`, and `D`
is the norm form of `χ`.

## Main results

* `Stacks.Polynomial.isHomogeneous_of_multiplicative` — each `P_m` is homogeneous of degree `N`.
* `Stacks.Polynomial.exists_monic_eval_eq` — `χ` is monic of degree `N` with `χ (n) = D (X - n)`.
* `Stacks.Polynomial.eq_zero_of_eval_split` — products of integral linear factors are Zariski
  dense in coefficient space.
* `Stacks.Polynomial.exists_eq_normForm` — `D` is the norm form of `χ`: `D R = ∏ R (β_i)`.
-/

@[expose] public noncomputable section

open Finset Polynomial

namespace Stacks.Polynomial

variable {N : ℕ} {D : ℤ[X] → ℤ}

/-- The polynomial `∑_{k ≤ m} r_k X^k` with coefficients `r`. -/
def ofCoeffs {m : ℕ} (r : Fin (m + 1) → ℤ) : ℤ[X] := ∑ k, C (r k) * X ^ (k : ℕ)

/-- Scaling the coefficients by `c` multiplies `ofCoeffs` by the constant `C c`. -/
theorem ofCoeffs_mul_const {m : ℕ} (c : ℤ) (r : Fin (m + 1) → ℤ) :
    ofCoeffs (fun k => c * r k) = C c * ofCoeffs r := by
  simp only [ofCoeffs, mul_sum, C_mul, mul_assoc]

/-- **The polynomial computing a multiplicative function is homogeneous of degree `N`.** -/
theorem isHomogeneous_of_multiplicative (hmul : ∀ R S, D (R * S) = D R * D S)
    (hC : ∀ c : ℤ, D (C c) = c ^ N) {m : ℕ} (P : MvPolynomial (Fin (m + 1)) ℚ)
    (hP : ∀ r : Fin (m + 1) → ℤ, (D (ofCoeffs r) : ℚ) = MvPolynomial.eval (fun k => (r k : ℚ)) P) :
    P.IsHomogeneous N := by
  refine MvPolynomial.isHomogeneous_of_eval_intCast_mul fun c r => ?_
  rw [← hP, ← hP, ofCoeffs_mul_const, hmul, hC]
  push_cast
  ring

/-- The polynomial `t ↦ P (-t, 1)` attached to a polynomial `P` in two variables. -/
def charPolyOf (P : MvPolynomial (Fin 2) ℚ) : ℚ[X] :=
  MvPolynomial.aeval (fun k : Fin 2 => if k = 0 then -X else (1 : ℚ[X])) P

/-- Evaluating `charPolyOf P` at `t` gives `P (-t, 1)`. -/
theorem eval_charPolyOf (P : MvPolynomial (Fin 2) ℚ) (t : ℚ) :
    (charPolyOf P).eval t = MvPolynomial.eval (fun k : Fin 2 => if k = 0 then -t else 1) P := by
  have key : (Polynomial.aeval t).comp
      (MvPolynomial.aeval (fun k : Fin 2 => if k = 0 then -X else (1 : ℚ[X]))) =
      MvPolynomial.aeval (fun k : Fin 2 => if k = 0 then -t else 1) :=
    MvPolynomial.algHom_ext fun i => by fin_cases i <;> simp
  have h := DFunLike.congr_fun key P
  rw [AlgHom.comp_apply, Polynomial.coe_aeval_eq_eval] at h
  rw [charPolyOf, h]
  rfl

/-- **For `P` homogeneous of degree `N` (even) with `P (1, 0) = 1`, the polynomial
`t ↦ P (-t, 1)` is monic of degree `N`.** -/
theorem monic_charPolyOf {P : MvPolynomial (Fin 2) ℚ} (hP : P.IsHomogeneous N) (hN : Even N)
    (h10 : MvPolynomial.eval (fun k : Fin 2 => if k = 0 then 1 else 0) P = 1) :
    (charPolyOf P).Monic ∧ (charPolyOf P).natDegree = N := by
  classical
  have hexp : charPolyOf P = ∑ s ∈ P.support, C (MvPolynomial.coeff s P) * (-X) ^ (s 0) := by
    rw [charPolyOf, MvPolynomial.aeval_def, MvPolynomial.eval₂_eq']
    refine sum_congr rfl fun s _ => ?_
    rw [Fin.prod_univ_two, if_pos rfl, if_neg (by decide), one_pow, mul_one,
      Polynomial.algebraMap_eq]
  have hs0 : ∀ s ∈ P.support, s 0 + s 1 = N := by
    intro s hs
    have := hP (MvPolynomial.mem_support_iff.mp hs)
    simpa [Finsupp.weight_apply, Finsupp.sum_fintype, Fin.sum_univ_two] using this
  have hcoeffN : MvPolynomial.coeff (Finsupp.single 0 N) P = 1 := by
    rw [← h10, MvPolynomial.eval_eq']
    rw [sum_eq_single (Finsupp.single 0 N)]
    · simp [Fin.prod_univ_two]
    · intro s hs hne
      have h1 : s 1 ≠ 0 := by
        intro h1
        apply hne
        ext k
        fin_cases k
        · have := hs0 s hs; simp [h1] at this ⊢; omega
        · simp [h1]
      rw [Fin.prod_univ_two, if_neg (by decide : (1 : Fin 2) ≠ 0), zero_pow h1, mul_zero,
        mul_zero]
    · intro hn
      rw [MvPolynomial.notMem_support_iff.mp hn, zero_mul]
  have hterm : ∀ (q : ℚ) (e : ℕ), C q * (-X : ℚ[X]) ^ e = C (q * (-1) ^ e) * X ^ e := by
    intro q e
    rw [neg_pow, C_mul, C_pow, C_neg, C_1, mul_assoc]
  have hdeg : ∀ s ∈ P.support,
      (C (MvPolynomial.coeff s P) * (-X : ℚ[X]) ^ (s 0)).natDegree ≤ N := by
    intro s hs
    rw [hterm]
    refine (natDegree_C_mul_le _ _).trans ?_
    rw [natDegree_X_pow]
    have := hs0 s hs
    omega
  have hcoeff : (charPolyOf P).coeff N = 1 := by
    rw [hexp, finset_sum_coeff, sum_eq_single (Finsupp.single 0 N)]
    · rw [hterm, coeff_C_mul_X_pow, Finsupp.single_eq_same, if_pos rfl, hcoeffN, one_mul,
        hN.neg_one_pow]
    · intro s hs hne
      rw [hterm, coeff_C_mul_X_pow, if_neg]
      intro hN0
      apply hne
      have h1 := hs0 s hs
      ext k
      fin_cases k
      · simp [← hN0]
      · simp; omega
    · intro hn
      rw [MvPolynomial.notMem_support_iff.mp hn, C_0, zero_mul, coeff_zero]
  have hle : (charPolyOf P).natDegree ≤ N := by
    rw [hexp]
    exact natDegree_sum_le_of_forall_le _ _ hdeg
  have heq : (charPolyOf P).natDegree = N :=
    le_antisymm hle (le_natDegree_of_ne_zero (by rw [hcoeff]; exact one_ne_zero))
  exact ⟨by rw [Monic, leadingCoeff, heq, hcoeff], heq⟩

/-- **`χ (t) = D (X - t)` is monic of degree `N`.** For `D : ℤ[X] → ℤ` multiplicative, equal to
`c ^ N` on constants (`N` even) and given on polynomials of degree at most one by a polynomial in
the two coefficients, there is a monic `χ ∈ ℚ[X]` of degree `N` with `χ (n) = D (X - n)` for all
integers `n`. -/
theorem exists_monic_eval_eq (hmul : ∀ R S, D (R * S) = D R * D S)
    (hC : ∀ c : ℤ, D (C c) = c ^ N) (hN : Even N)
    (hpoly : ∃ P : MvPolynomial (Fin 2) ℚ,
      ∀ r : Fin 2 → ℤ, (D (ofCoeffs (m := 1) r) : ℚ) = MvPolynomial.eval (fun k => (r k : ℚ)) P) :
    ∃ χ : ℚ[X], χ.Monic ∧ χ.natDegree = N ∧ ∀ n : ℤ, χ.eval (n : ℚ) = (D (X - C n) : ℚ) := by
  obtain ⟨P, hP⟩ := hpoly
  have hhom := isHomogeneous_of_multiplicative hmul hC P hP
  have hP' : ∀ a b : ℤ, (D (C a + C b * X) : ℚ) =
      MvPolynomial.eval (fun k : Fin 2 => if k = 0 then (a : ℚ) else b) P := by
    intro a b
    have e : (fun k : Fin 2 => if k = 0 then (a : ℚ) else b) = fun k => ((![a, b] k : ℤ) : ℚ) := by
      funext k
      fin_cases k <;> simp
    rw [e]
    simpa [ofCoeffs, Fin.sum_univ_two] using hP ![a, b]
  have h1 : D 1 = 1 := by simpa using hC 1
  have h10 : MvPolynomial.eval (fun k : Fin 2 => if k = 0 then 1 else 0) P = 1 := by
    have := hP' 1 0
    simp only [C_0, zero_mul, add_zero, C_1, h1] at this
    exact_mod_cast this.symm
  obtain ⟨hmon, hdeg⟩ := monic_charPolyOf hhom hN h10
  refine ⟨charPolyOf P, hmon, hdeg, fun n => ?_⟩
  have := hP' (-n) 1
  simp only [C_1, one_mul, C_neg] at this
  rw [show -C n + X = X - C n by ring] at this
  push_cast at this
  rw [eval_charPolyOf, ← this]

/-! ### Zariski density of products of linear factors -/

/-- The polynomial `Y₀ ∏_{k < m} (X - Y_{k+1})` with coefficients in `ℚ[Y₀, …, Y_m]`. -/
def genericSplit (m : ℕ) : (MvPolynomial (Fin (m + 1)) ℚ)[X] :=
  C (MvPolynomial.X 0) * ∏ k : Fin m, (X - C (MvPolynomial.X k.succ))

/-- Specializing the variables of `genericSplit m` to `v` gives `v₀ ∏_{k < m} (X - v_{k+1})`. -/
theorem map_genericSplit {m : ℕ} {K : Type*} [CommRing K] [Algebra ℚ K] (v : Fin (m + 1) → K) :
    (genericSplit m).map (MvPolynomial.aeval v).toRingHom =
      C (v 0) * ∏ k : Fin m, (X - C (v k.succ)) := by
  simp [genericSplit, Polynomial.map_prod]

/-- A product of `m` linear factors with coefficients in a field, as a product indexed by
`Fin m`: every polynomial of degree `m` over an algebraically closed field is one. -/
theorem exists_eq_C_mul_prod {K : Type*} [Field K] [IsAlgClosed K] {m : ℕ} (R : K[X])
    (hR : R.natDegree = m) :
    ∃ x : Fin m → K, R = C R.leadingCoeff * ∏ k, (X - C (x k)) := by
  have hcard : R.roots.card = m := by rw [IsAlgClosed.card_roots_eq_natDegree, hR]
  set l := R.roots.toList with hl
  have hlen : l.length = m := by rw [hl, Multiset.length_toList, hcard]
  refine ⟨fun k => l.get (Fin.cast hlen.symm k), ?_⟩
  conv_lhs => rw [(IsAlgClosed.splits R).eq_prod_roots]
  congr 1
  have e : ∏ k : Fin m, (X - C (l.get (Fin.cast hlen.symm k))) = (l.map fun a => X - C a).prod := by
    rw [← List.prod_ofFn]
    congr 1
    refine List.ext_get (by simp [hlen]) fun i h1 h2 => ?_
    simp
  rw [e, hl, ← Multiset.prod_coe, ← Multiset.map_coe, Multiset.coe_toList]

/-- A polynomial over `ℚ` vanishing at every integral point with `i`-th coordinate nonzero is
zero. -/
private theorem eq_zero_of_eval_intCast_of_ne {σ : Type*} [Finite σ] (F : MvPolynomial σ ℚ)
    (i : σ) (h : ∀ v : σ → ℤ, v i ≠ 0 → MvPolynomial.eval (fun j => (v j : ℚ)) F = 0) :
    F = 0 := by
  have : F * MvPolynomial.X i = 0 := by
    refine MvPolynomial.eq_zero_of_eval_intCast_eq_zero fun v => ?_
    rw [map_mul, MvPolynomial.eval_X]
    by_cases hv : v i = 0
    · simp [hv]
    · rw [h v hv, zero_mul]
  exact (mul_eq_zero.mp this).resolve_right (MvPolynomial.X_ne_zero _)

/-- **A polynomial in the coefficients vanishing on all products `c ∏ (X - n_k)` of integral
linear factors (`c ≠ 0`) vanishes identically.** -/
theorem eq_zero_of_eval_split {m : ℕ} (F : MvPolynomial (Fin (m + 1)) ℚ)
    (hF : ∀ (c : ℤ), c ≠ 0 → ∀ n : Fin m → ℤ,
      MvPolynomial.eval
        (fun j : Fin (m + 1) => (((C c * ∏ k, (X - C (n k))) : ℤ[X]).coeff (j : ℕ) : ℚ)) F = 0) :
    F = 0 := by
  classical
  let G : MvPolynomial (Fin (m + 1)) ℚ :=
    MvPolynomial.bind₁ (fun j : Fin (m + 1) => (genericSplit m).coeff (j : ℕ)) F
  have hGK : ∀ {K : Type} [Field K] [Algebra ℚ K] (v : Fin (m + 1) → K),
      MvPolynomial.aeval v G = MvPolynomial.aeval (fun j : Fin (m + 1) =>
        ((C (v 0) * ∏ k : Fin m, (X - C (v k.succ))) : K[X]).coeff (j : ℕ)) F := by
    intro K _ _ v
    rw [MvPolynomial.aeval_bind₁, ← map_genericSplit v]
    simp only [Polynomial.coeff_map]
    rfl
  have hGint : ∀ v : Fin (m + 1) → ℤ, v 0 ≠ 0 → MvPolynomial.eval (fun j => (v j : ℚ)) G = 0 := by
    intro v hv
    have h := hGK (K := ℚ) (fun j => (v j : ℚ))
    rw [show MvPolynomial.eval (fun j => (v j : ℚ)) G =
      MvPolynomial.aeval (fun j => (v j : ℚ)) G from rfl, h]
    refine Eq.trans ?_ (hF (v 0) hv (fun k => v k.succ))
    have hm : (C ((v 0 : ℤ) : ℚ) * ∏ k : Fin m, (X - C ((v k.succ : ℤ) : ℚ)) : ℚ[X]) =
        (C (v 0) * ∏ k : Fin m, (X - C (v k.succ)) : ℤ[X]).map (Int.castRingHom ℚ) := by
      simp [Polynomial.map_prod]
    rw [hm]
    simp only [Polynomial.coeff_map]
    rfl
  have hG0 : G = 0 := eq_zero_of_eval_intCast_of_ne G 0 hGint
  have hFint : ∀ r : Fin (m + 1) → ℤ, r (Fin.last m) ≠ 0 →
      MvPolynomial.eval (fun j => (r j : ℚ)) F = 0 := by
    intro r hr
    let K := AlgebraicClosure ℚ
    let R : K[X] := ∑ j : Fin (m + 1), C ((r j : ℚ) : K) * X ^ (j : ℕ)
    have hRcoeff : ∀ j : Fin (m + 1), R.coeff (j : ℕ) = ((r j : ℚ) : K) := by
      intro j
      simp only [R, finset_sum_coeff, coeff_C_mul_X_pow]
      rw [sum_eq_single j (fun i _ hi => if_neg (fun h => hi (Fin.ext h.symm)))
        (fun h => absurd (mem_univ j) h), if_pos rfl]
    have hRdeg : R.natDegree = m := by
      refine le_antisymm ?_ ?_
      · refine natDegree_sum_le_of_forall_le _ _ fun j _ => (natDegree_C_mul_X_pow_le _ _).trans ?_
        exact Nat.lt_succ_iff.mp j.2
      · refine le_natDegree_of_ne_zero ?_
        have := hRcoeff (Fin.last m)
        rw [Fin.val_last] at this
        rw [this]
        exact_mod_cast hr
    obtain ⟨x, hx⟩ := exists_eq_C_mul_prod R hRdeg
    have h := hGK (K := K) (Fin.cons R.leadingCoeff x)
    rw [hG0, map_zero] at h
    simp only [Fin.cons_zero, Fin.cons_succ] at h
    rw [← hx] at h
    have e : (fun j : Fin (m + 1) => R.coeff (j : ℕ)) = fun j => algebraMap ℚ K (r j : ℚ) :=
      funext fun j => hRcoeff j
    have key : MvPolynomial.aeval (fun j => algebraMap ℚ K (r j : ℚ)) F =
        algebraMap ℚ K (MvPolynomial.eval (fun j => (r j : ℚ)) F) := by
      rw [MvPolynomial.aeval_def, MvPolynomial.eval, MvPolynomial.coe_eval₂Hom,
        MvPolynomial.eval₂_comp_left, RingHom.comp_id]
      rfl
    rw [e, key] at h
    exact (FaithfulSMul.algebraMap_injective ℚ K) (by rw [← h, map_zero])
  exact eq_zero_of_eval_intCast_of_ne F (Fin.last m) hFint

/-! ### The norm form attached to a monic polynomial -/

/-- The norm form `R ↦ N_{(ℚ[X]/χ)/ℚ}(R mod χ)` attached to a monic `χ ∈ ℚ[X]`, on `ℤ[X]`. When
`χ = ∏ (X - β_i)` this is `∏ R(β_i)`, the resultant of `χ` and `R`. -/
def normForm (χ : ℚ[X]) (R : ℤ[X]) : ℚ :=
  Algebra.norm ℚ (AdjoinRoot.mk χ (R.map (Int.castRingHom ℚ)))

/-- The norm form is multiplicative. -/
theorem normForm_mul (χ : ℚ[X]) (R S : ℤ[X]) :
    normForm χ (R * S) = normForm χ R * normForm χ S := by
  simp [normForm, Polynomial.map_mul]

/-- For monic `χ`, the norm form of a constant `c` is `c ^ deg χ`. -/
theorem normForm_C {χ : ℚ[X]} (hχ : χ.Monic) (c : ℤ) :
    normForm χ (C c) = (c : ℚ) ^ χ.natDegree := by
  rw [normForm, Polynomial.map_C, AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq,
    Algebra.norm_algebraMap, (AdjoinRoot.powerBasis' hχ).finrank, AdjoinRoot.powerBasis'_dim]
  rfl

/-- For monic `χ` of even degree, the norm form of `X - n` is `χ (n)`. -/
theorem normForm_X_sub_C {χ : ℚ[X]} (hχ : χ.Monic) (hN : Even χ.natDegree) (n : ℤ) :
    normForm χ (X - C n) = χ.eval (n : ℚ) := by
  classical
  have hchar : (Algebra.leftMulMatrix (AdjoinRoot.powerBasis' hχ).basis
      (AdjoinRoot.root χ)).charpoly = χ := by
    have h := charpoly_leftMulMatrix (AdjoinRoot.powerBasis' hχ)
    rw [AdjoinRoot.powerBasis'_gen, AdjoinRoot.minpoly_root hχ.ne_zero, hχ.leadingCoeff, inv_one,
      C_1, mul_one] at h
    exact h
  rw [normForm, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, map_sub, AdjoinRoot.mk_X,
    AdjoinRoot.mk_C, ← AdjoinRoot.algebraMap_eq,
    Algebra.norm_eq_matrix_det (AdjoinRoot.powerBasis' hχ).basis, map_sub,
    AlgHom.commutes, ← neg_sub, Matrix.det_neg, Fintype.card_fin]
  have hev : Even (AdjoinRoot.powerBasis' hχ).dim := by rw [AdjoinRoot.powerBasis'_dim]; exact hN
  rw [hev.neg_one_pow, one_mul]
  conv_rhs => rw [← hchar, Matrix.eval_charpoly]
  congr 2

/-- `R ↦ normForm χ (∑ r_k X^k)` is a polynomial in the coefficients `r`. -/
theorem exists_mvPolynomial_normForm {χ : ℚ[X]} (hχ : χ.Monic) (m : ℕ) :
    ∃ Q : MvPolynomial (Fin (m + 1)) ℚ, ∀ r : Fin (m + 1) → ℤ,
      normForm χ (ofCoeffs r) = MvPolynomial.eval (fun k => (r k : ℚ)) Q := by
  classical
  set b := (AdjoinRoot.powerBasis' hχ).basis
  set M := Algebra.leftMulMatrix b (AdjoinRoot.root χ)
  let B : Matrix (Fin (AdjoinRoot.powerBasis' hχ).dim) (Fin (AdjoinRoot.powerBasis' hχ).dim)
      (MvPolynomial (Fin (m + 1)) ℚ) :=
    ∑ k : Fin (m + 1), (MvPolynomial.X k : MvPolynomial (Fin (m + 1)) ℚ) •
      (M ^ (k : ℕ)).map (MvPolynomial.C : ℚ → MvPolynomial (Fin (m + 1)) ℚ)
  refine ⟨B.det, fun r => ?_⟩
  have hL : Algebra.leftMulMatrix b (AdjoinRoot.mk χ ((ofCoeffs r).map (Int.castRingHom ℚ))) =
      ∑ k : Fin (m + 1), ((r k : ℚ) • M ^ (k : ℕ)) := by
    simp only [ofCoeffs, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_pow,
      Polynomial.map_X, map_sum, map_mul, map_pow, AdjoinRoot.mk_X, eq_intCast, M]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Polynomial.map_intCast, map_intCast, map_intCast,
      ← map_intCast (algebraMap ℚ (Matrix (Fin (AdjoinRoot.powerBasis' hχ).dim)
        (Fin (AdjoinRoot.powerBasis' hχ).dim) ℚ)) (r k),
      Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  have hR : (MvPolynomial.eval fun k => (r k : ℚ)).mapMatrix B =
      ∑ k : Fin (m + 1), ((r k : ℚ) • M ^ (k : ℕ)) := by
    ext i j
    simp [B, Matrix.sum_apply, Matrix.smul_apply]
  rw [RingHom.map_det, normForm, Algebra.norm_eq_matrix_det b, hL, hR]

/-- A polynomial of degree at most `m` is `ofCoeffs` of its first `m + 1` coefficients. -/
theorem ofCoeffs_coeff {m : ℕ} {R : ℤ[X]} (hR : R.natDegree ≤ m) :
    ofCoeffs (fun j : Fin (m + 1) => R.coeff (j : ℕ)) = R := by
  conv_rhs => rw [R.as_sum_range' (m + 1) (Nat.lt_succ_of_le hR)]
  rw [ofCoeffs, Fin.sum_univ_eq_sum_range (fun j => C (R.coeff j) * X ^ j) (m + 1)]
  exact sum_congr rfl fun j _ => C_mul_X_pow_eq_monomial

/-- **A multiplicative polynomial function on `ℤ[X]` is the norm form of `χ (t) = D (X - t)`**
([Mumford, Abelian varieties, §19, proof of Theorem 4]). Let `D : ℤ[X] → ℤ` be multiplicative,
with `D c = c ^ N` on constants (`N` even), and given on polynomials of degree at most `m` by a
polynomial in the coefficients, for every `m`. Then there is a monic `χ ∈ ℚ[X]` of degree `N`
with `χ (n) = D (X - n)` for all integers `n`, and `D R = N_{(ℚ[X]/χ)/ℚ}(R)` for every `R`:
when `χ = ∏ (X - β_i)`, `D R = ∏ R (β_i)`. -/
theorem exists_eq_normForm (hmul : ∀ R S, D (R * S) = D R * D S)
    (hC : ∀ c : ℤ, D (C c) = c ^ N) (hN : Even N)
    (hpoly : ∀ m : ℕ, ∃ P : MvPolynomial (Fin (m + 1)) ℚ,
      ∀ r : Fin (m + 1) → ℤ, (D (ofCoeffs r) : ℚ) = MvPolynomial.eval (fun k => (r k : ℚ)) P) :
    ∃ χ : ℚ[X], χ.Monic ∧ χ.natDegree = N ∧ (∀ n : ℤ, χ.eval (n : ℚ) = (D (X - C n) : ℚ)) ∧
      ∀ R : ℤ[X], (D R : ℚ) = normForm χ R := by
  obtain ⟨χ, hmon, hdeg, hev⟩ := exists_monic_eval_eq hmul hC hN (hpoly 1)
  refine ⟨χ, hmon, hdeg, hev, fun R => ?_⟩
  have h1 : D 1 = 1 := by simpa using hC 1
  let Dm : ℤ[X] →* ℚ :=
    { toFun := fun R => (D R : ℚ)
      map_one' := by rw [h1, Int.cast_one]
      map_mul' := fun R S => by rw [hmul, Int.cast_mul] }
  let Nm : ℤ[X] →* ℚ :=
    { toFun := normForm χ
      map_one' := by simpa using normForm_C hmon 1
      map_mul' := normForm_mul χ }
  obtain ⟨P, hP⟩ := hpoly R.natDegree
  obtain ⟨Q, hQ⟩ := exists_mvPolynomial_normForm hmon R.natDegree
  have hF : P - Q = 0 := by
    refine eq_zero_of_eval_split (P - Q) fun c hc n => ?_
    set R0 : ℤ[X] := C c * ∏ k, (X - C (n k)) with hR0
    have hR0deg : R0.natDegree ≤ R.natDegree := by
      refine (natDegree_C_mul_le _ _).trans ((natDegree_prod_le _ _).trans ?_)
      calc ∑ k, ((X - C (n k) : ℤ[X])).natDegree ≤ ∑ _k : Fin R.natDegree, (1 : ℕ) :=
            Finset.sum_le_sum fun k _ => natDegree_X_sub_C_le (n k)
        _ = R.natDegree := by simp
    have hc0 := ofCoeffs_coeff hR0deg
    rw [map_sub, ← hP, ← hQ, hc0, sub_eq_zero]
    show Dm R0 = Nm R0
    rw [hR0, map_mul, map_mul, map_prod, map_prod]
    have hDC : Dm (C c) = (c : ℚ) ^ N := by
      show ((D (C c) : ℤ) : ℚ) = _
      rw [hC]; push_cast; rfl
    have hNC : Nm (C c) = (c : ℚ) ^ N := by
      show normForm χ (C c) = _
      rw [normForm_C hmon, hdeg]
    have hlin : ∀ k, Dm (X - C (n k)) = Nm (X - C (n k)) := by
      intro k
      show (D (X - C (n k)) : ℚ) = normForm χ (X - C (n k))
      rw [normForm_X_sub_C hmon (hdeg ▸ hN), hev]
    rw [hDC, hNC]
    congr 1
    exact prod_congr rfl fun k _ => hlin k
  rw [← ofCoeffs_coeff (le_refl R.natDegree), hP, hQ, ← sub_eq_zero, ← map_sub, hF, map_zero]

end Stacks.Polynomial
