/-!
# Spectral sequences of filtered complexes: the induced filtration and weak convergence

The subobject lemmas behind [Stacks, Tag 012Q], the induced filtration on cohomology of
[Stacks, Tag 012R], the comparison of [Stacks, Tag 012F] for a complex in one degree, and the
criterion for weak convergence of the spectral sequence of a filtered complex in one bidegree.
-/

@[expose] public section

universe v u

open CategoryTheory Limits Preadditive Opposite

section Filtrations

variable {C : Type u} [Category.{v} C]


end Filtrations

section Subobjects

variable {C : Type u} [Category.{v} C] [Abelian C]

omit [Abelian C] in
/-- A morphism factoring through the subobject generated by a monomorphism factors through that
monomorphism. -/
lemma exists_comp_eq_of_factors_mk {W X Y : C} (m : X ⟶ Y) [Mono m] {h : W ⟶ Y}
    (hh : (Subobject.mk m).Factors h) : ∃ t : W ⟶ X, t ≫ m = h :=
  ⟨(Subobject.mk m).factorThru h hh ≫ (Subobject.underlyingIso m).hom, by
    rw [Category.assoc, Subobject.underlyingIso_hom_comp_eq_mk,
      Subobject.factorThru_arrow _ _ hh]⟩

/-- A morphism into `Z` which dies in the quotient `Z/W` factors, after the inclusion of `Z`,
through `W`. -/
lemma factors_of_comp_cokernel_π_ofLE_eq_zero {Y : C} {W Z : Subobject Y} (h : W ≤ Z)
    {T : C} (x : T ⟶ (Z : C)) (hx : x ≫ cokernel.π (Subobject.ofLE W Z h) = 0) :
    W.Factors (x ≫ Z.arrow) := by
  have hlift : x ≫ Z.arrow =
      Abelian.monoLift (Subobject.ofLE W Z h) x hx ≫ W.arrow := by
    rw [← Subobject.ofLE_arrow h, ← Category.assoc, Abelian.monoLift_comp]
  rw [hlift]
  exact Subobject.factors_comp_arrow _

/-- The pushforward of a subobject along `f` lies in the image of `f`. -/
lemma exists_le_imageSubobject {X Y : C} (f : X ⟶ Y) (U : Subobject X) :
    (Subobject.exists f).obj U ≤ imageSubobject f := by
  rw [Subobject.exists_eq_imageSubobject]
  exact imageSubobject_comp_le _ _

/-- Two morphisms out of a common source, the second an epimorphism, with the kernel of the first
inside the kernel of the second: the image of the first is a subobject mapping onto the target of
the second. -/
lemma exists_epi_of_ker_le {Y E G : C} (α : Y ⟶ E) (γ : Y ⟶ G) [Epi γ]
    (h : ∀ {T : C} (u : T ⟶ Y), u ≫ α = 0 → u ≫ γ = 0) :
    ∃ (S : Subobject E) (g : Y ⟶ (S : C)) (e : (S : C) ⟶ G),
      Epi g ∧ Epi e ∧ g ≫ S.arrow = α ∧ g ≫ e = γ := by
  have hcond : kernel.ι (factorThruImageSubobject α) ≫ γ = 0 := by
    refine h _ ?_
    calc kernel.ι (factorThruImageSubobject α) ≫ α
        = (kernel.ι (factorThruImageSubobject α) ≫ factorThruImageSubobject α) ≫
            (imageSubobject α).arrow := by
          rw [Category.assoc, imageSubobject_arrow_comp]
      _ = 0 := by rw [kernel.condition, zero_comp]
  have hge : factorThruImageSubobject α ≫ Abelian.epiDesc (factorThruImageSubobject α) γ hcond
      = γ := Abelian.comp_epiDesc _ _ hcond
  have : Epi (factorThruImageSubobject α ≫
      Abelian.epiDesc (factorThruImageSubobject α) γ hcond) := by rw [hge]; infer_instance
  exact ⟨imageSubobject α, factorThruImageSubobject α, _, inferInstance,
    epi_of_epi (factorThruImageSubobject α) _, imageSubobject_arrow_comp α, hge⟩

end Subobjects

section StableCyclesAndBoundaries

variable {C : Type u} [Category.{v} C] [Abelian C] {W X Y : C} {d₁ : W ⟶ X} {d₂ : X ⟶ Y}
  {P : ℕ → Subobject W} {Q : ℕ → Subobject Y} {G G' Z B : Subobject X}

/-- **Clause (1) of [Stacks, Tag 012Q].** With `d₁ ≫ d₂ = 0`, the least upper bound of the
subobjects `G ⊓ d₁(P r) ⊔ G'` is contained in the greatest lower bound of the subobjects
`G ⊓ d₂⁻¹(Q r) ⊔ G'`, because a boundary is a cycle. Applied to `d₁ = d^{n - 1}`, `d₂ = d^n`,
`G = F^pK^n`, `G' = F^{p + 1}K^n` this is `B_∞^{p, q} ≤ Z_∞^{p, q}`. -/
lemma isLUB_le_isGLB_of_comp_eq_zero (hd : d₁ ≫ d₂ = 0)
    (hZ : IsGLB (Set.range fun r : ℕ => G ⊓ (Subobject.pullback d₂).obj (Q r) ⊔ G') Z)
    (hB : IsLUB (Set.range fun r : ℕ =>
      G ⊓ (Subobject.«exists» d₁).obj (P r) ⊔ G') B) : B ≤ Z := by
  refine hB.2 ?_
  rintro _ ⟨r, rfl⟩
  refine hZ.2 ?_
  rintro _ ⟨r', rfl⟩
  exact sup_le_sup_right (inf_le_inf_left _ (Subobject.exists_le_pullback_of_comp_eq_zero hd _ _)) _

/-- The least upper bound of the subobjects `G ⊓ d₁(P r) ⊔ G'` is contained in
`Im(d₁) ⊓ G ⊔ G'`: this is the source's `B_∞^{p, q} ≤ Im(d^{n - 1}) ∩ F^pK^n + F^{p + 1}K^n`. -/
lemma isLUB_le_imageSubobject_inf_sup
    (hB : IsLUB (Set.range fun r : ℕ =>
      G ⊓ (Subobject.«exists» d₁).obj (P r) ⊔ G') B) : B ≤ imageSubobject d₁ ⊓ G ⊔ G' := by
  refine hB.2 ?_
  rintro _ ⟨r, rfl⟩
  exact sup_le_sup_right (le_inf (inf_le_right.trans (exists_le_imageSubobject _ _)) inf_le_left) _

/-- A monomorphism into `X` which lands in `G` and is killed by `d₂` factors through the greatest
lower bound of the subobjects `G ⊓ d₂⁻¹(Q r) ⊔ G'`: this is the source's
`Ker(d^n) ∩ F^pK^n ≤ Z_∞^{p, q}`. -/
lemma isGLB_factors_of_comp_eq_zero
    (hZ : IsGLB (Set.range fun r : ℕ => G ⊓ (Subobject.pullback d₂).obj (Q r) ⊔ G') Z)
    {T : C} (x : T ⟶ X) [Mono x] (hxG : G.Factors x) (hxd : x ≫ d₂ = 0) : Z.Factors x := by
  refine Subobject.factors_of_le _ (hZ.2 ?_) (Subobject.mk_factors_self x)
  rintro _ ⟨r, rfl⟩
  refine Subobject.mk_le_of_factors _ (Subobject.sup_factors_of_factors_left
    ((Subobject.inf_factors _).2 ⟨hxG, ?_⟩))
  rw [pullback_factors_iff, hxd]
  exact Subobject.factors_zero

end StableCyclesAndBoundaries

section Cycles

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- A morphism into `K^n` killed by `d^n` lifts to the cycles of `K^•` in degree `n`. -/
private lemma exists_comp_iCycles_eq {X : CochainComplex C ℤ} {n : ℤ} {T : C} (y : T ⟶ X.X n)
    (hy : y ≫ X.d n (n + 1) = 0) : ∃ y' : T ⟶ X.cycles n, y' ≫ X.iCycles n = y :=
  ⟨X.liftCycles y (n + 1) (by simp) hy, X.liftCycles_i _ _ _ _⟩

/-- The map on cycles induced by a degreewise monomorphic morphism of cochain complexes is a
monomorphism. -/
private lemma mono_cyclesMap {X L : CochainComplex C ℤ} (f : L ⟶ X) [Mono f] (n : ℤ) :
    Mono (HomologicalComplex.cyclesMap f n) := by
  have : Mono (HomologicalComplex.cyclesMap f n ≫ X.iCycles n) := by
    rw [HomologicalComplex.cyclesMap_i]; infer_instance
  exact mono_of_mono _ (X.iCycles n)

/-- **The cycles of a subcomplex.** For `f : L^• ⟶ K^•` a degreewise monomorphic morphism of
cochain complexes, a cycle of `K^•` in degree `n` which lies in `L^n` is a cycle of `L^•`. -/
lemma exists_liftCycles {X L : CochainComplex C ℤ} (f : L ⟶ X) [Mono f] (n : ℤ) {T : C}
    (y : T ⟶ X.cycles n) (hy : (Subobject.mk (f.f n)).Factors (y ≫ X.iCycles n)) :
    ∃ y' : T ⟶ L.cycles n, y' ≫ HomologicalComplex.cyclesMap f n = y := by
  obtain ⟨y₀, hy₀⟩ := exists_comp_eq_of_factors_mk (f.f n) hy
  have hy₀d : y₀ ≫ L.d n (n + 1) = 0 := by
    rw [← cancel_mono (f.f (n + 1)), zero_comp, Category.assoc, ← f.comm n (n + 1),
      ← Category.assoc, hy₀, Category.assoc, X.iCycles_d, comp_zero]
  obtain ⟨y', hy'⟩ := exists_comp_iCycles_eq y₀ hy₀d
  refine ⟨y', ?_⟩
  rw [← cancel_mono (X.iCycles n), Category.assoc, HomologicalComplex.cyclesMap_i,
    ← Category.assoc, hy', hy₀]

/-- The class of a cycle of `K^•` lying in a subcomplex `L^•` lies in the image of
`H^n(L^•) ⟶ H^n(K^•)`. -/
private lemma exists_comp_image_ι_homologyMap {X L : CochainComplex C ℤ} (f : L ⟶ X) [Mono f]
    (n : ℤ) {T : C} (y : T ⟶ X.cycles n)
    (hy : (Subobject.mk (f.f n)).Factors (y ≫ X.iCycles n)) :
    ∃ t : T ⟶ image (HomologicalComplex.homologyMap f n),
      t ≫ image.ι (HomologicalComplex.homologyMap f n) = y ≫ X.homologyπ n := by
  obtain ⟨y', hy'⟩ := exists_liftCycles f n y hy
  refine ⟨y' ≫ L.homologyπ n ≫ factorThruImage (HomologicalComplex.homologyMap f n), ?_⟩
  rw [Category.assoc, Category.assoc, image.fac, HomologicalComplex.homologyπ_naturality,
    ← Category.assoc, hy']

/-- The cycles of `K^•` in degree `n` lying in a subcomplex `L^•` map onto the image of
`H^n(L^•) ⟶ H^n(K^•)`. -/
lemma exists_epi_comp_image_ι_homologyMap {X L : CochainComplex C ℤ} (f : L ⟶ X) [Mono f]
    (n : ℤ) (A : Subobject (X.cycles n))
    (hA : A = (Subobject.pullback (X.iCycles n)).obj (Subobject.mk (f.f n))) :
    ∃ β : (A : C) ⟶ image (HomologicalComplex.homologyMap f n), Epi β ∧
      β ≫ image.ι (HomologicalComplex.homologyMap f n) = A.arrow ≫ X.homologyπ n := by
  have := mono_cyclesMap f n
  have hAu : A.Factors (HomologicalComplex.cyclesMap f n) := by
    rw [hA, pullback_factors_iff, HomologicalComplex.cyclesMap_i]
    exact Subobject.factors_of_factors_right _ (Subobject.mk_factors_self _)
  -- `A` is the cycles of `L^•`: the lift `w` of its arrow is split by the factorisation of
  -- `cyclesMap f n` through `A`
  obtain ⟨w, hw⟩ := exists_liftCycles f n A.arrow
    ((pullback_factors_iff _ _ A.arrow).1 (by rw [← hA]; exact Subobject.factors_self A))
  have : IsSplitEpi w := IsSplitEpi.mk' ⟨A.factorThru _ hAu, by
    rw [← cancel_mono (HomologicalComplex.cyclesMap f n), Category.assoc, hw,
      A.factorThru_arrow, Category.id_comp]⟩
  refine ⟨w ≫ L.homologyπ n ≫ factorThruImage _, inferInstance, ?_⟩
  rw [Category.assoc, Category.assoc, image.fac, HomologicalComplex.homologyπ_naturality,
    ← Category.assoc, hw]

/-- **A subobject of the boundaries consists of cycles with vanishing class.** A subobject `D` of
`Im(d^{n - 1})` lifts to the cycles of `K^•` in degree `n`, and the lift is killed by
`H^n(K^•)`. -/
lemma exists_liftCycles_comp_homologyπ_eq_zero {X : CochainComplex C ℤ} {n : ℤ}
    {D : Subobject (X.X n)} (hD : D ≤ imageSubobject (X.d (n - 1) n)) :
    ∃ l : (D : C) ⟶ X.cycles n, l ≫ X.iCycles n = D.arrow ∧ l ≫ X.homologyπ n = 0 := by
  have hIm : (imageSubobject (X.d (n - 1) n)).arrow ≫ X.d n (n + 1) = 0 :=
    imageSubobject_arrow_comp_eq_zero (X.d_comp_d _ _ _)
  obtain ⟨l₀, hl₀⟩ := exists_comp_iCycles_eq _ hIm
  have hl₀π : l₀ ≫ X.homologyπ n = 0 := by
    have hfac : factorThruImageSubobject (X.d (n - 1) n) ≫ l₀ = X.toCycles (n - 1) n := by
      rw [← cancel_mono (X.iCycles n), Category.assoc, hl₀, imageSubobject_arrow_comp,
        HomologicalComplex.toCycles_i]
    rw [← cancel_epi (factorThruImageSubobject (X.d (n - 1) n)), comp_zero, ← Category.assoc,
      hfac, HomologicalComplex.toCycles_comp_homologyπ]
  exact ⟨Subobject.ofLE _ _ hD ≫ l₀, by rw [Category.assoc, hl₀, Subobject.ofLE_arrow], by
    rw [Category.assoc, hl₀π, comp_zero]⟩

/-- **The class of a cycle lying in `D + M^n` dies in the graded piece.** Let
`M^• ⟶ L^• ⟶ K^•` factor a degreewise monomorphism of cochain complexes, let `D` be a subobject of
the boundaries `Im(d^{n - 1})` of `K^•`, and let `y` be a cycle of `K^•` in degree `n` lying in
`D + M^n`. Then `y` is, up to a boundary and a refinement, a cycle of `M^•`, so its class in
`Im(H^n(L^•) → H^n(K^•))` dies in the quotient by `Im(H^n(M^•) → H^n(K^•))`.

For `M^• = F^{p + 1}K^•`, `L^• = F^pK^•` and `D = Im(d^{n - 1}) ∩ F^pK^n` this is the computation
of [Stacks, Tag 012Q]: a cycle of `F^pK^n` lying in the stable boundaries has class in
`F^{p + 1}H^n(K^•)`, so it dies in `gr^pH^n(K^•)`. -/
lemma comp_cokernel_π_image_preComp_eq_zero_of_factors_sup
    {M L X : CochainComplex C ℤ} {g : M ⟶ L} {f : L ⟶ X} {h : M ⟶ X} [Mono h]
    (hgf : g ≫ f = h) {n : ℤ} {D : Subobject (X.X n)}
    (hD : D ≤ imageSubobject (X.d (n - 1) n)) {T : C} {y : T ⟶ X.cycles n}
    (hy : (D ⊔ Subobject.mk (h.f n)).Factors (y ≫ X.iCycles n))
    {β : T ⟶ image (HomologicalComplex.homologyMap f n)}
    (hβ : β ≫ image.ι (HomologicalComplex.homologyMap f n) = y ≫ X.homologyπ n) :
    β ≫ cokernel.π (image.preComp (HomologicalComplex.homologyMap g n)
      (HomologicalComplex.homologyMap f n)) = 0 := by
  obtain ⟨l₀, hl₀, hl₀π⟩ := exists_liftCycles_comp_homologyπ_eq_zero hD
  have hDd : D.arrow ≫ X.d n (n + 1) = 0 := by
    rw [← hl₀, Category.assoc, HomologicalComplex.iCycles_d, comp_zero]
  -- split the cycle into a boundary and a morphism through `M^n`
  obtain ⟨T', z, hz, δ, γ, fac⟩ := Subobject.exists_refinement_of_factors_sup _ hy
  have hγd : (γ ≫ (Subobject.mk (h.f n)).arrow) ≫ X.d n (n + 1) = 0 := by
    have hγ : γ ≫ (Subobject.mk (h.f n)).arrow = z ≫ y ≫ X.iCycles n - δ ≫ D.arrow := by
      rw [fac]; abel
    simp [hγ, hDd]
  -- the second summand is a cycle, the first being a boundary
  obtain ⟨l, hl⟩ := exists_comp_iCycles_eq _ hγd
  have hdecomp : z ≫ y = δ ≫ l₀ + l := by
    rw [← cancel_mono (X.iCycles n), add_comp, Category.assoc, Category.assoc, hl, hl₀]
    exact fac
  -- the class of the cycle of `M^•` lies in `Im(H^n(M^•) → H^n(K^•))`
  obtain ⟨t, ht⟩ : ∃ t : T' ⟶ image (HomologicalComplex.homologyMap g n ≫
        HomologicalComplex.homologyMap f n),
      t ≫ image.preComp (HomologicalComplex.homologyMap g n)
          (HomologicalComplex.homologyMap f n) ≫
        image.ι (HomologicalComplex.homologyMap f n) = l ≫ X.homologyπ n := by
    rw [image.preComp_ι, ← HomologicalComplex.homologyMap_comp, hgf]
    exact exists_comp_image_ι_homologyMap h n l (by rw [hl]; exact Subobject.factors_comp_arrow _)
  have hzβ : z ≫ β = t ≫ image.preComp (HomologicalComplex.homologyMap g n)
      (HomologicalComplex.homologyMap f n) := by
    rw [← cancel_mono (image.ι (HomologicalComplex.homologyMap f n)), Category.assoc, hβ,
      Category.assoc, ht, ← Category.assoc, hdecomp, add_comp, Category.assoc, hl₀π, comp_zero,
      zero_add]
  refine zero_of_epi_comp z ?_
  rw [← Category.assoc, hzβ, Category.assoc, cokernel.condition, comp_zero]

end Cycles

section SubobjectsAndQuotients

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- Precomposing with an epimorphism does not change the image. -/
private lemma imageSubobject_epi_comp {X I Y : C} (e : X ⟶ I) [Epi e] (g : I ⟶ Y) :
    imageSubobject (e ≫ g) = imageSubobject g := by
  refine le_antisymm (imageSubobject_comp_le e g) ?_
  have h0 : (imageSubobject (e ≫ g)).Factors (e ≫ g) := by
    simpa using imageSubobject_factors_comp_self (e ≫ g) (𝟙 X)
  exact imageSubobject_le g _
    (Subobject.factorThru_arrow _ _ (Subobject.factors_of_epi_comp _ _ h0))

/-- Pushing a factorisation forward along `f`. -/
lemma exists_factors {X Y : C} (f : X ⟶ Y) {S : Subobject X} {T : C} {u : T ⟶ X}
    (h : S.Factors u) : ((Subobject.exists f).obj S).Factors (u ≫ f) := by
  rw [Subobject.exists_eq_imageSubobject, ← Subobject.factorThru_arrow _ _ h, Category.assoc]
  exact imageSubobject_factors_comp_self _ _

/-- The pushforward of a monomorphism's whole source is the subobject it cuts out. -/
private lemma exists_top {X Y : C} (m : X ⟶ Y) [Mono m] :
    (Subobject.exists m).obj ⊤ = Subobject.mk m := by
  rw [Subobject.exists_obj_top, imageSubobject_mono]

/-- The engine of the correspondence: a morphism whose composite with `f` factors through the
image of `U` factors through `U + Ker(f)`. -/
lemma factors_sup_kernelSubobject {X Y W : C} (f : X ⟶ Y) (U : Subobject X) (g : W ⟶ X)
    (h : ((Subobject.exists f).obj U).Factors (g ≫ f)) :
    (U ⊔ kernelSubobject f).Factors g := by
  rw [Subobject.exists_eq_imageSubobject, Subobject.imageSubobject_factors_iff] at h
  obtain ⟨T, z, _, x, hx⟩ := h
  refine Subobject.factors_of_epi_comp z g ?_
  rw [show z ≫ g = (z ≫ g - x ≫ U.arrow) + x ≫ U.arrow by abel]
  refine Subobject.factors_add _ _ (Subobject.sup_factors_of_factors_right ?_)
    (Subobject.sup_factors_of_factors_left (Subobject.factors_comp_arrow x))
  exact kernelSubobject_factors f _ (by rw [Preadditive.sub_comp, Category.assoc, Category.assoc,
    hx, sub_self])

/-- In an abelian category the kernel of a cokernel is the image. -/
private lemma kernelSubobject_eq_imageSubobject_of_isColimit {W X Y : C} (t : W ⟶ X) (π : X ⟶ Y)
    (hw : t ≫ π = 0) (hc : IsColimit (CokernelCofork.ofπ π hw)) :
    kernelSubobject π = imageSubobject t := by
  refine le_antisymm (Subobject.le_of_factors ?_) (image_le_kernel t π hw)
  have h0 : (kernelSubobject π).arrow ≫ Cofork.π (CokernelCofork.ofπ π hw) = 0 :=
    kernelSubobject_arrow_comp π
  obtain ⟨A', z, hz, x, fac⟩ :=
    (CokernelCofork.IsColimit.comp_π_eq_zero_iff_up_to_refinements hc _).1 h0
  refine Subobject.factors_of_epi_comp z _ ?_
  rw [fac]
  exact imageSubobject_factors_comp_self t x

/-- A subobject exhausts a larger one as soon as the inclusion between them is an
epimorphism. -/
private lemma le_of_epi_ofLE {X : C} {V Z : Subobject X} (h : V ≤ Z)
    (he : Epi (Subobject.ofLE V Z h)) : Z ≤ V := by
  have : IsIso (Subobject.ofLE V Z h) := isIso_of_mono_of_epi _
  have h1 : inv (Subobject.ofLE V Z h) ≫ Subobject.ofLE V Z h ≫ Z.arrow = Z.arrow :=
    IsIso.inv_hom_id_assoc _ _
  rw [Subobject.ofLE_arrow] at h1
  exact Subobject.le_of_comm (inv (Subobject.ofLE V Z h)) h1

/-- If a morphism to `Z` becomes an epimorphism onto the quotient of `Z` by a subobject `W`, then
its image together with `W` exhausts `Z`. -/
private lemma le_sup_imageSubobject_of_epi {X A₀ : C} {Z W : Subobject X} (hWZ : W ≤ Z)
    (a : A₀ ⟶ (Z : C)) (hepi : Epi (a ≫ cokernel.π (Subobject.ofLE W Z hWZ))) :
    Z ≤ imageSubobject (a ≫ Z.arrow) ⊔ W := by
  have hIZ : imageSubobject (a ≫ Z.arrow) ≤ Z := imageSubobject_le _ a rfl
  have hVZ : imageSubobject (a ≫ Z.arrow) ⊔ W ≤ Z := sup_le hIZ hWZ
  refine le_of_epi_ofLE hVZ (Abelian.epi_of_cokernel_π_eq_zero _ ?_)
  have ht : (factorThruImageSubobject (a ≫ Z.arrow) ≫
        Subobject.ofLE _ (imageSubobject (a ≫ Z.arrow) ⊔ W) le_sup_left)
      ≫ Subobject.ofLE _ Z hVZ = a := by
    rw [← cancel_mono Z.arrow, Category.assoc, Subobject.ofLE_arrow, Category.assoc,
      Subobject.ofLE_arrow, imageSubobject_arrow_comp]
  have haV : a ≫ cokernel.π (Subobject.ofLE _ Z hVZ) = 0 :=
    calc a ≫ cokernel.π (Subobject.ofLE (imageSubobject (a ≫ Z.arrow) ⊔ W) Z hVZ)
        = ((factorThruImageSubobject (a ≫ Z.arrow) ≫
              Subobject.ofLE _ (imageSubobject (a ≫ Z.arrow) ⊔ W) le_sup_left)
            ≫ Subobject.ofLE _ Z hVZ) ≫
              cokernel.π (Subobject.ofLE (imageSubobject (a ≫ Z.arrow) ⊔ W) Z hVZ) := by rw [ht]
      _ = 0 := by rw [Category.assoc, cokernel.condition, comp_zero]
  have hjV : Subobject.ofLE W Z hWZ ≫ cokernel.π (Subobject.ofLE _ Z hVZ) = 0 := by
    rw [← Subobject.ofLE_comp_ofLE W (imageSubobject (a ≫ Z.arrow) ⊔ W) Z le_sup_right hVZ,
      Category.assoc, cokernel.condition, comp_zero]
  have hd : cokernel.desc (Subobject.ofLE W Z hWZ) (cokernel.π (Subobject.ofLE _ Z hVZ)) hjV
      = 0 := by
    refine (Preadditive.epi_iff_cancel_zero _).1 hepi _ _ ?_
    rw [Category.assoc, cokernel.π_desc]
    exact haV
  rw [← cokernel.π_desc (Subobject.ofLE W Z hWZ) (cokernel.π (Subobject.ofLE _ Z hVZ)) hjV, hd,
    comp_zero]

/-- A factorisation of `g` through a monomorphism cutting out exactly the image of `g` is an
epimorphism. -/
private lemma epi_of_fac_of_mk_eq_imageSubobject {A₀ I Y : C} {b : A₀ ⟶ I} {m : I ⟶ Y} [Mono m]
    {g : A₀ ⟶ Y} (hb : b ≫ m = g) (h : Subobject.mk m = imageSubobject g) : Epi b := by
  have hu' : Subobject.ofMkLEMk m (image.ι g) h.le ≫ image.ι g = m :=
    Subobject.ofMkLEMk_comp h.le
  have hv' : Subobject.ofMkLEMk (image.ι g) m h.ge ≫ m = image.ι g :=
    Subobject.ofMkLEMk_comp h.ge
  have huv : Subobject.ofMkLEMk m (image.ι g) h.le ≫ Subobject.ofMkLEMk (image.ι g) m h.ge
      = 𝟙 I := by rw [← cancel_mono m, Category.assoc, hv', hu', Category.id_comp]
  have hvu : Subobject.ofMkLEMk (image.ι g) m h.ge ≫ Subobject.ofMkLEMk m (image.ι g) h.le
      = 𝟙 (image g) := by
    rw [← cancel_mono (image.ι g), Category.assoc, hu', hv', Category.id_comp]
  have hiso : IsIso (Subobject.ofMkLEMk m (image.ι g) h.le) :=
    ⟨Subobject.ofMkLEMk (image.ι g) m h.ge, huv, hvu⟩
  have hbu : b ≫ Subobject.ofMkLEMk m (image.ι g) h.le = factorThruImage g := by
    rw [← cancel_mono (image.ι g), Category.assoc, hu', hb, image.fac]
  have hepi : Epi (b ≫ Subobject.ofMkLEMk m (image.ι g) h.le) := by rw [hbu]; infer_instance
  have := epi_comp (b ≫ Subobject.ofMkLEMk m (image.ι g) h.le)
    (inv (Subobject.ofMkLEMk m (image.ι g) h.le))
  simpa using this

omit [Abelian C] in
/-- A morphism factoring through a monomorphism factors through the subobject it cuts out. -/
lemma mk_factors_of_fac {X Y R : C} (m : X ⟶ Y) [Mono m] {g : R ⟶ Y} {t : R ⟶ X}
    (h : t ≫ m = g) : (Subobject.mk m).Factors g :=
  h ▸ Subobject.factors_of_factors_right t (Subobject.mk_factors_self m)


end SubobjectsAndQuotients

section Correspondence

variable {C : Type u} [Category.{v} C] [Abelian C] {Y X H : C}
  (w : Y ⟶ X) [Mono w] (π : Y ⟶ H) [Epi π]

/-- **The correspondence is faithful.** Reading a subobject of the quotient `H` inside `X` — pull
back along `π`, push forward along `w` — and then reading the result back inside `H` returns it
unchanged. -/
private lemma exists_pullback_exists_pullback_eq_self (S : Subobject H) :
    (Subobject.exists π).obj ((Subobject.pullback w).obj
        ((Subobject.exists w).obj ((Subobject.pullback π).obj S))) = S := by
  rw [Subobject.pullback_exists_eq_self_of_mono, Abelian.Subobject.exists_pullback_eq_self_of_epi]

omit [Epi π] in
/-- **The correspondence the other way round.** Reading a subobject `T` of `X` inside the quotient
`H` and then back inside `X` cuts `T` down to its part lying in `Y` and enlarges it by the image
of `Ker(π)`. -/
private lemma exists_pullback_exists_pullback_eq_sup (T : Subobject X) :
    (Subobject.exists w).obj ((Subobject.pullback π).obj
        ((Subobject.exists π).obj ((Subobject.pullback w).obj T)))
      = Subobject.mk w ⊓ T ⊔ (Subobject.exists w).obj (kernelSubobject π) := by
  rw [Abelian.Subobject.pullback_exists_eq_sup, (Subobject.existsPullbackAdj w).gc.l_sup,
    Subobject.exists_pullback_eq_inf_of_mono, inf_comm]

omit [Mono w] [Epi π] in
/-- The zero subobject of `H`, read inside `X`, is the image of `Ker(π)`. -/
private lemma exists_pullback_bot :
    (Subobject.exists w).obj ((Subobject.pullback π).obj ⊥)
      = (Subobject.exists w).obj (kernelSubobject π) := by
  rw [Subobject.pullback_bot]

omit [Epi π] in
/-- The whole of `H`, read inside `X`, is `Y` itself. -/
private lemma exists_pullback_top :
    (Subobject.exists w).obj ((Subobject.pullback π).obj (⊤ : Subobject H)) = Subobject.mk w := by
  rw [Subobject.pullback_top, exists_top]

omit [Epi π] in
/-- A subobject of `H`, read inside `X`, is a subobject of `Y`. -/
private lemma exists_pullback_le_mk (S : Subobject H) :
    (Subobject.exists w).obj ((Subobject.pullback π).obj S) ≤ Subobject.mk w := by
  rw [← exists_pullback_top w π]
  exact (Subobject.exists w).monotone ((Subobject.pullback π).monotone le_top)

omit [Mono w] [Epi π] in
/-- Every subobject of `H`, read inside `X`, contains the image of `Ker(π)`. -/
private lemma exists_kernelSubobject_le_exists_pullback (S : Subobject H) :
    (Subobject.exists w).obj (kernelSubobject π)
      ≤ (Subobject.exists w).obj ((Subobject.pullback π).obj S) := by
  refine (Subobject.exists w).monotone ?_
  rw [← Subobject.exists_le_iff_le_pullback, Subobject.exists_kernelSubobject]
  exact bot_le

/-- Separatedness of a family of subobjects of a quotient `H` of `Y`, read inside `X`: the family
`Set.range G` has greatest lower bound `⊥` if and only if the corresponding family of subobjects
of `X` has greatest lower bound the image of `Ker(π)`. -/
lemma isGLB_bot_iff_isGLB_exists_kernelSubobject {ι : Type*} [Nonempty ι]
    (G : ι → Subobject H) (T : ι → Subobject X)
    (hT : ∀ i, T i = (Subobject.exists w).obj ((Subobject.pullback π).obj (G i))) :
    IsGLB (Set.range G) ⊥ ↔
      IsGLB (Set.range T) ((Subobject.exists w).obj (kernelSubobject π)) := by
  constructor
  · rintro ⟨-, h2⟩
    refine ⟨?_, ?_⟩
    · rintro t ⟨i, rfl⟩
      rw [hT i]
      exact exists_kernelSubobject_le_exists_pullback w π _
    · rintro U hU
      obtain ⟨i₀⟩ := ‹Nonempty ι›
      have hVle : ∀ i, U ⊔ (Subobject.exists w).obj (kernelSubobject π) ≤ T i := fun i =>
        sup_le (hU ⟨i, rfl⟩) (by rw [hT i]; exact exists_kernelSubobject_le_exists_pullback w π _)
      have hVmk : U ⊔ (Subobject.exists w).obj (kernelSubobject π) ≤ Subobject.mk w :=
        le_trans (hVle i₀) (by rw [hT i₀]; exact exists_pullback_le_mk w π _)
      have hbot : (Subobject.exists π).obj ((Subobject.pullback w).obj
          (U ⊔ (Subobject.exists w).obj (kernelSubobject π))) = ⊥ := by
        refine le_antisymm (h2 ?_) bot_le
        rintro s ⟨i, rfl⟩
        have h3 := (Subobject.exists π).monotone ((Subobject.pullback w).monotone (hVle i))
        rwa [hT i, exists_pullback_exists_pullback_eq_self w π] at h3
      have hkey := exists_pullback_exists_pullback_eq_sup w π
        (U ⊔ (Subobject.exists w).obj (kernelSubobject π))
      rw [hbot, exists_pullback_bot w π, inf_eq_right.2 hVmk] at hkey
      rw [hkey]
      exact le_sup_of_le_left le_sup_left
  · rintro ⟨h1, h2⟩
    refine ⟨fun s _ => bot_le, fun S hS => ?_⟩
    have hle : (Subobject.exists w).obj ((Subobject.pullback π).obj S)
        ≤ (Subobject.exists w).obj (kernelSubobject π) := by
      refine h2 ?_
      rintro t ⟨i, rfl⟩
      rw [hT i]
      exact (Subobject.exists w).monotone
        ((Subobject.pullback π).monotone (mem_lowerBounds.1 hS _ (Set.mem_range_self i)))
    have h4 := (Subobject.exists π).monotone ((Subobject.pullback w).monotone hle)
    rwa [exists_pullback_exists_pullback_eq_self w π, ← exists_pullback_bot w π,
      exists_pullback_exists_pullback_eq_self w π] at h4

/-- Exhaustiveness of a family of subobjects of a quotient `H` of `Y`, read inside `X`. -/
lemma isLUB_top_iff_isLUB_mk {ι : Type*} [Nonempty ι]
    (G : ι → Subobject H) (T : ι → Subobject X)
    (hT : ∀ i, T i = (Subobject.exists w).obj ((Subobject.pullback π).obj (G i))) :
    IsLUB (Set.range G) ⊤ ↔ IsLUB (Set.range T) (Subobject.mk w) := by
  constructor
  · rintro ⟨-, h2⟩
    refine ⟨?_, ?_⟩
    · rintro t ⟨i, rfl⟩
      rw [hT i]
      exact exists_pullback_le_mk w π _
    · rintro U hU
      obtain ⟨i₀⟩ := ‹Nonempty ι›
      have htop : (Subobject.exists π).obj ((Subobject.pullback w).obj U) = ⊤ := by
        refine le_antisymm le_top (h2 ?_)
        rintro s ⟨i, rfl⟩
        have h5 := (Subobject.exists π).monotone ((Subobject.pullback w).monotone (hU ⟨i, rfl⟩))
        rwa [hT i, exists_pullback_exists_pullback_eq_self w π] at h5
      have hId : (Subobject.exists w).obj (kernelSubobject π) ≤ U :=
        le_trans (by rw [hT i₀]; exact exists_kernelSubobject_le_exists_pullback w π _)
          (hU ⟨i₀, rfl⟩)
      have hc := exists_pullback_exists_pullback_eq_sup w π U
      rw [htop, exists_pullback_top w π] at hc
      rw [hc]
      exact sup_le inf_le_right hId
  · rintro ⟨-, h2⟩
    refine ⟨fun s _ => le_top, fun S hS => ?_⟩
    have hle : Subobject.mk w ≤ (Subobject.exists w).obj ((Subobject.pullback π).obj S) := by
      refine h2 ?_
      rintro t ⟨i, rfl⟩
      rw [hT i]
      exact (Subobject.exists w).monotone
        ((Subobject.pullback π).monotone (mem_upperBounds.1 hS _ (Set.mem_range_self i)))
    have h6 := (Subobject.exists π).monotone ((Subobject.pullback w).monotone hle)
    rwa [exists_pullback_exists_pullback_eq_self w π, ← exists_pullback_top w π,
      exists_pullback_exists_pullback_eq_self w π] at h6

end Correspondence

section InducedFiltration

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The cycles of a cochain complex in degree `n`, as a subobject of `K^n`, are the kernel of
`d^n`. -/
lemma mk_iCycles (L : CochainComplex C ℤ) (n : ℤ) :
    Subobject.mk (L.iCycles n) = kernelSubobject (L.d n (n + 1)) := by
  refine le_antisymm (Subobject.mk_le_mk_of_comm
    (kernel.lift _ (L.iCycles n) (L.iCycles_d n (n + 1))) (kernel.lift_ι _ _ _)) ?_
  obtain ⟨t, ht⟩ := exists_comp_iCycles_eq (kernel.ι (L.d n (n + 1))) (kernel.condition _)
  exact Subobject.mk_le_mk_of_comm t ht

/-- For a degreewise monomorphism of cochain complexes, the cycles of the source are the cycles of
the target lying in the source. -/
private lemma exists_obj_kernelSubobject_d {L M : CochainComplex C ℤ} (φ : L ⟶ M) (n : ℤ)
    [Mono (φ.f n)] [Mono (φ.f (n + 1))] :
    (Subobject.exists (φ.f n)).obj (kernelSubobject (L.d n (n + 1)))
      = Subobject.mk (φ.f n) ⊓ kernelSubobject (M.d n (n + 1)) := by
  rw [inf_comm,
    ← Subobject.exists_pullback_eq_inf_of_mono (φ.f n) (kernelSubobject (M.d n (n + 1))),
    Subobject.pullback_kernelSubobject, φ.comm n (n + 1), kernelSubobject_comp_mono]

/-- The kernel of `Z^n(K^•) ⟶ H^n(K^•)` is the image of `d^{n-1}` in the cycles. -/
private lemma kernelSubobject_homologyπ (L : CochainComplex C ℤ) (n : ℤ) :
    kernelSubobject (L.homologyπ n) = imageSubobject (L.toCycles (n - 1) n) :=
  kernelSubobject_eq_imageSubobject_of_isColimit _ _ (L.toCycles_comp_homologyπ (n - 1) n)
    (L.homologyIsCokernel (n - 1) n (by simp))

/-- The image in `K^n` of the kernel of `Z^n(K^•) ⟶ H^n(K^•)` is the image of `d^{n-1}`. -/
lemma exists_iCycles_kernelSubobject_homologyπ (L : CochainComplex C ℤ) (n : ℤ) :
    (Subobject.exists (L.iCycles n)).obj (kernelSubobject (L.homologyπ n))
      = imageSubobject (L.d (n - 1) n) := by
  rw [kernelSubobject_homologyπ, ← Subobject.imageSubobject_comp_eq_exists,
      HomologicalComplex.toCycles_i]

variable (K : FilteredObject (CochainComplex (C) ℤ) ℤᵒᵖ) (n : ℤ)

/-- The cycles of the `p'`-th step of the filtration, as a subobject of `Z^n(K^•)`, are the cycles
lying in `F^{p'}K^n`. -/
private lemma imageSubobject_cyclesMap (p' : ℤ) :
    imageSubobject (HomologicalComplex.cyclesMap (K.filtration.ι.app (op p')) n)
      = (Subobject.pullback (K.X.iCycles n)).obj
          (Subobject.mk ((K.filtration.ι.app (op p')).f n)) := by
  have hc : HomologicalComplex.cyclesMap (K.filtration.ι.app (op p')) n ≫ K.X.iCycles n
      = (K.filtration.diagram.obj (op p')).iCycles n ≫ (K.filtration.ι.app (op p')).f n :=
    HomologicalComplex.cyclesMap_i _ _
  have key : (Subobject.exists (K.X.iCycles n)).obj
        (imageSubobject (HomologicalComplex.cyclesMap (K.filtration.ι.app (op p')) n))
      = (Subobject.exists (K.X.iCycles n)).obj ((Subobject.pullback (K.X.iCycles n)).obj
          (Subobject.mk ((K.filtration.ι.app (op p')).f n))) := by
    rw [← Subobject.imageSubobject_comp_eq_exists, hc, Subobject.imageSubobject_comp_eq_exists,
        imageSubobject_mono,
      mk_iCycles, exists_obj_kernelSubobject_d, Subobject.exists_pullback_eq_inf_of_mono,
          mk_iCycles]
    rfl
  rw [← Subobject.pullback_exists_eq_self_of_mono (K.X.iCycles n)
      (imageSubobject (HomologicalComplex.cyclesMap (K.filtration.ι.app (op p')) n)),
    key, Subobject.pullback_exists_eq_self_of_mono]

/-- **Stacks 012R**, upstairs: the step `F^{p'}H^n(K^•)` of the induced filtration is the image in
`H^n(K^•)` of the cycles lying in `F^{p'}K^n`. -/
private lemma mk_image_ι_homologyMap (p' : ℤ) :
    Subobject.mk (image.ι (HomologicalComplex.homologyMap (K.filtration.ι.app (op p')) n))
      = (Subobject.exists (K.X.homologyπ n)).obj ((Subobject.pullback (K.X.iCycles n)).obj
          (Subobject.mk ((K.filtration.ι.app (op p')).f n))) := by
  have hn : (K.filtration.diagram.obj (op p')).homologyπ n ≫
      HomologicalComplex.homologyMap (K.filtration.ι.app (op p')) n
      = HomologicalComplex.cyclesMap (K.filtration.ι.app (op p')) n ≫ K.X.homologyπ n :=
    HomologicalComplex.homologyπ_naturality _ _
  rw [← imageSubobject_cyclesMap, ← Subobject.imageSubobject_comp_eq_exists, ← hn]
  exact (imageSubobject_epi_comp _ _).symm

/-- **Stacks 012R.** The step `F^{p'}H^n(K^•)` of the induced filtration on cohomology, read as a
subobject of `K^n`, is `Ker(d^n) ∩ F^{p'}K^n + Im(d^{n-1})`. -/
@[stacks 012R]
lemma sub_image_homologyMap (F : ℤ → ∀ m : ℤ, Subobject (K.X.X m))
    (hF : ∀ p' m : ℤ, F p' m = Subobject.mk ((K.filtration.ι.app (op p')).f m)) (p' : ℤ) :
    (Subobject.exists (K.X.iCycles n)).obj ((Subobject.pullback (K.X.homologyπ n)).obj
        (Subobject.mk (image.ι (HomologicalComplex.homologyMap
          (K.filtration.ι.app (op p')) n))))
      = kernelSubobject (K.X.d n (n + 1)) ⊓ F p' n ⊔ imageSubobject (K.X.d (n - 1) n) := by
  rw [mk_image_ι_homologyMap, Abelian.Subobject.pullback_exists_eq_sup,
    (Subobject.existsPullbackAdj (K.X.iCycles n)).gc.l_sup,
        Subobject.exists_pullback_eq_inf_of_mono, inf_comm,
    exists_iCycles_kernelSubobject_homologyπ, mk_iCycles, hF p' n]

end InducedFiltration

section Comparison

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The cycles lying in `Fp`, as a subobject of `L^n`, are `Ker(d^n) ⊓ Fp`. -/
private lemma mk_arrow_comp_iCycles_eq_inf {L : CochainComplex C ℤ} {n : ℤ}
    {Fp : Subobject (L.X n)} {A : Subobject (L.cycles n)}
    (hA : A = (Subobject.pullback (L.iCycles n)).obj Fp) :
    Subobject.mk (A.arrow ≫ L.iCycles n) = kernelSubobject (L.d n (n + 1)) ⊓ Fp := by
  rw [← imageSubobject_mono, ← Subobject.exists_eq_imageSubobject, hA,
    Subobject.exists_pullback_eq_inf_of_mono, inf_comm, mk_iCycles]

/-- **Stacks 012F** for a cochain complex in a single degree. Let `L` be a cochain complex of an
abelian category, let `n : ℤ`, and let `Fp1 ≤ Fp` be two subobjects of `L^n` (the two steps
`F^{p+1}K^n ≤ F^pK^n` of a filtration, of which nothing else is used). Write `A` and `W` for the
cycles lying in `Fp` and in `Fp1`, `N = Ker(d^n) ⊓ Fp ⊔ Fp1`, `D = Im(d^{n-1}) ⊓ Fp ⊔ Fp1`, and let
`G` and `G'` be the images in `H^n(L)` of `A` and of `W`, presented by monomorphisms `m` and `m'`
with `ιm ≫ m = m'`. Then `N / D` is `G / G' = gr^p H^n(L)` by the unique isomorphism compatible
with the two canonical maps out of `A`. -/
private lemma exists_iso_cokernel_gr_homology (L : CochainComplex C ℤ) (n : ℤ)
    {Fp Fp1 : Subobject (L.X n)} (hFp : Fp1 ≤ Fp)
    {A W : Subobject (L.cycles n)}
    (hA : A = (Subobject.pullback (L.iCycles n)).obj Fp)
    (hW : W = (Subobject.pullback (L.iCycles n)).obj Fp1)
    {Nn Dd : Subobject (L.X n)}
    (hN : Nn = kernelSubobject (L.d n (n + 1)) ⊓ Fp ⊔ Fp1)
    (hD : Dd = imageSubobject (L.d (n - 1) n) ⊓ Fp ⊔ Fp1)
    (j : (Dd : C) ⟶ (Nn : C)) (hj : j ≫ Nn.arrow = Dd.arrow)
    {G G' : C} (m : G ⟶ L.homology n) [Mono m] (m' : G' ⟶ L.homology n) [Mono m']
    (hm : Subobject.mk m = imageSubobject (A.arrow ≫ L.homologyπ n))
    (hm' : Subobject.mk m' = imageSubobject (W.arrow ≫ L.homologyπ n))
    (ιm : G' ⟶ G) (hι : ιm ≫ m = m')
    (a : (A : C) ⟶ (Nn : C)) (ha : a ≫ Nn.arrow = A.arrow ≫ L.iCycles n)
    (b : (A : C) ⟶ G) (hb : b ≫ m = A.arrow ≫ L.homologyπ n) :
    ∃ e : cokernel j ≅ cokernel ιm, a ≫ cokernel.π j ≫ e.hom = b ≫ cokernel.π ιm := by
  have hprev : (ComplexShape.up ℤ).prev n = n - 1 := by simp
  have hdd : L.d (n - 1) n ≫ L.d n (n + 1) = 0 := L.d_comp_d _ _ _
  have hIdKd : imageSubobject (L.d (n - 1) n) ≤ kernelSubobject (L.d n (n + 1)) :=
    image_le_kernel _ _ hdd
  have h2 : Dd ≤ Nn := by rw [hD, hN]; exact sup_le_sup_right (inf_le_inf_right _ hIdKd) _
  have hFp1D : Fp1 ≤ Dd := by rw [hD]; exact le_sup_right
  have hFN : Fp1 ≤ Nn := hFp1D.trans h2
  have hjofLE : j = Subobject.ofLE Dd Nn h2 := by
    rw [← cancel_mono Nn.arrow, hj, Subobject.ofLE_arrow]
  have : Mono j := mono_of_mono_fac hj
  have : Mono ιm := mono_of_mono_fac hι
  -- the numerators of `A` and of `W` in `L^n`
  have hAFp : Fp.Factors (A.arrow ≫ L.iCycles n) := by
    rw [hA]; exact (pullback_factors_iff _ _ _).1 (Subobject.factors_self _)
  have hWFp1 : Fp1.Factors (W.arrow ≫ L.iCycles n) := by
    rw [hW]; exact (pullback_factors_iff _ _ _).1 (Subobject.factors_self _)
  have hAKd : (kernelSubobject (L.d n (n + 1))).Factors (A.arrow ≫ L.iCycles n) :=
    kernelSubobject_factors _ _ (by rw [Category.assoc, L.iCycles_d, comp_zero])
  have hAmk := mk_arrow_comp_iCycles_eq_inf hA
  have hAN : Subobject.mk (A.arrow ≫ L.iCycles n) ≤ Nn := by rw [hAmk, hN]; exact le_sup_left
  have haofLE : Subobject.ofLE (Subobject.mk (A.arrow ≫ L.iCycles n)) Nn hAN
      = (Subobject.underlyingIso (A.arrow ≫ L.iCycles n)).hom ≫ a := by
    rw [← cancel_mono Nn.arrow, Subobject.ofLE_arrow, Category.assoc, ha,
      Subobject.underlyingIso_hom_comp_eq_mk]
  -- the canonical epimorphism onto `G' = F^{p+1}H^n(L)`
  obtain ⟨π', hπ'epi, hπ'⟩ : ∃ π' : (W : C) ⟶ G', Epi π' ∧ π' ≫ m' = W.arrow ≫ L.homologyπ n := by
    obtain ⟨t, ht⟩ := exists_comp_eq_of_factors_mk m'
      (by rw [hm']; simpa using imageSubobject_factors_comp_self (W.arrow ≫ L.homologyπ n) (𝟙 _))
    exact ⟨t, epi_of_fac_of_mk_eq_imageSubobject ht hm', ht⟩
  have hbepi : Epi b := epi_of_fac_of_mk_eq_imageSubobject hb hm
  -- the map `A ⟶ N / D` is an epimorphism
  have : Epi (a ≫ cokernel.π j) := by
    rw [Preadditive.epi_iff_cancel_zero]
    intro R g hg
    have hjχ : j ≫ (cokernel.π j ≫ g) = 0 := by
      rw [← Category.assoc, cokernel.condition, zero_comp]
    have haχ : a ≫ (cokernel.π j ≫ g) = 0 := by rw [← Category.assoc]; exact hg
    obtain ⟨T', z, hz, β, γ, fac⟩ := Subobject.exists_refinement_of_factors_sup
      (x := Subobject.mk (A.arrow ≫ L.iCycles n)) (y := Fp1) Nn.arrow
      (by rw [show Subobject.mk (A.arrow ≫ L.iCycles n) ⊔ Fp1 = Nn from by rw [hAmk, hN]]
          exact Subobject.factors_self Nn)
    have hzd : z = β ≫ Subobject.ofLE _ Nn hAN + γ ≫ Subobject.ofLE _ Nn hFN := by
      rw [← cancel_mono Nn.arrow, fac, Preadditive.add_comp, Category.assoc, Category.assoc,
        Subobject.ofLE_arrow, Subobject.ofLE_arrow]
    have hzero : z ≫ (cokernel.π j ≫ g) = 0 := by
      rw [hzd, Preadditive.add_comp, Category.assoc, Category.assoc, haofLE, Category.assoc, haχ,
        comp_zero,
        show Subobject.ofLE Fp1 Nn hFN = Subobject.ofLE Fp1 Dd hFp1D ≫ j from by
          rw [hjofLE, Subobject.ofLE_comp_ofLE], Category.assoc, hjχ]
      simp
    have hπg : cokernel.π j ≫ g = 0 := (cancel_epi z).1 (by rw [hzero, comp_zero])
    exact (cancel_epi (cokernel.π j)).1 (by rw [hπg, comp_zero])
  have : Epi (b ≫ cokernel.π ιm) := epi_comp _ _
  -- the modular law computes the kernel of `A ⟶ N / D`
  have hmod : kernelSubobject (L.d n (n + 1)) ⊓ Fp ⊓ Dd
      ≤ imageSubobject (L.d (n - 1) n) ⊔ kernelSubobject (L.d n (n + 1)) ⊓ Fp1 := by
    have step1 : kernelSubobject (L.d n (n + 1)) ⊓ Fp ⊓ Dd
        ≤ (imageSubobject (L.d (n - 1) n) ⊔ Fp1) ⊓ kernelSubobject (L.d n (n + 1)) :=
      le_inf (inf_le_right.trans (by rw [hD]; exact sup_le_sup_right inf_le_left _))
        (inf_le_left.trans inf_le_left)
    refine step1.trans ((sup_inf_le_assoc_of_le _ hIdKd).trans ?_)
    exact sup_le_sup_left (le_inf inf_le_right inf_le_left) _
  -- what dies in `N / D` dies in `gr^p H^n(L)`
  have hkeru : ∀ {R : C} (k : R ⟶ (A : C)), k ≫ a ≫ cokernel.π j = 0 →
      k ≫ b ≫ cokernel.π ιm = 0 := by
    intro R k hk
    have hgD : Dd.Factors (k ≫ A.arrow ≫ L.iCycles n) := by
      have := factors_of_comp_cokernel_π_ofLE_eq_zero h2 (k ≫ a)
        (by rw [← hjofLE, Category.assoc]; exact hk)
      rwa [Category.assoc, ha] at this
    have hgA : (kernelSubobject (L.d n (n + 1)) ⊓ Fp).Factors (k ≫ A.arrow ≫ L.iCycles n) :=
      Subobject.factors_of_factors_right k ((Subobject.inf_factors _).2 ⟨hAKd, hAFp⟩)
    obtain ⟨T', z, hz, β, γ, fac⟩ := Subobject.exists_refinement_of_factors_sup
      (k ≫ A.arrow ≫ L.iCycles n)
      (Subobject.factors_of_le _ hmod ((Subobject.inf_factors _).2 ⟨hgA, hgD⟩))
    obtain ⟨l₁, hl₁, hl₁π⟩ := exists_liftCycles_comp_homologyπ_eq_zero
      (X := L) (le_refl (imageSubobject (L.d (n - 1) n)))
    obtain ⟨l₂, hl₂⟩ := exists_comp_iCycles_eq (kernelSubobject (L.d n (n + 1)) ⊓ Fp1).arrow
      (by rw [← Subobject.ofLE_arrow (inf_le_left : kernelSubobject (L.d n (n + 1)) ⊓ Fp1
        ≤ kernelSubobject (L.d n (n + 1))), Category.assoc, kernelSubobject_arrow_comp, comp_zero])
    have hdecomp : z ≫ k ≫ A.arrow = β ≫ l₁ + γ ≫ l₂ := by
      rw [← cancel_mono (L.iCycles n), Preadditive.add_comp]
      simp only [Category.assoc, hl₁, hl₂]
      exact fac
    have hl₂W : W.Factors l₂ := by
      rw [hW, pullback_factors_iff, hl₂]
      exact Subobject.factors_of_le _ inf_le_right (Subobject.factors_self _)
    obtain ⟨w, hw⟩ : ∃ w : _ ⟶ (W : C), w ≫ W.arrow = l₂ :=
      ⟨W.factorThru _ hl₂W, W.factorThru_arrow _ hl₂W⟩
    have key : (z ≫ k ≫ A.arrow) ≫ L.homologyπ n = γ ≫ l₂ ≫ L.homologyπ n := by
      rw [hdecomp, Preadditive.add_comp, Category.assoc, Category.assoc, hl₁π, comp_zero, zero_add]
    have hπw : (γ ≫ w ≫ π') ≫ m' = γ ≫ l₂ ≫ L.homologyπ n := by
      rw [← hw]
      simp only [Category.assoc]
      rw [← hπ']
    have hshape : (γ ≫ w ≫ π') ≫ m' = z ≫ (k ≫ A.arrow ≫ L.homologyπ n) := by
      rw [hπw, ← key]
      simp
    obtain ⟨s, hs⟩ := exists_comp_eq_of_factors_mk m'
      (Subobject.factors_of_epi_comp z _ (mk_factors_of_fac m' hshape))
    have hsι : s ≫ ιm = k ≫ b := by
      rw [← cancel_mono m]
      simp only [Category.assoc]
      rw [hι, hs, hb]
    rw [← Category.assoc, ← hsι, Category.assoc, cokernel.condition, comp_zero]
  -- what dies in `gr^p H^n(L)` dies in `N / D`
  have hkerv : ∀ {R : C} (k : R ⟶ (A : C)), k ≫ b ≫ cokernel.π ιm = 0 →
      k ≫ a ≫ cokernel.π j = 0 := by
    intro R k hk
    have hcond : (k ≫ b) ≫ cokernel.π ιm = 0 := by rw [Category.assoc]; exact hk
    have htι : Abelian.monoLift ιm (k ≫ b) hcond ≫ ιm = k ≫ b := Abelian.monoLift_comp _ _ _
    obtain ⟨T', z, hz, ω, fac⟩ :=
      surjective_up_to_refinements_of_epi π' (Abelian.monoLift ιm (k ≫ b) hcond)
    have e1 : (z ≫ k ≫ A.arrow) ≫ L.homologyπ n = (ω ≫ W.arrow) ≫ L.homologyπ n :=
      calc (z ≫ k ≫ A.arrow) ≫ L.homologyπ n
          = z ≫ (k ≫ b) ≫ m := by simp only [Category.assoc]; rw [hb]
        _ = ω ≫ π' ≫ m' := by
            rw [← htι, Category.assoc, hι, ← Category.assoc, fac, Category.assoc]
        _ = (ω ≫ W.arrow) ≫ L.homologyπ n := by rw [hπ', Category.assoc]
    have hφ : (z ≫ k ≫ A.arrow - ω ≫ W.arrow) ≫ L.homologyπ n = 0 := by
      rw [Preadditive.sub_comp, e1, sub_self]
    obtain ⟨T'', z', hz', ρ, fac'⟩ :=
      (CokernelCofork.IsColimit.comp_π_eq_zero_iff_up_to_refinements
        (L.homologyIsCokernel (n - 1) n hprev) _).1 hφ
    have hIdfac : (imageSubobject (L.d (n - 1) n)).Factors
        ((z' ≫ (z ≫ k ≫ A.arrow - ω ≫ W.arrow)) ≫ L.iCycles n) := by
      rw [fac', Category.assoc, HomologicalComplex.toCycles_i]
      exact imageSubobject_factors_comp_self _ ρ
    have hFpfac : Fp.Factors ((z' ≫ (z ≫ k ≫ A.arrow - ω ≫ W.arrow)) ≫ L.iCycles n) := by
      have hshape : (z' ≫ (z ≫ k ≫ A.arrow - ω ≫ W.arrow)) ≫ L.iCycles n
          = ((z' ≫ z) ≫ k) ≫ (A.arrow ≫ L.iCycles n)
            - (z' ≫ ω) ≫ (W.arrow ≫ L.iCycles n) := by
        simp [Preadditive.sub_comp, Preadditive.comp_sub]
      rw [hshape]
      exact Subobject.factors_sub _ _ (Subobject.factors_of_factors_right _ hAFp)
        (Subobject.factors_of_factors_right _ (Subobject.factors_of_le _ hFp hWFp1))
    have hDfac1 : Dd.Factors ((z' ≫ (z ≫ k ≫ A.arrow - ω ≫ W.arrow)) ≫ L.iCycles n) :=
      Subobject.factors_of_le _ (by rw [hD]; exact le_sup_left)
        ((Subobject.inf_factors _).2 ⟨hIdfac, hFpfac⟩)
    have hDfac2 : Dd.Factors ((z' ≫ ω) ≫ (W.arrow ≫ L.iCycles n)) :=
      Subobject.factors_of_le _ hFp1D (Subobject.factors_of_factors_right _ hWFp1)
    have hDfin : Dd.Factors (z' ≫ z ≫ k ≫ A.arrow ≫ L.iCycles n) := by
      have hshape : z' ≫ z ≫ k ≫ A.arrow ≫ L.iCycles n
          = (z' ≫ (z ≫ k ≫ A.arrow - ω ≫ W.arrow)) ≫ L.iCycles n
            + (z' ≫ ω) ≫ (W.arrow ≫ L.iCycles n) := by
        simp [Preadditive.sub_comp, Preadditive.comp_sub]
      rw [hshape]
      exact Subobject.factors_add _ _ hDfac1 hDfac2
    have hDk : Dd.Factors (k ≫ A.arrow ≫ L.iCycles n) :=
      Subobject.factors_of_epi_comp z _ (Subobject.factors_of_epi_comp z' _ hDfin)
    obtain ⟨s, hs⟩ : ∃ s : _ ⟶ (Dd : C), s ≫ Dd.arrow = k ≫ A.arrow ≫ L.iCycles n :=
      ⟨Dd.factorThru _ hDk, Dd.factorThru_arrow _ hDk⟩
    have hsj : s ≫ j = k ≫ a := by
      rw [← cancel_mono Nn.arrow]
      simp only [Category.assoc]
      rw [hj, hs, ha]
    rw [← Category.assoc, ← hsj, Category.assoc, cokernel.condition, comp_zero]
  obtain ⟨e, he⟩ := Subobject.exists_iso_of_epi_of_kernel (a ≫ cokernel.π j) (b ≫ cokernel.π ιm)
    (hkeru _ (kernel.condition _)) (hkerv _ (kernel.condition _))
  exact ⟨e, by rw [← Category.assoc]; exact he⟩

end Comparison

/-- Clause (1) of [Stacks, Tag 012V]: weak convergence in one bidegree is equality in (012S) and
(012T). -/
lemma weakly_converges_iff {C : Type u} [Category.{v} C] [Abelian C]
    (K : FilteredObject (CochainComplex C ℤ) ℤᵒᵖ) (p n : ℤ)
    (F : ℤ → ∀ m : ℤ, Subobject (K.X.X m))
    (hF : ∀ p' m : ℤ, F p' m = Subobject.mk ((K.filtration.ι.app (op p')).f m))
    (A : Subobject (K.X.cycles n))
    (hA : A = (Subobject.pullback (K.X.iCycles n)).obj (F p n))
    (N D : Subobject (K.X.X n))
    (hN : N = kernelSubobject (K.X.d n (n + 1)) ⊓ F p n ⊔ F (p + 1) n)
    (hD : D = imageSubobject (K.X.d (n - 1) n) ⊓ F p n ⊔ F (p + 1) n)
    (Z B : Subobject (K.X.X n))
    (hZ : IsGLB (Set.range fun r : ℕ =>
      F p n ⊓ (Subobject.pullback (K.X.d n (n + 1))).obj (F (p + r) (n + 1)) ⊔ F (p + 1) n) Z)
    (hB : IsLUB (Set.range fun r : ℕ =>
      F p n ⊓ (Subobject.«exists» (K.X.d (n - 1) n)).obj (F (p - r) (n - 1)) ⊔ F (p + 1) n) B)
    (a : (A : C) ⟶ (Z : C)) (ha : a ≫ Z.arrow = A.arrow ≫ K.X.iCycles n)
    (b : (A : C) ⟶ image (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))
    (hb : b ≫ image.ι (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n) =
      A.arrow ≫ K.X.homologyπ n) :
    (∃ e : cokernel (Subobject.ofLE (B ⊓ Z) Z inf_le_right) ≅
          cokernel (image.preComp
            (HomologicalComplex.homologyMap (K.filtration.diagram.map
              (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
            (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n)),
        a ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right) ≫ e.hom =
          b ≫ cokernel.π (image.preComp
            (HomologicalComplex.homologyMap (K.filtration.diagram.map
              (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
            (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))) ↔
      Z = N ∧ B = D := by
  have hIdKd : imageSubobject (K.X.d (n - 1) n) ≤ kernelSubobject (K.X.d n (n + 1)) :=
    image_le_kernel _ _ (K.X.d_comp_d _ _ _)
  have hA' := mk_arrow_comp_iCycles_eq_inf hA
  have hBle : B ≤ D := hD ▸ isLUB_le_imageSubobject_inf_sup hB
  have hNle : N ≤ Z := by
    refine hZ.2 ?_
    rintro s ⟨r, rfl⟩
    rw [hN]
    refine sup_le_sup_right (le_inf inf_le_right (inf_le_left.trans ?_)) _
    rw [← Subobject.exists_le_iff_le_pullback, Subobject.exists_kernelSubobject]
    exact bot_le
  have hDN : D ≤ N := by
    rw [hD, hN]
    exact sup_le_sup_right (inf_le_inf_right _ hIdKd) _
  have hFB : F (p + 1) n ≤ B := le_trans le_sup_right (hB.1 ⟨0, rfl⟩)
  have himg : Subobject.mk (image.ι (HomologicalComplex.homologyMap
        (K.filtration.ι.app (op p)) n)) = imageSubobject (A.arrow ≫ K.X.homologyπ n) := by
    rw [mk_image_ι_homologyMap, ← hF p n, ← hA, Subobject.exists_eq_imageSubobject]
  have hbepi : Epi b := epi_of_fac_of_mk_eq_imageSubobject hb himg
  constructor
  · rintro ⟨e, he⟩
    have hα : a ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right)
        = (b ≫ cokernel.π (image.preComp
            (HomologicalComplex.homologyMap (K.filtration.diagram.map
              (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
            (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))) ≫ e.inv := by
      rw [← he, Category.assoc, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    have hαepi : Epi (a ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right)) := by
      rw [hα]
      exact epi_comp _ _
    have hZle : Z ≤ N := by
      have h1 := le_sup_imageSubobject_of_epi (inf_le_right : B ⊓ Z ≤ Z) a hαepi
      rw [ha, imageSubobject_mono, hA'] at h1
      exact h1.trans (sup_le (by rw [hN]; exact le_sup_left)
        ((inf_le_left.trans hBle).trans hDN))
    have hkerβα : kernel.ι (b ≫ cokernel.π (image.preComp
          (HomologicalComplex.homologyMap (K.filtration.diagram.map
            (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
          (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n)))
        ≫ (a ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right)) = 0 := by
      rw [hα, ← Category.assoc, kernel.condition, zero_comp]
    have htmk : Subobject.mk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        ≤ Subobject.mk (A.arrow ≫ K.X.iCycles n) := by
      rw [Subobject.mk_arrow, hA']
      exact inf_le_inf_right _ hIdKd
    have htfac : Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk ≫ (A.arrow ≫ K.X.iCycles n)
        = (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow := Subobject.ofMkLEMk_comp htmk
    have hker : kernelSubobject (K.X.homologyπ n)
        = (Subobject.pullback (K.X.iCycles n)).obj (imageSubobject (K.X.d (n - 1) n)) := by
      rw [← exists_iCycles_kernelSubobject_homologyπ, Subobject.pullback_exists_eq_self_of_mono]
    have hfac : (kernelSubobject (K.X.homologyπ n)).Factors
        (Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
          (A.arrow ≫ K.X.iCycles n) htmk ≫ A.arrow) := by
      rw [hker, pullback_factors_iff, Category.assoc, htfac]
      exact Subobject.factors_of_le _ inf_le_left (Subobject.factors_self _)
    have hzero : (Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk ≫ A.arrow) ≫ K.X.homologyπ n = 0 :=
      (kernelSubobject_factors_iff _ _).1 hfac
    have htb : Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk ≫ b = 0 := by
      rw [← cancel_mono (image.ι (HomologicalComplex.homologyMap
        (K.filtration.ι.app (op p)) n)), zero_comp, Category.assoc, hb, ← Category.assoc, hzero]
    have htβ : Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk ≫ (b ≫ cokernel.π (image.preComp
          (HomologicalComplex.homologyMap (K.filtration.diagram.map
            (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
          (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))) = 0 := by
      rw [← Category.assoc, htb, zero_comp]
    have htα : Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk
        ≫ (a ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right)) = 0 := by
      rw [← kernel.lift_ι _ _ htβ, Category.assoc, hkerβα, comp_zero]
    have hmonoz : (Subobject.ofMkLEMk (imageSubobject (K.X.d (n - 1) n) ⊓ F p n).arrow
        (A.arrow ≫ K.X.iCycles n) htmk ≫ a)
        ≫ cokernel.π (Subobject.ofLE (B ⊓ Z) Z inf_le_right) = 0 := by
      rw [Category.assoc]
      exact htα
    have harr : Subobject.ofLE (B ⊓ Z) Z inf_le_right ≫ Z.arrow = (B ⊓ Z).arrow := by
      rw [Subobject.ofLE_arrow]
    have hTBZ : imageSubobject (K.X.d (n - 1) n) ⊓ F p n ≤ B ⊓ Z := by
      refine Subobject.le_of_comm (Abelian.monoLift _ _ hmonoz) ?_
      rw [← harr, ← Category.assoc, Abelian.monoLift_comp, Category.assoc, ha, htfac]
    have hDB : D ≤ B := by
      rw [hD]
      exact sup_le (hTBZ.trans inf_le_left) hFB
    exact ⟨le_antisymm hZle hNle, le_antisymm hBle hDB⟩
  · rintro ⟨hZN, hBD⟩
    have hBZle : B ≤ Z := hBD.le.trans (hDN.trans hZN.ge)
    have hnat : K.filtration.diagram.map
        (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op ≫ K.filtration.ι.app (op p)
        = K.filtration.ι.app (op (p + 1)) :=
      K.filtration.diagram_map_comp_ι_app _
    have hFple : F (p + 1) n ≤ F p n := by
      rw [hF (p + 1) n, hF p n]
      refine Subobject.mk_le_mk_of_comm ((K.filtration.diagram.map
        (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op).f n) ?_
      rw [← HomologicalComplex.comp_f, hnat]
    have hfg : HomologicalComplex.homologyMap (K.filtration.diagram.map
          (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n
        ≫ HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n
        = HomologicalComplex.homologyMap (K.filtration.ι.app (op (p + 1))) n := by
      rw [← HomologicalComplex.homologyMap_comp, hnat]
    have hm' : Subobject.mk (image.ι (HomologicalComplex.homologyMap
          (K.filtration.diagram.map
            (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n
          ≫ HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))
        = imageSubobject (((Subobject.pullback (K.X.iCycles n)).obj (F (p + 1) n)).arrow
            ≫ K.X.homologyπ n) := by
      rw [hfg, mk_image_ι_homologyMap K n (p + 1), ← hF (p + 1) n,
          Subobject.exists_eq_imageSubobject]
    exact exists_iso_cokernel_gr_homology K.X n hFple hA rfl (hZN.trans hN)
      ((inf_eq_left.2 hBZle).trans (hBD.trans hD))
      (Subobject.ofLE (B ⊓ Z) Z inf_le_right) (by rw [Subobject.ofLE_arrow])
      (image.ι (HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))
      (image.ι (HomologicalComplex.homologyMap (K.filtration.diagram.map
          (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n
        ≫ HomologicalComplex.homologyMap (K.filtration.ι.app (op p)) n))
      himg hm' (image.preComp _ _) (image.preComp_ι _ _) a ha b hb

end
