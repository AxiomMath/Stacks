module

public import Mathlib.Algebra.Category.ModuleCat.ChangeOfRings
public import StacksFrontier.Algebra.Homology.SpectralSequence.AbutsToAnnihilation

/-!
# The annihilated filtration of an abutment, read over a base ring

`Stacks.SpectralSequence.Annihilation.AbutsTo.exists_filtration_of_mem_annihilator_of_iso`
filters the abutment of an annihilated spectral sequence of `R`-modules, and asks for the
identification of that abutment with the module one is interested in to be an isomorphism of
`R`-modules. A consumer does not always have one: the spectral sequence may be a sequence of
modules over a ring `R` reached from the ring `A` of interest by a homomorphism `ρ : A →+* R` —
as the hypercohomology spectral sequence [Stacks, Tag 0G9Q] on the blowup of `Spec A` is a
sequence of `Γ(X, 𝒪_X)`-modules while the identification of its abutment with
`Tor_i^A(M, Iᑫ)` of [Stacks, Tag 0G9Z] is an identification of `A`-modules.

This file supplies that variant: the filtration of a module `T` over the *base* ring `A`,
identified with the restriction of scalars of the abutment along `ρ`, out of annihilation of the
page by the ideal generated by the image of an ideal of `A`.

Nothing here is about spectral sequences. Restriction of scalars along `ρ` changes neither the
underlying additive group nor the lattice of subgroups, so a submodule of an `R`-module *is* a
submodule of its restriction of scalars; the only arithmetic is that `a • x = ρ a • x`, which
turns annihilation by `Ideal.map ρ J` upstairs into annihilation by `J` downstairs.

## Main definitions

* `Stacks.SpectralSequence.Annihilation.restrictScalarsSubmodule`: a submodule of an `R`-module,
  read as a submodule of its restriction of scalars.

## Main results

* `Stacks.SpectralSequence.Annihilation.mem_annihilator_restrictScalars` and
  `Stacks.SpectralSequence.Annihilation.le_annihilator_restrictScalars`: an ideal of `A` whose
  image annihilates an `R`-module annihilates its restriction of scalars.
* `Stacks.SpectralSequence.Annihilation.AbutsTo`
  `.exists_filtration_of_mem_annihilator_of_restrictScalars_iso`: **the annihilated filtration of
  the abutment, on a module over the base ring.**

## References

* [Stacks Project, Tag 0GA1](https://stacks.math.columbia.edu/tag/0GA1)
* [Stacks Project, Tag 0G9Q](https://stacks.math.columbia.edu/tag/0G9Q)
* [Stacks Project, Tag 0G9Z](https://stacks.math.columbia.edu/tag/0G9Z)
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits

namespace Stacks.SpectralSequence.Annihilation

variable {A R : Type u} [CommRing A] [CommRing R] (ρ : A →+* R)

/-! ### Submodules and annihilators under restriction of scalars -/

/-- **A submodule of an `R`-module, read as a submodule of its restriction of scalars along
`ρ : A →+* R`.** The underlying set is unchanged: the `A`-action is the `R`-action through `ρ`,
so the same subset is closed under it. -/
def restrictScalarsSubmodule {M : ModuleCat.{u} R} (S : Submodule R M) :
    Submodule A ((ModuleCat.restrictScalars ρ).obj M) where
  carrier := {x | x ∈ S}
  add_mem' := S.add_mem
  zero_mem' := S.zero_mem
  smul_mem' a _ hx := S.smul_mem (ρ a) hx

/-- An element of the restriction of scalars lies in `restrictScalarsSubmodule ρ S` if and only
if, as an element of `M`, it lies in `S`. -/
@[simp] theorem mem_restrictScalarsSubmodule {M : ModuleCat.{u} R} (S : Submodule R M)
    (x : (ModuleCat.restrictScalars ρ).obj M) :
    x ∈ restrictScalarsSubmodule ρ S ↔ (show M from x) ∈ S := Iff.rfl

/-- The top submodule of `M`, read over `A`, is the top submodule of the restriction of
scalars. -/
@[simp] theorem restrictScalarsSubmodule_top {M : ModuleCat.{u} R} :
    restrictScalarsSubmodule ρ (⊤ : Submodule R M) = ⊤ := rfl

/-- The zero submodule of `M`, read over `A`, is the zero submodule of the restriction of
scalars. -/
@[simp] theorem restrictScalarsSubmodule_bot {M : ModuleCat.{u} R} :
    restrictScalarsSubmodule ρ (⊥ : Submodule R M) = ⊥ := by
  ext x
  exact Submodule.mem_bot R

/-- **Restriction of scalars turns annihilation by the image ideal into annihilation by the
ideal.** -/
theorem smul_restrictScalarsSubmodule_le {M : ModuleCat.{u} R} {S T : Submodule R M}
    (J : Ideal A) (h : J.map ρ • S ≤ T) :
    J • restrictScalarsSubmodule ρ S ≤ restrictScalarsSubmodule ρ T := by
  refine Submodule.smul_le.2 fun a ha x hx => ?_
  exact h (Submodule.smul_mem_smul (Ideal.mem_map_of_mem ρ ha) hx)

/-- An element whose image annihilates an `R`-module annihilates its restriction of scalars. -/
theorem mem_annihilator_restrictScalars {M : ModuleCat.{u} R} {a : A}
    (ha : ρ a ∈ Module.annihilator R M) :
    a ∈ Module.annihilator A ((ModuleCat.restrictScalars ρ).obj M) :=
  Module.mem_annihilator.2 fun x => Module.mem_annihilator.1 ha (show M from x)

/-- An ideal whose image annihilates an `R`-module annihilates its restriction of scalars. -/
theorem le_annihilator_restrictScalars {M : ModuleCat.{u} R} {J : Ideal A}
    (hJ : J.map ρ ≤ Module.annihilator R M) :
    J ≤ Module.annihilator A ((ModuleCat.restrictScalars ρ).obj M) :=
  fun _ ha => mem_annihilator_restrictScalars ρ (hJ (Ideal.mem_map_of_mem ρ ha))

/-! ### The filtration of the abutment over the base ring -/

open CategoryTheory.SpectralSequence in
/-- **The annihilated filtration of the abutment, on a module over a base ring.**
`Stacks.SpectralSequence.Annihilation.AbutsTo.exists_filtration_of_mem_annihilator_of_iso` for a
spectral sequence of `R`-modules whose abutment is identified, *after restriction of scalars
along* `ρ : A →+* R`, with a module `T` over the base ring: if the ideal generated by the image
of `J ⊆ A` annihilates the antidiagonal of total degree `n` on the page `s`, and that antidiagonal
vanishes outside the band of `N` columns, then `T` carries a filtration in `N` steps whose graded
pieces are annihilated by `J`.

This is the shape [Stacks, Tag 0GA1] needs. There the spectral sequence is the hypercohomology
spectral sequence [Stacks, Tag 0G9Q] on the blowup, a sequence of `Γ(X, 𝒪_X)`-modules, while the
identification of its abutment with `Tor_i^A(M, Iᑫ)` of [Stacks, Tag 0G9Z] is an identification
of `A`-modules; the hypothesis `hfilt` of
`Stacks.LocalCohomology.UniformityII.exists_pow_le_annihilator_tor_quotient_pow` is a filtration
by `A`-submodules. -/
theorem AbutsTo.exists_filtration_of_mem_annihilator_of_restrictScalars_iso {r₀ : ℤ}
    {E : CohomologicalSpectralSequence (ModuleCat.{u} R) r₀} {H : ℤ → ModuleCat.{u} R}
    (hE : AbutsTo E H) {s : ℤ} (hs : r₀ ≤ s) (J : Ideal A) (n : ℤ) (N : ℕ)
    (hvanish : ∀ p : ℤ, p < 0 ∨ (N : ℤ) ≤ p → IsZero ((E.page s hs).X (p, n - p)))
    (hann : ∀ p : ℤ, J.map ρ ≤ Module.annihilator R ((E.page s hs).X (p, n - p)))
    {T : ModuleCat.{u} A} (e : (ModuleCat.restrictScalars ρ).obj (H n) ≅ T) :
    ∃ F : ℕ → Submodule A T, F 0 = ⊤ ∧ F N = ⊥ ∧ ∀ k, J • F k ≤ F (k + 1) := by
  obtain ⟨F, h0, hN, hstep⟩ :=
    AbutsTo.exists_filtration_of_mem_annihilator hE hs (J.map ρ) n N hvanish hann
  refine ⟨fun k => (restrictScalarsSubmodule ρ (F k)).map
    (e.toLinearEquiv : (ModuleCat.restrictScalars ρ).obj (H n) →ₗ[A] T), ?_, ?_, fun k => ?_⟩
  · dsimp only
    rw [h0, restrictScalarsSubmodule_top, Submodule.map_top, LinearMap.range_eq_top]
    exact e.toLinearEquiv.surjective
  · dsimp only
    rw [hN, restrictScalarsSubmodule_bot, Submodule.map_bot]
  · dsimp only
    rw [← Submodule.map_smul'']
    exact Submodule.map_mono (smul_restrictScalarsSubmodule_le ρ J (hstep k))

end Stacks.SpectralSequence.Annihilation

end
