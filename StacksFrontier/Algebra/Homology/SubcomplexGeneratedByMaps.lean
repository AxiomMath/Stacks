module

public import StacksFrontier.Algebra.Homology.SubcomplexEnlargementAtADegree

/-!
# The subcomplex generated by a complex and finitely many maps into the terms of a complex

Let `𝓜` be a cochain complex in an abelian category, let `τ : T ⟶ 𝓜` be a morphism of complexes
and let `gᵢ : Pᵢ ⟶ 𝓜^{nᵢ}` be finitely many morphisms into its terms. The **subcomplex generated
by `τ` and the `gᵢ`** has in degree `n` the image of

`((⨁ᵢ Pᵢ) ⊕ (⨁ᵢ Pᵢ)) ⊕ T^n ⟶ 𝓜^n`,

whose first block is `gᵢ` on the summands with `nᵢ = n`, whose second block is `gᵢ ≫ d` on the
summands with `nᵢ + 1 = n`, and whose last component is `τ`. The differential of `𝓜` carries the
first block of degree `n` onto the second block of degree `n + 1`, kills the second block, and is
the differential of `T` on `T`, so the images form a subcomplex. Each `gᵢ` and `τ` factors
through it, and each of its terms is a quotient of `((⨁ᵢ Pᵢ) ⊕ (⨁ᵢ Pᵢ)) ⊕ T^n`.

This is the subcomplex of [Stacks, Tag 0FPV] "generated by the sections `fᵢ` and `d(fᵢ)`": over a
final object of a site a section of a sheaf of modules is a morphism out of the structure sheaf,
and the subcomplex is then a complex of quotients of finite free modules.

## Main results

* `CochainComplex.exists_subcomplex_generated`: the subcomplex, its degreewise monic inclusion,
  the factorization of `τ` and of each `gᵢ`, and the epimorphism onto each term from
  `((⨁ᵢ Pᵢ) ⊕ (⨁ᵢ Pᵢ)) ⊕ T^n`.

## Implementation notes

No complex is defined by cases on the degree: the generating map of degree `n` is one formula for
every `n`, the two blocks selecting their summands by a decidable equality of degrees, and the
transport between the degrees `nᵢ` and `n` is `HomologicalComplex.XIsoOfEq`.

## References

* [Stacks Project, Tag 0FPV](https://stacks.math.columbia.edu/tag/0FPV)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace CochainComplex

variable {A : Type u} [Category.{v} A] [Abelian A]

attribute [local instance] Abelian.hasFiniteBiproducts

variable (M : CochainComplex A ℤ) {ι : Type} [Fintype ι] (deg : ι → ℤ) (P : ι → A)
  (g : ∀ i, P i ⟶ M.X (deg i)) {T : CochainComplex A ℤ} (τ : T ⟶ M)

/-- The first block of the generating map of degree `n`: `gᵢ` on the summands of degree `n`. -/
private def genFst (n : ℤ) (i : ι) : P i ⟶ M.X n :=
  if h : deg i = n then g i ≫ (M.XIsoOfEq h).hom else 0

/-- The second block of the generating map of degree `n`: `gᵢ ≫ d` on the summands of degree
`n - 1`. -/
private def genSnd (n : ℤ) (i : ι) : P i ⟶ M.X n :=
  if _ : deg i + 1 = n then g i ≫ M.d (deg i) n else 0

/-- **The generating map of degree `n`**: the two blocks of the maps `gᵢ`, and the given complex
`T` through `τ`. -/
private def gen (n : ℤ) : ((⨁ P) ⊞ (⨁ P)) ⊞ T.X n ⟶ M.X n :=
  biprod.desc
    (biprod.desc (biproduct.desc (genFst M deg P g n)) (biproduct.desc (genSnd M deg P g n)))
    (τ.f n)

/-- The lift of the differential: the first block of degree `n` onto the second block of degree
`n + 1`, the second block to zero, and the differential of `T` on `T`. -/
private def genD (n : ℤ) : ((⨁ P) ⊞ (⨁ P)) ⊞ T.X n ⟶ ((⨁ P) ⊞ (⨁ P)) ⊞ T.X (n + 1) :=
  biprod.map (biprod.desc biprod.inr 0) (T.d n (n + 1))

omit [Fintype ι] in
private theorem genFst_d (n : ℤ) (i : ι) :
    genFst M deg P g n i ≫ M.d n (n + 1) = genSnd M deg P g (n + 1) i := by
  by_cases h : deg i = n
  · subst h
    simp [genFst, genSnd]
  · have h' : ¬ deg i + 1 = n + 1 := by omega
    simp [genFst, genSnd, h, h']

omit [Fintype ι] in
private theorem genSnd_d (n : ℤ) (i : ι) : genSnd M deg P g n i ≫ M.d n (n + 1) = 0 := by
  by_cases h : deg i + 1 = n
  · subst h
    simp [genSnd]
  · simp [genSnd, h]

private theorem genD_gen (n : ℤ) :
    genD P n ≫ gen M deg P g τ (n + 1) = gen M deg P g τ n ≫ M.d n (n + 1) := by
  refine biprod.hom_ext' _ _ (biprod.hom_ext' _ _ ?_ ?_) ?_
  · refine biproduct.hom_ext' _ _ fun i => ?_
    simp [genD, gen, genFst_d]
  · refine biproduct.hom_ext' _ _ fun i => ?_
    simp [genD, gen, genSnd_d]
  · simp [genD, gen]

/-- The differential of the generated subcomplex, induced on the images. -/
private def genDimg (n : ℤ) :
    image (gen M deg P g τ n) ⟶ image (gen M deg P g τ (n + 1)) :=
  image.map (Arrow.homMk' (genD P n) (M.d n (n + 1)) (genD_gen M deg P g τ n))

private theorem genDimg_ι (n : ℤ) :
    genDimg M deg P g τ n ≫ image.ι (gen M deg P g τ (n + 1)) =
      image.ι (gen M deg P g τ n) ≫ M.d n (n + 1) :=
  image.map_homMk'_ι _

private theorem genDimg_comp (n : ℤ) :
    genDimg M deg P g τ n ≫ genDimg M deg P g τ (n + 1) = 0 := by
  rw [← cancel_mono (image.ι (gen M deg P g τ (n + 1 + 1))), Category.assoc, genDimg_ι,
    ← Category.assoc, genDimg_ι, Category.assoc, HomologicalComplex.d_comp_d, comp_zero,
    zero_comp]

/-- **The generated subcomplex.** -/
private def generated : CochainComplex A ℤ :=
  CochainComplex.of (fun n => image (gen M deg P g τ n)) (genDimg M deg P g τ)
    (genDimg_comp M deg P g τ)

private theorem generated_d (n : ℤ) :
    (generated M deg P g τ).d n (n + 1) = genDimg M deg P g τ n :=
  CochainComplex.of_d (fun n => image (gen M deg P g τ n)) (genDimg M deg P g τ) n

/-- The inclusion of the generated subcomplex. -/
private def generatedι : generated M deg P g τ ⟶ M where
  f n := image.ι (gen M deg P g τ n)
  comm' i j hij := by
    obtain rfl : i + 1 = j := hij
    rw [generated_d]
    exact (genDimg_ι M deg P g τ i).symm


private theorem gen_fac (i : ι) :
    (biproduct.ι P i ≫ biprod.inl ≫ biprod.inl ≫ factorThruImage (gen M deg P g τ (deg i))) ≫
      image.ι (gen M deg P g τ (deg i)) = g i := by
  rw [Category.assoc, Category.assoc, Category.assoc, image.fac]
  simp [gen, genFst]

private theorem gen_fac_τ (n : ℤ) :
    (biprod.inr ≫ factorThruImage (gen M deg P g τ n)) ≫ image.ι (gen M deg P g τ n) = τ.f n := by
  rw [Category.assoc, image.fac]
  simp [gen]

/-- The comparison of `T` with the generated subcomplex. -/
private def generatedρ : T ⟶ generated M deg P g τ where
  f n := biprod.inr ≫ factorThruImage (gen M deg P g τ n)
  comm' i j hij := by
    obtain rfl : i + 1 = j := hij
    rw [generated_d]
    change (biprod.inr ≫ factorThruImage (gen M deg P g τ i)) ≫ genDimg M deg P g τ i =
      T.d i (i + 1) ≫ (biprod.inr ≫ factorThruImage (gen M deg P g τ (i + 1)))
    refine (cancel_mono (image.ι (gen M deg P g τ (i + 1)))).1 ?_
    rw [Category.assoc, genDimg_ι, ← Category.assoc, gen_fac_τ, Category.assoc, gen_fac_τ]
    exact τ.comm i (i + 1)

omit [Fintype ι] in
/-- **The subcomplex generated by a complex and finitely many maps.** For a morphism of complexes
`τ : T ⟶ 𝓜` and finitely many morphisms `gᵢ : Pᵢ ⟶ 𝓜^{nᵢ}` into the terms of a cochain complex
`𝓜` in an abelian category there are a complex `K`, a degreewise monomorphism `θ : K ⟶ 𝓜` and a
morphism `ρ : T ⟶ K` with `ρ ≫ θ = τ`, through which every `gᵢ` factors, each term of `K` being a
quotient of `((⨁ᵢ Pᵢ) ⊕ (⨁ᵢ Pᵢ)) ⊕ T^n`. -/
theorem exists_subcomplex_generated [Finite ι] :
    ∃ (K : CochainComplex A ℤ) (θ : K ⟶ M) (ρ : T ⟶ K), (∀ n, Mono (θ.f n)) ∧ ρ ≫ θ = τ ∧
      (∀ i, ∃ t : P i ⟶ K.X (deg i), t ≫ θ.f (deg i) = g i) ∧
      ∀ n, ∃ q : ((⨁ P) ⊞ (⨁ P)) ⊞ T.X n ⟶ K.X n, Epi q := by
  classical
  have := Fintype.ofFinite ι
  refine ⟨generated M deg P g τ, generatedι M deg P g τ, generatedρ M deg P g τ,
    fun n => inferInstanceAs (Mono (image.ι _)),
    HomologicalComplex.hom_ext _ _ fun n => gen_fac_τ M deg P g τ n, fun i => ?_,
    fun n => ⟨factorThruImage (gen M deg P g τ n), inferInstanceAs (Epi (factorThruImage _))⟩⟩
  exact ⟨biproduct.ι P i ≫ biprod.inl ≫ biprod.inl ≫ factorThruImage (gen M deg P g τ (deg i)),
    gen_fac M deg P g τ i⟩

end CochainComplex

end
