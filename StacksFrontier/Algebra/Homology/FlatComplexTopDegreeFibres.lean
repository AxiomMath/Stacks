module

public import StacksFrontier.Algebra.Homology.FlatComplexTopDegree
public import StacksFrontier.RingTheory.Jacobson.MaximalSmulTorsion
public import StacksFrontier.AlgebraicGeometry.DeRham.PoincareDuality.TopDifferentialCechHomology
public import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# A morphism of flat complexes which vanishes on top cohomology modulo every maximal ideal

Let `R` be a Noetherian Jacobson domain and `φ : K ⟶ L` a morphism of bounded complexes of flat
`R`-modules whose cohomology vanishes above degree `d = q + 1`, with `Hᵈ(L)` a finite `R`-module.
If `φ ⊗ R/𝔪` is zero on `Hᵈ` for every maximal ideal `𝔪` of `R`, then `φ ⊗ k` is zero on `Hᵈ`
for every field `k` containing `R`.

Indeed `Hᵈ(K ⊗ N)` is generated by the classes of `z ⊗ 1` for `z` a cocycle of `K` (the cycles of
`K ⊗ N` in degree `d` are `Zᵈ(K) ⊗ N`, `Stacks.FlatComplexTopDegree.range_lTensor_ker_subtype`),
and `Zᵈ(L) ⊗ N ⟶ Lᵈ ⊗ N` is injective. So the class of `φ z` in `Hᵈ(L)` lies in `𝔪 Hᵈ(L)` for
every maximal ideal `𝔪`, hence is torsion
(`Stacks.JacobsonTorsion.exists_smul_eq_zero_of_forall_mem_smul_top`), and dies in `Hᵈ(L ⊗ k)`.

This is the algebraic step of the reduction to positive characteristic in [Stacks, Tag 0FW6].
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits ModuleCat
open scoped TensorProduct ChangeOfRings

universe u

namespace Stacks.FlatComplexTopDegree

variable {R : Type u} [CommRing R]

/-- A cochain complex of modules whose cohomology in degree `i + 1` vanishes is exact at
`K^{i+1}`, as a sequence of linear maps. -/
theorem exact_of_isZero_homology (K : CochainComplex (ModuleCat.{u} R) ℕ) (i : ℕ)
    (h : IsZero (K.homology (i + 1))) :
    Function.Exact (K.d i (i + 1)).hom (K.d (i + 1) (i + 1 + 1)).hom := by
  have hS := (K.exactAt_iff' i (i + 1) (i + 1 + 1) (CochainComplex.prev_nat_succ i)
    (CochainComplex.next ℕ (i + 1))).1 ((K.exactAt_iff_isZero_homology (i + 1)).2 h)
  exact LinearMap.exact_iff.2 ((ShortComplex.moduleCat_exact_iff_range_eq_ker _).1 hS).symm

/-- The ring `S` as an `R`-module along `ψ : R →+* S`; extension of scalars along `ψ` is
`S ⊗_R -` for this module structure. -/
abbrev ringModule {S : Type u} [CommRing S] (ψ : R →+* S) : ModuleCat.{u} R :=
  (restrictScalars ψ).obj (ModuleCat.of S S)

/-- The element `s ∈ S`, as an element of `ringModule ψ`. -/
abbrev toRingModule {S : Type u} [CommRing S] (ψ : R →+* S) (s : S) : ringModule ψ := s

/-- The `R`-action on `ringModule ψ` is multiplication by the image under `ψ`. -/
theorem smul_toRingModule {S : Type u} [CommRing S] (ψ : R →+* S) (r : R) (s : S) :
    r • toRingModule ψ s = toRingModule ψ (ψ r * s) := rfl

/-- Extension of scalars along `ψ` sends `g : M ⟶ M'` to the map `s ⊗ m ↦ s ⊗ g m`. -/
theorem extendScalars_map_tmul {S : Type u} [CommRing S] (ψ : R →+* S) {M M' : ModuleCat.{u} R}
    (g : M ⟶ M') (s : ringModule ψ) (m : M) :
    (extendScalars ψ).map g (show (extendScalars ψ).obj M from s ⊗ₜ[R] m) = s ⊗ₜ[R] g m := rfl

/-- The `S`-action on the extension of scalars of `M` along `ψ` is `s' • (s ⊗ m) = (s' * s) ⊗ m`.
-/
theorem extendScalars_smul_tmul {S : Type u} [CommRing S] (ψ : R →+* S) {M : ModuleCat.{u} R}
    (s' s : S) (m : M) :
    s' • (show (extendScalars ψ).obj M from toRingModule ψ s ⊗ₜ[R] m) =
      (show (extendScalars ψ).obj M from toRingModule ψ (s' * s) ⊗ₜ[R] m) := rfl

/-- Extension of scalars on morphisms is `lTensor` of the base-changed ring. -/
theorem extendScalars_map_apply {S : Type u} [CommRing S] (ψ : R →+* S) {M M' : ModuleCat.{u} R}
    (g : M ⟶ M') (x : (extendScalars ψ).obj M) :
    (extendScalars ψ).map g x = (g.hom.lTensor (ringModule ψ)) x := by
  induction x using TensorProduct.induction_on with
  | zero => exact (map_zero _).trans (map_zero _).symm
  | tmul s m => rfl
  | add x y hx hy => exact (map_add _ x y).trans ((congrArg₂ _ hx hy).trans (map_add _ x y).symm)

/-- Along a surjective ring map `R → S`, every element of `S ⊗_R M` is of the form `1 ⊗ v`. -/
theorem exists_one_tmul_eq {S : Type u} [CommRing S] (ψ : R →+* S) (hψ : Function.Surjective ψ)
    {M : ModuleCat.{u} R} (w : TensorProduct R (ringModule ψ) M) :
    ∃ v : M, toRingModule ψ 1 ⊗ₜ[R] v = w := by
  induction w using TensorProduct.induction_on with
  | zero => exact ⟨0, TensorProduct.tmul_zero _ _⟩
  | tmul s m =>
    obtain ⟨a, ha⟩ := hψ s
    exact ⟨a • m, by rw [← TensorProduct.smul_tmul, smul_toRingModule, mul_one, ha]⟩
  | add x y hx hy =>
    obtain ⟨v, rfl⟩ := hx
    obtain ⟨v', rfl⟩ := hy
    exact ⟨v + v', TensorProduct.tmul_add _ _ _⟩

/-- **`1 ⊗ x = 0` in `R/𝔪 ⊗_R M` forces `x ∈ 𝔪 M`.** -/
theorem mem_smul_top_of_one_tmul_eq_zero (m : Ideal R) {M : Type u} [AddCommGroup M] [Module R M]
    (x : M) (h : toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] x = 0) :
    x ∈ m • (⊤ : Submodule R M) := by
  let e : ringModule (Ideal.Quotient.mk m) ≃ₗ[R] R ⧸ m :=
    { toFun := fun s => (s : R ⧸ m)
      invFun := fun s => s
      map_add' := fun _ _ => rfl
      map_smul' := fun r s => by
        show Ideal.Quotient.mk m r * (show R ⧸ m from s) = r • (show R ⧸ m from s)
        rw [Algebra.smul_def]
        rfl
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have h2 : TensorProduct.quotTensorEquivQuotSMul M m
      (TensorProduct.congr e (LinearEquiv.refl R M) (toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] x))
      = 0 := by
    rw [h, map_zero, map_zero]
  rw [TensorProduct.congr_tmul] at h2
  change TensorProduct.quotTensorEquivQuotSMul M m ((1 : R ⧸ m) ⊗ₜ[R] x) = 0 at h2
  rw [TensorProduct.quotTensorEquivQuotSMul_mk_one_tmul] at h2
  exact (Submodule.Quotient.mk_eq_zero _).1 h2

/-- **A morphism of flat complexes over a Noetherian Jacobson domain which is zero on top
cohomology modulo every maximal ideal is zero on top cohomology over any field containing the
ring.** Let `φ : K ⟶ L` be a morphism of complexes of flat `R`-modules vanishing in degrees
`≥ n`, whose cohomology vanishes above degree `q + 1`, with `H^{q+1}(L)` finite. If
`φ ⊗ R/𝔪` induces zero on `H^{q+1}` for every maximal ideal `𝔪`, then so does `φ ⊗ k` for every
injective ring map `R → k` into a field. -/
theorem homologyMap_extendScalars_eq_zero_of_forall_isMaximal [IsDomain R] [IsNoetherianRing R]
    [IsJacobsonRing R] {K L : CochainComplex (ModuleCat.{u} R) ℕ} (φ : K ⟶ L) (q n : ℕ)
    [∀ i, Module.Flat R (K.X i)] [∀ i, Module.Flat R (L.X i)]
    (hKn : ∀ i, n ≤ i → Subsingleton (K.X i)) (hLn : ∀ i, n ≤ i → Subsingleton (L.X i))
    (hK : ∀ i, q + 1 < i → IsZero (K.homology i)) (hL : ∀ i, q + 1 < i → IsZero (L.homology i))
    [Module.Finite R (L.homology (q + 1))]
    (hm : ∀ m : Ideal R, m.IsMaximal → HomologicalComplex.homologyMap
      (((extendScalars (Ideal.Quotient.mk m)).mapHomologicalComplex (ComplexShape.up ℕ)).map φ)
        (q + 1) = 0)
    {k : Type u} [Field k] (ι : R →+* k) (hι : Function.Injective ι) :
    HomologicalComplex.homologyMap
      (((extendScalars ι).mapHomologicalComplex (ComplexShape.up ℕ)).map φ) (q + 1) = 0 := by
  classical
  have hex : ∀ (C : CochainComplex (ModuleCat.{u} R) ℕ), (∀ i, q + 1 < i → IsZero (C.homology i)) →
      ∀ i, q + 1 ≤ i → Function.Exact (C.d i (i + 1)).hom (C.d (i + 1) (i + 1 + 1)).hom :=
    fun C hC i _ => exact_of_isZero_homology C i (hC (i + 1) (by omega))
  let S := L.sc' q (q + 1) (q + 1 + 1)
  have : Module.Finite R (LinearMap.ker S.g.hom ⧸ LinearMap.range S.moduleCatToCycles) :=
    Module.Finite.equiv ((L.homologyIsoSc' q (q + 1) (q + 1 + 1) (CochainComplex.prev_nat_succ q)
      (CochainComplex.next ℕ (q + 1))) ≪≫ S.moduleCatHomologyIso).toLinearEquiv
  have key : ∀ z : K.X (q + 1), K.d (q + 1) (q + 1 + 1) z = 0 →
      ∃ y : (extendScalars ι).obj (L.X q),
        (extendScalars ι).map (L.d q (q + 1)) y = (show (extendScalars ι).obj (L.X (q + 1)) from
          toRingModule ι 1 ⊗ₜ[R] φ.f (q + 1) z) := by
    intro z hz
    have hc : L.d (q + 1) (q + 1 + 1) (φ.f (q + 1) z) = 0 :=
      (ConcreteCategory.congr_hom (φ.comm (q + 1) (q + 1 + 1)) z).trans
        ((congrArg (φ.f (q + 1 + 1)) hz).trans (map_zero _))
    let c : LinearMap.ker S.g.hom := ⟨φ.f (q + 1) z, hc⟩
    have hmem : ∀ m : Ideal R, m.IsMaximal →
        (Submodule.Quotient.mk c : LinearMap.ker S.g.hom ⧸ LinearMap.range S.moduleCatToCycles) ∈
          m • (⊤ : Submodule R _) := by
      intro m hm'
      obtain ⟨w, hw⟩ := (CochainComplex.moduleCat_homologyMap_succ_eq_zero_iff _ q).1 (hm m hm')
        (toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] z)
        ((extendScalars_map_tmul _ _ _ z).trans ((congrArg
          (toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] ·) hz).trans (TensorProduct.tmul_zero _ _)))
      obtain ⟨v, rfl⟩ := exists_one_tmul_eq (Ideal.Quotient.mk m) Ideal.Quotient.mk_surjective w
      change (extendScalars _).map (L.d q (q + 1)) (toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] v) =
        (extendScalars _).map (φ.f (q + 1)) (toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] z) at hw
      rw [extendScalars_map_tmul, extendScalars_map_tmul] at hw
      have hinj := lTensor_ker_subtype_injective (C := fun i => L.X i)
        (fun i => (L.d i (i + 1)).hom) (q + 1) n hLn (hex L hL)
        (ringModule (Ideal.Quotient.mk m))
      have h1 : toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] (c - S.moduleCatToCycles v) = 0 := by
        refine hinj (((LinearMap.lTensor_tmul _ _ _ _).trans ?_).trans (map_zero _).symm)
        show toRingModule (Ideal.Quotient.mk m) 1 ⊗ₜ[R] (φ.f (q + 1) z - L.d q (q + 1) v) = 0
        exact (TensorProduct.tmul_sub _ _ _).trans (sub_eq_zero.2 hw.symm)
      have h3 : (Submodule.Quotient.mk c : LinearMap.ker S.g.hom ⧸
          LinearMap.range S.moduleCatToCycles) =
          Submodule.Quotient.mk (c - S.moduleCatToCycles v) := by
        have h0 : (Submodule.Quotient.mk (S.moduleCatToCycles v) : LinearMap.ker S.g.hom ⧸
            LinearMap.range S.moduleCatToCycles) = 0 :=
          (Submodule.Quotient.mk_eq_zero _).2 (LinearMap.mem_range_self _ v)
        exact (sub_zero _).symm.trans
          ((congrArg (fun t => Submodule.Quotient.mk c - t) h0).symm.trans
            (Submodule.Quotient.mk_sub ..).symm)
      rw [h3]
      refine Submodule.smul_induction_on (mem_smul_top_of_one_tmul_eq_zero m _ h1)
        (fun a ha y _ => ?_) (fun y y' hy hy' => ?_)
      · rw [Submodule.Quotient.mk_smul]
        exact Submodule.smul_mem_smul ha Submodule.mem_top
      · rw [Submodule.Quotient.mk_add]
        exact add_mem hy hy'
    obtain ⟨r, hr0, hr⟩ := Stacks.JacobsonTorsion.exists_smul_eq_zero_of_forall_mem_smul_top _ hmem
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hr
    obtain ⟨v, hv⟩ := hr
    have hv' : L.d q (q + 1) v = r • φ.f (q + 1) z := congrArg Subtype.val hv
    refine ⟨toRingModule ι (ι r)⁻¹ ⊗ₜ[R] v, ?_⟩
    have hone : r • toRingModule ι (ι r)⁻¹ = toRingModule ι 1 :=
      (smul_toRingModule ι r _).trans (congrArg _ (mul_inv_cancel₀ ((map_ne_zero_iff ι hι).2 hr0)))
    exact (extendScalars_map_tmul ι _ _ v).trans ((congrArg _ hv').trans
      ((TensorProduct.smul_tmul _ _ _).symm.trans (congrArg (· ⊗ₜ[R] φ.f (q + 1) z) hone)))
  rw [CochainComplex.moduleCat_homologyMap_succ_eq_zero_iff]
  intro x hx
  change (extendScalars ι).map (K.d (q + 1) (q + 1 + 1)) x = 0 at hx
  show ∃ y : (extendScalars ι).obj (L.X q),
    (extendScalars ι).map (L.d q (q + 1)) y = (extendScalars ι).map (φ.f (q + 1)) x
  rw [extendScalars_map_apply] at hx
  obtain ⟨w, rfl⟩ := (congrArg (fun P => x ∈ P) (range_lTensor_ker_subtype (C := fun i => K.X i)
    (fun i => (K.d i (i + 1)).hom) (q + 1) n hKn (hex K hK) (ringModule ι))).mpr hx
  clear hx
  induction w using TensorProduct.induction_on with
  | zero => exact ⟨0, (map_zero _).trans (((congrArg _ (map_zero _)).trans (map_zero _)).symm)⟩
  | tmul s z =>
    obtain ⟨y, hy⟩ := key z.1 z.2
    refine ⟨(show k from s) • y, ?_⟩
    refine (((extendScalars ι).map (L.d q (q + 1))).hom.map_smul (show k from s) y).trans ?_
    refine (congrArg _ hy).trans ?_
    refine (extendScalars_smul_tmul ι (show k from s) 1 _).trans ?_
    rw [mul_one]
    rfl
  | add a b ha hb =>
    obtain ⟨ya, hya⟩ := ha
    obtain ⟨yb, hyb⟩ := hb
    exact ⟨ya + yb, (map_add _ _ _).trans ((congrArg₂ (· + ·) hya hyb).trans
      (((congrArg _ (map_add _ _ _)).trans (map_add _ _ _)).symm))⟩

end Stacks.FlatComplexTopDegree
