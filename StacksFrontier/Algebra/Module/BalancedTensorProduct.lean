module

public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The balanced tensor product of a right and a left module

Let `R` be a commutative ring, let `A` be a ring, let `M` be a right `A`-module and let `N` be a
left `A`-module, both of them also `R`-modules. The *balanced tensor product* `M ⊗_A N` is the
quotient of `M ⊗_R N` by the submodule generated by the balancing relations
`x a ⊗ y - x ⊗ a y`. It is an `R`-module, it is generated by the symbols `x ⊗ y`, and it is the
receptacle of the universal `A`-balanced `R`-bilinear map `M × N → M ⊗_A N`, so that

`Bilinear_A(M × N, Q) = Hom_R(M ⊗_A N, Q)`

for every `R`-module `Q`.

## Main definitions

* `StacksDraft.IsBalancedBilinear`: `A`-balancedness of a bilinear map, `f (x a) y = f x (a y)`.
* `StacksDraft.BalancedTensorProduct` ([stacks 09LL]): the `R`-module `M ⊗_A N`.
* `StacksDraft.BalancedTensorProduct.tmul` ([stacks 09LL]): the universal map `(x, y) ↦ x ⊗ y`.
* `StacksDraft.BalancedTensorProduct.lift`: the map out of `M ⊗_A N` determined by an
  `A`-balanced bilinear map, with the variant `liftBiadditive` taking a biadditive map and its
  homogeneity in each variable.
* `StacksDraft.balancedBilinearMaps`: the `R`-module `Bilinear_A(M × N, Q)`.

## Main results

* `StacksDraft.BalancedTensorProduct.tmul_balanced` ([stacks 09LL]): the universal map is
  `A`-balanced, which is the relation `x a ⊗ y = x ⊗ a y`.
* `StacksDraft.BalancedTensorProduct.span_tmul_eq_top` ([stacks 09LL]): `M ⊗_A N` is generated
  as an `R`-module by the symbols `x ⊗ y`.
* `StacksDraft.BalancedTensorProduct.liftEquiv` ([stacks 09LL]): the identification
  `Bilinear_A(M × N, Q) = Hom_R(M ⊗_A N, Q)`, as an `R`-linear equivalence.
* `StacksDraft.BalancedTensorProduct.existsUnique_lift`: every `A`-balanced bilinear map factors
  uniquely through the universal one.

## Implementation notes

The source takes `A` to be an `R`-algebra. Neither the construction nor the universal property
uses the compatibility of the two scalar actions: what is needed is a ring `A` acting on `M` on
the right and on `N` on the left, together with `R`-module structures on `M` and on `N`, and the
`R`-algebra case is the special case. The ambient `M ⊗_R N` already identifies the `R`-action
coming from `M` with the one coming from `N`, which for an `R`-algebra is the identification the
source makes using the centrality of the image of `R`.

A right `A`-module is a module over the opposite ring, so the right action is written
`MulOpposite.op a • x` and the balancing relation reads
`MulOpposite.op a • x ⊗ y = x ⊗ a • y`.

The displayed identity of Hom-sets is realized as an `R`-linear equivalence rather than an
equality of types, which is the only faithful reading in a type-theoretic setting; the
`A`-balanced bilinear maps form an `R`-submodule `balancedBilinearMaps` of the bilinear maps,
which is the left-hand side `Bilinear_A(M × N, Q)`. The `∃!` form `existsUnique_lift` is the same
statement read as a universal property.

The base ring, the ring `A`, the two modules and the target all have independent universes; the
carrier of `M ⊗_A N` lives in the maximum of the two module universes, as `M ⊗_R N` does.

## References

* [Stacks Project, Tag 09LL](https://stacks.math.columbia.edu/tag/09LL)
-/

@[expose] public section

open scoped TensorProduct

namespace StacksDraft

universe u v w w' t

variable (R : Type u) [CommRing R] (A : Type v) [Ring A]
  (M : Type w) [AddCommGroup M] [Module R M] [Module (MulOpposite A) M]
  (N : Type w') [AddCommGroup N] [Module R N] [Module A N]

/-- An `R`-bilinear map out of a right `A`-module `M` and a left `A`-module `N` is
*`A`-balanced* when `f (x a) y = f x (a y)` for all `x : M`, `a : A` and `y : N`. -/
@[ega "III 7.2.1"]
def IsBalancedBilinear {R : Type u} [CommRing R] (A : Type v) [Ring A]
    {M : Type w} [AddCommGroup M] [Module R M] [Module (MulOpposite A) M]
    {N : Type w'} [AddCommGroup N] [Module R N] [Module A N]
    {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →ₗ[R] N →ₗ[R] Q) : Prop :=
  ∀ (x : M) (a : A) (y : N), f (MulOpposite.op a • x) y = f x (a • y)

/-- The submodule of `M ⊗_R N` generated by the balancing relations `x a ⊗ y - x ⊗ a y`. -/
def balancingRelations : Submodule R (M ⊗[R] N) :=
  Submodule.span R {z | ∃ (x : M) (a : A) (y : N),
    z = (MulOpposite.op a • x) ⊗ₜ[R] y - x ⊗ₜ[R] (a • y)}

/-- The tensor product `M ⊗_A N` of a right `A`-module `M` and a left `A`-module `N`: the quotient
of `M ⊗_R N` by the balancing relations `x a ⊗ y - x ⊗ a y`. -/
@[stacks 09LL "the tensor product"]
def BalancedTensorProduct : Type (max w w') :=
  (M ⊗[R] N) ⧸ balancingRelations R A M N

namespace BalancedTensorProduct

/-- The additive group structure of `M ⊗_A N`, inherited from the quotient. -/
instance : AddCommGroup (BalancedTensorProduct R A M N) :=
  inferInstanceAs (AddCommGroup ((M ⊗[R] N) ⧸ balancingRelations R A M N))

/-- The `R`-module structure of `M ⊗_A N`, inherited from the quotient. -/
instance : Module R (BalancedTensorProduct R A M N) :=
  inferInstanceAs (Module R ((M ⊗[R] N) ⧸ balancingRelations R A M N))

/-- The projection of `M ⊗_R N` onto `M ⊗_A N`. -/
def mk : (M ⊗[R] N) →ₗ[R] BalancedTensorProduct R A M N :=
  (balancingRelations R A M N).mkQ

/-- The universal `A`-balanced bilinear map `(x, y) ↦ x ⊗ y` of `M ⊗_A N`. -/
@[stacks 09LL "the universal bilinear map"]
def tmul : M →ₗ[R] N →ₗ[R] BalancedTensorProduct R A M N :=
  LinearMap.compr₂ (TensorProduct.mk R M N) (mk R A M N)

/-- The symbol `x ⊗ y` is the class of the pure tensor `x ⊗ y` of `M ⊗_R N`. -/
@[simp]
theorem tmul_apply (x : M) (y : N) : tmul R A M N x y = mk R A M N (x ⊗ₜ[R] y) :=
  rfl

/-- The universal map is `A`-balanced: `x a ⊗ y = x ⊗ a y`. This is the balancing relation the
tensor product is defined by. -/
@[stacks 09LL "the balancing relation"]
theorem tmul_balanced : IsBalancedBilinear A (tmul R A M N) := fun x a y =>
  (Submodule.Quotient.eq (balancingRelations R A M N)).2
    (Submodule.subset_span ⟨x, a, y, rfl⟩)

/-- Pure tensors generate `M ⊗_A N` as an `R`-module: every element is an `R`-linear
combination of symbols `x ⊗ y`. -/
theorem mem_span_tmul (z : BalancedTensorProduct R A M N) :
    z ∈ Submodule.span R (Set.range fun p : M × N => tmul R A M N p.1 p.2) := by
  have hcomap : (Submodule.span R (Set.range fun p : M × N => tmul R A M N p.1 p.2)).comap
      (mk R A M N) = ⊤ := by
    rw [eq_top_iff, ← TensorProduct.span_tmul_eq_top R M N, Submodule.span_le]
    rintro t ⟨x, y, rfl⟩
    exact Submodule.subset_span ⟨(x, y), rfl⟩
  obtain ⟨w, rfl⟩ := Submodule.mkQ_surjective (balancingRelations R A M N) z
  have hw : w ∈ (Submodule.span R (Set.range fun p : M × N => tmul R A M N p.1 p.2)).comap
      (mk R A M N) := by
    rw [hcomap]; exact Submodule.mem_top
  exact hw

/-- As an `R`-module, `M ⊗_A N` is generated by the symbols `x ⊗ y`. -/
@[stacks 09LL "generated by the symbols x ⊗ y"]
theorem span_tmul_eq_top :
    Submodule.span R (Set.range fun p : M × N => tmul R A M N p.1 p.2) = ⊤ :=
  eq_top_iff.2 fun z _ => mem_span_tmul R A M N z

/-- Two `R`-linear maps out of `M ⊗_A N` that agree on the symbols `x ⊗ y` are equal. -/
theorem hom_ext {Q : Type t} [AddCommGroup Q] [Module R Q]
    (g g' : BalancedTensorProduct R A M N →ₗ[R] Q)
    (h : ∀ (x : M) (y : N), g (tmul R A M N x y) = g' (tmul R A M N x y)) : g = g' := by
  refine Submodule.linearMap_qext _ (TensorProduct.ext' fun x y => ?_)
  exact h x y

variable {R A M N}

/-- An `A`-balanced bilinear map kills the balancing relations, so that the map it induces on
`M ⊗_R N` descends to `M ⊗_A N`. -/
theorem balancingRelations_le_ker {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q) (hf : IsBalancedBilinear A f) :
    balancingRelations R A M N ≤ LinearMap.ker (TensorProduct.lift f) :=
  Submodule.span_le.2 <| by
    rintro z ⟨x, a, y, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, TensorProduct.lift.tmul,
      hf x a y, sub_self]

/-- The `R`-linear map out of `M ⊗_A N` determined by an `A`-balanced `R`-bilinear map
`f : M × N → Q`; it sends `x ⊗ y` to `f x y`. -/
@[ega "III 7.2.1"]
def lift {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalancedBilinear A f) : BalancedTensorProduct R A M N →ₗ[R] Q :=
  Submodule.liftQ _ (TensorProduct.lift f) (balancingRelations_le_ker f hf)

/-- The map determined by `f` sends `x ⊗ y` to `f x y`. -/
@[simp]
theorem lift_tmul {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalancedBilinear A f) (x : M) (y : N) : lift f hf (tmul R A M N x y) = f x y :=
  rfl

/-- A biadditive map which is `R`-homogeneous in each variable, as an `R`-bilinear map. -/
def bilinearOfBiadditive {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →+ N →+ Q)
    (h₁ : ∀ (r : R) (x : M) (y : N), f (r • x) y = r • f x y)
    (h₂ : ∀ (r : R) (x : M) (y : N), f x (r • y) = r • f x y) : M →ₗ[R] N →ₗ[R] Q where
  toFun x :=
    { toFun := fun y => f x y
      map_add' := (f x).map_add
      map_smul' := fun r y => h₂ r x y }
  map_add' x x' := LinearMap.ext fun y => DFunLike.congr_fun (f.map_add x x') y
  map_smul' r x := LinearMap.ext fun y => h₁ r x y

/-- Reading a biadditive map as a bilinear map does not change its
values. -/
@[simp]
theorem bilinearOfBiadditive_apply {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →+ N →+ Q)
    (h₁ : ∀ (r : R) (x : M) (y : N), f (r • x) y = r • f x y)
    (h₂ : ∀ (r : R) (x : M) (y : N), f x (r • y) = r • f x y) (x : M) (y : N) :
    bilinearOfBiadditive f h₁ h₂ x y = f x y :=
  rfl

/-- The `R`-linear map out of `M ⊗_A N` determined by an `A`-balanced biadditive map which is
`R`-homogeneous in each variable. No `R`-module structure on a space of linear maps enters the
statement, which is what makes this usable when the `R`-action on the target arrives by a
nonstandard path. -/
def liftBiadditive {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →+ N →+ Q)
    (h₁ : ∀ (r : R) (x : M) (y : N), f (r • x) y = r • f x y)
    (h₂ : ∀ (r : R) (x : M) (y : N), f x (r • y) = r • f x y)
    (hbal : ∀ (x : M) (a : A) (y : N), f (MulOpposite.op a • x) y = f x (a • y)) :
    BalancedTensorProduct R A M N →ₗ[R] Q :=
  lift (bilinearOfBiadditive f h₁ h₂) hbal

/-- The map determined by a biadditive `f` sends `x ⊗ y` to `f x y`. -/
@[simp]
theorem liftBiadditive_tmul {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →+ N →+ Q)
    (h₁ : ∀ (r : R) (x : M) (y : N), f (r • x) y = r • f x y)
    (h₂ : ∀ (r : R) (x : M) (y : N), f x (r • y) = r • f x y)
    (hbal : ∀ (x : M) (a : A) (y : N), f (MulOpposite.op a • x) y = f x (a • y))
    (x : M) (y : N) : liftBiadditive f h₁ h₂ hbal (tmul R A M N x y) = f x y :=
  rfl

/-- Every `A`-balanced `R`-bilinear map `M × N → Q` factors uniquely through the universal
balanced map `(x, y) ↦ x ⊗ y`. This is the universal property of `M ⊗_A N`. -/
@[ega "III 7.2.1" "partial"]
theorem existsUnique_lift {Q : Type t} [AddCommGroup Q] [Module R Q] (f : M →ₗ[R] N →ₗ[R] Q)
    (hf : IsBalancedBilinear A f) :
    ∃! g : BalancedTensorProduct R A M N →ₗ[R] Q,
      ∀ (x : M) (y : N), g (tmul R A M N x y) = f x y :=
  ⟨lift f hf, fun _ _ => rfl, fun g hg =>
    hom_ext R A M N g (lift f hf) fun x y => (hg x y).trans (lift_tmul f hf x y).symm⟩

end BalancedTensorProduct

/-- The `R`-module `Bilinear_A(M × N, Q)` of `A`-balanced `R`-bilinear maps `M × N → Q`, as a
submodule of the `R`-module of all `R`-bilinear maps. -/
def balancedBilinearMaps (Q : Type t) [AddCommGroup Q] [Module R Q] :
    Submodule R (M →ₗ[R] N →ₗ[R] Q) where
  carrier := {f | IsBalancedBilinear A f}
  add_mem' hf hg := fun x a y => by
    simp only [LinearMap.add_apply, hf x a y, hg x a y]
  zero_mem' := fun _ _ _ => by simp only [LinearMap.zero_apply]
  smul_mem' c f hf := fun x a y => by
    simp only [LinearMap.smul_apply, hf x a y]

/-- Membership in `Bilinear_A(M × N, Q)` is `A`-balancedness. -/
@[simp]
theorem mem_balancedBilinearMaps {Q : Type t} [AddCommGroup Q] [Module R Q]
    (f : M →ₗ[R] N →ₗ[R] Q) : f ∈ balancedBilinearMaps R A M N Q ↔ IsBalancedBilinear A f :=
  Iff.rfl

namespace BalancedTensorProduct

/-- The identification `Bilinear_A(M × N, Q) = Hom_R(M ⊗_A N, Q)`: composing with the universal
map `(x, y) ↦ x ⊗ y` is an `R`-linear bijection from the `R`-linear maps out of `M ⊗_A N` onto the
`A`-balanced `R`-bilinear maps `M × N → Q`. -/
@[stacks 09LL "Bilinear_A(M × N, Q) = Hom_R(M ⊗_A N, Q)", ega "III 7.2.1"]
def liftEquiv (Q : Type t) [AddCommGroup Q] [Module R Q] :
    balancedBilinearMaps R A M N Q ≃ₗ[R] (BalancedTensorProduct R A M N →ₗ[R] Q) where
  toFun f := lift f.1 f.2
  map_add' _ _ := hom_ext R A M N _ _ fun _ _ => rfl
  map_smul' _ _ := hom_ext R A M N _ _ fun _ _ => rfl
  invFun g := ⟨LinearMap.compr₂ (tmul R A M N) g, fun x a y =>
    congrArg g (tmul_balanced R A M N x a y)⟩
  left_inv _ := Subtype.ext (LinearMap.ext fun _ => LinearMap.ext fun _ => rfl)
  right_inv _ := hom_ext R A M N _ _ fun _ _ => rfl

/-- The identification sends an `A`-balanced bilinear map `f` to the map taking
`x ⊗ y` to `f x y`. -/
@[simp]
theorem liftEquiv_apply_tmul (Q : Type t) [AddCommGroup Q] [Module R Q]
    (f : balancedBilinearMaps R A M N Q) (x : M) (y : N) :
    liftEquiv R A M N Q f (tmul R A M N x y) = (f : M →ₗ[R] N →ₗ[R] Q) x y :=
  rfl

/-- Its inverse sends a map `g` out of `M ⊗_A N` to the balanced bilinear map
`(x, y) ↦ g (x ⊗ y)`. -/
@[simp]
theorem liftEquiv_symm_apply (Q : Type t) [AddCommGroup Q] [Module R Q]
    (g : BalancedTensorProduct R A M N →ₗ[R] Q) (x : M) (y : N) :
    ((liftEquiv R A M N Q).symm g : M →ₗ[R] N →ₗ[R] Q) x y = g (tmul R A M N x y) :=
  rfl

end BalancedTensorProduct

end StacksDraft

end
