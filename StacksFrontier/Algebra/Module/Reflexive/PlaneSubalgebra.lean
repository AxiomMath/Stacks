module

public import Mathlib.LinearAlgebra.Dual.Defs
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.RingTheory.MvPolynomial.Basic
public import StacksFrontier.Algebra.Module.Reflexive

/-!
# The plane subalgebra `k[y, x², xy, x³]` and its rank-one module

Let `A = k[x, y]` be the polynomial ring in two variables over a field and let
`R = k[y, x², xy, x³]` be the subalgebra generated by `y`, `x²`, `xy` and `x³`.  The ring `R` is a
Noetherian domain which fails Serre's condition `(S₂)`, while `A` is a reflexive `R`-module
satisfying `(S₂)`.  Writing `m = (y, x², xy, x³) ⊆ R`, the two successive `R`-duals of `A` are
`m` and `A`.  This file packages that computation of Example 0EBB into named declarations: a
fixed choice of the two duality isomorphisms, the description of `m` by vanishing of the
constant coefficient, the endomorphism module of `A` over `R`, the double dual of `m ⊗_R A`, and
the two non-isomorphism statements that make `R` a counterexample.

## Main definitions

* `Stacks.PlaneSubalgebra.plane` is the polynomial ring `k[x, y]`, with `x = X 0` and `y = X 1`.
* `Stacks.PlaneSubalgebra.generators` is the set `{y, x², xy, x³}` of generators.
* `Stacks.PlaneSubalgebra.adjoinGenerators` is the subalgebra `R = k[y, x², xy, x³]`.
* `Stacks.PlaneSubalgebra.generatorIdeal` is the ideal `m = (y, x², xy, x³)` of `R`.
* `Stacks.PlaneSubalgebra.dualPlaneEquiv` and `Stacks.PlaneSubalgebra.dualGeneratorIdealEquiv`
  are the two duality isomorphisms `A* ≃ m` and `m* ≃ A`, fixed once and for all.
* `Stacks.PlaneSubalgebra.endEquiv` identifies an `R`-endomorphism of `A` with its value at one.

## Main results

* `propertySkModule_of_linearEquiv` (of `StacksFrontier.Algebra.Module.Reflexive`): Serre's
  condition `(Sₖ)` transports along a linear
  equivalence.
* `nonempty_dual_dual_tensor_equiv_of_dual_end`: the generic double-dual computation for a
  tensor product, from which the concrete one below is a single application.
* `Stacks.PlaneSubalgebra.mem_generatorIdeal_iff_constantCoeff`: an element of `R` lies in `m`
  exactly when its constant coefficient vanishes.
* `Stacks.PlaneSubalgebra.dualPlaneEquiv_mul_apply` and
  `Stacks.PlaneSubalgebra.dualGeneratorIdealEquiv_apply_coe` specify the two isomorphisms.
* `Stacks.PlaneSubalgebra.isReflexive_plane`, `Stacks.PlaneSubalgebra.propertySkModule_plane`
  and `Stacks.PlaneSubalgebra.not_propertySkModule_self`: `A` is reflexive and `(S₂)` over `R`,
  while `R` itself is not `(S₂)`.
* `Stacks.PlaneSubalgebra.endEquiv_mul_apply`: every `R`-endomorphism of `A` is multiplication
  by its value at one.
* `Stacks.PlaneSubalgebra.nonempty_dual_dual_tensor_equiv`: the double `R`-dual of `m ⊗_R A` is
  isomorphic to `m`.
* `Stacks.PlaneSubalgebra.not_nonempty_linearEquiv_plane_generatorIdeal` and
  `Stacks.PlaneSubalgebra.not_nonempty_linearEquiv_generatorIdeal_self`: `A` is not isomorphic
  to `m`, and `m` is not isomorphic to `R`.

## Implementation notes

We represent `k[x, y]` by `MvPolynomial (Fin 2) k`, with `x = X 0` and `y = X 1`.  The subalgebra
and the ideal are introduced as opaque definitions rather than as local abbreviations for their
defining terms: typeclass synthesis then treats `↥(adjoinGenerators k)` as an atom instead of
unfolding a five-element `Algebra.adjoin` through several coercion layers, which is what makes
the proofs below fit inside the default elaboration budgets.  Both definitions are nevertheless
definitionally equal to the corresponding data of
`mvPolynomial_adjoin_reflexive_propertyS2_module_not_propertyS2`, so that theorem can be quoted
directly; `generatorIdeal_eq_span` records the bridge in rewritable form.

All of the content extracted from the imported existential is routed through the reducible
abbreviation `Stacks.PlaneSubalgebra.spec`, so that the duality isomorphisms are *one* fixed
choice: downstream code referring to `dualPlaneEquiv` and `dualGeneratorIdealEquiv` gets the
same maps every time.

The double dual of `m ⊗_R k[x, y]` is computed by `nonempty_dual_dual_tensor_equiv_of_dual_end`,
stated over an abstract commutative ring.  Doing the construction generically keeps every
intermediate module of linear maps out of this concrete setting, where writing one of them down
would start a typeclass search through the coercions of the subalgebra and of its ideal.  The
one such type that does occur, `m ⊗_R k[x, y]`, is given a named `Module` instance,
`instModuleTensorGeneratorIdealPlane`; it is `TensorProduct.instModule` and exists only so that
the search terminates on a syntactic match.

The construction goes through the endomorphism module of `k[x, y]` rather than that of `m`,
commuting the tensor factors first, so that `endEquiv` can be reused.

## References

* [Stacks Project, Example 31.12.7 (Tag 0EBB)](https://stacks.math.columbia.edu/tag/0EBB)
-/

@[expose] public section

open scoped TensorProduct

universe u v w

/-- The double-dual computation for a tensor product, in generic form.  If `M* ≃ I`, if
`I* ≃ M`, and if the `R`-endomorphisms of `M` are identified with `M` itself, then the double
`R`-dual of `I ⊗_R M` is `I`.

The three hypotheses are exactly the data Example 0EBB provides for `I = m` and
`M = k[x, y]`. -/
theorem nonempty_dual_dual_tensor_equiv_of_dual_end
    {R : Type*} [CommRing R] {I : Type*} [AddCommGroup I] [Module R I]
    {M : Type*} [AddCommGroup M] [Module R M]
    (eDualM : Module.Dual R M ≃ₗ[R] I) (eDualI : Module.Dual R I ≃ₗ[R] M)
    (eEnd : (M →ₗ[R] M) ≃ₗ[R] M) :
    Nonempty (Module.Dual R (Module.Dual R (I ⊗[R] M)) ≃ₗ[R] I) := by
  classical
  let eComm : Module.Dual R (I ⊗[R] M) ≃ₗ[R] Module.Dual R (M ⊗[R] I) :=
    (TensorProduct.comm R M I).dualMap
  let eCurry : Module.Dual R (M ⊗[R] I) ≃ₗ[R] (M →ₗ[R] Module.Dual R I) :=
    (TensorProduct.lift.equiv (RingHom.id R) M I R).symm
  let eFirst : Module.Dual R (I ⊗[R] M) ≃ₗ[R] M :=
    ((eComm.trans eCurry).trans eDualI.congrRight).trans eEnd
  exact ⟨eFirst.dualMap.symm.trans eDualM⟩

namespace Stacks.PlaneSubalgebra

variable (k : Type u) [Field k]

/-- The polynomial ring `k[x, y]`, with `x = X 0` and `y = X 1`. -/
abbrev plane : Type u := MvPolynomial (Fin 2) k

/-- The four elements `y`, `x²`, `xy` and `x³` of `k[x, y]`. -/
def generators : Set (plane k) :=
  {MvPolynomial.X (1 : Fin 2), MvPolynomial.X (0 : Fin 2) ^ 2,
    MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2),
    MvPolynomial.X (0 : Fin 2) ^ 3}

/-- The subalgebra `R = k[y, x², xy, x³]` of `k[x, y]`. -/
noncomputable def adjoinGenerators : Subalgebra k (plane k) :=
  Algebra.adjoin k {1, MvPolynomial.X (1 : Fin 2), MvPolynomial.X (0 : Fin 2) ^ 2,
    MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2),
    MvPolynomial.X (0 : Fin 2) ^ 3}

/-- The ideal `m = (y, x², xy, x³)` of `R = k[y, x², xy, x³]`. -/
noncomputable def generatorIdeal : Ideal (adjoinGenerators k) :=
  Ideal.span ((fun z : adjoinGenerators k ↦ (z : plane k)) ⁻¹' generators k)

/-- The ideal `m` written as the span of the subset of `R` cut out by the four generators, which
is the shape in which `mvPolynomial_adjoin_reflexive_propertyS2_module_not_propertyS2` states
it. -/
theorem generatorIdeal_eq_span :
    generatorIdeal k = Ideal.span {r : adjoinGenerators k | (r : plane k) ∈
      ({MvPolynomial.X 1, MvPolynomial.X 0 ^ 2,
        MvPolynomial.X 0 * MvPolynomial.X 1, MvPolynomial.X 0 ^ 3} : Set (plane k))} :=
  rfl

/-- The computation of Example 0EBB, specialized to `adjoinGenerators` and `generatorIdeal`.

This is a reducible abbreviation rather than a theorem on purpose: the extracted data below are
then definitionally the *same* choices, which is what makes `dualPlaneEquiv` and
`dualGeneratorIdealEquiv` one fixed pair of isomorphisms together with their specifications. -/
abbrev spec :
    ∃ (_ : IsNoetherianRing (adjoinGenerators k)) (_ : IsDomain (adjoinGenerators k))
      (_ : Module.Finite (adjoinGenerators k) (plane k)),
      ∃ (dualPToM : Module.Dual (adjoinGenerators k) (plane k) ≃ₗ[adjoinGenerators k]
            generatorIdeal k)
        (dualMToP : Module.Dual (adjoinGenerators k) (generatorIdeal k) ≃ₗ[adjoinGenerators k]
            plane k),
        ¬ PropertySkRing (adjoinGenerators k) 2 ∧
          Module.IsReflexive (adjoinGenerators k) (adjoinGenerators k) ∧
          ¬ PropertySkModule (adjoinGenerators k) (adjoinGenerators k) 2 ∧
          (∀ (f : Module.Dual (adjoinGenerators k) (plane k)) (q : plane k),
            (↑(↑(dualPToM f) : adjoinGenerators k) : plane k) * q = (↑(f q) : plane k)) ∧
          (∀ (g : Module.Dual (adjoinGenerators k) (generatorIdeal k)) (a : generatorIdeal k),
            (↑(g a) : plane k) = dualMToP g * (↑(↑a : adjoinGenerators k) : plane k)) ∧
          Module.IsReflexive (adjoinGenerators k) (plane k) ∧
          PropertySkModule (adjoinGenerators k) (plane k) 2 :=
  mvPolynomial_adjoin_reflexive_propertyS2_module_not_propertyS2 k

/-- The subalgebra `R = k[y, x², xy, x³]` is a Noetherian ring. -/
instance isNoetherianRing_adjoinGenerators : IsNoetherianRing (adjoinGenerators k) :=
  (spec k).choose

/-- The subalgebra `R = k[y, x², xy, x³]` is a domain. -/
instance isDomain_adjoinGenerators : IsDomain (adjoinGenerators k) :=
  (spec k).choose_spec.choose

/-- The polynomial ring `k[x, y]` is a finite module over `R = k[y, x², xy, x³]`. -/
instance finite_plane : Module.Finite (adjoinGenerators k) (plane k) :=
  (spec k).choose_spec.choose_spec.choose

/-- The `R`-dual of `k[x, y]` is the ideal `m = (y, x², xy, x³)`.  This is one fixed choice of
isomorphism, specified by `dualPlaneEquiv_mul_apply`. -/
noncomputable def dualPlaneEquiv :
    Module.Dual (adjoinGenerators k) (plane k) ≃ₗ[adjoinGenerators k] generatorIdeal k :=
  (spec k).choose_spec.choose_spec.choose_spec.choose

/-- The `R`-dual of the ideal `m = (y, x², xy, x³)` is `k[x, y]`.  This is one fixed choice of
isomorphism, specified by `dualGeneratorIdealEquiv_apply_coe`. -/
noncomputable def dualGeneratorIdealEquiv :
    Module.Dual (adjoinGenerators k) (generatorIdeal k) ≃ₗ[adjoinGenerators k] plane k :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose

/-- `dualPlaneEquiv` sends an `R`-linear functional on `k[x, y]` to the element of `m` by which
it multiplies. -/
theorem dualPlaneEquiv_mul_apply (f : Module.Dual (adjoinGenerators k) (plane k))
    (q : plane k) :
    (↑(↑(dualPlaneEquiv k f) : adjoinGenerators k) : plane k) * q = (↑(f q) : plane k) :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.1 f q

/-- `dualGeneratorIdealEquiv` sends an `R`-linear functional on `m` to the polynomial by which
it multiplies. -/
theorem dualGeneratorIdealEquiv_apply_coe
    (g : Module.Dual (adjoinGenerators k) (generatorIdeal k)) (a : generatorIdeal k) :
    (↑(g a) : plane k)
      = dualGeneratorIdealEquiv k g * (↑(↑a : adjoinGenerators k) : plane k) :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.2.1 g a

/-- The subalgebra `R = k[y, x², xy, x³]` does not satisfy Serre's condition `(S₂)`. -/
theorem not_propertySkRing_adjoinGenerators : ¬ PropertySkRing (adjoinGenerators k) 2 :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.1

/-- The subalgebra `R = k[y, x², xy, x³]` is reflexive over itself. -/
instance isReflexive_adjoinGenerators :
    Module.IsReflexive (adjoinGenerators k) (adjoinGenerators k) :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.1

/-- As a module over itself, `R = k[y, x², xy, x³]` does not satisfy Serre's condition `(S₂)`. -/
theorem not_propertySkModule_self :
    ¬ PropertySkModule (adjoinGenerators k) (adjoinGenerators k) 2 :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2.1

/-- The polynomial ring `k[x, y]` is a reflexive module over `R = k[y, x², xy, x³]`. -/
instance isReflexive_plane : Module.IsReflexive (adjoinGenerators k) (plane k) :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.2.2.1

/-- The polynomial ring `k[x, y]` satisfies Serre's condition `(S₂)` as a module over
`R = k[y, x², xy, x³]`. -/
theorem propertySkModule_plane : PropertySkModule (adjoinGenerators k) (plane k) 2 :=
  (spec k).choose_spec.choose_spec.choose_spec.choose_spec.choose_spec.2.2.2.2.2.2

/-! ### Membership of the generators -/

/-- The generator `y` lies in `R = k[y, x², xy, x³]`. -/
theorem y_mem : (MvPolynomial.X 1 : plane k) ∈ adjoinGenerators k :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_insert _ _))

/-- The generator `x²` lies in `R = k[y, x², xy, x³]`. -/
theorem x_sq_mem : (MvPolynomial.X 0 : plane k) ^ 2 ∈ adjoinGenerators k :=
  Algebra.subset_adjoin
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))

/-- The generator `x³` lies in `R = k[y, x², xy, x³]`. -/
theorem x_cube_mem : (MvPolynomial.X 0 : plane k) ^ 3 ∈ adjoinGenerators k :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _
    (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))))

/-! ### The ideal `m` by vanishing of the constant coefficient -/

/-- The four generators of `m` have vanishing constant coefficient. -/
private theorem constantCoeff_eq_zero_of_mem_generators {t : plane k} (ht : t ∈ generators k) :
    MvPolynomial.constantCoeff t = 0 := by
  simp only [generators, Set.mem_insert_iff, Set.mem_singleton_iff] at ht
  rcases ht with rfl | rfl | rfl | rfl <;> simp

/-- Every element of `R` differs from (the image of) its constant coefficient by an element of
`m = (y, x², xy, x³)`. -/
private theorem sub_constantCoeff_mem (r : adjoinGenerators k) :
    r - algebraMap k (adjoinGenerators k) (MvPolynomial.constantCoeff (r : plane k))
      ∈ generatorIdeal k := by
  classical
  obtain ⟨q, hq⟩ := r
  apply Algebra.adjoin_induction (p := fun t ht =>
    (⟨t, ht⟩ : adjoinGenerators k) -
      algebraMap k (adjoinGenerators k) (MvPolynomial.constantCoeff t) ∈ generatorIdeal k)
    _ _ _ _ hq
  · intro t ht
    have ht' : t = 1 ∨ t ∈ generators k := by
      simpa only [generators, Set.mem_insert_iff, Set.mem_singleton_iff] using ht
    rcases ht' with rfl | ht'
    · change (1 : adjoinGenerators k) -
        algebraMap k (adjoinGenerators k)
          (MvPolynomial.constantCoeff (1 : plane k)) ∈ generatorIdeal k
      simp
    · rw [constantCoeff_eq_zero_of_mem_generators k ht', map_zero, sub_zero]
      exact Ideal.subset_span ht'
  · intro a
    change algebraMap k (adjoinGenerators k) a -
      algebraMap k (adjoinGenerators k)
        (MvPolynomial.constantCoeff (MvPolynomial.C a)) ∈ generatorIdeal k
    rw [MvPolynomial.constantCoeff_C, sub_self]
    exact (generatorIdeal k).zero_mem
  · intro a b ha hb hda hdb
    convert (generatorIdeal k).add_mem hda hdb using 1
    apply Subtype.ext
    simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_algebraMap, map_add]
    ring
  · intro a b ha hb hda hdb
    convert (generatorIdeal k).add_mem
      ((generatorIdeal k).mul_mem_right ⟨b, hb⟩ hda) ((generatorIdeal k).mul_mem_left
        (algebraMap k (adjoinGenerators k) (MvPolynomial.constantCoeff a)) hdb) using 1
    apply Subtype.ext
    simp only [Subalgebra.coe_add, Subalgebra.coe_sub, Subalgebra.coe_mul,
      Subalgebra.coe_algebraMap, map_mul]
    ring

/-- The ideal `m` is contained in the kernel of the constant coefficient on `R`. -/
private theorem generatorIdeal_le_ker : generatorIdeal k ≤
    RingHom.ker (MvPolynomial.constantCoeff.comp (adjoinGenerators k).subtype) := by
  refine Ideal.span_le.mpr fun r hr => ?_
  change MvPolynomial.constantCoeff (r : plane k) = 0
  exact constantCoeff_eq_zero_of_mem_generators k hr

/-- An element of `R = k[y, x², xy, x³]` lies in `m = (y, x², xy, x³)` exactly when its constant
coefficient vanishes. -/
theorem mem_generatorIdeal_iff_constantCoeff (r : adjoinGenerators k) :
    r ∈ generatorIdeal k ↔ MvPolynomial.constantCoeff (r : plane k) = 0 := by
  refine ⟨fun hr => generatorIdeal_le_ker k hr, fun hr => ?_⟩
  have hs := sub_constantCoeff_mem k r
  rwa [hr, map_zero, sub_zero] at hs

/-- The generator `y`, as an element of the ideal `m`. -/
theorem y_mem_generatorIdeal :
    (⟨MvPolynomial.X 1, y_mem k⟩ : adjoinGenerators k) ∈ generatorIdeal k :=
  (mem_generatorIdeal_iff_constantCoeff k _).2 (by simp)

/-- The generator `x²`, as an element of the ideal `m`. -/
theorem x_sq_mem_generatorIdeal :
    (⟨MvPolynomial.X 0 ^ 2, x_sq_mem k⟩ : adjoinGenerators k) ∈ generatorIdeal k :=
  (mem_generatorIdeal_iff_constantCoeff k _).2 (by simp)

/-! ### Endomorphisms of `k[x, y]` over `R` -/

/-- Membership in the `R`-span of `1` and `x` in `k[x, y]`, in terms of multiplication. -/
private theorem mem_span_one_x_iff (q : plane k) :
    q ∈ Submodule.span (adjoinGenerators k) ({1, MvPolynomial.X 0} : Set (plane k)) ↔
      ∃ a b : adjoinGenerators k, (a : plane k) + (b : plane k) * MvPolynomial.X 0 = q := by
  simp only [Submodule.mem_span_pair, Algebra.smul_def, Subalgebra.algebraMap_apply, mul_one]

/-- The `R`-submodule of `k[x, y]` generated by `1` and `x` is everything. -/
private theorem span_one_x_eq_top :
    Submodule.span (adjoinGenerators k) ({1, MvPolynomial.X 0} : Set (plane k)) = ⊤ := by
  classical
  let S : Submodule (adjoinGenerators k) (plane k) :=
    Submodule.span (adjoinGenerators k) {1, MvPolynomial.X 0}
  change S = ⊤
  have hmulx (q : plane k) (hq : q ∈ S) : q * MvPolynomial.X 0 ∈ S := by
    obtain ⟨a, b, hab⟩ := (mem_span_one_x_iff k q).mp hq
    refine (mem_span_one_x_iff k _).mpr ⟨b * ⟨MvPolynomial.X 0 ^ 2, x_sq_mem k⟩, a, ?_⟩
    rw [← hab]
    simp only [Subalgebra.coe_mul]
    ring
  have hmuly (q : plane k) (hq : q ∈ S) : q * MvPolynomial.X 1 ∈ S := by
    convert S.smul_mem ⟨MvPolynomial.X 1, y_mem k⟩ hq using 1
    change q * MvPolynomial.X 1 = MvPolynomial.X 1 * q
    ring
  suffices h : ∀ q : plane k, q ∈ S from top_unique fun q _ => h q
  intro q
  induction q using MvPolynomial.induction_on with
  | C a =>
      exact (mem_span_one_x_iff k _).mpr
        ⟨⟨MvPolynomial.C a, (adjoinGenerators k).algebraMap_mem a⟩, 0, by simp⟩
  | add q₁ q₂ h₁ h₂ => exact S.add_mem h₁ h₂
  | mul_X q i hq =>
      fin_cases i
      · exact hmulx q hq
      · exact hmuly q hq

/-- An `R`-endomorphism of `k[x, y]` commutes with multiplication by elements of `R`. -/
private theorem mul_end_apply (f : Module.End (adjoinGenerators k) (plane k))
    (p : plane k) (hp : p ∈ adjoinGenerators k) (a : plane k) : p * f a = f (p * a) :=
  (map_smul f (⟨p, hp⟩ : adjoinGenerators k) a).symm

/-- An `R`-endomorphism of `k[x, y]` is multiplication by its value at one. -/
private theorem end_apply_eq_mul (f : Module.End (adjoinGenerators k) (plane k))
    (a : plane k) : f a = f 1 * a := by
  classical
  have hxne : (MvPolynomial.X 0 : plane k) ^ 2 ≠ 0 :=
    pow_ne_zero _ (MvPolynomial.X_ne_zero (0 : Fin 2))
  have h2 := mul_end_apply k f _ (x_sq_mem k) (MvPolynomial.X 0)
  have h3 := mul_end_apply k f _ (x_cube_mem k) (1 : plane k)
  have hfx : f (MvPolynomial.X 0) = f 1 * MvPolynomial.X 0 := by
    apply mul_left_cancel₀ hxne
    rw [h2, show (MvPolynomial.X 0 : plane k) ^ 2 * MvPolynomial.X 0
      = MvPolynomial.X 0 ^ 3 * 1 from by ring, ← h3]
    ring
  obtain ⟨b, c, hbc⟩ := (mem_span_one_x_iff k a).mp (by rw [span_one_x_eq_top]; trivial)
  have hfq : f a = (b : plane k) * f 1 + (c : plane k) * f (MvPolynomial.X 0) := by
    calc
      f a = f (b • (1 : plane k) + c • MvPolynomial.X 0) := by
        rw [← hbc]; simp [Algebra.smul_def]
      _ = b • f 1 + c • f (MvPolynomial.X 0) := by rw [map_add, map_smul, map_smul]
      _ = (b : plane k) * f 1 + (c : plane k) * f (MvPolynomial.X 0) := rfl
  rw [hfq, hfx, ← hbc]
  ring

/-- Evaluation at one is a bijection from the `R`-endomorphisms of `k[x, y]` onto `k[x, y]`. -/
theorem bijective_applyₗ_one :
    Function.Bijective (LinearMap.applyₗ (R := adjoinGenerators k)
      (M := plane k) (M₂ := plane k) 1) := by
  classical
  constructor
  · intro f g h
    apply LinearMap.ext
    intro a
    have h1 : f 1 = g 1 := by simpa using h
    rw [end_apply_eq_mul k f a, end_apply_eq_mul k g a, h1]
  · intro p
    let f : Module.End (adjoinGenerators k) (plane k) :=
      { toFun := fun a => p * a
        map_add' := fun _ _ => mul_add p _ _
        map_smul' := by
          intro r a
          simp [Algebra.smul_def, mul_left_comm, mul_comm] }
    exact ⟨f, by simp [f]⟩

/-- An `R`-endomorphism of `k[x, y]` is canonically identified with its value at one. -/
noncomputable def endEquiv :
    Module.End (adjoinGenerators k) (plane k) ≃ₗ[adjoinGenerators k] plane k :=
  LinearEquiv.ofBijective (LinearMap.applyₗ (R := adjoinGenerators k)
    (M := plane k) (M₂ := plane k) 1) (bijective_applyₗ_one k)

/-- Every `R`-endomorphism of `k[x, y]` acts by multiplication by its value at one. -/
theorem endEquiv_mul_apply (f : Module.End (adjoinGenerators k) (plane k)) (a : plane k) :
    f a = endEquiv k f * a := by
  simpa [endEquiv] using end_apply_eq_mul k f a

/-! ### The double dual of `m ⊗_R k[x, y]` -/

/-- The `R`-module structure on `m ⊗_R k[x, y]`.  This is `TensorProduct.instModule`, exactly
the instance typeclass search produces, under a name.  Search has to find it by unifying the
coercions of the subalgebra and of its ideal, which costs more than the default budget allows,
so without this declaration the type `m ⊗_R k[x, y]` cannot even be written down. -/
noncomputable instance instModuleTensorGeneratorIdealPlane :
    Module (adjoinGenerators k)
      (TensorProduct (adjoinGenerators k) (generatorIdeal k) (plane k)) :=
  TensorProduct.instModule

/-- The double `R`-dual of `m ⊗_R k[x, y]` is isomorphic to `m`. -/
theorem nonempty_dual_dual_tensor_equiv :
    Nonempty (Module.Dual (adjoinGenerators k)
      (Module.Dual (adjoinGenerators k)
        (TensorProduct (adjoinGenerators k) (generatorIdeal k) (plane k)))
      ≃ₗ[adjoinGenerators k] generatorIdeal k) :=
  nonempty_dual_dual_tensor_equiv_of_dual_end (dualPlaneEquiv k)
    (dualGeneratorIdealEquiv k) (endEquiv k)

/-! ### The two non-isomorphisms -/

/-- The polynomial ring `k[x, y]` is not isomorphic, as an `R`-module, to the ideal
`m = (y, x², xy, x³)`. -/
theorem not_nonempty_linearEquiv_plane_generatorIdeal :
    ¬ Nonempty (plane k ≃ₗ[adjoinGenerators k] generatorIdeal k) := by
  rintro ⟨e⟩
  classical
  let f : Module.Dual (adjoinGenerators k) (plane k) :=
    (generatorIdeal k).subtype.comp e.toLinearMap
  let a : plane k := ↑(↑(dualPlaneEquiv k f) : adjoinGenerators k)
  have hmul (q : plane k) :
      a * q = (↑(↑(e q) : adjoinGenerators k) : plane k) := dualPlaneEquiv_mul_apply k f q
  have hca : MvPolynomial.constantCoeff a = 0 :=
    (mem_generatorIdeal_iff_constantCoeff k _).1 (dualPlaneEquiv k f).property
  obtain ⟨qy, hqy⟩ := e.surjective ⟨⟨MvPolynomial.X 1, y_mem k⟩, y_mem_generatorIdeal k⟩
  obtain ⟨qx, hqx⟩ := e.surjective ⟨⟨MvPolynomial.X 0 ^ 2, x_sq_mem k⟩, x_sq_mem_generatorIdeal k⟩
  have hdvdY : a ∣ (MvPolynomial.X 1 : plane k) := ⟨qy, by rw [hmul qy, hqy]⟩
  have hdvdX : a ∣ (MvPolynomial.X 0 : plane k) ^ 2 := ⟨qx, by rw [hmul qx, hqx]⟩
  obtain ⟨r, hr, ha | ha⟩ :=
    (MvPolynomial.dvd_X_iff_exists (p := a) (i := (1 : Fin 2))).mp hdvdY
  · rw [ha, MvPolynomial.constantCoeff_C] at hca
    exact hr.ne_zero hca
  · have hXa : (MvPolynomial.X 1 : plane k) ∣ a := by
      rw [ha, MvPolynomial.smul_eq_C_mul]
      exact dvd_mul_left _ _
    have hbad : (MvPolynomial.X 1 : plane k) ∣
        MvPolynomial.X 0 * MvPolynomial.X 0 := by
      simpa [pow_two] using hXa.trans hdvdX
    rw [MvPolynomial.X_dvd_mul_iff, MvPolynomial.X_dvd_X] at hbad
    simp at hbad

/-- The ideal `m = (y, x², xy, x³)` is not isomorphic, as an `R`-module, to `R` itself. -/
theorem not_nonempty_linearEquiv_generatorIdeal_self :
    ¬ Nonempty (generatorIdeal k ≃ₗ[adjoinGenerators k] adjoinGenerators k) := by
  rintro ⟨emR⟩
  let eRP : adjoinGenerators k ≃ₗ[adjoinGenerators k] plane k :=
    (LinearMap.ringLmapEquivSelf (adjoinGenerators k) (adjoinGenerators k)
      (adjoinGenerators k)).symm.trans (emR.dualMap.trans (dualGeneratorIdealEquiv k))
  exact not_propertySkModule_self k
    (propertySkModule_of_linearEquiv eRP 2 (propertySkModule_plane k))

end Stacks.PlaneSubalgebra

end
