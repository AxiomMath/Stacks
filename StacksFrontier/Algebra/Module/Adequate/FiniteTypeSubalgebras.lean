module

public import Mathlib.RingTheory.FiniteType
public import StacksFrontier.Algebra.Module.Adequate.Colimit

/-!
# An algebra is the filtered colimit of its finitely generated subalgebras

[Stacks, Tag 06UU] — `AdequateFunctor.isColimit_mapCocone_of_isAdequate` — says that an adequate
module-valued functor on the `A`-algebras turns a filtered colimit of algebras into a colimit of
abelian groups. To use it to reduce a statement about all `A`-algebras to a statement about the
*finite-type* ones, which is what the proof of [Stacks, Tag 06ZR] does when it passes from the
algebras of a chosen big site to all algebras, one needs the filtered colimit itself: every
`A`-algebra is the directed union of its finitely generated subalgebras.

That is what this module provides, as a colimit in `CommAlgCat.{u} A` and in the doubly opposite
category `((CommAlgCat.{u} A)ᵒᵖ)ᵒᵖ` on which the module-valued functors of the chapter are
defined.

## Main definitions

* `Stacks.Adequate.FgSubalgebras` — the finitely generated `A`-subalgebras of an `A`-algebra `R`,
  ordered by inclusion.
* `Stacks.Adequate.fgSubalgebraDiagram` — that poset as a diagram of `A`-algebras, the arrows
  being the inclusions.
* `Stacks.Adequate.fgSubalgebraCocone` — the cocone on it with apex `R`.

## Main results

* `Stacks.Adequate.fgSubalgebras_directed` and `Stacks.Adequate.fgSubalgebras_isDirectedOrder` —
  the index poset is directed, two finitely generated subalgebras being contained in their
  supremum, which is again finitely generated. With `Stacks.Adequate`
  `.fgSubalgebras_nonempty` this makes the index category filtered.
* `Stacks.Adequate.fgSubalgebras_iSup_eq_top` — the finitely generated subalgebras exhaust `R`:
  every element lies in the one it generates.
* `Stacks.Adequate.isColimit_fgSubalgebraCocone` — **`R` is the colimit of its finitely generated
  subalgebras** in `CommAlgCat.{u} A`.
* `Stacks.Adequate.isColimit_fgSubalgebraCoconeOpOp` — the same colimit in
  `((CommAlgCat.{u} A)ᵒᵖ)ᵒᵖ`, which is the category the module-valued functors of
  `StacksFrontier/Algebra/Module/Adequate/Defs.lean` are indexed by, so that it can be fed to
  [Stacks, Tag 06UU] directly.
* `Stacks.Adequate.finiteType_fgSubalgebraDiagram_obj` — every term of the diagram is of finite
  type over `A`, which is what makes the reduction a reduction.

## Implementation notes

The colimit map out of `R` is `Subalgebra.iSupLift` at the family of finitely generated
subalgebras, whose supremum is `⊤`; `AlgEquiv`-free, the identification of `⊤` with `R` being
`Algebra.toTop`. Uniqueness is checked at a single element `x` by evaluating the competing map on
the subalgebra `A[x]`, which is finitely generated by `Subalgebra.fg_adjoin_finset`.

## References

* [Stacks Project, Tag 06UU](https://stacks.math.columbia.edu/tag/06UU)
* [Stacks Project, Tag 06ZR](https://stacks.math.columbia.edu/tag/06ZR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Adequate

variable (A R : Type u) [CommRing A] [CommRing R] [Algebra A R]

/-- The finitely generated `A`-subalgebras of `R`, ordered by inclusion. -/
public abbrev FgSubalgebras := {T : Subalgebra A R // T.FG}

/-- The finitely generated `A`-subalgebras of `R` as a diagram of `A`-algebras, the arrows being
the inclusions. -/
public abbrev fgSubalgebraDiagram : FgSubalgebras A R ⥤ CommAlgCat.{u} A where
  obj T := CommAlgCat.of A T.val
  map f := CommAlgCat.ofHom (Subalgebra.inclusion (leOfHom f))

/-- The cocone on `Stacks.Adequate.fgSubalgebraDiagram` with apex `R`, its legs the inclusions of
the subalgebras. -/
public abbrev fgSubalgebraCocone : Cocone (fgSubalgebraDiagram A R) where
  pt := CommAlgCat.of A R
  ι.app T := CommAlgCat.ofHom T.val.val

/-- Every term of the diagram is of finite type over `A`: a finitely generated subalgebra is a
finite-type algebra. This is what makes a reduction along
`Stacks.Adequate.isColimit_fgSubalgebraCocone` a reduction to the finite-type algebras. -/
public theorem finiteType_fgSubalgebraDiagram_obj (T : FgSubalgebras A R) :
    Algebra.FiniteType A ((fgSubalgebraDiagram A R).obj T) :=
  T.val.fg_iff_finiteType.mp T.property

/-- The finitely generated subalgebras are directed: two of them are contained in their
supremum, which is again finitely generated. -/
public theorem fgSubalgebras_directed :
    Directed (· ≤ ·) (fun T : FgSubalgebras A R => T.val) := by
  intro T U
  exact ⟨⟨T.val ⊔ U.val, T.property.sup U.property⟩, le_sup_left, le_sup_right⟩

/-- The index poset is directed, hence the index category is filtered. -/
public instance fgSubalgebras_isDirectedOrder : IsDirectedOrder (FgSubalgebras A R) :=
  ⟨fgSubalgebras_directed A R⟩

/-- The index poset is nonempty: the bottom subalgebra is finitely generated. -/
public instance fgSubalgebras_nonempty : Nonempty (FgSubalgebras A R) :=
  ⟨⟨⊥, Subalgebra.fg_bot⟩⟩

/-- The finitely generated subalgebras exhaust `R`: an element lies in the subalgebra it
generates, which is finitely generated by `Subalgebra.fg_adjoin_finset`. -/
public theorem fgSubalgebras_iSup_eq_top :
    (⨆ T : FgSubalgebras A R, T.val) = ⊤ := by
  classical
  apply eq_top_iff.mpr
  intro x _
  exact (le_iSup (fun T : FgSubalgebras A R => T.val)
    ⟨Algebra.adjoin A ({x} : Finset R), Subalgebra.fg_adjoin_finset _⟩)
      (Algebra.subset_adjoin (by simp))

/-- **An `A`-algebra is the filtered colimit of its finitely generated subalgebras.** The map out
of `R` is `Subalgebra.iSupLift` at that directed family, whose supremum is `⊤`; uniqueness is
checked at a single element by evaluating on the subalgebra it generates. -/
public noncomputable def isColimit_fgSubalgebraCocone : IsColimit (fgSubalgebraCocone A R) := by
  classical
  let lift (s : Cocone (fgSubalgebraDiagram A R)) : R →ₐ[A] s.pt :=
    (Subalgebra.iSupLift (B := (s.pt : Type u)) (fun T : FgSubalgebras A R => T.val)
      (fgSubalgebras_directed A R) (fun T => show T.val →ₐ[A] s.pt from (s.ι.app T).hom)
      (fun T U h => by
        ext x
        exact (ConcreteCategory.congr_hom (s.w (homOfLE h)) x).symm)
      ⊤ (by rw [fgSubalgebras_iSup_eq_top])).comp Algebra.toTop
  have lift_val (s : Cocone (fgSubalgebraDiagram A R)) (T : FgSubalgebras A R)
      (x : T.val) : lift s x.val = (s.ι.app T).hom x :=
    Subalgebra.iSupLift_inclusion (fun T : FgSubalgebras A R => T.val)
      (dir := fgSubalgebras_directed A R)
      (hf := fun T U h => by
        ext x
        exact (ConcreteCategory.congr_hom (s.w (homOfLE h)) x).symm)
      (B := (s.pt : Type u)) (f := fun T => show T.val →ₐ[A] s.pt from (s.ι.app T).hom) x le_top
  refine ⟨fun s => CommAlgCat.ofHom (lift s), ?_, ?_⟩
  · intro s T
    ext x
    exact lift_val s T x
  · intro s m hm
    ext x
    let T : FgSubalgebras A R :=
      ⟨Algebra.adjoin A ({x} : Finset R), Subalgebra.fg_adjoin_finset _⟩
    let x' : T.val := ⟨x, Algebra.subset_adjoin (by simp)⟩
    exact (ConcreteCategory.congr_hom (hm T) x').trans (lift_val s T x').symm

/-- **The colimit of `Stacks.Adequate.isColimit_fgSubalgebraCocone` in
`((CommAlgCat.{u} A)ᵒᵖ)ᵒᵖ`**, which is the category the adequate module-valued functors of
`StacksFrontier/Algebra/Module/Adequate/Defs.lean` are indexed by. An equivalence preserves
colimits, so this is the previous statement transported along `CategoryTheory.opOpEquivalence`;
it is the shape `AdequateFunctor.isColimit_mapCocone_of_isAdequate` consumes. -/
public noncomputable def isColimit_fgSubalgebraCoconeOpOp :
    IsColimit ((opOpEquivalence (CommAlgCat.{u} A)).inverse.mapCocone
      (fgSubalgebraCocone A R)) :=
  isColimitOfPreserves _ (isColimit_fgSubalgebraCocone A R)

end Stacks.Adequate

end
