module

public import Mathlib.RingTheory.Finiteness.ModuleFinitePresentation
public import StacksFrontier.Algebra.Module.FinitePresentationRel.Basic
public import StacksFrontier.Algebra.Module.FinitePresentation.Transport

@[expose] public section

/-!
# Relative finite presentation is insensitive to a finite algebra map

Let `R` be a ring, let `φ : A → B` be a finite map of `R`-algebras with both `R → A` and
`R → B` of finite type, and let `M` be a `B`-module, hence an `A`-module by restriction of
scalars along `φ`. This file proves Stacks 05H0 (Lemma 15.82.3): `M` is finitely presented
relative to `R` as an `A`-module if and only if it is finitely presented relative to `R` as a
`B`-module.

The relative notion is `Module.FinitePresentationRel` from
`StacksFrontier.Algebra.Module.FinitePresentationRel.Basic`. Both sides are recast through
condition (3) of Stacks 05GY (`Module.FinitePresentationRel.AllFPCovers`, available here as
`Module.finitePresentationRel_iff_allFPCovers`), and the equivalence of the two
condition-(3) predicates follows from `fp_iff_of_finite_fp_algebra` (Stacks 0564) applied to a
single explicit algebra `C = W ⧸ I` that is finite and finitely presented over a polynomial
presentation `A' = R[x_1, …, x_n]` of `A` and surjects onto `B`.

The relative notion is genuinely needed: for `R = k[x_1, x_2, …]`, `A = R`,
`B = R/(x_i : i ≥ 1)` and `M = B`, ordinary finite presentation fails. Over Noetherian `R` the
relative notion coincides with ordinary finite presentation, so the content is only nontrivial
for non-Noetherian `R`.
-/

open MvPolynomial

universe u

/-- A quotient `W ⧸ I` of an `R`-algebra `W` generated over `A'` by elements `y j`, with `I`
generated by monic relations `P j (y j)`, is finite and finitely presented over `A'`. -/
theorem Algebra.finite_finitePresentation_quotient_of_monic
    (R : Type u) [CommRing R] (A' W : Type u) [CommRing A'] [CommRing W]
    [Algebra R A'] [Algebra R W]
    [Algebra.FinitePresentation R A'] [Algebra.FinitePresentation R W]
    (iAW : A' →ₐ[R] W) {m : ℕ} (y : Fin m → W)
    (hWgen : Algebra.adjoin R (Set.range (iAW : A' → W) ∪ Set.range y) = ⊤)
    (P : Fin m → Polynomial A') (hPmonic : ∀ j, (P j).Monic) (rel : Fin m → W)
    (hreldef : ∀ j, rel j = Polynomial.aeval (y j) ((P j).map iAW.toRingHom))
    (I : Ideal W) (hIdef : I = Ideal.span (Set.range rel)) :
    letI := ((Ideal.Quotient.mkₐ R I).comp iAW).toRingHom.toAlgebra
    Module.Finite A' (W ⧸ I) ∧ Algebra.FinitePresentation A' (W ⧸ I) := by
  have hIfg : I.FG := by rw [hIdef]; exact Submodule.fg_span (Set.finite_range rel)
  set C := W ⧸ I
  set πC : W →ₐ[R] C := Ideal.Quotient.mkₐ R I with hπCdef
  have hπCsurj : Function.Surjective πC := Ideal.Quotient.mkₐ_surjective R I
  set iAC : A' →ₐ[R] C := πC.comp iAW
  let algAC : Algebra A' C := iAC.toRingHom.toAlgebra
  have towerRAC : IsScalarTower R A' C :=
    IsScalarTower.of_algebraMap_eq fun r => (iAC.commutes r).symm
  set ybar : Fin m → C := fun j => πC (y j)
  have hint : ∀ j, IsIntegral A' (ybar j) := by
    intro j
    refine ⟨P j, hPmonic j, ?_⟩
    have hrel0 : πC (rel j) = 0 := by
      rw [hπCdef, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem, hIdef]
      exact Ideal.subset_span ⟨j, rfl⟩
    show Polynomial.eval₂ (πC.toRingHom.comp iAW.toRingHom) (πC.toRingHom (y j)) (P j) = 0
    rw [← Polynomial.hom_eval₂, ← hrel0, hreldef j, Polynomial.aeval_def, Polynomial.eval₂_map]
    rfl
  have hadjoinTop : Algebra.adjoin A' (Set.range ybar) = ⊤ := by
    rw [_root_.eq_top_iff]
    rintro c -
    obtain ⟨w, rfl⟩ := hπCsurj c
    have hw : w ∈ Algebra.adjoin R (Set.range (iAW : A' → W) ∪ Set.range y) :=
      hWgen ▸ Algebra.mem_top
    induction hw using Algebra.adjoin_induction with
    | mem x hx =>
        rcases hx with ⟨a, rfl⟩ | ⟨j, rfl⟩
        · exact Subalgebra.algebraMap_mem _ a
        · exact Algebra.subset_adjoin ⟨j, rfl⟩
    | algebraMap r =>
        rw [πC.commutes, IsScalarTower.algebraMap_apply R A' C]
        exact Subalgebra.algebraMap_mem _ _
    | add x z _ _ hx hz => simpa only [map_add] using Subalgebra.add_mem _ hx hz
    | mul x z _ _ hx hz => simpa only [map_mul] using Subalgebra.mul_mem _ hx hz
  have hCfinA' : Module.Finite A' C := by
    have hfg := fg_adjoin_of_finite (Set.finite_range ybar) fun _ ⟨j, hj⟩ => hj ▸ hint j
    rw [hadjoinTop, Algebra.top_toSubmodule] at hfg
    exact ⟨hfg⟩
  have : Algebra.FinitePresentation R C := .quotient hIfg
  exact ⟨hCfinA', Algebra.FinitePresentation.of_restrict_scalars_finitePresentation R A' C⟩

/-- Restricting scalars along `g : A' → B` agrees with restricting along `f : A' → A` when
`g = algebraMap A B ∘ f`. -/
theorem Module.compHom_eq_of_eq_algebraMap {A A' B M : Type*} [CommRing A] [CommRing A']
    [CommRing B] [Algebra A B] [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    {g : A' →+* B} (f : A' →+* A) (h : ∀ a, g a = algebraMap A B (f a)) :
    Module.compHom M g = Module.compHom M f := by
  refine Module.ext' _ _ fun a x => ?_
  show g a • x = f a • x
  rw [h]
  exact IsScalarTower.algebraMap_smul B (f a) x

/-- In the setting of `Module.finitePresentation_of_allFPCovers_ascend`, `δ` factors through
`W ⧸ I`, and `M` is finitely presented over `A'` (through `α`) iff it is over `W ⧸ I`
(through the factorization). -/
private theorem Module.finitePresentation_alpha_iff_exists_lift
    (R : Type u) (A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Algebra A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    (A' W : Type u) [CommRing A'] [CommRing W] [Algebra R A'] [Algebra R W]
    [Algebra.FinitePresentation R A'] [Algebra.FinitePresentation R W]
    (α : A' →ₐ[R] A) (iAW : A' →ₐ[R] W) {m : ℕ} (y : Fin m → W)
    (hWgen : Algebra.adjoin R (Set.range (iAW : A' → W) ∪ Set.range y) = ⊤)
    (δ : W →ₐ[R] B) (P : Fin m → Polynomial A') (hPmonic : ∀ j, (P j).Monic)
    (hδiAW : ∀ w, δ (iAW w) = algebraMap A B (α w))
    (rel : Fin m → W)
    (hreldef : ∀ j, rel j = Polynomial.aeval (y j) ((P j).map iAW.toRingHom))
    (I : Ideal W) (hIdef : I = Ideal.span (Set.range rel)) (hδrel : ∀ j, δ (rel j) = 0) :
    ∃ δbar : W ⧸ I →ₐ[R] B, (∀ w, δbar (Ideal.Quotient.mk I w) = δ w) ∧
      (@Module.FinitePresentation A' M _ _ (Module.compHom M α.toRingHom) ↔
        @Module.FinitePresentation (W ⧸ I) M _ _ (Module.compHom M δbar.toRingHom)) := by
  have hIker : I ≤ RingHom.ker δ.toRingHom := by
    rw [hIdef, Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker]
    exact hδrel j
  set C := W ⧸ I
  set δbar : C →ₐ[R] B := Ideal.Quotient.liftₐ I δ (fun a ha => hIker ha)
  set iAC : A' →ₐ[R] C := (Ideal.Quotient.mkₐ R I).comp iAW
  let algAC : Algebra A' C := iAC.toRingHom.toAlgebra
  obtain ⟨hCfinA', hCfpA'⟩ := Algebra.finite_finitePresentation_quotient_of_monic R A' W
    iAW y hWgen P hPmonic rel hreldef I hIdef
  let iMC : Module C M := Module.compHom M δbar.toRingHom
  let iMA' : Module A' M := Module.compHom M (δbar.toRingHom.comp iAC.toRingHom)
  have towerA'CM : IsScalarTower A' C M := by
    refine ⟨fun a' c mm => ?_⟩
    show δbar.toRingHom ((a' • c : C)) • mm
      = δbar.toRingHom (iAC a') • (δbar.toRingHom c • mm)
    rw [show (a' • c : C) = algebraMap A' C a' * c from Algebra.smul_def a' c, map_mul,
      mul_smul]
    rfl
  rw [← show iMA' = Module.compHom M α.toRingHom from
    Module.compHom_eq_of_eq_algebraMap α.toRingHom hδiAW]
  exact ⟨δbar, fun _ => rfl, fp_iff_of_finite_fp_algebra A' C M hCfinA' hCfpA'⟩

/-- **Heart of the `mp` direction of Stacks 05H0.**
Let `α : A' ↠ A` be a presentation of `A` by a finitely presented `R`-algebra, let `W` be a
finitely presented `R`-algebra with an `R`-algebra map `δ : W → B` and a compatible map
`iAW : A' → W`, and let `I` be generated by monic relations `rel j = (P j)(y j)` that `δ`
kills, with `W` generated over `A'` by the `y j`. If condition (3) of Stacks 05GY holds for
`A`, then `M` is finitely presented as a `W`-module, scalars acting through `δ`. -/
theorem Module.finitePresentation_of_allFPCovers_ascend
    (R : Type u) (A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Algebra A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    (hA3 : Module.FinitePresentationRel.AllFPCovers.{u} R A M)
    (A' W : Type u) [CommRing A'] [CommRing W] [Algebra R A'] [Algebra R W]
    [Algebra.FinitePresentation R A'] [Algebra.FinitePresentation R W]
    (α : A' →ₐ[R] A) (hαsurj : Function.Surjective α) (iAW : A' →ₐ[R] W)
    {m : ℕ} (y : Fin m → W)
    (hWgen : Algebra.adjoin R (Set.range (iAW : A' → W) ∪ Set.range y) = ⊤)
    (δ : W →ₐ[R] B)
    (P : Fin m → Polynomial A') (hPmonic : ∀ j, (P j).Monic)
    (hδiAW : ∀ w, δ (iAW w) = algebraMap A B (α w))
    (rel : Fin m → W)
    (hreldef : ∀ j, rel j = Polynomial.aeval (y j) ((P j).map iAW.toRingHom))
    (I : Ideal W) (hIdef : I = Ideal.span (Set.range rel)) (hδrel : ∀ j, δ (rel j) = 0) :
    @Module.FinitePresentation W M _ _ (Module.compHom M δ.toRingHom) := by
  have hIfg : I.FG := by rw [hIdef]; exact Submodule.fg_span (Set.finite_range rel)
  obtain ⟨δbar, hδbar, hiff⟩ := Module.finitePresentation_alpha_iff_exists_lift R A B M A' W α
    iAW y hWgen δ P hPmonic hδiAW rel hreldef I hIdef hδrel
  let iMC : Module (W ⧸ I) M := Module.compHom M δbar.toRingHom
  let iMW : Module W M := Module.compHom M δ.toRingHom
  have towerWCM : IsScalarTower W (W ⧸ I) M := by
    refine ⟨fun w c mm => ?_⟩
    show δbar.toRingHom ((w • c : W ⧸ I)) • mm = δ.toRingHom w • (δbar.toRingHom c • mm)
    rw [show (w • c : W ⧸ I) = Ideal.Quotient.mk I w * c from rfl, map_mul, mul_smul]
    exact congrArg (· • _) (hδbar w)
  exact (fp_iff_of_finite_fp_algebra W (W ⧸ I) M (inferInstanceAs (Module.Finite W (W ⧸ I)))
    (.quotient hIfg)).mpr (hiff.mp (hA3 A' inferInstance α hαsurj))


/-- **Heart of the `mpr` direction of Stacks 05H0.**
In the situation of `Module.finitePresentation_of_allFPCovers_ascend`, with `δ : W → B`
moreover surjective, condition (3) of Stacks 05GY for `B` implies that `M` is finitely
presented as an `A'`-module, scalars acting through `α`. -/
theorem Module.finitePresentation_of_allFPCovers_descend
    (R : Type u) (A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Algebra A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M]
    (hB3 : Module.FinitePresentationRel.AllFPCovers.{u} R B M)
    (A' W : Type u) [CommRing A'] [CommRing W] [Algebra R A'] [Algebra R W]
    [Algebra.FinitePresentation R A'] [Algebra.FinitePresentation R W]
    (α : A' →ₐ[R] A) (iAW : A' →ₐ[R] W) {m : ℕ} (y : Fin m → W)
    (hWgen : Algebra.adjoin R (Set.range (iAW : A' → W) ∪ Set.range y) = ⊤)
    (δ : W →ₐ[R] B) (hδsurj : Function.Surjective δ)
    (P : Fin m → Polynomial A') (hPmonic : ∀ j, (P j).Monic)
    (hδiAW : ∀ w, δ (iAW w) = algebraMap A B (α w))
    (rel : Fin m → W)
    (hreldef : ∀ j, rel j = Polynomial.aeval (y j) ((P j).map iAW.toRingHom))
    (I : Ideal W) (hIdef : I = Ideal.span (Set.range rel)) (hδrel : ∀ j, δ (rel j) = 0) :
    @Module.FinitePresentation A' M _ _ (Module.compHom M α.toRingHom) := by
  have hIfg : I.FG := by rw [hIdef]; exact Submodule.fg_span (Set.finite_range rel)
  obtain ⟨δbar, hδbar, hiff⟩ := Module.finitePresentation_alpha_iff_exists_lift R A B M A' W α
    iAW y hWgen δ P hPmonic hδiAW rel hreldef I hIdef hδrel
  have hδbarsurj : Function.Surjective δbar := fun b ↦
    let ⟨w, hw⟩ := hδsurj b
    ⟨Ideal.Quotient.mk I w, (hδbar w).trans hw⟩
  exact hiff.mpr (hB3 (W ⧸ I) (.quotient hIfg) δbar hδbarsurj)


/-- An `R`-algebra map `δ : W → B` whose range contains the image of `A` and a family of
`A`-module generators of `B` is surjective. -/
theorem AlgHom.surjective_of_span_eq_top {R A B W ι : Type*} [CommSemiring R] [CommSemiring A]
    [CommSemiring B] [CommSemiring W] [Algebra R B] [Algebra A B] [Algebra R W] {b : ι → B}
    (δ : W →ₐ[R] B) (hbspan : Submodule.span A (Set.range b) = ⊤)
    (hA : ∀ a : A, algebraMap A B a ∈ δ.range) (hb : ∀ j, b j ∈ δ.range) :
    Function.Surjective δ := by
  rw [← AlgHom.range_eq_top, eq_top_iff]
  rintro x -
  have hx : x ∈ Submodule.span A (Set.range b) := hbspan ▸ Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨j, rfl⟩ := hy
    exact hb j
  | zero => exact Subalgebra.zero_mem _
  | add y z _ _ hy hz => exact Subalgebra.add_mem _ hy hz
  | smul a y _ hy =>
    rw [Algebra.smul_def]
    exact Subalgebra.mul_mem _ (hA a) hy

/-- If `δ ∘ iAW = algebraMap A B ∘ α`, then `δ` kills
`P(y)` whenever the image of `P` in `A[X]` kills `δ y`. -/
theorem AlgHom.map_aeval_map_eq_zero {R A A' B W : Type*} [CommRing R] [CommRing A]
    [CommRing A'] [CommRing B] [CommRing W] [Algebra R A] [Algebra R A'] [Algebra R B]
    [Algebra R W] [Algebra A B] (δ : W →ₐ[R] B) (α : A' →ₐ[R] A) (iAW : A' →ₐ[R] W)
    (hδiAW : ∀ w, δ (iAW w) = algebraMap A B (α w)) (y : W) (P : Polynomial A')
    (hP : Polynomial.aeval (δ y) (P.map α.toRingHom) = 0) :
    δ (Polynomial.aeval y (P.map iAW.toRingHom)) = 0 := by
  have hcomp : δ.toRingHom.comp iAW.toRingHom = (algebraMap A B).comp α.toRingHom :=
    RingHom.ext hδiAW
  have h1 : Polynomial.aeval y (P.map iAW.toRingHom) = Polynomial.eval₂ iAW.toRingHom y P := by
    simp only [Polynomial.aeval_def, Polynomial.eval₂_map]
    congr 1
  have h2 : δ (Polynomial.eval₂ iAW.toRingHom y P) =
      Polynomial.eval₂ (δ.toRingHom.comp iAW.toRingHom) (δ y) P :=
    Polynomial.hom_eval₂ P iAW.toRingHom δ.toRingHom y
  rw [h1, h2, hcomp, ← Polynomial.eval₂_map]
  exact hP

/-- An element integral over `A` is killed by the image of a monic polynomial over any ring
surjecting onto `A`. -/
theorem IsIntegral.exists_monic_aeval_map_eq_zero {A A' B : Type*} [CommRing A] [CommRing A']
    [CommRing B] [Algebra A B] {x : B} (hx : IsIntegral A x) (f : A' →+* A)
    (hf : Function.Surjective f) :
    ∃ P : Polynomial A', P.Monic ∧ Polynomial.aeval x (P.map f) = 0 := by
  obtain ⟨q, hqmonic, hqeval⟩ := hx
  obtain ⟨P, hPmap, -, hPmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
    (Polynomial.mem_lifts_of_surjective hf _) hqmonic
  exact ⟨P, hPmonic, hPmap ▸ hqeval⟩

/-- `R[x, y]` is generated as an `R`-algebra by `R[x]` and the `y`-variables. -/
theorem MvPolynomial.adjoin_range_rename_inl_union_range_X_inr (R σ τ : Type*) [CommSemiring R] :
    Algebra.adjoin R (Set.range (rename (R := R) (Sum.inl : σ → σ ⊕ τ)) ∪
      Set.range (fun j => X (Sum.inr j) : τ → MvPolynomial (σ ⊕ τ) R)) = ⊤ := by
  rw [eq_top_iff, ← MvPolynomial.adjoin_range_X, Algebra.adjoin_le_iff]
  rintro _ ⟨i | j, rfl⟩
  · exact Algebra.subset_adjoin (Or.inl ⟨X i, rename_X _ _⟩)
  · exact Algebra.subset_adjoin (Or.inr ⟨j, rfl⟩)

/-- A presentation of `B` by polynomials in the variables `Fin n ⊕ Fin m` reindexes to one in
the variables `Fin (n + m)`, keeping `M` finitely presented under restriction of scalars. -/
theorem Module.exists_fin_presentation_of_sum {R B M : Type*} [CommRing R] [CommRing B]
    [Algebra R B] [AddCommGroup M] [Module B M] {n m : ℕ}
    (δ : MvPolynomial (Fin n ⊕ Fin m) R →ₐ[R] B) (hδ : Function.Surjective δ)
    (hM : @Module.FinitePresentation _ M _ _ (Module.compHom M δ.toRingHom)) :
    ∃ f : MvPolynomial (Fin (n + m)) R →ₐ[R] B, Function.Surjective f ∧
      @Module.FinitePresentation _ M _ _ (Module.compHom M f.toRingHom) :=
  ⟨δ.comp (renameEquiv R finSumFinEquiv.symm).toAlgHom,
    hδ.comp (renameEquiv R finSumFinEquiv.symm).surjective,
    Module.finitePresentation_compHom_comp δ.toRingHom
      ((renameEquiv R finSumFinEquiv.symm : MvPolynomial (Fin (n + m)) R ≃ₐ[R] _) :
        MvPolynomial (Fin (n + m)) R →+* _)
      (renameEquiv R finSumFinEquiv.symm).surjective
      (by rw [AlgHom.ker_coe_equiv]; exact Submodule.fg_bot) hM⟩

/-! ## Main statement -/

/-- **Stacks Tag 05H0 (Lemma 15.82.3).** Let `R` be a ring, `φ : A → B` a finite
map of `R`-algebras with both `R → A` and `R → B` of finite type, and `M` a
`B`-module (hence an `A`-module via `φ`). Then `M` is finitely presented
relative to `R` as an `A`-module iff it is finitely presented relative to `R`
as a `B`-module.

The hypothesis `[IsScalarTower R A B]` encodes that `A → B` is a map of
`R`-algebras; `[IsScalarTower A B M]` encodes that the `A`-module structure on
`M` is the one obtained by restriction of scalars along `φ : A → B`. -/
@[stacks 05H0]
theorem Module.finitePresentationRel_iff_of_finite
    (R A B : Type*) [CommRing R] [CommRing A] [CommRing B]
    [Algebra R A] [Algebra R B] [Algebra A B] [IsScalarTower R A B]
    [Algebra.FiniteType R A] [Algebra.FiniteType R B] [Module.Finite A B]
    (M : Type*) [AddCommGroup M] [Module A M] [Module B M] [IsScalarTower A B M] :
    Module.FinitePresentationRel R A M ↔ Module.FinitePresentationRel R B M := by
  rw [Module.finitePresentationRel_iff_allFPCovers (R := R) (A := A) (M := M),
    Module.finitePresentationRel_iff_allFPCovers (R := R) (A := B) (M := M)]
  obtain ⟨n, α, hαsurj⟩ :=
    (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R) (S := A)).mp inferInstance
  set A' : Type _ := MvPolynomial (Fin n) R
  obtain ⟨m, b, hbspan⟩ := Module.Finite.exists_fin (R := A) (M := B)
  have : Algebra.IsIntegral A B := Algebra.IsIntegral.of_finite A B
  choose P hPmonic hPeval using fun j =>
    (Algebra.IsIntegral.isIntegral (R := A) (b j)).exists_monic_aeval_map_eq_zero
      α.toRingHom hαsurj
  set W : Type _ := MvPolynomial (Fin n ⊕ Fin m) R
  set iAW : A' →ₐ[R] W := MvPolynomial.rename Sum.inl with hiAWdef
  set δ : W →ₐ[R] B :=
    MvPolynomial.aeval (Sum.elim (fun i => algebraMap A B (α (MvPolynomial.X i))) b) with hδdef
  have hcompat : δ.comp iAW = (IsScalarTower.toAlgHom R A B).comp α := by
    refine MvPolynomial.algHom_ext fun i => ?_
    simp only [AlgHom.comp_apply, hiAWdef, hδdef]
    rw [MvPolynomial.rename_X, MvPolynomial.aeval_X, Sum.elim_inl, IsScalarTower.toAlgHom_apply]
  have hδiAW : ∀ w : A', δ (iAW w) = algebraMap A B (α w) := fun w => by
    simpa [IsScalarTower.toAlgHom_apply] using congrArg (fun f => f w) hcompat
  have hδXr : ∀ j, δ (MvPolynomial.X (Sum.inr j) : W) = b j := fun j => by
    rw [hδdef, MvPolynomial.aeval_X, Sum.elim_inr]
  have hδsurj : Function.Surjective δ := δ.surjective_of_span_eq_top hbspan
    (fun a => by
      obtain ⟨w, rfl⟩ := hαsurj a
      exact ⟨iAW w, hδiAW w⟩)
    fun j => ⟨MvPolynomial.X (Sum.inr j), hδXr j⟩
  set rel : Fin m → W := fun j =>
    Polynomial.aeval (MvPolynomial.X (Sum.inr j)) ((P j).map iAW.toRingHom)
  set I : Ideal W := Ideal.span (Set.range rel) with hIdef
  have hδrel : ∀ j, δ (rel j) = 0 := fun j =>
