@[expose] public section

/-
# Problem Description

Stacks Tag 0ASB (Lemma 15.25.2).

Let `A` be a (commutative, unital) ring, let `M` be a flat `A`-module, and let `x ∈ M`.

Consider the set
  `S_x = { I ⊆ A : I is an ideal of A and x ∈ I M }`,
where `I M` denotes the `A`-submodule of `M` generated by all products `f m` with
`f ∈ I` and `m ∈ M`.

An ideal `I₀ ∈ S_x` is a *content ideal of `x`* if it is the smallest element of `S_x`
with respect to inclusion; that is `x ∈ I₀ M`, and for every ideal `I` of `A` with
`x ∈ I M`, one has `I₀ ⊆ I`.

Statement: if a content ideal `I₀` of `x` exists, then `I₀` is a finitely generated
ideal of `A`.
-/

variable {A : Type*} [CommSemiring A] {M : Type*} [AddCommMonoid M] [Module A M]

/-- If `x` lies in `I • N`, then `x` already lies in `J • N` for some finitely generated
ideal `J ≤ I`. -/
theorem Submodule.exists_fg_le_of_mem_smul {I : Ideal A} {N : Submodule A M} {x : M}
    (hx : x ∈ I • N) : ∃ J : Ideal A, J.FG ∧ J ≤ I ∧ x ∈ J • N := by
  refine Submodule.smul_induction_on hx ?_ ?_
  · intro r hr n hn
    refine ⟨Ideal.span {r}, Submodule.fg_span_singleton r, ?_, ?_⟩
    · rw [Ideal.span_le]
      simpa using hr
    · exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self r) hn
  · rintro y z ⟨J₁, hJ₁fg, hJ₁le, hJ₁mem⟩ ⟨J₂, hJ₂fg, hJ₂le, hJ₂mem⟩
    exact ⟨J₁ ⊔ J₂, Submodule.FG.sup hJ₁fg hJ₂fg, sup_le hJ₁le hJ₂le,
      Submodule.add_mem _ (Submodule.smul_mono_left le_sup_left hJ₁mem)
        (Submodule.smul_mono_left le_sup_right hJ₂mem)⟩

/-- `I₀` is a *content ideal* of `x`: it is the least element of `S_x` under inclusion,
i.e. `x ∈ I₀ M` and any ideal `I` with `x ∈ I M` contains `I₀`. Here the submodule `I M`
of `M` is spelled `I • (⊤ : Submodule A M)`.

Flatness of `M` is not needed to state this, so the predicate is given for an arbitrary
module; for a flat module it is exactly the source's definition. -/
@[stacks 0ASA, sga "3 XXII 5.1.1" "more general"]
def IsContentIdeal (x : M) (I₀ : Ideal A) : Prop :=
  IsLeast {I : Ideal A | x ∈ I • (⊤ : Submodule A M)} I₀

/-- To show `I₀` is a content ideal of `x` it suffices to check that `x ∈ I₀ M` and that
`I₀` is contained in every ideal `I` with `x ∈ I M`. -/
theorem isContentIdeal_of_forall_le {x : M} {I₀ : Ideal A}
    (hmem : x ∈ I₀ • (⊤ : Submodule A M))
    (hle : ∀ I : Ideal A, x ∈ I • (⊤ : Submodule A M) → I₀ ≤ I) : IsContentIdeal x I₀ :=
  ⟨hmem, fun _ hI => hle _ hI⟩

/-- A content ideal `I₀` of `x` satisfies `x ∈ I₀ M`. -/
theorem IsContentIdeal.mem_smul_top {x : M} {I₀ : Ideal A} (h : IsContentIdeal x I₀) :
    x ∈ I₀ • (⊤ : Submodule A M) := h.left

/-- A content ideal of `x` is contained in every ideal `I` with `x ∈ I M`. -/
theorem IsContentIdeal.le_of_mem_smul_top {x : M} {I₀ I : Ideal A} (h : IsContentIdeal x I₀)
    (hI : x ∈ I • (⊤ : Submodule A M)) : I₀ ≤ I := h.right hI

/-- A content ideal of `x` is unique. -/
theorem IsContentIdeal.unique {x : M} {I₀ I₁ : Ideal A} (h₀ : IsContentIdeal x I₀)
    (h₁ : IsContentIdeal x I₁) : I₀ = I₁ := IsLeast.unique h₀ h₁

/-- If `I₀` is a content ideal of `x`, then `I₀` is finitely generated. Flatness of `M` is not
needed. -/
theorem IsContentIdeal.fg {x : M} {I₀ : Ideal A} (h : IsContentIdeal x I₀) : I₀.FG := by
  obtain ⟨J, hJfg, hJle, hJmem⟩ := Submodule.exists_fg_le_of_mem_smul h.mem_smul_top
  rw [le_antisymm (h.le_of_mem_smul_top hJmem) hJle]
  exact hJfg

/-- **Stacks Tag 0ASB.** If a content ideal `I₀` of `x` exists, then `I₀` is finitely
generated.

The source states this for a flat module `M`, but flatness is never used: the content ideal is
by definition the least ideal `I` with `x ∈ I M`, and `x ∈ I₀ M` already exhibits `x` inside
`J M` for some finitely generated `J ≤ I₀`, whence `J = I₀` by minimality. The hypothesis is
therefore dropped, which only strengthens the statement. -/
@[stacks 0ASB]
theorem contentIdeal_fg {A : Type*} [CommRing A] {M : Type*} [AddCommGroup M] [Module A M]
    (x : M) (I₀ : Ideal A) (h : IsContentIdeal x I₀) :
    I₀.FG :=
  h.fg


/-! ### Content ideals and injectivity modulo the maximal ideal

Over a local ring, a linear map between flat modules preserves the content ideal of an element
provided the induced map modulo the maximal ideal is injective. The quotient customarily denoted
`M / 𝔪 M` is represented by `M ⧸ 𝔪 • (⊤ : Submodule A M)`, and its induced map is the canonical
`Submodule.mapQ`. -/

section MapsOfFlatModules

open IsLocalRing TensorProduct

private lemma exists_residueField_linearMap_of_lt
    {A : Type*} [CommRing A] [IsLocalRing A] (K I : Ideal A) (hKI : K < I)
    (hIfg : I.FG) :
    ∃ χ : I →ₗ[A] (A ⧸ maximalIdeal A), χ ≠ 0 ∧
      ∀ z : I, (z : A) ∈ K → χ z = 0 := by
  let : (maximalIdeal A).IsMaximal := maximalIdeal.isMaximal A
  let : Field (A ⧸ maximalIdeal A) := Ideal.Quotient.field (maximalIdeal A)
  let L : Submodule A I := Submodule.comap (Submodule.subtype (I : Submodule A A)) K
  have hLtop : L ≠ ⊤ := by
    intro h
    have hle : I ≤ K := by
      intro a ha
      have hz : (⟨a, ha⟩ : I) ∈ L := by rw [h]; exact Submodule.mem_top
      change (a : A) ∈ K at hz
      exact hz
    exact hKI.2 hle
  let Q := I ⧸ L
  let : Module.Finite A I := Module.Finite.of_fg hIfg
  let : Module.Finite A Q := Module.Finite.quotient A L
  have hQ : Nontrivial Q := Submodule.Quotient.nontrivial_iff.mpr hLtop
  let mQ : Submodule A Q := maximalIdeal A • ⊤
  have hmQ : mQ ≠ ⊤ := by
    let : Nontrivial Q := hQ
    exact (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator
      (IsLocalRing.maximalIdeal_le_jacobson (Module.annihilator A Q))).symm
  let Qbar := Q ⧸ mQ
  have hQbar : Nontrivial Qbar := Submodule.Quotient.nontrivial_iff.mpr hmQ
  let : Module ((A ⧸ maximalIdeal A)) Qbar :=
    Module.instQuotientIdealSubmoduleHSMulTop Q (maximalIdeal A)
  let : Nontrivial Qbar := hQbar
  let : NoZeroSMulDivisors (A ⧸ maximalIdeal A) Qbar := by infer_instance
  let : Module.Free (A ⧸ maximalIdeal A) Qbar :=
    Module.Free.of_divisionRing (A ⧸ maximalIdeal A) Qbar
  have hdual : Nontrivial (Module.Dual (A ⧸ maximalIdeal A) Qbar) := by simpa using hQbar
  obtain ⟨g, hg⟩ := exists_ne (α := Module.Dual (A ⧸ maximalIdeal A) Qbar) 0
  let gA : Qbar →ₗ[A] (A ⧸ maximalIdeal A) :=
    { __ := g
      map_smul' := fun r x => by
        show g ((algebraMap A ((A ⧸ maximalIdeal A)) r) • x) =
          (algebraMap A ((A ⧸ maximalIdeal A)) r) • g x
        exact g.map_smul _ _ }
  let χ : I →ₗ[A] (A ⧸ maximalIdeal A) := gA.comp (mQ.mkQ.comp L.mkQ)
  refine ⟨χ, ?_, ?_⟩
  · intro hχ
    apply hg
    apply LinearMap.ext
    intro q
    obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective mQ q
    obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective L y
    show χ z = 0
    rw [hχ]
    rfl
  · intro z hz
    change (z : A) ∈ K at hz
    show gA (mQ.mkQ (L.mkQ z)) = 0
    have hzL : z ∈ L := hz
    rw [show L.mkQ z = 0 from (Submodule.Quotient.mk_eq_zero L).2 hzL]
    simp

/-- An element of `I • ⊤` is the image of a tensor in `I ⊗ M` under `I ⊗ M → A ⊗ M ≃ M`. -/
private lemma exists_lid_rTensor_subtype_eq {A M : Type*} [CommRing A] [AddCommGroup M]
    [Module A M] {I : Ideal A} {x : M} (hx : x ∈ I • (⊤ : Submodule A M)) :
    ∃ z : I ⊗[A] M,
      ((TensorProduct.lid A M).toLinearMap ∘ₗ LinearMap.rTensor M I.subtype) z = x := by
  rw [← LinearMap.mem_range, Ideal.subtype_rTensor_range]
  exact hx

private lemma rTensor_ne_zero_of_isContentIdeal
    {A M : Type*} [CommRing A] [IsLocalRing A] [AddCommGroup M] [Module A M] [Module.Flat A M]
    {x : M} {I : Ideal A} (hx : IsContentIdeal x I)
    (χ : I →ₗ[A] (A ⧸ maximalIdeal A)) (hχ : χ ≠ 0)
    (z : I ⊗[A] M)
    (hz : ((TensorProduct.lid A M).toLinearMap ∘ₗ
      LinearMap.rTensor M I.subtype) z = x) :
    LinearMap.rTensor M χ z ≠ 0 := by
  intro hzero
  let J : Ideal A := χ.ker.map (Submodule.subtype (I : Submodule A A))
  have hex : Function.Exact χ.ker.subtype χ := by
    rw [LinearMap.exact_iff, Submodule.range_subtype]
  obtain ⟨w, hw⟩ := (Module.Flat.rTensor_exact M hex z).mp hzero
  let kJ : χ.ker →ₗ[A] J :=
    { toFun := fun q => ⟨q.1.1, ⟨q.1, q.2, rfl⟩⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hnat (w' : χ.ker ⊗[A] M) :
      ((TensorProduct.lid A M).toLinearMap ∘ₗ LinearMap.rTensor M J.subtype)
          (LinearMap.rTensor M kJ w') =
        ((TensorProduct.lid A M).toLinearMap ∘ₗ LinearMap.rTensor M I.subtype)
          (LinearMap.rTensor M χ.ker.subtype w') := by
    simp only [LinearMap.comp_apply, ← LinearMap.rTensor_comp_apply]
    rfl
  have hxJ : x ∈ J • (⊤ : Submodule A M) := by
    rw [← Ideal.subtype_rTensor_range M J]
    refine ⟨LinearMap.rTensor M kJ w, ?_⟩
    rw [hnat, hw, hz]
  have hIJ : I ≤ J := hx.le_of_mem_smul_top hxJ
  apply hχ
  rw [← LinearMap.ker_eq_top]
  apply top_unique
  intro a _
  have haJ := hIJ a.property
  obtain ⟨q, hq, hqa⟩ := haJ
  have hqa' : q = a := Subtype.ext hqa
  simpa [hqa'] using hq

private lemma lTensor_residueField_injective
    {A M N : Type*} [CommRing A] [IsLocalRing A]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (u : M →ₗ[A] N)
    (hu : Function.Injective
      (Submodule.mapQ (maximalIdeal A • (⊤ : Submodule A M))
        (maximalIdeal A • (⊤ : Submodule A N)) u
        (Submodule.smul_top_le_comap_smul_top (maximalIdeal A) u))) :
    Function.Injective (LinearMap.lTensor ((A ⧸ maximalIdeal A)) u) := by
  let : Module ((A ⧸ maximalIdeal A)) (M ⧸ maximalIdeal A • (⊤ : Submodule A M)) :=
    inferInstanceAs (Module (A ⧸ maximalIdeal A) _)
  let : IsScalarTower A ((A ⧸ maximalIdeal A))
      (M ⧸ maximalIdeal A • (⊤ : Submodule A M)) :=
    inferInstanceAs (IsScalarTower A (A ⧸ maximalIdeal A) _)
  let : Module ((A ⧸ maximalIdeal A)) (N ⧸ maximalIdeal A • (⊤ : Submodule A N)) :=
    inferInstanceAs (Module (A ⧸ maximalIdeal A) _)
  let : IsScalarTower A ((A ⧸ maximalIdeal A))
      (N ⧸ maximalIdeal A • (⊤ : Submodule A N)) :=
    inferInstanceAs (IsScalarTower A (A ⧸ maximalIdeal A) _)
  let : IsScalarTower A ((A ⧸ maximalIdeal A)) ((A ⧸ maximalIdeal A) ⊗[A] M) :=
    ⟨fun a b x => by
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul c m => simp [TensorProduct.smul_tmul', Algebra.smul_def, mul_assoc]
      | add x y hx hy => simp only [smul_add, hx, hy]⟩
  let : IsScalarTower A ((A ⧸ maximalIdeal A)) ((A ⧸ maximalIdeal A) ⊗[A] N) :=
    ⟨fun a b x => by
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul c n => simp [TensorProduct.smul_tmul', Algebra.smul_def, mul_assoc]
      | add x y hx hy => simp only [smul_add, hx, hy]⟩
  let eM : (A ⧸ maximalIdeal A) ⊗[A] M ≃ₗ[(A ⧸ maximalIdeal A)]
      M ⧸ maximalIdeal A • (⊤ : Submodule A M) :=
    (TensorProduct.quotTensorEquivQuotSMul M (maximalIdeal A)).extendScalarsOfSurjective
      residue_surjective
  let eN : (A ⧸ maximalIdeal A) ⊗[A] N ≃ₗ[(A ⧸ maximalIdeal A)]
      N ⧸ maximalIdeal A • (⊤ : Submodule A N) :=
    (TensorProduct.quotTensorEquivQuotSMul N (maximalIdeal A)).extendScalarsOfSurjective
      residue_surjective
  let qmap :=
    Submodule.mapQ (maximalIdeal A • (⊤ : Submodule A M))
      (maximalIdeal A • (⊤ : Submodule A N)) u
      (Submodule.smul_top_le_comap_smul_top (maximalIdeal A) u)
  have hcomm (a : (A ⧸ maximalIdeal A) ⊗[A] M) :
      qmap (eM a) = eN (LinearMap.lTensor ((A ⧸ maximalIdeal A)) u a) := by
    induction a using TensorProduct.induction_on with
    | zero => simp [eM, eN, qmap]
    | tmul r m =>
        obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective r
        simp only [eM, eN, LinearMap.lTensor_tmul]
        show qmap (Submodule.Quotient.mk (s • m)) =
          Submodule.Quotient.mk (s • u m)
        simp [qmap]
    | add a b ha hb => simpa only [map_add] using congrArg₂ (· + ·) ha hb
  intro a b hab
  apply eM.injective
  apply hu
  rw [hcomm, hcomm, hab]

/-- **Stacks Tag 0ASC.** A map between flat modules over a local ring which is injective modulo
the maximal ideal preserves content ideals of elements. -/
@[stacks 0ASC]
theorem isContentIdeal_map_of_injective_mapQ_maximalIdeal
    {A : Type*} [CommRing A] [IsLocalRing A]
    {M N : Type*} [AddCommGroup M] [Module A M] [Module.Flat A M]
    [AddCommGroup N] [Module A N] [Module.Flat A N]
    (u : M →ₗ[A] N)
    (hu : Function.Injective
      (Submodule.mapQ (maximalIdeal A • (⊤ : Submodule A M))
        (maximalIdeal A • (⊤ : Submodule A N)) u
        (Submodule.smul_top_le_comap_smul_top (maximalIdeal A) u)))
    {x : M} {I : Ideal A} (hx : IsContentIdeal x I) :
    IsContentIdeal (u x) I := by
  refine ⟨(Submodule.smul_top_le_comap_smul_top I u) hx.mem_smul_top, fun J hxJ => ?_⟩
  by_contra hIJ
  let K : Ideal A := I ⊓ J
  have hKI : K < I := by
    refine lt_of_le_of_ne inf_le_left ?_
    intro h
    apply hIJ
    rw [← h]
    exact inf_le_right
  obtain ⟨χ, hχ, hχK⟩ :=
    exists_residueField_linearMap_of_lt K I hKI (hx.fg)
  obtain ⟨zI, hzI⟩ := exists_lid_rTensor_subtype_eq hx.mem_smul_top
  have htM : LinearMap.rTensor M χ zI ≠ 0 :=
    rTensor_ne_zero_of_isContentIdeal hx χ hχ zI hzI
  have huxI : u x ∈ I • (⊤ : Submodule A N) :=
    (Submodule.smul_top_le_comap_smul_top I u) hx.mem_smul_top
  have huxK : u x ∈ K • (⊤ : Submodule A N) := by
    rw [← ideal_smul_top_inf A I J N]
    exact ⟨huxI, hxJ⟩
  obtain ⟨zK, hzK⟩ := exists_lid_rTensor_subtype_eq huxK
  let kI : K →ₗ[A] I :=
    { toFun := fun a => ⟨a.1, a.2.1⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hphiI : Function.Injective
      ((TensorProduct.lid A N).toLinearMap ∘ₗ LinearMap.rTensor N I.subtype) :=
    (TensorProduct.lid A N).injective.comp
      ((Module.Flat.iff_rTensor_injective'.mp inferInstance) I)
  have hzEq : LinearMap.lTensor I u zI = LinearMap.rTensor N kI zK := by
    apply hphiI
    have hleft (z : I ⊗[A] M) :
        ((TensorProduct.lid A N).toLinearMap ∘ₗ LinearMap.rTensor N I.subtype)
            (LinearMap.lTensor I u z) =
          u (((TensorProduct.lid A M).toLinearMap ∘ₗ LinearMap.rTensor M I.subtype) z) := by
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a m => simp [LinearMap.comp_apply]
      | add a b ha hb => simpa only [map_add] using congrArg₂ (· + ·) ha hb
    have hright (z : K ⊗[A] N) :
        ((TensorProduct.lid A N).toLinearMap ∘ₗ LinearMap.rTensor N I.subtype)
            (LinearMap.rTensor N kI z) =
          ((TensorProduct.lid A N).toLinearMap ∘ₗ LinearMap.rTensor N K.subtype) z := by
      simp only [LinearMap.comp_apply, ← LinearMap.rTensor_comp_apply]
      rfl
    rw [hleft, hright, hzI, hzK]
  apply htM
  apply (lTensor_residueField_injective u hu)
  have hnatural' (z : I ⊗[A] M) :
      LinearMap.lTensor (A ⧸ maximalIdeal A) u (LinearMap.rTensor M χ z) =
        LinearMap.rTensor N χ (LinearMap.lTensor I u z) := by
    simp only [← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor,
      LinearMap.rTensor_comp_lTensor]
  rw [hnatural' zI, hzEq]
  have hzeroK (z : K ⊗[A] N) :
      LinearMap.rTensor N χ (LinearMap.rTensor N kI z) = 0 := by
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a n =>
        rw [LinearMap.rTensor_tmul, LinearMap.rTensor_tmul,
          show χ (kI a) = 0 from hχK (kI a) a.2]
        exact @TensorProduct.zero_tmul A _ (A ⧸ maximalIdeal A) N _ _ _ _ n
    | add a b ha hb => simp only [map_add, ha, hb, add_zero]
  exact hzeroK zK

end MapsOfFlatModules


/-! ### Existence for flat Mittag-Leffler modules

The auxiliary modules in the Mittag-Leffler condition live in a common universe containing both
the ring and the module, so the ring and module universes remain independent; the `ULift`
shuffling below is what keeps them so. -/

section MittagLeffler

open TensorProduct

universe u v

private lemma isMittagLeffler_ulift
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (hM : IsMittagLeffler.{u, max u v, v, max u v, max u v} A M) :
    IsMittagLeffler.{u, max u v, max u v, max u v, max u v} A
      (ULift.{u} M) := by
  rw [isMittagLeffler_def_iff] at hM ⊢
  intro P _ _ _ f
  obtain ⟨Q, hQa, hQm, hQfp, g, hg⟩ :=
    hM P ((ULift.moduleEquiv (R := A) (M := M)).toLinearMap.comp f)
  refine ⟨Q, hQa, hQm, hQfp, g, fun N _ _ ↦ ?_⟩
  rw [← hg N]
  show LinearMap.ker (f.rTensor N) =
    LinearMap.ker (((ULift.moduleEquiv (R := A) (M := M)).toLinearMap.comp f).rTensor N)
  ext z
  simp only [LinearMap.mem_ker, LinearMap.rTensor_comp, LinearMap.comp_apply]
  constructor
  · intro hz
    rw [hz, map_zero]
  · intro hz
    apply (LinearEquiv.rTensor N
      (ULift.moduleEquiv (R := A) (M := M))).injective
    show ((ULift.moduleEquiv (R := A) (M := M)).toLinearMap.rTensor N)
      ((f.rTensor N) z) = 0
    exact hz

private lemma mem_comap_range_iff_mem_smul_top
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    (J : Ideal A) (x : M) :
    let eA : ULift.{v} A ≃ₗ[A] A := ULift.moduleEquiv
    let eM : ULift.{u} M ≃ₗ[A] M := ULift.moduleEquiv
    eA.symm 1 ⊗ₜ[A] eM.symm x ∈
        LinearMap.range ((Submodule.comap eA.toLinearMap J).subtype.rTensor (ULift.{u} M)) ↔
      x ∈ J • (⊤ : Submodule A M) := by
  dsimp
  let K : Submodule A (ULift.{v} A) := Submodule.comap
    (ULift.moduleEquiv (R := A) (M := A)).toLinearMap J
  let eA : ULift.{v} A ≃ₗ[A] A := ULift.moduleEquiv
  let eK : K ≃ₗ[A] J :=
    { toFun := fun z ↦ ⟨eA z, z.property⟩
      invFun := fun z ↦ ⟨eA.symm z, by simp [K, eA]⟩
      left_inv := fun z ↦ by ext; simp
      right_inv := fun z ↦ by ext; simp
      map_add' := fun _ _ ↦ by ext; simp
      map_smul' := fun _ _ ↦ by ext; simp }
  let E := TensorProduct.congr
    (ULift.moduleEquiv (R := A) (M := A))
    (ULift.moduleEquiv (R := A) (M := M))
  let EK := TensorProduct.congr eK (ULift.moduleEquiv (R := A) (M := M))
  have hcomm (z : K ⊗[A] ULift.{u} M) :
      E (K.subtype.rTensor (ULift.{u} M) z) =
        J.subtype.rTensor M (EK z) := by
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul a m => rfl
    | add z w hz hw => simp [hz, hw]
  rw [← Ideal.subtype_rTensor_range M J]
  constructor
  · rintro ⟨z, hz⟩
    refine ⟨EK z, ?_⟩
    show (TensorProduct.lid A M) (J.subtype.rTensor M (EK z)) = x
    rw [← hcomm z, hz]
    simp [E]
  · rintro ⟨z, hz⟩
    obtain ⟨z', rfl⟩ := EK.surjective z
    refine ⟨z', ?_⟩
    apply E.injective
    rw [hcomm]
    apply (TensorProduct.lid A M).injective
    change (TensorProduct.lid A M) (J.subtype.rTensor M (EK z')) = x at hz
    rw [hz]
    simp [E]

/-- **Stacks Tag 0ASD.** Every element of a flat Mittag-Leffler module has a content ideal. -/
@[stacks 0ASD]
theorem exists_isContentIdeal_of_flat_isMittagLeffler
    {A : Type u} [CommRing A]
    {M : Type v} [AddCommGroup M] [Module A M]
    [Module.Flat A M]
    (hM : IsMittagLeffler.{u, max u v, v, max u v, max u v} A M) (x : M) :
    ∃ I : Ideal A, IsContentIdeal x I := by
  let eA : ULift.{v} A ≃ₗ[A] A := ULift.moduleEquiv
  let eM : ULift.{u} M ≃ₗ[A] M := ULift.moduleEquiv
  let y : ULift.{v} A ⊗[A] ULift.{u} M := eA.symm 1 ⊗ₜ[A] eM.symm x
  have hML := isMittagLeffler_ulift hM
  have hchar :=
    (Module.mittagLeffler_iff_exists_isLeast_mem_range_rTensor_subtype A
      (ULift.{u} M)).mp ((isMittagLeffler_def_iff A _).mp hML)
  obtain ⟨F', hF'⟩ := hchar (ULift.{v} A) y
  let I : Ideal A :=
    { carrier := {a | eA.symm a ∈ F'}
      zero_mem' := F'.zero_mem
      add_mem' := fun ha hb ↦ F'.add_mem ha hb
      smul_mem' := fun a b hb ↦ by
        show eA.symm (a • b) ∈ F'
        rw [eA.symm.map_smul]
        exact F'.smul_mem a hb }
  refine ⟨I, isContentIdeal_of_forall_le ?_ ?_⟩
  · apply (mem_comap_range_iff_mem_smul_top I x).mp
    have hIF : Submodule.comap eA.toLinearMap I = F' := by
      ext z
      simp [I, eA]
    rw [hIF]
    simpa [y, eA, eM] using hF'.1
  · intro J hxJ a ha
    have hle : F' ≤ Submodule.comap eA.toLinearMap J :=
      hF'.2 ((mem_comap_range_iff_mem_smul_top J x).mpr hxJ)
    have ha' : eA.symm a ∈ F' := ha
    have := hle ha'
    simpa [eA] using this

end MittagLeffler

/-! ### Content ideals of a projective module

A projective module has a content ideal for every one of its elements: a dual basis writes the
element as a finite combination of basis-like vectors, and the ideal generated by the occurring
coefficients is the least ideal `I` with `x ∈ I M`. -/

section Projective

/-- **Every element of a projective module has a finitely generated content ideal.** If `M` is a
projective `A`-module and `x ∈ M`, the ideal generated by the coordinates of `x` in a dual basis
is a content ideal of `x`.

Projectivity provides `s : M →ₗ[A] (M →₀ A)` with `∑ (s x) y ⬝ y = x`. Taking `I₀` to be the ideal
generated by the range of `s x` exhibits `x ∈ I₀ M`; and if `x ∈ I M` for an ideal `I`, then
`A`-linearity of `s` and the fact that `s` lands in finitely supported functions force every
coordinate of `s x` into `I`, so `I₀ ≤ I`. -/
theorem exists_isContentIdeal_of_projective {A : Type*} [CommRing A] {M : Type*}
    [AddCommGroup M] [Module A M] [Module.Projective A M] (x : M) :
    ∃ I₀ : Ideal A, I₀.FG ∧ IsContentIdeal x I₀ := by
  classical
  obtain ⟨s, hs⟩ := Module.Projective.out (R := A) (P := M)
  have hcontent : IsContentIdeal x (Ideal.span (Set.range (s x))) := by
    refine isContentIdeal_of_forall_le ?_ ?_
    · have hx := (Submodule.mem_ideal_smul_span_iff_exists_sum
        (Ideal.span (Set.range (s x))) (id : M → M) x).2
        ⟨s x, fun i ↦ Ideal.subset_span ⟨i, rfl⟩, hs x⟩
      simpa only [Set.range_id, Submodule.span_univ] using hx
    · intro J hx
      refine Ideal.span_le.mpr ?_
      rintro c ⟨i, rfl⟩
      refine Submodule.smul_induction_on hx ?_ ?_
      · intro r hr y _
        show (s (r • y)) i ∈ J
        rw [map_smul, Finsupp.smul_apply, smul_eq_mul]
        exact Ideal.mul_mem_right ((s y) i) J hr
      · intro y z hy hz
        show (s (y + z)) i ∈ J
        rw [map_add, Finsupp.add_apply]
        exact J.add_mem hy hz
  exact ⟨_, hcontent.fg, hcontent⟩

end Projective
