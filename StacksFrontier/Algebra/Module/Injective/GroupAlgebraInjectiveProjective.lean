module

public import StacksFrontier.Algebra.Module.Injective.GroupAlgebraSelfInjective
public import StacksFrontier.Algebra.Module.Injective.ZModPrimePower
public import StacksFrontier.Homology.Perfect.ZModPrimePowerReduction
public import StacksFrontier.RingTheory.Module.Projective.NilpotentIdeal
public import Mathlib.NumberTheory.Padics.RingHoms

/-!
# Injective modules over `(ℤ/ℓⁿ)[H]` are projective

Let `ℓ` be a prime, `A = ℤ/ℓⁿ` and `H` a finite group. Every injective module `I` over the group
algebra `A[H]` is projective. Indeed:

* `I` has the exactness property `IsPowExact` over `A`: if `ℓ^a x = 0`, the map `r ℓ^{n-a} ↦ r x`
  on the left ideal generated by the central element `ℓ^{n-a}` is well defined (an element of
  `A[H]` killed by `ℓ^{n-a}` is a multiple of `ℓ^a`, coefficientwise), and it extends to `A[H]`;
  the image `y` of `1` satisfies `ℓ^{n-a} y = x`;
* hence `I` is a flat, so free, `A`-module (`A` is local with nilpotent maximal ideal); let
  `(e_s)` be an `A`-basis with coordinate forms `c_s`;
* the map `σ : I → ⊕_s A[H]`, `σ(x)_s = ∑_h c_s(h⁻¹ x) h`, is `A[H]`-linear and injective (the
  coefficient of `1` in `σ(x)_s` is `c_s(x)`), so it is split by injectivity of `I`, and `I` is a
  direct summand of a free `A[H]`-module.

Together with `MonoidAlgebra.injective_of_finite_projective` this says that `(ℤ/ℓⁿ)[H]` is a
quasi-Frobenius ring in the strong sense that injective and projective modules coincide. It is
the algebraic input for the perfectness of `RΓ_c(U_k̄, D(A[H]))` in Step 7 of the proof of
[Stacks, Tag 03UG].

## Main results

* `MonoidAlgebra.isPowExact_of_injective_zmod`
* `MonoidAlgebra.projective_of_injective_zmod`

## References

* [Stacks Project, Tag 03UG](https://stacks.math.columbia.edu/tag/03UG)
-/

@[expose] public section

universe w

open Stacks.ZModPrimePower

namespace MonoidAlgebra

variable {ℓ : ℕ} [hℓ : Fact ℓ.Prime] {n : ℕ} {H : Type} [Group H]

/-- An element of `(ℤ/ℓⁿ)[H]` killed by `ℓ^{n-a}` acts by zero on an element killed by `ℓ^a`. -/
theorem smul_eq_zero_of_mul_natCast_eq_zero {a : ℕ} (ha : a ≤ n) {I : Type w} [AddCommGroup I]
    [Module (MonoidAlgebra (ZMod (ℓ ^ n)) H) I] {x : I} (hx : ℓ ^ a • x = 0)
    {r : MonoidAlgebra (ZMod (ℓ ^ n)) H} (hr : r * ((ℓ ^ (n - a) : ℕ) : MonoidAlgebra _ H) = 0) :
    r • x = 0 := by
  classical
  have hcoeff : ∀ h : H, ((ℓ : ZMod (ℓ ^ n)) ^ (n - a)) * r.coeff h = 0 := fun h => by
    have := congrArg (fun t : MonoidAlgebra (ZMod (ℓ ^ n)) H => t.coeff h) hr
    rw [MonoidAlgebra.natCast_def, coeff_mul_single_one, coeff_zero] at this
    rw [mul_comm]
    simpa using this
  rw [← sum_coeff_single r, Finsupp.sum, Finset.sum_smul]
  refine Finset.sum_eq_zero fun h _ => ?_
  obtain ⟨s, hs⟩ := exists_eq_pow_mul_of_pow_mul_eq_zero ha (hcoeff h)
  have : single h (r.coeff h) = single h s * ((ℓ ^ a : ℕ) : MonoidAlgebra (ZMod (ℓ ^ n)) H) := by
    rw [MonoidAlgebra.natCast_def, single_mul_single, mul_one, hs]
    push_cast
    ring_nf
  rw [this, mul_smul, Nat.cast_smul_eq_nsmul, hx, smul_zero]

/-- **An injective `(ℤ/ℓⁿ)[H]`-module has the exactness property**: an element killed by `ℓ^a` is
a multiple of `ℓ^{n-a}`. -/
theorem isPowExact_of_injective_zmod (I : Type w) [AddCommGroup I]
    [Module (MonoidAlgebra (ZMod (ℓ ^ n)) H) I]
    [Module.Injective (MonoidAlgebra (ZMod (ℓ ^ n)) H) I] :
    IsPowExact ℓ n I := by
  intro a ha x hx
  let R := MonoidAlgebra (ZMod (ℓ ^ n)) H
  let c : R := ((ℓ ^ (n - a) : ℕ) : R)
  let μ : R →ₗ[R] R := LinearMap.mulRight R c
  have hker : LinearMap.ker μ ≤ LinearMap.ker (LinearMap.toSpanSingleton R I x) := fun _ hr =>
    smul_eq_zero_of_mul_natCast_eq_zero ha hx hr
  let g : LinearMap.range μ →ₗ[R] I :=
    (LinearMap.ker μ).liftQ _ hker ∘ₗ (μ.quotKerEquivRange).symm.toLinearMap
  obtain ⟨g', hg'⟩ :=
    (Module.Baer.of_injective (R := R) (Q := I) inferInstance) (LinearMap.range μ) g
  refine ⟨g' 1, ?_⟩
  have hc : c ∈ LinearMap.range μ := ⟨1, by simp [μ]⟩
  have h1 : g' c = x := by
    rw [hg' c hc]
    have : (μ.quotKerEquivRange).symm ⟨c, hc⟩ = Submodule.Quotient.mk 1 := by
      rw [LinearEquiv.symm_apply_eq]
      ext
      simp [μ, LinearMap.quotKerEquivRange_apply_mk]
    simp only [g, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply, this,
      Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply, one_smul]
  rw [← h1, show c = c • (1 : R) by simp, map_smul, Nat.cast_smul_eq_nsmul]

/-- `ℤ/ℓⁿ` is a local ring, for `n ≠ 0`. -/
theorem zmod_primePow_isLocalRing [NeZero n] : IsLocalRing (ZMod (ℓ ^ n)) := by
  obtain ⟨n', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (NeZero.ne n)
  have : Fact (1 < ℓ ^ (n' + 1)) :=
    ⟨Nat.one_lt_pow (Nat.succ_ne_zero n') hℓ.out.one_lt⟩
  exact IsLocalRing.of_surjective' (PadicInt.toZModPow (n' + 1)) (ZMod.ringHom_surjective _)

/-- The `A[H]`-linear map `x ↦ ∑_h c(h⁻¹ x) h` attached to an `A`-linear form `c` on an
`A[H]`-module, `A` acting through `A ⟶ A[H]`. -/
noncomputable def formLift [Fintype H] {A : Type} [CommRing A] {I : Type w} [AddCommGroup I]
    [Module (MonoidAlgebra A H) I] (c : I →+ A)
    (hc : ∀ (a : A) (x : I), c (single (1 : H) a • x) = a * c x) :
    I →ₗ[MonoidAlgebra A H] MonoidAlgebra A H where
  toFun x := ∑ h : H, single h (c (single h⁻¹ (1 : A) • x))
  map_add' x y := by
    simp only [smul_add, map_add, single_add, Finset.sum_add_distrib]
  map_smul' r x := by
    change ∑ h : H, single h (c (single h⁻¹ (1 : A) • (r • x))) =
      r * ∑ h : H, single h (c (single h⁻¹ (1 : A) • x))
    induction r using MonoidAlgebra.induction_on with
    | of g =>
      calc ∑ h : H, single h (c (single h⁻¹ (1 : A) • (of A H g • x)))
          = ∑ h : H, single (g * h) (c (single (g * h)⁻¹ (1 : A) • (of A H g • x))) :=
            (Fintype.sum_equiv (Equiv.mulLeft g) _ _ fun h => rfl).symm
        _ = ∑ h : H, of A H g * single h (c (single h⁻¹ (1 : A) • x)) := by
            refine Finset.sum_congr rfl fun h _ => ?_
            rw [MonoidAlgebra.of_apply, single_mul_single, one_mul, ← mul_smul, single_mul_single,
              mul_one, mul_inv_rev, inv_mul_cancel_right]
        _ = of A H g * ∑ h : H, single h (c (single h⁻¹ (1 : A) • x)) := (Finset.mul_sum ..).symm
    | add s t hs ht =>
      simp only [add_smul, smul_add, map_add, single_add, Finset.sum_add_distrib, add_mul, hs, ht]
    | smul a s hs =>
      have hsm : ∀ y : I, (a • s) • y = single (1 : H) a • (s • y) := fun y => by
        rw [← mul_smul, Algebra.smul_def]
        rfl
      have hcomm : ∀ (h : H) (y : I), single h⁻¹ (1 : A) • (single (1 : H) a • y) =
          single (1 : H) a • (single h⁻¹ (1 : A) • y) := fun h y => by
        rw [← mul_smul, ← mul_smul, single_mul_single, single_mul_single, one_mul, mul_one,
          mul_one, one_mul]
      simp only [hsm, hcomm, hc]
      rw [smul_mul_assoc, ← hs, Finset.smul_sum]
      refine Finset.sum_congr rfl fun h _ => ?_
      rw [smul_single, smul_eq_mul]

/-- `formLift c hc` sends `x` to `∑_h c(h⁻¹ x) h`. -/
theorem formLift_apply [Fintype H] {A : Type} [CommRing A] {I : Type w} [AddCommGroup I]
    [Module (MonoidAlgebra A H) I] (c : I →+ A)
    (hc : ∀ (a : A) (x : I), c (single (1 : H) a • x) = a * c x) (x : I) :
    formLift c hc x = ∑ h : H, single h (c (single h⁻¹ (1 : A) • x)) := rfl

/-- The coefficient of `1` in `∑_h c(h⁻¹ x) h` is `c(x)`. -/
theorem coeff_one_formLift [Fintype H] {A : Type} [CommRing A] {I : Type w} [AddCommGroup I]
    [Module (MonoidAlgebra A H) I] (c : I →+ A)
    (hc : ∀ (a : A) (x : I), c (single (1 : H) a • x) = a * c x) (x : I) :
    (formLift c hc x).coeff 1 = c x := by
  classical
  rw [formLift_apply, MonoidAlgebra.coeff_sum, Finsupp.finsetSum_apply,
    Finset.sum_eq_single (1 : H)]
  · simp [← MonoidAlgebra.one_def]
  · intro h _ hh
    simp [hh]
  · simp

/-- **Injective `(ℤ/ℓⁿ)[H]`-modules are projective.** -/
theorem projective_of_injective_zmod [Finite H] [NeZero n] (I : Type w) [AddCommGroup I]
    [Module (MonoidAlgebra (ZMod (ℓ ^ n)) H) I]
    [Module.Injective (MonoidAlgebra (ZMod (ℓ ^ n)) H) I] :
    Module.Projective (MonoidAlgebra (ZMod (ℓ ^ n)) H) I := by
  classical
  have := Fintype.ofFinite H
  let A := ZMod (ℓ ^ n)
  let R := MonoidAlgebra A H
  let : Module A I := Module.compHom I (algebraMap A R)
  have : IsLocalRing A := zmod_primePow_isLocalRing
  have : Module.Free A I :=
    ((Module.tfae_flat_free_projective_of_isNilpotent_maximalIdeal (M := I)
      ((isArtinianRing_iff_isNilpotent_maximalIdeal A).mp inferInstance)).out 1 2).mp
      (flat_of_isPowExact (isPowExact_of_injective_zmod (H := H) I))
  let b := Module.Free.chooseBasis A I
  let S := Module.Free.ChooseBasisIndex A I
  have hc : ∀ (s : S) (a : A) (x : I),
      (b.coord s).toAddMonoidHom (single (1 : H) a • x) = a * (b.coord s).toAddMonoidHom x :=
    fun s a x => by
      change b.coord s (a • x) = _
      rw [map_smul, smul_eq_mul]
      rfl
  let cs : S → (I →+ A) := fun s => (b.coord s).toAddMonoidHom
  have hcs : ∀ (s : S) (y : I), cs s y = b.repr y s := fun _ _ => rfl
  let σf : I → (S →₀ R) := fun x => Finsupp.onFinset
    (Finset.univ.biUnion fun h : H => (b.repr (single h⁻¹ (1 : A) • x)).support)
    (fun s => formLift (cs s) (hc s) x) (by
      intro s hs
      by_contra hnot
      apply hs
      rw [formLift_apply]
      refine Finset.sum_eq_zero fun h _ => ?_
      rw [hcs, Finsupp.notMem_support_iff.mp fun hm =>
        hnot (Finset.mem_biUnion.2 ⟨h, Finset.mem_univ _, hm⟩), single_zero])
  have hσf : ∀ x s, σf x s = formLift (cs s) (hc s) x := fun _ _ => Finsupp.onFinset_apply
  let σ : I →ₗ[R] (S →₀ R) :=
    { toFun := σf
      map_add' := fun x y => by
        ext s
        rw [Finsupp.add_apply, hσf, hσf, hσf, map_add]
      map_smul' := fun r x => by
        ext s
        rw [Finsupp.smul_apply, hσf, hσf, map_smul, RingHom.id_apply] }
  have hσ : Function.Injective σ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    refine b.repr.injective (Finsupp.ext fun s => ?_)
    have := congrArg (fun f : S →₀ R => (f s).coeff 1) hx
    simp only [Finsupp.zero_apply, coeff_zero] at this
    change (σf x s).coeff 1 = 0 at this
    rw [hσf, coeff_one_formLift, hcs] at this
    rw [this, map_zero, Finsupp.zero_apply]
  obtain ⟨ρ, hρ⟩ := Module.Injective.extension_property R I I (S →₀ R) σ hσ LinearMap.id
  exact Module.Projective.of_split σ ρ hρ

end MonoidAlgebra
