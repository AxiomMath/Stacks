module

public import StacksFrontier.Algebra.Module.Injective.ZModSelfInjective
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.LinearAlgebra.Dual.Defs
public import Mathlib.SetTheory.Cardinal.Finite

/-!
# Duality for finite `ℤ/n`-modules

Let `n ≠ 0` and let `M` be a finite `ℤ/n`-module. Since `ℤ/n` is self-injective
(`ZMod.injective_self`), linear forms separate the points of `M`, the dual `M^* = Hom(M, ℤ/n)` has
the same number of elements as `M`, and the evaluation map `M → M^**` is an isomorphism.

This is the duality the quasi-Frobenius treatment of the coefficients `A = ℤ/ℓⁿ` in Step 7 of the
proof of [Stacks, Tag 03UG] rests on: it identifies `L ⊗_A M` with `Hom_A(M^*, L)` for a free
`A`-module `L`, and so turns the derived tensor product by `M` into an additive functor
preserving finite projective modules.

## Main definitions

* `ZMod.evalEquiv`: the evaluation isomorphism `M ≃ M^**` of a finite `ℤ/n`-module.

## Main results

* `ZMod.exists_dual_ne_zero`: a nonzero element is not killed by every linear form.
* `ZMod.natCard_dual_le`: the dual `M^*` of a finite `ℤ/n`-module has `#M^* ≤ #M`.

## References

* [Stacks Project, Tag 03UG](https://stacks.math.columbia.edu/tag/03UG), Step 7.
-/

@[expose] public section

namespace ZMod

variable (n : ℕ) [NeZero n]

/-- **Linear forms separate points.** A nonzero element of a `ℤ/n`-module is not killed by every
linear form. -/
theorem exists_dual_ne_zero {M : Type*} [AddCommGroup M] [Module (ZMod n) M] (m : M)
    (hm : m ≠ 0) : ∃ φ : M →ₗ[ZMod n] ZMod n, φ m ≠ 0 := by
  set f : ZMod n →ₗ[ZMod n] M := LinearMap.toSpanSingleton (ZMod n) M m
  obtain ⟨e, he⟩ := exists_eq_span_singleton n (LinearMap.ker f)
  obtain ⟨c, hc0, hec⟩ : ∃ c : ZMod n, c ≠ 0 ∧ e * c = 0 := by
    by_contra! H
    have hinj : Function.Injective (fun x : ZMod n => e * x) := fun x y hxy => by
      by_contra hne
      exact H (x - y) (sub_ne_zero.mpr hne) ((mul_sub e x y).trans (sub_eq_zero.mpr hxy))
    obtain ⟨x, hx⟩ := (Finite.injective_iff_surjective.mp hinj) 1
    have h1 : (1 : ZMod n) ∈ LinearMap.ker f := by
      rw [he, Submodule.mem_span_singleton]
      exact ⟨x, by simpa [mul_comm] using hx⟩
    exact hm (by simpa [f] using h1)
  set ψ : ZMod n →ₗ[ZMod n] ZMod n := LinearMap.mulRight (ZMod n) c
  have hle : LinearMap.ker f ≤ LinearMap.ker ψ := by
    rw [he, Submodule.span_singleton_le_iff_mem, LinearMap.mem_ker]
    simpa [ψ] using hec
  set g : LinearMap.range f →ₗ[ZMod n] ZMod n :=
    ((LinearMap.ker f).liftQ ψ hle).comp (f.quotKerEquivRange.symm : _ →ₗ[ZMod n] _)
  obtain ⟨φ, hφ⟩ := (baer_self n).extension_property (LinearMap.range f).subtype
    Subtype.val_injective g
  refine ⟨φ, ?_⟩
  have hm' : m = (LinearMap.range f).subtype ⟨f 1, LinearMap.mem_range_self f 1⟩ := by simp [f]
  rw [hm', ← LinearMap.comp_apply, hφ]
  have : (f.quotKerEquivRange.symm ⟨f 1, LinearMap.mem_range_self f 1⟩) =
      (LinearMap.ker f).mkQ 1 := by
    rw [LinearEquiv.symm_apply_eq]
    rfl
  simpa only [g, LinearMap.comp_apply, LinearEquiv.coe_coe, this, Submodule.mkQ_apply,
    Submodule.liftQ_apply, ψ, LinearMap.mulRight_apply, one_mul] using hc0

/-- The dual of the cyclic submodule of a `ℤ/n`-module generated by `m` has at most as many
elements as that submodule. -/
theorem natCard_dual_span_singleton_le {M : Type*} [AddCommGroup M] [Module (ZMod n) M] (m : M) :
    Nat.card (Module.Dual (ZMod n) (Submodule.span (ZMod n) {m})) ≤
      Nat.card (Submodule.span (ZMod n) {m}) := by
  set S := Submodule.span (ZMod n) {m}
  set m₀ : S := ⟨m, Submodule.mem_span_singleton_self m⟩
  set f : ZMod n →ₗ[ZMod n] S := LinearMap.toSpanSingleton (ZMod n) S m₀
  have hf : Function.Surjective f := fun ⟨x, hx⟩ => by
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hx
    exact ⟨r, rfl⟩
  have hev : Function.Injective (fun φ : Module.Dual (ZMod n) S => φ m₀) := fun φ ψ h => by
    ext x
    obtain ⟨r, rfl⟩ := hf x
    simp only [f, LinearMap.toSpanSingleton_apply, map_smul]
    simp only at h
    rw [h]
  obtain ⟨e, he⟩ := exists_eq_span_singleton n (LinearMap.ker f)
  set mulE : ZMod n →ₗ[ZMod n] ZMod n := LinearMap.mulLeft (ZMod n) e
  have himg : ∀ φ : Module.Dual (ZMod n) S, φ m₀ ∈ LinearMap.ker mulE := fun φ => by
    have : e ∈ LinearMap.ker f := he ▸ Submodule.mem_span_singleton_self e
    rw [LinearMap.mem_ker] at this ⊢
    simpa [f, mulE, smul_eq_mul] using congrArg φ this
  have h1 : Nat.card (Module.Dual (ZMod n) S) ≤ Nat.card (LinearMap.ker mulE) :=
    Nat.card_le_card_of_injective (fun φ => ⟨φ m₀, himg φ⟩) fun φ ψ h =>
      hev (congrArg Subtype.val h)
  have hr : LinearMap.range mulE = LinearMap.ker f := by
    rw [he]
    ext x
    simp [mulE, Submodule.mem_span_singleton, mul_comm, eq_comm]
  have k1 := Submodule.card_eq_card_quotient_mul_card (LinearMap.ker mulE)
  have k2 := Submodule.card_eq_card_quotient_mul_card (LinearMap.ker f)
  rw [Nat.card_congr (LinearMap.quotKerEquivRange mulE).toEquiv, hr] at k1
  rw [Nat.card_congr (LinearMap.quotKerEquivOfSurjective f hf).toEquiv] at k2
  have hpos : 0 < Nat.card (LinearMap.ker f) := Nat.card_pos
  have : Nat.card (LinearMap.ker mulE) = Nat.card S :=
    Nat.eq_of_mul_eq_mul_right hpos (k1.symm.trans (k2.trans (mul_comm _ _)))
  omega

/-- The dual `Module.Dual (ZMod n) P` of a finite `ℤ/n`-module `P` is finite. -/
instance finite_dual (P : Type*) [AddCommGroup P] [Module (ZMod n) P] [Finite P] :
    Finite (Module.Dual (ZMod n) P) :=
  Finite.of_injective (fun φ : Module.Dual (ZMod n) P => (φ : P → ZMod n)) DFunLike.coe_injective

/-- For every `k`, the dual of a finite `ℤ/n`-module `N` with `k` elements has at most as many
elements as `N`. -/
theorem natCard_dual_le : ∀ (k : ℕ) (N : Type*) [AddCommGroup N] [Module (ZMod n) N] [Finite N],
    Nat.card N = k → Nat.card (Module.Dual (ZMod n) N) ≤ Nat.card N := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ih =>
  intro N _ _ _ hk
  rcases subsingleton_or_nontrivial N with hN | hN
  · have : Subsingleton (Module.Dual (ZMod n) N) :=
      ⟨fun φ ψ => LinearMap.ext fun x => by rw [Subsingleton.elim x 0, map_zero, map_zero]⟩
    rw [Nat.card_of_subsingleton (0 : N), Nat.card_of_subsingleton (0 : Module.Dual (ZMod n) N)]
  obtain ⟨m, hm⟩ := exists_ne (0 : N)
  set S := Submodule.span (ZMod n) {m}
  have : Finite (N ⧸ S) := Finite.of_surjective _ (Submodule.mkQ_surjective S)
  set r : Module.Dual (ZMod n) N →ₗ[ZMod n] Module.Dual (ZMod n) S :=
    LinearMap.lcomp (ZMod n) (ZMod n) S.subtype
  have hS1 : 1 < Nat.card S := by
    rw [Finite.one_lt_card_iff_nontrivial]
    exact ⟨⟨0, ⟨m, Submodule.mem_span_singleton_self m⟩,
      fun h => hm (congrArg Subtype.val h).symm⟩⟩
  have hNS := Submodule.card_eq_card_quotient_mul_card S
  have hq : Nat.card (N ⧸ S) < k := by
    rw [← hk, hNS]
    exact lt_mul_of_one_lt_left (Nat.card_pos (α := N ⧸ S)) hS1
  have hker : Nat.card (LinearMap.ker r) ≤ Nat.card (Module.Dual (ZMod n) (N ⧸ S)) :=
    Nat.card_le_card_of_injective (fun φ => S.liftQ φ.1 (fun x hx =>
        LinearMap.congr_fun (LinearMap.mem_ker.mp φ.2) ⟨x, hx⟩))
      fun φ ψ h => Subtype.ext <| LinearMap.ext fun x => LinearMap.congr_fun h (S.mkQ x)
  have hd := Submodule.card_eq_card_quotient_mul_card (LinearMap.ker r)
  rw [Nat.card_congr (LinearMap.quotKerEquivRange r).toEquiv] at hd
  calc Nat.card (Module.Dual (ZMod n) N)
      = Nat.card (LinearMap.ker r) * Nat.card (LinearMap.range r) := by rw [hd, mul_comm]
    _ ≤ Nat.card (N ⧸ S) * Nat.card S :=
        Nat.mul_le_mul (hker.trans (ih _ hq (N ⧸ S) rfl))
          (le_trans (Nat.card_le_card_of_injective _ Subtype.val_injective)
            (natCard_dual_span_singleton_le n m))
    _ = Nat.card N := by rw [hNS, mul_comm]

/-- **The evaluation isomorphism `M ≃ M^**`** of a finite `ℤ/n`-module. -/
noncomputable def evalEquiv (M : Type*) [AddCommGroup M] [Module (ZMod n) M] [Finite M] :
    M ≃ₗ[ZMod n] Module.Dual (ZMod n) (Module.Dual (ZMod n) M) :=
  LinearEquiv.ofBijective (Module.Dual.eval (ZMod n) M) <| by
    have hinj : Function.Injective (Module.Dual.eval (ZMod n) M) := by
      rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
      intro m hm
      by_contra h0
      obtain ⟨φ, hφ⟩ := exists_dual_ne_zero n m h0
      exact hφ (LinearMap.congr_fun (LinearMap.mem_ker.mp hm) φ)
    exact ⟨hinj, (hinj.bijective_of_nat_card_le
      ((natCard_dual_le n _ _ rfl).trans (natCard_dual_le n _ M rfl))).2⟩

end ZMod
