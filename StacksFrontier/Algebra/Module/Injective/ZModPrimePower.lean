module

public import Mathlib.Algebra.Module.Injective
public import Mathlib.Data.Nat.Factorization.Basic
public import Mathlib.Data.ZMod.Units
public import Mathlib.LinearAlgebra.Isomorphisms
public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.RingTheory.PrincipalIdealDomain
public import Mathlib.Algebra.EuclideanDomain.Int
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Injective modules over `ℤ/pᵐℤ`

Let `p` be a prime and `R = ℤ/pᵐℤ`.  The ring `R` is self-injective, and in every `R`-module
satisfying Baer's criterion the kernel of `p^a` is the image of `p^(m - a)`.  For an injective
sheaf `I` of `R`-modules the second fact identifies `I / p^{m'} I` with `I[p^{m'}]`, the
coextension of scalars of `I` to `ℤ/p^{m'}ℤ`.  This is how the cohomology with coefficients in
`ℤ/p^{m'}ℤ` of the reduction of a flat sheaf is computed from an injective resolution with
coefficients in `ℤ/pᵐℤ`, in the change of coefficients behind [Tag 03V2].

## Main results

* `Stacks.ZModPrimePower.exists_eq_pow_mul_of_pow_mul_eq_zero`: in `ℤ/pᵐℤ`, the annihilator of
  `p^(m - a)` is generated by `p^a`.
* `Stacks.ZModPrimePower.exists_pow_smul_eq_of_pow_smul_eq_zero`: in a Baer module, `p^a x = 0`
  implies `x = p^(m - a) y` for some `y`.
* `Stacks.ZModPrimePower.baer_self`: `ℤ/pᵐℤ` satisfies Baer's criterion over itself.
* `Stacks.ZModPrimePower.IsPowExact`: the sequences `M --p^(m-a)--> M --p^a--> M` are exact;
  it holds for Baer modules and for free modules.

## References

* [Stacks Project, Tag 03V2](https://stacks.math.columbia.edu/tag/03V2)
-/

@[expose] public section

namespace Stacks.ZModPrimePower

variable {p : ℕ} [hp : Fact p.Prime] {m : ℕ}

/-- In `ℤ/pᵐℤ`, an element killed by `p^(m - a)` is a multiple of `p^a`. -/
theorem exists_eq_pow_mul_of_pow_mul_eq_zero {a : ℕ} (ha : a ≤ m) {r : ZMod (p ^ m)}
    (h : (p : ZMod (p ^ m)) ^ (m - a) * r = 0) : ∃ s, r = (p : ZMod (p ^ m)) ^ a * s := by
  have : NeZero (p ^ m) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  obtain ⟨k, rfl⟩ : ∃ k : ℕ, (k : ZMod (p ^ m)) = r := ⟨r.val, ZMod.natCast_zmod_val r⟩
  have h' : p ^ m ∣ p ^ (m - a) * k := by
    rw [← ZMod.natCast_eq_zero_iff]
    exact_mod_cast h
  have hk : p ^ a ∣ k := by
    rw [show p ^ m = p ^ (m - a) * p ^ a by rw [← pow_add, Nat.sub_add_cancel ha]] at h'
    exact Nat.dvd_of_mul_dvd_mul_left (pow_pos hp.out.pos _) h'
  obtain ⟨t, rfl⟩ := hk
  exact ⟨t, by push_cast; ring⟩

/-- **In a module over `ℤ/pᵐℤ` satisfying Baer's criterion, the kernel of `p^a` is the image of
`p^(m - a)`.** -/
theorem exists_pow_smul_eq_of_pow_smul_eq_zero {J : Type*} [AddCommGroup J]
    [Module (ZMod (p ^ m)) J] (hJ : Module.Baer (ZMod (p ^ m)) J) {a : ℕ} (ha : a ≤ m) {x : J}
    (hx : ((p : ZMod (p ^ m)) ^ a) • x = 0) :
    ∃ y, ((p : ZMod (p ^ m)) ^ (m - a)) • y = x := by
  let c : ZMod (p ^ m) := (p : ZMod (p ^ m)) ^ (m - a)
  let f : ZMod (p ^ m) →ₗ[ZMod (p ^ m)] J := LinearMap.toSpanSingleton _ _ x
  let g : ZMod (p ^ m) →ₗ[ZMod (p ^ m)] ZMod (p ^ m) := LinearMap.mulLeft _ c
  have hker : LinearMap.ker g ≤ LinearMap.ker f := by
    intro r hr
    rw [LinearMap.mem_ker] at hr ⊢
    obtain ⟨s, rfl⟩ := exists_eq_pow_mul_of_pow_mul_eq_zero ha hr
    show ((p : ZMod (p ^ m)) ^ a * s) • x = 0
    rw [mul_comm, mul_smul, hx, smul_zero]
  let φ : LinearMap.range g →ₗ[ZMod (p ^ m)] J :=
    ((LinearMap.ker g).liftQ f hker).comp g.quotKerEquivRange.symm.toLinearMap
  obtain ⟨g', hg'⟩ := hJ (LinearMap.range g) φ
  refine ⟨g' 1, ?_⟩
  have h2 : φ ⟨g 1, LinearMap.mem_range_self g 1⟩ = x := by
    simp only [φ, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply,
      LinearMap.quotKerEquivRange_symm_apply_image]
    rw [Submodule.mkQ_apply, Submodule.liftQ_apply]
    exact one_smul _ x
  calc c • g' 1 = g' (g 1) := by
        rw [← map_smul, smul_eq_mul, mul_one]
        simp [g]
    _ = x := (hg' (g 1) (LinearMap.mem_range_self g 1)).trans h2

omit hp in
/-- In `ℤ/pᵐℤ`, `p ^ m = 0`. -/
private theorem natCast_pow_self_eq_zero : (p : ZMod (p ^ m)) ^ m = 0 := by
  exact_mod_cast ZMod.natCast_self (p ^ m)

/-- Every element of `ℤ/pᵐℤ` is a power of `p` times a unit. -/
theorem exists_eq_pow_mul_unit (r : ZMod (p ^ m)) :
    ∃ a ≤ m, ∃ u : (ZMod (p ^ m))ˣ, r = (p : ZMod (p ^ m)) ^ a * u := by
  have : NeZero (p ^ m) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  by_cases h0 : r.val = 0
  · refine ⟨m, le_rfl, 1, ?_⟩
    rw [(ZMod.val_eq_zero r).1 h0, Units.val_one, mul_one]
    exact natCast_pow_self_eq_zero.symm
  obtain ⟨e, w, hw, he⟩ := Nat.exists_eq_pow_mul_and_not_dvd h0 p hp.out.one_lt.ne'
  have hlt : p ^ e < p ^ m := by
    calc p ^ e ≤ r.val := by
          rw [he]
          exact Nat.le_mul_of_pos_right _ (Nat.pos_of_ne_zero (by rintro rfl; simp at hw))
      _ < p ^ m := ZMod.val_lt r
  have hcop : Nat.Coprime w (p ^ m) :=
    Nat.Coprime.pow_right _ (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hp.out).2 hw))
  refine ⟨e, ((Nat.pow_lt_pow_iff_right hp.out.one_lt).1 hlt).le, ZMod.unitOfCoprime w hcop, ?_⟩
  rw [ZMod.coe_unitOfCoprime, ← ZMod.natCast_zmod_val r, he]
  push_cast
  rfl

/-- **`ℤ/pᵐℤ` is self-injective**: it satisfies Baer's criterion over itself. -/
@[sga "4 XVIII 3.2.6" "special case"]
theorem baer_self : Module.Baer (ZMod (p ^ m)) (ZMod (p ^ m)) := by
  intro I f
  have : IsPrincipalIdealRing (ZMod (p ^ m)) :=
    IsPrincipalIdealRing.of_surjective (Int.castRingHom (ZMod (p ^ m))) ZMod.intCast_surjective
  obtain ⟨g, rfl⟩ : ∃ g, I = Ideal.span {g} :=
    ⟨_, (Submodule.IsPrincipal.span_singleton_generator I).symm⟩
  obtain ⟨a, ha, u, hgu⟩ := exists_eq_pow_mul_unit g
  have hg : g ∈ Ideal.span {g} := Ideal.subset_span rfl
  have hkill : (p : ZMod (p ^ m)) ^ (m - a) * f ⟨g, hg⟩ = 0 := by
    rw [← smul_eq_mul, ← map_smul]
    have : (p : ZMod (p ^ m)) ^ (m - a) • (⟨g, hg⟩ : Ideal.span {g}) = 0 := by
      ext
      show (p : ZMod (p ^ m)) ^ (m - a) * g = 0
      rw [hgu, ← mul_assoc, ← pow_add, Nat.sub_add_cancel ha, natCast_pow_self_eq_zero, zero_mul]
    rw [this, map_zero]
  obtain ⟨s, hs⟩ := exists_eq_pow_mul_of_pow_mul_eq_zero ha hkill
  refine ⟨LinearMap.mulRight _ ((u⁻¹ : (ZMod (p ^ m))ˣ) * s), fun x hx => ?_⟩
  obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  have hf : f ⟨t * g, hx⟩ = t * f ⟨g, hg⟩ := by
    rw [show (⟨t * g, hx⟩ : Ideal.span {g}) = t • ⟨g, hg⟩ from rfl, map_smul, smul_eq_mul]
  rw [hf, hs, LinearMap.mulRight_apply, hgu]
  calc t * ((p : ZMod (p ^ m)) ^ a * u) * (↑u⁻¹ * s) =
      t * ((p : ZMod (p ^ m)) ^ a * s) * (u * ↑u⁻¹) := by ring
    _ = t * ((p : ZMod (p ^ m)) ^ a * s) := by rw [Units.mul_inv, mul_one]

/-! ### The exactness of `p^(m - a)` and `p^a` -/

/-- **`M --p^(m-a)--> M --p^a--> M` is exact for every `a ≤ m`**: an element killed by `p^a` is
a multiple of `p^(m - a)`.  For a `ℤ/pᵐℤ`-module this is flatness; it is stated for an
additive group, with natural-number multiples, so that it transports along additive
isomorphisms such as the corepresentation of sections of a sheaf. -/
def IsPowExact (p m : ℕ) (M : Type*) [AddCommGroup M] : Prop :=
  ∀ a ≤ m, ∀ x : M, p ^ a • x = 0 → ∃ y : M, p ^ (m - a) • y = x

/-- The exactness property `IsPowExact p m` is invariant under additive isomorphisms. -/
theorem IsPowExact.of_addEquiv {M N : Type*} [AddCommGroup M] [AddCommGroup N] (e : M ≃+ N)
    (h : IsPowExact p m M) : IsPowExact p m N := by
  intro a ha x hx
  obtain ⟨y, hy⟩ := h a ha (e.symm x) (by rw [← map_nsmul, hx, map_zero])
  exact ⟨e y, by rw [← map_nsmul, hy, AddEquiv.apply_symm_apply]⟩

/-- A module over `ℤ/pᵐℤ` satisfying Baer's criterion has the exactness property. -/
theorem isPowExact_of_baer {J : Type*} [AddCommGroup J] [Module (ZMod (p ^ m)) J]
    (hJ : Module.Baer (ZMod (p ^ m)) J) : IsPowExact p m J := by
  intro a ha x hx
  obtain ⟨y, hy⟩ := exists_pow_smul_eq_of_pow_smul_eq_zero hJ ha
    (x := x) (by rwa [← Nat.cast_pow, Nat.cast_smul_eq_nsmul])
  exact ⟨y, by rwa [← Nat.cast_smul_eq_nsmul (ZMod (p ^ m)), Nat.cast_pow]⟩

/-- Free modules over `ℤ/pᵐℤ` have the exactness property. -/
theorem isPowExact_finsupp (X : Type*) : IsPowExact p m (X →₀ ZMod (p ^ m)) := by
  classical
  have hR := isPowExact_of_baer (p := p) (m := m) baer_self
  intro a ha x hx
  let c : ZMod (p ^ m) → ZMod (p ^ m) := fun r =>
    if h : p ^ a • r = 0 then (if r = 0 then 0 else (hR a ha r h).choose) else 0
  have hc0 : c 0 = 0 := by simp [c]
  refine ⟨Finsupp.mapRange c hc0 x, ?_⟩
  ext i
  have hi : p ^ a • x i = 0 := by simpa using congrArg (fun z => z i) hx
  simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, c, dif_pos hi]
  by_cases h0 : x i = 0
  · simp [h0]
  · rw [if_neg h0]
    exact (hR a ha (x i) hi).choose_spec

/-- **Over `ℤ/pᵐℤ`, the exactness property is Baer's criterion**: every ideal is principal,
generated by `p^a` times a unit, and a map out of `(p^a)` is an element killed by `p^(m - a)`. -/
theorem baer_of_isPowExact {J : Type*} [AddCommGroup J] [Module (ZMod (p ^ m)) J]
    (hJ : IsPowExact p m J) : Module.Baer (ZMod (p ^ m)) J := by
  intro I f
  have : IsPrincipalIdealRing (ZMod (p ^ m)) :=
    IsPrincipalIdealRing.of_surjective (Int.castRingHom (ZMod (p ^ m))) ZMod.intCast_surjective
  obtain ⟨g, rfl⟩ : ∃ g, I = Ideal.span {g} :=
    ⟨_, (Submodule.IsPrincipal.span_singleton_generator I).symm⟩
  obtain ⟨a, ha, u, hgu⟩ := exists_eq_pow_mul_unit g
  have hg : g ∈ Ideal.span {g} := Ideal.subset_span rfl
  have : NeZero (p ^ m) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  have hkill : p ^ (m - a) • f ⟨g, hg⟩ = 0 := by
    rw [← map_nsmul]
    have : p ^ (m - a) • (⟨g, hg⟩ : Ideal.span {g}) = 0 := by
      ext
      show p ^ (m - a) • g = 0
      rw [← Nat.cast_smul_eq_nsmul (ZMod (p ^ m)), smul_eq_mul, hgu, Nat.cast_pow, ← mul_assoc,
        ← pow_add, Nat.sub_add_cancel ha, natCast_pow_self_eq_zero, zero_mul]
    rw [this, map_zero]
  obtain ⟨y, hy⟩ := hJ (m - a) (Nat.sub_le m a) _ hkill
  rw [Nat.sub_sub_self ha] at hy
  refine ⟨LinearMap.toSpanSingleton _ _ ((u⁻¹ : (ZMod (p ^ m))ˣ) • y), fun x hx => ?_⟩
  obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.1 hx
  have hf : f ⟨t * g, hx⟩ = t • f ⟨g, hg⟩ := by
    rw [show (⟨t * g, hx⟩ : Ideal.span {g}) = t • ⟨g, hg⟩ from rfl, map_smul]
  rw [hf, ← hy, LinearMap.toSpanSingleton_apply, hgu, Units.smul_def, smul_smul,
    ← Nat.cast_smul_eq_nsmul (ZMod (p ^ m)), smul_smul, Nat.cast_pow]
  congr 1
  calc t * ((p : ZMod (p ^ m)) ^ a * u) * ↑u⁻¹ = t * (p : ZMod (p ^ m)) ^ a * (u * ↑u⁻¹) := by
        ring
    _ = t * (p : ZMod (p ^ m)) ^ a := by rw [Units.mul_inv, mul_one]

end Stacks.ZModPrimePower
