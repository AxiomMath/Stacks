module

public import Mathlib.RingTheory.FinitePresentation
public import StacksFrontier.Algebra.Module.FinitePresentation.Transport
public import StacksFrontier.AlgebraicGeometry.Stacks.Quasicoherent.BigSiteColimits.AffineCokernelDescent
public import StacksFrontier.RingTheory.Flat.FaithfullyFlat.Descent
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Finite presentation descends along a faithfully flat finite family of algebras

Let `A` be a commutative ring and let `A → Bᵢ`, for `i` in a finite index set, be algebras whose
product `∏ Bᵢ` is faithfully flat over `A`.  An `A`-module `M` whose base change to each `Bᵢ` is of
finite presentation over `Bᵢ` is of finite presentation over `A`.

This is the form in which faithfully flat descent of finite presentation is applied to a finite
covering family: no single member need be faithfully flat.  The base change along the product is
the product of the base changes, and a finite product of modules of finite presentation over the
factors of a product of rings is of finite presentation over the product, each factor being a
finite algebra of finite presentation over the product (a quotient by the ideal generated by an
idempotent).

## Main results

* `Module.FinitePresentation.pi_of_forall`: a finite product of modules of finite presentation over
  the factors of a product of rings is of finite presentation over the product.
* `Module.FinitePresentation.of_forall_bijective_liftBaseChange_pi`: the descent statement.

## References

* [Stacks Project, Tag 05B0](https://stacks.math.columbia.edu/tag/05B0)
-/

@[expose] public section

open TensorProduct

namespace Module.FinitePresentation

variable {ι : Type*} [Finite ι] (Bi : ι → Type*) [∀ i, CommRing (Bi i)]

omit [Finite ι] in
/-- The kernel of the projection of a product of rings onto a factor is generated by one
element, the complement of the idempotent of that factor. -/
theorem fg_ker_evalRingHom (i : ι) :
    (RingHom.ker (Pi.evalRingHom Bi i)).FG := by
  classical
  refine ⟨{1 - Pi.single i 1}, ?_⟩
  ext t
  simp only [Finset.coe_singleton, RingHom.mem_ker, Pi.evalRingHom_apply]
  refine ⟨fun ht => ?_, fun ht => ?_⟩
  · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.1 ht
    simp
  · refine Ideal.mem_span_singleton'.2 ⟨t, funext fun j => ?_⟩
    by_cases hj : j = i
    · subst hj
      simp [ht]
    · simp [hj]

/-- **A finite product of modules of finite presentation over the factors of a product of rings
is of finite presentation over the product.**  Each factor `Bᵢ` is a finite algebra of finite
presentation over `∏ Bᵢ`, so a module of finite presentation over `Bᵢ` is one over `∏ Bᵢ`
(`fp_iff_of_finite_fp_algebra`), and finite products of modules of finite presentation over one
ring are of finite presentation. -/
theorem pi_of_forall (Ni : ι → Type*) [∀ i, AddCommGroup (Ni i)] [∀ i, Module (Bi i) (Ni i)]
    [∀ i, Module.FinitePresentation (Bi i) (Ni i)] :
    letI : ∀ i, Module (∀ i, Bi i) (Ni i) := fun i => Module.compHom _ (Pi.evalRingHom Bi i)
    Module.FinitePresentation (∀ i, Bi i) (∀ i, Ni i) := by
  classical
  let : ∀ i, Module (∀ i, Bi i) (Ni i) := fun i => Module.compHom _ (Pi.evalRingHom Bi i)
  let : ∀ i, Algebra (∀ i, Bi i) (Bi i) := fun i => (Pi.evalRingHom Bi i).toAlgebra
  have : ∀ i, IsScalarTower (∀ i, Bi i) (Bi i) (Ni i) := fun i =>
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have hsurj : ∀ i, Function.Surjective (algebraMap (∀ i, Bi i) (Bi i)) := fun i b =>
    ⟨Pi.single i b, by simp [RingHom.algebraMap_toAlgebra]⟩
  have : ∀ i, Module.FinitePresentation (∀ i, Bi i) (Ni i) := fun i =>
    (fp_iff_of_finite_fp_algebra (∀ i, Bi i) (Bi i) (Ni i)
      (Module.Finite.of_surjective (Algebra.linearMap (∀ i, Bi i) (Bi i)) (hsurj i))
      (Algebra.FinitePresentation.of_surjective (f := Algebra.ofId (∀ i, Bi i) (Bi i))
        (hsurj i) (fg_ker_evalRingHom Bi i))).mpr inferInstance
  exact Module.FinitePresentation.pi (R := ∀ i, Bi i) Ni

/-- **Finite presentation descends along a faithfully flat finite family of algebras.**  If the
product of the `A`-algebras `Bᵢ` is faithfully flat over `A` and, for each `i`, `ρᵢ : M ⟶ Nᵢ`
exhibits the module `Nᵢ`, of finite presentation over `Bᵢ`, as the base change of `M`, then `M` is
of finite presentation over `A`. -/
@[ega "IV 2.5.3" "partial", sga "4½ Arcata 1.4.2" "more general"]
theorem of_forall_bijective_liftBaseChange_pi (A : Type*) [CommRing A] (M : Type*)
    [AddCommGroup M] [Module A M] [∀ i, Algebra A (Bi i)] [Module.FaithfullyFlat A (∀ i, Bi i)]
    (Ni : ι → Type*) [∀ i, AddCommGroup (Ni i)] [∀ i, Module A (Ni i)]
    [∀ i, Module (Bi i) (Ni i)] [∀ i, IsScalarTower A (Bi i) (Ni i)]
    [∀ i, Module.FinitePresentation (Bi i) (Ni i)] (ρ : ∀ i, M →ₗ[A] Ni i)
    (hρ : ∀ i, Function.Bijective ((ρ i).liftBaseChange (Bi i))) :
    Module.FinitePresentation A M := by
  classical
  let : ∀ i, Module (∀ i, Bi i) (Ni i) := fun i => Module.compHom _ (Pi.evalRingHom Bi i)
  have hfp := pi_of_forall Bi Ni
  have : IsScalarTower A (∀ i, Bi i) (∀ i, Ni i) := by
    refine ⟨fun a t n => funext fun i => ?_⟩
    change (a • t) i • n i = a • (t i • n i)
    rw [Pi.smul_apply, Algebra.smul_def, mul_smul, algebraMap_smul]
  let f : M →ₗ[A] ∀ i, Ni i := LinearMap.pi ρ
  obtain ⟨E, hE⟩ := Module.BaseChange.exists_piAddEquiv A M Bi Ni
    fun i => (LinearEquiv.ofBijective ((ρ i).liftBaseChange (Bi i)) (hρ i)).toAddEquiv
  have hfE : ∀ z, f.liftBaseChange (∀ i, Bi i) z = E z := by
    intro z
    induction z with
    | tmul b m =>
      refine funext fun i => ?_
      rw [LinearMap.liftBaseChange_tmul, hE]
      change b i • ρ i m = (ρ i).liftBaseChange (Bi i) (b i ⊗ₜ[A] m)
      rw [LinearMap.liftBaseChange_tmul]
    | add z z' hz hz' => rw [map_add, map_add, hz, hz']
  have hbij : Function.Bijective (f.liftBaseChange (∀ i, Bi i)) := by
    have : (f.liftBaseChange (∀ i, Bi i) : _ → _) = E := funext hfE
    rw [this]
    exact E.bijective
  have hbc : IsBaseChange (∀ i, Bi i) f :=
    IsBaseChange.of_equiv (LinearEquiv.ofBijective _ hbij) fun m => by
      change f.liftBaseChange (∀ i, Bi i) (1 ⊗ₜ m) = f m
      rw [LinearMap.liftBaseChange_tmul, one_smul]
  exact Module.FinitePresentation.of_isBaseChange_of_faithfullyFlat f hbc

end Module.FinitePresentation
