/-!
# Free differential graded algebras on graded generators

This file begins the construction of K-flat free graded resolutions of differential graded
algebras over a commutative ring: free graded algebras on homogeneous generators in arbitrary
integer degrees, the free differential graded algebras they carry, and the maps out of them.

## Main definitions

* `Stacks.DGA.IsFreeGradedAlgebra` says that a graded algebra is freely generated by
  homogeneous elements, in arbitrary integer degrees.
* `Stacks.DGA.IsDGAMorphism` says that an algebra map preserves the grading and commutes with
  the differential.

## Implementation notes

The free graded algebra is described by a graded set of generators and an algebra
equivalence with the ordinary free algebra. Its degree-`n` part is the span of words
whose generator degrees sum to `n`; thus the equivalence preserves the entire grading.
The free differential graded algebra on a graded alphabet is built on the monoid algebra of
words, with the differential determined by its values on the generators through the Leibniz
rule; maps of alphabets induce maps of these algebras.

## References

* [Stacks Project, Tag 0BZ7](https://stacks.math.columbia.edu/tag/0BZ7)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits


universe u v

namespace Stacks.DGA

variable {R : Type u} [CommRing R]

/-- The product of the letters of a word in the free associative algebra. -/
public def word {S : Type v} (w : List S) : FreeAlgebra R S :=
  w.foldl (fun a s => a * FreeAlgebra.ι R s) 1

private theorem word_append {S : Type v} (u w : List S) :
    word (R := R) (u ++ w) = word u * word w := by
  let f : FreeAlgebra R S → S → FreeAlgebra R S :=
    fun a s => a * FreeAlgebra.ι R s
  have hfold : ∀ (a : FreeAlgebra R S) (w : List S),
      w.foldl f a = a * w.foldl f 1 := by
    intro a w
    induction w generalizing a with
    | nil => simp [f]
    | cons s w ih =>
      simp only [List.foldl_cons]
      rw [ih (a * FreeAlgebra.ι R s), ih (1 * FreeAlgebra.ι R s)]
      simp [f, mul_assoc]
  change (u ++ w).foldl f 1 = u.foldl f 1 * w.foldl f 1
  rw [List.foldl_append, hfold]

private theorem map_word {S : Type v} {T : Type*} [Ring T] [Algebra R T]
    (f : FreeAlgebra R S →ₐ[R] T) (w : List S) :
    f (word w) = w.foldl (fun a s => a * f (FreeAlgebra.ι R s)) 1 := by
  have hfold : ∀ (a : FreeAlgebra R S) (w : List S),
      f (w.foldl (fun a s => a * FreeAlgebra.ι R s) a) =
        w.foldl (fun a s => a * f (FreeAlgebra.ι R s)) (f a) := by
    intro a w
    induction w generalizing a with
    | nil => rfl
    | cons s w ih =>
        simp only [List.foldl_cons]
        calc
          f ((w.foldl (fun a s => a * FreeAlgebra.ι R s)
              (a * FreeAlgebra.ι R s))) =
              w.foldl (fun a s => a * f (FreeAlgebra.ι R s))
                (f (a * FreeAlgebra.ι R s)) := ih (a * FreeAlgebra.ι R s)
          _ = w.foldl (fun a s => a * f (FreeAlgebra.ι R s))
                (f a * f (FreeAlgebra.ι R s)) :=
              congrArg (fun x => w.foldl (fun a s => a * f (FreeAlgebra.ι R s)) x)
                (map_mul f a (FreeAlgebra.ι R s))
  simpa [word] using hfold 1 w

/-- A graded algebra is free on a graded set if it is the free associative algebra
on homogeneous generators and every homogeneous component is spanned by the words
of that degree. -/
public def IsFreeGradedAlgebra (A : DifferentialGradedAlgebra.{u, v} R) : Prop :=
  ∃ (S : Type v) (degree : S → ℤ) (e : FreeAlgebra R S ≃ₐ[R] A.A),
    ∀ n : ℤ, A.grading n = Submodule.span R
      {a : A.A | ∃ w : List S, (w.map degree).sum = n ∧ e (word w) = a}

/-- A morphism of differential graded algebras preserves the grading and commutes
with the differential. -/
public def IsDGAMorphism
    (A B : DifferentialGradedAlgebra.{u, max u v} R)
    (f : A.A →ₐ[R] B.A) : Prop :=
  (∀ (n : ℤ) (a : A.A), a ∈ A.grading n → f a ∈ B.grading n) ∧
    (∀ a : A.A, f (A.d a) = B.d (f a))

private noncomputable def freeAlgebraWordBasis {S : Type v} :
    Module.Basis (FreeMonoid S) R (FreeAlgebra R S) :=
  (MonoidAlgebra.basis (FreeMonoid S) R).map
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := R) (X := S)).symm.toLinearEquiv

private theorem freeAlgebraWordBasis_apply {S : Type v} (w : List S) :
    freeAlgebraWordBasis (R := R) (S := S) (FreeMonoid.ofList w) = word w := by
  let e := FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := R) (X := S)
  have h1 : e (freeAlgebraWordBasis (R := R) (S := S) (FreeMonoid.ofList w)) =
      MonoidAlgebra.single (FreeMonoid.ofList w) 1 := by
    simp [freeAlgebraWordBasis, e, Module.Basis.map_apply, MonoidAlgebra.basis_apply]
  have hf : ∀ a (w : List S),
      e (w.foldl (fun a s => a * FreeAlgebra.ι R s) a) =
        w.foldl (fun a s => a * MonoidAlgebra.single (FreeMonoid.of s) 1) (e a) := by
    intro a w
    induction w generalizing a with
    | nil => rfl
    | cons s w ih =>
      simp only [List.foldl_cons]
      rw [ih]
      simp [e, FreeAlgebra.equivMonoidAlgebraFreeMonoid, FreeAlgebra.lift_ι_apply]
  have hfold : ∀ (a : MonoidAlgebra R (FreeMonoid S)) (w : List S),
      w.foldl (fun a s => a * MonoidAlgebra.single (FreeMonoid.of s) (1 : R)) a =
        a * w.foldl (fun a s => a * MonoidAlgebra.single (FreeMonoid.of s) (1 : R)) 1 := by
    intro a w
    induction w generalizing a with
    | nil => simp
    | cons s w ih =>
      simp only [List.foldl_cons]
      rw [ih (a * MonoidAlgebra.single (FreeMonoid.of s) 1),
        ih (1 * MonoidAlgebra.single (FreeMonoid.of s) 1)]
      simp [mul_assoc]
  have hs : ∀ w : List S,
      w.foldl (fun a s => a * MonoidAlgebra.single (FreeMonoid.of s) (1 : R)) 1 =
        MonoidAlgebra.single (FreeMonoid.ofList w) 1 := by
    intro w
    induction w with
    | nil => simp only [List.foldl, FreeMonoid.ofList_nil]; rfl
    | cons s w ih =>
      simp only [List.foldl_cons]
      rw [hfold, ih]
      simp [FreeMonoid.ofList_cons]
  have h2 : e (word w) = MonoidAlgebra.single (FreeMonoid.ofList w) 1 := by
    calc
      e (word w) =
          w.foldl (fun a s => a * MonoidAlgebra.single (FreeMonoid.of s) (1 : R)) (e 1) := hf 1 w
      _ = MonoidAlgebra.single (FreeMonoid.ofList w) 1 := by rw [map_one, hs]
  exact e.injective (h1.trans h2.symm)

/-! The first stage of the free graded resolution uses the additive presentation
of the monoid algebra on words. -/

private def freeWordDegree {S : Type v} (degree : S → ℤ) :
    Additive (FreeMonoid S) →+ ℤ where
  toFun w := ((FreeMonoid.toList w.toMul).map degree).sum
  map_zero' := rfl
  map_add' := by
    intro x y
    change ((FreeMonoid.toList (x.toMul * y.toMul)).map degree).sum =
      ((FreeMonoid.toList x.toMul).map degree).sum +
        ((FreeMonoid.toList y.toMul).map degree).sum
    simp only [FreeMonoid.toList_mul, List.map_append, List.sum_append]

private noncomputable def freeAlgebraWordEquiv {S : Type v} :
    FreeAlgebra R S ≃ₐ[R] AddMonoidAlgebra R (Additive (FreeMonoid S)) :=
  (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := R) (X := S)).trans
    (MonoidAlgebra.toAdditiveAlgEquiv R R (FreeMonoid S))

private theorem freeAlgebraWordEquiv_word {S : Type v} (w : List S) :
    freeAlgebraWordEquiv (R := R) (S := S) (word w) =
      AddMonoidAlgebra.single (Additive.ofMul (FreeMonoid.ofList w)) 1 := by
  let e := FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := R) (X := S)
  have h : e (word w) = MonoidAlgebra.single (FreeMonoid.ofList w) 1 := by
    rw [← freeAlgebraWordBasis_apply (R := R) w]
    simp [freeAlgebraWordBasis, e, Module.Basis.map_apply, MonoidAlgebra.basis_apply]
  change (MonoidAlgebra.toAdditiveAlgEquiv R R (FreeMonoid S)) (e (word w)) = _
  rw [h, MonoidAlgebra.toAdditiveAlgEquiv_single]

private noncomputable def monoidWord {S : Type v} (w : List S) :
    AddMonoidAlgebra R (Additive (FreeMonoid S)) :=
  AddMonoidAlgebra.single (Additive.ofMul (FreeMonoid.ofList w)) 1

/-- The inverse of `freeAlgebraWordEquiv` sends the word basis element back to the word. -/
private theorem freeAlgebraWordEquiv_symm_monoidWord {S : Type v} (w : List S) :
    (freeAlgebraWordEquiv (R := R) (S := S)).symm (monoidWord w) = word w :=
  (AlgEquiv.symm_apply_eq _).2 (freeAlgebraWordEquiv_word w).symm

private theorem monoidWord_append {S : Type v} (w w' : List S) :
    monoidWord (R := R) (w ++ w') = monoidWord w * monoidWord w' := by
  simp [monoidWord, FreeMonoid.ofList_append, AddMonoidAlgebra.single_mul_single]

private theorem monoidWord_cons {S : Type v} (s : S) (w : List S) :
    monoidWord (R := R) (s :: w) = monoidWord [s] * monoidWord w := by
  simpa only [List.singleton_append] using monoidWord_append (R := R) [s] w

/-- The signed Leibniz differential of a word, specified by the values on letters. -/
private noncomputable def monoidWordDifferential {S : Type v} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S))) :
    List S → AddMonoidAlgebra R (Additive (FreeMonoid S))
  | [] => 0
  | s :: w => δ s * monoidWord w +
      ((degree s).negOnePow : ℤ) •
        (monoidWord [s] * monoidWordDifferential degree δ w)

private noncomputable def freeWordDifferentialLinear {S : Type v}
    (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S))) :
    AddMonoidAlgebra R (Additive (FreeMonoid S)) →ₗ[R]
      AddMonoidAlgebra R (Additive (FreeMonoid S)) :=
  (AddMonoidAlgebra.basis (Additive (FreeMonoid S)) R).constr R
    (fun m => monoidWordDifferential degree δ (FreeMonoid.toList m.toMul))

private theorem freeWordDifferentialLinear_monoidWord {S : Type v}
    (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S))) (w : List S) :
    freeWordDifferentialLinear degree δ (monoidWord w) =
      monoidWordDifferential degree δ w := by
  unfold freeWordDifferentialLinear
  simpa only [monoidWord, AddMonoidAlgebra.basis_apply,
    FreeMonoid.toList_ofList, toMul_ofMul] using
    (AddMonoidAlgebra.basis (Additive (FreeMonoid S)) R).constr_basis R
      (fun m => monoidWordDifferential degree δ (FreeMonoid.toList m.toMul))
      (Additive.ofMul (FreeMonoid.ofList w))

private theorem monoidWordDifferential_append {S : Type v}
    (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (w w' : List S) :
    monoidWordDifferential degree δ (w ++ w') =
      monoidWordDifferential degree δ w * monoidWord w' +
        (((w.map degree).sum).negOnePow : ℤ) •
          (monoidWord w * monoidWordDifferential degree δ w') := by
  induction w with
  | nil =>
      simp only [List.nil_append, monoidWordDifferential, monoidWord, zero_mul, List.map_nil,
        List.sum_nil, Int.negOnePow_zero, Units.val_one, FreeMonoid.ofList_nil, ofMul_one, one_smul,
        zero_add]
      rw [← AddMonoidAlgebra.one_def, one_mul]
  | cons s w ih =>
      simp only [List.cons_append, monoidWordDifferential, List.map_cons, List.sum_cons,
        monoidWord_append, ih]
      rw [Int.negOnePow_add]
      simp only [smul_add, mul_add, add_mul, smul_mul_assoc,
        mul_smul_comm, mul_assoc]
      rw [monoidWord_cons s w]
      simp only [Units.val_mul, mul_smul, mul_assoc]
      abel

private theorem freeWordDifferentialLinear_leibniz_words {S : Type v}
    (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (w w' : List S) :
    freeWordDifferentialLinear degree δ (monoidWord w * monoidWord w') =
      freeWordDifferentialLinear degree δ (monoidWord w) * monoidWord w' +
        (((w.map degree).sum).negOnePow : ℤ) •
          (monoidWord w * freeWordDifferentialLinear degree δ (monoidWord w')) := by
  rw [← monoidWord_append, freeWordDifferentialLinear_monoidWord,
    freeWordDifferentialLinear_monoidWord,
    freeWordDifferentialLinear_monoidWord]
  exact monoidWordDifferential_append degree δ w w'

private theorem monoidWord_mem_grade {S : Type v}
    (degree : S → ℤ) (w : List S) :
    monoidWord (R := R) w ∈
      AddMonoidAlgebra.gradeBy R (freeWordDegree degree) ((w.map degree).sum) :=
  AddMonoidAlgebra.single_mem_gradeBy (freeWordDegree degree)
    (Additive.ofMul (FreeMonoid.ofList w)) (1 : R)

private theorem monoidWordDifferential_mem_grade {S : Type v}
    (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1)) (w : List S) :
    monoidWordDifferential degree δ w ∈
      AddMonoidAlgebra.gradeBy R (freeWordDegree degree) ((w.map degree).sum + 1) := by
  induction w with
  | nil => exact (AddMonoidAlgebra.gradeBy R (freeWordDegree degree) _).zero_mem
  | cons s w ih =>
      have hidx : (List.map degree (s :: w)).sum + 1 =
          degree s + 1 + (List.map degree w).sum := by
        simp only [List.map_cons, List.sum_cons]
        ring
      have hidx' : (List.map degree (s :: w)).sum + 1 =
          (List.map degree [s]).sum + ((List.map degree w).sum + 1) := by
        simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
        ring
      change δ s * monoidWord w +
        ((degree s).negOnePow : ℤ) •
          (monoidWord [s] * monoidWordDifferential degree δ w) ∈ _
      refine Submodule.add_mem _ ?_ ?_
      · rw [hidx]
        exact SetLike.mul_mem_graded (hδ s) (monoidWord_mem_grade (R := R) degree w)
      · rw [hidx']
        apply (AddMonoidAlgebra.gradeBy R (freeWordDegree degree) _).toAddSubgroup.zsmul_mem
        exact SetLike.mul_mem_graded (monoidWord_mem_grade (R := R) degree [s]) ih

private theorem monoidWordDifferential_zero {S : Type v}
    (degree : S → ℤ) (w : List S) :
    monoidWordDifferential (R := R) degree (fun _ => 0) w = 0 := by
  induction w with
  | nil => rfl
  | cons s w ih => simp [monoidWordDifferential, ih]

private noncomputable def freeZeroDGA {S : Type (max u v)} (degree : S → ℤ) :
    DifferentialGradedAlgebra.{u, max u v} R where
  A := AddMonoidAlgebra R (Additive (FreeMonoid S))
  grading := AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
  gradedAlg := AddMonoidAlgebra.gradeBy.gradedAlgebra (freeWordDegree degree)
  d := 0
  d_comp_d := by simp
  d_mem _ _ _ := by simp
  leibniz _ _ _ _ _ _ := by simp

private theorem freeZeroDGA_grading_eq_span
    {S : Type (max u v)} (degree : S → ℤ) (n : ℤ) :
    (freeZeroDGA (R := R) degree).grading n = Submodule.span R
      {a : (freeZeroDGA (R := R) degree).A |
        ∃ w : List S, (w.map degree).sum = n ∧
          freeAlgebraWordEquiv (R := R) (S := S) (word w) = a} := by
  classical
  dsimp only [freeZeroDGA]
  let f := freeWordDegree degree
  let s : Set (Additive (FreeMonoid S)) := {m | f m = n}
  have hset :
      {a : AddMonoidAlgebra R (Additive (FreeMonoid S)) |
        ∃ w : List S, (w.map degree).sum = n ∧
          freeAlgebraWordEquiv (R := R) (S := S) (word w) = a} =
      (fun m => AddMonoidAlgebra.single m (1 : R)) '' s := by
    ext a
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ⟨Additive.ofMul (FreeMonoid.ofList w), hw,
        (freeAlgebraWordEquiv_word (R := R) w).symm⟩
    · rintro ⟨m, hm, rfl⟩
      refine ⟨FreeMonoid.toList m.toMul, hm, ?_⟩
      simpa only [FreeMonoid.ofList_toList, ofMul_toMul] using
        freeAlgebraWordEquiv_word (R := R) (FreeMonoid.toList m.toMul)
  change AddMonoidAlgebra.gradeBy R f n = _
  rw [hset]
  change AddMonoidAlgebra.supported R R s =
    Submodule.span R ((fun m => AddMonoidAlgebra.single m (1 : R)) '' s)
  exact AddMonoidAlgebra.supported_eq_span_single R s

/-- A linear map out of the graded word algebra sends degree `n` into `P` if it does so on
the words of degree `n`. -/
private theorem map_mem_of_monoidWord_mem {S : Type (max u v)} {M : Type*} [AddCommMonoid M]
    [Module R M] (degree : S → ℤ) (P : Submodule R M)
    (f : AddMonoidAlgebra R (Additive (FreeMonoid S)) →ₗ[R] M) (n : ℤ)
    (h : ∀ w : List S, (w.map degree).sum = n → f (monoidWord w) ∈ P)
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (ha : a ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree) n) : f a ∈ P := by
  have hle : Submodule.span R
      {a : AddMonoidAlgebra R (Additive (FreeMonoid S)) |
        ∃ w : List S, (w.map degree).sum = n ∧
          freeAlgebraWordEquiv (R := R) (S := S) (word w) = a} ≤ P.comap f := by
    apply Submodule.span_le.mpr
    rintro a ⟨w, hw, rfl⟩
    rw [freeAlgebraWordEquiv_word]
    exact h w hw
  exact hle ((freeZeroDGA_grading_eq_span (R := R) degree n).symm ▸ ha)

private theorem freeWordDifferentialLinear_mem_grade
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1)) (n : ℤ)
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (ha : a ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree) n) :
    freeWordDifferentialLinear degree δ a ∈
      AddMonoidAlgebra.gradeBy R (freeWordDegree degree) (n + 1) := by
  refine map_mem_of_monoidWord_mem degree _ _ n (fun w hw => ?_) a ha
  rw [freeWordDifferentialLinear_monoidWord]
  exact hw ▸ monoidWordDifferential_mem_grade degree δ hδ w

private theorem monoidWord_span_eq_top {S : Type (max u v)} :
    Submodule.span R (Set.range (monoidWord (R := R) (S := S))) = ⊤ := by
  classical
  have hs : Set.range (monoidWord (R := R) (S := S)) =
      Set.range (AddMonoidAlgebra.basis (Additive (FreeMonoid S)) R) := by
    ext a
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨Additive.ofMul (FreeMonoid.ofList w), by
        simp [monoidWord, AddMonoidAlgebra.basis_apply]⟩
    · rintro ⟨m, rfl⟩
      exact ⟨FreeMonoid.toList m.toMul, by
        simp [monoidWord, AddMonoidAlgebra.basis_apply]⟩
  rw [hs]
  exact (AddMonoidAlgebra.basis (Additive (FreeMonoid S)) R).span_eq

/-- Linear maps out of the word algebra are determined by their values on words. -/
private theorem monoidWord_linearMap_ext {S : Type (max u v)} {M : Type*} [AddCommMonoid M]
    [Module R M] {f g : AddMonoidAlgebra R (Additive (FreeMonoid S)) →ₗ[R] M}
    (h : ∀ w : List S, f (monoidWord w) = g (monoidWord w)) : f = g := by
  classical
  apply LinearMap.ext_on (s := Set.range (monoidWord (R := R) (S := S)))
  · rw [monoidWord_span_eq_top]
  rintro _ ⟨w, rfl⟩
  exact h w

private theorem freeWordDifferentialLinear_zero {S : Type (max u v)}
    (degree : S → ℤ) :
    freeWordDifferentialLinear (R := R) degree (fun _ => 0) = 0 := by
  refine monoidWord_linearMap_ext fun w => ?_
  rw [freeWordDifferentialLinear_monoidWord, monoidWordDifferential_zero]
  rfl

private theorem freeWordDifferentialLinear_leibniz
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (n : ℤ) (a b : AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (ha : a ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree) n) :
    freeWordDifferentialLinear degree δ (a * b) =
      freeWordDifferentialLinear degree δ a * b +
        (n.negOnePow : ℤ) • (a * freeWordDifferentialLinear degree δ b) := by
  classical
  let D := freeWordDifferentialLinear degree δ
  have hspan : ∀ x, x ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree) n ↔
      x ∈ Submodule.span R
        {a : AddMonoidAlgebra R (Additive (FreeMonoid S)) |
          ∃ w : List S, (w.map degree).sum = n ∧
            freeAlgebraWordEquiv (R := R) (S := S) (word w) = a} :=
    fun x => SetLike.ext_iff.mp (freeZeroDGA_grading_eq_span (R := R) degree n) x
  have ha' := (hspan a).1 ha
  induction ha' using Submodule.span_induction with
  | mem a h =>
      obtain ⟨w, hw, rfl⟩ := h
      rw [freeAlgebraWordEquiv_word]
      have hb : b ∈ Submodule.span R (Set.range (monoidWord (R := R) (S := S))) := by
        rw [monoidWord_span_eq_top]
        trivial
      induction hb using Submodule.span_induction with
      | mem b h =>
          obtain ⟨w', rfl⟩ := h
          change D (monoidWord w * monoidWord w') =
            D (monoidWord w) * monoidWord w' +
              (n.negOnePow : ℤ) • (monoidWord w * D (monoidWord w'))
          rw [← hw]
          exact freeWordDifferentialLinear_leibniz_words degree δ w w'
      | zero => simp
      | add x y hx hy ihx ihy =>
          simp only [mul_add, map_add, smul_add] at *
          rw [ihx, ihy]
          abel
      | smul r x hx ih =>
          simp only [mul_smul_comm, map_smul]
          rw [ih, smul_add, smul_comm]
  | zero => simp
  | add x y hx hy ihx ihy =>
      simp only [add_mul, map_add, smul_add]
      rw [ihx ((hspan x).2 hx), ihy ((hspan y).2 hy)]
      abel
  | smul r x hx ih =>
      simp only [smul_mul_assoc, map_smul]
      rw [ih ((hspan x).2 hx), smul_add, smul_comm]

private theorem freeWordDifferentialLinear_square_zero_word
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1))
    (hδcycle : ∀ s, freeWordDifferentialLinear degree δ (δ s) = 0)
    (w : List S) :
    freeWordDifferentialLinear degree δ
      (freeWordDifferentialLinear degree δ (monoidWord w)) = 0 := by
  let D := freeWordDifferentialLinear degree δ
  induction w with
  | nil =>
      change D (D (monoidWord [])) = 0
      rw [freeWordDifferentialLinear_monoidWord]
      simp [monoidWordDifferential]
  | cons s w ih =>
      have hs : D (monoidWord [s]) = δ s := by
        rw [freeWordDifferentialLinear_monoidWord]
        simp only [monoidWordDifferential, mul_zero, smul_zero, add_zero]
        change δ s * AddMonoidAlgebra.single 0 1 = δ s
        rw [← AddMonoidAlgebra.one_def, mul_one]
      have hδLeib := freeWordDifferentialLinear_leibniz degree δ
        (degree s + 1) (δ s) (monoidWord w) (hδ s)
      have hsLeib := freeWordDifferentialLinear_leibniz degree δ
        (degree s) (monoidWord [s]) (monoidWordDifferential degree δ w)
        (by
          convert monoidWord_mem_grade (R := R) degree [s] using 1
          simp)
      change D (D (monoidWord (s :: w))) = 0
      rw [freeWordDifferentialLinear_monoidWord]
      unfold monoidWordDifferential
      rw [map_add, map_zsmul, hδLeib, hsLeib, hδcycle, hs]
      have hw : D (monoidWordDifferential degree δ w) = 0 := by
        rw [← freeWordDifferentialLinear_monoidWord]
        exact ih
      rw [freeWordDifferentialLinear_monoidWord, hw]
      simp only [zero_mul, zero_add, mul_zero, smul_zero, add_zero,
        Int.negOnePow_succ, Units.val_neg, neg_smul]
      abel

private theorem freeWordDifferentialLinear_square_zero
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1))
    (hδcycle : ∀ s, freeWordDifferentialLinear degree δ (δ s) = 0) :
    (freeWordDifferentialLinear degree δ) ∘ₗ
      (freeWordDifferentialLinear degree δ) = 0 := by
  exact monoidWord_linearMap_ext fun w =>
    freeWordDifferentialLinear_square_zero_word degree δ hδ hδcycle w

private noncomputable def freeDGA {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1))
    (hδcycle : ∀ s, freeWordDifferentialLinear degree δ (δ s) = 0) :
    DifferentialGradedAlgebra.{u, max u v} R where
  A := AddMonoidAlgebra R (Additive (FreeMonoid S))
  grading := AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
  gradedAlg := AddMonoidAlgebra.gradeBy.gradedAlgebra (freeWordDegree degree)
  d := freeWordDifferentialLinear degree δ
  d_comp_d := freeWordDifferentialLinear_square_zero degree δ hδ hδcycle
  d_mem := freeWordDifferentialLinear_mem_grade degree δ hδ
  leibniz := fun n _ a b ha _ => freeWordDifferentialLinear_leibniz degree δ n a b ha

private noncomputable def freeZeroDGA_map
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (_degree : S → ℤ) (b : S → B.A) :
    AddMonoidAlgebra R (Additive (FreeMonoid S)) →ₐ[R] B.A :=
  (FreeAlgebra.lift R b).comp
    (freeAlgebraWordEquiv (R := R) (S := S)).symm.toAlgHom

private theorem d_one (B : DifferentialGradedAlgebra.{u, max u v} R) :
    B.d 1 = 0 := by
  have h : B.d 1 = B.d 1 + B.d 1 := by
    simpa using B.leibniz 0 0 1 1
      (SetLike.one_mem_graded B.grading) (SetLike.one_mem_graded B.grading)
  have h' : B.d 1 + 0 = B.d 1 + B.d 1 := by simpa using h
  exact (add_left_cancel h').symm

private theorem freeZeroDGA_map_word
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ) (b : S → B.A) (w : List S) :
    freeZeroDGA_map B degree b (monoidWord w) = (FreeAlgebra.lift R b) (word w) := by
  change (FreeAlgebra.lift R b) ((freeAlgebraWordEquiv (R := R) (S := S)).symm (monoidWord w)) = _
  rw [freeAlgebraWordEquiv_symm_monoidWord]

private theorem freeZeroDGA_map_letter
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ) (b : S → B.A) (s : S) :
    freeZeroDGA_map B degree b (monoidWord [s]) = b s := by
  rw [freeZeroDGA_map_word]
  simp [word]

private theorem freeAlgebra_lift_word_mem_grade
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ) (b : S → B.A)
    (hb : ∀ s, b s ∈ B.grading (degree s)) (w : List S) :
    (FreeAlgebra.lift R b) (word w) ∈ B.grading ((w.map degree).sum) := by
  induction w using List.reverseRecOn with
  | nil =>
      simpa only [word, List.foldl_nil, map_one, List.map_nil, List.sum_nil] using
        (SetLike.one_mem_graded B.grading)
  | @append_singleton w s ih =>
      have hword : (FreeAlgebra.lift R b) (word (w ++ [s])) =
          (FreeAlgebra.lift R b) (word w) * b s := by
        rw [word_append]
        simp [word]
      rw [hword]
      simpa only [List.map_append, List.map_singleton, List.sum_append,
        List.sum_singleton] using SetLike.mul_mem_graded ih (hb s)

private theorem freeWord_map_mem_grade
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ) (b : S → B.A)
    (hb : ∀ s, b s ∈ B.grading (degree s)) (n : ℤ)
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (ha : a ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree) n) :
    freeZeroDGA_map B degree b a ∈ B.grading n := by
  refine map_mem_of_monoidWord_mem degree _ (freeZeroDGA_map B degree b).toLinearMap n
    (fun w hw => ?_) a ha
  change freeZeroDGA_map B degree b (monoidWord w) ∈ B.grading n
  rw [freeZeroDGA_map_word]
  exact hw ▸ freeAlgebra_lift_word_mem_grade B degree b hb w

private theorem freeWord_map_commutes_d_word
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (b : S → B.A) (hb : ∀ s, b s ∈ B.grading (degree s))
    (hdb : ∀ s, freeZeroDGA_map B degree b (δ s) = B.d (b s))
    (w : List S) :
    freeZeroDGA_map B degree b
      (freeWordDifferentialLinear degree δ (monoidWord w)) =
      B.d (freeZeroDGA_map B degree b (monoidWord w)) := by
  let f := freeZeroDGA_map B degree b
  let D := freeWordDifferentialLinear degree δ
  have hfLetter (s : S) : f (monoidWord [s]) = b s := freeZeroDGA_map_letter B degree b s
  induction w with
  | nil =>
      change f (D (monoidWord [])) = B.d (f (monoidWord []))
      rw [freeWordDifferentialLinear_monoidWord]
      change f 0 = B.d (f (AddMonoidAlgebra.single 0 1))
      rw [← AddMonoidAlgebra.one_def, map_zero, map_one, d_one]
  | cons s w ih =>
      have hw : f (monoidWord w) ∈ B.grading ((w.map degree).sum) :=
        freeWord_map_mem_grade B degree b hb _ _
          (monoidWord_mem_grade (R := R) degree w)
      calc
        f (D (monoidWord (s :: w))) =
            f (δ s) * f (monoidWord w) +
              ((degree s).negOnePow : ℤ) •
                (f (monoidWord [s]) * f (D (monoidWord w))) := by
          rw [freeWordDifferentialLinear_monoidWord]
          unfold monoidWordDifferential
          rw [map_add, map_zsmul, map_mul, map_mul, freeWordDifferentialLinear_monoidWord]
        _ = B.d (b s) * f (monoidWord w) +
              ((degree s).negOnePow : ℤ) • (b s * B.d (f (monoidWord w))) := by
          rw [hdb s, hfLetter s, ih]
        _ = B.d (f (monoidWord (s :: w))) := by
          rw [monoidWord_cons s w, map_mul, hfLetter,
            B.leibniz (degree s) ((w.map degree).sum) (b s)
              (f (monoidWord w)) (hb s) hw]

private theorem freeWord_map_commutes_d
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (b : S → B.A) (hb : ∀ s, b s ∈ B.grading (degree s))
    (hdb : ∀ s, freeZeroDGA_map B degree b (δ s) = B.d (b s))
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S))) :
    freeZeroDGA_map B degree b (freeWordDifferentialLinear degree δ a) =
      B.d (freeZeroDGA_map B degree b a) := by
  exact LinearMap.congr_fun (f := (freeZeroDGA_map B degree b).toLinearMap ∘ₗ
      freeWordDifferentialLinear degree δ) (g := B.d ∘ₗ (freeZeroDGA_map B degree b).toLinearMap)
    (monoidWord_linearMap_ext fun w => freeWord_map_commutes_d_word B degree δ b hb hdb w) a

private theorem freeDGA_map_isDGAMorphism
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S : Type (max u v)} (degree : S → ℤ)
    (δ : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (hδ : ∀ s, δ s ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degree)
      (degree s + 1))
    (hδcycle : ∀ s, freeWordDifferentialLinear degree δ (δ s) = 0)
    (b : S → B.A) (hb : ∀ s, b s ∈ B.grading (degree s))
    (hdb : ∀ s, freeZeroDGA_map B degree b (δ s) = B.d (b s)) :
    IsDGAMorphism (freeDGA (R := R) degree δ hδ hδcycle) B
      (freeZeroDGA_map B degree b) :=
  ⟨freeWord_map_mem_grade B degree b hb, freeWord_map_commutes_d B degree δ b hb hdb⟩

private noncomputable def freeWordMap {S T : Type (max u v)} (α : S → T) :
    AddMonoidAlgebra R (Additive (FreeMonoid S)) →ₐ[R]
      AddMonoidAlgebra R (Additive (FreeMonoid T)) :=
  (FreeAlgebra.lift R (fun s => monoidWord (R := R) [α s])).comp
    (freeAlgebraWordEquiv (R := R) (S := S)).symm.toAlgHom

private theorem freeWordMap_monoidWord {S T : Type (max u v)}
    (α : S → T) (w : List S) :
    freeWordMap (R := R) α (monoidWord w) = monoidWord (w.map α) := by
  change (FreeAlgebra.lift R (fun s => monoidWord (R := R) [α s]))
    ((freeAlgebraWordEquiv (R := R) (S := S)).symm (monoidWord w)) = _
  rw [freeAlgebraWordEquiv_symm_monoidWord]
  induction w using List.reverseRecOn with
  | nil =>
      simp [word, monoidWord, ← AddMonoidAlgebra.one_def]
  | @append_singleton w s ih =>
      rw [word_append, map_mul, ih, List.map_append, monoidWord_append]
      simp [word]

/-- Renaming free generators injectively gives an injective map of free algebras. -/
private theorem freeWordMap_injective {S T : Type (max u v)}
    (α : S → T) (hα : Function.Injective α) :
    Function.Injective (freeWordMap (R := R) α) := by
  let α' : Additive (FreeMonoid S) → Additive (FreeMonoid T) :=
    fun w => Additive.ofMul (FreeMonoid.map α w.toMul)
  have hα' : Function.Injective α' := by
    intro w w' h
    change w.toMul = w'.toMul
    apply FreeMonoid.toList.injective
    have hh := congrArg
      (fun z : Additive (FreeMonoid T) => FreeMonoid.toList z.toMul) h
    exact (List.map_injective_iff.mpr hα) hh
  have hmap : ∀ a : AddMonoidAlgebra R (Additive (FreeMonoid S)),
      freeWordMap (R := R) α a = AddMonoidAlgebra.mapDomain α' a := by
    intro a
    have ha : a ∈ Submodule.span R (Set.range (monoidWord (R := R) (S := S))) := by
      rw [monoidWord_span_eq_top]
      trivial
    induction ha using Submodule.span_induction with
    | mem a h =>
        obtain ⟨w, rfl⟩ := h
        rw [freeWordMap_monoidWord]
        simp [monoidWord, α', FreeMonoid.ofList_map]
    | zero => simp
    | add a b ha hb iha ihb =>
        simpa only [map_add, AddMonoidAlgebra.mapDomain_add] using congrArg₂ (· + ·) iha ihb
    | smul r a ha iha =>
        rw [map_smul, iha]
        simp [AddMonoidAlgebra.mapDomain, Finsupp.mapDomain_smul]
  intro a b hab
  apply (AddMonoidAlgebra.mapDomain_injective (R := R) hα')
  simpa only [← hmap] using hab

private theorem freeWordMap_mem_grade {S T : Type (max u v)}
    (α : S → T) (degreeS : S → ℤ) (degreeT : T → ℤ)
    (hdegree : ∀ s, degreeT (α s) = degreeS s) (n : ℤ)
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (ha : a ∈ AddMonoidAlgebra.gradeBy R (freeWordDegree degreeS) n) :
    freeWordMap (R := R) α a ∈
      AddMonoidAlgebra.gradeBy R (freeWordDegree degreeT) n := by
  let D := freeZeroDGA (R := R) degreeT
  have hb : ∀ s : S, monoidWord (R := R) [α s] ∈ D.grading (degreeS s) := by
    intro s
    change monoidWord [α s] ∈
      AddMonoidAlgebra.gradeBy R (freeWordDegree degreeT) (degreeS s)
    convert monoidWord_mem_grade (R := R) degreeT [α s] using 1
    simp [hdegree]
  change freeZeroDGA_map D degreeS
    (fun s => monoidWord (R := R) [α s]) a ∈ D.grading n
  exact freeWord_map_mem_grade D degreeS
    (fun s => monoidWord (R := R) [α s]) hb n a ha

private theorem freeZeroDGA_map_comp_freeWordMap
    (B : DifferentialGradedAlgebra.{u, max u v} R)
    {S T : Type (max u v)} (α : S → T)
    (degreeS : S → ℤ) (degreeT : T → ℤ)
    (bS : S → B.A) (bT : T → B.A)
    (hb : ∀ s, bT (α s) = bS s)
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S))) :
    freeZeroDGA_map B degreeT bT (freeWordMap (R := R) α a) =
      freeZeroDGA_map B degreeS bS a := by
  let e := freeAlgebraWordEquiv (R := R) (S := S)
  let fS := freeZeroDGA_map B degreeS bS
  let fT := freeZeroDGA_map B degreeT bT
  let E := freeWordMap (R := R) α
  have h : (fT.comp E).comp e.toAlgHom = fS.comp e.toAlgHom := by
    apply FreeAlgebra.hom_ext
    funext s
    have hs : e (FreeAlgebra.ι R s) = monoidWord [s] := by
      change freeAlgebraWordEquiv (R := R) (S := S) (FreeAlgebra.ι R s) =
        AddMonoidAlgebra.single (Additive.ofMul (FreeMonoid.ofList [s])) 1
      simpa only [word, List.foldl_cons, List.foldl_nil, one_mul] using
        (freeAlgebraWordEquiv_word (R := R) [s])
    change fT (E (e (FreeAlgebra.ι R s))) = fS (e (FreeAlgebra.ι R s))
    rw [hs, freeWordMap_monoidWord, List.map_singleton,
      freeZeroDGA_map_letter, freeZeroDGA_map_letter, hb]
  have ha := congrArg (fun g : FreeAlgebra R S →ₐ[R] B.A => g (e.symm a)) h
  change fT (E (e (e.symm a))) = fS (e (e.symm a)) at ha
  simpa only [AlgEquiv.apply_symm_apply] using ha

private theorem freeWordMap_commutes_d_word {S T : Type (max u v)}
    (α : S → T) (degreeS : S → ℤ) (degreeT : T → ℤ)
    (δS : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (δT : T → AddMonoidAlgebra R (Additive (FreeMonoid T)))
    (hdegree : ∀ s, degreeT (α s) = degreeS s)
    (hδ : ∀ s, δT (α s) = freeWordMap (R := R) α (δS s))
    (w : List S) :
    freeWordDifferentialLinear degreeT δT
      (freeWordMap (R := R) α (monoidWord w)) =
    freeWordMap (R := R) α
      (freeWordDifferentialLinear degreeS δS (monoidWord w)) := by
  let E := freeWordMap (R := R) α
  let DS := freeWordDifferentialLinear degreeS δS
  let DT := freeWordDifferentialLinear degreeT δT
  induction w with
  | nil =>
      change DT (E (monoidWord [])) = E (DS (monoidWord []))
      rw [freeWordMap_monoidWord, freeWordDifferentialLinear_monoidWord,
        freeWordDifferentialLinear_monoidWord]
      simp [monoidWordDifferential]
  | cons s w ih =>
      have ih' : monoidWordDifferential degreeT δT (w.map α) =
          E (monoidWordDifferential degreeS δS w) := by
        simpa only [freeWordMap_monoidWord,
          freeWordDifferentialLinear_monoidWord] using ih
      change DT (E (monoidWord (s :: w))) = E (DS (monoidWord (s :: w)))
      rw [freeWordMap_monoidWord, freeWordDifferentialLinear_monoidWord,
        freeWordDifferentialLinear_monoidWord]
      simp only [List.map_cons, monoidWordDifferential, map_add, map_zsmul,
        map_mul]
      rw [hδ s, ih', hdegree s]
      simp only [E, freeWordMap_monoidWord, List.map_singleton]

private theorem freeWordMap_commutes_d {S T : Type (max u v)}
    (α : S → T) (degreeS : S → ℤ) (degreeT : T → ℤ)
    (δS : S → AddMonoidAlgebra R (Additive (FreeMonoid S)))
    (δT : T → AddMonoidAlgebra R (Additive (FreeMonoid T)))
    (hdegree : ∀ s, degreeT (α s) = degreeS s)
    (hδ : ∀ s, δT (α s) = freeWordMap (R := R) α (δS s))
    (a : AddMonoidAlgebra R (Additive (FreeMonoid S))) :
    freeWordDifferentialLinear degreeT δT (freeWordMap (R := R) α a) =
      freeWordMap (R := R) α (freeWordDifferentialLinear degreeS δS a) := by
  exact LinearMap.congr_fun (f := (freeWordDifferentialLinear degreeT δT) ∘ₗ
      (freeWordMap (R := R) α).toLinearMap)
    (g := (freeWordMap (R := R) α).toLinearMap ∘ₗ (freeWordDifferentialLinear degreeS δS))
    (monoidWord_linearMap_ext fun w =>
      freeWordMap_commutes_d_word α degreeS degreeT δS δT hdegree hδ w) a

end Stacks.DGA

