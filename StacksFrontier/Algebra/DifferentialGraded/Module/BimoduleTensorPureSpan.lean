module

public import StacksFrontier.Algebra.DGA.BimoduleTensorExact
public import StacksFrontier.Algebra.DifferentialGraded.Module.GradedSubmodule
public import StacksFrontier.Algebra.DifferentialGraded.Module.Subquotient

/-! # The pure tensors generate the relative tensor product

Let `(A, d)` and `(B, d)` be differential graded algebras over a commutative ring `R`, let `N` be
a differential graded `(A, B)`-bimodule and let `M` be a right differential graded `A`-module.
The relative tensor product `M ⊗_A N` of Tag 09LM is characterized by its universal property and
has no presentation, so the uniqueness half of that property — two *homomorphisms* of differential
graded modules out of `M ⊗_A N` agreeing on the pure tensors are equal — is the only handle on it.
This file upgrades that to a statement about the underlying `R`-module: the pure tensors
*generate* `M ⊗_A N`, so two `R`-linear maps out of it agreeing on the pure tensors are equal,
whether or not they respect the grading, the differential or the action.

The argument is the one that turns a uniqueness statement into a generation statement. The
`R`-submodule generated by the pure tensors of homogeneous elements is stable under the right
`B`-action, contains every graded component of each of its elements, and is stable under the
differential, so it is a differential graded submodule; the projection onto the quotient by it
kills every pure tensor, hence is the zero homomorphism by the uniqueness half of the universal
property, hence the submodule is everything.

## Main definitions

* `DifferentialGraded.Bimodule.purePoints`: the pure tensors of homogeneous elements.
* `DifferentialGraded.Bimodule.pureSpan`: the `R`-submodule they generate.
* `DifferentialGraded.Bimodule.pureGradedSub`: that submodule, as a differential graded
  submodule of `M ⊗_A N`.

## Main results

* `DifferentialGraded.Bimodule.pure_mem_pureSpan`: every pure tensor, of arbitrary elements, lies
  in the submodule generated by the homogeneous ones.
* `DifferentialGraded.Bimodule.pureSpan_eq_top`: **the pure tensors generate `M ⊗_A N`.**
* `DifferentialGraded.Bimodule.tensorObj_linearMap_ext` and
  `DifferentialGraded.Bimodule.tensorObj_fun_ext`: two `R`-linear maps, or two additive maps, out
  of `M ⊗_A N` which agree on the pure tensors are equal.

## References

* [Stacks Project, Tag 09LM](https://stacks.math.columbia.edu/tag/09LM) is the relative tensor
  product and its universal property; [Tag 09JI](https://stacks.math.columbia.edu/tag/09JI) is
  the category of differential graded modules.
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace DifferentialGraded.Bimodule

open DifferentialGradedModule

variable {R : Type u} [CommRing R] {A B : DifferentialGradedAlgebra.{u, u} R}

/-- The pure tensors of homogeneous elements in the relative tensor product `M ⊗_A N`. -/
def purePoints (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A) :
    Set (tensorObj N M).M :=
  {z | ∃ (p q : ℤ) (x : M.grading p) (y : N.rightModule.grading q),
    z = (tensorPure N M).toLinearMap (x : M.M) (y : N.rightModule.M)}

/-- The `R`-submodule of `M ⊗_A N` generated by the pure tensors of homogeneous elements. -/
def pureSpan (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A) :
    Submodule R (tensorObj N M).M :=
  Submodule.span R (purePoints N M)

/-- The pure tensor of two homogeneous elements lies in `pureSpan`. -/
theorem homogeneous_pure_mem_pureSpan (N : Bimodule A B)
    (M : DifferentialGradedModule.{u, u, u} A) {p q : ℤ} (x : M.grading p)
    (y : N.rightModule.grading q) :
    (tensorPure N M).toLinearMap (x : M.M) (y : N.rightModule.M) ∈ pureSpan N M :=
  Submodule.subset_span ⟨p, q, x, y, rfl⟩

/-- Every pure tensor lies in the submodule generated by the pure tensors of homogeneous
elements: decompose each of the two factors. -/
theorem pure_mem_pureSpan (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    (x : M.M) (y : N.rightModule.M) :
    (tensorPure N M).toLinearMap x y ∈ pureSpan N M := by
  induction x using DirectSum.Decomposition.inductionOn M.grading with
  | zero => simpa only [map_zero, LinearMap.zero_apply] using Submodule.zero_mem _
  | add x x' hx hx' =>
    simpa only [map_add, LinearMap.add_apply] using Submodule.add_mem _ hx hx'
  | @homogeneous p x =>
    induction y using DirectSum.Decomposition.inductionOn N.rightModule.grading with
    | zero => simpa only [map_zero] using Submodule.zero_mem _
    | add y y' hy hy' => simpa only [map_add] using Submodule.add_mem _ hy hy'
    | @homogeneous q y => exact homogeneous_pure_mem_pureSpan N M x y

/-- An `R`-linear endomorphism of `M ⊗_A N` preserves `pureSpan` once it sends the pure tensors of
homogeneous elements into it. -/
private theorem linearMap_mem_pureSpan (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    (f : (tensorObj N M).M →ₗ[R] (tensorObj N M).M)
    (h : ∀ w ∈ purePoints N M, f w ∈ pureSpan N M) {z : (tensorObj N M).M}
    (hz : z ∈ pureSpan N M) : f z ∈ pureSpan N M :=
  (Submodule.span_le (p := (pureSpan N M).comap f)).2 h hz

/-- The submodule generated by the pure tensors is stable under the right `B`-action: the action
moves into the second factor. -/
theorem pureSpan_op_smul_mem (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    (b : B.A) {z : (tensorObj N M).M} (hz : z ∈ pureSpan N M) :
    MulOpposite.op b • z ∈ pureSpan N M := by
  induction hz using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨p, q, x, y, rfl⟩ := hw
    rw [← (tensorPure N M).map_right]
    exact pure_mem_pureSpan N M _ _
  | zero => simpa only [smul_zero] using Submodule.zero_mem _
  | add w w' _ _ ihw ihw' =>
    simpa only [smul_add] using Submodule.add_mem _ ihw ihw'
  | smul r w _ ih =>
    rw [smul_comm]
    exact Submodule.smul_mem _ r ih

/-- The submodule generated by the pure tensors, as a right `B`-submodule. -/
def pureCarrier (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A) :
    Submodule (MulOpposite B.A) (tensorObj N M).M where
  carrier := (pureSpan N M : Set (tensorObj N M).M)
  add_mem' {a b} ha hb := Submodule.add_mem (pureSpan N M) ha hb
  zero_mem' := Submodule.zero_mem (pureSpan N M)
  smul_mem' c z hz := by
    rw [show c • z = MulOpposite.op c.unop • z from rfl]
    exact pureSpan_op_smul_mem N M c.unop hz

/-- Membership in `pureCarrier` is membership in `pureSpan`. -/
theorem mem_pureCarrier {N : Bimodule A B} {M : DifferentialGradedModule.{u, u, u} A}
    {z : (tensorObj N M).M} : z ∈ pureCarrier N M ↔ z ∈ pureSpan N M := Iff.rfl

/-- Taking the degree-`n` graded component of a differential graded module, as an `R`-linear
endomorphism of its underlying module. -/
private def gradedComponent (T : DifferentialGradedModule.{u, u, u} B) (n : ℤ) :
    T.M →ₗ[R] T.M :=
  (T.grading n).subtype ∘ₗ
    (DirectSum.component R ℤ (fun i => T.grading i) n) ∘ₗ
      (DirectSum.decomposeLinearEquiv T.grading).toLinearMap

private theorem gradedComponent_apply (T : DifferentialGradedModule.{u, u, u} B) (n : ℤ)
    (z : T.M) : gradedComponent T n z = (DirectSum.decompose T.grading z n : T.M) := rfl

/-- The submodule generated by the pure tensors of homogeneous elements contains every graded
component of each of its elements: its generators are homogeneous. -/
theorem pureSpan_decompose_mem (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    (n : ℤ) {z : (tensorObj N M).M} (hz : z ∈ pureSpan N M) :
    (DirectSum.decompose (tensorObj N M).grading z n : (tensorObj N M).M) ∈ pureSpan N M := by
  rw [← gradedComponent_apply]
  refine linearMap_mem_pureSpan N M _ (fun w hw => ?_) hz
  obtain ⟨p, q, x, y, rfl⟩ := hw
  have hmem := (tensorPure N M).map_grading p q x y
  rw [gradedComponent_apply]
  by_cases hn : p + q = n
  · subst hn
    rw [DirectSum.decompose_of_mem_same _ hmem]
    exact homogeneous_pure_mem_pureSpan N M x y
  · rw [DirectSum.decompose_of_mem_ne _ hmem hn]
    exact Submodule.zero_mem _

/-- The submodule generated by the pure tensors is stable under the differential: the Leibniz
rule expresses the differential of a pure tensor as a sum of pure tensors. -/
theorem pureSpan_d_mem (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    {z : (tensorObj N M).M} (hz : z ∈ pureSpan N M) :
    (tensorObj N M).d z ∈ pureSpan N M := by
  refine linearMap_mem_pureSpan N M (tensorObj N M).d (fun w hw => ?_) hz
  obtain ⟨p, q, x, y, rfl⟩ := hw
  rw [(tensorPure N M).map_d p x (y : N.rightModule.M)]
  refine Submodule.add_mem _ (pure_mem_pureSpan N M _ _) ?_
  rw [← Int.cast_smul_eq_zsmul R]
  exact Submodule.smul_mem _ _ (pure_mem_pureSpan N M _ _)

/-- The submodule generated by the pure tensors, as a differential graded submodule of
`M ⊗_A N`. -/
def pureGradedSub (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A) :
    GradedSub (tensorObj N M) where
  carrier := pureCarrier N M
  decompose_mem n _ hz :=
    mem_pureCarrier.2 (pureSpan_decompose_mem N M n (mem_pureCarrier.1 hz))
  d_mem _ hz := mem_pureCarrier.2 (pureSpan_d_mem N M (mem_pureCarrier.1 hz))

/-- **The pure tensors generate the relative tensor product.** The projection of `M ⊗_A N` onto
the quotient by the submodule generated by the pure tensors kills every pure tensor, so it is the
zero homomorphism by the uniqueness half of the universal property of Tag 09LM; hence every
element of `M ⊗_A N` lies in that submodule. -/
theorem pureSpan_eq_top (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A) :
    pureSpan N M = ⊤ := by
  set S := pureGradedSub N M with hS
  have hrange : ∀ z : (tensorObj N M).M, z ∈ (S.ι).range ↔ z ∈ pureSpan N M := by
    intro z
    refine ⟨fun ⟨w, hw⟩ => hw ▸ mem_pureCarrier.1 w.2,
      fun hz => ⟨⟨z, mem_pureCarrier.2 hz⟩, rfl⟩⟩
  have hzero : Hom.cokernelπ (S.ι) = 0 := by
    refine tensorObj_hom_ext N M _ _ fun x y => ?_
    exact (Submodule.Quotient.mk_eq_zero _).2 ((hrange _).2 (pure_mem_pureSpan N M x y))
  refine Submodule.eq_top_iff'.2 fun z => ?_
  have h := congrArg (fun f : (tensorObj N M) ⟶ (S.ι).cokernelObj => f.toFun z) hzero
  exact (hrange z).1 ((Submodule.Quotient.mk_eq_zero _).1 h)

/-- **Extensionality for `R`-linear maps out of the relative tensor product.** Two `R`-linear
maps out of `M ⊗_A N` which agree on the pure tensors are equal; unlike
`DifferentialGraded.Bimodule.tensorObj_hom_ext` this asks nothing of the grading, the
differential or the action. -/
theorem tensorObj_linearMap_ext (N : Bimodule A B) (M : DifferentialGradedModule.{u, u, u} A)
    {P : Type u} [AddCommGroup P] [Module R P] (f g : (tensorObj N M).M →ₗ[R] P)
    (h : ∀ (x : M.M) (y : N.rightModule.M),
      f ((tensorPure N M).toLinearMap x y) = g ((tensorPure N M).toLinearMap x y)) :
    f = g := by
  refine LinearMap.ext fun z => ?_
  have hz : z ∈ pureSpan N M := by rw [pureSpan_eq_top]; exact Submodule.mem_top
  induction hz using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨p, q, x, y, rfl⟩ := hw
    exact h _ _
  | zero => simp
  | add w w' _ _ ihw ihw' => simp only [map_add, ihw, ihw']
  | smul r w _ ih => simp only [map_smul, ih]

end DifferentialGraded.Bimodule

end
