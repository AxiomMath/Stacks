module

public import Mathlib.CategoryTheory.Triangulated.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Algebra.DifferentialGraded.Module.ConnectingHom
public import StacksFrontier.Algebra.DifferentialGraded.Module.HasShift

/-!
# Distinguished triangles of differential graded modules

An admissible short exact sequence `K → L → M` of right differential graded modules gives a
triangle `K → L → M → K[1]` in the homotopy category, whose third arrow is the connecting
homomorphism of any pair of compatible graded splittings. A triangle of the homotopy category is
*distinguished* when it is isomorphic to a triangle arising this way.

## Main definitions

* `DifferentialGradedModule.CompatibleSplittings`: the graded section and projection used to
  write the connecting arrow.
* `DifferentialGradedModule.associatedTriangle`: the triangle of an admissible short exact
  sequence, with no choice of splittings in its interface.
* `DifferentialGradedModule.IsDistinguishedTriangle`: the triangles isomorphic to an associated
  triangle.

## Main results

* `DifferentialGradedModule.nonempty_compatibleSplittings`: admissibility supplies compatible
  graded splittings.
* `DifferentialGradedModule.associatedTriangleOfSplittings_eq`: the triangle formed with any
  compatible splittings is the canonical associated triangle.
* `DifferentialGradedModule.isDistinguishedTriangle_iff`,
  `DifferentialGradedModule.isDistinguishedTriangle_associatedTriangle`,
  `DifferentialGradedModule.isDistinguishedTriangle_associatedTriangleOfSplittings` and
  `DifferentialGradedModule.isDistinguishedTriangle_of_iso`: the introduction rules and the
  isomorphism-invariance of the class.

## Implementation notes

The connecting arrow uses the splitting formula `δ = π ∘ d_L ∘ s` of
`DifferentialGradedModule.connectingHom`. The shift of the homotopy category is the one induced
from the signed shift of differential graded modules by
`DifferentialGradedModule.instHasShift` and
`DifferentialGradedModule.homotopyRelCompatibleWithShift`.

Part (1) of the source is given a choice-free interface: `associatedTriangle` picks compatible
splittings internally, and `associatedTriangleOfSplittings_eq` — which is the independence
statement of the splittings — identifies the triangle from every other choice with it. Part (2)
is then the isomorphism-closed class generated by these triangles; its introduction and
isomorphism-invariance lemmas let later results use the notion without unfolding its existential
definition.

Any graded section and retraction of an admissible short exact sequence can be corrected to a
compatible pair, which is what `nonempty_compatibleSplittings` does: replacing `s₀` by
`s₀ - f ∘ π₀ ∘ s₀` makes `ker π` equal to `im s`.

## References

* [Stacks Project, Tag 09K8](https://stacks.math.columbia.edu/tag/09K8)
-/

@[expose] public section

namespace DifferentialGradedModule

open CategoryTheory

universe u

variable {R : Type u} [CommRing R] (A : DifferentialGradedAlgebra R)

/-- The graded splittings used to write the connecting morphism. -/
structure CompatibleSplittings {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) where
  /-- The graded section of `g`. -/
  s : GradedHom M L
  /-- The graded retraction of `f`. -/
  π : GradedHom L K
  /-- `s` is a section of `g`. -/
  hs : ∀ x : M.M, g.toFun (s.toFun x) = x
  /-- `π` is a retraction of `f`. -/
  hπ : ∀ x : K.M, π.toFun (f.toFun x) = x
  /-- The two splittings are compatible: the kernel of `π` is the image of `s`. -/
  hker : LinearMap.ker π.toFun = LinearMap.range s.toFun

/-- Admissibility supplies graded splittings compatible with one another. -/
@[stacks 09K8 "part (1), compatible splittings"]
theorem nonempty_compatibleSplittings {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g) :
    Nonempty (CompatibleSplittings A f g) := by
  obtain ⟨π₀, hπ₀⟩ := hfg.admissibleMono
  obtain ⟨s₀, hs₀⟩ := hfg.admissibleEpi
  let s : GradedHom M L := {
    toFun := s₀.toFun - f.toFun.comp (π₀.toFun.comp s₀.toFun)
    map_smul := by
      intro x a
      change s₀.toFun (MulOpposite.op a • x) -
        f.toFun (π₀.toFun (s₀.toFun (MulOpposite.op a • x))) =
        MulOpposite.op a • (s₀.toFun x - f.toFun (π₀.toFun (s₀.toFun x)))
      rw [s₀.map_smul, π₀.map_smul, f.map_smul]
      simp [smul_sub]
    map_grading := by
      intro n x hx
      exact Submodule.sub_mem _ (s₀.map_grading n x hx) (f.map_grading n _
        (π₀.map_grading n _ (s₀.map_grading n x hx)))
  }
  have hgf (x : K.M) : g.toFun (f.toFun x) = 0 := LinearMap.mem_ker.mp
    (hfg.exact ▸ (show f.toFun x ∈ LinearMap.range f.toFun from ⟨x, rfl⟩))
  have hgs (x : M.M) : g.toFun (s.toFun x) = x := by
    change g.toFun (s₀.toFun x - f.toFun (π₀.toFun (s₀.toFun x))) = x
    simp [map_sub, hs₀, hgf]
  have hπs (x : M.M) : π₀.toFun (s.toFun x) = 0 := by
    change π₀.toFun (s₀.toFun x - f.toFun (π₀.toFun (s₀.toFun x))) = 0
    simp [map_sub, hπ₀]
  refine ⟨⟨s, π₀, hgs, hπ₀, ?_⟩⟩
  ext x
  constructor
  · intro hx
    obtain ⟨y, hy⟩ : x - s.toFun (g.toFun x) ∈ LinearMap.range f.toFun := by
      rw [hfg.exact, LinearMap.mem_ker]
      simp [map_sub, hgs]
    have hy₀ : y = 0 := by
      simpa [map_sub, hπ₀, hπs, LinearMap.mem_ker.mp hx] using congrArg π₀.toFun hy
    exact ⟨g.toFun x, (sub_eq_zero.mp (by simpa [hy₀] using hy.symm)).symm⟩
  · rintro ⟨y, rfl⟩
    exact LinearMap.mem_ker.mpr (hπs y)

/-- The formula for the associated triangle using a particular compatible pair of graded
splittings. -/
noncomputable def associatedTriangleOfSplittings {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g)
    (c : CompatibleSplittings A f g) :
    Pretriangulated.Triangle (HomotopyCategory A) :=
  Pretriangulated.Triangle.mk
    ((toHomotopyCategory A).map f)
    ((toHomotopyCategory A).map g)
    ((toHomotopyCategory A).map
      (connectingHom f g hfg c.s c.π c.hs c.hπ c.hker).val ≫
        eqToHom (CategoryTheory.Quotient.functor_obj_shift (homotopyRel A) ℤ K 1).symm)

/-- The triangle of an admissible short exact sequence in the homotopy category. -/
@[stacks 09K8 "part (1)"]
noncomputable def associatedTriangle {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g) :
    Pretriangulated.Triangle (HomotopyCategory A) :=
  associatedTriangleOfSplittings A f g hfg
    (Classical.choice (nonempty_compatibleSplittings A f g hfg))

/-- The associated triangle is independent of the compatible graded splittings used to compute
its connecting arrow. -/
@[stacks 09K8 "part (1), independence of splittings",
  sga "4½ Etat_0 1.2.4" "splitting independence"]
theorem associatedTriangleOfSplittings_eq {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g)
    (c : CompatibleSplittings A f g) :
    associatedTriangleOfSplittings A f g hfg c = associatedTriangle A f g hfg := by
  unfold associatedTriangle associatedTriangleOfSplittings
  rw [toHomotopyCategory_map_connectingHom_eq]

/-- A triangle of the homotopy category is distinguished precisely when it is isomorphic to the
triangle of an admissible short exact sequence. -/
@[stacks 09K8 "part (2)"]
def IsDistinguishedTriangle (T : Pretriangulated.Triangle (HomotopyCategory A)) : Prop :=
  ∃ (K L M : DifferentialGradedModule A) (f : Hom K L) (g : Hom L M)
    (hfg : IsAdmissibleShortExact f g),
    Nonempty (T ≅ associatedTriangle A f g hfg)

/-- A triangle is distinguished exactly when it is isomorphic to one computed from an admissible
sequence and any compatible graded splittings. -/
theorem isDistinguishedTriangle_iff (T : Pretriangulated.Triangle (HomotopyCategory A)) :
    IsDistinguishedTriangle A T ↔
      ∃ (K L M : DifferentialGradedModule A) (f : Hom K L) (g : Hom L M)
        (hfg : IsAdmissibleShortExact f g) (c : CompatibleSplittings A f g),
        Nonempty (T ≅ associatedTriangleOfSplittings A f g hfg c) := by
  constructor
  · rintro ⟨K, L, M, f, g, hfg, ⟨i⟩⟩
    obtain ⟨c⟩ := nonempty_compatibleSplittings A f g hfg
    exact ⟨K, L, M, f, g, hfg, c,
      ⟨i.trans (eqToIso (associatedTriangleOfSplittings_eq A f g hfg c)).symm⟩⟩
  · rintro ⟨K, L, M, f, g, hfg, c, ⟨i⟩⟩
    exact ⟨K, L, M, f, g, hfg,
      ⟨i.trans (eqToIso (associatedTriangleOfSplittings_eq A f g hfg c))⟩⟩

/-- Every associated triangle is distinguished. -/
theorem isDistinguishedTriangle_associatedTriangle {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g) :
    IsDistinguishedTriangle A (associatedTriangle A f g hfg) :=
  ⟨K, L, M, f, g, hfg, ⟨Iso.refl _⟩⟩

/-- A triangle computed with explicitly specified compatible splittings is distinguished. -/
theorem isDistinguishedTriangle_associatedTriangleOfSplittings
    {K L M : DifferentialGradedModule A}
    (f : Hom K L) (g : Hom L M) (hfg : IsAdmissibleShortExact f g)
    (c : CompatibleSplittings A f g) :
    IsDistinguishedTriangle A (associatedTriangleOfSplittings A f g hfg c) :=
  (isDistinguishedTriangle_iff A _).2 ⟨K, L, M, f, g, hfg, c, ⟨Iso.refl _⟩⟩

/-- Being distinguished is invariant under isomorphism of triangles. -/
theorem isDistinguishedTriangle_of_iso
    {T T' : Pretriangulated.Triangle (HomotopyCategory A)}
    (e : T ≅ T') (hT : IsDistinguishedTriangle A T) : IsDistinguishedTriangle A T' :=
  let ⟨K, L, M, f, g, hfg, ⟨i⟩⟩ := hT
  ⟨K, L, M, f, g, hfg, ⟨e.symm.trans i⟩⟩

end DifferentialGradedModule
