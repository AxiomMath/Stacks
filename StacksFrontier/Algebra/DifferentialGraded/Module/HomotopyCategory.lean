module

public import Mathlib.CategoryTheory.Quotient
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Algebra.DifferentialGraded.Module.Homotopy

/-!
# The homotopy category of differential graded modules

For a differential graded algebra `(A, d)` over a commutative ring `R`, the homotopy category
`K(A, d)` of right differential graded `A`-modules has the differential graded modules as objects
and homotopy classes of their homomorphisms as morphisms. It is realized here as Mathlib's
quotient of the category `Mod_{(A,d)}` by the homotopy relation, which is a congruence: homotopy
is an equivalence relation and is stable under pre- and postcomposition.

## Main definitions

* `DifferentialGradedModule.homotopyRel`: homotopy, as a relation on the morphisms of
  `Mod_{(A,d)}`.
* `DifferentialGradedModule.HomotopyCategory`: the homotopy category.
* `DifferentialGradedModule.toHomotopyCategory`: the canonical functor sending a homomorphism to
  its homotopy class.

## Main results

* `DifferentialGradedModule.Homotopy.refl`, `DifferentialGradedModule.Homotopy.symm` and
  `DifferentialGradedModule.Homotopy.trans`: homotopy is an equivalence relation, with the zero,
  the negated and the added homotopy as witnesses.
* `DifferentialGradedModule.homotopyRelCongruence`: homotopy is a congruence, so the category
  structure and the universal property of the quotient are inherited from
  `CategoryTheory.Quotient`.

## Implementation notes

Because the congruence instance identifies the congruence generated by homotopy with homotopy
itself, equality of two morphisms of the homotopy category is *exactly* homotopy of
representatives: clients may use `CategoryTheory.Quotient.functor_map_eq_iff` without unfolding
the quotient. The objects of the homotopy category are a type synonym of the differential graded
modules, so `toHomotopyCategory` is the identity on objects.

## References

* [Stacks Project, Tag 09JQ](https://stacks.math.columbia.edu/tag/09JQ)
-/

@[expose] public section

open CategoryTheory

namespace DifferentialGradedModule

universe u

variable {R : Type u} [CommRing R]

section Equivalence

variable {A : DifferentialGradedAlgebra R} {M N : DifferentialGradedModule A}

/-- The zero homotopy from a homomorphism of differential graded modules to itself. -/
def Homotopy.refl (f : Hom M N) : Homotopy f f where
  toLinearMap := 0
  map_grading := by intros; simp
  homotopy_eq := by intro x; simp

/-- The negative of a homotopy, a homotopy in the opposite direction. -/
def Homotopy.symm {f g : Hom M N} (h : Homotopy f g) : Homotopy g f where
  toLinearMap := -h.toLinearMap
  map_grading n x hx := (N.grading (n - 1)).neg_mem (h.map_grading n x hx)
  homotopy_eq x := by
    simp only [LinearMap.neg_apply, map_neg]
    rw [← neg_sub (f.toFun x) (g.toFun x), h.homotopy_eq x]; abel

/-- The sum of two homotopies, a homotopy between the outer homomorphisms. -/
def Homotopy.trans {f g k : Hom M N} (h : Homotopy f g) (j : Homotopy g k) : Homotopy f k where
  toLinearMap := h.toLinearMap + j.toLinearMap
  map_grading n x hx :=
    (N.grading (n - 1)).add_mem (h.map_grading n x hx) (j.map_grading n x hx)
  homotopy_eq x := by
    simp only [LinearMap.add_apply, map_add]
    calc
      f.toFun x - k.toFun x = (f.toFun x - g.toFun x) + (g.toFun x - k.toFun x) := by abel
      _ = _ := by rw [h.homotopy_eq x, j.homotopy_eq x]; abel

/-- Every homomorphism of differential graded modules is homotopic to itself. -/
theorem Homotopic.refl (f : Hom M N) : Homotopic f f := ⟨Homotopy.refl f⟩

/-- Homotopy of homomorphisms of differential graded modules is symmetric. -/
theorem Homotopic.symm {f g : Hom M N} (h : Homotopic f g) : Homotopic g f :=
  ⟨h.some.symm⟩

/-- Homotopy of homomorphisms of differential graded modules is transitive. -/
theorem Homotopic.trans {f g k : Hom M N} (h : Homotopic f g) (j : Homotopic g k) :
    Homotopic f k :=
  ⟨h.some.trans j.some⟩

end Equivalence

/-- Homotopy of homomorphisms of differential graded modules, regarded as a relation on the
morphisms of the category `Mod_{(A,d)}`. -/
abbrev homotopyRel (A : DifferentialGradedAlgebra R) :
    HomRel (DifferentialGradedModule A) :=
  fun _ _ f g => Homotopic f g

/-- Homotopy of differential graded module homomorphisms is an equivalence relation compatible
with composition on either side. -/
instance homotopyRelCongruence (A : DifferentialGradedAlgebra R) :
    Congruence (homotopyRel A) where
  equivalence := fun {_ _} => ⟨Homotopic.refl, Homotopic.symm, Homotopic.trans⟩
  comp_left := by
    intro M N P a f g ⟨h⟩
    exact ⟨(Homotopy.exists_comp f g a (Hom.id P) h).choose⟩
  comp_right := by
    intro M N P f g c ⟨h⟩
    exact ⟨(Homotopy.exists_comp f g (Hom.id M) c h).choose⟩

/-- The homotopy category of right differential graded `A`-modules. -/
@[stacks 09JQ]
abbrev HomotopyCategory (A : DifferentialGradedAlgebra R) : Type _ :=
  CategoryTheory.Quotient (homotopyRel A)

/-- The canonical functor from differential graded modules to the homotopy category, sending a
homomorphism to its homotopy class. -/
abbrev toHomotopyCategory (A : DifferentialGradedAlgebra R) :
    DifferentialGradedModule A ⥤ HomotopyCategory A :=
  CategoryTheory.Quotient.functor (homotopyRel A)

end DifferentialGradedModule
