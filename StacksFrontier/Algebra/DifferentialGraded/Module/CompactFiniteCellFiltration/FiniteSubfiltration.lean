/-!
# Morphisms out of a compact object factor through a finite subfiltration

Let `(A, d)` be a differential graded algebra and let `P` be a differential graded `A`-module with
a finite filtration `0 = F₋₁P ⊆ F₀P ⊆ ⋯ ⊆ FₙP = P` by differential graded submodules whose
successive quotients are direct sums `F_{i+1}P/FᵢP ≅ ⨁_{j ∈ Jᵢ} A[k_{i,j}]` of shifts of the
algebra. [Stacks, Tag 09R2] says that a morphism `E ⟶ P` of `D(A, d)` out of a *compact* object
factors through a differential graded submodule `P' ⊆ P` whose induced filtration has successive
quotients the *finite* subsums `⨁_{j ∈ J'ᵢ} A[k_{i,j}]`, `J'ᵢ ⊆ Jᵢ` finite.

The proof is a descending induction on the filtration degree, exactly as in the source. Suppose
`P'` already has finite subsums in degrees `≥ m`. Then `P'/F_mP'` is generated by finitely many
homogeneous elements, so their differentials land in a finite subsum of `F_mP/F_{m-1}P`; let `P''`
be the preimage of that finite subsum. The quotient `P'/P''` is the complementary subsum of
`F_mP/F_{m-1}P`, and compactness of `E` makes the composite `E ⟶ P' ⟶ P'/P''` factor through a
finite subsum of it, which can be absorbed into `P''` by enlarging `J'_{m-1}`.

## Main results

* `DifferentialGradedModule.exists_factorThrough_finiteSubfiltration`: **Tag 09R2**.

## Implementation notes

*The shape of the statement.* A filtration by differential graded submodules is a
`CategoryTheory.Filtration P ℕ`, with `F.obj (i + 1)` playing the role of `FᵢP`; the two ends of
the filtration are `IsZero (F.obj 0)` and `IsIso (F.ι.app (n + 1))`. The successive quotient
`F_{i+1}P/FᵢP` is the categorical cokernel of the step `F.diagram.map (homOfLE i.le_succ)`, and the
hypothesis names an isomorphism of it with `∐ⱼ A[k_{i,j}]`. The output filtration on `P'` is the
pullback of the given one along the inclusion `P' ⟶ P`, which is what `P' ∩ FᵢP` means, and its
quotients identify with the *inclusions of the finite subsums*, through
`CategoryTheory.Limits.Sigma.map'`, which pins `J'ᵢ` down as a subset of `Jᵢ`.

*The induction.* The statement proved by descending induction is packaged as the private structure
`FiniteLayers`, whose field `lower` records that the comparison with the ambient filtration is an
isomorphism below the current degree and whose field `upper` records the finite subsums above it.
The base case is `P' = P` and the conclusion is read off at degree `0`.

*Transparency discipline.* The carrier of a step of the filtration induced on a kernel is the
carrier of a `DifferentialGradedModule.Hom.kernelObj` only after unfolding the filtration, which
instance search and structure-field elaboration do not do. Every statement that has to read an
element of such a step therefore names the type as the honest `Hom.kernelObj`, and is applied to
the step by plain application, which checks definitional equality at default transparency; the
structure fields of the filtration are discharged by `exact` for the same reason.

## References

* [Stacks Project, Tag 09R2](https://stacks.math.columbia.edu/tag/09R2)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace DifferentialGradedModule

/- As in `CompactFiniteCellFiltration/DirectSums.lean`: the admissible-sequence pretriangulated
structure on the homotopy category is the one used throughout; it is not an instance, so it is
activated here explicitly. -/
attribute [local instance 10000] instPretriangulatedHomotopyCategory'

universe u u₁ u₂

variable {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra.{u, u} R}

/-! ### Passing to a complementary subsum -/

/-- The composite of two maps of graded right `A`-modules. -/
private def gradedHomComp {K L M : DifferentialGradedModule.{u, u, u} A} (r : GradedHom L K)
    (s : GradedHom M L) : GradedHom M K where
  toFun := r.toFun.comp s.toFun
  map_smul x a := by simp only [LinearMap.comp_apply, r.map_smul, s.map_smul]
  map_grading n x hx := r.map_grading n _ (s.map_grading n x hx)

/-- The projection away from a finite subsum is surjective. -/
private lemma surjective_finiteComplementProjection {I : Type u}
    (G : I → DifferentialGradedModule.{u, u, u} A) (s : Finset I) :
    Function.Surjective (finiteComplementProjection G s).toFun := fun y =>
  ⟨(Sigma.map' (fun i : {i : I // i ∉ s} => i.val) (fun _ => 𝟙 (G _))).toFun y,
    congrArg (fun p : (∐ fun i : {i : I // i ∉ s} => G i.val) ⟶ _ => p.toFun y)
      (finiteComplementProjection_has_section G s)⟩

/-- A map of graded right `A`-modules into a direct sum whose defect from commuting with the
differentials has finitely generated image becomes a homomorphism of differential graded modules
after projecting away a finite subsum. -/
private lemma exists_complement_hom_of_fg_differential {I : Type u}
    (G : I → DifferentialGradedModule.{u, u, u} A) {M : DifferentialGradedModule.{u, u, u} A}
    (r : GradedHom M (∐ G)) (hr : (LinearMap.range (gradedHomDifferential r)).FG) :
    ∃ (s : Finset I) (q : M ⟶ ∐ fun i : {i : I // i ∉ s} => G i.val),
      q.toFun = (finiteComplementProjection G s).toFun.comp r.toFun := by
  classical
  obtain ⟨t, ht⟩ := hr
  obtain ⟨s, hs⟩ := exists_finiteComplementProjection_toFun_eq_zero G (fun y : t => y.val)
  let p := finiteComplementProjection G s
  have hker : LinearMap.range (gradedHomDifferential r) ≤ Hom.ker p := by
    rw [← ht]
    refine Submodule.span_le.mpr fun y hy => ?_
    exact hs ⟨y, hy⟩
  have hd (x : M.M) : p.toFun (r.toFun (M.d x)) = p.toFun ((∐ G).d (r.toFun x)) := by
    have hh := hker (LinearMap.mem_range_self (gradedHomDifferential r) x)
    change p.toFun (r.toFun (M.d x) - (∐ G).d (r.toFun x)) = 0 at hh
    simpa only [map_sub, sub_eq_zero] using hh
  let c := gradedHomComp p.toGradedHom r
  refine ⟨s, { toFun := c.toFun, map_smul := c.map_smul, map_grading := c.map_grading
               map_d := ?_ }, rfl⟩
  ext x
  exact (hd x).trans (LinearMap.congr_fun p.map_d (r.toFun x))

/-- Enlarging the finite subset kills a given morphism out of a compact object. -/
private lemma exists_larger_complement_hom_killing_compact_map {I : Type u}
    (G : I → DifferentialGradedModule.{u, u, u} A) {M : DifferentialGradedModule.{u, u, u} A}
    (s : Finset I) (q : M ⟶ ∐ fun i : {i : I // i ∉ s} => G i.val)
    (E : derivedCategory' A) [IsCompactObject.{u} E]
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj M) :
    ∃ t : Finset I, s ⊆ t ∧
      f ≫ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).map
        (q ≫ finiteComplementMap G (s := s) (t := t)) = 0 := by
  classical
  let Q := toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q
  let H := fun i : {i : I // i ∉ s} => G i.val
  obtain ⟨t, g, hg⟩ := exists_factorization_through_finite_coproduct_in_derived H E (f ≫ Q.map q)
  refine ⟨s ∪ t.image Subtype.val, Finset.subset_union_left, ?_⟩
  have hzero : Sigma.desc (fun j : t => Sigma.ι H j.val) ≫
      finiteComplementMap G (s := s) (t := s ∪ t.image Subtype.val) = 0 := by
    refine Sigma.hom_ext _ _ fun j => ?_
    rw [← Category.assoc, Sigma.ι_desc, comp_zero]
    dsimp [finiteComplementMap]
    rw [Sigma.ι_desc, dite_eq_left]
    exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨j.val, j.property, rfl⟩)
  rw [Q.map_comp, ← Category.assoc, ← hg, Category.assoc, ← Q.map_comp, hzero]
  simp only [Functor.map_zero, comp_zero]

/-- A linear map which kills a submodule with finitely generated quotient has finitely generated
image. -/
private lemma fg_range_of_finite_quotient {S V W : Type u} [Ring S] [AddCommGroup V]
    [AddCommGroup W] [Module S V] [Module S W] (p : Submodule S V)
    [Module.Finite S (V ⧸ p)] (f : V →ₗ[S] W) (hf : p ≤ LinearMap.ker f) :
    (LinearMap.range f).FG := by
  rw [← Submodule.range_liftQ p f hf]
  simpa only [Submodule.map_top] using
    (Module.Finite.fg_top (R := S) (M := V ⧸ p)).map (p.liftQ f hf)

/-- If a graded map restricts along a monomorphism with finitely generated quotient to a
homomorphism of differential graded modules, then its defect from commuting with the differentials
has finitely generated image. -/
private lemma gradedHomDifferential_range_fg {K M N : DifferentialGradedModule.{u, u, u} A}
    (i : K ⟶ M) (q : K ⟶ N) (r : GradedHom M N) (h : r.toFun.comp i.toFun = q.toFun)
    [Module.Finite (MulOpposite A.A) (M.M ⧸ Hom.range i)] :
    (LinearMap.range (gradedHomDifferential r)).FG := by
  refine fg_range_of_finite_quotient (Hom.range i) _ ?_
  rintro _ ⟨x, rfl⟩
  show r.toFun (M.d (i.toFun x)) - N.d (r.toFun (i.toFun x)) = 0
  have hi := LinearMap.congr_fun i.map_d x
  change i.toFun (K.d x) = M.d (i.toFun x) at hi
  have hr (y : K.M) : r.toFun (i.toFun y) = q.toFun y := LinearMap.congr_fun h y
  rw [← hi, hr, hr]
  exact sub_eq_zero.mpr (LinearMap.congr_fun q.map_d x)

/-! ### The inductive step on a single graded piece -/

/-- The key construction: a surjective graded map onto a direct sum of shifts of the algebra whose
differential defect is finitely generated becomes, after projecting away a finite subsum and
enlarging it, an admissible epimorphism through whose kernel the given compact map factors. -/
private lemma exists_kernel_factorization_of_fg_differential {I : Type u} (k : I → ℤ)
    {M : DifferentialGradedModule.{u, u, u} A}
    (r : GradedHom M (∐ fun i => shift (regularModule A) (k i)))
    (hr : Function.Surjective r.toFun)
    (hd : (LinearMap.range (gradedHomDifferential r)).FG)
    (E : derivedCategory' A) [IsCompactObject.{u} E]
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj M) :
    ∃ (s : Finset I) (q : M ⟶ ∐ fun i : {i : I // i ∉ s} => shift (regularModule A) (k i.val)),
      q.toFun = (finiteComplementProjection
          (fun i => shift (regularModule A) (k i)) s).toFun.comp r.toFun ∧
      IsAdmissibleEpi q ∧
      ∃ g : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj (Hom.kernelObj q),
        g ≫ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).map (Hom.kernelι q) = f := by
  classical
  let G := fun i => shift (regularModule A) (k i)
  obtain ⟨s, q, hq⟩ := exists_complement_hom_of_fg_differential G r hd
  obtain ⟨t, hst, ht⟩ := exists_larger_complement_hom_killing_compact_map G s q E f
  let q' := q ≫ finiteComplementMap G (s := s) (t := t)
  have hq' : q'.toFun = (finiteComplementProjection G t).toFun.comp r.toFun := by
    ext x
    show (finiteComplementMap G).toFun (q.toFun x) = _
    rw [hq]
    exact congrArg (fun p : (∐ G) ⟶ _ => p.toFun (r.toFun x))
      (finiteComplementProjection_comp_map G hst)
  have hsurj : Function.Surjective q'.toFun := by
    intro y
    obtain ⟨z, rfl⟩ := surjective_finiteComplementProjection G t y
    obtain ⟨x, rfl⟩ := hr z
    exact ⟨x, by rw [hq']; rfl⟩
  have hepi' : Epi q' := epi_of_surjective q' hsurj
  have hepi : IsAdmissibleEpi q' :=
    isAdmissibleEpi_of_epi_to_coproduct_shifts (fun i : {i : I // i ∉ t} => k i.val) q'
  refine ⟨t, q', hq', hepi, ?_⟩
  obtain ⟨j, hj⟩ := hepi
  exact exists_lift_derived_of_gradedSplitEpi q' j hj E f ht

/-- The kernel of the complementary projection of a finite subset is the subsum on that subset. -/
private lemma kernel_finiteComplementProjection_iso {I : Type u}
    (G : I → DifferentialGradedModule.{u, u, u} A) (s : Finset I) :
    ∃ e : Hom.kernelObj (finiteComplementProjection G s) ≅ ∐ fun i : s => G i.val,
      e.hom ≫ Sigma.map' (fun i : s => i.val) (fun _ => 𝟙 (G _)) =
        Hom.kernelι (finiteComplementProjection G s) := by
  classical
  let p := finiteComplementProjection G s
  let c := Sigma.map' (fun i : s => i.val) (fun _ => 𝟙 (G _))
  let c' := Sigma.map' (fun i : {i : I // i ∉ s} => i.val) (fun _ => 𝟙 (G _))
  let r : (∐ G) ⟶ ∐ fun i : s => G i.val :=
    Sigma.desc fun i => if h : i ∈ s then Sigma.ι (fun i : s => G i.val) ⟨i, h⟩ else 0
  have hcr : c ≫ r = 𝟙 _ := by
    refine Sigma.hom_ext _ _ fun i => ?_
    simp [c, r, i.property]
  have hsum : r ≫ c + p ≫ c' = 𝟙 _ := by
    refine Sigma.hom_ext _ _ fun i => ?_
    by_cases hi : i ∈ s <;> simp [r, p, finiteComplementProjection, c, c', hi]
  have hcp : c ≫ p = 0 := by
    simpa only [c, Sigma.map', Category.id_comp] using
      finiteCoproduct_inclusion_comp_complement G s
  have hab : kernelLift c p hcp ≫ (Hom.kernelι p ≫ r) = 𝟙 _ :=
    Hom.ext (LinearMap.ext fun x =>
      congrArg (fun f : (∐ fun i : s => G i.val) ⟶ _ => f.toFun x) hcr)
  have he (x : (Hom.kernelObj p).M) : c.toFun (r.toFun x.val) = x.val := by
    have hh := congrArg (fun f : (∐ G) ⟶ (∐ G) => f.toFun x.val) hsum
    change c.toFun (r.toFun x.val) + c'.toFun (p.toFun x.val) = x.val at hh
    have hx : p.toFun x.val = 0 := x.property
    simpa only [hx, map_zero, add_zero] using hh
  refine ⟨⟨Hom.kernelι p ≫ r, kernelLift c p hcp, ?_, hab⟩, ?_⟩
  · exact Hom.ext (LinearMap.ext fun x => Subtype.ext (he x))
  · exact Hom.ext (LinearMap.ext he)

/-- The variant of `exists_kernel_factorization_of_fg_differential` whose input is an admissible
monomorphism with finitely generated quotient together with an epimorphism out of its source. -/
private lemma exists_kernel_factorization_of_finite_quotient
    {K M : DifferentialGradedModule.{u, u, u} A} (i : K ⟶ M) (hi : IsAdmissibleMono i)
    [Module.Finite (MulOpposite A.A) (M.M ⧸ Hom.range i)] {I : Type u} (k : I → ℤ)
    (q : K ⟶ ∐ fun j => shift (regularModule A) (k j)) [Epi q]
    (E : derivedCategory' A) [IsCompactObject.{u} E]
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj M) :
    ∃ (s : Finset I) (q' : M ⟶ ∐ fun j : {j : I // j ∉ s} => shift (regularModule A) (k j.val)),
      i ≫ q' = q ≫ finiteComplementProjection (fun j => shift (regularModule A) (k j)) s ∧
      IsAdmissibleEpi q' ∧
      ∃ g : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj (Hom.kernelObj q'),
        g ≫ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).map (Hom.kernelι q') = f := by
  obtain ⟨r, hr⟩ := hi
  let l := gradedHomComp q.toGradedHom r
  have hl : l.toFun.comp i.toFun = q.toFun := by
    ext x
    show q.toFun (r.toFun (i.toFun x)) = q.toFun x
    rw [hr]
  have hsurj : Function.Surjective l.toFun := by
    intro y
    obtain ⟨x, rfl⟩ := Hom.surjective_of_epi A q y
    exact ⟨i.toFun x, LinearMap.congr_fun hl x⟩
  obtain ⟨s, q', hq', hepi, hfactor⟩ := exists_kernel_factorization_of_fg_differential
    k l hsurj (gradedHomDifferential_range_fg i q l hl) E f
  refine ⟨s, q', ?_, hepi, hfactor⟩
  apply Hom.ext
  ext x
  show q'.toFun (i.toFun x) = _
  rw [hq', LinearMap.comp_apply]
  show (finiteComplementProjection (fun j => shift (regularModule A) (k j)) s).toFun
    (q.toFun (r.toFun (i.toFun x))) = _
  rw [hr]
  rfl

/-! ### The filtration induced on a kernel -/

section KernelFiltration

variable {M N : DifferentialGradedModule.{u, u, u} A} (q : M ⟶ N) (F : Filtration M ℕ)

/-- The filtration induced on the kernel of `q` by a filtration of its source: the `i`-th step is
the kernel of the restriction of `q` to the `i`-th step. -/
private noncomputable def kernelFiltration : Filtration (Hom.kernelObj q) ℕ := by
  have hb (i : ℕ) : Mono (kernelObjMap (F.ι.app i) q) :=
    mono_of_injective _ (fun x y h => Subtype.ext
      (Hom.injective_of_mono A (F.ι.app i) (congrArg Subtype.val h)))
  let a {i j : ℕ} (f : i ⟶ j) :
      Hom.kernelObj (F.ι.app i ≫ q) ⟶ Hom.kernelObj (F.ι.app j ≫ q) :=
    kernelLift (Hom.kernelι (F.ι.app i ≫ q) ≫ F.diagram.map f) (F.ι.app j ≫ q) (by
      rw [Category.assoc, ← Category.assoc (F.diagram.map f), F.ι.naturality f]
      simpa using Hom.kernelι_comp (F.ι.app i ≫ q))
  refine ⟨{ obj := fun i => @MonoOver.mk _ _ _ _ (kernelObjMap (F.ι.app i) q) (hb i)
            map := fun f => MonoOver.homMk (a f) ?_
            map_id := fun i => Subsingleton.elim _ _
            map_comp := fun f g => Subsingleton.elim _ _ }⟩
  exact Hom.ext (LinearMap.ext fun x =>
    Subtype.ext (congrArg (fun t : F.obj _ ⟶ M => t.toFun x.val) (F.ι.naturality f)))

/-- The comparison of the induced filtration of the kernel with the given filtration. -/
private noncomputable def kernelFiltrationBeta : (kernelFiltration q F).diagram ⟶ F.diagram where
  app i := by exact Hom.kernelι (F.ι.app i ≫ q)
  naturality := by intros; rfl

/-- Each step of the induced filtration of the kernel is the fibre product of the kernel with the
corresponding step. -/
private lemma kernelFiltration_isPullback (i : ℕ) :
    IsPullback ((kernelFiltration q F).ι.app i) ((kernelFiltrationBeta q F).app i)
      (Hom.kernelι q) (F.ι.app i) :=
  kernelObjMap_isPullback (F.ι.app i) q

/-- Where `q` already vanishes, the comparison of the induced filtration with the given one is an
isomorphism. -/
private lemma kernelFiltrationBeta_isIso (i : ℕ) (hz : F.ι.app i ≫ q = 0) :
    IsIso ((kernelFiltrationBeta q F).app i) := by
  have hbij : Function.Bijective (Hom.kernelι (F.ι.app i ≫ q)).toFun := by
    refine ⟨fun x y hxy => Subtype.ext hxy, fun x => ⟨⟨x, ?_⟩, rfl⟩⟩
    exact congrArg (fun t : F.obj i ⟶ N => t.toFun x) hz
  exact (Hom.isoOfBijective ((kernelFiltrationBeta q F).app i) hbij).isIso_hom

/-- Above the vanishing range of `q`, the graded pieces of the induced filtration of the kernel
agree with those of the given filtration. -/
private lemma kernelFiltration_cokernel_iso (i : ℕ)
    (hqi : Function.Surjective (F.ι.app i ≫ q).toFun) :
    ∃ e : cokernel ((kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))) ≅
        cokernel (F.diagram.map (homOfLE (Nat.le_succ i))),
      cokernel.π ((kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))) ≫ e.hom =
        (kernelFiltrationBeta q F).app (i + 1) ≫
          cokernel.π (F.diagram.map (homOfLE (Nat.le_succ i))) := by
  let a := F.diagram.map (homOfLE (Nat.le_succ i))
  let a' := (kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))
  let b := (kernelFiltrationBeta q F).app (i + 1) ≫ cokernel.π a
  have ha : a ≫ F.ι.app (i + 1) = F.ι.app i := F.diagram_map_comp_ι_app (homOfLE (Nat.le_succ i))
  have hπ (x : (F.obj i).M) : (cokernel.π a).toFun (a.toFun x) = 0 :=
    congrArg (fun t : F.obj i ⟶ cokernel a => t.toFun x) (cokernel.condition a)
  have hb : Function.Surjective b.toFun := by
    intro z
    obtain ⟨y, rfl⟩ := Hom.surjective_of_epi A (cokernel.π a) z
    obtain ⟨x, hx⟩ := hqi ((F.ι.app (i + 1) ≫ q).toFun y)
    have hxy : (F.ι.app (i + 1) ≫ q).toFun (y - a.toFun x) = 0 := by
      rw [map_sub]
      have hh := congrArg (fun t : F.obj i ⟶ N => t.toFun x)
        (show a ≫ (F.ι.app (i + 1) ≫ q) = F.ι.app i ≫ q by rw [← Category.assoc, ha])
      change (F.ι.app (i + 1) ≫ q).toFun (a.toFun x) = _ at hh
      rw [hh, hx, sub_self]
    refine ⟨(show (Hom.kernelObj (F.ι.app (i + 1) ≫ q)).M from ⟨y - a.toFun x, hxy⟩), ?_⟩
    show (cokernel.π a).toFun (y - a.toFun x) = _
    rw [map_sub, hπ, sub_zero]
  have he (y : (Hom.kernelObj (F.ι.app (i + 1) ≫ q)).M) :
      b.toFun y = 0 ↔ ∃ x : (Hom.kernelObj (F.ι.app i ≫ q)).M, a'.toFun x = y := by
    constructor
    · intro hy
      obtain ⟨x, hx⟩ := cokernelπ_eq_zero_mem_range a y.val hy
      change a.toFun x = y.val at hx
      have hxq : (F.ι.app i ≫ q).toFun x = 0 := by
        rw [← ha, Category.assoc]
        show (F.ι.app (i + 1) ≫ q).toFun (a.toFun x) = 0
        rw [hx]
        exact y.property
      exact ⟨⟨x, hxq⟩, Subtype.ext hx⟩
    · rintro ⟨x, rfl⟩
      exact hπ x.val
  exact ⟨cokernelIsoOfExact a' b hb he, cokernelIsoOfExact_π a' b hb he⟩

end KernelFiltration

/-- At the degree where `q` is introduced, the graded piece of the induced filtration of the
kernel is the finite subsum complementary to the one `q` projects onto. -/
private lemma kernelFiltration_finite_piece {M : DifferentialGradedModule.{u, u, u} A}
    (F : Filtration M ℕ) (i : ℕ) {I : Type u} (G : I → DifferentialGradedModule.{u, u, u} A)
    (s : Finset I) (c : F.obj (i + 1) ⟶ ∐ G) [Epi c]
    (hc : ∀ x, c.toFun x = 0 ↔ ∃ y, (F.diagram.map (homOfLE (Nat.le_succ i))).toFun y = x)
    (q : M ⟶ ∐ fun j : {j : I // j ∉ s} => G j.val)
    (hq : F.ι.app (i + 1) ≫ q = c ≫ finiteComplementProjection G s) :
    ∃ e : cokernel ((kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))) ≅
        ∐ fun j : s => G j.val,
      cokernel.π ((kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))) ≫
          e.hom ≫ Sigma.map' (fun j : s => j.val) (fun _ => 𝟙 (G _)) =
        (kernelFiltrationBeta q F).app (i + 1) ≫ c := by
  let a := F.diagram.map (homOfLE (Nat.le_succ i))
  let a' := (kernelFiltration q F).diagram.map (homOfLE (Nat.le_succ i))
  let p := finiteComplementProjection G s
  let b := (kernelFiltrationBeta q F).app (i + 1) ≫ c
  have hbp : b ≫ p = 0 := by
    show Hom.kernelι (F.ι.app (i + 1) ≫ q) ≫ c ≫ p = 0
    rw [← hq]
    exact Hom.kernelι_comp _
  have hl : Function.Surjective (kernelLift b p hbp).toFun := by
    intro z
    obtain ⟨x, hx⟩ := Hom.surjective_of_epi A c z.val
    have hxq : (F.ι.app (i + 1) ≫ q).toFun x = 0 := by
      rw [hq]
      show p.toFun (c.toFun x) = 0
      rw [hx]
      exact z.property
    exact ⟨(show (Hom.kernelObj (F.ι.app (i + 1) ≫ q)).M from ⟨x, hxq⟩), Subtype.ext hx⟩
  have hex (x : (Hom.kernelObj (F.ι.app (i + 1) ≫ q)).M) :
      (kernelLift b p hbp).toFun x = 0 ↔
        ∃ y : (Hom.kernelObj (F.ι.app i ≫ q)).M, a'.toFun y = x := by
    constructor
    · intro hx
      obtain ⟨y, hy⟩ := (hc x.val).mp (congrArg Subtype.val hx)
      have hyq : (F.ι.app i ≫ q).toFun y = 0 := by
        have ha : a ≫ F.ι.app (i + 1) = F.ι.app i :=
          F.diagram_map_comp_ι_app (homOfLE (Nat.le_succ i))
        rw [← ha, Category.assoc]
        show (F.ι.app (i + 1) ≫ q).toFun (a.toFun y) = 0
        rw [hy]
        exact x.property
      exact ⟨⟨y, hyq⟩, Subtype.ext hy⟩
    · rintro ⟨y, rfl⟩
      exact Subtype.ext ((hc _).mpr ⟨y.val, rfl⟩)
  obtain ⟨d, hd⟩ := kernel_finiteComplementProjection_iso G s
  refine ⟨cokernelIsoOfExact a' (kernelLift b p hbp) hl hex ≪≫ d, ?_⟩
  show cokernel.π a' ≫ (cokernelIsoOfExact a' (kernelLift b p hbp) hl hex).hom ≫ d.hom ≫ _ = b
  rw [hd, ← Category.assoc,
    cokernelIsoOfExact_π a' (kernelLift b p hbp) hl hex]
  exact kernelLift_ι b p hbp

/-! ### Bookkeeping along a finite filtration -/

/-- Admissible monomorphisms compose. -/
private lemma admissibleMono_comp {X Y Z : DifferentialGradedModule.{u, u, u} A} {i : X ⟶ Y}
    {j : Y ⟶ Z} (hi : IsAdmissibleMono i) (hj : IsAdmissibleMono j) :
    IsAdmissibleMono (i ≫ j) := by
  obtain ⟨r, hr⟩ := hi
  obtain ⟨s, hs⟩ := hj
  refine ⟨gradedHomComp r s, fun x => ?_⟩
  show r.toFun (s.toFun (j.toFun (i.toFun x))) = x
  rw [hs, hr]

/-- An isomorphism is an admissible monomorphism. -/
private lemma admissibleMono_of_isIso {X Y : DifferentialGradedModule.{u, u, u} A} (i : X ⟶ Y)
    [IsIso i] : IsAdmissibleMono i :=
  ⟨(inv i).toGradedHom, fun x => congrArg (fun t : X ⟶ X => t.toFun x) (IsIso.hom_inv_id i)⟩

/-- Finite generation of quotients is stable under composition. -/
private lemma finite_quotient_comp {S X Y Z : Type u} [Ring S] [AddCommGroup X] [AddCommGroup Y]
    [AddCommGroup Z] [Module S X] [Module S Y] [Module S Z] (i : X →ₗ[S] Y) (j : Y →ₗ[S] Z)
    [Module.Finite S (Y ⧸ LinearMap.range i)] [Module.Finite S (Z ⧸ LinearMap.range j)] :
    Module.Finite S (Z ⧸ LinearMap.range (j.comp i)) := by
  let a := (LinearMap.range i).mapQ (LinearMap.range (j.comp i)) j (by
    rintro _ ⟨x, rfl⟩; exact ⟨x, rfl⟩)
  let b := (LinearMap.range (j.comp i)).mapQ (LinearMap.range j) LinearMap.id (by
    rintro _ ⟨x, rfl⟩; exact ⟨i x, rfl⟩)
  refine Module.Finite.of_exact (f := a) (g := b) ?_ ?_
  · intro z
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (LinearMap.range (j.comp i)) z
    show Submodule.Quotient.mk z = (0 : Z ⧸ LinearMap.range j) ↔ _
    rw [Submodule.Quotient.mk_eq_zero]
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨Submodule.Quotient.mk y, rfl⟩
    · rintro ⟨y, hy⟩
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective (LinearMap.range i) y
      obtain ⟨x, hx⟩ : j y - z ∈ LinearMap.range (j.comp i) := (Submodule.Quotient.eq _).mp hy
      refine ⟨y - i x, ?_⟩
      have hx' : j (i x) = j y - z := hx
      show j (y - i x) = z
      rw [map_sub, hx']
      abel
  · intro z
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective (LinearMap.range j) z
    exact ⟨Submodule.Quotient.mk z, rfl⟩

/-- The quotient by the image of an epimorphism is zero, hence finitely generated. -/
private lemma finite_quotient_range_of_epi {X Y : DifferentialGradedModule.{u, u, u} A}
    (i : X ⟶ Y) [Epi i] : Module.Finite (MulOpposite A.A) (Y.M ⧸ Hom.range i) := by
  have hr : Hom.range i = ⊤ := by
    ext y
    simp only [Submodule.mem_top, iff_true]
    exact Hom.surjective_of_epi A i y
  rw [hr]
  infer_instance

/-- If every step of a finite filtration above `t` is an admissible monomorphism with finitely
generated quotient and the filtration is exhausted at `b`, then the inclusion of the `t`-th step is
an admissible monomorphism with finitely generated quotient. -/
private lemma filtration_tail_split_finite {M : DifferentialGradedModule.{u, u, u} A}
    (F : Filtration M ℕ) (t b : ℕ) (htb : t ≤ b) (htop : IsIso (F.ι.app b))
    (hs : ∀ i, t ≤ i → i < b → IsAdmissibleMono (F.diagram.map (homOfLE (Nat.le_succ i))))
    (hf : ∀ i, t ≤ i → i < b → Module.Finite (MulOpposite A.A)
      ((F.obj (i + 1)).M ⧸ Hom.range (F.diagram.map (homOfLE (Nat.le_succ i))))) :
    IsAdmissibleMono (F.ι.app t) ∧
      Module.Finite (MulOpposite A.A) (M.M ⧸ Hom.range (F.ι.app t)) := by
  refine Nat.decreasingInduction' (P := fun j =>
    IsAdmissibleMono (F.ι.app j) ∧
      Module.Finite (MulOpposite A.A) (M.M ⧸ Hom.range (F.ι.app j)))
    (fun j hj htj ih => ?_) htb ?_
  · obtain ⟨hmono, hfin⟩ := ih
    have hfin' : Module.Finite (MulOpposite A.A)
        (M.M ⧸ LinearMap.range (rightLinearMap (F.ι.app (j + 1)))) := by
      rw [← range_eq_linearMap_range]
      exact hfin
    have hjfin : Module.Finite (MulOpposite A.A) ((F.obj (j + 1)).M ⧸
        LinearMap.range (rightLinearMap (F.diagram.map (homOfLE (Nat.le_succ j))))) := by
      rw [← range_eq_linearMap_range]
      exact hf j htj hj
    have he : F.diagram.map (homOfLE (Nat.le_succ j)) ≫ F.ι.app (j + 1) = F.ι.app j :=
      F.diagram_map_comp_ι_app (homOfLE (Nat.le_succ j))
    rw [← he]
    refine ⟨admissibleMono_comp (hs j htj hj) hmono, ?_⟩
    rw [range_eq_linearMap_range]
    exact finite_quotient_comp (rightLinearMap (F.diagram.map (homOfLE (Nat.le_succ j))))
      (rightLinearMap (F.ι.app (j + 1)))
  · exact ⟨admissibleMono_of_isIso _, finite_quotient_range_of_epi _⟩

/-- A cokernel projection followed by an isomorphism has the image as its kernel. -/
private lemma exact_cokernel_comp_iso {X Y Z : DifferentialGradedModule.{u, u, u} A} (a : X ⟶ Y)
    (e : cokernel a ≅ Z) (x : Y.M) :
    (cokernel.π a ≫ e.hom).toFun x = 0 ↔ ∃ y, a.toFun y = x := by
  constructor
  · intro hx
    refine cokernelπ_eq_zero_mem_range a x (Hom.injective_of_mono A e.hom ?_)
    simpa using hx
  · rintro ⟨y, rfl⟩
    exact congrArg (fun t : X ⟶ Z => t.toFun y)
      (by simp : a ≫ (cokernel.π a ≫ e.hom) = 0)

/-- Transporting the previous computation across an isomorphism of two consecutive steps of two
filtrations. -/
private lemma exact_of_comparison_iso {M P Z : DifferentialGradedModule.{u, u, u} A}
    (H : Filtration M ℕ) (F : Filtration P ℕ) (β : H.diagram ⟶ F.diagram) (i : ℕ)
    [IsIso (β.app i)] [IsIso (β.app (i + 1))]
    (e : cokernel (F.diagram.map (homOfLE (Nat.le_succ i))) ≅ Z) (x : (H.obj (i + 1)).M) :
    (β.app (i + 1) ≫ cokernel.π (F.diagram.map (homOfLE (Nat.le_succ i))) ≫ e.hom).toFun x = 0 ↔
      ∃ y, (H.diagram.map (homOfLE (Nat.le_succ i))).toFun y = x := by
  let a := H.diagram.map (homOfLE (Nat.le_succ i))
  let b := F.diagram.map (homOfLE (Nat.le_succ i))
  have hn := β.naturality (homOfLE (Nat.le_succ i))
  change a ≫ β.app (i + 1) = β.app i ≫ b at hn
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := (exact_cokernel_comp_iso b e ((β.app (i + 1)).toFun x)).mp hx
    obtain ⟨y, rfl⟩ := Hom.surjective_of_epi A (β.app i) y
    refine ⟨y, Hom.injective_of_mono A (β.app (i + 1)) ?_⟩
    exact (congrArg (fun t : H.obj i ⟶ F.obj (i + 1) => t.toFun y) hn).trans hy
  · rintro ⟨y, rfl⟩
    have hy := (exact_cokernel_comp_iso b e (b.toFun ((β.app i).toFun y))).mpr
      ⟨(β.app i).toFun y, rfl⟩
    have hh := congrArg (fun t : H.obj i ⟶ F.obj (i + 1) => t.toFun y) hn
    change (β.app (i + 1)).toFun (a.toFun y) = _ at hh
    show e.hom.toFun ((cokernel.π b).toFun ((β.app (i + 1)).toFun (a.toFun y))) = 0
    rw [hh]
    exact hy

/-! ### The descending induction -/

/-- The statement proved by descending induction on the filtration degree `m`: a differential
graded submodule of `P` through which the given morphism factors, whose induced filtration agrees
with that of `P` below `m` and has finite subsums as graded pieces from `m` on. -/
private structure FiniteLayers (A : DifferentialGradedAlgebra.{u, u} R) (n : ℕ)
    (P : DifferentialGradedModule.{u, u, u} A) (F : Filtration P ℕ)
    (J : Fin (n + 1) → Type u) (k : ∀ i, J i → ℤ)
    (e : ∀ i : Fin (n + 1), cokernel (F.diagram.map (homOfLE (Nat.le_succ i.val))) ≅
      ∐ fun j : J i => shift (regularModule A) (k i j))
    (E : derivedCategory' A)
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj P) (m : ℕ) where
  /-- The submodule. -/
  obj : DifferentialGradedModule.{u, u, u} A
  /-- Its inclusion into `P`. -/
  inclusion : obj ⟶ P
  /-- The inclusion is a monomorphism. -/
  mono : Mono inclusion
  /-- The induced filtration of the submodule. -/
  filtration : Filtration obj ℕ
  /-- Its comparison with the filtration of `P`. -/
  comparison : filtration.diagram ⟶ F.diagram
  /-- Each step is the intersection of the submodule with the corresponding step of `P`. -/
  pullback : ∀ i, IsPullback (filtration.ι.app i) (comparison.app i) inclusion (F.ι.app i)
  /-- Below `m` the filtration agrees with that of `P`. -/
  lower : ∀ i, i ≤ m → IsIso (comparison.app i)
  /-- From `m` on the graded pieces are the inclusions of finite subsums. -/
  upper : ∀ i : Fin (n + 1), m ≤ i.val →
    ∃ (s : Finset (J i)) (d : cokernel (filtration.diagram.map (homOfLE (Nat.le_succ i.val))) ≅
      ∐ fun j : s => shift (regularModule A) (k i j.val)),
      cokernel.π (filtration.diagram.map (homOfLE (Nat.le_succ i.val))) ≫ d.hom ≫
          Sigma.map' (fun j : s => j.val) (fun _ => 𝟙 _) =
        comparison.app (i.val + 1) ≫
          cokernel.π (F.diagram.map (homOfLE (Nat.le_succ i.val))) ≫ (e i).hom
  /-- The factorization of the given morphism. -/
  factor : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj obj
  /-- It is a factorization. -/
  factor_eq :
    factor ≫ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).map inclusion = f

/-- The inductive step: from finite subsums in degrees `≥ m + 1` to finite subsums in degrees
`≥ m`. -/
private lemma finiteLayers_step (A : DifferentialGradedAlgebra.{u, u} R) (n : ℕ)
    (P : DifferentialGradedModule.{u, u, u} A) (F : Filtration P ℕ)
    (htop : IsIso (F.ι.app (n + 1))) (J : Fin (n + 1) → Type u) (k : ∀ i, J i → ℤ)
    (e : ∀ i : Fin (n + 1), cokernel (F.diagram.map (homOfLE (Nat.le_succ i.val))) ≅
      ∐ fun j : J i => shift (regularModule A) (k i j))
    (E : derivedCategory' A) [IsCompactObject.{u} E]
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj P)
    (m : ℕ) (hm : m ≤ n) (T : FiniteLayers A n P F J k e E f (m + 1)) :
    Nonempty (FiniteLayers A n P F J k e E f m) := by
  classical
  let H := T.filtration
  let β := T.comparison
  let Q := toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q
  let l : Fin (n + 1) := ⟨m, by omega⟩
  let G := fun j : J l => shift (regularModule A) (k l j)
  have hiso₀ : IsIso (β.app m) := T.lower m (by omega)
  have hiso₁ : IsIso (β.app (m + 1)) := T.lower (m + 1) le_rfl
  let c := β.app (m + 1) ≫ cokernel.π (F.diagram.map (homOfLE (Nat.le_succ m))) ≫ (e l).hom
  have hepic : Epi c := inferInstance
  have htopH : IsIso (H.ι.app (n + 1)) := (T.pullback (n + 1)).isIso_fst_of_isIso
  have hsplit (i : ℕ) (hi : m + 1 ≤ i) (hi' : i < n + 1) :
      IsAdmissibleMono (H.diagram.map (homOfLE (Nat.le_succ i))) := by
    obtain ⟨s, d, hd⟩ := T.upper ⟨i, hi'⟩ hi
    exact isAdmissibleMono_of_cokernel_iso_coproduct_shifts
      (H.diagram.map (homOfLE (Nat.le_succ i))) (fun j : s => k ⟨i, hi'⟩ j.val) d
  have hfinite (i : ℕ) (hi : m + 1 ≤ i) (hi' : i < n + 1) :
      Module.Finite (MulOpposite A.A) ((H.obj (i + 1)).M ⧸
        Hom.range (H.diagram.map (homOfLE (Nat.le_succ i)))) := by
    obtain ⟨s, d, hd⟩ := T.upper ⟨i, hi'⟩ hi
    exact finite_quotient_range_of_cokernel_iso_finite_coproduct_shifts
      (H.diagram.map (homOfLE (Nat.le_succ i))) (fun j : s => k ⟨i, hi'⟩ j.val) d
  obtain ⟨hi, hfin⟩ := filtration_tail_split_finite H (m + 1) (n + 1) (by omega)
    htopH hsplit hfinite
  obtain ⟨s, q, hq, hqepi, g, hg⟩ := exists_kernel_factorization_of_finite_quotient
    (H.ι.app (m + 1)) hi (k l) c E T.factor
  let H' := kernelFiltration q H
  let γ := kernelFiltrationBeta q H
  have hmonoq : Mono (Hom.kernelι q) := mono_of_injective _ (fun x y hxy => Subtype.ext hxy)
  have := T.mono
  have hzero (i : ℕ) (him : i ≤ m) : H.ι.app i ≫ q = 0 := by
    let a := H.diagram.map (homOfLE him)
    let b := H.diagram.map (homOfLE (Nat.le_succ m))
    have hca : b ≫ c = 0 := Hom.ext (LinearMap.ext fun x =>
      (exact_of_comparison_iso H F β m (e l) (b.toFun x)).mpr ⟨x, rfl⟩)
    have ha : a ≫ H.ι.app m = H.ι.app i := H.diagram_map_comp_ι_app (homOfLE him)
    have hb : b ≫ H.ι.app (m + 1) = H.ι.app m :=
      H.diagram_map_comp_ι_app (homOfLE (Nat.le_succ m))
    rw [← ha, ← hb, Category.assoc, Category.assoc, hq, ← Category.assoc b, hca, zero_comp,
      comp_zero]
  refine ⟨{ obj := Hom.kernelObj q
            inclusion := Hom.kernelι q ≫ T.inclusion
            mono := inferInstance
            filtration := H'
            comparison := γ ≫ β
            pullback := fun i => (kernelFiltration_isPullback q H i).paste_vert (T.pullback i)
            lower := ?_
            upper := ?_
            factor := g
            factor_eq := ?_ }⟩
  · intro i him
    have hγ : IsIso (γ.app i) := kernelFiltrationBeta_isIso q H i (hzero i him)
    have hβ : IsIso (β.app i) := T.lower i (by omega)
    show IsIso (γ.app i ≫ β.app i)
    infer_instance
  · intro i him
    by_cases heq : i.val = m
    · have hil : i = l := Fin.ext heq
      subst i
      obtain ⟨d, hd⟩ := kernelFiltration_finite_piece H m G s c
        (exact_of_comparison_iso H F β m (e l)) q hq
      exact ⟨s, d, by simpa only [NatTrans.comp_app, Category.assoc] using hd⟩
    · obtain ⟨s', d, hd⟩ := T.upper i (by omega)
      have hsurj : Function.Surjective (H.ι.app i.val ≫ q).toFun := by
        have hcq : Function.Surjective (H.ι.app (m + 1) ≫ q).toFun := by
          rw [hq]
          show Function.Surjective fun x => (finiteComplementProjection G s).toFun (c.toFun x)
          exact (surjective_finiteComplementProjection G s).comp (Hom.surjective_of_epi A c)
        intro y
        obtain ⟨x, hx⟩ := hcq y
        let a := H.diagram.map (homOfLE (show m + 1 ≤ i.val by omega))
        refine ⟨a.toFun x, ?_⟩
        have ha : a ≫ H.ι.app i.val = H.ι.app (m + 1) :=
          H.diagram_map_comp_ι_app (homOfLE (show m + 1 ≤ i.val by omega))
        exact (congrArg (fun t : H.obj (m + 1) ⟶ _ => t.toFun x)
          (show a ≫ (H.ι.app i.val ≫ q) = H.ι.app (m + 1) ≫ q by
            rw [← Category.assoc, ha])).trans hx
      obtain ⟨d', hd'⟩ := kernelFiltration_cokernel_iso q H i.val hsurj
      refine ⟨s', d' ≪≫ d, ?_⟩
      show cokernel.π _ ≫ d'.hom ≫ d.hom ≫ _ = _
      rw [← Category.assoc (cokernel.π _), hd', Category.assoc]
      exact congrArg (fun t => γ.app (i.val + 1) ≫ t) hd
  · show g ≫ Q.map (Hom.kernelι q ≫ T.inclusion) = f
    rw [Q.map_comp, ← Category.assoc, hg]
    exact T.factor_eq

/-! ### The theorem -/

/-- **Stacks Tag 09R2.** Let `(A, d)` be a differential graded algebra, let `E` be a compact
object of `D(A, d)` and let `P` be a differential graded `A`-module carrying a finite filtration
`0 = F₋₁P ⊆ F₀P ⊆ ⋯ ⊆ FₙP = P` by differential graded submodules whose graded pieces are direct
sums `F_{i+1}P/FᵢP ≅ ⨁_{j ∈ Jᵢ} A[k_{i,j}]` of shifts of the algebra. Then every morphism
`E ⟶ P` of `D(A, d)` factors through a differential graded submodule `P' ⊆ P` whose intersections
with the filtration have graded pieces the finite subsums `⨁_{j ∈ J'ᵢ} A[k_{i,j}]`, for finite
subsets `J'ᵢ ⊆ Jᵢ`.

The filtration of `P'` is produced as the pullback of that of `P`, and the identification of its
graded pieces with the finite subsums is compatible with the given identification of the graded
pieces of `P`, through the inclusion of the subsum. -/
@[stacks 09R2]
theorem exists_factorThrough_finiteSubfiltration (A : DifferentialGradedAlgebra.{u, u} R)
    (n : ℕ) (P : DifferentialGradedModule.{u, u, u} A) (F : Filtration P ℕ)
    (_hzero : IsZero (F.obj 0)) (htop : IsIso (F.ι.app (n + 1)))
    (J : Fin (n + 1) → Type u) (k : ∀ i, J i → ℤ)
    (e : ∀ i : Fin (n + 1), cokernel (F.diagram.map (homOfLE (Nat.le_succ i.val))) ≅
      ∐ fun j : J i => shift (regularModule A) (k i j))
    (E : derivedCategory' A) [IsCompactObject.{u} E]
    (f : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj P) :
    ∃ (P' : DifferentialGradedModule.{u, u, u} A) (p : P' ⟶ P),
      Mono p ∧
      ∃ (F' : Filtration P' ℕ) (β : ∀ i : ℕ, F'.obj i ⟶ F.obj i),
        (∀ i : ℕ, IsPullback (F'.ι.app i) (β i) p (F.ι.app i)) ∧
        (∃ (J' : ∀ i : Fin (n + 1), Finset (J i))
          (e' : ∀ i : Fin (n + 1),
            cokernel (F'.diagram.map (homOfLE (Nat.le_succ i.val))) ≅
              ∐ fun j : ↑(J' i) => shift (regularModule A) (k i j.val))
          (q : ∀ i : Fin (n + 1),
            cokernel (F'.diagram.map (homOfLE (Nat.le_succ i.val))) ⟶
              cokernel (F.diagram.map (homOfLE (Nat.le_succ i.val)))),
          (∀ i : Fin (n + 1),
            cokernel.π (F'.diagram.map (homOfLE (Nat.le_succ i.val))) ≫ q i =
              β (i.val + 1) ≫ cokernel.π (F.diagram.map (homOfLE (Nat.le_succ i.val)))) ∧
          (∀ i : Fin (n + 1),
            (e' i).hom ≫ Sigma.map' (fun j : ↑(J' i) => j.val) (fun _ => 𝟙 _) =
              q i ≫ (e i).hom)) ∧
        ∃ g : E ⟶ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).obj P',
          g ≫ (toHomotopyCategory A ⋙ (quasiIsomorphisms' A).Q).map p = f := by
  classical
  let Ttop : FiniteLayers A n P F J k e E f (n + 1) :=
    { obj := P
      inclusion := 𝟙 P
      mono := inferInstance
      filtration := F
      comparison := 𝟙 F.diagram
      pullback := fun i => IsPullback.of_id_fst.flip
      lower := fun i _ => inferInstance
      upper := fun i hi => False.elim (by omega)
      factor := f
      factor_eq := by simp }
  have hT : Nonempty (FiniteLayers A n P F J k e E f 0) := by
    refine Nat.decreasingInduction' (m := 0) (n := n + 1)
      (P := fun m => Nonempty (FiniteLayers A n P F J k e E f m))
      (fun m hm _ h => ?_) (Nat.zero_le _) ⟨Ttop⟩
    obtain ⟨T⟩ := h
    exact finiteLayers_step A n P F htop J k e E f m (by omega) T
  obtain ⟨T⟩ := hT
  choose s d hd using fun i => T.upper i (Nat.zero_le _)
  let q (i : Fin (n + 1)) := cokernel.map
    (T.filtration.diagram.map (homOfLE (Nat.le_succ i.val)))
    (F.diagram.map (homOfLE (Nat.le_succ i.val)))
    (T.comparison.app i.val) (T.comparison.app (i.val + 1))
    (T.comparison.naturality (homOfLE (Nat.le_succ i.val)))
  have hq (i : Fin (n + 1)) :
      cokernel.π (T.filtration.diagram.map (homOfLE (Nat.le_succ i.val))) ≫ q i =
        T.comparison.app (i.val + 1) ≫
          cokernel.π (F.diagram.map (homOfLE (Nat.le_succ i.val))) := by
    simp only [q, cokernel.map, cokernel.π_desc]
  refine ⟨T.obj, T.inclusion, T.mono, T.filtration, fun i => T.comparison.app i,
    T.pullback, ⟨s, d, q, hq, ?_⟩, T.factor, T.factor_eq⟩
  intro i
  apply (cancel_epi (cokernel.π (T.filtration.diagram.map (homOfLE (Nat.le_succ i.val))))).mp
  rw [← Category.assoc _ (q i), hq, Category.assoc]
  exact hd i

end DifferentialGradedModule

