module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Algebra.DifferentialGraded.Module.HomotopyCategory
import all StacksFrontier.Algebra.DGA.Abelian
import all StacksFrontier.Algebra.DGA.Abelian.ProductCoproduct

/-!
# Products and direct sums in the homotopy category of differential graded modules

For a differential graded algebra `(A, d)` over a commutative ring `R`, the homotopy category of
right differential graded `A`-modules has arbitrary products and arbitrary direct sums.

Both are computed degreewise on the underlying graded modules, not on the plain right modules:
the product of a family `(M i)` has degree-`n` part `∏ᵢ (M i)^n` and underlying module
`⊕ₙ ∏ᵢ (M i)^n`, and the direct sum has degree-`n` part `⊕ᵢ (M i)^n`. Both constructions pass to
the homotopy category because a homotopy into a product, and a homotopy out of a direct sum, is
determined componentwise.

## Main results

* `DifferentialGradedModule.hasProducts_homotopyCategory`: the homotopy category has products.
* `DifferentialGradedModule.hasCoproducts_homotopyCategory`: the homotopy category has direct
  sums.
* `DifferentialGradedModule.isLimitMapFanToHomotopyCategory`: the quotient functor carries an
  arbitrary product cone of differential graded modules to a product cone, not only the concrete
  degreewise one.

## Implementation notes

The concrete degreewise constructions are not repeated here. The underlying module of the product
is the `Aᵐᵒᵖ`-submodule of `∏ᵢ (M i).M` generated by the degreewise products, and the underlying
module of the direct sum is the submodule generated by their finitely-supported elements; in each
case the right action and the differential are the componentwise ones, which preserve the
submodule because they shift degree by `0` and by `1`. Those submodules, their gradings and
differentials, the projections and injections, and the lift and the descent are built once by
`StacksFrontier.Algebra.DGA.Abelian`, which uses them for the abelian-category structure. They are
`private` there, so this file reaches them with `import all` and adds only what the passage to the
homotopy category needs.

Universal properties are checked by `Fan.IsLimit.mk` and `Cofan.IsColimit.mk`: existence of the
lift or the descent is the universal property of the product or the direct sum in `Module R`,
applied degreewise; uniqueness in the homotopy category is where `homotopyIntoProduct` and
`homotopyIntoCoproduct` are used, assembling a homotopy from componentwise homotopies. Elements
of the direct sum have finite support, so a map out of it is a finite sum over a finset
containing that support; `coprodGenSum_subset` and `homotopyGenSum_subset` make those sums
independent of the chosen finset.

## References

* [Stacks Project, Tag 09JR](https://stacks.math.columbia.edu/tag/09JR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace DifferentialGradedModule

universe u v w

variable {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra.{u, v} R}

section Product

variable {I : Type w} (f : I → DifferentialGradedModule.{u, v, w} A)

private theorem mem_prodGrading {n : ℤ} (x : ↥(prodSub f)) :
    x ∈ prodGrading f n ↔ (x : ∀ i, (f i).M) ∈ prodPn f n := Iff.rfl

private theorem prodMap_mem {T : DifferentialGradedModule.{u, v, w} A}
    (g : ∀ i, T.M →+ (f i).M) (d : ℤ → ℤ)
    (hg : ∀ i n x, x ∈ T.grading n → g i x ∈ (f i).grading (d n)) (t : T.M) :
    (fun i => g i t) ∈ (prodSub f).restrictScalars R := by
  classical
  rw [prodSub_restrict_eq]
  have heq : (fun i => g i t)
      = ∑ n ∈ DFinsupp.support (DirectSum.decompose T.grading t),
        (fun i => g i ((DirectSum.decompose T.grading t) n : T.M)) := by
    funext i
    rw [Finset.sum_apply, ← map_sum, DirectSum.sum_support_decompose]
  rw [heq]
  exact Submodule.sum_mem _ fun n _ => Submodule.mem_iSup_of_mem (d n)
    ((mem_prodPn ..).2 fun i => hg i n _ ((DirectSum.decompose T.grading t) n).2)

end Product

private noncomputable def homotopyIntoProduct {I : Type w}
    (N : I → DifferentialGradedModule.{u, v, w} A)
    {M : DifferentialGradedModule.{u, v, w} A}
    {f g : M ⟶ prodObj N}
    (h : ∀ i, Homotopic (f ≫ prodπ N i) (g ≫ prodπ N i)) :
    Homotopy f g := by
  classical
  let hChosen : ∀ i, Homotopy (f ≫ prodπ N i) (g ≫ prodπ N i) :=
    fun i => Classical.choice (h i)
  refine ⟨?_, ?_, ?_⟩
  · exact {
      toFun := fun x => ⟨fun i => hChosen i |>.toLinearMap x,
        prodMap_mem N (fun i => (hChosen i).toLinearMap.toAddMonoidHom)
          (fun n => n - 1) (fun i n x hx => (hChosen i).map_grading n x hx) x⟩
      map_add' x y := Subtype.ext (funext fun i => map_add (hChosen i).toLinearMap x y)
      map_smul' a x := Subtype.ext (funext fun i => map_smul (hChosen i).toLinearMap a x) }
  · intro n x hx
    change (fun i => (hChosen i).toLinearMap x) ∈ prodPn N (n - 1)
    rw [mem_prodPn]
    intro i
    exact (hChosen i).map_grading n x hx
  · intro x
    apply Subtype.ext
    funext i
    change (f ≫ prodπ N i).toFun x - (g ≫ prodπ N i).toFun x =
      (N i).d ((hChosen i).toLinearMap x) + (hChosen i).toLinearMap (M.d x)
    simpa [prodπ_toFun_apply, prodObj_d, prodD, prodD0_apply] using
      (hChosen i).homotopy_eq x

/-- The concrete degreewise product `prodObj` is a product of `N` in the category of
differential graded modules. -/
private noncomputable def prodIsLimit {I : Type w}
    (N : I → DifferentialGradedModule.{u, v, w} A) :
    IsLimit (Fan.mk (prodObj N) (fun i => prodπ N i)) := by
  refine Fan.IsLimit.mk _ (fun s => prodLift N (fun i => s.proj i))
    (fun s i => Hom.ext (LinearMap.ext fun _ => rfl)) fun s m hm => ?_
  exact Hom.ext (LinearMap.ext fun x => Subtype.ext (funext fun i =>
    LinearMap.congr_fun (congrArg Hom.toFun (hm i)) x))

/-- Homotopies into *any* product of differential graded modules are determined componentwise.
This is the bridge from the concrete degreewise product `prodObj` to whichever product object a
given limit cone has. -/
private theorem homotopyIntoProductOfLimits {I : Type w}
    (N : I → DifferentialGradedModule.{u, v, w} A)
    {P : DifferentialGradedModule.{u, v, w} A} (p : ∀ i, P ⟶ N i)
    (hp : IsLimit (Fan.mk P p))
    {M : DifferentialGradedModule.{u, v, w} A} {f g : M ⟶ P}
    (h : ∀ i, Homotopic (f ≫ p i) (g ≫ p i)) :
    Homotopic f g := by
  classical
  let e : P ≅ prodObj N := hp.conePointUniqueUpToIso (prodIsLimit N)
  have he (i : I) : e.hom ≫ prodπ N i = p i :=
    hp.conePointUniqueUpToIso_hom_comp (prodIsLimit N) ⟨i⟩
  have hh : ∀ i, Homotopic ((f ≫ e.hom) ≫ prodπ N i) ((g ≫ e.hom) ≫ prodπ N i) := fun i => by
    simpa only [Category.assoc, he i] using h i
  obtain ⟨H', -⟩ := Homotopy.exists_comp (f ≫ e.hom) (g ≫ e.hom) (𝟙 M) e.inv
    (homotopyIntoProduct N hh)
  simpa only [Category.assoc, Iso.hom_inv_id, Category.comp_id] using
    (show Homotopic ((f ≫ e.hom) ≫ e.inv) ((g ≫ e.hom) ≫ e.inv) from ⟨H'⟩)

/-- The quotient functor to the homotopy category sends *any* product cone of differential graded
modules to a product cone. The product object is not required to be the concrete degreewise one:
uniqueness of the lift in the homotopy category only needs that homotopies into a product are
determined componentwise, which `homotopyIntoProductOfLimits` supplies for an arbitrary limit
cone. -/
theorem isLimitMapFanToHomotopyCategory {I : Type w}
    (N : I → DifferentialGradedModule.{u, v, w} A)
    {P : DifferentialGradedModule.{u, v, w} A} (p : ∀ i, P ⟶ N i)
    (hp : IsLimit (Fan.mk P p)) :
    Nonempty (IsLimit (Fan.mk ((toHomotopyCategory A).obj P)
      (fun i => (toHomotopyCategory A).map (p i)))) := by
  classical
  refine ⟨?_⟩
  let q := toHomotopyCategory A
  let g (s : Fan (fun i => q.obj (N i))) : s.pt.as ⟶ P :=
    hp.lift (Fan.mk s.pt.as (fun i => q.preimage (s.proj i)))
  have g_fac (s : Fan (fun i => q.obj (N i))) (i : I) :
      q.map (g s ≫ p i) = s.proj i := by
    rw [show g s ≫ p i = q.preimage (s.proj i) from
      hp.fac (Fan.mk s.pt.as (fun j => q.preimage (s.proj j))) ⟨i⟩, q.map_preimage]
  refine Fan.IsLimit.mk _ (fun s => q.map (g s)) ?_ ?_
  · intro s i
    rw [← g_fac s i]
    exact (q.map_comp _ _).symm
  · intro s m hm
    have hpre : q.map (q.preimage m) = m := q.map_preimage m
    have hcomp (i : I) : q.map (q.preimage m ≫ p i) = q.map (g s ≫ p i) := by
      rw [q.map_comp, hpre, g_fac s i]
      exact hm i
    have hhom : ∀ i, Homotopic (q.preimage m ≫ p i) (g s ≫ p i) := fun i =>
      (CategoryTheory.Quotient.functor_map_eq_iff (homotopyRel A) _ _).mp (hcomp i)
    have hmEq : q.map (q.preimage m) = q.map (g s) :=
      (CategoryTheory.Quotient.functor_map_eq_iff (homotopyRel A) _ _).mpr
        (homotopyIntoProductOfLimits N p hp hhom)
    exact hpre.symm.trans hmEq

private noncomputable def quotientProductCone {I : Type w}
    (F : I → HomotopyCategory.{u, v, w} A) : Fan F := by
  classical
  let f : I → DifferentialGradedModule.{u, v, w} A := fun i => (F i).as
  let q := toHomotopyCategory A
  exact Fan.mk ⟨prodObj f⟩ (fun i => q.map (prodπ f i))

private noncomputable def quotientProductIsLimit {I : Type w}
    (F : I → HomotopyCategory.{u, v, w} A) :
    IsLimit (quotientProductCone F) :=
  (isLimitMapFanToHomotopyCategory _ _ (prodIsLimit fun i => (F i).as)).some

/-- The homotopy category of differential graded modules over a differential graded algebra has
all products. -/
@[stacks 09JR "homotopy_products"]
instance hasProducts_homotopyCategory (A : DifferentialGradedAlgebra.{u, v} R) :
    HasProducts.{w} (HomotopyCategory.{u, v, w} A) :=
  hasProducts_of_limit_fans quotientProductCone quotientProductIsLimit

section Coproduct

variable {I : Type w} (f : I → DifferentialGradedModule.{u, v, w} A)

private theorem mem_coprodGrading {n : ℤ} (x : ↥(coprodSub f)) :
    x ∈ coprodGrading f n ↔ (x : ∀ i, (f i).M) ∈ coprodPn f n := Iff.rfl

variable {T : DifferentialGradedModule.{u, v, w} A} (g : ∀ i, f i ⟶ T)

end Coproduct

private theorem coprodDesc_fac {I : Type w} (f : I → DifferentialGradedModule.{u, v, w} A)
    {T : DifferentialGradedModule.{u, v, w} A} (g : ∀ i, f i ⟶ T) (i : I) :
    coprodι f i ≫ coprodDesc f g = g i :=
  Hom.ext (LinearMap.ext (coprodDescent0_incl f g i))

private def homotopyGenSum {I : Type w} {N : DifferentialGradedModule.{u, v, w} A}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    (h : ∀ i, (f i).M →ₗ[MulOpposite A.A] N.M) (s : Finset I)
    (x : ∀ i, (f i).M) : N.M :=
  ∑ i ∈ s, h i (x i)

private theorem homotopyGenSum_subset {I : Type w} {N : DifferentialGradedModule.{u, v, w} A}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    (h : ∀ i, (f i).M →ₗ[MulOpposite A.A] N.M) (x : ∀ i, (f i).M) (s t : Finset I)
    (hs : {i | x i ≠ 0} ⊆ ↑s) (hst : s ⊆ t) :
    homotopyGenSum f h t x = homotopyGenSum f h s x := by
  refine (Finset.sum_subset hst fun i _ hi => ?_).symm
  rw [not_not.1 fun hn => hi (hs hn), map_zero]

/-- The support of an element of the direct sum lies in the chosen finite support set. -/
private theorem coprodSub_support_subset {I : Type w}
    (f : I → DifferentialGradedModule.{u, v, w} A) (x : ↥(coprodSub f)) :
    {i | (x : ∀ j, (f j).M) i ≠ 0} ⊆ ↑(coprodSub_finite f (x : ∀ j, (f j).M) x.2).toFinset :=
  (Set.Finite.coe_toFinset _).ge

private noncomputable def homotopyDescent0 {I : Type w}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    {N : DifferentialGradedModule.{u, v, w} A}
    (h : ∀ i, (f i).M →ₗ[MulOpposite A.A] N.M) : ↥(coprodSub f) →ₗ[MulOpposite A.A] N.M where
  toFun x := homotopyGenSum f h
    (coprodSub_finite f (x : ∀ i, (f i).M) x.2).toFinset (x : ∀ i, (f i).M)
  map_add' := by
    intro x y
    classical
    let sx := (coprodSub_finite f (x : ∀ i, (f i).M) x.2).toFinset
    let sy := (coprodSub_finite f (y : ∀ i, (f i).M) y.2).toFinset
    let sxy := (coprodSub_finite f (x + y : ∀ i, (f i).M) (x + y).2).toFinset
    let s := sx ∪ (sy ∪ sxy)
    have hx := homotopyGenSum_subset f h _ sx s (coprodSub_support_subset f x)
      Finset.subset_union_left
    have hy := homotopyGenSum_subset f h _ sy s (coprodSub_support_subset f y)
      (Finset.subset_union_left.trans Finset.subset_union_right)
    have hxy := homotopyGenSum_subset f h _ sxy s (coprodSub_support_subset f (x + y))
      (Finset.subset_union_right.trans Finset.subset_union_right)
    change homotopyGenSum f h sxy ((x + y : ↥(coprodSub f)) : ∀ i, (f i).M) =
      homotopyGenSum f h sx (x : ∀ i, (f i).M) + homotopyGenSum f h sy (y : ∀ i, (f i).M)
    rw [← hxy, ← hx, ← hy]
    simp only [homotopyGenSum]
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i _
    simp [map_add]
  map_smul' := by
    intro c x
    classical
    let sx := (coprodSub_finite f (x : ∀ i, (f i).M) x.2).toFinset
    let scx := (coprodSub_finite f (c • x : ∀ i, (f i).M) (c • x).2).toFinset
    let s := sx ∪ scx
    have hx := homotopyGenSum_subset f h _ sx s (coprodSub_support_subset f x)
      Finset.subset_union_left
    have hcx := homotopyGenSum_subset f h _ scx s (coprodSub_support_subset f (c • x))
      Finset.subset_union_right
    change homotopyGenSum f h scx ((c • x : ↥(coprodSub f)) : ∀ i, (f i).M) =
      c • homotopyGenSum f h sx (x : ∀ i, (f i).M)
    rw [← hcx, ← hx]
    simp only [homotopyGenSum, Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp [map_smul]

private theorem homotopyDescent0_eq_genSum {I : Type w}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    {N : DifferentialGradedModule.{u, v, w} A}
    (h : ∀ i, (f i).M →ₗ[MulOpposite A.A] N.M) (x : ↥(coprodSub f)) (s : Finset I)
    (hs : {i | (x : ∀ j, (f j).M) i ≠ 0} ⊆ ↑s) :
    homotopyDescent0 f h x = homotopyGenSum f h s (x : ∀ j, (f j).M) := by
  classical
  show homotopyGenSum f h
      (coprodSub_finite f (x : ∀ j, (f j).M) x.2).toFinset (x : ∀ j, (f j).M) = _
  let sf := (coprodSub_finite f (x : ∀ j, (f j).M) x.2).toFinset
  have hsf := coprodSub_support_subset f x
  by_cases hle : sf ⊆ s
  · exact (homotopyGenSum_subset f h _ sf s hsf hle).symm
  · rw [← homotopyGenSum_subset f h _ sf (sf ∪ s) hsf Finset.subset_union_left,
      ← homotopyGenSum_subset f h _ s (sf ∪ s) hs Finset.subset_union_right]

private theorem homotopyDescent0_inj {I : Type w}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    {N : DifferentialGradedModule.{u, v, w} A}
    (h : ∀ i, (f i).M →ₗ[MulOpposite A.A] N.M) (i : I) (y : (f i).M) :
    homotopyDescent0 f h ((coprodι f i).toFun y) = h i y := by
  classical
  let w : ↥(coprodSub f) := (coprodι f i).toFun y
  have hwi : (w : ∀ k, (f k).M) i = y := by
    show coprodIncl0 f i y i = y
    exact coprodIncl0_apply_self f i y
  have hsupp : {j | (w : ∀ k, (f k).M) j ≠ 0} ⊆ ↑({i} : Finset I) := fun j hj => by
    simpa using not_imp_comm.1 (coprodIncl0_apply_ne f i y j) hj
  rw [homotopyDescent0_eq_genSum f h w {i} hsupp]
  simp [homotopyGenSum, hwi]

private noncomputable def homotopyIntoCoproduct {I : Type w}
    (f : I → DifferentialGradedModule.{u, v, w} A)
    {N : DifferentialGradedModule.{u, v, w} A}
    {g₁ g₂ : coprodObj f ⟶ N}
    (h : ∀ i, Homotopic (coprodι f i ≫ g₁) (coprodι f i ≫ g₂)) :
    Homotopy g₁ g₂ := by
  classical
  let chosen : ∀ i, Homotopy (coprodι f i ≫ g₁) (coprodι f i ≫ g₂) :=
    fun i => Classical.choice (h i)
  let hfun : ↥(coprodSub f) →ₗ[MulOpposite A.A] N.M :=
    homotopyDescent0 f (fun i => (chosen i).toLinearMap)
  refine ⟨hfun, ?_, ?_⟩
  · intro n x hx
    let w : ↥(coprodSub f) := x
    change hfun w ∈ N.grading (n - 1)
    replace hx : (w : ∀ i, (f i).M) ∈ coprodPn f n := hx
    obtain ⟨hfin, hhom⟩ := (mem_coprodPn f (w : ∀ i, (f i).M)).1 hx
    rw [homotopyDescent0_eq_genSum f (fun i => (chosen i).toLinearMap) w hfin.toFinset
      (coprodSub_support_subset f w)]
    simp only [homotopyGenSum]
    refine Submodule.sum_mem _ (fun i _ => (chosen i).map_grading n _ (hhom i))
  · intro x
    classical
    let w : ↥(coprodSub f) := x
    let s := (coprodSub_finite f (w : ∀ i, (f i).M) w.2).toFinset
    have hsx := coprodSub_support_subset f w
    have hdcoord (i : I) : ((coprodD f w : ↥(coprodSub f)) : ∀ j, (f j).M) i =
        (f i).d ((w : ∀ j, (f j).M) i) := by
      change (prodD0 f (w : ∀ j, (f j).M)) i = _
      rw [prodD0_apply]
    have hsdx : {i | ((coprodD f w : ↥(coprodSub f)) : ∀ i, (f i).M) i ≠ 0} ⊆ ↑s := by
      intro i hi
      apply hsx
      simp only [Set.mem_ofPred_eq]
      intro hz
      apply hi
      rw [hdcoord, hz, map_zero]
    have hrepr := coprodSub_repr f w s hsx
    have hleft : g₁.toFun w - g₂.toFun w =
        ∑ i ∈ s, (g₁.toFun ((coprodι f i).toFun ((w : ∀ j, (f j).M) i)) -
          g₂.toFun ((coprodι f i).toFun ((w : ∀ j, (f j).M) i))) := by
      have hg (g : coprodObj f ⟶ N) :
          g.toFun w = ∑ i ∈ s, g.toFun ((coprodι f i).toFun ((w : ∀ j, (f j).M) i)) := by
        simpa only [map_sum] using congrArg g.toFun hrepr
      rw [hg g₁, hg g₂, Finset.sum_sub_distrib]
    change g₁.toFun w - g₂.toFun w = N.d (hfun w) + hfun (coprodD f w)
    dsimp only [hfun]
    rw [homotopyDescent0_eq_genSum f (fun i => (chosen i).toLinearMap) w s hsx,
      homotopyDescent0_eq_genSum f (fun i => (chosen i).toLinearMap) (coprodD f w) s hsdx]
    simp only [homotopyGenSum, map_sum]
    rw [← Finset.sum_add_distrib, hleft]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hi := (chosen i).homotopy_eq ((w : ∀ j, (f j).M) i)
    change (coprodι f i ≫ g₁).toFun _ - (coprodι f i ≫ g₂).toFun _ = _ at hi
    simpa [Hom.comp_toFun_apply, homotopyDescent0_inj, hdcoord] using hi

private noncomputable def quotientCofan {I : Type w}
    (f : I → HomotopyCategory.{u, v, w} A) : Cofan f :=
  let f' : I → DifferentialGradedModule.{u, v, w} A := fun i => (f i).as
  Cofan.mk ((toHomotopyCategory A).obj (coprodObj f'))
    (fun i => (toHomotopyCategory A).map (coprodι f' i))

private noncomputable def quotientCofan_isColimit {I : Type w}
    (f : I → HomotopyCategory.{u, v, w} A) :
    IsColimit (quotientCofan f) := by
  let Q := toHomotopyCategory A
  let f' : I → DifferentialGradedModule.{u, v, w} A := fun i => (f i).as
  have hfac (s : Cofan f) (i : I) :
      Q.map (coprodι f' i) ≫ Q.map (coprodDesc f' (fun i => Q.preimage (s.inj i))) = s.inj i := by
    rw [← Functor.map_comp, coprodDesc_fac, Functor.map_preimage]
  refine Cofan.IsColimit.mk _ (fun s => Q.map (coprodDesc f' (fun i => Q.preimage (s.inj i))))
    hfac (fun s m hm => ?_)
  · let m' : coprodObj f' ⟶ s.pt.as := Q.preimage m
    let desc : coprodObj f' ⟶ s.pt.as := coprodDesc f' (fun i => Q.preimage (s.inj i))
    have hpre : Q.map m' = m := Q.map_preimage m
    rw [← hpre]
    apply (CategoryTheory.Quotient.functor_map_eq_iff (r := homotopyRel A) m' desc).2
    refine ⟨homotopyIntoCoproduct f' (g₁ := m') (g₂ := desc) ?_⟩
    intro i
    apply (CategoryTheory.Quotient.functor_map_eq_iff
      (r := homotopyRel A) (coprodι f' i ≫ m') (coprodι f' i ≫ desc)).1
    have hm_i : Q.map (coprodι f' i) ≫ m = s.inj i := hm i
    rw [Functor.map_comp, Functor.map_comp, hpre, hm_i, hfac s i]

/-- The homotopy category of differential graded modules has direct sums. -/
@[stacks 09JR "homotopy_direct_sums"]
instance hasCoproducts_homotopyCategory (A : DifferentialGradedAlgebra.{u, v} R) :
    HasCoproducts.{w} (HomotopyCategory.{u, v, w} A) :=
  hasCoproducts_of_colimit_cofans quotientCofan quotientCofan_isColimit

end DifferentialGradedModule
