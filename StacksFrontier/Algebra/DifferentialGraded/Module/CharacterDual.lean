module

public import Mathlib.Algebra.Module.CharacterModule
public import StacksFrontier.Algebra.DirectSum.GradedSubmodule
public import StacksFrontier.Algebra.DirectSum.ParityOperator
public import StacksFrontier.Algebra.DifferentialGraded.LeftModule
public import StacksCore.Tactic.StacksAttribute

/-! # The graded `ℚ/ℤ`-dual of a left differential graded module

Let `(A, d)` be a differential graded algebra over a commutative ring `R`. For a *left*
differential graded `A`-module `M`, Stacks 0FQD forms

`M^∨ = Hom^•(M^•, ℚ/ℤ)`,

the graded dual taken into `ℚ/ℤ` placed in degree `0`, and observes that it is a *right*
differential graded `A`-module. This file constructs that module in the bundled
`DifferentialGradedAlgebra` encoding of Stacks Tag 09JJ.

Concretely, `(M^∨)^n` is the group of characters of `M` supported on `M^{-n}`, the right action
is `(λ · a)(x) = λ(a · x)`, and the differential is `λ ↦ -(-1)^n (λ ∘ d_M)` on `(M^∨)^n`.

## Main definitions

* `DifferentialGraded.LeftModule.dualPiece`: the degree-`n` part of the graded dual, as a
  submodule of Mathlib's `CharacterModule`.
* `DifferentialGraded.LeftModule.dual`: the graded dual `M^∨`, a right differential graded
  `A`-module.
* `DifferentialGraded.LeftModule.regular`: the algebra as a left module over itself, whose dual
  is `A^∨` (`DifferentialGradedModule.dualRegularModule`).

## Main results

* `DifferentialGraded.LeftModule.dualD0_charSMul`: the Leibniz rule for the dual differential,
  which is what makes `M^∨` a differential graded module and not merely a complex.
* `DifferentialGraded.LeftModule.dualPiece_iSupIndep`: the graded pieces of the dual are
  independent, so the carrier really is their direct sum.
* `DifferentialGraded.LeftModule.dualPieceEquiv`: the degree-`n` part of `M^∨` is the character
  module of `M^{-n}`, which is the identification Stacks 09K3 and 09K4 are stated through.
* `DifferentialGraded.LeftModule.dualMap`: the graded dual of a homomorphism, contravariantly;
  with `dualMap_id`, `dualMap_comp`, `dualMap_injective` (the dual of a surjection is injective)
  and `dualMap_surjective` (the dual of an injection is surjective).

## Implementation notes

*`ℚ/ℤ` is Mathlib's `CharacterModule`.* A character of an abelian group `X` is an element of
`CharacterModule X = X →+ AddCircle (1 : ℚ)`, and `AddCircle (1 : ℚ)` is `ℚ/ℤ`. Mathlib already
provides the `R`-module structure, the contravariant action `CharacterModule.dual` on linear
maps, and the exactness and separation lemmas; the Tag 09K4 development carries a hand-rolled
copy (`Stacks.DifferentialGradedDual.RDual`) over a different encoding of differential graded
algebras, which is not usable here.

*The carrier is a submodule of the full character module, not a direct sum.* The bundled
encoding demands `DirectSum.Decomposition` of the grading, so the carrier of `M^∨` cannot be all
of `CharacterModule M.M` — that is the *product* of the duals of the graded pieces. It is the
submodule `dualSub M` generated by the homogeneous characters, and the decomposition comes from
`Submodule.inducedGrading` together with the independence of the pieces.

*The sign in the differential.* Writing the dual differential as `λ ↦ ε_n (λ ∘ d_M)` on
`(M^∨)^n`, the right-module Leibniz rule forces `ε_n = -(-1)^n`. This is implemented without
mentioning `n` by precomposing with `signedDifferential M = d_M ∘ DirectSum.parity M.grading`:
a character of
degree `n` is supported on `M^{-n}`, so the only degree at which the sign is seen is `-n-1`,
where the parity operator contributes `(-1)^{-n-1} = -(-1)^n`.

## References

* [Stacks Project, Tag 0FQD](https://stacks.math.columbia.edu/tag/0FQD)
* [Stacks Project, Tag 09K3](https://stacks.math.columbia.edu/tag/09K3)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace DifferentialGraded.LeftModule

variable {R : Type u} [CommRing R] {A : DifferentialGradedAlgebra R}


/-- A left differential graded module is the supremum of its graded pieces. -/
theorem iSup_grading_eq_top (M : LeftModule A) : (⨆ n, M.grading n) = ⊤ :=
  ((DirectSum.isInternal_submodule_iff_iSupIndep_and_iSup_eq_top M.grading).mp
    (DirectSum.Decomposition.isInternal M.grading)).2

/-- A property that holds for every homogeneous element and is closed under zero and addition
holds for every element of a left differential graded module. -/
theorem induction_homogeneous {M : LeftModule A} {p : M.M → Prop} (x : M.M)
    (hmem : ∀ (n : ℤ) (y : M.M), y ∈ M.grading n → p y) (hzero : p 0)
    (hadd : ∀ y z : M.M, p y → p z → p (y + z)) : p x := by
  have hx : x ∈ ⨆ n, M.grading n := by rw [iSup_grading_eq_top]; exact Submodule.mem_top
  induction hx using Submodule.iSup_induction' with
  | mem n y hy => exact hmem n y hy
  | zero => exact hzero
  | add y z _ _ ihy ihz => exact hadd y z ihy ihz

/-- The parity operator followed by the differential: the operator whose `CharacterModule` dual
is the differential of the graded dual. -/
def signedDifferential (M : LeftModule A) : M.M →ₗ[R] M.M :=
  M.d.comp (DirectSum.parity M.grading)

/-- On a homogeneous element of degree `n` the signed differential is `(-1)^n d`. -/
theorem signedDifferential_apply_mem (M : LeftModule A) {n : ℤ} {x : M.M}
    (hx : x ∈ M.grading n) : signedDifferential M x = (n.negOnePow : ℤ) • M.d x := by
  simp [signedDifferential, DirectSum.parity_apply_of_mem M.grading hx]

/-- The signed differential squares to zero: the signs on consecutive degrees are opposite, so
the two factors cancel against `d ∘ d = 0`. -/
theorem signedDifferential_comp_self (M : LeftModule A) :
    (signedDifferential M).comp (signedDifferential M) = 0 := by
  ext x
  refine induction_homogeneous (p := fun y => signedDifferential M (signedDifferential M y) = 0)
    x (fun n y hy => ?_) (by simp) (fun y z hy hz => by simp [hy, hz])
  rw [signedDifferential_apply_mem M hy, map_zsmul,
    signedDifferential_apply_mem M (M.d_mem n y hy)]
  have := LinearMap.congr_fun M.d_comp_d y
  simp only [LinearMap.comp_apply, LinearMap.zero_apply] at this
  simp [this]

/-! ### The right action on characters -/

/-- The right action of `A` on the characters of a left differential graded module:
`(λ · a)(x) = λ (a · x)`. -/
def charSMul (M : LeftModule A) (a : A.Aᵐᵒᵖ) (l : CharacterModule M.M) :
    CharacterModule M.M :=
  l.comp (DistribSMul.toAddMonoidHom M.M a.unop)

/-- The right action of `a` on a character `l` evaluates `l` at `a · x`. -/
@[simp] theorem charSMul_apply (M : LeftModule A) (a : A.Aᵐᵒᵖ) (l : CharacterModule M.M)
    (x : M.M) : charSMul M a l x = l (a.unop • x) := rfl

/-- The characters of a left differential graded `A`-module form a *right* `A`-module. This is
not registered as a global instance: the algebra and the module cannot be recovered from
`CharacterModule M.M`, so it is made available file-locally instead. -/
@[instance_reducible]
def charModule (M : LeftModule A) : Module A.Aᵐᵒᵖ (CharacterModule M.M) where
  smul := charSMul M
  one_smul l := by
    ext x
    change l ((1 : A.Aᵐᵒᵖ).unop • x) = l x
    rw [MulOpposite.unop_one, one_smul]
  mul_smul a b l := by
    ext x
    change l (((a * b : A.Aᵐᵒᵖ)).unop • x) = l (b.unop • (a.unop • x))
    rw [MulOpposite.unop_mul, mul_smul]
  smul_zero a := by ext x; rfl
  smul_add a l l' := by ext x; rfl
  add_smul a b l := by
    ext x
    change l (((a + b : A.Aᵐᵒᵖ)).unop • x) = l (a.unop • x) + l (b.unop • x)
    rw [MulOpposite.unop_add, add_smul, map_add]
  zero_smul l := by
    ext x
    change l ((0 : A.Aᵐᵒᵖ).unop • x) = 0
    rw [MulOpposite.unop_zero, zero_smul, map_zero]

attribute [local instance] charModule

/-- The right action on characters, in terms of the module structure. -/
theorem charModule_smul_apply (M : LeftModule A) (a : A.Aᵐᵒᵖ) (l : CharacterModule M.M)
    (x : M.M) : (a • l) x = l (a.unop • x) := rfl

/-- The right `A`-action on characters is compatible with the base ring, because the image of
`R` in `A` is central. -/
theorem charIsScalarTower (M : LeftModule A) :
    IsScalarTower R A.Aᵐᵒᵖ (CharacterModule M.M) :=
  IsScalarTower.of_algebraMap_smul (fun r l => by
    ext x
    rw [charModule_smul_apply]
    change l ((algebraMap R A.Aᵐᵒᵖ r).unop • x) = l (r • x)
    rw [show (algebraMap R A.Aᵐᵒᵖ r).unop = algebraMap R A.A r from rfl,
      IsScalarTower.algebraMap_smul])

attribute [local instance] charIsScalarTower

/-! ### The graded pieces of the dual -/

/-- The degree-`n` part of the graded dual: the characters of `M` supported on `M^{-n}`. -/
def dualPiece (M : LeftModule A) (n : ℤ) : Submodule R (CharacterModule M.M) where
  carrier := {l | ∀ m : ℤ, m ≠ -n → ∀ x ∈ M.grading m, l x = 0}
  zero_mem' := by intro m _ x _; rfl
  add_mem' := by
    intro l l' hl hl' m hm x hx
    rw [show ((l + l') x) = l x + l' x from rfl, hl m hm x hx, hl' m hm x hx, add_zero]
  smul_mem' := by
    intro r l hl m hm x hx
    rw [CharacterModule.smul_apply]
    exact hl m hm (r • x) ((M.grading m).smul_mem r hx)

/-- Membership in the degree-`n` piece of the dual, unfolded. -/
theorem mem_dualPiece {M : LeftModule A} {n : ℤ} {l : CharacterModule M.M} :
    l ∈ dualPiece M n ↔ ∀ m : ℤ, m ≠ -n → ∀ x ∈ M.grading m, l x = 0 := Iff.rfl

/-- A character lying in the supremum of the graded pieces of degree `≠ n` kills `M^{-n}`. -/
theorem eq_zero_of_mem_iSup_ne_dualPiece {M : LeftModule A} {n : ℤ}
    {l : CharacterModule M.M} (hl : l ∈ ⨆ m, ⨆ (_ : m ≠ n), dualPiece M m)
    {x : M.M} (hx : x ∈ M.grading (-n)) : l x = 0 := by
  induction hl using Submodule.iSup_induction' with
  | mem m z hz =>
      by_cases hmn : m = n
      · rw [hmn] at hz
        simp only [ne_eq, not_true_eq_false, iSup_false, Submodule.mem_bot] at hz
        rw [hz]; rfl
      · rw [iSup_pos hmn] at hz
        exact hz (-n) (fun h => hmn (by omega)) x hx
  | zero => rfl
  | add y z _ _ ihy ihz => rw [show ((y + z) x) = y x + z x from rfl, ihy, ihz, add_zero]


/-- The graded pieces of the dual are independent: a character supported in degree `-n` that
also lies in the span of the other pieces kills every homogeneous element, hence vanishes. -/
theorem dualPiece_iSupIndep (M : LeftModule A) : iSupIndep (dualPiece M) := by
  rw [iSupIndep_def]
  intro n
  rw [Submodule.disjoint_def]
  intro l hl hl'
  ext x
  refine induction_homogeneous (M := M) (p := fun y => l y = 0) x (fun m y hy => ?_)
    (map_zero l) (fun y z hy hz => by rw [map_add l y z, hy, hz, add_zero])
  by_cases hm : m = -n
  · exact eq_zero_of_mem_iSup_ne_dualPiece hl' (hm ▸ hy)
  · exact hl m hm y hy

/-- The carrier of the graded dual, as an `R`-submodule: the characters that are sums of
homogeneous ones. -/
def dualCarrier (M : LeftModule A) : Submodule R (CharacterModule M.M) := ⨆ n, dualPiece M n

/-- Membership in the carrier of the dual, unfolded. -/
theorem mem_dualCarrier {M : LeftModule A} {l : CharacterModule M.M} :
    l ∈ dualCarrier M ↔ l ∈ ⨆ n, dualPiece M n := Iff.rfl

/-- An additive map of character modules that sends each homogeneous character into the carrier of
the dual sends the carrier of the dual into it. -/
private theorem map_mem_dualCarrier {M N : LeftModule A}
    (f : CharacterModule M.M →+ CharacterModule N.M)
    (h : ∀ n, ∀ l ∈ dualPiece M n, f l ∈ dualCarrier N) {l : CharacterModule M.M}
    (hl : l ∈ dualCarrier M) : f l ∈ dualCarrier N := by
  rw [mem_dualCarrier] at hl
  induction hl using Submodule.iSup_induction' with
  | mem n z hz => exact h n z hz
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add z z' _ _ ihz ihz' => rw [map_add]; exact Submodule.add_mem _ ihz ihz'

/-- The right action of a homogeneous element shifts the degree of a homogeneous character. -/
theorem charSMul_mem_dualPiece (M : LeftModule A) {n m : ℤ} {l : CharacterModule M.M}
    (hl : l ∈ dualPiece M n) {a : A.A} (ha : a ∈ A.grading m) :
    charSMul M (MulOpposite.op a) l ∈ dualPiece M (n + m) := by
  intro j hj x hx
  rw [charSMul_apply]
  exact hl (m + j) (by omega) _ (M.smul_mem m j a x ha hx)

/-- The right action by a homogeneous element preserves the carrier of the graded dual. -/
theorem charSMul_mem_dualCarrier_of_mem (M : LeftModule A) {m : ℤ} {a : A.A}
    (ha : a ∈ A.grading m) {l : CharacterModule M.M} (hl : l ∈ dualCarrier M) :
    charSMul M (MulOpposite.op a) l ∈ dualCarrier M := by
  refine map_mem_dualCarrier (AddMonoidHom.mk' (charSMul M (MulOpposite.op a)) fun _ _ => rfl)
    (fun n z hz => ?_) hl
  exact Submodule.mem_iSup_of_mem (n + m) (charSMul_mem_dualPiece M hz ha)

/-- Right action by an algebra element, as an additive map in the algebra element. -/
def charSMulHom (M : LeftModule A) (l : CharacterModule M.M) :
    A.A →+ CharacterModule M.M :=
  AddMonoidHom.mk' (fun a => charSMul M (MulOpposite.op a) l) (fun a b => by
    ext x
    rw [charSMul_apply]
    simp only [MulOpposite.unop_op, add_smul]
    rw [map_add]
    rfl)

/-- The additive map `charSMulHom M l` sends `a` to the right action of `a` on `l`. -/
@[simp] theorem charSMulHom_apply (M : LeftModule A) (l : CharacterModule M.M) (a : A.A) :
    charSMulHom M l a = charSMul M (MulOpposite.op a) l := rfl

/-- The right action by an arbitrary algebra element preserves the carrier of the dual: decompose
the element into homogeneous pieces and apply the homogeneous case to each. -/
theorem charSMul_mem_dualCarrier (M : LeftModule A) (a : A.Aᵐᵒᵖ) {l : CharacterModule M.M}
    (hl : l ∈ dualCarrier M) : charSMul M a l ∈ dualCarrier M := by
  classical
  have hsum : ∑ m ∈ DFinsupp.support (DirectSum.decompose A.grading a.unop),
      ((DirectSum.decompose A.grading a.unop) m : A.A) = a.unop :=
    DirectSum.sum_support_decompose A.grading a.unop
  have key : charSMul M a l
      = ∑ m ∈ DFinsupp.support (DirectSum.decompose A.grading a.unop),
          charSMul M (MulOpposite.op ((DirectSum.decompose A.grading a.unop) m : A.A)) l := by
    have h0 : charSMul M a l = charSMulHom M l a.unop := rfl
    rw [h0]
    conv_lhs => rw [← hsum]
    rw [map_sum]
    rfl
  rw [key]
  exact Submodule.sum_mem _ (fun m _ =>
    charSMul_mem_dualCarrier_of_mem M ((DirectSum.decompose A.grading a.unop) m).2 hl)

/-- The carrier of the graded dual, as a right `A`-submodule of the character module. -/
def dualSub (M : LeftModule A) : Submodule A.Aᵐᵒᵖ (CharacterModule M.M) where
  carrier := {l | l ∈ dualCarrier M}
  zero_mem' := (dualCarrier M).zero_mem
  add_mem' ha hb := (dualCarrier M).add_mem ha hb
  smul_mem' a _ hl := charSMul_mem_dualCarrier M a hl

/-- Restricting the scalars of the dual submodule to `R` recovers the `R`-submodule generated by
the homogeneous characters. -/
theorem dualSub_restrictScalars (M : LeftModule A) :
    (dualSub M).restrictScalars R = dualCarrier M := by
  apply SetLike.coe_injective; rfl

/-! ### The dual differential -/

/-- The differential of the graded dual: precomposition with `signedDifferential`. -/
def dualD0 (M : LeftModule A) : CharacterModule M.M →ₗ[R] CharacterModule M.M :=
  CharacterModule.dual (signedDifferential M)

/-- The dual differential of a character `l` evaluates `l` on `signedDifferential M x`. -/
@[simp] theorem dualD0_apply (M : LeftModule A) (l : CharacterModule M.M) (x : M.M) :
    dualD0 M l x = l (signedDifferential M x) := rfl

/-- The dual differential raises the degree of a homogeneous character by one. -/
theorem dualD0_mem_dualPiece (M : LeftModule A) {n : ℤ} {l : CharacterModule M.M}
    (hl : l ∈ dualPiece M n) : dualD0 M l ∈ dualPiece M (n + 1) := by
  intro j hj x hx
  rw [dualD0_apply, signedDifferential_apply_mem M hx, map_zsmul,
    hl (j + 1) (by omega) _ (M.d_mem j x hx), smul_zero]

/-- The dual differential preserves the carrier of the dual. -/
theorem dualD0_mem_dualCarrier (M : LeftModule A) {_l : CharacterModule M.M}
    (hl : _l ∈ dualCarrier M) : dualD0 M _l ∈ dualCarrier M := by
  exact map_mem_dualCarrier (dualD0 M).toAddMonoidHom
    (fun n z hz => Submodule.mem_iSup_of_mem (n + 1) (dualD0_mem_dualPiece M hz)) hl

/-- The dual differential squares to zero. -/
theorem dualD0_comp_dualD0 (M : LeftModule A) : (dualD0 M).comp (dualD0 M) = 0 := by
  rw [dualD0, ← CharacterModule.dual_comp, signedDifferential_comp_self,
    CharacterModule.dual_zero]

/-- The sign identity behind the cancellation in the Leibniz rule for the dual: when the degree
at which the `d a` term can be nonzero is actually hit, the two contributions are opposite. -/
theorem negOnePow_cancel {m j n : ℤ} (h : m + 1 + j = -n) :
    ((m + j).negOnePow : ℤ) + (n.negOnePow : ℤ) = 0 := by
  have hj : m + j = -n - 1 := by omega
  rw [hj, show (-n - 1 : ℤ) = -(n + 1) by ring, Int.negOnePow_neg, Int.negOnePow_succ]
  simp

/-- Multiplicativity of the Koszul sign, in the form the Leibniz rule for the dual needs. -/
theorem negOnePow_split (m j : ℤ) :
    ((m + j).negOnePow : ℤ) * (m.negOnePow : ℤ) = (j.negOnePow : ℤ) := by
  have h : (m + j).negOnePow * m.negOnePow = j.negOnePow := by
    rw [Int.negOnePow_add, mul_comm m.negOnePow j.negOnePow, mul_assoc, Int.units_mul_self,
      mul_one]
  exact_mod_cast congrArg Units.val h

/-- Integer scaling of a character is pointwise. -/
theorem zsmul_char_apply (M : LeftModule A) (c : ℤ) (ch : CharacterModule M.M) (y : M.M) :
    (c • ch) y = c • ch y := rfl

/-- The Leibniz rule for the graded dual, at the level of characters. -/
theorem dualD0_charSMul (M : LeftModule A) {n m : ℤ} {l : CharacterModule M.M}
    (hl : l ∈ dualPiece M n) {a : A.A} (ha : a ∈ A.grading m) :
    dualD0 M (charSMul M (MulOpposite.op a) l)
      = charSMul M (MulOpposite.op a) (dualD0 M l)
        + (n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l := by
  ext y
  refine induction_homogeneous (M := M) (p := fun z =>
    dualD0 M (charSMul M (MulOpposite.op a) l) z
      = (charSMul M (MulOpposite.op a) (dualD0 M l)
        + (n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l) z)
    y (fun j z hz => ?_) (by simp) (fun z z' hz hz' => by
      rw [map_add, map_add, hz, hz'])
  set u := l ((A.d a) • z) with hu
  set v := l (a • M.d z) with hv
  have hlhs : dualD0 M (charSMul M (MulOpposite.op a) l) z = (j.negOnePow : ℤ) • v := by
    rw [dualD0_apply, signedDifferential_apply_mem M hz, map_zsmul]
    rfl
  have e1 : (charSMul M (MulOpposite.op a) (dualD0 M l)) z
      = ((m + j).negOnePow : ℤ) • u + (j.negOnePow : ℤ) • v := by
    rw [charSMul_apply, dualD0_apply]
    simp only [MulOpposite.unop_op]
    rw [signedDifferential_apply_mem M (M.smul_mem m j a z ha hz), map_zsmul,
      M.leibniz m j a z ha hz, map_add, map_zsmul, smul_add, smul_smul, negOnePow_split]
  have e2 : ((n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l) z
      = (n.negOnePow : ℤ) • u := by
    rw [zsmul_char_apply, charSMul_apply]
    rfl
  have hrhs : (charSMul M (MulOpposite.op a) (dualD0 M l)
      + (n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l) z
      = (((m + j).negOnePow : ℤ) + (n.negOnePow : ℤ)) • u + (j.negOnePow : ℤ) • v := by
    rw [show ((charSMul M (MulOpposite.op a) (dualD0 M l)
        + (n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l) z
        = (charSMul M (MulOpposite.op a) (dualD0 M l)) z
          + ((n.negOnePow : ℤ) • charSMul M (MulOpposite.op (A.d a)) l) z) from rfl,
      e1, e2, add_smul]
    abel
  rw [hlhs, hrhs]
  by_cases hc : m + 1 + j = -n
  · rw [negOnePow_cancel hc, zero_smul, zero_add]
  · have hu0 : u = 0 := by
      rw [hu]
      exact hl (m + 1 + j) hc _ (M.smul_mem (m + 1) j (A.d a) z (A.d_mem m a ha) hz)
    rw [hu0, smul_zero, zero_add]

/-- **The graded `ℚ/ℤ`-dual.** -/
def dual (M : LeftModule A) : DifferentialGradedModule A where
  M := ↥(dualSub M)
  isScalarTower := IsScalarTower.of_algebraMap_smul (fun r x => Subtype.ext
    (IsScalarTower.algebraMap_smul A.Aᵐᵒᵖ r (x : CharacterModule M.M)))
  grading := Submodule.inducedGrading (dualPiece M) ((dualSub M).restrictScalars R)
  decomposition := Submodule.inducedGrading.decompositionOfEqISup (dualPiece M)
    (dualPiece_iSupIndep M) ((dualSub M).restrictScalars R) (dualSub_restrictScalars M)
  smul_mem := by
    intro n m x a hx ha
    exact Submodule.mem_inducedGrading.mpr
      (charSMul_mem_dualPiece M (Submodule.mem_inducedGrading.mp hx) ha)
  d := LinearMap.restrict (dualD0 M) (p := (dualSub M).restrictScalars R)
    (q := (dualSub M).restrictScalars R) (fun x hx => dualD0_mem_dualCarrier M hx)
  d_comp_d := LinearMap.ext (fun x => Subtype.ext
    (LinearMap.congr_fun (dualD0_comp_dualD0 M) (x : CharacterModule M.M)))
  d_mem := by
    intro n x hx
    exact Submodule.mem_inducedGrading.mpr
      (dualD0_mem_dualPiece M (Submodule.mem_inducedGrading.mp hx))
  leibniz := by
    intro n m x a hx ha
    exact Subtype.ext (dualD0_charSMul M (Submodule.mem_inducedGrading.mp hx) ha)

/-! ### Reading the graded dual elementwise -/

/-- A point of the graded dual `M^∨`, read as a character of `M`. -/
def dualChar {M : LeftModule A} (x : (dual M).M) : CharacterModule M.M :=
  (show ↥(dualSub M) from x).1

/-- A point of the dual is determined by the character underlying it. -/
theorem dualChar_injective {M : LeftModule A} : Function.Injective (dualChar (M := M)) :=
  fun _ _ h => Subtype.ext (p := fun l => l ∈ dualCarrier M) h

/-- The character underlying a point of the dual is a sum of homogeneous characters. -/
theorem dualChar_mem {M : LeftModule A} (x : (dual M).M) : dualChar x ∈ dualCarrier M :=
  (show ↥(dualSub M) from x).2

/-- The character underlying the zero of `M^∨` is the zero character. -/
@[simp] theorem dualChar_zero {M : LeftModule A} : dualChar (0 : (dual M).M) = 0 := rfl

/-- The character underlying a sum in `M^∨` is the sum of the underlying characters. -/
@[simp] theorem dualChar_add {M : LeftModule A} (x y : (dual M).M) :
    dualChar (x + y) = dualChar x + dualChar y := rfl

/-- The character underlying `r • x` in `M^∨` is `r` times the character underlying `x`. -/
@[simp] theorem dualChar_smul {M : LeftModule A} (r : R) (x : (dual M).M) :
    dualChar (r • x) = r • dualChar x := rfl

/-- Homogeneity in `M^∨` is support of the underlying character in a single degree. -/
theorem mem_dual_grading {M : LeftModule A} {n : ℤ} {x : (dual M).M} :
    x ∈ (dual M).grading n ↔ dualChar x ∈ dualPiece M n :=
  Submodule.mem_inducedGrading

/-- The differential of `M^∨`, read on underlying characters. -/
theorem dualChar_d {M : LeftModule A} (x : (dual M).M) :
    dualChar ((dual M).d x) = dualD0 M (dualChar x) := rfl

/-- The right action on `M^∨`, read on underlying characters. -/
theorem dualChar_op_smul {M : LeftModule A} (a : A.A) (x : (dual M).M) :
    dualChar (MulOpposite.op a • x) = charSMul M (MulOpposite.op a) (dualChar x) := rfl

/-- A homogeneous-sum character of `M`, read as a point of `M^∨`. -/
def dualOf {M : LeftModule A} (l : CharacterModule M.M) (hl : l ∈ dualCarrier M) :
    (dual M).M := ⟨l, hl⟩

/-- The character underlying `dualOf l hl` is `l`. -/
@[simp] theorem dualChar_dualOf {M : LeftModule A} (l : CharacterModule M.M)
    (hl : l ∈ dualCarrier M) : dualChar (dualOf l hl) = l := rfl

/-- Every sum of homogeneous characters is the character underlying a point of `M^∨`. -/
theorem dualChar_surjective {M : LeftModule A} {l : CharacterModule M.M}
    (hl : l ∈ dualCarrier M) : ∃ x : (dual M).M, dualChar x = l := ⟨dualOf l hl, rfl⟩

/-! ### The degree-`n` part of the dual -/

/-- Restriction of a homogeneous character to the graded piece it is supported on. -/
def dualPieceRestrict (M : LeftModule A) (n : ℤ) :
    dualPiece M n →ₗ[R] CharacterModule (M.grading (-n)) where
  toFun l := CharacterModule.dual (M.grading (-n)).subtype (l : CharacterModule M.M)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Restriction to the supporting graded piece, applied to an element. -/
theorem dualPieceRestrict_apply (M : LeftModule A) (n : ℤ) (l : dualPiece M n)
    (x : M.grading (-n)) : dualPieceRestrict M n l x = (l : CharacterModule M.M) (x : M.M) :=
  rfl

/-- A homogeneous character is determined by its restriction. -/
theorem dualPieceRestrict_injective (M : LeftModule A) (n : ℤ) :
    Function.Injective (dualPieceRestrict M n) := by
  intro l l' h
  apply Subtype.ext
  ext x
  refine induction_homogeneous (M := M)
    (p := fun y => (l : CharacterModule M.M) y = (l' : CharacterModule M.M) y) x
    (fun m y hy => ?_) (by simp) (fun y z hy hz => by rw [map_add, map_add, hy, hz])
  by_cases hm : m = -n
  · have hy' : y ∈ M.grading (-n) := hm ▸ hy
    simpa only [dualPieceRestrict_apply] using DFunLike.congr_fun h ⟨y, hy'⟩
  · rw [l.2 m hm y hy, l'.2 m hm y hy]

/-- Extension of a character of `M^{-n}` to a character of `M`, by zero on the other graded
pieces. -/
def extendChar (M : LeftModule A) (n : ℤ) (μ : CharacterModule (M.grading (-n))) :
    CharacterModule M.M :=
  μ.comp ((DFinsupp.evalAddMonoidHom (-n)).comp
    (DirectSum.decomposeAddEquiv M.grading).toAddMonoidHom)

/-- The extension by zero of `μ` evaluates `μ` on the degree-`(-n)` component of `x`. -/
@[simp] theorem extendChar_apply (M : LeftModule A) (n : ℤ)
    (μ : CharacterModule (M.grading (-n))) (x : M.M) :
    extendChar M n μ x = μ ((DirectSum.decompose M.grading x) (-n)) := rfl

/-- A character extended by zero from `M^{-n}` is homogeneous of degree `n`. -/
theorem extendChar_mem (M : LeftModule A) (n : ℤ) (μ : CharacterModule (M.grading (-n))) :
    extendChar M n μ ∈ dualPiece M n := by
  intro m hm y hy
  rw [extendChar_apply, show ((DirectSum.decompose M.grading y) (-n)) = 0 from
    Subtype.ext (DirectSum.decompose_of_mem_ne M.grading hy hm), map_zero]

/-- Every character of `M^{-n}` is the restriction of a homogeneous character of degree `n`,
namely of its extension by zero. -/
theorem dualPieceRestrict_surjective (M : LeftModule A) (n : ℤ) :
    Function.Surjective (dualPieceRestrict M n) := by
  intro μ
  refine ⟨⟨extendChar M n μ, extendChar_mem M n μ⟩, ?_⟩
  ext x
  rw [dualPieceRestrict_apply]
  change extendChar M n μ (x : M.M) = μ x
  rw [extendChar_apply,
    show ((DirectSum.decompose M.grading (x : M.M)) (-n)) = x from
      Subtype.ext (DirectSum.decompose_of_mem_same M.grading x.2)]

/-- **The degree-`n` part of `M^∨` is the character module of `M^{-n}`.** -/
def dualPieceEquiv (M : LeftModule A) (n : ℤ) :
    dualPiece M n ≃ₗ[R] CharacterModule (M.grading (-n)) :=
  LinearEquiv.ofBijective (dualPieceRestrict M n)
    ⟨dualPieceRestrict_injective M n, dualPieceRestrict_surjective M n⟩

/-! ### Functoriality of the graded dual -/

/-- A homomorphism of left differential graded modules commutes with the parity operators,
because it preserves degrees. -/
theorem parity_comm {M N : LeftModule A} (f : M ⟶ N) (x : M.M) :
    f.toFun (DirectSum.parity M.grading x) = DirectSum.parity N.grading (f.toFun x) := by
  refine induction_homogeneous (M := M)
    (p := fun y => f.toFun (DirectSum.parity M.grading y)
      = DirectSum.parity N.grading (f.toFun y)) x (fun n y hy => ?_)
    (by simp) (fun y z hy hz => by simp only [map_add, hy, hz])
  rw [DirectSum.parity_apply_of_mem M.grading hy, map_zsmul,
    DirectSum.parity_apply_of_mem N.grading (f.map_grading n y hy)]

/-- A homomorphism of left differential graded modules commutes with the signed differentials. -/
theorem signedDifferential_comm {M N : LeftModule A} (f : M ⟶ N) (x : M.M) :
    f.toFun (signedDifferential M x) = signedDifferential N (f.toFun x) := by
  rw [signedDifferential, signedDifferential, LinearMap.comp_apply, LinearMap.comp_apply,
    ← parity_comm f x]
  exact LinearMap.congr_fun f.map_d (DirectSum.parity M.grading x)

/-- A character of `N` pulled back along `f : M ⟶ N` stays homogeneous of the same degree. -/
theorem dual_mem_dualPiece {M N : LeftModule A} (f : M ⟶ N) {n : ℤ}
    {l : CharacterModule N.M} (hl : l ∈ dualPiece N n) :
    CharacterModule.dual f.toFun l ∈ dualPiece M n :=
  fun m hm x hx => hl m hm _ (f.map_grading m x hx)

/-- Pulling a sum of homogeneous characters back along a homomorphism gives a sum of
homogeneous characters. -/
theorem dual_mem_dualCarrier {M N : LeftModule A} (f : M ⟶ N)
    {l : CharacterModule N.M} (hl : l ∈ dualCarrier N) :
    CharacterModule.dual f.toFun l ∈ dualCarrier M := by
  exact map_mem_dualCarrier (CharacterModule.dual f.toFun).toAddMonoidHom
    (fun n z hz => Submodule.mem_iSup_of_mem n (dual_mem_dualPiece f hz)) hl

/-- The underlying map of the graded dual of a homomorphism. -/
def dualMapFun {M N : LeftModule A} (f : M ⟶ N) : (dual N).M →ₗ[R] (dual M).M :=
  LinearMap.restrict (CharacterModule.dual f.toFun)
    (p := (dualSub N).restrictScalars R) (q := (dualSub M).restrictScalars R)
    (fun _ hl => dual_mem_dualCarrier f hl)

/-- The character underlying `dualMapFun f x` is the character underlying `x` composed with
`f`. -/
@[simp] theorem dualChar_dualMapFun {M N : LeftModule A} (f : M ⟶ N) (x : (dual N).M) (y : M.M) :
    dualChar (dualMapFun f x) y = dualChar x (f.toFun y) := rfl

/-- The graded dual of a homomorphism of left differential graded modules: a homomorphism
`N^∨ ⟶ M^∨` of right differential graded modules. -/
def dualMap {M N : LeftModule A} (f : M ⟶ N) : dual N ⟶ dual M where
  toFun := dualMapFun f
  map_smul x a := dualChar_injective (by
    ext y
    rw [dualChar_op_smul, charSMul_apply, dualChar_dualMapFun, dualChar_dualMapFun,
      dualChar_op_smul, charSMul_apply, MulOpposite.unop_op, f.map_smul])
  map_grading n x hx :=
    mem_dual_grading.mpr (dual_mem_dualPiece f (mem_dual_grading.mp hx))
  map_d := LinearMap.ext (fun x => dualChar_injective (by
    ext y
    rw [LinearMap.comp_apply, LinearMap.comp_apply, dualChar_dualMapFun, dualChar_d,
      dualChar_d, dualD0_apply, dualD0_apply, dualChar_dualMapFun,
      signedDifferential_comm f y]))

/-- The character underlying `(dualMap f).toFun x` is the character underlying `x` composed
with `f`. -/
@[simp] theorem dualChar_dualMap {M N : LeftModule A} (f : M ⟶ N) (x : (dual N).M) (y : M.M) :
    dualChar ((dualMap f).toFun x) y = dualChar x (f.toFun y) := rfl

/-- The graded dual of a surjection is injective. -/
theorem dualMap_injective {M N : LeftModule A} (f : M ⟶ N) (hf : Function.Surjective f.toFun) :
    Function.Injective (dualMap f).toFun := by
  intro x x' h
  refine dualChar_injective ?_
  ext y
  obtain ⟨z, rfl⟩ := hf y
  rw [← dualChar_dualMap f x z, ← dualChar_dualMap f x' z, h]

/-- The graded dual of the identity of `M` is the identity of `M^∨`. -/
@[simp] theorem dualMap_id (M : LeftModule A) : dualMap (𝟙 M) = 𝟙 (dual M) :=
  DifferentialGradedModule.Hom.ext (LinearMap.ext fun _ => dualChar_injective (by ext; rfl))

/-- The graded dual is contravariant on composites. -/
theorem dualMap_comp {M N P : LeftModule A} (f : M ⟶ N) (g : N ⟶ P) :
    dualMap (f ≫ g) = dualMap g ≫ dualMap f :=
  DifferentialGradedModule.Hom.ext (LinearMap.ext fun _ => dualChar_injective (by ext; rfl))

/-! ### Graded pieces of a homomorphism, and extension of characters -/

/-- A homomorphism of left differential graded modules, restricted to a graded piece. -/
def Hom.gradedMap {M N : LeftModule A} (f : M ⟶ N) (n : ℤ) :
    M.grading n →ₗ[R] N.grading n :=
  (f.toFun.comp (M.grading n).subtype).codRestrict _ (fun x => f.map_grading n x x.2)

/-- The restriction of `f` to the degree-`n` piece agrees with `f` on underlying elements. -/
@[simp] theorem Hom.gradedMap_apply {M N : LeftModule A} (f : M ⟶ N) (n : ℤ)
    (x : M.grading n) : (Hom.gradedMap f n x : N.M) = f.toFun (x : M.M) := rfl

/-- An injective homomorphism is injective on each graded piece. -/
theorem Hom.gradedMap_injective {M N : LeftModule A} (f : M ⟶ N)
    (hf : Function.Injective f.toFun) (n : ℤ) : Function.Injective (Hom.gradedMap f n) :=
  fun _ _ h => Subtype.ext (hf (congrArg Subtype.val h))

/-- The graded dual of an injection is surjective: a homogeneous character of `M` of degree `n`
extends to one of `N`, because `M^{-n} → N^{-n}` is injective and `ℚ/ℤ` is an injective
cogenerator of the abelian groups. -/
theorem exists_dualPiece_extension {M N : LeftModule A} (f : M ⟶ N)
    (hf : Function.Injective f.toFun) {n : ℤ} {l : CharacterModule M.M}
    (hl : l ∈ dualPiece M n) :
    ∃ l' ∈ dualPiece N n, ∀ z : M.M, l' (f.toFun z) = l z := by
  obtain ⟨ν, hν⟩ := CharacterModule.dual_surjective_of_injective (Hom.gradedMap f (-n))
    (Hom.gradedMap_injective f hf (-n)) (dualPieceRestrict M n ⟨l, hl⟩)
  refine ⟨extendChar N n ν, extendChar_mem N n ν, fun z => ?_⟩
  refine induction_homogeneous (M := M) (p := fun w => extendChar N n ν (f.toFun w) = l w) z
    (fun m w hw => ?_) (by simp) (fun w w' hw hw' => by
      rw [map_add, map_add, hw, hw']
      exact (map_add l w w').symm)
  by_cases hm : m = -n
  · have hfw : f.toFun w ∈ N.grading (-n) := hm ▸ f.map_grading m w hw
    rw [extendChar_apply, show ((DirectSum.decompose N.grading (f.toFun w)) (-n))
        = ⟨f.toFun w, hfw⟩ from Subtype.ext (DirectSum.decompose_of_mem_same N.grading hfw)]
    have hw' : w ∈ M.grading (-n) := hm ▸ hw
    calc ν ⟨f.toFun w, hfw⟩
        = ν ((Hom.gradedMap f (-n)) ⟨w, hw'⟩) := by rw [show
            (Hom.gradedMap f (-n)) ⟨w, hw'⟩ = (⟨f.toFun w, hfw⟩ : N.grading (-n)) from
            Subtype.ext rfl]
      _ = (CharacterModule.dual (Hom.gradedMap f (-n)) ν) ⟨w, hw'⟩ := rfl
      _ = (dualPieceRestrict M n ⟨l, hl⟩) ⟨w, hw'⟩ := by rw [hν]
      _ = l w := dualPieceRestrict_apply M n ⟨l, hl⟩ ⟨w, hw'⟩
  · rw [extendChar_apply, show ((DirectSum.decompose N.grading (f.toFun w)) (-n)) = 0 from
      Subtype.ext (DirectSum.decompose_of_mem_ne N.grading (f.map_grading m w hw) hm),
      map_zero, hl m hm w hw]

/-- **The graded dual of an injection is surjective.** Every sum of homogeneous characters of
`M` extends to one of `N`, degree by degree. -/
theorem dualMap_surjective {M N : LeftModule A} (f : M ⟶ N)
    (hf : Function.Injective f.toFun) : Function.Surjective (dualMap f).toFun := by
  intro x
  have key : ∀ l ∈ dualCarrier M,
      ∃ y : (dual N).M, ∀ z : M.M, dualChar y (f.toFun z) = l z := by
    intro l hl
    rw [mem_dualCarrier] at hl
    induction hl using Submodule.iSup_induction' with
    | mem n z hz =>
        obtain ⟨l', hl', hz'⟩ := exists_dualPiece_extension f hf hz
        exact ⟨dualOf l' (Submodule.mem_iSup_of_mem n hl'), hz'⟩
    | zero => exact ⟨0, fun z => rfl⟩
    | add z z' _ _ ihz ihz' =>
        obtain ⟨y, hy⟩ := ihz
        obtain ⟨y', hy'⟩ := ihz'
        exact ⟨y + y', fun w => by
          rw [dualChar_add]
          change dualChar y (f.toFun w) + dualChar y' (f.toFun w) = _
          rw [hy, hy']
          rfl⟩
  obtain ⟨y, hy⟩ := key (dualChar x) (dualChar_mem x)
  exact ⟨y, dualChar_injective (by ext z; rw [dualChar_dualMap]; exact hy z)⟩

/-! ### The regular left module and its dual -/

/-- The regular left differential graded module: the algebra acting on itself on the left.
This is the left-handed counterpart of `DifferentialGradedModule.regularModule`. -/
abbrev regular (A : DifferentialGradedAlgebra R) : LeftModule A where
  M := A.A
  grading := A.grading
  d := A.d
  d_comp_d := A.d_comp_d
  d_mem := A.d_mem
  smul_mem := by
    intro m n a x ha hx
    simpa using SetLike.mul_mem_graded ha hx
  leibniz := by
    intro m n a x ha hx
    simpa using A.leibniz m n a x ha hx


end LeftModule

end DifferentialGraded

namespace DifferentialGradedModule

variable {R : Type u} [CommRing R]

/-- `A^∨`, the graded `ℚ/ℤ`-dual of the differential graded algebra, viewed as a *right*
differential graded `A`-module. This is the module denoted `A^∨` in Stacks 0FQD, and the
building block of the property-(I) filtrations of Stacks 09KQ. -/
def dualRegularModule (A : DifferentialGradedAlgebra R) : DifferentialGradedModule A :=
  DifferentialGraded.LeftModule.dual (DifferentialGraded.LeftModule.regular A)

end DifferentialGradedModule

end
