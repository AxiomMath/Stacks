module

public import StacksFrontier.Algebra.DifferentialGraded.Module.CompactCountableCohomology
public import StacksFrontier.Algebra.DifferentialGraded.Module.DerivedHomCoproducts
import all StacksFrontier.Algebra.DifferentialGraded.Module.CompactCountableConverse

/-!
# Countable cell towers in compactly generated pre-triangulated categories

Let `D` be a pre-triangulated category with direct sums, generated by the shifts of one compact
object `G` whose shifts map countably into every compact object. An object `M` with every
`Hom(G[m], M)` countable is a derived colimit `hocolim Eₙ` of compact objects `Eₙ`. This is the
cell tower of the (2) ⇒ (1) part of [Stacks, Tag 0CRM], built at this generality.

## Main results

In the namespace `CategoryTheory.Pretriangulated.CountableCells`:

* `exists_isHomotopyColimit_isCompactObject_of_countable_hom`:
  the derived colimit presentation by compact objects.
* `exists_isCompactObject_comp_eq_forall_comp_eq_zero`:
  finitely many dead cells of a compact approximation of `M` are killed by one cell attachment,
  the attached object staying compact.

## Implementation notes

A stage `Eₙ` carries a surjection `ℕ → {cells of Eₙ}`; the step to `Eₙ₊₁` attaches the `n`-th
cell of `M` and kills the dead cells among the first `4ⁿ`, re-indexing the old cells at even
places, so every dead cell enters the window at a later stage. The gluing is
`CategoryTheory.Pretriangulated.isHomotopyColimit_of_forall_fac_of_forall_eventually_eq_zero`
([Stacks, Tag 09SN]).

## References

* [Stacks Project, Tag 0CRM](https://stacks.math.columbia.edu/tag/0CRM),
  [Tag 09SN](https://stacks.math.columbia.edu/tag/09SN).
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe w v' u'

namespace CategoryTheory.Pretriangulated.CountableCells

variable {D : Type u'} [Category.{v'} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{w} D]

variable (G : D)

/-! ### Cells -/

/-- A **cell** of an object `X`: a degree `m` together with a morphism `G[m] ⟶ X` out of the
corresponding shift of the generator. These are exactly the morphisms against which the
generation criterion is tested. -/
private abbrev Cell (X : D) :=
  Σ m : ℤ, (G⟦m⟧ ⟶ X)

/-- A cell of `X` pushed forward along a morphism `X ⟶ Y`. -/
private def pushCell {X Y : D} (f : X ⟶ Y) (t : Cell G X) : Cell G Y :=
  ⟨t.1, t.2 ≫ f⟩

omit [Preadditive D] [HasZeroObject D] [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [Pretriangulated D] [HasCoproducts D] in
/-- Pushing forward twice is pushing forward along the composition. -/
private theorem pushCell_pushCell {X Y Z : D} (f : X ⟶ Y) (g : Y ⟶ Z)
    (t : Cell G X) : pushCell G g (pushCell G f t) = pushCell G (f ≫ g) t := by
  simp [pushCell]

omit [Preadditive D] [HasZeroObject D] [∀ (n : ℤ), (shiftFunctor D n).Additive]
  [Pretriangulated D] [HasCoproducts D] in
/-- An object receiving countably many morphisms from each shift of `G` has countably many
cells. -/
private theorem countable_cell (X : D) (hX : ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X)) :
    Countable (Cell G X) :=
  @instCountableSigma _ _ _ hX

omit [HasZeroObject D] [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated D]
  [HasCoproducts D] in
/-- **The cells of an object with countably many cells can be enumerated.** The set of cells is
nonempty because the zero morphism is one. -/
private theorem exists_surjective_cell (X : D) (hX : ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X)) :
    ∃ e : ℕ → Cell G X, Function.Surjective e :=
  have := countable_cell G X hX
  have : Nonempty (Cell G X) := ⟨⟨0, 0⟩⟩
  exists_surjective_nat _

/-! ### Attaching finitely many cells at once -/

/-- **Finitely many cells dying in `M` can be killed by a single cell attachment.** Let `E` be a
compact object of `D(A, d)` and `u : E ⟶ M` a morphism, and let `ρ j : A[m j] ⟶ E` be a finite
family of morphisms all of which `u` annihilates. Then there is a morphism `f : E ⟶ E'` into a
compact object through which `u` factors and which kills every `ρ j`.

The object `E'` is the cone on the morphism `∐ⱼ G[m j] ⟶ E` assembled from the `ρ j`; it is
compact because a finite direct sum of compact objects is compact
(`CategoryTheory.isCompactObject_sigma`) and the third vertex of a distinguished triangle on
compact objects is compact (Tag 07LS). This is the simultaneous form of
`DifferentialGradedModule.exists_isCompactObject_comp_eq_cohomologyFunctor_map_eq_zero`, which
kills one prescribed cohomology class; attaching finitely many cells at a time, rather than all
of them, is what keeps the stages of the tower below compact. -/
theorem exists_isCompactObject_comp_eq_forall_comp_eq_zero (hGc : IsCompactObject.{w} G)
    {M E : D} (hE : IsCompactObject.{w} E) (u : E ⟶ M) {J : Type w}
    [Finite J] (m : J → ℤ) (ρ : ∀ j, G⟦m j⟧ ⟶ E) (hρ : ∀ j, ρ j ≫ u = 0) :
    ∃ (E' : D) (f : E ⟶ E') (u' : E' ⟶ M),
      IsCompactObject.{w} E' ∧ f ≫ u' = u ∧ ∀ j, ρ j ≫ f = 0 := by
  have hP : IsCompactObject.{w} G := hGc
  have hZ : IsCompactObject.{w} (∐ fun j => G⟦m j⟧) :=
    isCompactObject_sigma _ fun j => isCompactObject_shift hP (m j)
  have hcu : Limits.Sigma.desc ρ ≫ u = 0 := by
    refine Limits.Sigma.hom_ext _ _ fun j => ?_
    rw [← Category.assoc, Limits.Sigma.ι_comp_desc, hρ j, comp_zero]
  obtain ⟨E', f, w, hT⟩ := Pretriangulated.distinguished_cocone_triangle (Limits.Sigma.desc ρ)
  obtain ⟨u', hu'⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hT u hcu
  refine ⟨E', f, u', isCompactObject_obj₃ _ hT hZ hE, hu'.symm, fun j => ?_⟩
  have h0 : Limits.Sigma.desc ρ ≫ f = 0 := Pretriangulated.comp_distTriang_mor_zero₁₂ _ hT
  rw [← Limits.Sigma.ι_comp_desc ρ j, Category.assoc, h0, comp_zero]

/-! ### Stages of the tower -/

/-- A **stage** of the approximation of `M` by compact objects: a compact object with a morphism
to `M`, together with an enumeration of its cells. The enumeration is part of the data rather
than produced on demand, because the diagonal argument has to compare the enumerations of
different stages. -/
private structure Stage (M : D) where
  /-- the object of the stage -/
  obj : D
  /-- the object of the stage is compact -/
  compact : IsCompactObject.{w} obj
  /-- the structure morphism to `M` -/
  hom : obj ⟶ M
  /-- an enumeration of the cells of the stage -/
  enum : ℕ → Cell G obj
  /-- the enumeration is onto -/
  enum_surjective : Function.Surjective enum

/-- One step of the tower out of the stage `s`, the `n`-th step, attaching the cell `t` of `M`:
the next stage, the transition morphism, and the three properties the diagonal argument needs —
the dead cells in the window `4 ^ n` of the current enumeration die, the new enumeration extends
the pushforward of the current one along the even indices, and the prescribed cell `t` of `M` is
reached from the new stage. -/
private structure StepData {M : D} (s : Stage.{w} G M) (n : ℕ)
    (t : Cell G M) where
  /-- the next stage -/
  next : Stage.{w} G M
  /-- the transition morphism -/
  hom : s.obj ⟶ next.obj
  /-- the structure morphisms are compatible with the transition -/
  comm : hom ≫ next.hom = s.hom
  /-- a cell in the window which dies in `M` dies in the next stage -/
  kill : ∀ j : ℕ, j < 4 ^ n → (s.enum j).2 ≫ s.hom = 0 → (s.enum j).2 ≫ hom = 0
  /-- the new enumeration extends the pushforward of the old one along the even indices -/
  enum_two_mul : ∀ k : ℕ, next.enum (2 * k) = pushCell G hom (s.enum k)
  /-- the prescribed cell of `M` is reached from the next stage -/
  hit : ∃ r : G⟦t.1⟧ ⟶ next.obj, r ≫ next.hom = t.2

/-- **A step out of any stage exists.** The next stage is obtained in two moves: first the
prescribed cell of `M` is attached, by forming the direct sum of the stage with `A[t.1]` and
extending the structure morphism by the morphism naming the cell; then the dead cells of the
window — finitely many — are killed at once by
`DifferentialGradedModule.exists_isCompactObject_comp_eq_forall_comp_eq_zero`. Both moves keep
the object compact, so its cells can be enumerated
(`exists_surjective_cell`, where the countability hypothesis enters),
and the new enumeration is interleaved with the pushforward of the old one so that the even
indices carry the latter. -/
private theorem nonempty_stepData (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X))
    {M : D} (s : Stage.{w} G M) (n : ℕ) (t : Cell G M) :
    Nonempty (StepData G s n t) := by
  have hP : IsCompactObject.{w} G := hG.1
  -- attach the prescribed cell of `M`
  set E₁ := s.obj ⊞ G⟦t.1⟧
  set u₁ : E₁ ⟶ M := biprod.desc s.hom t.2
  have hc₁ : IsCompactObject.{w} E₁ :=
    isCompactObject_biprod s.compact (isCompactObject_shift hP t.1)
  have hinl : (biprod.inl : s.obj ⟶ E₁) ≫ u₁ = s.hom := biprod.inl_desc _ _
  have hinr : (biprod.inr : G⟦t.1⟧ ⟶ E₁) ≫ u₁ = t.2 := biprod.inr_desc _ _
  -- kill the dead cells of the window
  set J := ULift.{w} {j : Fin (4 ^ n) // (s.enum j.1).2 ≫ s.hom = 0}
  obtain ⟨E₂, f₂, u₂, hc₂, hf₂, hkill⟩ :=
    exists_isCompactObject_comp_eq_forall_comp_eq_zero G hG.1 hc₁ u₁
      (J := J) (fun j => (s.enum j.down.1.1).1)
      (fun j => (s.enum j.down.1.1).2 ≫ biprod.inl)
      (fun j => by rw [Category.assoc, hinl]; exact j.down.2)
  -- enumerate the cells of the new stage
  obtain ⟨g, hg⟩ := exists_surjective_cell G E₂ (hG.2 E₂ hc₂)
  refine ⟨{
    next :=
      { obj := E₂
        compact := hc₂
        hom := u₂
        enum := fun j => if j % 2 = 0 then pushCell G (biprod.inl ≫ f₂) (s.enum (j / 2))
          else g (j / 2)
        enum_surjective := fun x => ?_ }
    hom := biprod.inl ≫ f₂
    comm := ?_
    kill := ?_
    enum_two_mul := ?_
    hit := ⟨biprod.inr ≫ f₂, ?_⟩ }⟩
  · obtain ⟨k, rfl⟩ := hg x
    exact ⟨2 * k + 1, by simp [Nat.mul_add_div]⟩
  · rw [Category.assoc, hf₂, hinl]
  · intro j hj hdead
    simpa using hkill (ULift.up ⟨⟨j, hj⟩, hdead⟩)
  · intro k
    simp [Nat.mul_div_cancel_left k (by norm_num : 0 < 2)]
  · rw [Category.assoc, hf₂, hinr]

/-! ### The tower -/

/-- The chosen step out of a stage, attaching the `n`-th cell of the enumeration `c` of the cells
of `M`. -/
private noncomputable def stepData (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X))
    {M : D} (c : ℕ → Cell G M) (s : Stage.{w} G M) (n : ℕ) :
    StepData G s n (c n) :=
  (nonempty_stepData G hG s n (c n)).some

/-- The stages of the tower over `M` starting at `s₀`. -/
private noncomputable def tower (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X))
    {M : D} (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) :
    ℕ → Stage.{w} G M := fun n =>
  Nat.rec s₀ (fun k s => (stepData G hG c s k).next) n

/-- The tower over `M` starting at `s₀`, as a system of objects indexed by `ℕ`. -/
private noncomputable def cellTower (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X))
    {M : D} (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) :
    ℕ ⥤ D :=
  Functor.ofSequence (X := fun n => (tower G hG c s₀ n).obj)
    fun n => (stepData G hG c (tower G hG c s₀ n) n).hom

section Interface

variable (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X)) {M : D}

/-- The structure morphism of the `n`-th term of the tower, with its source read as a term of
`cellTower`. All the statements below are phrased against `cellTower` rather than against
`tower`, so that no rewriting has to cross the identification of the two. -/
private noncomputable def towerHom (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    (cellTower G hG c s₀).obj n ⟶ M :=
  (tower G hG c s₀ n).hom

/-- The enumeration of the cells of the `n`-th term of the tower, read on `cellTower`. -/
private noncomputable def towerEnum (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    ℕ → Cell G ((cellTower G hG c s₀).obj n) :=
  (tower G hG c s₀ n).enum

/-- Every term of the tower is compact: this is what the whole construction is for. -/
private theorem isCompactObject_cellTower_obj (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    IsCompactObject.{w} ((cellTower G hG c s₀).obj n) :=
  (tower G hG c s₀ n).compact

/-- The enumeration carried by a term of the tower is onto its cells. -/
private theorem towerEnum_surjective (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    Function.Surjective (towerEnum G hG c s₀ n) :=
  (tower G hG c s₀ n).enum_surjective

/-- The transition of `cellTower` out of stage `n` is the morphism of the chosen step. -/
private theorem cellTower_map_succ_eq (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    (cellTower G hG c s₀).map (homOfLE (Nat.le_succ n))
      = (stepData G hG c (tower G hG c s₀ n) n).hom :=
  Functor.ofSequence_map_homOfLE_succ _ n

/-- The structure morphisms of the tower are compatible with its transitions. -/
private theorem cellTower_map_succ_comp_towerHom (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    (cellTower G hG c s₀).map (homOfLE (Nat.le_succ n)) ≫ towerHom G hG c s₀ (n + 1)
      = towerHom G hG c s₀ n := by
  rw [cellTower_map_succ_eq]
  exact (stepData G hG c (tower G hG c s₀ n) n).comm

/-- The even indices of the enumeration at stage `n + 1` carry the pushforward of the enumeration
at stage `n`. -/
private theorem towerEnum_two_mul (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n k : ℕ) :
    towerEnum G hG c s₀ (n + 1) (2 * k)
      = pushCell G ((cellTower G hG c s₀).map (homOfLE (Nat.le_succ n)))
          (towerEnum G hG c s₀ n k) := by
  rw [cellTower_map_succ_eq]
  exact (stepData G hG c (tower G hG c s₀ n) n).enum_two_mul k

/-- A cell inside the window at stage `n` which dies in `M` dies at stage `n + 1`. -/
private theorem comp_cellTower_map_succ_eq_zero (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n j : ℕ)
    (hj : j < 4 ^ n) (hdead : (towerEnum G hG c s₀ n j).2 ≫ towerHom G hG c s₀ n = 0) :
    (towerEnum G hG c s₀ n j).2 ≫ (cellTower G hG c s₀).map (homOfLE (Nat.le_succ n)) = 0 := by
  rw [cellTower_map_succ_eq]
  exact (stepData G hG c (tower G hG c s₀ n) n).kill j hj hdead

/-- The `n`-th cell of `M` in the enumeration `c` is reached from stage `n + 1`. -/
private theorem exists_comp_towerHom_succ_eq (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) :
    ∃ r : G⟦(c n).1⟧ ⟶ (cellTower G hG c s₀).obj (n + 1),
      r ≫ towerHom G hG c s₀ (n + 1) = (c n).2 :=
  (stepData G hG c (tower G hG c s₀ n) n).hit

/-! ### The two hypotheses of the gluing criterion -/

/-- The structure morphisms of the tower are compatible with its transitions, for an arbitrary
later index. -/
private theorem towerHom_eq_map_comp_towerHom (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n s : ℕ) :
    towerHom G hG c s₀ n
      = (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n s))
        ≫ towerHom G hG c s₀ (n + s) := by
  induction s with
  | zero => simp
  | succ s ih =>
    change towerHom G hG c s₀ n
      = (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n (s + 1)))
        ≫ towerHom G hG c s₀ (n + s + 1)
    rw [ih, ← cellTower_map_succ_comp_towerHom G hG c s₀ (n + s), ← Category.assoc,
      ← Functor.map_comp, homOfLE_comp]

/-- **The index of a cell doubles at each stage.** The cell at index `k` of the enumeration of
stage `n` is, pushed forward to stage `n + s`, the cell at index `2ˢ k` there. -/
private theorem towerEnum_two_pow_mul (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n k s : ℕ) :
    towerEnum G hG c s₀ (n + s) (2 ^ s * k)
      = pushCell G ((cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n s)))
          (towerEnum G hG c s₀ n k) := by
  induction s with
  | zero => simp [pushCell]
  | succ s ih =>
    change towerEnum G hG c s₀ (n + s + 1) (2 ^ (s + 1) * k)
      = pushCell G ((cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n (s + 1))))
          (towerEnum G hG c s₀ n k)
    rw [show 2 ^ (s + 1) * k = 2 * (2 ^ s * k) by ring, towerEnum_two_mul, ih,
      pushCell_pushCell, ← Functor.map_comp, homOfLE_comp]

/-- **Every cell of `M` is reached from some stage of the tower**, since the cells of `M` are
enumerated by `c` and the `n`-th one is attached at the `n`-th step. This is the first hypothesis
of the gluing criterion. -/
private theorem exists_comp_eq_of_surjective (c : ℕ → Cell G M) (s₀ : Stage.{w} G M)
    (hc : Function.Surjective c) (t : Cell G M) :
    ∃ (n : ℕ) (r : G⟦t.1⟧ ⟶ (cellTower G hG c s₀).obj n),
      t.2 = r ≫ towerHom G hG c s₀ n := by
  obtain ⟨n, hcn⟩ := hc t
  have hit := exists_comp_towerHom_succ_eq G hG c s₀ n
  rw [hcn] at hit
  obtain ⟨r, hr⟩ := hit
  exact ⟨n + 1, r, hr.symm⟩

/-- **A cell of a stage which dies in `M` dies at some later stage**, which is the second
hypothesis of the gluing criterion. The cell sits at some index `k` of the enumeration of its
stage `n`; pushed forward to stage `n + w` it sits at index `2 ^ w * k`, which for a suitable `w`
is inside the window `4 ^ (n + w)` treated at that stage
(`DifferentialGradedModule.exists_two_pow_mul_lt_four_pow`); and it still dies in `M` there, so
it is killed by the transition to stage `n + w + 1`. -/
private theorem exists_comp_map_eq_zero (c : ℕ → Cell G M) (s₀ : Stage.{w} G M) (n : ℕ) (m : ℤ)
    (ρ : G⟦m⟧ ⟶ (cellTower G hG c s₀).obj n)
    (hρ : ρ ≫ towerHom G hG c s₀ n = 0) :
    ∃ s : ℕ, ρ ≫ (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n s)) = 0 := by
  obtain ⟨k, hk⟩ := towerEnum_surjective G hG c s₀ n ⟨m, ρ⟩
  obtain ⟨w, hw⟩ := DifferentialGradedModule.exists_two_pow_mul_lt_four_pow n k
  have henum : towerEnum G hG c s₀ (n + w) (2 ^ w * k)
      = ⟨m, ρ ≫ (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n w))⟩ := by
    rw [towerEnum_two_pow_mul, hk]
    rfl
  have hdead : (towerEnum G hG c s₀ (n + w) (2 ^ w * k)).2 ≫ towerHom G hG c s₀ (n + w) = 0 := by
    rw [henum]
    change (ρ ≫ (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n w)))
      ≫ towerHom G hG c s₀ (n + w) = 0
    rw [Category.assoc, ← towerHom_eq_map_comp_towerHom, hρ]
  have hk2 := comp_cellTower_map_succ_eq_zero G hG c s₀ (n + w) (2 ^ w * k) hw hdead
  rw [henum] at hk2
  refine ⟨w + 1, ?_⟩
  show ρ ≫ (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n (w + 1))) = 0
  rw [show (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n (w + 1)))
      = (cellTower G hG c s₀).map (homOfLE (Nat.le_add_right n w)) ≫
        (cellTower G hG c s₀).map (homOfLE (Nat.le_succ (n + w))) from by
      rw [← Functor.map_comp, homOfLE_comp], ← Category.assoc]
  exact hk2

end Interface


/-! ### The gluing -/

/-- **An object receiving countably many morphisms from the shifts of a compact generator is a
derived colimit of compact objects.** Let `G` be a compact object of a pre-triangulated category
`D` whose shifts generate `D`, and suppose that the shifts of `G` map countably into every compact
object. If every `Hom(G[m], M)` is countable, then `M = hocolim Eₙ` with each `Eₙ` compact: the
diagonally refined cell tower attaches the cells of `M` one at a time and kills the dead cells of
a growing window, finitely many at a time. -/
theorem exists_isHomotopyColimit_isCompactObject_of_countable_hom
    (hG : IsCompactObject.{w} G ∧
      ∀ X : D, IsCompactObject.{w} X → ∀ m : ℤ, Countable (G⟦m⟧ ⟶ X))
    (hgen : ∀ Y : D,
      ((ObjectProperty.ofObj (fun _ : PUnit.{w + 1} => G)).shiftClosure ℤ).rightOrthogonal Y →
        IsZero Y)
    (M : D) (hM : ∀ m : ℤ, Countable (G⟦m⟧ ⟶ M)) :
    ∃ F : ℕ ⥤ D, (∀ n : ℕ, IsCompactObject.{w} (F.obj n)) ∧ IsHomotopyColimit F M := by
  obtain ⟨c, hc⟩ := exists_surjective_cell G M hM
  obtain ⟨e₀, he₀⟩ := exists_surjective_cell G G (hG.2 G hG.1)
  let s₀ : Stage.{w} G M := ⟨G, hG.1, 0, e₀, he₀⟩
  refine ⟨cellTower G hG c s₀, isCompactObject_cellTower_obj G hG c s₀, ?_⟩
  exact @isHomotopyColimit_of_forall_fac_of_forall_eventually_eq_zero D _ _ _ _ _ _ _
    PUnit.{w + 1} (fun _ => G) (fun _ => hG.1) hgen M (cellTower G hG c s₀) (towerHom G hG c s₀)
    (cellTower_map_succ_comp_towerHom G hG c s₀)
    (fun _ m ψ => exists_comp_eq_of_surjective G hG c s₀ hc ⟨m, ψ⟩)
    (fun n _ m ρ h => exists_comp_map_eq_zero G hG c s₀ n m ρ h)

end CategoryTheory.Pretriangulated.CountableCells

