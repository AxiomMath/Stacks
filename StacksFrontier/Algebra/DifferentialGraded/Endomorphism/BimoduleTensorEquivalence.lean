module

public import StacksFrontier.Algebra.DifferentialGraded.Endomorphism.BimoduleAdmissible
public import StacksFrontier.Algebra.DifferentialGraded.Endomorphism.BimoduleToTensor

/-!
# Differential graded bimodules are modules over the graded tensor product

Let `A` and `B` be differential graded algebras over a commutative ring `R`. The two constructions
of the previous files — a bimodule to a right module over `Aᵒᵖ ⊗ B` and back — are mutually
inverse, and the first is a fully faithful, essentially surjective functor. Differential graded
`(A, B)`-bimodules therefore form a category equivalent to right differential graded modules over
`Aᵒᵖ ⊗ B`, with `x · (a ⊗ b) = (-1)^{|a||x|} a x b`.

## Main definitions

* `DifferentialGraded.Bimodule.tensorFunctor`: the functor from bimodules to right modules over
  the graded tensor product.
* `DifferentialGraded.Bimodule.tensorGradedPreimage`: a homomorphism of *graded* right modules
  over the graded tensor product, read back as a homomorphism of graded bimodules.
* `DifferentialGraded.Bimodule.TensorEquivalence`: the equivalence together with the
  identifications that pin it down — it does not change the underlying graded complex, and it acts
  on a pure tensor by the signed formula.

## Main results

* `DifferentialGraded.Bimodule.tensorFunctorFullyFaithful`: the functor is fully faithful.
* `DifferentialGraded.Bimodule.tensorEquivalence`: the equivalence exists, with those
  identifications.

## Implementation notes

Everything is checked on pure tensors and extended by
`DifferentialGradedAlgebra.tensorProduct_induction`, an induction principle for the graded tensor
product generated by the pure tensors of homogeneous elements. Full faithfulness comes from the two
formulas `tensorActionApply_includeRight` and `tensorActionApply_includeLeft`, which recover each
of the two separate actions from the combined one; essential surjectivity is the fact that the
composite of the two constructions is the identity on the underlying module, which is
`tensorActionApply_ofTensorModule`.

Neither of those two formulas mentions the differential, so the inverse construction is carried
out first for *graded* homomorphisms — `tensorGradedMapToRightHom` and `tensorGradedPreimage` —
and the differential graded versions `tensorMapToRightHom` and `tensorMapPreimage` borrow their
right-linearity and their compatibility with the left action from those. The graded form is what
the admissible sequences of Tag 0FQL need, their splittings being graded bimodule maps.

## References

* [Stacks Project, Tag 0FQJ](https://stacks.math.columbia.edu/tag/0FQJ)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u

variable {R : Type u} [CommRing R]

namespace DifferentialGradedAlgebra

/-- The graded tensor product is generated by the pure tensors of homogeneous elements. -/
theorem tensorProduct_induction (C D : DifferentialGradedAlgebra.{u, u} R)
    {P : (tensorProduct C D).A → Prop} (hzero : P 0)
    (hadd : ∀ x y, P x → P y → P (x + y))
    (htmul : ∀ (m n : ℤ) (a : C.grading m) (b : D.grading n),
      P ((a : C.A) ᵍ⊗ₜ[R] (b : D.A) : C.grading ᵍ⊗[R] D.grading))
    (t : (tensorProduct C D).A) : P t := by
  obtain ⟨t, rfl⟩ := (GradedTensorProduct.of R C.grading D.grading).surjective t
  induction t using TensorProduct.inductionOn with
  | add x y hx hy => exact hadd _ _ hx hy
  | tmul a b =>
    change P (a ᵍ⊗ₜ[R] b : C.grading ᵍ⊗[R] D.grading)
    induction a using DirectSum.Decomposition.inductionOn C.grading with
    | zero => simpa [GradedTensorProduct.tmul] using hzero
    | add a a' ha ha' =>
      rw [tmul_add_left]
      exact hadd _ _ ha ha'
    | @homogeneous m a =>
      induction b using DirectSum.Decomposition.inductionOn D.grading with
      | zero => simpa [GradedTensorProduct.tmul] using hzero
      | add b b' hb hb' =>
        rw [tmul_add_right]
        exact hadd _ _ hb hb'
      | @homogeneous n b => exact htmul m n a b

end DifferentialGradedAlgebra

namespace DifferentialGraded

/-- A linear map commutes with the action of a unit of `ℤ`. -/
theorem map_units_smul {X Y : Type*} [AddCommGroup X] [AddCommGroup Y] [Module R X] [Module R Y]
    (f : X →ₗ[R] Y) (s : ℤˣ) (x : X) : f (s • x) = s • f x := by
  simp only [Units.smul_def, map_zsmul]

end DifferentialGraded

namespace DifferentialGraded.Bimodule

variable (A : DifferentialGradedAlgebra.{u, u} R) (B : DifferentialGradedAlgebra.{u, u} R)

/-- The combined action of the graded tensor product on the module underlying a bimodule, as a
plain function. -/
noncomputable def tensorActionApply (M : Bimodule A B) (t : (tensorAlgebra A B).A)
    (x : M.rightModule.M) : M.rightModule.M :=
  MulOpposite.unop (tensorActionAlgHom A B M t) x

/-- The combined action of `0` is zero. -/
theorem tensorActionApply_zero (M : Bimodule A B) (x : M.rightModule.M) :
    tensorActionApply A B M 0 x = 0 := by
  unfold tensorActionApply
  rw [map_zero, MulOpposite.unop_zero]
  rfl

/-- The combined action is additive in the tensor. -/
theorem tensorActionApply_add (M : Bimodule A B) (s t : (tensorAlgebra A B).A)
    (x : M.rightModule.M) :
    tensorActionApply A B M (s + t) x =
      tensorActionApply A B M s x + tensorActionApply A B M t x := by
  unfold tensorActionApply
  rw [map_add, MulOpposite.unop_add]
  rfl

/-- The combined action of any tensor sends `0` to `0`. -/
theorem tensorActionApply_zero_right (M : Bimodule A B) (t : (tensorAlgebra A B).A) :
    tensorActionApply A B M t 0 = 0 :=
  (MulOpposite.unop (tensorActionAlgHom A B M t)).map_zero

/-- The combined action of a tensor is additive in the module element. -/
theorem tensorActionApply_add_right (M : Bimodule A B) (t : (tensorAlgebra A B).A)
    (x y : M.rightModule.M) :
    tensorActionApply A B M t (x + y) =
      tensorActionApply A B M t x + tensorActionApply A B M t y :=
  (MulOpposite.unop (tensorActionAlgHom A B M t)).map_add x y

/-- The combined action of a pure tensor on a homogeneous element. -/
theorem tensorActionApply_tmul (M : Bimodule A B) {m n p : ℤ}
    (a : (oppAlgebra A).grading m) (b : B.grading n) (x : M.rightModule.grading p) :
    tensorActionApply A B M
        ((a : (oppAlgebra A).A) ᵍ⊗ₜ[R] (b : B.A) :
          (oppAlgebra A).grading ᵍ⊗[R] B.grading) x =
      (m * p).negOnePow • leftActionTotal A B M.rightModule M.leftAction.1
        ((DifferentialGradedAlgebra.opposite R A).equiv a)
        (MulOpposite.op (b : B.A) • (x : M.rightModule.M)) :=
  tensorAction_tmul_formula A B M a b x

/-- The totalized left action of a homogeneous element on a homogeneous element is the cochain
component of its action. -/
private theorem leftActionTotal_apply_val (M : Bimodule A B) {m p : ℤ} (a : A.grading m)
    (x : M.rightModule.grading p) :
    leftActionTotal A B M.rightModule M.leftAction.1 (a : A.A) (x : M.rightModule.M) =
      (M.rightModule.grading (p + m)).subtype
        (((M.leftAction.1.action m a).v p (p + m) rfl).hom x) := by
  rw [leftActionTotal_apply, DifferentialGradedModule.totalizeCochain_apply]

/-- A homomorphism of bimodules commutes with the totalized left action. -/
theorem Hom.map_leftActionTotal {M N : Bimodule A B} (f : M ⟶ N) (m : ℤ) (a : A.A)
    (ha : a ∈ A.grading m) (x : M.rightModule.M) :
    f.rightHom.toFun (leftActionTotal A B M.rightModule M.leftAction.1 a x) =
      leftActionTotal A B N.rightModule N.leftAction.1 a (f.rightHom.toFun x) := by
  induction x using DirectSum.Decomposition.inductionOn M.rightModule.grading with
  | zero => simp
  | add x y hx hy => simp [hx, hy]
  | @homogeneous p x =>
    rw [leftActionTotal_apply_val A B M ⟨a, ha⟩ x]
    exact (f.map_left m p ⟨a, ha⟩ x).trans
      (leftActionTotal_apply_val A B N ⟨a, ha⟩ (f.rightHom.gradedMap p x)).symm

/-- The underlying map of a homomorphism of bimodules is a homomorphism of right modules over the
graded tensor product. -/
noncomputable def tensorMap {M N : Bimodule A B} (f : M ⟶ N) :
    toTensorModule A B M ⟶ toTensorModule A B N where
  toFun := f.rightHom.toFun
  map_grading := f.rightHom.map_grading
  map_d := f.rightHom.map_d
  map_smul := by
    intro x t
    change f.rightHom.toFun (tensorActionApply A B M t x) =
      tensorActionApply A B N t (f.rightHom.toFun x)
    induction t using DifferentialGradedAlgebra.tensorProduct_induction (oppAlgebra A) B with
    | hzero => simp only [tensorActionApply_zero, map_zero]
    | hadd s t hs ht => simp only [tensorActionApply_add, map_add, hs, ht]
    | htmul m n a b =>
      induction x using DirectSum.Decomposition.inductionOn M.rightModule.grading with
      | zero => simp only [tensorActionApply_zero_right, map_zero]
      | add x y hx hy => simp only [tensorActionApply_add_right, map_add, hx, hy]
      | @homogeneous p x =>
        have h : tensorActionApply A B N
            ((a : (oppAlgebra A).A) ᵍ⊗ₜ[R] (b : B.A) :
              (oppAlgebra A).grading ᵍ⊗[R] B.grading) (f.rightHom.toFun x) =
            (m * p).negOnePow • leftActionTotal A B N.rightModule N.leftAction.1
              ((DifferentialGradedAlgebra.opposite R A).equiv a)
              (MulOpposite.op (b : B.A) • f.rightHom.toFun x) :=
          tensorActionApply_tmul A B N a b (f.rightHom.gradedMap p x)
        rw [tensorActionApply_tmul A B M a b x, h, DifferentialGraded.map_units_smul,
          Hom.map_leftActionTotal A B f m ((DifferentialGradedAlgebra.opposite R A).equiv a)
            (((DifferentialGradedAlgebra.opposite R A).mem_grading_iff m a).mp a.property),
          f.rightHom.map_smul]

/-- The functor from differential graded bimodules to right differential graded modules over the
graded tensor product. -/
noncomputable def tensorFunctor :
    Bimodule A B ⥤ DifferentialGradedModule (tensorAlgebra A B) where
  obj := toTensorModule A B
  map := tensorMap A B
  map_id := by intros; apply DifferentialGradedModule.Hom.ext; rfl
  map_comp := by intros; apply DifferentialGradedModule.Hom.ext; rfl

/-- The combined action restricted along the right inclusion is the right `B`-action. -/
theorem tensorActionApply_includeRight (M : Bimodule A B) (b : B.A) (x : M.rightModule.M) :
    tensorActionApply A B M
        (GradedTensorProduct.includeRight (oppAlgebra A).grading B.grading b) x =
      MulOpposite.op b • x := by
  induction b using DirectSum.Decomposition.inductionOn B.grading with
  | zero =>
    rw [map_zero, tensorActionApply_zero, MulOpposite.op_zero, zero_smul]
  | add b c hb hc =>
    rw [map_add, tensorActionApply_add, hb, hc, MulOpposite.op_add, add_smul]
  | @homogeneous n b =>
    induction x using DirectSum.Decomposition.inductionOn M.rightModule.grading with
    | zero => rw [tensorActionApply_zero_right, smul_zero]
    | add x y hx hy => rw [tensorActionApply_add_right, hx, hy, smul_add]
    | @homogeneous p x =>
      have h := tensorActionApply_tmul A B M
        (⟨1, SetLike.one_mem_graded _⟩ : (oppAlgebra A).grading 0) b x
      simpa only [zero_mul, Int.negOnePow_zero, one_smul,
        DifferentialGradedAlgebra.Opposite.map_one, leftActionTotal_one, LinearMap.id_apply,
        GradedTensorProduct.includeRight_apply] using h

/-- The combined action restricted along the left inclusion is the totalized left action, up to the
Koszul sign. -/
theorem tensorActionApply_includeLeft (M : Bimodule A B) {m p : ℤ}
    (a : (oppAlgebra A).grading m) (x : M.rightModule.grading p) :
    tensorActionApply A B M
        (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading a) x =
      (m * p).negOnePow • leftActionTotal A B M.rightModule M.leftAction.1
        ((DifferentialGradedAlgebra.opposite R A).equiv a) x := by
  simpa only [MulOpposite.op_one, one_smul, GradedTensorProduct.includeLeft_apply] using
    tensorActionApply_tmul A B M a (⟨1, SetLike.one_mem_graded _⟩ : B.grading 0) x

/-- A homomorphism of graded right modules over the graded tensor product restricts to a
homomorphism of the underlying graded right `B`-modules. -/
noncomputable def tensorGradedMapToRightHom {M N : Bimodule A B}
    (f : DifferentialGradedModule.GradedHom (toTensorModule A B M) (toTensorModule A B N)) :
    DifferentialGradedModule.GradedHom M.rightModule N.rightModule where
  toFun := f.toFun
  map_grading := f.map_grading
  map_smul := by
    intro x b
    rw [← tensorActionApply_includeRight A B M b x,
      ← tensorActionApply_includeRight A B N b (f.toFun x)]
    exact f.map_smul x _

/-- A homomorphism of right modules over the graded tensor product restricts to a homomorphism of
the underlying right `B`-modules. -/
noncomputable def tensorMapToRightHom {M N : Bimodule A B}
    (f : toTensorModule A B M ⟶ toTensorModule A B N) :
    DifferentialGradedModule.Hom M.rightModule N.rightModule where
  toFun := f.toFun
  map_grading := f.map_grading
  map_d := f.map_d
  map_smul := (tensorGradedMapToRightHom A B f.toGradedHom).map_smul

/-- A homomorphism of graded right modules over the graded tensor product is the image of a
homomorphism of graded bimodules. -/
noncomputable def tensorGradedPreimage {M N : Bimodule A B}
    (f : DifferentialGradedModule.GradedHom (toTensorModule A B M) (toTensorModule A B N)) :
    GradedHom A B M N where
  rightHom := tensorGradedMapToRightHom A B f
  map_left := by
    intro m p a x
    let c : (oppAlgebra A).grading m :=
      ⟨(DifferentialGradedAlgebra.opposite R A).equiv.symm a, by
        rw [DifferentialGradedAlgebra.Opposite.mem_grading_iff]
        simp⟩
    let fx : N.rightModule.grading p := ⟨f.toFun x.val, f.map_grading p x.val x.property⟩
    have h := f.map_smul x.val
      (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading c)
    have hM : tensorActionApply A B M
        (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading c) x.val =
        (m * p).negOnePow • leftActionTotal A B M.rightModule M.leftAction.1
          ((DifferentialGradedAlgebra.opposite R A).equiv c) x.val :=
      tensorActionApply_includeLeft A B M c x
    have hN : tensorActionApply A B N
        (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading c)
          (f.toFun x.val) =
        (m * p).negOnePow • leftActionTotal A B N.rightModule N.leftAction.1
          ((DifferentialGradedAlgebra.opposite R A).equiv c) (f.toFun x.val) :=
      tensorActionApply_includeLeft A B N c fx
    have h₂ : (m * p).negOnePow •
          f.toFun (leftActionTotal A B M.rightModule M.leftAction.1
            ((DifferentialGradedAlgebra.opposite R A).equiv c) x.val) =
        (m * p).negOnePow • leftActionTotal A B N.rightModule N.leftAction.1
          ((DifferentialGradedAlgebra.opposite R A).equiv c) (f.toFun x.val) := by
      rw [← DifferentialGraded.map_units_smul, ← hM, ← hN]
      exact h
    have h' := smul_left_cancel (m * p).negOnePow h₂
    simp only [c, LinearEquiv.apply_symm_apply] at h'
    rw [leftActionTotal_apply A B M.rightModule M.leftAction.1 m a,
      leftActionTotal_apply A B N.rightModule N.leftAction.1 m a] at h'
    have hMv : DifferentialGradedModule.totalizeCochain B M.rightModule m
        (M.leftAction.1.action m a) x.val =
        (M.rightModule.grading (p + m)).subtype
          (((M.leftAction.1.action m a).v p (p + m) rfl).hom x) :=
      DifferentialGradedModule.totalizeCochain_apply B M.rightModule m p
        (M.leftAction.1.action m a) x
    have hNv : DifferentialGradedModule.totalizeCochain B N.rightModule m
        (N.leftAction.1.action m a) (f.toFun x.val) =
        (N.rightModule.grading (p + m)).subtype
          (((N.leftAction.1.action m a).v p (p + m) rfl).hom fx) :=
      DifferentialGradedModule.totalizeCochain_apply B N.rightModule m p
        (N.leftAction.1.action m a) fx
    rw [hMv, hNv] at h'
    exact h'

/-- A homomorphism of right modules over the graded tensor product is the image of a homomorphism
of bimodules. -/
noncomputable def tensorMapPreimage {M N : Bimodule A B}
    (f : toTensorModule A B M ⟶ toTensorModule A B N) : M ⟶ N where
  rightHom := tensorMapToRightHom A B f
  map_left := (tensorGradedPreimage A B f.toGradedHom).map_left

/-- The functor to right modules over the graded tensor product is fully faithful. -/
noncomputable def tensorFunctorFullyFaithful : (tensorFunctor A B).FullyFaithful where
  preimage := tensorMapPreimage A B
  map_preimage := by intros; apply DifferentialGradedModule.Hom.ext; rfl
  preimage_map := by intros; apply Bimodule.Hom.ext; rfl

/-- The totalized left action on the bimodule attached to a right module over the graded tensor
product. -/
theorem ofTensorModule_leftActionTotal_apply
    (N : DifferentialGradedModule (tensorAlgebra A B)) {m p : ℤ} (a : A.grading m)
    (x : (ofTensorModule A B N).rightModule.grading p) :
    letI : Module (MulOpposite (tensorAlgebra A B).A) (ofTensorModule A B N).rightModule.M :=
      N.rmodule
    leftActionTotal A B (ofTensorModule A B N).rightModule (ofTensorModule A B N).leftAction.1
        a x =
      (m * p).negOnePow •
        ((MulOpposite.op (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading
          ((DifferentialGradedAlgebra.opposite R A).equiv.symm a)) :
            MulOpposite (tensorAlgebra A B).A) • (x.val : N.M)) :=
  ofTensorModule_leftAction_apply A B N a x

/-- The combined action on the bimodule attached to a right module over the graded tensor product
is the original action. -/
theorem tensorActionApply_ofTensorModule (N : DifferentialGradedModule (tensorAlgebra A B))
    (t : (tensorAlgebra A B).A) (x : N.M) :
    tensorActionApply A B (ofTensorModule A B N) t x = MulOpposite.op t • x := by
  let M := ofTensorModule A B N
  let _ : Module (MulOpposite ((oppAlgebra A).grading ᵍ⊗[R] B.grading)) N.M := N.rmodule
  induction t using DifferentialGradedAlgebra.tensorProduct_induction (oppAlgebra A) B with
  | hzero => rw [tensorActionApply_zero, MulOpposite.op_zero, zero_smul]
  | hadd s t hs ht => rw [tensorActionApply_add, MulOpposite.op_add, add_smul, hs, ht]
  | htmul m n a b =>
    induction x using DirectSum.Decomposition.inductionOn N.grading with
    | zero => rw [tensorActionApply_zero_right, smul_zero]
    | add x y hx hy => rw [tensorActionApply_add_right, hx, hy, smul_add]
    | @homogeneous p x =>
      let aa : A.grading m := ⟨(DifferentialGradedAlgebra.opposite R A).equiv a,
        ((DifferentialGradedAlgebra.opposite R A).mem_grading_iff m a).mp a.property⟩
      rw [tensorActionApply_tmul A B M a b x,
        leftActionTotal_commutes A B M.rightModule M.leftAction.1 M.leftAction.2 aa b x.val,
        ofTensorModule_leftActionTotal_apply A B N aa x]
      change (m * p).negOnePow •
          ((MulOpposite.op (GradedTensorProduct.includeRight (oppAlgebra A).grading B.grading b) :
              MulOpposite (tensorAlgebra A B).A) •
            ((m * p).negOnePow •
              ((MulOpposite.op (GradedTensorProduct.includeLeft (oppAlgebra A).grading B.grading
                  ((DifferentialGradedAlgebra.opposite R A).equiv.symm
                    ((DifferentialGradedAlgebra.opposite R A).equiv a))) :
                  MulOpposite (tensorAlgebra A B).A) • (x.val : N.M)))) = _
      rw [LinearEquiv.symm_apply_apply, smul_comm, smul_smul, ← Int.negOnePow_add,
        Int.negOnePow_even _ (Even.add_self _), one_smul,
        DifferentialGradedAlgebra.op_tmul_eq_includeRight_mul_includeLeft, mul_smul]

/-- The two constructions are mutually inverse: the right module over the graded tensor product
attached to the bimodule attached to `N` is `N`. -/
noncomputable def toTensorModuleOfTensorModuleIso
    (N : DifferentialGradedModule (tensorAlgebra A B)) :
    toTensorModule A B (ofTensorModule A B N) ≅ N where
  hom :=
    { toFun := LinearMap.id
      map_grading := by intros; assumption
      map_d := rfl
      map_smul := fun x t => tensorActionApply_ofTensorModule A B N t x }
  inv :=
    { toFun := LinearMap.id
      map_grading := by intros; assumption
      map_d := rfl
      map_smul := fun x t => (tensorActionApply_ofTensorModule A B N t x).symm }
  hom_inv_id := by apply DifferentialGradedModule.Hom.ext; rfl
  inv_hom_id := by apply DifferentialGradedModule.Hom.ext; rfl

/-- The canonical equivalence between differential graded bimodules and right differential graded
modules over the graded tensor product, including its underlying complex and its homogeneous
action formula. -/
structure TensorEquivalence where
  /-- The equivalence of categories. -/
  equivalence : Bimodule A B ≌ DifferentialGradedModule.{u, u, u} (tensorAlgebra A B)
  /-- It does not change the underlying module. -/
  underlying (M : Bimodule A B) : (equivalence.functor.obj M).M ≃ₗ[R] M.rightModule.M
  /-- It does not change the grading. -/
  grading (M : Bimodule A B) (n : ℤ) (x : (equivalence.functor.obj M).M) :
    x ∈ (equivalence.functor.obj M).grading n ↔ underlying M x ∈ M.rightModule.grading n
  /-- It does not change the differential. -/
  differential (M : Bimodule A B) (x : (equivalence.functor.obj M).M) :
    underlying M ((equivalence.functor.obj M).d x) = M.rightModule.d (underlying M x)
  /-- It does not change the underlying map of a homomorphism. -/
  naturality {M N : Bimodule A B} (f : M ⟶ N) (x : (equivalence.functor.obj M).M) :
    underlying N ((equivalence.functor.map f).toFun x) = f.rightHom.toFun (underlying M x)
  /-- The action of a pure tensor is the signed composite of the two actions. -/
  action (M : Bimodule A B) (m n p : ℤ) (a : (oppAlgebra A).grading m) (b : B.grading n)
      (x : (equivalence.functor.obj M).grading p) :
    underlying M
        (MulOpposite.op
          (show (tensorAlgebra A B).A from
            ((a : (oppAlgebra A).A) ᵍ⊗ₜ[R] (b : B.A) :
              (oppAlgebra A).grading ᵍ⊗[R] B.grading)) •
            (x : (equivalence.functor.obj M).M)) =
      (m * p).negOnePow •
        ((show M.rightModule.grading (p + n + m) from
          (M.leftAction.1.action m
            ⟨(DifferentialGradedAlgebra.opposite R A).equiv a,
              ((DifferentialGradedAlgebra.opposite R A).mem_grading_iff m a).mp a.property⟩).v
            (p + n) (p + n + m) (by omega)
            ⟨MulOpposite.op (b : B.A) • (underlying M x),
              M.rightModule.smul_mem p n (underlying M x) (b : B.A)
                ((grading M p x).mp x.property) b.property⟩) : M.rightModule.M)

/-- A `TensorEquivalence` exists: the tensor functor is fully faithful and essentially
surjective, hence an equivalence, and it satisfies the identifications that pin it down. -/
theorem nonempty_tensorEquivalence : Nonempty (TensorEquivalence A B) := by
  let F := tensorFunctor A B
  let hF := tensorFunctorFullyFaithful A B
  let _ : F.Full := hF.full
  let _ : F.Faithful := hF.faithful
  let _ : F.EssSurj :=
    ⟨fun N => ⟨ofTensorModule A B N, ⟨toTensorModuleOfTensorModuleIso A B N⟩⟩⟩
  let _ : F.IsEquivalence := ⟨inferInstance, inferInstance, inferInstance⟩
  refine ⟨{
    equivalence := F.asEquivalence
    underlying := fun M => LinearEquiv.refl R M.rightModule.M
    grading := fun _ _ _ => Iff.rfl
    differential := fun _ _ => rfl
    naturality := fun _ _ => rfl
    action := ?_ }⟩
  intro M m n p a b x
  let x' : M.rightModule.grading p := ⟨x.val, x.property⟩
  change tensorActionApply A B M
    ((a : (oppAlgebra A).A) ᵍ⊗ₜ[R] (b : B.A) :
      (oppAlgebra A).grading ᵍ⊗[R] B.grading) x'.val = _
  rw [tensorActionApply_tmul A B M a b x',
    leftActionTotal_apply_val A B M
      ⟨(DifferentialGradedAlgebra.opposite R A).equiv a,
        ((DifferentialGradedAlgebra.opposite R A).mem_grading_iff m a).mp a.property⟩
      ⟨MulOpposite.op (b : B.A) • (x' : M.rightModule.M),
        M.rightModule.smul_mem p n x' b x'.property b.property⟩]
  rfl

/-- A differential graded `(A, B)`-bimodule is canonically a right differential graded module over
the graded tensor product of the graded opposite of `A` with `B`, and this is an equivalence of
categories. -/
@[stacks 0FQJ]
noncomputable def tensorEquivalence : TensorEquivalence A B :=
  Classical.choice (nonempty_tensorEquivalence A B)

end DifferentialGraded.Bimodule
