/-!
# `p`-bases and `p`-independence

Let `p` be a prime and `K/k` an extension of fields of characteristic `p`. Write `kK^p` for the
subfield of `K` generated by the image of `k` and the `p`-th powers of elements of `K`. For a
family `{x_i}_{i ∈ I}` in `K` and a finitely supported `E : I → {0, …, p - 1}`, the monomial
`x^E` is `∏_i x_i ^ E(i)`. The family is `p`-independent over `k` if the monomials `x^E` are
linearly independent over `kK^p`, and a `p`-basis of `K` over `k` if they form a basis of `K`
over `kK^p`.

We show that `{x_i}` is `p`-independent if and only if the differentials `{d x_i}` are
`K`-linearly independent in `Ω_{K/k}`, that every `p`-independent family extends to a `p`-basis,
that `K` has a `p`-basis over `k`, and that `{x_i}` is a `p`-basis if and only if `{d x_i}` is a
`K`-basis of `Ω_{K/k}`.

## Main definitions

* `compositumFrobenius`: the subfield `kK^p` of `K`.
* `monomialPow`: the monomial `x^E` of a family `x` and an exponent function `E`.
* `monomialFamily`: the family of monomials `x^E` with all exponents less than `p`.
* `PIndependent`: `p`-independence of a family over `k`.
* `PBasis`: the property of being a `p`-basis of `K` over `k`.
* `PBasis.basis`: the `kK^p`-basis of `K` attached to a `p`-basis.

## Main results

* `pIndependent_iff_linearIndependent_differentials`: `{x_i}` is `p`-independent over `k` if and
  only if `{d x_i}` is `K`-linearly independent in `Ω_{K/k}`.
* `exists_pBasis_extending`: every `p`-independent family extends to a `p`-basis.
* `exists_pBasis`: `K` has a `p`-basis over `k`.
* `pBasis_iff_basis_differentials`: `{x_i}` is a `p`-basis of `K` over `k` if and only if
  `{d x_i}` is a `K`-basis of `Ω_{K/k}`.

## References

* [Stacks: Tag 07P2](https://stacks.math.columbia.edu/tag/07P2)
-/

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-- The exponent functions for monomials: finitely supported `E : I → ℕ` with all values
`< p`, modelling functions `I → {0, …, p-1}` of finite support. -/
def BoundedExp (I : Type*) (p : ℕ) : Type _ := {E : I →₀ ℕ // ∀ i, E i < p}

/-- The zero exponent function, bounded by any `p > 0`. -/
def BoundedExp.zero {I : Type*} {p : ℕ} (hp : 0 < p) : BoundedExp I p :=
  ⟨0, fun _ => by simpa using hp⟩

/-- The exponent function `1` in the slot `i`, bounded by any `p > 1`. -/
noncomputable def BoundedExp.single {I : Type*} {p : ℕ} (hp : 1 < p) (i : I) : BoundedExp I p :=
  ⟨Finsupp.single i 1, fun a => by
    rcases eq_or_ne i a with rfl | h
    · rw [Finsupp.single_eq_same]; exact hp
    · rw [Finsupp.single_eq_of_ne h.symm]; omega⟩

/-- Reindexing `BoundedExp` along an equivalence of index types. -/
noncomputable def boundedExpCongr {I J : Type*} (p : ℕ) (e : I ≃ J) :
    BoundedExp I p ≃ BoundedExp J p :=
  Equiv.subtypeEquiv (Finsupp.equivCongrLeft e) fun _ =>
    ⟨fun h j => by simpa [Finsupp.equivMapDomain_apply] using h (e.symm j),
      fun h i => by simpa [Finsupp.equivMapDomain_apply] using h (e i)⟩

section CommMonoid

variable {M : Type*} [CommMonoid M]

/-- The monomial `x^E = ∏_i (x i) ^ (E i)`, a finite product since `E` is finitely supported. -/
@[ega "IV 16.11.1"]
def monomialPow {I : Type*} (x : I → M) (E : I →₀ ℕ) : M :=
  E.prod (fun i e => (x i) ^ e)

/-- The family of all monomials `x^E`, indexed by bounded exponent functions, viewed as a
family of elements of `M`. -/
@[sga "3 VIIB 4.3" "partial"]
def monomialFamily {I : Type*} (x : I → M) (p : ℕ) :
    BoundedExp I p → M := fun E => monomialPow x E.1

@[simp]
theorem monomialFamily_apply {I : Type*} (x : I → M) (p : ℕ) (E : BoundedExp I p) :
    monomialFamily x p E = monomialPow x E.1 := rfl

/-- `monomialPow` is additive-to-multiplicative in the exponent. -/
theorem monomialPow_add {I : Type*} (x : I → M) (A B : I →₀ ℕ) :
    monomialPow x (A + B) = monomialPow x A * monomialPow x B := by
  unfold monomialPow
  rw [Finsupp.prod_add_index'] <;> intros
  · rw [pow_zero]
  · rw [pow_add]

/-- The monomial of `n • A` is the `n`-th power of the monomial of `A`. -/
theorem monomialPow_nsmul {I : Type*} (x : I → M) (n : ℕ) (A : I →₀ ℕ) :
    monomialPow x (n • A) = (monomialPow x A) ^ n := by
  induction n with
  | zero => simp [monomialPow]
  | succ k ih => rw [succ_nsmul, monomialPow_add, ih, pow_succ]

/-- The monomial at the zero exponent is `1`. -/
@[simp]
theorem monomialPow_zero {I : Type*} (x : I → M) : monomialPow x 0 = 1 := by
  rw [monomialPow, Finsupp.prod_zero_index]

/-- The monomial at a single exponent `n` in the slot `i` is `(x i) ^ n`. -/
@[simp]
theorem monomialPow_single {I : Type*} (x : I → M) (i : I) (n : ℕ) :
    monomialPow x (Finsupp.single i n) = x i ^ n :=
  Finsupp.prod_single_index (pow_zero (x i))

/-- The monomial at the zero exponent function is `1`. -/
@[simp]
theorem monomialFamily_zero {I : Type*} (x : I → M) {p : ℕ} (hp : 0 < p) :
    monomialFamily x p (BoundedExp.zero hp) = 1 :=
  monomialPow_zero x

/-- The monomial at the exponent function `1` in the slot `i` is `x i`. -/
@[simp]
theorem monomialFamily_single {I : Type*} (x : I → M) {p : ℕ} (hp : 1 < p) (i : I) :
    monomialFamily x p (BoundedExp.single hp i) = x i := by
  show monomialPow x (Finsupp.single i 1) = x i
  rw [monomialPow_single, pow_one]

end CommMonoid

variable {k K : Type*} [Field k] [Field K] [Algebra k K]

/-- The compositum `kK^p`: the smallest subfield of `K` containing the image of `k`
(via the algebra map) together with all `p`-th powers `{a^p : a ∈ K}`. -/
@[ega "0 21.4.0", ega "0 21.8.2"]
noncomputable def compositumFrobenius (k K : Type*) [Field k] [Field K] [Algebra k K]
    (p : ℕ) : Subfield K :=
  Subfield.closure (((algebraMap k K).range : Set K) ∪ {a : K | ∃ b : K, a = b ^ p})

/-- The `p`-th power of a monomial lies in `kK^p`. -/
theorem monomialPow_pow_mem_compositum {I : Type*} (x : I → K) (p : ℕ)
    (E : I →₀ ℕ) : (monomialPow x E) ^ p ∈ compositumFrobenius k K p :=
  Subfield.subset_closure (Or.inr ⟨monomialPow x E, rfl⟩)

/-- The family `{x_i}` is `p`-independent over `k` if the family of monomials `{x^E}_E` is
linearly independent over the subfield `kK^p`. -/
@[ega "0 21.1.9" "special case"]
def PIndependent {I : Type*} (k : Type*) [Field k] [Algebra k K] (x : I → K) (p : ℕ) : Prop :=
  LinearIndependent (compositumFrobenius k K p) (monomialFamily x p)

/-- The family `{x_i}` is a `p`-basis of `K` over `k` if the family of monomials `{x^E}_E` is a
basis of `K` as a `kK^p`-vector space, i.e. it is linearly independent and its span is all of
`K`. -/
@[ega "0 21.1.9" "special case"]
def PBasis {I : Type*} (k : Type*) [Field k] [Algebra k K] (x : I → K) (p : ℕ) : Prop :=
  PIndependent k x p ∧
    ⊤ ≤ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p))

/-- The `kK^p`-basis of `K` given by the monomials `x^E` of a `p`-basis `{x_i}`. -/
noncomputable def PBasis.basis {I : Type*} {k : Type*} [Field k] [Algebra k K] {x : I → K}
    {p : ℕ} (hx : PBasis k x p) :
    Module.Basis (BoundedExp I p) (compositumFrobenius k K p) K :=
  Module.Basis.mk hx.1 hx.2

@[simp]
theorem PBasis.basis_apply {I : Type*} {k : Type*} [Field k] [Algebra k K] {x : I → K} {p : ℕ}
    (hx : PBasis k x p) (E : BoundedExp I p) : hx.basis E = monomialFamily x p E :=
  Module.Basis.mk_apply hx.1 hx.2 E

/-- Every `k`-derivation `D : K → M` into a `K`-module vanishes on `kK^p`. -/
@[ega "0 21.1.5" "(i) for field extensions",
  ega "0 21.4.4" "Sufficiency",
  ega "0 21.4.6" "(b) ⇒ (a)"]
theorem derivation_eq_zero_of_mem_compositumFrobenius
    {M : Type*} [AddCommGroup M] [Module K M] [Module k M] [IsScalarTower k K M]
    (D : Derivation k K M)
    (p : ℕ) [Fact (Nat.Prime p)] [CharP K p]
    {a : K} (ha : a ∈ compositumFrobenius k K p) :
    D a = 0 := by
  have hinv : ∀ x : K, D x = 0 → D x⁻¹ = 0 := by
    intro x hx
    by_cases hx0 : x = 0
    · subst hx0; simp
    · have h1 : D (x * x⁻¹) = 0 := by
        rw [mul_inv_cancel₀ hx0]; simp
      rw [Derivation.leibniz, hx] at h1
      simp only [smul_zero, add_zero] at h1
      have := mul_inv_cancel₀ hx0
      have h2 : x • D x⁻¹ = 0 := h1
      have : x⁻¹ • (x • D x⁻¹) = 0 := by rw [h2, smul_zero]
      rwa [smul_smul, inv_mul_cancel₀ hx0, one_smul] at this
  let S : Subfield K :=
    { carrier := {x : K | D x = 0}
      mul_mem' := by
        intro x y hx hy
        simp only [Set.mem_ofPred_eq] at *
        rw [Derivation.leibniz, hx, hy, smul_zero, smul_zero, add_zero]
      one_mem' := by simp
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_ofPred_eq] at *
        rw [map_add, hx, hy, add_zero]
      zero_mem' := by simp
      neg_mem' := by
        intro x hx
        simp only [Set.mem_ofPred_eq] at *
        rw [map_neg, hx, neg_zero]
      inv_mem' := by
        intro x hx
        simp only [Set.mem_ofPred_eq] at *
        exact hinv x hx }
  have hle : compositumFrobenius k K p ≤ S := by
    apply Subfield.closure_le.mpr
    intro x hx
    simp only [Set.mem_union] at hx
    rcases hx with hx | hx
    · obtain ⟨r, rfl⟩ := hx
      show D (algebraMap k K r) = 0
      rw [Derivation.map_algebraMap]
    · obtain ⟨b, rfl⟩ := hx
      show D (b ^ p) = 0
      rw [Derivation.leibniz_pow]
      have : (p : ℕ) • (b ^ (p - 1) • D b) = ((p : K)) • (b ^ (p - 1) • D b) := by
        rw [Nat.cast_smul_eq_nsmul]
      rw [this, CharP.cast_eq_zero K p, zero_smul]
  exact hle ha

/-- The universal derivation `d : K → Ω_{K/k}` vanishes on `kK^p`. -/
theorem KaehlerDifferential.D_eq_zero_of_mem_compositumFrobenius
    (p : ℕ) [Fact (Nat.Prime p)] [CharP K p]
    {a : K} (ha : a ∈ compositumFrobenius k K p) :
    (KaehlerDifferential.D k K) a = 0 :=
  derivation_eq_zero_of_mem_compositumFrobenius (KaehlerDifferential.D k K) p ha

/-- If the differentials `{d x_i}` are `K`-linearly independent in `Ω_{K/k}`, then `{x_i}` is
`p`-independent over `k`. -/
@[ega "0 21.4.5" "partial", ega "0 21.4.6" "(b) ⇒ (c)"]
theorem pIndependent_of_linearIndependent_differentials
    {I : Type*} (x : I → K) (p : ℕ) [Fact (Nat.Prime p)] [CharP K p]
    (hd : LinearIndependent K (fun i => (KaehlerDifferential.D k K) (x i))) :
    PIndependent k x p := by
  classical
  have leibniz_finset_prod : ∀ (D : Derivation k K K) (s : Finset I) (f : I → K),
      D (∏ i ∈ s, f i) = ∑ i ∈ s, (∏ j ∈ s.erase i, f j) • D (f i) := by
    intro D s f
    classical
    induction s using Finset.induction with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Derivation.leibniz, ih, Finset.sum_insert ha,
        Finset.erase_insert ha, Finset.smul_sum, add_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro y hy
      have hya : y ≠ a := fun h => ha (h ▸ hy)
      rw [Finset.erase_insert_of_ne (Ne.symm hya),
        Finset.prod_insert (by simp only [Finset.mem_erase, not_and]; exact fun _ => ha),
        smul_smul, mul_comm, mul_smul]
  have monomialPow_split : ∀ (E : I →₀ ℕ) (i : I),
      monomialPow x E = x i ^ (E i) * monomialPow x (E.update i 0) := by
    intro E i
    classical
    have hupd : E.update i 0 = Finsupp.erase i E := by
      ext j; rw [Finsupp.update_apply]; by_cases h : j = i <;> simp [h, Finsupp.erase]
    by_cases hi : i ∈ E.support
    · rw [monomialPow, monomialPow, hupd, ← Finsupp.mul_prod_erase E i (fun i e => (x i) ^ e) hi]
    · simp only [Finsupp.mem_support_iff, not_not] at hi
      rw [hi, pow_zero, one_mul]
      congr 1
      ext j
      rw [Finsupp.update_apply]
      by_cases h : j = i <;> simp [h, hi]
  have deriv_monomial_zero : ∀ (θ : Derivation k K K) (i : I)
      (hθ : ∀ j, θ (x j) = if j = i then 1 else 0) (F : I →₀ ℕ), F i = 0 →
      θ (monomialPow x F) = 0 := by
    intro θ i hθ F hF
    classical
    rw [monomialPow, Finsupp.prod, leibniz_finset_prod θ F.support (fun a => x a ^ F a)]
    apply Finset.sum_eq_zero
    intro j hj
    have hji : j ≠ i := by
      rintro rfl
      rw [Finsupp.mem_support_iff] at hj; exact hj hF
    rw [Derivation.leibniz_pow, hθ j, ite_eq_right hji, smul_zero, smul_zero, smul_zero]
  have deriv_monomial : ∀ (θ : Derivation k K K) (i : I)
      (hθ : ∀ j, θ (x j) = if j = i then 1 else 0) (E : I →₀ ℕ),
      θ (monomialPow x E) = (E i : K) • monomialPow x (E.update i (E i - 1)) := by
    intro θ i hθ E
    classical
    have hM0 : θ (monomialPow x (E.update i 0)) = 0 :=
      deriv_monomial_zero θ i hθ _ (by simp [Finsupp.update_apply])
    rw [monomialPow_split E i, Derivation.leibniz, hM0, smul_zero, zero_add,
      Derivation.leibniz_pow, hθ i, ite_eq_left rfl]
    rw [monomialPow_split (E.update i (E i - 1)) i]
    have h1 : (E.update i (E i - 1)) i = E i - 1 := by simp [Finsupp.update_apply]
    have h2 : (E.update i (E i - 1)).update i 0 = E.update i 0 := by
      ext j; simp only [Finsupp.update_apply]; by_cases h : j = i <;> simp [h]
    rw [h1, h2]
    simp only [nsmul_eq_mul, smul_eq_mul, mul_one]
    ring
  let shiftExp : I → BoundedExp I p → BoundedExp I p := fun i E =>
    ⟨E.1.update i (E.1 i - 1), by
      intro j
      rw [Finsupp.update_apply]
      by_cases h : j = i
      · simp only [ite_eq_left h]; exact lt_of_le_of_lt (Nat.sub_le _ _) (E.2 i)
      · simp only [ite_eq_right h]; exact E.2 j⟩
  have hshiftExp : ∀ i E, (shiftExp i E).1 = (E : BoundedExp I p).1.update i (E.1 i - 1) :=
    fun i E => rfl
  let scaleRel : I → (BoundedExp I p →₀ (compositumFrobenius k K p)) →
      (BoundedExp I p →₀ (compositumFrobenius k K p)) := fun i l =>
    l.sum (fun E r => Finsupp.single E ((E.1 i : compositumFrobenius k K p) * r))
  have hscaleRel : ∀ i l, scaleRel i l =
      l.sum (fun E r => Finsupp.single E ((E.1 i : compositumFrobenius k K p) * r)) :=
    fun i l => rfl
  let Drel : I → (BoundedExp I p →₀ (compositumFrobenius k K p)) →
      (BoundedExp I p →₀ (compositumFrobenius k K p)) := fun i l =>
    Finsupp.mapDomain (shiftExp i) (scaleRel i l)
  have hDrel : ∀ i l, Drel i l = Finsupp.mapDomain (shiftExp i) (scaleRel i l) := fun i l => rfl
  let td : (I →₀ ℕ) → ℕ := fun E => E.sum (fun _ e => e)
  have htd : ∀ E, td E = E.sum (fun _ e => e) := fun E => rfl
  have Drel_linearCombination : ∀ (θ : Derivation k K K) (i : I)
      (hθ : ∀ j, θ (x j) = if j = i then 1 else 0)
      (l : BoundedExp I p →₀ (compositumFrobenius k K p)),
      Finsupp.linearCombination (compositumFrobenius k K p) (monomialFamily x p) (Drel i l)
        = θ (Finsupp.linearCombination (compositumFrobenius k K p) (monomialFamily x p) l) := by
    intro θ i hθ l
    classical
    have hRHS : θ (Finsupp.linearCombination (compositumFrobenius k K p) (monomialFamily x p) l)
        = l.sum fun E r => ((E.1 i : K) * (r : K)) • (monomialFamily x p) (shiftExp i E) := by
      rw [Finsupp.linearCombination_apply, map_finsuppSum]
      apply Finsupp.sum_congr
      intro E _
      have hr : θ ((l E : K)) = 0 := derivation_eq_zero_of_mem_compositumFrobenius θ p (l E).2
      have hsm : (l E) • (monomialFamily x p) E = (l E : K) * (monomialFamily x p) E :=
        smul_eq_mul ((l E):K) ((monomialFamily x p) E)
      rw [hsm, Derivation.leibniz, hr, smul_zero, add_zero]
      show ((l E):K) • θ (monomialPow x E.1) = _
      rw [deriv_monomial θ i hθ E.1, smul_smul, mul_comm]
      rfl
    rw [hRHS]
    rw [hDrel, Finsupp.linearCombination_mapDomain, Finsupp.linearCombination_apply]
    rw [hscaleRel, Finsupp.sum_sum_index]
    · apply Finsupp.sum_congr
      intro E _
      rw [Finsupp.sum_single_index]
      · show ((E.1 i : (compositumFrobenius k K p)) * l E) • (monomialFamily x p) (shiftExp i E)
          = _
        rw [show ((E.1 i : (compositumFrobenius k K p)) * l E) • (monomialFamily x p) (shiftExp i E)
              = (((E.1 i : (compositumFrobenius k K p)) * l E : (compositumFrobenius k K p)) : K)
                * (monomialFamily x p) (shiftExp i E) from smul_eq_mul _ _]
        push_cast
        ring
      · simp
    · intro a; simp
    · intro a b1 b2; rw [add_smul]
  have scaleRel_apply : ∀ (i : I) (l : BoundedExp I p →₀ (compositumFrobenius k K p))
      (E : BoundedExp I p),
      (scaleRel i l) E = (E.1 i : (compositumFrobenius k K p)) * l E := by
    intro i l E
    classical
    rw [hscaleRel, Finsupp.sum, Finsupp.finsetSum_apply]
    by_cases hE : E ∈ l.support
    · rw [Finset.sum_eq_single E]
      · rw [Finsupp.single_apply, ite_eq_left rfl]
      · intro b _ hbE
        rw [Finsupp.single_apply, ite_eq_right hbE]
      · exact fun h => absurd hE h
    · have hlE0 : l E = 0 := by simpa [Finsupp.mem_support_iff] using hE
      rw [hlE0, mul_zero]
      refine Finset.sum_eq_zero fun b hb => ?_
      rw [Finsupp.single_apply, ite_eq_right]
      rintro rfl
      exact absurd hb hE
  have shiftExp_injOn : ∀ (i : I),
      Set.InjOn (shiftExp i) {E : BoundedExp I p | 1 ≤ E.1 i} := by
    intro i E hE E' hE' heq
    simp only [Set.mem_ofPred_eq] at hE hE'
    have heq2 : E.1.update i (E.1 i - 1) = E'.1.update i (E'.1 i - 1) := by
      rw [← hshiftExp i E, ← hshiftExp i E', heq]
    apply Subtype.ext
    ext j
    by_cases h : j = i
    · subst h
      have h1 : (E.1.update j (E.1 j - 1)) j = (E'.1.update j (E'.1 j - 1)) j := by rw [heq2]
      rw [Finsupp.update_apply, Finsupp.update_apply, ite_eq_left rfl, ite_eq_left rfl] at h1
      omega
    · have h1 : (E.1.update i (E.1 i - 1)) j = (E'.1.update i (E'.1 i - 1)) j := by rw [heq2]
      rwa [Finsupp.update_apply, Finsupp.update_apply, ite_eq_right h, ite_eq_right h] at h1
  have td_shift : ∀ (i : I) (E : BoundedExp I p), 1 ≤ E.1 i →
      td (shiftExp i E).1 + 1 = td E.1 := by
    intro i E hE
    have key := Finsupp.sum_update_add E.1 i (E.1 i - 1) (fun _ e => e) (fun _ => rfl)
      (fun _ _ _ => rfl)
    rw [hshiftExp, htd, htd]
    omega
  have Drel_apply_shift : ∀ (i : I) (l : BoundedExp I p →₀ (compositumFrobenius k K p))
      (E : BoundedExp I p), 1 ≤ E.1 i →
      (Drel i l) (shiftExp i E) = (E.1 i : (compositumFrobenius k K p)) * l E := by
    intro i l E hE
    classical
    have hsupp : ↑(scaleRel i l).support ⊆ {F : BoundedExp I p | 1 ≤ F.1 i} := by
      intro F hF
      simp only [Finset.mem_coe, Finsupp.mem_support_iff] at hF
      simp only [Set.mem_ofPred_eq]
      rw [scaleRel_apply] at hF
      by_contra h
      rw [not_le, Nat.lt_one_iff] at h
      rw [h] at hF
      simp at hF
    rw [hDrel, Finsupp.mapDomain_apply' _ _ hsupp (shiftExp_injOn i) hE,
      scaleRel_apply]
  have exists_dual_deriv : ∀ (i : I),
      ∃ θ : Derivation k K K, ∀ j, θ (x j) = if j = i then 1 else 0 := by
    intro i
    classical
    set v : I → KaehlerDifferential k K := fun i => (KaehlerDifferential.D k K) (x i) with hv
    let g0 : (Submodule.span K (Set.range v)) →ₗ[K] K :=
      (Finsupp.lapply i : (I →₀ K) →ₗ[K] K) ∘ₗ hd.repr
    obtain ⟨g, hg⟩ := LinearMap.exists_extend g0
    refine ⟨(KaehlerDifferential.linearMapEquivDerivation k K) g, ?_⟩
    intro j
    show g (v j) = _
    have hmem : v j ∈ Submodule.span K (Set.range v) := Submodule.subset_span ⟨j, rfl⟩
    have heq : g (v j) = g0 ⟨v j, hmem⟩ := LinearMap.congr_fun hg ⟨v j, hmem⟩
    rw [heq]
    have hval : g0 ⟨v j, hmem⟩ = (hd.repr ⟨v j, hmem⟩) i := rfl
    rw [hval, hd.repr_eq_single j ⟨v j, hmem⟩ rfl]
    simp [Finsupp.single_apply, eq_comm]
  have deg_zero_rel_zero : ∀ (l : BoundedExp I p →₀ (compositumFrobenius k K p)),
      (∀ F ∈ l.support, td F.1 = 0) →
      Finsupp.linearCombination (compositumFrobenius k K p) (monomialFamily x p) l = 0 →
      l = 0 := by
    intro l hsupp hlc
    classical
    have hzero : ∀ F ∈ l.support, F.1 = 0 := by
      intro F hF
      have hF0 := hsupp F hF
      ext j
      simp only [Finsupp.coe_zero, Pi.zero_apply]
      by_contra hj
      have hle : F.1 j ≤ td F.1 := Finset.single_le_sum (by intros; exact Nat.zero_le _)
        (Finsupp.mem_support_iff.mpr hj)
      rw [htd] at hF0
      rw [htd] at hle
      omega
    have hmf1 : ∀ F ∈ l.support, (monomialFamily x p) F = 1 := by
      intro F hF
      rw [monomialFamily, hzero F hF]
      simp [monomialPow]
    rw [Finsupp.linearCombination_apply, Finsupp.sum] at hlc
    have hlc2 : ∑ F ∈ l.support, ((l F : K)) = 0 := by
      rw [← hlc]
      apply Finset.sum_congr rfl
      intro F hF
      rw [hmf1 F hF, show l F • (1:K) = ((l F : K)) * 1 from smul_eq_mul _ _, mul_one]
    ext F
    simp only [Finsupp.coe_zero, Pi.zero_apply]
    by_cases hF : F ∈ l.support
    · exfalso
      have hsupeq : l.support = {F} := by
        apply Finset.Subset.antisymm
        · intro G hG
          simp only [Finset.mem_singleton]
          apply Subtype.ext
          rw [hzero G hG, hzero F hF]
        · simpa using hF
      rw [hsupeq, Finset.sum_singleton] at hlc2
      have hlF : l F = 0 := by exact_mod_cast hlc2
      exact (Finsupp.mem_support_iff.mp hF) hlF
    · simpa [Finsupp.mem_support_iff] using hF
  have pind_core : ∀ (n : ℕ) (l : BoundedExp I p →₀ (compositumFrobenius k K p)),
      (∀ F ∈ l.support, td F.1 ≤ n) →
      Finsupp.linearCombination (compositumFrobenius k K p) (monomialFamily x p) l = 0 →
      l = 0 := by
    intro n
    classical
    induction n with
    | zero =>
      intro l hdeg hlc
      exact deg_zero_rel_zero l (fun F hF => Nat.le_zero.mp (hdeg F hF)) hlc
    | succ n ih =>
      intro l hdeg hlc
      have hD0 : ∀ i : I, Drel i l = 0 := by
        intro i
        obtain ⟨θ, hθ⟩ := exists_dual_deriv i
        apply ih (Drel i l)
        · intro F hF
          have hms := Finsupp.mapDomain_support (f := shiftExp i) (s := scaleRel i l)
          rw [hDrel] at hF
          have hF2 := hms hF
          rw [Finset.mem_image] at hF2
          obtain ⟨E, hE, hEF⟩ := hF2
          have hEpos : 1 ≤ E.1 i := by
            rw [Finsupp.mem_support_iff, scaleRel_apply] at hE
            by_contra hc
            rw [not_le, Nat.lt_one_iff] at hc
            rw [hc] at hE; simp at hE
          have hEl : E ∈ l.support := by
            rw [Finsupp.mem_support_iff, scaleRel_apply] at hE
            rw [Finsupp.mem_support_iff]
            intro hlE; rw [hlE, mul_zero] at hE; exact hE rfl
          have htds := td_shift i E hEpos
          have hdE := hdeg E hEl
          rw [← hEF]
          omega
        · rw [Drel_linearCombination θ i hθ, hlc, map_zero]
      have hpos : ∀ E, td E.1 ≠ 0 → l E = 0 := by
        intro E hEd
        have hex : ∃ i, 1 ≤ E.1 i := by
          by_contra hc
          push Not at hc
          apply hEd
          rw [htd]
          apply Finset.sum_eq_zero
          intro j _; have := hc j; change E.1 j = 0; omega
        obtain ⟨i, hi⟩ := hex
        have hval := Drel_apply_shift i l E hi
        rw [hD0 i] at hval
        simp only [Finsupp.coe_zero, Pi.zero_apply] at hval
        have hne : (E.1 i : (compositumFrobenius k K p)) ≠ 0 := by
          have hcp : CharP (compositumFrobenius k K p) p := inferInstance
          rw [Ne, CharP.cast_eq_zero_iff (compositumFrobenius k K p) p (E.1 i)]
          intro hdvd
          have hle := Nat.le_of_dvd (by omega) hdvd
          have := E.2 i
          omega
        exact (mul_eq_zero.mp hval.symm).resolve_left hne
      have hsupp0 : ∀ F ∈ l.support, td F.1 = 0 := by
        intro F hF
        by_contra hFd
        exact (Finsupp.mem_support_iff.mp hF) (hpos F hFd)
      exact deg_zero_rel_zero l hsupp0 hlc
  rw [PIndependent, linearIndependent_iff]
  intro l hlc
  exact pind_core (l.support.sup (fun F => td F.1)) l
    (fun F hF => Finset.le_sup (f := fun F => td F.1) hF) hlc

/-! ### Partial derivatives along a `p`-basis -/

/-- Division with remainder on exponents: `x^F = (x^q)^p · x^r` with `r` bounded by `p`. -/
private theorem exists_monomialPow_eq_smul {I : Type*} (x : I → K) (p : ℕ) (hp : 0 < p)
    (F : I →₀ ℕ) : ∃ (q : I →₀ ℕ) (r : BoundedExp I p), F = p • q + r.1 ∧
      monomialPow x F = (⟨(monomialPow x q) ^ p, monomialPow_pow_mem_compositum x p q⟩ :
        compositumFrobenius k K p) • monomialFamily x p r := by
  obtain ⟨q, r, hr, hF⟩ : ∃ q r : I →₀ ℕ, (∀ i, r i < p) ∧ F = p • q + r :=
    ⟨F.mapRange (· / p) (by simp), F.mapRange (· % p) (by simp),
      fun i => by simpa using Nat.mod_lt _ hp, by ext i; simp [Nat.div_add_mod]⟩
  exact ⟨q, ⟨r, hr⟩, hF, by rw [hF, monomialPow_add, monomialPow_nsmul]; rfl⟩

/-- Exponent arithmetic: `x^E · x^{F - 1_{i₀}} = x^{(E + F) - 1_{i₀}}` when `F(i₀) ≥ 1`. -/
private theorem monomialPow_mul_sub_single {I : Type*} (x : I → K) (E F : I →₀ ℕ)
    (i₀ : I) (hF : 1 ≤ F i₀) :
    monomialPow x E * monomialPow x (F - Finsupp.single i₀ 1)
      = monomialPow x ((E + F) - Finsupp.single i₀ 1) := by
  classical
  rw [← monomialPow_add]; congr 1; ext j
  rcases eq_or_ne j i₀ with hj | hj
  · subst hj
    have hs : (Finsupp.single j 1) j = 1 := Finsupp.single_eq_same
    simp only [Finsupp.add_apply, Finsupp.tsub_apply, hs]; omega
  · have hs : (Finsupp.single i₀ 1) j = 0 := Finsupp.single_eq_of_ne hj
    simp only [Finsupp.add_apply, Finsupp.tsub_apply, hs]; omega

/-- Exponent arithmetic: `(x^q)^p · x^{r - 1_{i₀}} = x^{(p•q + r) - 1_{i₀}}` when `r(i₀) ≥ 1`. -/
private theorem monomialPow_pow_mul_sub_single {I : Type*} (x : I → K) (p : ℕ) (q r : I →₀ ℕ)
    (i₀ : I) (hri : 1 ≤ r i₀) :
    (monomialPow x q) ^ p * monomialPow x (r - Finsupp.single i₀ 1)
      = monomialPow x ((p • q + r) - Finsupp.single i₀ 1) := by
  rw [← monomialPow_nsmul]; exact monomialPow_mul_sub_single x (p • q) r i₀ hri

set_option backward.isDefEq.respectTransparency true in
/-- For a `p`-basis `{x_i}` and an index `i₀`, the `kK^p`-linear map sending each basis monomial
`x^E` to `E(i₀) · x^{E - 1_{i₀}}` sends every monomial `x^G` to `G(i₀) · x^{G - 1_{i₀}}`. -/
private theorem constr_apply_monomialPow {I : Type*} (x : I → K) (p : ℕ)
    [hp : Fact (Nat.Prime p)] [CharP K p] (hx : PBasis k x p) (i₀ : I) (G : I →₀ ℕ) :
    (hx.basis.constr (compositumFrobenius k K p)
        (fun E : BoundedExp I p => ((E.1 i₀ : K)) * monomialPow x (E.1 - Finsupp.single i₀ 1)))
      (monomialPow x G)
      = (G i₀ : K) * monomialPow x (G - Finsupp.single i₀ 1) := by
  classical
  set R := compositumFrobenius k K p with hR
  set bval : BoundedExp I p → K :=
    fun E => ((E.1 i₀ : K)) * monomialPow x (E.1 - Finsupp.single i₀ 1) with hbval
  set θ : K →ₗ[R] K := hx.basis.constr R bval with hθ
  have hbasis : ∀ E : BoundedExp I p, θ (monomialFamily x p E) = bval E := fun E => by
    rw [hθ, ← hx.basis_apply E, Module.Basis.constr_basis]
  show θ (monomialPow x G) = (G i₀ : K) * monomialPow x (G - Finsupp.single i₀ 1)
  obtain ⟨q, ⟨r, hrbound⟩, hdecomp, hGsmul⟩ :=
    exists_monomialPow_eq_smul (k := k) x p hp.out.pos G
  rw [hGsmul, map_smul, hbasis ⟨r, hrbound⟩]
  have hGi : G i₀ = p * q i₀ + r i₀ := by
    simpa [Finsupp.add_apply, Finsupp.smul_apply, smul_eq_mul] using
      congrArg (fun (f : I →₀ ℕ) => f i₀) hdecomp
  have hcast : (G i₀ : K) = (r i₀ : K) := by
    rw [hGi]; push_cast; rw [CharP.cast_eq_zero K p]; ring
  show (monomialPow x q) ^ p • bval ⟨r, hrbound⟩ = _
  rw [hcast]
  show (monomialPow x q) ^ p • ((r i₀ : K) * monomialPow x (r - Finsupp.single i₀ 1))
      = (r i₀ : K) * monomialPow x (G - Finsupp.single i₀ 1)
  rcases Nat.eq_zero_or_pos (r i₀) with h0 | hpos
  · rw [h0]; simp
  · rw [smul_eq_mul]
    rw [show (monomialPow x q) ^ p * ((r i₀ : K) * monomialPow x (r - Finsupp.single i₀ 1))
          = (r i₀ : K) * ((monomialPow x q) ^ p * monomialPow x (r - Finsupp.single i₀ 1)) by ring]
    rw [monomialPow_pow_mul_sub_single x p q r i₀ hpos, ← hdecomp]

set_option backward.isDefEq.respectTransparency true in
/-- If `{x_i}` is a `p`-basis of `K` over `k`, then the differentials `{d x_i}` are `K`-linearly
independent. -/
private theorem linearIndependent_differentials_of_pBasis {I : Type*} (x : I → K) (p : ℕ)
    [Fact (Nat.Prime p)] [CharP K p] (hx : PBasis k x p) :
    LinearIndependent K (fun i => (KaehlerDifferential.D k K) (x i)) := by
  classical
  set R := compositumFrobenius k K p with hR
  have hdual : ∀ i₀ : I, ∃ Θ : Derivation k K K,
      ∀ j, Θ (x j) = if j = i₀ then 1 else 0 := by
    intro i₀
    set bval : BoundedExp I p → K :=
      fun E => ((E.1 i₀ : K)) * monomialPow x (E.1 - Finsupp.single i₀ 1) with hbval
    set θ : K →ₗ[R] K := hx.basis.constr R bval with hθ
    have hGf : ∀ G : I →₀ ℕ,
        θ (monomialPow x G) = (G i₀ : K) * monomialPow x (G - Finsupp.single i₀ 1) :=
      constr_apply_monomialPow x p hx i₀
    have hLeibMon : ∀ E F : I →₀ ℕ,
        θ (monomialPow x E * monomialPow x F)
          = monomialPow x E • θ (monomialPow x F) + monomialPow x F • θ (monomialPow x E) := by
      intro E F
      rw [← monomialPow_add, hGf (E + F), hGf E, hGf F]
      simp only [smul_eq_mul]
      have hEF : ((E + F) i₀ : K) = (E i₀ : K) + (F i₀ : K) := by
        rw [Finsupp.add_apply]; push_cast; ring
      rw [hEF]
      have hF0 : (F i₀ : K) * (monomialPow x E * monomialPow x (F - Finsupp.single i₀ 1))
          = (F i₀ : K) * monomialPow x ((E + F) - Finsupp.single i₀ 1) := by
        rcases eq_or_ne (F i₀) 0 with h | h
        · rw [h]; simp
        · rw [monomialPow_mul_sub_single x E F i₀ (Nat.one_le_iff_ne_zero.mpr h)]
      have hE0 : (E i₀ : K) * (monomialPow x F * monomialPow x (E - Finsupp.single i₀ 1))
          = (E i₀ : K) * monomialPow x ((E + F) - Finsupp.single i₀ 1) := by
        rcases eq_or_ne (E i₀) 0 with h | h
        · rw [h]; simp
        · rw [monomialPow_mul_sub_single x F E i₀ (Nat.one_le_iff_ne_zero.mpr h), add_comm F E]
      rw [show monomialPow x E * ((F i₀ : K) * monomialPow x (F - Finsupp.single i₀ 1))
            = (F i₀ : K) * (monomialPow x E * monomialPow x (F - Finsupp.single i₀ 1)) by ring,
          show monomialPow x F * ((E i₀ : K) * monomialPow x (E - Finsupp.single i₀ 1))
            = (E i₀ : K) * (monomialPow x F * monomialPow x (E - Finsupp.single i₀ 1)) by ring,
          hF0, hE0]
      ring
    have hLeib : ∀ u v : K, θ (u * v) = u • θ v + v • θ u := by
      have hRlin : ∀ (c : R) (w : K), θ ((c : K) * w) = (c : K) * θ w := by
        intro c w
        have h := map_smul θ c w
        have e1 : (c • w : K) = (c : K) * w := rfl
        have e2 : (c • θ w : K) = (c : K) * θ w := rfl
        rw [e1, e2] at h; exact h
      have hsmulK : ∀ (a w : K), a • w = a * w := fun _ _ => smul_eq_mul ..
      have hgen : ∀ (A : BoundedExp I p) (v : K),
          θ (monomialFamily x p A * v)
            = monomialFamily x p A * θ v + v * θ (monomialFamily x p A) := by
        intro A v
        have hv : v ∈ Submodule.span R (Set.range (monomialFamily x p)) := hx.2 Submodule.mem_top
        induction hv using Submodule.span_induction with
        | mem c hc =>
            obtain ⟨B, rfl⟩ := hc
            have := hLeibMon A.1 B.1
            simpa only [hsmulK, monomialFamily] using this
        | zero => simp
        | add u w hu hw ihu ihw =>
            rw [mul_add, map_add, ihu, ihw, map_add]; ring
        | smul c u hu ihu =>
            rw [show (c • u : K) = (c:K) * u from rfl,
              ← mul_assoc, mul_comm (monomialFamily x p A) (c:K), mul_assoc,
              hRlin, hRlin, ihu]
            ring
      intro u v
      have hu : u ∈ Submodule.span R (Set.range (monomialFamily x p)) := hx.2 Submodule.mem_top
      rw [hsmulK, hsmulK]
      induction hu using Submodule.span_induction with
      | mem c hc =>
          obtain ⟨A, rfl⟩ := hc
          exact hgen A v
      | zero => simp
      | add a b' ha hb iha ihb =>
          rw [add_mul, map_add, iha, ihb, map_add]; ring
      | smul c a ha iha =>
          rw [show (c • a : K) = (c:K) * a from rfl, mul_assoc, hRlin, hRlin, iha]
          ring
    set θk : K →ₗ[k] K := by
      refine { toFun := θ, map_add' := θ.map_add, map_smul' := ?_ }
      intro c v
      have hc : (algebraMap k K) c ∈ R := by
        apply Subfield.subset_closure; left; exact ⟨c, rfl⟩
      have h1 : c • v = (⟨(algebraMap k K) c, hc⟩ : R) • v := by rw [Algebra.smul_def]; rfl
      rw [h1, map_smul]
      show (⟨(algebraMap k K) c, hc⟩ : R) • θ v = c • θ v
      have h2 : (⟨(algebraMap k K) c, hc⟩ : R) • θ v = (algebraMap k K c) * θ v := rfl
      rw [h2, Algebra.smul_def]
    with hθk
    have hθkapp : ∀ v, θk v = θ v := fun v => rfl
    refine ⟨Derivation.mk' θk ?_, ?_⟩
    · intro a b'
      rw [hθkapp, hθkapp, hθkapp]
      show θ (a * b') = a • θ b' + b' • θ a
      rw [hLeib]
    · intro j
      show θk (x j) = if j = i₀ then 1 else 0
      rw [hθkapp]
      have hxj : x j = monomialPow x (Finsupp.single j 1) := by
        rw [monomialPow_single, pow_one]
      rw [hxj, hGf (Finsupp.single j 1)]
      by_cases hj : j = i₀
      · subst hj
        rw [Finsupp.single_eq_same, ite_eq_left rfl, Nat.cast_one, one_mul]
        rw [show Finsupp.single j 1 - Finsupp.single j 1 = (0 : I →₀ ℕ) by simp,
          monomialPow_zero]
      · rw [Finsupp.single_eq_of_ne (Ne.symm hj), ite_eq_right hj, Nat.cast_zero, zero_mul]
  choose Θ hΘ using hdual
  set φ : I → (KaehlerDifferential k K →ₗ[K] K) :=
    fun i₀ => (KaehlerDifferential.linearMapEquivDerivation k K).symm (Θ i₀) with hφ
  have hφapp : ∀ i₀ j, φ i₀ ((KaehlerDifferential.D k K) (x j)) = if j = i₀ then 1 else 0 := by
    intro i₀ j
    have : (KaehlerDifferential.linearMapEquivDerivation k K) (φ i₀) = Θ i₀ := by
      rw [hφ]
      exact (KaehlerDifferential.linearMapEquivDerivation k K).apply_symm_apply (Θ i₀)
    have h2 : (KaehlerDifferential.linearMapEquivDerivation k K) (φ i₀) (x j) = Θ i₀ (x j) := by
      rw [this]
    have h3 : (KaehlerDifferential.linearMapEquivDerivation k K) (φ i₀) (x j)
        = (φ i₀) ((KaehlerDifferential.D k K) (x j)) := by
      rfl
    rw [← h3, h2, hΘ i₀ j]
  rw [linearIndependent_iff]
  intro l hl
  ext i₀
  have := congrArg (φ i₀) hl
  rw [map_zero, Finsupp.linearCombination_apply, map_finsuppSum] at this
  simp only [map_smul, smul_eq_mul] at this
  rw [Finsupp.sum] at this
  rw [Finset.sum_eq_single i₀] at this
  · rw [hφapp i₀ i₀, ite_eq_left rfl, mul_one] at this
    simpa using this
  · intro c _ hc
    rw [hφapp i₀ c, ite_eq_right hc, mul_zero]
  · intro hi₀
    simp only [Finsupp.mem_support_iff, not_not] at hi₀
    rw [hi₀]; simp

/-- If `{x_i}` is a `p`-basis of `K` over `k`, then the differentials `{d x_i}` are `K`-linearly
independent and span `Ω_{K/k}`. -/
@[ega "0 21.1.7" "a)⇒c), special case",
  ega "0 21.2.4" "special case",
  ega "0 21.2.5" "special case",
  ega "0 21.4.4" "partial",
  ega "0 21.4.5" "partial"]
theorem pBasis_differentials_basis
    {I : Type*} (x : I → K) (p : ℕ) [Fact (Nat.Prime p)] [CharP K p]
    (hx : PBasis k x p) :
    LinearIndependent K (fun i => (KaehlerDifferential.D k K) (x i)) ∧
      ⊤ ≤ Submodule.span K
        (Set.range (fun i => (KaehlerDifferential.D k K) (x i))) := by
  classical
  refine ⟨linearIndependent_differentials_of_pBasis x p hx, ?_⟩
  set D := (KaehlerDifferential.D k K)
  set T := Submodule.span K (Set.range (fun i => D (x i))) with hT
  have hmon : ∀ E : BoundedExp I p, D (monomialFamily x p E) ∈ T := by
    intro E
    show D (monomialPow x E.1) ∈ T
    rw [monomialPow, Finsupp.prod]
    induction E.1.support using Finset.induction with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Derivation.leibniz]
      apply T.add_mem
      · exact T.smul_mem _ ih
      · apply T.smul_mem
        rw [Derivation.leibniz_pow]
        exact T.nsmul_mem (T.smul_mem _ (Submodule.subset_span ⟨a, rfl⟩)) _
  have hall : ∀ a : K, D a ∈ T := by
    intro a
    have ha : a ∈ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p)) :=
      hx.2 Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem c hc =>
        obtain ⟨E, rfl⟩ := hc
        exact hmon E
    | zero => simp
    | add u v hu hv ihu ihv => rw [map_add]; exact T.add_mem ihu ihv
    | smul c u hu ihu =>
        have hcu : c • u = (c : K) * u := rfl
        rw [hcu, Derivation.leibniz]
        apply T.add_mem
        · exact T.smul_mem _ ihu
        · rw [KaehlerDifferential.D_eq_zero_of_mem_compositumFrobenius p c.2, smul_zero]
          exact T.zero_mem
  rw [hT, ← KaehlerDifferential.span_range_derivation k K, Submodule.span_le]
  rintro _ ⟨a, rfl⟩
  exact hall a

/-! ### Maximal `p`-independent families -/

/-- The `p`-th power of every element of the `kK^p`-span of the monomials `x^E` lies in `kK^p`. -/
theorem span_monomials_pow_mem_compositum {I : Type*} (x : I → K) (p : ℕ)
    [hp : Fact (Nat.Prime p)] [CharP K p]
    {m : K}
    (hm : m ∈ Submodule.span (compositumFrobenius k K p)
            (Set.range (monomialFamily x p))) :
    m ^ p ∈ compositumFrobenius k K p := by
  have : ExpChar K p := ExpChar.prime hp.out
  set R := compositumFrobenius k K p with hR
  induction hm using Submodule.span_induction with
  | mem c hc =>
      obtain ⟨E, rfl⟩ := hc
      exact monomialPow_pow_mem_compositum x p E.1
  | zero =>
      rw [zero_pow hp.out.ne_zero]
      exact zero_mem R
  | add u v hu hv ihu ihv =>
      rw [add_pow_expChar]
      exact add_mem ihu ihv
  | smul c u hu ihu =>
      have hsmul : c • u = (c : K) * u := rfl
      rw [hsmul, mul_pow]
      exact mul_mem (pow_mem c.2 p) ihu

/-- The `kK^p`-span of the monomials `x^E` is closed under multiplication. -/
theorem span_monomials_mul_mem {I : Type*} (x : I → K) (p : ℕ)
    [hp : Fact (Nat.Prime p)] [CharP K p]
    {a b : K}
    (ha : a ∈ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p)))
    (hb : b ∈ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p))) :
    a * b ∈ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p)) := by
  have hppos : 0 < p := hp.out.pos
  set S := Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p)) with hS
  have hgen2 : ∀ (A B : BoundedExp I p),
      monomialFamily x p A * monomialFamily x p B ∈ S := by
    intro A B
    obtain ⟨q, r, -, hprod⟩ := exists_monomialPow_eq_smul (k := k) x p hppos (A.1 + B.1)
    change monomialPow x A.1 * monomialPow x B.1 ∈ S
    rw [← monomialPow_add, hprod]
    exact S.smul_mem _ (Submodule.subset_span ⟨r, rfl⟩)
  have hgenR : ∀ (B : BoundedExp I p) {a' : K}, a' ∈ S → a' * monomialFamily x p B ∈ S := by
    intro B a' ha'
    induction ha' using Submodule.span_induction with
    | mem c hc =>
        obtain ⟨A, rfl⟩ := hc
        exact hgen2 A B
    | zero => simp
    | add u v hu hv ihu ihv =>
        rw [add_mul]; exact S.add_mem ihu ihv
    | smul c u hu ihu =>
        rw [smul_mul_assoc]; exact S.smul_mem c ihu
  induction hb using Submodule.span_induction with
  | mem c hc =>
      obtain ⟨B, rfl⟩ := hc
      exact hgenR B ha
  | zero => simp
  | add u v hu hv ihu ihv =>
      rw [mul_add]; exact S.add_mem ihu ihv
  | smul c u hu ihu =>
      rw [mul_smul_comm]; exact S.smul_mem c ihu

/-- If `Mf` is a subfield of `K` and `y ∉ Mf` satisfies `yᵖ ∈ Mf`, then `1, y, …, y^{p-1}` are
`Mf`-linearly independent. -/
theorem linearIndependent_pow_of_pow_mem_of_notMem (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p]
    (Mf : Subfield K) {y : K} (hyp : y ^ p ∈ Mf) (hy : y ∉ Mf) :
    LinearIndependent Mf (fun e : Fin p => y ^ (e : ℕ)) := by
  set a : Mf := ⟨y ^ p, hyp⟩ with ha
  have hnp : ∀ b : Mf, b ^ p ≠ a := by
    intro b hb
    apply hy
    have hbk : (b : K) ^ p = y ^ p := by
      have := congrArg (Subfield.subtype Mf) hb
      simpa [ha] using this
    have hbe : (b : K) = y := by
      have hsub : ((b : K) - y) ^ p = 0 := by
        rw [sub_pow_char]; rw [hbk]; ring
      have : (b : K) - y = 0 :=
        pow_eq_zero_iff (Nat.pos_of_ne_zero (by have := hp.out.pos; omega)).ne' |>.mp hsub
      exact sub_eq_zero.mp this
    rw [← hbe]; exact b.2
  have hirr : Irreducible ((Polynomial.X : Polynomial ↥Mf) ^ p - Polynomial.C a) :=
    X_pow_sub_C_irreducible_of_prime hp.out hnp
  have hmonic : ((Polynomial.X : Polynomial ↥Mf) ^ p - Polynomial.C a).Monic :=
    Polynomial.monic_X_pow_sub_C a hp.out.ne_zero
  have hroot : (Polynomial.aeval y) ((Polynomial.X : Polynomial ↥Mf) ^ p - Polynomial.C a) = 0 := by
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, ha]
    show y ^ p - y ^ p = 0
    ring
  have hmin : minpoly Mf y = (Polynomial.X : Polynomial ↥Mf) ^ p - Polynomial.C a :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot hmonic).symm
  have hint : IsIntegral Mf y := ⟨_, hmonic, hroot⟩
  have hdeg : (minpoly Mf y).natDegree = p := by
    rw [hmin, Polynomial.natDegree_X_pow_sub_C]
  set pb := Algebra.adjoin.powerBasis hint with hpb
  have hpbdim : pb.dim = p := by rw [hpb, Algebra.adjoin.powerBasis_dim, hdeg]
  have hli : LinearIndependent Mf (fun i : Fin pb.dim => pb.gen ^ (i : ℕ)) := by
    have h := pb.basis.linearIndependent
    simpa [pb.basis_eq_pow] using h
  set incl : (Algebra.adjoin Mf {y}) →ₗ[Mf] K :=
    (Algebra.adjoin Mf {y}).val.toLinearMap with hincl
  have hker : incl.ker = ⊥ := by
    rw [LinearMap.ker_eq_bot, hincl]
    exact Subtype.val_injective
  have hmap := hli.map' incl hker
  have hcomp : (⇑incl ∘ fun i : Fin pb.dim => pb.gen ^ (i : ℕ))
      = fun i : Fin pb.dim => y ^ (i : ℕ) := by
    funext i
    simp only [Function.comp_apply, hincl, map_pow, hpb, Algebra.adjoin.powerBasis_gen,
      AlgHom.toLinearMap_apply, Subalgebra.coe_val]
  rw [hcomp] at hmap
  subst hpbdim
  exact hmap

/-- `kK^p` is contained in the `kK^p`-span of the monomials `x^E`. -/
private theorem mem_span_monomialFamily_of_mem_compositum {I : Type*} (x : I → K) (p : ℕ)
    (hp0 : 0 < p) {r : K} (hr : r ∈ compositumFrobenius k K p) :
    r ∈ Submodule.span (compositumFrobenius k K p) (Set.range (monomialFamily x p)) := by
  have h1M : (1 : K) ∈ Submodule.span (compositumFrobenius k K p)
      (Set.range (monomialFamily x p)) := by
    rw [← monomialFamily_zero x hp0]; exact Submodule.subset_span ⟨_, rfl⟩
  have hmem := Submodule.smul_mem _ (⟨r, hr⟩ : compositumFrobenius k K p) h1M
  rwa [Algebra.smul_def, mul_one, Subfield.algebraMap_ofSubfield] at hmem

/-- A point `y` of a set `S` lies in the `kK^p`-span of the monomials of `S`. -/
private theorem mem_span_monomialFamily_of_mem {S : Set K} (p : ℕ) (hp1 : 1 < p) {y : K}
    (hy : y ∈ S) :
    y ∈ Submodule.span (compositumFrobenius k K p)
      (Set.range (monomialFamily (Subtype.val : S → K) p)) := by
  have hmon : monomialFamily (Subtype.val : S → K) p (BoundedExp.single hp1 ⟨y, hy⟩) = y :=
    monomialFamily_single (Subtype.val : S → K) hp1 _
  rw [← hmon]
  exact Submodule.subset_span ⟨_, rfl⟩

/-- The `kK^p`-span of the monomials `x^E` is the carrier of a subfield of `K`. -/
theorem exists_subfield_eq_span_monomials {I : Type*} (x : I → K) (p : ℕ)
    [hp : Fact (Nat.Prime p)] [CharP K p] :
    ∃ Mf : Subfield K, ∀ z : K,
      z ∈ Mf ↔ z ∈ Submodule.span (compositumFrobenius k K p)
        (Set.range (monomialFamily x p)) := by
  classical
  set R := compositumFrobenius k K p with hR
  set M := Submodule.span R (Set.range (monomialFamily x p)) with hM
  have hp0 : 0 < p := hp.out.pos
  have h1M : (1 : K) ∈ M := mem_span_monomialFamily_of_mem_compositum x p hp0 (one_mem R)
  have hpowM : ∀ (a : K), a ∈ M → ∀ n : ℕ, a ^ n ∈ M := by
    intro a ha n
    induction n with
    | zero => simpa using h1M
    | succ m ih => rw [pow_succ]; exact span_monomials_mul_mem x p ih ha
  refine ⟨{
    carrier := (M : Set K)
    mul_mem' := by intro a b ha hb; exact span_monomials_mul_mem x p ha hb
    one_mem' := h1M
    add_mem' := by intro a b ha hb; exact M.add_mem ha hb
    zero_mem' := M.zero_mem
    neg_mem' := by intro a ha; exact M.neg_mem ha
    inv_mem' := by
      intro a ha
      by_cases ha0 : a = 0
      · simp [ha0]
      · have hap : a ^ p ∈ R := span_monomials_pow_mem_compositum x p ha
        have hapM : (a ^ p)⁻¹ ∈ M :=
          mem_span_monomialFamily_of_mem_compositum x p hp0 (R.inv_mem hap)
        have hpow : a ^ (p - 1) ∈ M := hpowM a ha (p - 1)
        have key : a⁻¹ = a ^ (p - 1) * (a ^ p)⁻¹ := by
          have hpne : a ^ p ≠ 0 := pow_ne_zero _ ha0
          field_simp
          rw [← pow_succ']
          congr 1
          omega
        rw [key]
        exact span_monomials_mul_mem x p hpow hapM
  }, ?_⟩
  intro z
  rfl

set_option backward.isDefEq.respectTransparency true in
/-- For subfields `R ≤ Mf` of `K`, if `b` is an `R`-linearly independent family in `Mf` and `c` is
an `Mf`-linearly independent family in `K`, then the products `b i * c j` are `R`-linearly
independent. -/
private lemma linearIndependent_mul_of_subfield_le {K : Type*} [Field K]
    (R Mf : Subfield K) (hRle : R ≤ Mf)
    {ιb ιc : Type*} (b : ιb → Mf) (hb : LinearIndependent R (fun g => (b g : K)))
    (c : ιc → K) (hc : LinearIndependent Mf c) :
    LinearIndependent R (fun q : ιb × ιc => (b q.1 : K) * c q.2) := by
  let algRMf : Algebra R Mf := (Subfield.inclusion hRle).toAlgebra
  have towerRMfK : IsScalarTower R Mf K := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hb' : LinearIndependent R b :=
    LinearIndependent.of_comp ((Algebra.linearMap Mf K).restrictScalars R) hb
  have hsmul : LinearIndependent R (fun q : ιb × ιc => b q.1 • c q.2) :=
    linearIndependent_smul hb' hc
  have heq : (fun q : ιb × ιc => b q.1 • c q.2) = (fun q : ιb × ιc => (b q.1 : K) * c q.2) := by
    funext q
    show (b q.1 : K) • c q.2 = _
    rw [smul_eq_mul]
  rwa [heq] at hsmul

/-- The equivalence between `BoundedExp (Option S) p` and pairs of a `none`-exponent in `Fin p`
and a bounded exponent function on `S`. -/
noncomputable def boundedExpOptionEquiv {S : Type*} (p : ℕ) :
    BoundedExp (Option S) p ≃ Fin p × BoundedExp S p where
  toFun := fun E =>
    (⟨E.1 none, E.2 none⟩,
      ⟨Finsupp.some E.1, fun s => by rw [Finsupp.some_apply]; exact E.2 (some s)⟩)
  invFun := fun P =>
    ⟨Finsupp.optionEquiv.symm ((P.1 : ℕ), P.2.1), by
      intro o
      have h1 : Finsupp.optionEquiv (Finsupp.optionEquiv.symm ((P.1 : ℕ), P.2.1)) = ((P.1:ℕ),
          P.2.1) :=
        Finsupp.optionEquiv.apply_symm_apply _
      cases o with
      | none =>
        have : (Finsupp.optionEquiv.symm ((P.1:ℕ), P.2.1)) none = (P.1:ℕ) := by
          have := congrArg Prod.fst h1; simpa [Finsupp.optionEquiv] using this
        rw [this]
        exact P.1.2
      | some s =>
        have : (Finsupp.optionEquiv.symm ((P.1:ℕ), P.2.1)) (some s) = P.2.1 s := by
          rw [← Finsupp.some_apply]
          simp [Finsupp.optionEquiv]
        rw [this]
        exact P.2.2 s⟩
  left_inv := by
    intro E
    apply Subtype.ext
    change Finsupp.optionEquiv.symm (E.1 none, Finsupp.some E.1) = E.1
    have : (E.1 none, Finsupp.some E.1) = Finsupp.optionEquiv E.1 := by
      simp [Finsupp.optionEquiv]
    rw [this, Finsupp.optionEquiv.symm_apply_apply]
  right_inv := by
    intro P
    have h1 : Finsupp.optionEquiv (Finsupp.optionEquiv.symm ((P.1:ℕ), P.2.1)) = ((P.1:ℕ), P.2.1) :=
      Finsupp.optionEquiv.apply_symm_apply _
    apply Prod.ext
    · apply Fin.ext
      change (Finsupp.optionEquiv.symm ((P.1:ℕ), P.2.1)) none = (P.1:ℕ)
      have := congrArg Prod.fst h1; simpa [Finsupp.optionEquiv] using this
    · apply Subtype.ext
      change Finsupp.some (Finsupp.optionEquiv.symm ((P.1:ℕ), P.2.1)) = P.2.1
      simp [Finsupp.optionEquiv]

/-- Let `S` be `p`-independent, `y ∉ S`, and `Mf` a subfield of `K` whose elements are those of the
`kK^p`-span of the monomials of `S`. If `1, y, …, y^{p-1}` are `Mf`-linearly independent, then
`insert y S` is `p`-independent. -/
@[ega "0 21.1.10" "(ii)"]
theorem insert_pIndependent_reindex (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p]
    (S : Set K) (hSi : PIndependent k (Subtype.val : S → K) p)
    {y : K} (hyS : y ∉ S)
    (Mf : Subfield K)
    (hMf : ∀ z : K, z ∈ Mf ↔ z ∈ Submodule.span (compositumFrobenius k K p)
        (Set.range (monomialFamily (Subtype.val : S → K) p)))
    (hpow : LinearIndependent Mf (fun e : Fin p => y ^ (e : ℕ))) :
    PIndependent k (Subtype.val : ↥(insert y S) → K) p := by
  classical
  set R := compositumFrobenius k K p with hR
  set M := Submodule.span R (Set.range (monomialFamily (Subtype.val : S → K) p)) with hM
  have hp0 : 0 < p := hp.out.pos
  have hRle : R ≤ Mf := fun r hr =>
    (hMf r).2 (mem_span_monomialFamily_of_mem_compositum _ p hp0 hr)
  have hmonMf : ∀ G : BoundedExp S p, monomialFamily (Subtype.val : S → K) p G ∈ Mf := by
    intro G
    rw [hMf _, hM]
    exact Submodule.subset_span ⟨G, rfl⟩
  let b : BoundedExp S p → Mf := fun G => ⟨monomialFamily (Subtype.val : S → K) p G, hmonMf G⟩
  have hbK : LinearIndependent R (fun G => (b G : K)) := hSi
  have hmul : LinearIndependent R
      (fun q : BoundedExp S p × Fin p => (b q.1 : K) * (fun e : Fin p => y ^ (e:ℕ)) q.2) :=
    linearIndependent_mul_of_subfield_le R Mf hRle b hbK (fun e : Fin p => y ^ (e:ℕ)) hpow
  set J := (insert y S : Set K)
  let ej : ↥J ≃ Option ↥S := Set.subtypeInsertEquivOption hyS
  let be' : BoundedExp ↥J p ≃ BoundedExp ↥S p × Fin p :=
    ((boundedExpCongr p ej).trans (boundedExpOptionEquiv p)).trans (Equiv.prodComm _ _)
  have hfam : monomialFamily (Subtype.val : ↥J → K) p
      = (fun q : BoundedExp ↥S p × Fin p => (b q.1 : K) * (fun e : Fin p => y ^ (e:ℕ)) q.2) ∘ be'
        := by
    funext E
    show monomialPow (Subtype.val : ↥J → K) E.1 = _
    set F : Option ↥S →₀ ℕ := Finsupp.equivMapDomain ej E.1 with hF
    have hreindex : monomialPow (Subtype.val : ↥J → K) E.1
        = F.prod (fun o e => ((ej.symm o : ↥J) : K) ^ e) := by
      rw [hF]
      rw [Finsupp.prod_equivMapDomain ej E.1 (fun o e => ((ej.symm o : ↥J) : K) ^ e)]
      apply Finsupp.prod_congr
      intro j _
      simp
    rw [hreindex]
    rw [Finsupp.prod_option_index F (fun o e => ((ej.symm o : ↥J) : K) ^ e)
        (by intro o; rw [pow_zero]) (by intro o a c; rw [pow_add])]
    have hsval : ∀ s : ↥S, ((ej.symm (some s) : ↥J) : K) = (s : K) := by
      intro s; simp [ej, Set.subtypeInsertEquivOption]
    have hnval : ((ej.symm none : ↥J) : K) = y := by
      simp [ej, Set.subtypeInsertEquivOption]
    rw [hnval]
    have hsecond : (Finsupp.some F).prod (fun s e => ((ej.symm (some s) : ↥J) : K) ^ e)
        = monomialPow (Subtype.val : ↥S → K) (Finsupp.some F) := by
      rw [monomialPow]
      apply Finsupp.prod_congr
      intro s _
      rw [hsval s]
    rw [hsecond]
    show _ = (b (be' E).1 : K) * (fun e : Fin p => y ^ (e:ℕ)) (be' E).2
    have hG : (be' E).1 = (⟨Finsupp.some F, by
        intro s; rw [Finsupp.some_apply]; exact E.2 (ej.symm (some s))⟩ : BoundedExp ↥S p) := rfl
    have he : ((be' E).2 : ℕ) = F none := rfl
    rw [hG]
    show y ^ F none * monomialPow (Subtype.val : ↥S → K) (Finsupp.some F)
      = monomialPow (Subtype.val : ↥S → K) (Finsupp.some F) * y ^ ((be' E).2 : ℕ)
    rw [he, mul_comm]
  show LinearIndependent R (monomialFamily (Subtype.val : ↥J → K) p)
  rw [hfam]
  exact (linearIndependent_equiv be').mpr hmul

/-- If `S` is `p`-independent and `y` is not in the `kK^p`-span of the monomials of `S`, then
`insert y S` is `p`-independent. -/
@[ega "0 21.1.10" "(ii)", ega "0 21.4.1" "sufficiency"]
theorem insert_pIndependent_of_not_mem_span (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p]
    (S : Set K) (hSi : PIndependent k (Subtype.val : S → K) p)
    {y : K}
    (hy : y ∉ Submodule.span (compositumFrobenius k K p)
            (Set.range (monomialFamily (Subtype.val : S → K) p))) :
    PIndependent k (Subtype.val : ↥(insert y S) → K) p := by
  classical
  set R := compositumFrobenius k K p with hR
  set M := Submodule.span R (Set.range (monomialFamily (Subtype.val : S → K) p)) with hM
  obtain ⟨Mf, hMf⟩ := exists_subfield_eq_span_monomials (k := k) (Subtype.val : S → K) p
  have hyMf : y ∉ Mf := by rw [hMf y]; exact hy
  have hp0 : 0 < p := hp.out.pos
  have hyS : y ∉ S := by
    intro hyS
    exact hy (mem_span_monomialFamily_of_mem p hp.out.one_lt hyS)
  have hyp : y ^ p ∈ Mf := by
    rw [hMf (y ^ p)]
    have hyR : y ^ p ∈ R := Subfield.subset_closure (Set.mem_union_right _ ⟨y, rfl⟩)
    exact mem_span_monomialFamily_of_mem_compositum _ p hp0 hyR
  have hpow : LinearIndependent Mf (fun e : Fin p => y ^ (e : ℕ)) :=
    linearIndependent_pow_of_pow_mem_of_notMem p Mf hyp hyMf
  exact insert_pIndependent_reindex p S hSi hyS Mf hMf hpow

/-- A `p`-independent subset `S ⊆ K` that is maximal among `p`-independent subsets is a `p`-basis
of `K` over `k`. -/
theorem pBasis_of_maximal_pIndependent
    (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p]
    (S : Set K) (hSi : PIndependent k (Subtype.val : S → K) p)
    (hmax : ∀ T : Set K, S ⊆ T → PIndependent k (Subtype.val : T → K) p → T = S) :
    PBasis k (Subtype.val : S → K) p := by
  refine ⟨hSi, ?_⟩
  set R := compositumFrobenius k K p with hR
  set M := Submodule.span R (Set.range (monomialFamily (Subtype.val : S → K) p)) with hM
  rw [top_le_iff, eq_top_iff]
  intro y _
  by_contra hyM
  have hins : PIndependent k (Subtype.val : ↥(insert y S) → K) p :=
    insert_pIndependent_of_not_mem_span p S hSi hyM
  have hsub : S ⊆ insert y S := Set.subset_insert y S
  have heq : (insert y S : Set K) = S := hmax (insert y S) hsub hins
  have hyS : y ∈ S := heq ▸ Set.mem_insert y S
  exact hyM (mem_span_monomialFamily_of_mem p hp.out.one_lt hyS)

/-- Exponent functions bounded by `p` and supported in a subset `T`. -/
def boundedExpOn (T : Set K) (p : ℕ) : Set (K →₀ ℕ) := {E | (∀ a, E a < p) ∧ ↑E.support ⊆ T}

/-- Bounded exponent functions on `↥T` are equivalent to bounded exponent functions on `K`
supported in `T`. -/
noncomputable def boundedExpEquivBoundedExpOn (T : Set K) (p : ℕ) (hp0 : 0 < p) :
    BoundedExp (↥T) p ≃ ↥(boundedExpOn T p) where
  toFun := fun E => ⟨Finsupp.embDomain (Function.Embedding.subtype (· ∈ T)) E.1, by
    refine ⟨?_, ?_⟩
    · intro a
      rw [Finsupp.embDomain_apply]
      split
      · next h => exact E.2 _
      · exact hp0
    · intro a ha
      rw [Finset.mem_coe, Finsupp.support_embDomain, Finset.mem_map] at ha
      obtain ⟨i, _, rfl⟩ := ha
      exact (i).2 ⟩
  invFun := fun F => ⟨Finsupp.comapDomain Subtype.val F.1
      (Subtype.val_injective.injOn), by
    intro i
    rw [Finsupp.comapDomain_apply]
    exact F.2.1 _⟩
  left_inv := by
    intro E
    apply Subtype.ext
    ext i
    rw [Finsupp.comapDomain_apply, Finsupp.embDomain_apply, dite_eq_left ⟨i, rfl⟩]
    congr 1
    exact Subtype.val_injective
      (⟨i, rfl⟩ : ∃ a : ↥T, Function.Embedding.subtype (· ∈ T) a = (i : K)).choose_spec
  right_inv := by
    intro F
    apply Subtype.ext
    change Finsupp.embDomain (Function.Embedding.subtype (· ∈ T))
        (Finsupp.comapDomain Subtype.val F.1 (Subtype.val_injective.injOn)) = F.1
    rw [Finsupp.embDomain_eq_mapDomain]
    exact Finsupp.mapDomain_comapDomain _ Subtype.val_injective _ fun a ha => ⟨⟨a, F.2.2 ha⟩, rfl⟩

/-- The monomial family of `↥T` is the monomial family of `K` itself, composed with
`boundedExpEquivBoundedExpOn`. -/
theorem monomialFamily_eq_monomialPow_comp (T : Set K) (p : ℕ) (hp0 : 0 < p) :
    monomialFamily (Subtype.val : ↥T → K) p
      = (fun F : ↥(boundedExpOn T p) => monomialPow (id : K → K) (F : K →₀ ℕ)) ∘
        (boundedExpEquivBoundedExpOn T p hp0) := by
  funext E
  show monomialPow (Subtype.val : ↥T → K) E.1
      = monomialPow (id : K → K) (Finsupp.embDomain (Function.Embedding.subtype (· ∈ T)) E.1)
  unfold monomialPow
  rw [Finsupp.prod_embDomain]
  rfl

/-- `p`-independence of `↥T` is equivalent to linear independence of the monomials of `K`
indexed by `boundedExpOn T p`. -/
theorem pIndependent_iff_linearIndependent_monomialPow (T : Set K) (p : ℕ) (hp0 : 0 < p) :
    PIndependent k (Subtype.val : ↥T → K) p ↔
      LinearIndependent (compositumFrobenius k K p)
        (fun F : ↥(boundedExpOn T p) => monomialPow (id : K → K) (F : K →₀ ℕ)) := by
  unfold PIndependent
  rw [monomialFamily_eq_monomialPow_comp T p hp0]
  exact linearIndependent_equiv (boundedExpEquivBoundedExpOn T p hp0)

/-- A `p`-independent family `x : I → K` is injective. -/
theorem PIndependent.injective {I : Type*} {x : I → K} {p : ℕ}
    (hx : PIndependent k x p) (hp1 : 1 < p) : Function.Injective x := by
  classical
  have hmono : Function.Injective (monomialFamily x p) :=
    LinearIndependent.injective
      (hx : LinearIndependent (compositumFrobenius k K p) (monomialFamily x p))
  intro i j hij
  by_contra hne
  have hmeq : monomialFamily x p (BoundedExp.single hp1 i)
      = monomialFamily x p (BoundedExp.single hp1 j) := by
    rw [monomialFamily_single, monomialFamily_single, hij]
  have heq := hmono hmeq
  have hsingle : (Finsupp.single i 1 : I →₀ ℕ) = Finsupp.single j 1 := congrArg Subtype.val heq
  have hval := congrArg (fun (f : I →₀ ℕ) => f i) hsingle
  simp only [Finsupp.single_eq_same, Finsupp.single_apply, ite_eq_right (Ne.symm hne)] at hval
  exact one_ne_zero hval

/-- The monomial family of an injective family `x` is the monomial family of `Set.range x`,
reindexed along `Equiv.ofInjective`. -/
theorem monomialFamily_eq_comp_ofInjective {I : Type*} {x : I → K} (p : ℕ)
    (hinj : Function.Injective x) :
    monomialFamily x p = (monomialFamily (Subtype.val : ↥(Set.range x) → K) p) ∘
      (boundedExpCongr p (Equiv.ofInjective x hinj)) := by
  let e : I ≃ ↥(Set.range x) := Equiv.ofInjective x hinj
  funext E
  show monomialPow x E.1
    = monomialPow (Subtype.val : ↥(Set.range x) → K) (Finsupp.equivMapDomain e E.1)
  rw [monomialPow, monomialPow, Finsupp.prod_equivMapDomain e E.1 (fun j n => ((j : K)) ^ n)]
  exact Finsupp.prod_congr fun i _ => by rw [Equiv.ofInjective_apply x hinj i]

/-- The range of a `p`-independent family, as a subset of `K`, is `p`-independent. -/
theorem PIndependent.range {I : Type*} {x : I → K} {p : ℕ}
    (hx : PIndependent k x p) (hp1 : 1 < p) :
    PIndependent k (Subtype.val : ↥(Set.range x) → K) p := by
  have hinj := hx.injective hp1
  have hx' : LinearIndependent (compositumFrobenius k K p) (monomialFamily x p) := hx
  rw [monomialFamily_eq_comp_ofInjective p hinj] at hx'
  exact (linearIndependent_equiv (boundedExpCongr p (Equiv.ofInjective x hinj))).mp hx'

omit [Field K] in
/-- `boundedExpOn T p` is monotone in `T`. -/
theorem boundedExpOn_mono {T₁ T₂ : Set K} (h : T₁ ⊆ T₂) (p : ℕ) :
    boundedExpOn T₁ p ⊆ boundedExpOn T₂ p :=
  fun _ hE => ⟨hE.1, hE.2.trans h⟩

omit [Field K] in
/-- For a nonempty chain `c` of subsets of `K`, the bounded exponent functions supported in `⋃₀ c`
are the union of those supported in the members of `c`. -/
theorem boundedExpOn_sUnion_of_chain {c : Set (Set K)} (hchain : IsChain (· ⊆ ·) c)
    (hne : c.Nonempty) (p : ℕ) :
    boundedExpOn (⋃₀ c) p = ⋃₀ ((fun T => boundedExpOn T p) '' c) := by
  ext E
  constructor
  · rintro ⟨hb, hsupp⟩
    have hsub : (↑(E.support) : Set K) ⊆ ⋃ s ∈ c, id s := by
      intro a ha
      obtain ⟨s, hsc, has⟩ := Set.mem_sUnion.mp (hsupp ha)
      exact Set.mem_biUnion hsc has
    obtain ⟨T, hTc, hTsub⟩ :=
      (hchain.directedOn : DirectedOn (fun a b => id a ⊆ id b)
        c).exists_mem_subset_of_finset_subset_biUnion hne hsub
    exact ⟨boundedExpOn T p, ⟨T, hTc, rfl⟩, hb, hTsub⟩
  · rintro ⟨W, ⟨T, hTc, rfl⟩, hb, hsupp⟩
    exact ⟨hb, hsupp.trans (Set.subset_sUnion_of_mem hTc)⟩

/-- The union of a nonempty chain of `p`-independent subsets of `K` is `p`-independent. -/
theorem pIndependent_sUnion_of_chain {c : Set (Set K)} (hchain : IsChain (· ⊆ ·) c)
    (hne : c.Nonempty) (p : ℕ) (hp0 : 0 < p)
    (h : ∀ T ∈ c, PIndependent k (Subtype.val : ↥T → K) p) :
    PIndependent k (Subtype.val : ↥(⋃₀ c) → K) p := by
  rw [pIndependent_iff_linearIndependent_monomialPow _ p hp0]
  set S : Set (Set (K →₀ ℕ)) := (fun T => boundedExpOn T p) '' c with hS
  have hSdir : DirectedOn (· ⊆ ·) S := by
    rintro A ⟨T₁, hT₁, rfl⟩ B ⟨T₂, hT₂, rfl⟩
    rcases hchain.total hT₁ hT₂ with hle | hle
    · exact ⟨boundedExpOn T₂ p, ⟨T₂, hT₂, rfl⟩, boundedExpOn_mono hle p, le_refl _⟩
    · exact ⟨boundedExpOn T₁ p, ⟨T₁, hT₁, rfl⟩, le_refl _, boundedExpOn_mono hle p⟩
  have hSind : ∀ s ∈ S, LinearIndependent (compositumFrobenius k K p)
      (fun i : (s : Set (K →₀ ℕ)) => monomialPow (id : K → K) (i : K →₀ ℕ)) := by
    rintro s ⟨T, hTc, rfl⟩
    exact (pIndependent_iff_linearIndependent_monomialPow T p hp0).mp (h T hTc)
  rw [boundedExpOn_sUnion_of_chain hchain hne p]
  exact linearIndepOn_sUnion_of_directed hSdir hSind

/-- **Stacks 07P2** (extension to p-basis).
Every `p`-independent family `{x_i}` over `k` extends to a `p`-basis: there is a subset `S ⊆ K`
containing the range of `x` whose inclusion `S → K` is a `p`-basis of `K` over `k`. -/
@[stacks 07P2 "extension to p-basis", ega "0 21.4.2" "more general"]
theorem exists_pBasis_extending
    {I : Type*} (x : I → K) (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p]
    (hx : PIndependent k x p) :
    ∃ S : Set K, Set.range x ⊆ S ∧ PBasis k (Subtype.val : S → K) p := by
  classical
  set 𝒮 : Set (Set K) :=
    {T : Set K | Set.range x ⊆ T ∧ PIndependent k (Subtype.val : ↥T → K) p} with h𝒮
  have hbase : Set.range x ∈ 𝒮 := ⟨le_refl _, hx.range hp.out.one_lt⟩
  have hchaincond : ∀ c ⊆ 𝒮, IsChain (· ⊆ ·) c → c.Nonempty →
      ∃ ub ∈ 𝒮, ∀ s ∈ c, s ⊆ ub := by
    intro c hc hchain hne
    obtain ⟨T, hTc⟩ := hne
    exact ⟨⋃₀ c, ⟨(hc hTc).1.trans (Set.subset_sUnion_of_mem hTc),
      pIndependent_sUnion_of_chain hchain ⟨T, hTc⟩ p hp.out.pos fun T hTc => (hc hTc).2⟩,
      fun _ => Set.subset_sUnion_of_mem⟩
  obtain ⟨S, hbaseS, hmaxS⟩ := zorn_subset_nonempty 𝒮 hchaincond (Set.range x) hbase
  exact ⟨S, hbaseS, pBasis_of_maximal_pIndependent p S hmaxS.1.2 fun T hST hTi =>
    hmaxS.eq_of_ge ⟨hbaseS.trans hST, hTi⟩ hST⟩

/-- **Stacks 07P2** (existence of p-basis).
There is a subset of `K` that is a `p`-basis of `K` over `k`. -/
@[stacks 07P2 "existence of p-basis", ega "0 21.4.2"]
theorem exists_pBasis (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p] :
    ∃ S : Set K, PBasis k (Subtype.val : S → K) p := by
  have hpind : PIndependent k (fun _ : Empty => (0 : K)) p := by
    unfold PIndependent monomialFamily monomialPow
    have hsing : (fun (E : BoundedExp Empty p) => (E.1).prod (fun i e => (fun _ => (0:K)) i ^ e))
        = fun _ => (1 : K) := by
      funext E
      have : E.1 = 0 := by
        ext i; exact i.elim
      rw [this]; simp
    rw [hsing]
    have : Unique (BoundedExp Empty p) :=
      { default := ⟨0, fun i => i.elim⟩
        uniq := fun E => by apply Subtype.ext; ext i; exact i.elim }
    rw [linearIndependent_unique_iff]
    simp
  obtain ⟨S, _, hS⟩ := exists_pBasis_extending (k := k) (fun _ : Empty => (0 : K)) p hpind
  exact ⟨S, hS⟩

/-- **Stacks 07P2** ((1)<=>(2)).
For a family `x : I → K`, the elements `{x_i}` are `p`-independent over `k` if and only if the
differentials `{d x_i}` are `K`-linearly independent in `Ω_{K/k}`. -/
@[stacks 07P2 "(1)<=>(2)",
  ega "0 21.2.4" "partial",
  ega "0 21.2.5" "partial",
  ega "0 21.4.5",
  ega "0 21.4.6" "(b) ⇔ (c)"]
theorem pIndependent_iff_linearIndependent_differentials
    {I : Type*} (x : I → K) (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p] :
    PIndependent k x p ↔
      LinearIndependent K (fun i => (KaehlerDifferential.D k K) (x i)) := by
  refine ⟨fun hx => ?_, pIndependent_of_linearIndependent_differentials x p⟩
  obtain ⟨S, hrange, hPB⟩ := exists_pBasis_extending (k := k) x p hx
  exact (pBasis_differentials_basis (Subtype.val : ↥S → K) p hPB).1.comp
    (fun i => ⟨x i, hrange ⟨i, rfl⟩⟩) fun _ _ hij =>
      hx.injective hp.out.one_lt (congrArg Subtype.val hij)

/-- If `x` is injective and its range is a `p`-basis of `K` over `k`, then `x` is a `p`-basis. -/
private theorem pBasis_of_pBasis_range {I : Type*} (x : I → K) (p : ℕ)
    [Fact (Nat.Prime p)] [CharP K p]
    (hxinj : Function.Injective x)
    (hPB : PBasis k (Subtype.val : ↥(Set.range x) → K) p) :
    PBasis k x p := by
  classical
  let e : I ≃ ↥(Set.range x) := Equiv.ofInjective x hxinj
  have hfam := monomialFamily_eq_comp_ofInjective p hxinj
  refine ⟨?_, ?_⟩
  · rw [PIndependent, hfam]
    exact (linearIndependent_equiv (boundedExpCongr p e)).mpr hPB.1
  · rw [hfam, Set.range_comp, (boundedExpCongr p e).surjective.range_eq, Set.image_univ]
    exact hPB.2

/-- **Stacks 07P2** ((a)<=>(b)).
For a family `x : I → K`, the elements `{x_i}` form a `p`-basis of `K` over `k` if and only if the
differentials `{d x_i}` form a `K`-basis of `Ω_{K/k}`. -/
@[stacks 07P2 "(a)<=>(b)",
  ega "0 21.4.5" "p-base case",
  ega "0 21.1.7" "a)⇒c), special case",
  ega "0 21.2.4" "special case",
  ega "0 21.2.5" "special case",
  ega "0 21.4.4" "more general"]
theorem pBasis_iff_basis_differentials
    {I : Type*} (x : I → K) (p : ℕ) [hp : Fact (Nat.Prime p)] [CharP K p] :
    PBasis k x p ↔
      (LinearIndependent K (fun i => (KaehlerDifferential.D k K) (x i)) ∧
        ⊤ ≤ Submodule.span K
          (Set.range (fun i => (KaehlerDifferential.D k K) (x i)))) := by
  have h1 := pIndependent_iff_linearIndependent_differentials (k := k) x p
  rw [PBasis, h1]
  constructor
  · rintro ⟨hli, hspan⟩
    exact ⟨hli, (pBasis_differentials_basis x p ⟨h1.mpr hli, hspan⟩).2⟩
  · rintro ⟨hli, hspan⟩
    refine ⟨hli, ?_⟩
    classical
    set D := (KaehlerDifferential.D k K)
    have hpind : PIndependent k x p := h1.mpr hli
    have hmax : ∀ T : Set K, Set.range x ⊆ T →
        PIndependent k (Subtype.val : ↥T → K) p → T = Set.range x := by
      intro T hsub hTi
      have hTindep : LinearIndependent K (fun s : ↥T => D ((s : K))) :=
        (pIndependent_iff_linearIndependent_differentials (Subtype.val : ↥T → K) p).mp hTi
      apply Set.Subset.antisymm _ hsub
      intro t ht
      by_contra htr
      set s₀ : ↥T := ⟨t, ht⟩ with hs₀
      have hsubset : Set.range (fun i => D (x i)) ⊆
          (fun s : ↥T => D ((s : K))) '' {s : ↥T | s ≠ s₀} := by
        rintro _ ⟨i, rfl⟩
        refine ⟨⟨x i, hsub ⟨i, rfl⟩⟩, ?_, rfl⟩
        exact fun hcontra => htr ⟨i, congrArg Subtype.val hcontra⟩
      have hmem : D ((s₀ : K)) ∈
          Submodule.span K ((fun s : ↥T => D ((s : K))) '' {s : ↥T | s ≠ s₀}) :=
        Submodule.span_mono hsubset (hspan Submodule.mem_top)
      exact (hTindep.notMem_span_image (s := {s : ↥T | s ≠ s₀}) (fun h => h rfl)) hmem
    exact (pBasis_of_pBasis_range x p (hpind.injective hp.out.one_lt)
      (pBasis_of_maximal_pIndependent p (Set.range x)
        (hpind.range hp.out.one_lt) hmax)).2
