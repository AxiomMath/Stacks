module

public import Mathlib.FieldTheory.Perfect
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import StacksFrontier.FieldTheory.PBasis

/-!
# The degree of a field over the compositum of its `p`-th powers

Let `K / k` be an extension of fields and let `p` be a natural number.  The compositum
`kKᵖ = compositumFrobenius k K p` is the subfield of `K` generated by the image of `k`
together with all `p`-th powers of elements of `K`, and a family `x : I → K` is a `p`-basis
when the monomials `x ^ E` with `E i < p` form a `kKᵖ`-basis of `K` (Tag 07P1).  This file
computes the degree `[K : kKᵖ]` from the size of a `p`-basis: it is `p ^ #I`.

When `k` is perfect of characteristic `p` the compositum is just the subfield `Kᵖ` of `p`-th
powers, so the degree computed here is the degree of the absolute Frobenius of `K`.

## Main definitions

* `boundedExpEquivPi` identifies the bounded exponent functions on a finite index type `I`
  with the functions `I → Fin p`.

## Main results

* `card_boundedExp` counts the bounded exponent functions: there are `p ^ #I` of them.
* `PBasis.finrank_compositumFrobenius` computes `[K : kKᵖ] = p ^ #I` for a `p`-basis
  indexed by a finite type `I`.
* `compositumFrobenius_eq_fieldRange_frobenius` identifies `kKᵖ` with the range of the
  Frobenius of `K` when every element of `k` is a `p`-th power.
* `PBasis.finrank_fieldRange_frobenius` is the resulting degree of the Frobenius subfield.

## Implementation notes

`BoundedExp I p` is a subtype of `I →₀ ℕ`, so the equivalence with `I → Fin p` uses
`Finsupp.equivFunOnFinite` and is therefore noncomputable; the resulting `Finite` instance is
recorded so that `Module.finrank_eq_card_basis` applies to `PBasis.basis`.

Perfection of `k` is taken in the form `PerfectRing k p`, which says exactly that the
Frobenius of `k` is bijective.  That is the only consequence of perfection used, and it is
what `PerfectField k` supplies in characteristic `p`.

## References

* [Stacks Project, Tag 07P1](https://stacks.math.columbia.edu/tag/07P1)
* [Stacks Project, Tag 07P2](https://stacks.math.columbia.edu/tag/07P2)
-/


@[expose] public section

/-- The bounded exponent functions on a finite index type `I` are the functions `I → Fin p`. -/
noncomputable def boundedExpEquivPi {I : Type*} [Finite I] (p : ℕ) :
    BoundedExp I p ≃ (I → Fin p) where
  toFun E i := ⟨E.1 i, E.2 i⟩
  invFun f := ⟨Finsupp.equivFunOnFinite.symm fun i ↦ ((f i : ℕ)), fun i ↦ by simp⟩
  left_inv E := by
    apply Subtype.ext
    ext i
    simp
  right_inv f := by
    ext i
    simp

/-- There are finitely many bounded exponent functions on a finite index type. -/
instance {I : Type*} [Finite I] (p : ℕ) : Finite (BoundedExp I p) :=
  .of_equiv _ (boundedExpEquivPi p).symm

/-- There are `p ^ #I` bounded exponent functions on a finite index type `I`. -/
theorem card_boundedExp {I : Type*} [Finite I] (p : ℕ) :
    Nat.card (BoundedExp I p) = p ^ Nat.card I := by
  have := Fintype.ofFinite I
  rw [Nat.card_congr (boundedExpEquivPi p), Nat.card_pi]
  simp

/-- The degree of `K` over the compositum `kKᵖ` is `p ^ #I` for a `p`-basis indexed by a
finite type `I`. -/
theorem PBasis.finrank_compositumFrobenius {I : Type*} [Finite I] {k K : Type*} [Field k]
    [Field K] [Algebra k K] {x : I → K} {p : ℕ} (hx : PBasis k x p) :
    Module.finrank (compositumFrobenius k K p) K = p ^ Nat.card I := by
  have := Fintype.ofFinite (BoundedExp I p)
  rw [Module.finrank_eq_card_basis hx.basis, ← Nat.card_eq_fintype_card, card_boundedExp]

/-- If every element of `k` is a `p`-th power then the compositum `kKᵖ` is the subfield of
`p`-th powers of `K`, that is, the range of the Frobenius of `K`. -/
theorem compositumFrobenius_eq_fieldRange_frobenius (k K : Type*) [Field k] [Field K]
    [Algebra k K] (p : ℕ) [ExpChar k p] [ExpChar K p] [PerfectRing k p] :
    compositumFrobenius k K p = (frobenius K p).fieldRange := by
  refine le_antisymm (Subfield.closure_le.2 ?_) fun a ha ↦ ?_
  · rintro a (⟨c, rfl⟩ | ⟨b, rfl⟩)
    · obtain ⟨d, hd⟩ := surjective_frobenius k p c
      exact ⟨algebraMap k K d, by
        rw [frobenius_def] at hd ⊢
        rw [← hd, map_pow]⟩
    · exact ⟨b, frobenius_def p b⟩
  · obtain ⟨b, rfl⟩ := RingHom.mem_fieldRange.1 ha
    exact Subfield.subset_closure (.inr ⟨b, frobenius_def p b⟩)

/-- The degree of `K` over the subfield of its `p`-th powers is `p ^ #I` for a `p`-basis
indexed by a finite type `I`, over a base field all of whose elements are `p`-th powers. -/
theorem PBasis.finrank_fieldRange_frobenius {I : Type*} [Finite I] {k K : Type*} [Field k]
    [Field K] [Algebra k K] {x : I → K} {p : ℕ} [ExpChar k p] [ExpChar K p] [PerfectRing k p]
    (hx : PBasis k x p) :
    Module.finrank (frobenius K p).fieldRange K = p ^ Nat.card I := by
  rw [← compositumFrobenius_eq_fieldRange_frobenius k K p]
  exact hx.finrank_compositumFrobenius

end
