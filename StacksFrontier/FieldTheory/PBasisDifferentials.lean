  have hfg := fg_adjoin_of_finite (Set.finite_range (MvPolynomial.X (σ := σ) (R := R))) hint
  have hfin : Module.Finite h.range (MvPolynomial σ R) := by
    apply Module.finite_def.mpr
    change T.toSubmodule.FG at hfg
    simpa only [htop, Algebra.top_toSubmodule] using hfg
  exact ringHom_finite_of_finite_range h hfin

private lemma finite_field_of_pbasis_complement
    {p : ℕ} [Fact p.Prime] {k I : Type*} [Field k] [CharP k p]
    [Algebra (ZMod p) k] (x : I → k) (hx : _root_.PBasis (ZMod p) x p)
    (J : Finset I) :
    Module.Finite ↥((frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J})) k := by
  classical
  let S : Subfield k := (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J})
  let T := Algebra.adjoin S (x '' (J : Set I))
  have hbase : compositumFrobenius (ZMod p) k p ≤ S := by
    rw [compositumFrobenius_zmod]
    exact le_sup_left
  have hxT : ∀ i, x i ∈ T := by
    intro i
    by_cases hi : i ∈ J
    · exact Algebra.subset_adjoin ⟨i, hi, rfl⟩
    · have hxi : x i ∈ S := (show Subfield.closure (x '' {i | i ∉ J}) ≤ S from le_sup_right)
        (Subfield.subset_closure ⟨i, hi, rfl⟩)
      exact T.algebraMap_mem ⟨x i, hxi⟩
  have hT : T = ⊤ := by
    apply top_unique
    intro a hatop
    clear hatop
    have ha := hx.2 (show a ∈ (⊤ : Submodule (compositumFrobenius (ZMod p) k p) k) from trivial)
    induction ha using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨e, rfl⟩ := hy
      exact T.prod_mem fun i _ => T.pow_mem (hxT i) _
    | zero => exact T.zero_mem
    | add a b _ _ ha hb => exact T.add_mem ha hb
    | smul c a _ ha =>
      change (c : k) * a ∈ T
      exact T.mul_mem (T.algebraMap_mem ⟨c, hbase c.2⟩) ha
  have hint : ∀ a ∈ x '' (J : Set I), IsIntegral S a := by
    intro a _
    apply IsIntegral.of_pow (n := p) (Nat.Prime.pos Fact.out)
    have hpS : a ^ p ∈ S := (show (frobenius k p).fieldRange ≤ S from le_sup_left) ⟨a, rfl⟩
    exact isIntegral_algebraMap (x := (⟨a ^ p, hpS⟩ : S))
  have hfg := fg_adjoin_of_finite (J.finite_toSet.image x) hint
  apply Module.finite_def.mpr
  change T.toSubmodule.FG at hfg
  simpa only [hT, Algebra.top_toSubmodule] using hfg

private lemma mem_span_monomials_complement
    {p : ℕ} [Fact p.Prime] {k I : Type*} [Field k] [CharP k p]
    [Algebra (ZMod p) k] (x : I → k) (J : Finset I) {a : k}
    (ha : a ∈ (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J})) :
    a ∈ Submodule.span (compositumFrobenius (ZMod p) k p)
      (monomialFamily x p '' {E | ∀ i ∈ J, E.val i = 0}) := by
  classical
  let U := {i : I // i ∉ J}
  let y : U → k := fun i => x i.val
  let R := compositumFrobenius (ZMod p) k p
  obtain ⟨M, hM⟩ := exists_subfield_eq_span_monomials (k := ZMod p) y p
  have h1 : (1 : k) ∈ M := by
    rw [hM]
    apply Submodule.subset_span
    refine ⟨⟨0, fun _ => Nat.Prime.pos Fact.out⟩, ?_⟩
    simp [monomialFamily, monomialPow]
  have hR : R ≤ M := by
    intro r hr
    rw [hM] at h1 ⊢
    have h := Submodule.smul_mem
      (Submodule.span R (Set.range (monomialFamily y p))) (⟨r, hr⟩ : R) h1
    simpa only [Algebra.smul_def, Subfield.algebraMap_ofSubfield, Subfield.coe_subtype,
      mul_one] using h
  have hy : ∀ i : U, y i ∈ M := by
    intro i
    rw [hM]
    apply Submodule.subset_span
    refine ⟨⟨Finsupp.single i 1, ?_⟩, ?_⟩
    · intro j
      by_cases hij : i = j
      · simpa [hij] using (Nat.Prime.one_lt Fact.out)
      · simpa [Finsupp.single_apply, hij, Ne.symm hij] using (Nat.Prime.pos Fact.out)
    · simp [monomialFamily, monomialPow, Finsupp.prod_single_index]
  have hle : (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J}) ≤ M := by
    refine sup_le ?_ (Subfield.closure_le.mpr ?_)
    · simpa only [R, compositumFrobenius_zmod] using hR
    · rintro _ ⟨i, hi, rfl⟩
      exact hy ⟨i, hi⟩
  have ham := (hM a).mp (hle ha)
  apply Submodule.span_mono (t :=
    monomialFamily x p '' {E | ∀ i ∈ J, E.val i = 0}) ?_ ham
  rintro _ ⟨E, rfl⟩
  let emb : U ↪ I := ⟨Subtype.val, Subtype.val_injective⟩
  refine ⟨embDomainExp (Nat.Prime.pos Fact.out) emb E, ?_,
    monomialFamily_embDomainExp x (Nat.Prime.pos Fact.out) emb E⟩
  intro i hi
  change Finsupp.embDomain emb E.val i = 0
  rw [Finsupp.embDomain_of_notMem_range]
  rintro ⟨j, rfl⟩
  exact j.property hi

private lemma frobeniusFieldRange_eq_iInf_pbasis_complement
    {p : ℕ} [Fact p.Prime] {k I : Type*} [Field k] [CharP k p]
    [Algebra (ZMod p) k] (x : I → k) (hx : _root_.PBasis (ZMod p) x p) :
    (frobenius k p).fieldRange = ⨅ J : Finset I,
      (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J}) := by
  classical
  apply le_antisymm (le_iInf fun J => le_sup_left)
  intro a ha
  let b : Module.Basis (BoundedExp I p) (compositumFrobenius (ZMod p) k p) k :=
    Module.Basis.mk hx.1 hx.2
  have hb : ∀ E, b E = monomialFamily x p E := fun E => Module.Basis.mk_apply _ _ _
  have hrepr : ∀ E ∈ (b.repr a).support, E.val = 0 := by
    intro E hE
    ext i
    have haJ := mem_span_monomials_complement x {i} (a := a)
      ((Subfield.mem_iInf.mp ha) {i})
    have haJ' : a ∈ Submodule.span (compositumFrobenius (ZMod p) k p)
      (b '' {E | ∀ j ∈ ({i} : Finset I), E.val j = 0}) := by
      simpa only [show (b : BoundedExp I p → k) = monomialFamily x p from funext hb] using haJ
    exact b.repr_support_subset_of_mem_span _ haJ' hE i (Finset.mem_singleton_self i)
  rw [← compositumFrobenius_zmod]
  rw [← b.linearCombination_repr a]
  change ∑ E ∈ (b.repr a).support, (b.repr a E) • b E ∈
    compositumFrobenius (ZMod p) k p
  apply Subfield.sum_mem
  intro E hE
  have hbE : b E = 1 := by
    rw [hb]
    simp [monomialFamily, monomialPow, hrepr E hE]
  simpa only [hbE, Algebra.smul_def, Subfield.algebraMap_ofSubfield,
    Subfield.coe_subtype, mul_one] using (b.repr a E).property

namespace Stacks.FieldTheory.PBasisDifferentials

/-- A polynomial ring in finitely many variables over an integrally closed domain is integrally
closed: induct on the number of variables through `MvPolynomial.finSuccEquiv`, the integral closure
of a domain in a polynomial ring in one variable over it being the polynomial ring itself. -/
public theorem isIntegrallyClosed_mvPolynomial
    (R : Type*) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (n : ℕ) :
    IsIntegrallyClosed (MvPolynomial (Fin n) R) := by
  induction n with
  | zero => exact IsIntegrallyClosed.of_equiv (MvPolynomial.isEmptyRingEquiv R (Fin 0)).symm
  | succ n ih =>
    let := ih
    let : IsDomain (MvPolynomial (Fin n) R) := NoZeroDivisors.to_isDomain _
    exact IsIntegrallyClosed.of_equiv (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv

/-- A formal power-series ring in finitely many variables over an integrally closed Noetherian
domain is integrally closed: induct on the number of variables through
`MvPowerSeries.finSuccEquiv`, a power-series ring in one variable over an integrally closed
Noetherian domain being integrally closed. -/
@[ega "IV 21.13.9" "(iv)"]
public theorem isIntegrallyClosed_mvPowerSeries
    (R : Type*) [CommRing R] [IsDomain R] [IsNoetherianRing R]
    [IsIntegrallyClosed R] (n : ℕ) : IsIntegrallyClosed (MvPowerSeries (Fin n) R) := by
  induction n with
  | zero =>
    exact IsIntegrallyClosed.of_equiv
      (MvPowerSeries.isEmptyEquiv (σ := Fin 0) (R := R)).symm.toRingEquiv
  | succ n ih =>
    let := ih
    let : IsDomain (MvPowerSeries (Fin n) R) := NoZeroDivisors.to_isDomain _
    exact IsIntegrallyClosed.of_equiv (MvPowerSeries.finSuccEquiv R n).symm.toRingEquiv

end Stacks.FieldTheory.PBasisDifferentials

private lemma mem_range_of_pow_mem_of_mem_fractionField
    {R A K : Type*} [CommRing R] [IsDomain R] [IsIntegrallyClosed R]
    [CommRing A] [IsDomain A] [Field K] [Algebra A K] [IsFractionRing A K]
    (f : R →+* A) (hf : Function.Injective f) {a : A} {p : ℕ} (hp : 0 < p)
    (hap : a ^ p ∈ f.range)
    (ha : algebraMap A K a ∈ Subfield.closure
      (Set.range ((algebraMap A K).comp f))) : a ∈ f.range := by
  let j : R →+* K := (algebraMap A K).comp f
  have hj : Function.Injective j := (IsFractionRing.injective A K).comp hf
  let g : FractionRing R →+* K := IsFractionRing.lift hj
  have hg : g.fieldRange = Subfield.closure (Set.range j) :=
    IsFractionRing.lift_fieldRange hj
  rw [← hg] at ha
  obtain ⟨z, hz⟩ := ha
  obtain ⟨b, hb⟩ := hap
  have hzpow : z ^ p = algebraMap R (FractionRing R) b := by
    apply g.injective
    rw [map_pow, hz, IsFractionRing.lift_algebraMap hj]
    change (algebraMap A K a) ^ p = algebraMap A K (f b)
    rw [hb, map_pow]
  have hzint : IsIntegral R z := IsIntegral.of_pow hp (hzpow ▸ isIntegral_algebraMap)
  obtain ⟨c, hc⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hzint
  refine ⟨c, (IsFractionRing.injective A K) ?_⟩
  have hg' := congrArg g hc
  rwa [IsFractionRing.lift_algebraMap hj, hz] at hg'

private lemma adjoin_image_range_toSubfield
    {p : ℕ} [Fact p.Prime] {R A K : Type*} [CommRing R] [CommRing A] [Field K]
    [CharP K p] [Algebra (ZMod p) K] (f : R →+* A) (j : A →+* K) :
    (IntermediateField.adjoin (ZMod p) (j '' (f.range : Set A))).toSubfield =
      Subfield.closure (Set.range (j.comp f)) := by
  apply le_antisymm
  · change Subfield.closure _ ≤ _
    apply Subfield.closure_le.mpr
    rintro a (⟨z, rfl⟩ | ⟨b, ⟨c, rfl⟩, rfl⟩)
    · apply Subfield.subset_closure
      refine ⟨(z.val : R), ?_⟩
      simp only [map_natCast]
      simpa only [map_natCast] using congrArg (algebraMap (ZMod p) K) (ZMod.natCast_zmod_val z)
    · exact Subfield.subset_closure ⟨c, rfl⟩
  · apply Subfield.closure_le.mpr
    rintro _ ⟨c, rfl⟩
    exact IntermediateField.subset_adjoin _ _ ⟨f c, ⟨c, rfl⟩, rfl⟩

private noncomputable abbrev expandMap
    {R S σ τ : Type*} [CommRing R] [CommRing S] (p : ℕ) (hp : p ≠ 0)
    (f : R →+* S) : MvPolynomial τ (MvPowerSeries σ R) →+*
      MvPolynomial τ (MvPowerSeries σ S) :=
  MvPolynomial.eval₂Hom
    (MvPolynomial.C.comp ((MvPowerSeries.expand p hp).toRingHom.comp (MvPowerSeries.map f)))
    (fun i => MvPolynomial.X i ^ p)

private lemma expandMap_eq
    {R S σ τ : Type*} [CommRing R] [CommRing S] (p : ℕ) (hp : p ≠ 0)
    (f : R →+* S) : expandMap (σ := σ) (τ := τ) p hp f =
      (MvPolynomial.expand p).toRingHom.comp
        (MvPolynomial.map ((MvPowerSeries.expand p hp).toRingHom.comp (MvPowerSeries.map f))) := by
  apply MvPolynomial.ringHom_ext <;> intro <;> simp [expandMap]

private lemma expandMap_injective
    {R S σ τ : Type*} [CommRing R] [CommRing S] (p : ℕ) (hp : p ≠ 0)
    (f : R →+* S) (hf : Function.Injective f) :
    Function.Injective (expandMap (σ := σ) (τ := τ) p hp f) := by
  rw [expandMap_eq]
  apply (MvPolynomial.expand_injective (Nat.pos_of_ne_zero hp)).comp
  apply MvPolynomial.map_injective
  intro a b hab
  apply MvPowerSeries.ext
  intro d
  apply hf
  have hd := congrArg (MvPowerSeries.coeff (p • d)) hab
  simpa only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
    MvPowerSeries.coeff_expand_smul, MvPowerSeries.coeff_map] using hd

private lemma expandMap_eq_comp_map
    {R S σ τ : Type*} [CommRing R] [CommRing S] (p : ℕ) (hp : p ≠ 0)
    (f : R →+* S) : expandMap (σ := σ) (τ := τ) p hp f =
      (expandMap p hp (RingHom.id S)).comp (MvPolynomial.map (MvPowerSeries.map f)) := by
  simp only [expandMap_eq, MvPowerSeries.map_id, RingHom.comp_id]
  rw [RingHom.comp_assoc]
  congr 1
  apply RingHom.ext
  intro g
  simp only [RingHom.comp_apply, MvPolynomial.map_map]

private lemma mem_range_mapMap_iff
    {R S σ τ : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    (g : MvPolynomial τ (MvPowerSeries σ S)) :
    g ∈ (MvPolynomial.map (MvPowerSeries.map f)).range ↔
      ∀ d e, MvPowerSeries.coeff e (g.coeff d) ∈ f.range := by
  classical
  constructor
  · rintro ⟨g, rfl⟩ d e
    simp only [MvPolynomial.coeff_map, MvPowerSeries.coeff_map]
    exact ⟨_, rfl⟩
  · intro hg
    apply MvPolynomial.mem_range_map_iff_coeffs_subset.mpr
    intro a ha
    obtain ⟨d, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp ha
    choose c hc using hg d
    exact ⟨(fun e => c e : MvPowerSeries σ R), MvPowerSeries.ext hc⟩

private lemma expandMap_finite
    {R S σ τ : Type*} [CommRing R] [CommRing S] [Finite σ] [Finite τ]
    (p : ℕ) (hp : p ≠ 0) (f : R →+* S) (hf : f.Finite) :
    (expandMap (σ := σ) (τ := τ) p hp f).Finite := by
  rw [expandMap_eq]
  exact (mvPolynomial_expand_finite p hp).comp
    (mvPolynomial_map_finite _ ((mvPowerSeries_expand_finite p hp).comp
      (mvPowerSeries_map_finite f hf)))

private lemma expandMap_frobenius
    {k σ τ : Type*} [Field k] (p : ℕ) [Fact p.Prime] [CharP k p]
    (f : MvPolynomial τ (MvPowerSeries σ k)) :
    expandMap p (Nat.Prime.ne_zero Fact.out) (frobenius k p) f = f ^ p := by
  let : CharP (MvPowerSeries σ k) p :=
    charP_of_injective_algebraMap (algebraMap k _).injective p
  have h : (MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)).toRingHom.comp
      (MvPowerSeries.map (frobenius k p)) = frobenius (MvPowerSeries σ k) p := by
    ext g : 1
    change MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)
      (MvPowerSeries.map (frobenius k p) g) = g ^ p
    rw [← MvPowerSeries.map_expand, MvPowerSeries.map_frobenius_expand]
  rw [expandMap_eq, RingHom.comp_apply, h]
  change MvPolynomial.expand p (MvPolynomial.map (frobenius (MvPowerSeries σ k) p) f) = _
  rw [← MvPolynomial.map_expand, MvPolynomial.map_frobenius_expand]

private lemma mem_frobenius_range_of_mem_expandMap_ranges
    {k σ τ T : Type*} [Field k] (p : ℕ) [Fact p.Prime] [CharP k p]
    (S : T → Subfield k) (hS : (frobenius k p).fieldRange = ⨅ t, S t)
    [Nonempty T] (f : MvPolynomial τ (MvPowerSeries σ k))
    (hf : ∀ t, f ∈ (expandMap p (Nat.Prime.ne_zero Fact.out) (S t).subtype).range) :
    ∃ g, g ^ p = f := by
  classical
  let hp := Nat.Prime.ne_zero (Fact.out : p.Prime)
  let H := expandMap (σ := σ) (τ := τ) p hp (RingHom.id k)
  have hH : Function.Injective H := expandMap_injective p hp _ Function.injective_id
  obtain ⟨t⟩ := ‹Nonempty T›
  obtain ⟨q, hq⟩ := hf t
  let g := MvPolynomial.map (MvPowerSeries.map (S t).subtype) q
  have hg : H g = f := by
    rw [expandMap_eq_comp_map, RingHom.comp_apply] at hq
    exact hq
  have hc : ∀ d e, MvPowerSeries.coeff e (g.coeff d) ∈
      (frobenius k p).fieldRange := by
    intro d e
    rw [hS]
    apply Subfield.mem_iInf.mpr
    intro t'
    obtain ⟨q', hq'⟩ := hf t'
    have heq : MvPolynomial.map (MvPowerSeries.map (S t').subtype) q' = g := by
      apply hH
      rw [expandMap_eq_comp_map, RingHom.comp_apply] at hq'
      exact hq'.trans hg.symm
    rw [← heq, MvPolynomial.coeff_map, MvPowerSeries.coeff_map]
    exact (MvPowerSeries.coeff e (q'.coeff d)).property
  obtain ⟨a, ha⟩ := (mem_range_mapMap_iff (frobenius k p) g).mpr hc
  refine ⟨a, ?_⟩
  rw [← expandMap_frobenius p a, expandMap_eq_comp_map, RingHom.comp_apply, ha]
  exact hg

/-- Let `x` be a p-basis of a field `k` of characteristic `p`. Inside
`A = k[[X₁, ..., Xₙ]][Y₁, ..., Yₘ]`, let `AJ` be obtained by taking coefficients in the
subfield generated by `k^p` and the `x i` for `i ∉ J`, and replacing every `X` and `Y` by
its p-th power. The fraction fields of the `AJ` form a downward-directed family whose
intersection is the p-th-power subfield and each `AJ ⊆ A` is finite. -/
@[stacks 07P5, ega "0 21.8.8" "∩K_J=K^p, A_J⊂A finite"]
public theorem fractionFields_powerSeries_polynomial_subrings
    {p : ℕ} [Fact p.Prime] {k : Type u} [Field k] [CharP k p]
    [Algebra (ZMod p) k] {I : Type v} (x : I → k)
    (hx : _root_.PBasis (ZMod p) x p) (n m : ℕ) :
    let kJ : Finset I → Subfield k := fun J =>
      (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J})
    let A := MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)
    letI : IsDomain A := NoZeroDivisors.to_isDomain A
    letI : CharP A p :=
      charP_of_injective_algebraMap (algebraMap k A).injective p
    let K := FractionRing A
    letI : CharP K p :=
      charP_of_injective_algebraMap (IsFractionRing.injective A K) p
    let toA : (J : Finset I) →
        MvPolynomial (Fin m) (MvPowerSeries (Fin n) ↥(kJ J)) →+* A := fun J =>
      MvPolynomial.eval₂Hom
        ((MvPolynomial.C : MvPowerSeries (Fin n) k →+* A).comp
          ((MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)).toRingHom.comp
            (MvPowerSeries.map (kJ J).subtype)))
        (fun i => MvPolynomial.X i ^ p)
    let AJ : Finset I → Subring A := fun J => RingHom.range (toA J)
    let KJ : Finset I → IntermediateField (ZMod p) K := fun J =>
      IntermediateField.adjoin (ZMod p) ((algebraMap A K) '' (AJ J : Set A))
    (∀ J, (frobenius K p).fieldRange ≤ (KJ J).toSubfield) ∧
      (frobenius K p).fieldRange = ⨅ J, (KJ J).toSubfield ∧
      (∀ J J', ∃ J'', KJ J'' ≤ KJ J ⊓ KJ J') ∧
      ∀ J, Module.Finite (AJ J) A := by
  classical
  dsimp only
  let kJ : Finset I → Subfield k := fun J =>
    (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J})
  let A := MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)
  let : IsDomain A := NoZeroDivisors.to_isDomain A
  let : CharP A p := charP_of_injective_algebraMap (algebraMap k A).injective p
  let K := FractionRing A
  let : CharP K p := charP_of_injective_algebraMap (IsFractionRing.injective A K) p
  let toA := fun J => expandMap (σ := Fin n) (τ := Fin m) p
    (Nat.Prime.ne_zero Fact.out) (kJ J).subtype
  let AJ := fun J => (toA J).range
  let KJ := fun J => IntermediateField.adjoin (ZMod p) ((algebraMap A K) '' (AJ J : Set A))
  change (∀ J, (frobenius K p).fieldRange ≤ (KJ J).toSubfield) ∧
    (frobenius K p).fieldRange = ⨅ J, (KJ J).toSubfield ∧
    (∀ J J', ∃ J'', KJ J'' ≤ KJ J ⊓ KJ J') ∧
    ∀ J, Module.Finite (AJ J) A
  have hpow : ∀ J (a : A), a ^ p ∈ AJ J := fun J a =>
    pow_mem_expand_map_range (kJ J) le_sup_left a
  have hKpow : ∀ J, (frobenius K p).fieldRange ≤ (KJ J).toSubfield := by
    intro J
    apply frobeniusFieldRange_le_of_pow_mem (A := A)
    intro a
    exact IntermediateField.subset_adjoin _ _ ⟨a ^ p, hpow J a, rfl⟩
  refine ⟨hKpow, le_antisymm (le_iInf hKpow) ?_, ?_, ?_⟩
  · intro z hz
    obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective A z
    have hb0 : b ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hb
    have hbK : algebraMap A K b ≠ 0 := by
      simpa only [map_zero] using (IsFractionRing.injective A K).ne hb0
    let c := a * b ^ (p - 1)
    have hcp : algebraMap A K c = z * (algebraMap A K b) ^ p := by
      rw [← hab]
      dsimp [c]
      rw [map_mul, map_pow]
      calc
        algebraMap A K a * algebraMap A K b ^ (p - 1) =
          (algebraMap A K a / algebraMap A K b) * algebraMap A K b ^ ((p - 1) + 1) := by
            rw [pow_succ, mul_comm (algebraMap A K b ^ (p - 1)) (algebraMap A K b),
              ← mul_assoc, div_mul_cancel₀ _ hbK]
        _ = _ := by rw [Nat.sub_add_cancel (Nat.Prime.one_le Fact.out)]
    have hc : ∀ J, c ∈ AJ J := by
      intro J
      let R := MvPolynomial (Fin m) (MvPowerSeries (Fin n) (kJ J))
      let : IsDomain (MvPowerSeries (Fin n) (kJ J)) := NoZeroDivisors.to_isDomain _
      let : IsIntegrallyClosed (MvPowerSeries (Fin n) (kJ J)) :=
        Stacks.FieldTheory.PBasisDifferentials.isIntegrallyClosed_mvPowerSeries (kJ J) n
      let : IsDomain R := NoZeroDivisors.to_isDomain _
      let : IsIntegrallyClosed R :=
        Stacks.FieldTheory.PBasisDifferentials.isIntegrallyClosed_mvPolynomial _ m
      have hcin : algebraMap A K c ∈ (KJ J).toSubfield := by
        rw [hcp]
        exact (KJ J).mul_mem ((Subfield.mem_iInf.mp hz) J) (hKpow J ⟨algebraMap A K b, rfl⟩)
      have hclos : algebraMap A K c ∈ Subfield.closure
          (Set.range ((algebraMap A K).comp (toA J))) := by
        rw [← adjoin_image_range_toSubfield (p := p) (toA J) (algebraMap A K)]
        exact hcin
      exact mem_range_of_pow_mem_of_mem_fractionField (toA J)
        (expandMap_injective _ _ _ (kJ J).subtype_injective)
        (Nat.Prime.pos Fact.out) (hpow J c) hclos
    obtain ⟨d, hd⟩ := mem_frobenius_range_of_mem_expandMap_ranges p kJ
      (frobeniusFieldRange_eq_iInf_pbasis_complement x hx) c hc
    refine ⟨algebraMap A K d / algebraMap A K b, ?_⟩
    change (algebraMap A K d / algebraMap A K b) ^ p = z
    rw [div_pow, ← map_pow, hd, hcp,
      mul_div_cancel_right₀ _ (pow_ne_zero p hbK)]
  · intro J J'
    refine ⟨J ∪ J', le_inf ?_ ?_⟩ <;> refine IntermediateField.adjoin_le_iff.mpr ?_ <;>
      rintro z ⟨a, ha, rfl⟩ <;> refine IntermediateField.subset_adjoin _ _ ⟨a, ?_, rfl⟩ <;>
      exact toA_range_antitone n m _ (fun h => fieldRange_mono_closure_compl x h) _
        (fun _ => rfl)
        (by first | exact Finset.subset_union_left | exact Finset.subset_union_right) ha
  · intro J
    have hfield : Module.Finite (kJ J) k := finite_field_of_pbasis_complement x hx J
    have hto : (toA J).Finite := expandMap_finite _ _ _ (RingHom.finite_algebraMap.mpr hfield)
    apply RingHom.finite_algebraMap.mp
    apply RingHom.Finite.of_comp_finite (f := (toA J).rangeRestrict)
    exact hto

end

