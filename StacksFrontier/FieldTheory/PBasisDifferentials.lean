private lemma fieldRange_mono_closure_compl
    {p : ℕ} [Fact p.Prime] {k : Type u} [Field k] [CharP k p]
    {I : Type v} (x : I → k) {J J' : Finset I} (h : J ⊆ J') :
    (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J'}) ≤
      (frobenius k p).fieldRange ⊔ Subfield.closure (x '' {i | i ∉ J}) := by
  gcongr

private lemma toA_range_antitone
    {p : ℕ} [Fact p.Prime] {k : Type u} [Field k] [CharP k p]
    {I : Type v} (n m : ℕ)
    (kJ : Finset I → Subfield k) (hkJ : ∀ {J J'}, J ⊆ J' → kJ J' ≤ kJ J)
    (toA : (J : Finset I) →
      MvPolynomial (Fin m) (MvPowerSeries (Fin n) ↥(kJ J)) →+*
        MvPolynomial (Fin m) (MvPowerSeries (Fin n) k))
    (htoA : ∀ J, toA J =
      MvPolynomial.eval₂Hom
        ((MvPolynomial.C : MvPowerSeries (Fin n) k →+*
            MvPolynomial (Fin m) (MvPowerSeries (Fin n) k)).comp
          ((MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)).toRingHom.comp
            (MvPowerSeries.map (kJ J).subtype)))
        (fun i => MvPolynomial.X i ^ p))
    {J J' : Finset I} (h : J ⊆ J') : RingHom.range (toA J') ≤ RingHom.range (toA J) := by
  classical
  rintro _ ⟨f, rfl⟩
  let inc : kJ J' →+* kJ J := Subfield.inclusion (hkJ h)
  refine ⟨MvPolynomial.map (MvPowerSeries.map inc) f, ?_⟩
  rw [htoA J', htoA J]
  rw [MvPolynomial.eval₂Hom_map_hom]
  congr 1

private lemma pow_mem_expand_map_range
    {p : ℕ} [Fact p.Prime] {k : Type*} [Field k] [CharP k p]
    {σ τ : Type*} (S : Subfield k) (hS : (frobenius k p).fieldRange ≤ S)
    (f : MvPolynomial τ (MvPowerSeries σ k)) :
    f ^ p ∈ RingHom.range (MvPolynomial.eval₂Hom
      ((MvPolynomial.C : MvPowerSeries σ k →+* MvPolynomial τ (MvPowerSeries σ k)).comp
        ((MvPowerSeries.expand p (Nat.Prime.ne_zero Fact.out)).toRingHom.comp
          (MvPowerSeries.map S.subtype)))
      (fun i => MvPolynomial.X i ^ p)) := by
  let : CharP (MvPolynomial τ (MvPowerSeries σ k)) p :=
    charP_of_injective_algebraMap (algebraMap k _).injective p
  let φ : k →+* S := (frobenius k p).codRestrict S (fun a => hS ⟨a, rfl⟩)
  let ψ := MvPowerSeries.map φ (σ := σ)
  refine ⟨MvPolynomial.map ψ f, ?_⟩
  induction f using MvPolynomial.induction_on with
  | C c =>
    simp only [MvPolynomial.map_C, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
      AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom]
    rw [← MvPolynomial.C_pow]
    congr 1
    have hφ : S.subtype.comp φ = frobenius k p := rfl
    change MvPowerSeries.expand p _ (MvPowerSeries.map S.subtype
      (MvPowerSeries.map φ c)) = _
    rw [MvPowerSeries.map_map, hφ, ← MvPowerSeries.map_expand,
      MvPowerSeries.map_frobenius_expand]
  | add a b ha hb => simpa only [map_add, add_pow_char] using congrArg₂ (· + ·) ha hb
  | mul_X a i ha =>
    simp only [map_mul, MvPolynomial.map_X, MvPolynomial.eval₂Hom_X', ha, mul_pow]

private lemma frobeniusFieldRange_le_of_pow_mem
    {p : ℕ} [Fact p.Prime] {A K : Type*} [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharP K p]
    (S : Subfield K) (hS : ∀ a : A, algebraMap A K (a ^ p) ∈ S) :
    (frobenius K p).fieldRange ≤ S := by
  rintro _ ⟨z, rfl⟩
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := A) z
  simpa only [frobenius_def, div_pow, ← map_pow] using S.div_mem (hS a) (hS b)

/-- A ring homomorphism is finite when its target is a finite module over its range. -/
private lemma ringHom_finite_of_finite_range {R S : Type*} [CommRing R] [CommRing S]
    (h : R →+* S) (hfin : Module.Finite h.range S) : h.Finite := by
  have hh : h.range.subtype.comp h.rangeRestrict = h := rfl
  rw [← hh]
  exact (RingHom.finite_algebraMap.mpr hfin).comp
    (RingHom.Finite.of_surjective _ h.rangeRestrict_surjective)

private lemma mvPowerSeries_map_finite
    {R S σ : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : f.Finite) : (MvPowerSeries.map (σ := σ) f).Finite := by
  classical
  let : Algebra R S := f.toAlgebra
  have : Module.Finite R S := hf
  let h := MvPowerSeries.map (σ := σ) f
  have hfin : Module.Finite h.range (MvPowerSeries σ S) := by
    obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := S)
    refine Module.finite_def.mpr (Submodule.fg_def.mpr
      ⟨Set.range fun i => (MvPowerSeries.C (s i) : MvPowerSeries σ S),
        Set.finite_range _, eq_top_iff.mpr fun g _ => ?_⟩)
    have hcoeff : ∀ d : σ →₀ ℕ, ∃ c : Fin n → R, ∑ i, c i • s i = MvPowerSeries.coeff d g :=
      fun d => (Submodule.mem_span_range_iff_exists_fun R).mp (by rw [hs]; trivial)
    choose c hc using hcoeff
    let cs : Fin n → MvPowerSeries σ R := fun i d => c d i
    let ds : Fin n → h.range := fun i => ⟨h (cs i), ⟨cs i, rfl⟩⟩
    have hg : g = ∑ i, ds i • (MvPowerSeries.C (s i) : MvPowerSeries σ S) := by
      ext d
      rw [map_sum, ← hc d]
      apply Finset.sum_congr rfl
      intro i _
      change f (c d i) * s i = MvPowerSeries.coeff d
        (MvPowerSeries.map f (cs i) * MvPowerSeries.C (s i))
      rw [MvPowerSeries.coeff_mul_C, MvPowerSeries.coeff_map]
      rfl
    rw [hg]
    exact Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  exact ringHom_finite_of_finite_range h hfin

private lemma mvPowerSeries_expand_finite
    {R σ : Type*} [CommRing R] [Finite σ] (p : ℕ) (hp : p ≠ 0) :
    (MvPowerSeries.expand (σ := σ) (R := R) p hp).toRingHom.Finite := by
  classical
  let := Fintype.ofFinite σ
  let e : (σ → Fin p) → σ →₀ ℕ := fun r => Finsupp.equivFunOnFinite.symm fun i => (r i).val
  let h := (MvPowerSeries.expand (σ := σ) (R := R) p hp).toRingHom
  have hfin : Module.Finite h.range (MvPowerSeries σ R) := by
    refine Module.finite_def.mpr (Submodule.fg_def.mpr
      ⟨Set.range fun r => (MvPowerSeries.monomial (e r) 1 : MvPowerSeries σ R),
        Set.finite_range _, eq_top_iff.mpr fun f _ => ?_⟩)
    let g : (σ → Fin p) → MvPowerSeries σ R := fun r =>
      fun d => MvPowerSeries.coeff (p • d + e r) f
    let c : (σ → Fin p) → h.range := fun r => ⟨h (g r), ⟨g r, rfl⟩⟩
    have hf : f = ∑ r, c r • (MvPowerSeries.monomial (e r) 1 : MvPowerSeries σ R) := by
      ext d
      let r : σ → Fin p := fun i => ⟨d i % p, Nat.mod_lt _ (Nat.pos_of_ne_zero hp)⟩
      let q : σ →₀ ℕ := d.mapRange (· / p) (Nat.zero_div p)
      have hde : p • q + e r = d := by
        ext i
        simp only [Finsupp.add_apply, Finsupp.smul_apply, Finsupp.mapRange_apply,
          smul_eq_mul, e, Finsupp.coe_equivFunOnFinite_symm, r, q]
        exact Nat.div_add_mod _ _
      rw [map_sum, Finset.sum_eq_single r]
      · change MvPowerSeries.coeff d f = MvPowerSeries.coeff d
          (MvPowerSeries.expand p hp (g r) * MvPowerSeries.monomial (e r) 1)
        rw [← hde, MvPowerSeries.coeff_add_mul_monomial,
          MvPowerSeries.coeff_expand_smul, mul_one]
        rfl
      · intro s _ hsr
        change MvPowerSeries.coeff d
          (MvPowerSeries.expand p hp (g s) * MvPowerSeries.monomial (e s) 1) = 0
        rw [MvPowerSeries.coeff_mul_monomial]
        split_ifs with hsd
        · have hex : ∃ i, ¬p ∣ (d - e s) i := by
            by_contra! hh
            apply hsr
            funext i
            apply Fin.ext
            have hle : (s i).val ≤ d i := hsd i
            have hdvd : p ∣ d i - (s i).val := hh i
            have hslt := (s i).isLt
            dsimp [r]
            rw [← Nat.sub_add_cancel hle, Nat.add_mod,
              Nat.mod_eq_zero_of_dvd hdvd, zero_add, Nat.mod_eq_of_lt hslt,
              Nat.mod_eq_of_lt hslt]
          obtain ⟨i, hi⟩ := hex
          rw [MvPowerSeries.coeff_expand_of_not_dvd p hp _ hi, zero_mul]
        · rfl
      · simp
    rw [hf]
    exact Submodule.sum_mem _ fun r _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨r, rfl⟩)
  exact ringHom_finite_of_finite_range h hfin

private lemma mvPolynomial_map_finite
    {R S σ : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (hf : f.Finite) : (MvPolynomial.map (σ := σ) f).Finite := by
  classical
  let : Algebra R S := f.toAlgebra
  have : Module.Finite R S := hf
  let h := MvPolynomial.map (σ := σ) f
  let : Algebra (MvPolynomial σ R) (MvPolynomial σ S) := h.toAlgebra
  change Module.Finite (MvPolynomial σ R) (MvPolynomial σ S)
  obtain ⟨G, hG⟩ := Module.finite_def.mp ‹Module.Finite R S›
  let M := Submodule.span (MvPolynomial σ R)
    ((MvPolynomial.C : S → MvPolynomial σ S) '' (G : Set S))
  have hC : ∀ a : S, MvPolynomial.C a ∈ M := by
    intro a
    have ha : a ∈ Submodule.span R (G : Set S) := by rw [hG]; trivial
    induction ha using Submodule.span_induction with
    | mem a ha => exact Submodule.subset_span ⟨a, ha, rfl⟩
    | zero => simp only [map_zero, Submodule.zero_mem]
    | add a b _ _ ha hb => simpa using M.add_mem ha hb
    | smul r a _ ha =>
      have h := M.smul_mem (MvPolynomial.C r) ha
      change MvPolynomial.map f (MvPolynomial.C r) * MvPolynomial.C a ∈ M at h
      simpa only [MvPolynomial.map_C, ← map_mul, Algebra.smul_def,
        RingHom.algebraMap_toAlgebra] using h
  have htop : M = ⊤ := by
    apply top_unique
    intro f hf
    clear hf
    induction f using MvPolynomial.induction_on with
    | C a => exact hC a
    | add a b ha hb => exact M.add_mem ha hb
    | mul_X a i ha =>
      have h := M.smul_mem (MvPolynomial.X i) ha
      change MvPolynomial.map f (MvPolynomial.X i) * a ∈ M at h
      simpa only [MvPolynomial.map_X, mul_comm] using h
  exact Module.finite_def.mpr (Submodule.fg_def.mpr ⟨_, G.finite_toSet.image _, htop⟩)

private lemma mvPolynomial_expand_finite
    {R σ : Type*} [CommRing R] [Finite σ] (p : ℕ) (hp : p ≠ 0) :
    (MvPolynomial.expand (σ := σ) (R := R) p).toRingHom.Finite := by
