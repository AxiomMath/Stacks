/-- Frobenius carries a finite field extension to a finite extension of its field range. -/
private theorem finiteDimensional_frobeniusFieldRange
    {p : ℕ} [Fact p.Prime] {K : Type u} [Field K] [CharP K p]
    {L : Type w} [Field L] [Algebra K L] [FiniteDimensional K L] [CharP L p]
    (hr : ∀ x : ↥((frobenius K p).fieldRange),
      algebraMap ↥((frobenius K p).fieldRange) L x ∈ (frobenius L p).fieldRange) :
    FiniteDimensional ↥((frobenius K p).fieldRange)
      ((frobenius L p).fieldRange.toIntermediateField hr) := by
  let F : Type u := ↥((frobenius K p).fieldRange)
  let S := (frobenius L p).fieldRange
  let E := S.toIntermediateField hr
  let σ : K →+* F := (frobenius K p).codRestrict _ (fun a => ⟨a, rfl⟩)
  let f : L →ₛₗ[σ] E :=
    { toFun := fun a => ⟨(frobenius L p) a, ⟨a, rfl⟩⟩
      map_add' := fun a b => Subtype.ext (map_add _ a b)
      map_smul' := by
        intro a b
        apply Subtype.ext
        simp only [Algebra.smul_def]
        change (frobenius L p) (algebraMap K L a * b) =
          ((algebraMap F E (σ a) : E) : L) * (frobenius L p) b
        rw [map_mul]
        congr 1
        rw [IntermediateField.coe_algebraMap_apply E,
          IsScalarTower.algebraMap_eq F K L]
        simp only [frobenius_def, ← map_pow, RingHom.coe_comp, Function.comp_apply,
          algebraMap.coe_inj, σ]
        exact frobenius_def p a |>.symm }
  have hf : Function.Surjective f := by
    intro a
    obtain ⟨b, hb⟩ := a.2
    exact ⟨b, Subtype.ext hb⟩
  exact Module.Finite.of_surjective f hf

/-- The Frobenius field range commutes with a directed intersection after a finite extension. -/
private theorem frobenius_fieldRange_iInf_of_nonempty
    {p : ℕ} [Fact p.Prime] {K : Type u} [Field K] [CharP K p] [Algebra (ZMod p) K]
    {A : Type v} [Nonempty A] (Kα : A → IntermediateField (ZMod p) K)
    (hpow : ∀ α, (frobenius K p).fieldRange ≤ (Kα α).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ α, (Kα α).toSubfield)
    (hdir : ∀ α α', ∃ α'', Kα α'' ≤ Kα α ⊓ Kα α') :
    ∀ (L : Type w) [Field L] [Algebra K L] [FiniteDimensional K L],
      letI : CharP L p :=
        charP_of_injective_algebraMap (algebraMap K L).injective p
      (frobenius L p).fieldRange =
        ⨅ α, (frobenius L p).fieldRange ⊔ (Kα α).toSubfield.map (algebraMap K L) := by
  intro L _ _ _
  let : CharP L p :=
    charP_of_injective_algebraMap (algebraMap K L).injective p
  let F : Type u := ↥((frobenius K p).fieldRange)
  obtain ⟨G, hGeq, hinfG, hdirG⟩ := exists_intermediateField_frobenius_bot Kα hpow hiInf hdir
  let : Algebra F L := inferInstance
  let S := (frobenius L p).fieldRange
  have hr : ∀ x : F, algebraMap F L x ∈ S := by
    intro x
    obtain ⟨a, ha⟩ : (x : K) ∈ (frobenius K p).fieldRange := x.2
    have h : algebraMap F L x = (algebraMap K L a) ^ p := by
      have hx : (x : K) = a ^ p := by simpa [frobenius_def] using ha.symm
      rw [← map_pow, ← hx]
      rfl
    rw [h]
    exact ⟨algebraMap K L a, by simp [frobenius_def]⟩
  let E := S.toIntermediateField hr
  let : FiniteDimensional F E := finiteDimensional_frobeniusFieldRange hr
  have hres := finite_compositum_intersection G hinfG hdirG E
  simpa only [E, S, hGeq, Subfield.toIntermediateField_toSubfield] using hres

/-- If every element is a `p`-th power, the Kähler differential module vanishes. -/
private theorem kaehlerDifferential_eq_zero_of_frobeniusFieldRange_eq_top
    {p : ℕ} [Fact p.Prime] {K : Type u} [Field K] [CharP K p]
    [Algebra (ZMod p) K] (htop : (frobenius K p).fieldRange = ⊤) :
    (⊤ : Submodule K (KaehlerDifferential (ZMod p) K)) = ⊥ := by
  have hD : ∀ x : K, (KaehlerDifferential.D (ZMod p) K) x = 0 := by
    intro x
    obtain ⟨y, hy⟩ := (RingHom.mem_fieldRange.mp (htop.symm ▸ Subfield.mem_top x))
    have hx : x = y ^ p := by simpa [frobenius_def] using hy.symm
    subst x
    apply _root_.derivation_eq_zero_of_mem_compositumFrobenius
    rw [compositumFrobenius_zmod]
    exact ⟨y, rfl⟩
  apply le_antisymm _ bot_le
  rw [← KaehlerDifferential.span_range_derivation]
  apply Submodule.span_le.mpr
  rintro z ⟨x, rfl⟩
  simp [hD x]

/-- Let `Kα` be a downward-directed family of subfields of a field `K` of characteristic
`p`, each containing the `p`-th powers, and suppose their intersection is exactly the subfield
of `p`-th powers. Then the kernels of the canonical maps from `Ω[K/(ZMod p)]` to
`Ω[K/(Kα α)]` have trivial intersection. Moreover, after any finite extension `L / K`,
the intersection of the composita `L^p Kα` is `L^p`. -/
@[stacks 07P4, ega "0 21.8.5" "k₀=K^p, L/K finite", ega "0 21.8.3" "a) => c), k₀=F_p"]
public theorem iInf_ker_kaehlerDifferentialMap_eq_bot_and_frobeniusFieldRange_eq_iInf
    {p : ℕ} [Fact p.Prime] {K : Type u} [Field K] [CharP K p] [Algebra (ZMod p) K]
    {A : Type v} (Kα : A → IntermediateField (ZMod p) K)
    (hpow : ∀ α, (frobenius K p).fieldRange ≤ (Kα α).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ α, (Kα α).toSubfield)
    (hdir : ∀ α α', ∃ α'', Kα α'' ≤ Kα α ⊓ Kα α') :
    (⨅ α, LinearMap.ker (KaehlerDifferential.map (ZMod p) (Kα α) K K)) = ⊥ ∧
      ∀ (L : Type w) [Field L] [Algebra K L] [FiniteDimensional K L],
        letI : CharP L p :=
          charP_of_injective_algebraMap (algebraMap K L).injective p
        (frobenius L p).fieldRange =
          ⨅ α, (frobenius L p).fieldRange ⊔ (Kα α).toSubfield.map (algebraMap K L) := by
  classical
  by_cases hne : Nonempty A
  · let : Nonempty A := hne
    exact ⟨differential_intersection Kα hpow hiInf hdir,
      frobenius_fieldRange_iInf_of_nonempty Kα hpow hiInf hdir⟩
  · let : IsEmpty A := not_nonempty_iff.mp hne
    have htop : (frobenius K p).fieldRange = ⊤ := by
      simpa using hiInf
    have : PerfectRing K p := PerfectRing.ofSurjective K p
      (RingHom.fieldRange_eq_top_iff.mp htop)
    have : PerfectField K := PerfectRing.toPerfectField K p
    refine ⟨by simpa using kaehlerDifferential_eq_zero_of_frobeniusFieldRange_eq_top htop,
      fun L _ _ _ => ?_⟩
    let : CharP L p := charP_of_injective_algebraMap (algebraMap K L).injective p
    let : PerfectField L := Algebra.IsAlgebraic.perfectField K
    simpa using RingHom.fieldRange_eq_top_iff.mpr (surjective_frobenius L p)

end

