private lemma compositumFrobenius_zmod
    {p : ℕ} [Fact p.Prime] {k : Type*} [Field k] [CharP k p] [Algebra (ZMod p) k] :
    compositumFrobenius (ZMod p) k p = (frobenius k p).fieldRange := by
  apply le_antisymm
  · apply Subfield.closure_le.mpr
    rintro a (⟨b, rfl⟩ | ⟨b, rfl⟩)
    · refine ⟨algebraMap (ZMod p) k b, ?_⟩
      simp only [frobenius_def, ← map_pow, ZMod.pow_card]
    · exact ⟨b, rfl⟩
  · rintro a ⟨b, rfl⟩
    exact Subfield.subset_closure (Or.inr ⟨b, rfl⟩)

private theorem compositumFrobenius_eq_intermediateField
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [CharP K p]
    [Algebra (ZMod p) K] (S : IntermediateField (ZMod p) K)
    (hpow : (frobenius K p).fieldRange ≤ S.toSubfield) :
    _root_.compositumFrobenius (↥S) K p = S.toSubfield := by
  apply le_antisymm
  · change Subfield.closure
      (((algebraMap (↥S) K).range : Set K) ∪ {a : K | ∃ b : K, a = b ^ p}) ≤ _
    apply Subfield.closure_le.mpr
    rintro z (⟨s, rfl⟩ | ⟨b, rfl⟩)
    · exact s.2
    · exact hpow ⟨b, by simp [frobenius_def]⟩
  · exact fun z hz => Subfield.subset_closure (Or.inl ⟨⟨z, hz⟩, rfl⟩)

/-- A linear combination that is independent over a larger subfield has no nonzero
coefficients over a smaller subfield. -/
private theorem coefficients_eq_zero_of_linearIndependent
    {K : Type*} [Field K] {S T : Subfield K} (hST : S ≤ T)
    {n : ℕ} (m : Fin n → K) (hli : LinearIndependent T m)
    (c : Fin n → S)
    (hc : ∑ j : Fin n, algebraMap S K (c j) * m j = 0) : c = 0 := by
  have hsum : ∑ j : Fin n,
      ((⟨algebraMap S K (c j), hST (c j).2⟩ : T) : K) • m j = 0 := by
    simpa using hc
  have hzero : ∀ j, (⟨algebraMap S K (c j), hST (c j).2⟩ : T) = 0 :=
    (Fintype.linearIndependent_iff.mp hli) _ hsum
  funext j
  apply (algebraMap S K).injective
  simpa using congrArg Subtype.val (hzero j)

/-- The basis of differentials associated to a `p`-basis. -/
private noncomputable def differentialBasis
    {p : ℕ} [Fact p.Prime] {k K : Type*} [Field k] [Field K] [Algebra k K]
    [CharP K p] {I : Type*} (x : I → K) (hx : _root_.PBasis k x p) :
    Module.Basis I K (KaehlerDifferential k K) :=
  let h := _root_.pBasis_differentials_basis x p hx
  Module.Basis.mk h.1 h.2

private theorem differentialBasis_apply
    {p : ℕ} [Fact p.Prime] {k K : Type*} [Field k] [Field K] [Algebra k K]
    [CharP K p] {I : Type*} (x : I → K) (hx : _root_.PBasis k x p) (i : I) :
    differentialBasis x hx i = KaehlerDifferential.D k K (x i) := by
  unfold differentialBasis
  exact Module.Basis.mk_apply _ _ _

/-- Over the `p`-th powers, a directed family of subfields containing them with intersection the
`p`-th powers becomes a directed family of intermediate fields with trivial intersection. -/
private theorem exists_intermediateField_frobenius_bot
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [CharP K p] [Algebra (ZMod p) K]
    {A : Type*} (Kα : A → IntermediateField (ZMod p) K)
    (hpow : ∀ a, (frobenius K p).fieldRange ≤ (Kα a).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ a, (Kα a).toSubfield)
    (hdir : ∀ a b, ∃ c, Kα c ≤ Kα a ⊓ Kα b) :
    ∃ G : A → IntermediateField ↥((frobenius K p).fieldRange) K,
      (∀ a, (G a).toSubfield = (Kα a).toSubfield) ∧ (⨅ a, G a) = ⊥ ∧
        ∀ a b, ∃ c, G c ≤ G a ⊓ G b := by
  refine ⟨fun a => (Kα a).toSubfield.toIntermediateField (fun x => hpow a x.2),
    fun a => rfl, ?_, fun a b => ?_⟩
  · apply IntermediateField.toSubfield_injective
    rw [IntermediateField.iInf_toSubfield, IntermediateField.bot_toSubfield]
    simp only [Subfield.toIntermediateField_toSubfield]
    refine hiInf.symm.trans ?_
    ext z
    constructor
    · intro hz
      exact ⟨⟨z, hz⟩, rfl⟩
    · rintro ⟨x, rfl⟩
      exact x.2
  · obtain ⟨c, hc⟩ := hdir a b
    exact ⟨c, fun z hz => ⟨(hc hz).1, (hc hz).2⟩⟩

/-- Extend a bounded exponent along an embedding of index types by zero. -/
private noncomputable def embDomainExp {I J : Type*} {p : ℕ} (hp : 0 < p) (emb : I ↪ J)
    (e : _root_.BoundedExp I p) : _root_.BoundedExp J p :=
  ⟨Finsupp.embDomain emb e.1, fun j => by
    rw [Finsupp.embDomain_apply]
    split
    · exact e.2 _
    · exact hp⟩

private theorem embDomainExp_injective {I J : Type*} {p : ℕ} (hp : 0 < p) (emb : I ↪ J) :
    Function.Injective (embDomainExp hp emb) := fun _ _ he =>
  Subtype.ext (Finsupp.embDomain_injective emb (congrArg Subtype.val he))

private theorem monomialFamily_embDomainExp {I J M : Type*} [CommMonoid M] {p : ℕ}
    (x : J → M) (hp : 0 < p) (emb : I ↪ J) (e : _root_.BoundedExp I p) :
    _root_.monomialFamily x p (embDomainExp hp emb e) =
      _root_.monomialFamily (fun i => x (emb i)) p e := by
  simp [_root_.monomialFamily, _root_.monomialPow, embDomainExp, Finsupp.prod_embDomain]

private theorem differential_intersection
    {p : ℕ} [hp : Fact p.Prime] {K : Type*} [Field K] [CharP K p]
    [Algebra (ZMod p) K] {A : Type*} [Nonempty A]
    (Kα : A → IntermediateField (ZMod p) K)
    (hpow : ∀ a, (frobenius K p).fieldRange ≤ (Kα a).toSubfield)
    (hiInf : (frobenius K p).fieldRange = ⨅ a, (Kα a).toSubfield)
    (hdir : ∀ a b, ∃ c, Kα c ≤ Kα a ⊓ Kα b) :
    (⨅ a, LinearMap.ker (KaehlerDifferential.map (ZMod p) (Kα a) K K)) = ⊥ := by
  classical
  let F : Type _ := ↥((frobenius K p).fieldRange)
  let : Field F := inferInstance
  let : Algebra F K := inferInstance
  obtain ⟨G, hGeq, hinfG, hdirG⟩ := exists_intermediateField_frobenius_bot Kα hpow hiInf hdir
  obtain ⟨S, hPB⟩ := _root_.exists_pBasis (k := ZMod p) (K := K) p
  let x : S → K := fun i => i.1
  let d : S → KaehlerDifferential (ZMod p) K :=
    fun i => KaehlerDifferential.D (ZMod p) K (x i)
  let b : Module.Basis S K (KaehlerDifferential (ZMod p) K) := differentialBasis x hPB
  apply le_antisymm
  · intro η hη
    by_contra hηne
    let coeff : S →₀ K := b.repr η
    have hcoeffne : coeff ≠ 0 := by
      intro hzero
      have heta0 : η = 0 := b.repr.injective (by simpa [coeff] using hzero)
      exact hηne (by simp [heta0])
    let I : Type _ := ↥(coeff.support : Set S)
    let : Fintype I := Finset.fintypeCoeSort coeff.support
    let xI : I → K := fun i => x i.1
    have hrepr : Finsupp.linearCombination K d coeff = η := by
      have hd : d = b := by
        funext i
        exact (differentialBasis_apply x hPB i).symm
      rw [hd]
      exact b.linearCombination_repr η
    let emb : I ↪ S := ⟨Subtype.val, Subtype.val_injective⟩
    have hmonoI : LinearIndependent (_root_.compositumFrobenius (ZMod p) K p)
        (_root_.monomialFamily xI p) := by
      rw [show _root_.monomialFamily xI p =
          _root_.monomialFamily x p ∘ embDomainExp hp.out.pos emb from
        funext fun e => (monomialFamily_embDomainExp x hp.out.pos emb e).symm]
      exact hPB.1.comp _ (embDomainExp_injective hp.out.pos emb)
    have hFle : (frobenius K p).fieldRange ≤ _root_.compositumFrobenius (ZMod p) K p :=
      compositumFrobenius_zmod.ge
    let E := _root_.BoundedExp I p
    let expAsFun : E → (I → Fin p) := fun e i => ⟨e.1 i, e.2 i⟩
    have hexpAsFun : Function.Injective expAsFun := by
      intro e e' he
      apply Subtype.ext
      ext i
      exact congrArg Fin.val (congrFun he i)
    let : Finite E := Finite.of_injective expAsFun hexpAsFun
    let : Fintype E := Fintype.ofFinite E
    let n := Fintype.card E
    let e : Fin n ≃ _root_.BoundedExp I p := (Fintype.equivFin _).symm
    let m : Fin n → K := fun j => _root_.monomialFamily xI p (e j)
    let φ : (Fin n → K) →ₗ[K] K :=
      ∑ j : Fin n, (LinearMap.proj j).smulRight (m j)
    have hker : ∀ c : Fin n → F, φ (fun j => algebraMap F K (c j)) = 0 → c = 0 := by
      intro c hc
      have hli : LinearIndependent (_root_.compositumFrobenius (ZMod p) K p) m :=
        hmonoI.comp e (fun _ _ h => e.injective h)
      apply coefficients_eq_zero_of_linearIndependent hFle m hli c
      simpa [φ, LinearMap.sum_apply, LinearMap.smulRight_apply,
        LinearMap.proj_apply] using hc
    have hmeet : ∀ a, _root_.NonzeroSubset
        ((LinearMap.ker φ : Set (Fin n → K)) ∩
          _root_.coordSubset n (G a)) := by
      intro a
      have hdepDiff : ¬ LinearIndependent K
          (fun i : I => KaehlerDifferential.D (Kα a) K (xI i)) := by
        intro hli
        have hmap : KaehlerDifferential.map (ZMod p) (Kα a) K K η = 0 := by
          exact LinearMap.mem_ker.mp ((Submodule.mem_iInf _).mp hη a)
        have hcombMap : Finsupp.linearCombination K
            (fun i : S => KaehlerDifferential.D (Kα a) K (x i)) coeff = 0 := by
          have hh := congrArg (KaehlerDifferential.map (ZMod p) (Kα a) K K) hrepr
          rw [hmap] at hh
          simpa [d, x, Finsupp.linearCombination_apply, Finsupp.sum,
            KaehlerDifferential.map_D] using hh
        have hsumI : (∑ i : I, coeff i.1 •
            KaehlerDifferential.D (Kα a) K (xI i)) = 0 := by
          have hs : (∑ i ∈ coeff.support, coeff i •
              KaehlerDifferential.D (Kα a) K (x i)) = 0 := by
            simpa [Finsupp.linearCombination_apply, Finsupp.sum] using hcombMap
          change (∑ i : I, coeff i.1 •
            KaehlerDifferential.D (Kα a) K (x i.1)) = 0
          exact (Finset.sum_coe_sort coeff.support
            (fun i => coeff i • KaehlerDifferential.D (Kα a) K (x i))).trans hs
        have hz : ∀ i : I, coeff i.1 = 0 :=
          (Fintype.linearIndependent_iff.mp hli) (fun i => coeff i.1) hsumI
        apply hcoeffne
        ext i
        by_cases hi : i ∈ coeff.support
        · exact hz ⟨i, hi⟩
        · exact Finsupp.notMem_support_iff.mp hi
      have hpdep : ¬ _root_.PIndependent (↥(Kα a)) xI p := fun h =>
        hdepDiff ((_root_.pIndependent_iff_linearIndependent_differentials
          (k := ↥(Kα a)) (K := K) xI p).mp h)
      have hcomp := compositumFrobenius_eq_intermediateField (Kα a) (hpow a)
      have hnotli : ¬ LinearIndependent (_root_.compositumFrobenius (↥(Kα a)) K p)
          (_root_.monomialFamily xI p) := by
        simpa [_root_.PIndependent, hcomp] using hpdep
      obtain ⟨g, hsum, j₀, hj₀⟩ := Fintype.not_linearIndependent_iff.mp hnotli
      refine ⟨fun j => (g (e j) : K), ⟨LinearMap.mem_ker.mpr ?_, ?_⟩,
        fun hz => hj₀ (Subtype.ext ?_)⟩
      · simp only [φ, LinearMap.sum_apply, LinearMap.smulRight_apply,
          LinearMap.proj_apply]
        change (∑ j : Fin n, (g (e j) : K) *
          _root_.monomialFamily xI p (e j)) = 0
        change (∑ i : E, (g i : K) • _root_.monomialFamily xI p i) = 0 at hsum
        exact (Equiv.sum_comp e _).trans hsum
      · intro j
        change (g (e j) : K) ∈ (G a).toSubfield
        rw [hGeq, ← hcomp]
        exact (g (e j)).2
      · rw [← e.apply_symm_apply j₀]
        exact congrFun hz (e.symm j₀)
    obtain ⟨q, ⟨hqker, hqcoord⟩, hqne⟩ := (_root_.intersection_subfields_07P3 G hinfG hdirG n
      (LinearMap.ker φ)).mpr hmeet
    choose cF hcF using fun j => IntermediateField.mem_bot.mp (hqcoord j)
    have hcFzero := hker cF (by rw [funext hcF]; exact LinearMap.mem_ker.mp hqker)
    apply hqne
    funext j
    rw [← hcF j, hcFzero]
    simp
  · exact bot_le

private def snocFin {K : Type*} [Field K] {n : ℕ} (c : Fin n → K) (t : K) :
    Fin (n + 1) → K := fun i => Fin.lastCases t c i

private theorem affine_solution_over_intersection
    {F K A W : Type*} [Field F] [Field K] [Algebra F K] [Nonempty A]
    (G : A → IntermediateField F K)
    (hinf : ⨅ a, G a = ⊥)
    (hdir : ∀ a b, ∃ c, G c ≤ G a ⊓ G b)
    {n : ℕ} [AddCommGroup W] [Module K W]
    (φ : (Fin n → K) →ₗ[K] W)
    (hker : ∀ c : Fin n → F,
      φ (fun i => algebraMap F K (c i)) = 0 → c = 0)
    (y : W)
    (hsol : ∀ a, ∃ c : Fin n → G a,
      φ (fun i => algebraMap (G a) K (c i)) = y) :
    ∃ c : Fin n → F, φ (fun i => algebraMap F K (c i)) = y := by
  classical
  let proj : (Fin (n + 1) → K) →ₗ[K] (Fin n → K) :=
    LinearMap.funLeft K K Fin.castSucc
  let ψ : (Fin (n + 1) → K) →ₗ[K] W :=
    φ.comp proj - (LinearMap.proj (Fin.last n)).smulRight y
  let V : Submodule K (Fin (n + 1) → K) := LinearMap.ker ψ
  have hmeet : ∀ a, _root_.NonzeroSubset
      ((V : Set (Fin (n + 1) → K)) ∩
        _root_.coordSubset (n + 1) (G a)) := by
    intro a
    obtain ⟨c, hc⟩ := hsol a
    refine ⟨snocFin (fun i => algebraMap (G a) K (c i)) 1, ?_, ?_⟩
    · constructor
      · change ψ (snocFin (fun i => algebraMap (G a) K (c i)) 1) = 0
        have hproj :
            proj (snocFin (fun i => algebraMap (G a) K (c i)) 1) =
              fun i => algebraMap (G a) K (c i) := by
          funext i
          simp [proj, snocFin]
        simp only [ψ, LinearMap.sub_apply, LinearMap.comp_apply,
          LinearMap.smulRight_apply, LinearMap.proj_apply]
        rw [hproj, hc]
        simp [snocFin]
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · simp [snocFin]
        · intro j
          simp [snocFin]
    · intro hzero
      have hlast := congrFun hzero (Fin.last n)
      simp [snocFin] at hlast
  obtain ⟨q, hqmem, hqne⟩ :=
    (_root_.intersection_subfields_07P3 G hinf hdir
      (n + 1) V).mpr hmeet
  rcases hqmem with ⟨hqV, hqcoord⟩
  have hψq : ψ q = 0 := hqV
  let qfirst : Fin n → K := fun i => q i.castSucc
  let qlast : K := q (Fin.last n)
  have hφq : φ qfirst = qlast • y := by
    change φ qfirst - qlast • y = 0 at hψq
    exact sub_eq_zero.mp hψq
  choose cF hcF using fun i => IntermediateField.mem_bot.mp (hqcoord i)
  let cfirst : Fin n → F := fun i => cF i.castSucc
  have hlast_ne : qlast ≠ 0 := by
    intro hlast0
    have hfirst0 : φ (fun i => algebraMap F K (cfirst i)) = 0 := by
      have hqfirst : (fun i => algebraMap F K (cfirst i)) = qfirst := by
        funext i
        exact hcF i.castSucc
      rw [hqfirst]
      simpa [qlast, hlast0] using hφq
    have hcfirst0 := hker cfirst hfirst0
    apply hqne
    funext i
    by_cases hi : i = Fin.last n
    · subst i
      simpa [qlast] using hlast0
    · obtain ⟨j, rfl⟩ := Fin.exists_castSucc_eq.mpr hi
      have hj : cfirst j = 0 := congrFun hcfirst0 j
      calc
        q (Fin.castSucc j) = algebraMap F K (cfirst j) := (hcF _).symm
        _ = algebraMap F K 0 := by rw [hj]
        _ = 0 := map_zero _
  let tF : F := cF (Fin.last n)
  have htF : algebraMap F K tF = qlast := hcF (Fin.last n)
  have htFne : tF ≠ 0 := by
    intro ht
    apply hlast_ne
    rw [← htF, ht, map_zero]
  refine ⟨fun i => cfirst i / tF, ?_⟩
  have hscaled :
      (fun i => algebraMap F K (cfirst i / tF)) = qlast⁻¹ • qfirst := by
    funext i
    change algebraMap F K (cfirst i / tF) = qlast⁻¹ * q (i.castSucc)
    rw [map_div₀, hcF i.castSucc, htF]
    simp [div_eq_mul_inv, mul_comm]
  rw [hscaled, map_smul, hφq]
  simp [smul_smul, hlast_ne]

/-- A finite subextension commutes with a directed intersection of coefficient fields. -/
private theorem finite_compositum_intersection
    {F K L A : Type*} [Field F] [Field K] [Field L]
    [Algebra F K] [Algebra K L] [Algebra F L] [IsScalarTower F K L]
    [Nonempty A] (G : A → IntermediateField F K)
    (hinf : ⨅ a, G a = ⊥)
    (hdir : ∀ a b, ∃ c, G c ≤ G a ⊓ G b)
    (E : IntermediateField F L) [FiniteDimensional F E] :
    E.toSubfield = ⨅ a, E.toSubfield ⊔
      (G a).toSubfield.map (algebraMap K L) := by
  classical
  let b := Module.finBasis F E
  let n := Module.finrank F E
  let φ : (Fin n → K) →ₗ[K] L :=
    ∑ i : Fin n, (LinearMap.proj i).smulRight ((b i : E) : L)
  have heq (c : Fin n → F) :
      (algebraMap E L) (∑ i : Fin n, c i • b i) =
        φ (fun i => algebraMap F K (c i)) := by
    simp [φ, LinearMap.sum_apply, LinearMap.smulRight_apply,
      LinearMap.proj_apply, map_sum, Algebra.smul_def,
      IsScalarTower.algebraMap_eq F K L]
  have hker : ∀ c : Fin n → F,
      φ (fun i => algebraMap F K (c i)) = 0 → c = 0 := by
    intro c hc
    have hsum : ∑ i : Fin n, c i • b i = 0 := by
      apply (algebraMap E L).injective
      rw [heq, hc, map_zero]
    have hz := (Fintype.linearIndependent_iff.mp b.linearIndependent) _ hsum
    funext i
    exact hz i
  apply le_antisymm
  · exact le_iInf (fun a => le_sup_left)
  · intro x hx
    have hsol : ∀ a, ∃ c : Fin n → G a,
        φ (fun i => algebraMap (G a) K (c i)) = x := by
      intro a
      let : Algebra (G a) L := inferInstance
      let : IsScalarTower F (G a) L := inferInstance
      let H : IntermediateField (G a) L :=
        IntermediateField.adjoin (G a) (E : Set L)
      have hE : E.toSubfield ≤ H.toSubfield := by
        intro y hy
        exact IntermediateField.mem_adjoin_of_mem (G a) hy
      have hG : (G a).toSubfield.map (algebraMap K L) ≤ H.toSubfield := by
        intro y hy
        rcases hy with ⟨z, hz, rfl⟩
        have hm := H.algebraMap_mem ⟨z, hz⟩
        change (algebraMap K L) z ∈ H
        convert hm using 1
        rfl
      have hxH : x ∈ H := (sup_le hE hG) ((Subfield.mem_iInf).mp hx a)
      have hA : H.toSubalgebra = Algebra.adjoin (G a) (E : Set L) :=
        IntermediateField.adjoin_intermediateField_toSubalgebra_of_isAlgebraic_right
          (G a) E
      have hspan := E.toSubalgebra.adjoin_eq_span_basis (G a) b
      have hxA : x ∈ Algebra.adjoin (G a) (E : Set L) := by
        rw [← hA]
        exact hxH
      have hxspan : x ∈ Submodule.span (G a)
          (Set.range (fun i => ((b i : E) : L))) := by
        have hxA' : x ∈ Subalgebra.toSubmodule
            (Algebra.adjoin (G a) (E.toSubalgebra : Set L)) := hxA
        exact hspan ▸ hxA'
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (G a)).mp hxspan
      refine ⟨c, ?_⟩
      simpa [φ, LinearMap.sum_apply, LinearMap.smulRight_apply,
        LinearMap.proj_apply, Algebra.smul_def,
        IsScalarTower.algebraMap_eq (G a) K L] using hc
    obtain ⟨c, hc⟩ := affine_solution_over_intersection G hinf hdir φ hker x hsol
    change x ∈ E
    rw [← hc, ← heq]
    exact (∑ i : Fin n, c i • b i).2

