module

public import StacksFrontier.FieldTheory.FieldOfDefinitionTensor
public import StacksFrontier.RingTheory.GeometricallyIntegral.TensorProduct
public import StacksFrontier.RingTheory.GeometricallyIntegral.TFAE

/-!
# Approximation of a rational group by finitely generated invariant subfields

Let `k` be a field and `K` a field extension of `k`, equipped with a coassociative
"comultiplication" `Δ : K → Frac(K ⊗[k] K)` — the map induced on function fields by the
multiplication of an integral group scheme with function field `K`.  Every finite subset of `K`
lies in a finitely generated intermediate field `K₁` such that `Δ(K₁)` lies in the image of
`Frac(K₁ ⊗[k] K)` (Perrin, thèse, III 2.2.1, one-sided form).

## Main results

* `TensorProduct.RationalGroup.exists_fg_leftInvariant_intermediateField`: the approximation.

## Implementation notes

The invariant subfield is taken in the *first* slot: `Δ(K₁) ⊆ Frac(K₁ ⊗[k] K)`.  For the
comultiplication `Δ b (x, g) = b (g x)` (the opposite of the usual one) this is left invariance
of `K₁`.

Coassociativity `(Δ ⊗ 1) ∘ Δ = (1 ⊗ Δ) ∘ Δ` is stated in `Frac(Frac(K ⊗ K) ⊗ K)`.  The first
side is `TensorProduct.fractionRingMap K Δ`, the extension of `Δ ⊗ 1`.  For the second side the
statement takes two ring maps `e₂₃, Δ₂₃ : Frac(K ⊗ K) → Frac(Frac(K ⊗ K) ⊗ K)` together with
their values on `K ⊗ K`, which determine them: `e₂₃` is the embedding of the last two slots,
`b ⊗ c ↦ (1 ⊗ b) ⊗ c`, and `Δ₂₃` is the extension of `a ⊗ b ↦ (a ⊗ 1) ⊗ 1 · e₂₃(Δ b)`.

The proof is Perrin's.  Let `K''` be generated by the minimal fields of definition (in the
first slot, `TensorProduct.fieldOfDefinition`) of the `Δ x`, `x ∈ s`, and `K₁ := K''(s)`.
Since `Δ x` is defined over `K'' `, coassociativity shows that `(Δ ⊗ 1)(Δ x)` is defined over
the image `M` of `Frac(K'' ⊗ K)` in the first slot `Frac(K ⊗ K)`; and by the functoriality of
minimal fields of definition (`TensorProduct.fieldOfDefinition_map`) the minimal field of
definition of `(Δ ⊗ 1)(Δ x)` is `Δ` of that of `Δ x`.  Hence `Δ(K'') ⊆ M`, and the elements `y`
with `Δ y` defined over `K₁` form a subfield containing `s` and `K''`.

## References

* D. Perrin, *Approximation des schémas en groupes, quasi compacts sur un corps*, thèse,
  III 2.2.1.
-/

@[expose] public section

open TensorProduct

universe u

namespace TensorProduct.RationalGroup

/-- A ring map out of a fraction field takes values in a subfield as soon as it does so on the
ring. -/
theorem map_mem_of_forall_algebraMap_mem {A F L : Type*} [CommRing A] [IsDomain A] [Field F]
    [Algebra A F] [IsFractionRing A F] [Field L] (φ : F →+* L) (Q : Subfield L)
    (h : ∀ a, φ (algebraMap A F a) ∈ Q) (z : F) : φ z ∈ Q := by
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := A) z
  rw [map_div₀]
  exact Q.div_mem (h a) (h b)

variable {k : Type*} [Field k] {K : Type*} [Field K] [Algebra k K]

/-- The image of `Frac(K' ⊗[k] K)` in `Frac(K ⊗[k] K)`, as a subfield. -/
noncomputable abbrev definedOver [IsDomain (K ⊗[k] K)] (K' : IntermediateField k K) :
    Subfield (FractionRing (K ⊗[k] K)) :=
  (fractionRingMap K K'.val).fieldRange

/-- Being defined over an intermediate field is monotone in it. -/
theorem definedOver_mono [IsDomain (K ⊗[k] K)] {K' K'' : IntermediateField k K}
    (h : K' ≤ K'') : definedOver K' ≤ definedOver K'' := by
  rintro _ ⟨z, rfl⟩
  refine ⟨fractionRingMap K (IntermediateField.inclusion h) z, ?_⟩
  change ((fractionRingMap K K''.val).comp (fractionRingMap K (IntermediateField.inclusion h))) z =
    fractionRingMap K K'.val z
  congr 1
  refine IsLocalization.ringHom_ext (nonZeroDivisors (K' ⊗[k] K)) (RingHom.ext fun p => ?_)
  simp only [RingHom.comp_apply, fractionRingMap_algebraMap]
  congr 1
  rw [← LinearMap.comp_apply, ← LinearMap.rTensor_comp]
  rfl

/-! ### The coassociativity maps -/

section Coassociativity

variable (k K) in
/-- The fraction field `Frac(K ⊗[k] K)` of the square of `K`. -/
abbrev Sq := FractionRing (K ⊗[k] K)

variable (k K) in
/-- The fraction field `Frac(Frac(K ⊗[k] K) ⊗[k] K)` of the cube of `K`. -/
abbrev Cube := FractionRing (Sq k K ⊗[k] K)

variable [IsDomain (K ⊗[k] K)]

/-- `Cube k K` is a field; registered directly because the search through `FractionRing` for a
`DivisionRing` structure on it does not terminate in time. -/
noncomputable instance instFieldCube [IsDomain (Sq k K ⊗[k] K)] : Field (Cube k K) :=
  FractionRing.field _

/-- The division ring structure of `Cube k K`, from `instFieldCube`. -/
noncomputable instance (priority := high) instDivisionRingCube [IsDomain (Sq k K ⊗[k] K)] :
    DivisionRing (Cube k K) :=
  instFieldCube.toDivisionRing

variable (k K) in
/-- The canonical map `K ⊗[k] K → Frac(K ⊗[k] K)`. -/
noncomputable abbrev toSq : K ⊗[k] K →ₐ[k] Sq k K := IsScalarTower.toAlgHom k _ _

omit [IsDomain (K ⊗[k] K)] in
/-- The map `K ⊗[k] K → Frac(K ⊗[k] K)` is injective. -/
theorem toSq_injective : Function.Injective (toSq k K) := IsFractionRing.injective _ _

variable [IsDomain (Sq k K ⊗[k] K)]

variable (k K) in
/-- The embedding `K ⊗[k] K → Frac(Frac(K ⊗[k] K) ⊗[k] K)` of the last two slots,
`b ⊗ c ↦ (1 ⊗ b) ⊗ c`. -/
noncomputable def lastTwoHom : K ⊗[k] K →ₐ[k] Cube k K :=
  (IsScalarTower.toAlgHom k _ _).comp
    (Algebra.TensorProduct.map ((toSq k K).comp
      (Algebra.TensorProduct.includeRight (R := k) (A := K) (B := K))) (AlgHom.id k K))

omit [IsDomain (K ⊗[k] K)] [IsDomain (Sq k K ⊗[k] K)] in
/-- `lastTwoHom` on a pure tensor. -/
theorem lastTwoHom_tmul (b c : K) :
    lastTwoHom k K (b ⊗ₜ[k] c) =
      algebraMap (Sq k K ⊗[k] K) (Cube k K) (toSq k K (1 ⊗ₜ[k] b) ⊗ₜ[k] c) :=
  rfl

omit [IsDomain (K ⊗[k] K)] [IsDomain (Sq k K ⊗[k] K)] in
/-- `lastTwoHom` is injective, `k` being a field. -/
theorem lastTwoHom_injective : Function.Injective (lastTwoHom k K) := by
  refine (IsFractionRing.injective (Sq k K ⊗[k] K) (Cube k K)).comp ?_
  exact TensorProduct.map_injective_of_flat_flat
    ((toSq k K).comp (Algebra.TensorProduct.includeRight (R := k) (A := K) (B := K))).toLinearMap
    (AlgHom.id k K).toLinearMap
    (toSq_injective.comp (Algebra.TensorProduct.includeRight_injective
      (A := K) (B := K) (algebraMap k K).injective))
    Function.injective_id

variable (k K) in
/-- The embedding `Frac(K ⊗[k] K) → Frac(Frac(K ⊗[k] K) ⊗[k] K)` of the last two slots. -/
noncomputable def lastTwo : Sq k K →ₐ[k] Cube k K :=
  IsFractionRing.liftAlgHom (K := Sq k K) (g := lastTwoHom k K) lastTwoHom_injective

/-- `lastTwo` extends `lastTwoHom`. -/
theorem lastTwo_algebraMap (x : K ⊗[k] K) :
    lastTwo k K (algebraMap _ _ x) = lastTwoHom k K x :=
  IsFractionRing.lift_algebraMap (K := Sq k K) (g := (lastTwoHom k K).toRingHom)
    lastTwoHom_injective x

/-- `lastTwo` extends `lastTwoHom`, along `toSq`. -/
theorem lastTwo_toSq (x : K ⊗[k] K) : lastTwo k K (toSq k K x) = lastTwoHom k K x :=
  lastTwo_algebraMap x

variable (k K) in
/-- The embedding `K → Frac(Frac(K ⊗[k] K) ⊗[k] K)` of the first slot, `a ↦ (a ⊗ 1) ⊗ 1`. -/
noncomputable def firstHom : K →ₐ[k] Cube k K :=
  (IsScalarTower.toAlgHom k (Sq k K ⊗[k] K) (Cube k K)).comp
    ((Algebra.TensorProduct.includeLeft (S := k) (R := k) (A := Sq k K) (B := K)).comp
      ((toSq k K).comp (Algebra.TensorProduct.includeLeft (S := k) (R := k) (A := K) (B := K))))

omit [IsDomain (K ⊗[k] K)] [IsDomain (Sq k K ⊗[k] K)] in
/-- The value of `firstHom`. -/
theorem firstHom_apply (a : K) :
    firstHom k K a =
      algebraMap (Sq k K ⊗[k] K) (Cube k K) (toSq k K (a ⊗ₜ[k] 1) ⊗ₜ[k] (1 : K)) :=
  rfl

variable (k K) in
/-- The map `K ⊗[k] Frac(K ⊗[k] K) → Frac(Frac(K ⊗[k] K) ⊗[k] K)`, `a ⊗ w ↦ (a ⊗ 1 ⊗ 1) · w`
with `w` in the last two slots. -/
noncomputable def firstLastTwo : K ⊗[k] Sq k K →ₐ[k] Cube k K :=
  Algebra.TensorProduct.lift (firstHom k K) (lastTwo k K) fun _ _ => mul_comm _ _

/-- `firstLastTwo` on a pure tensor. -/
theorem firstLastTwo_tmul (a : K) (w : Sq k K) :
    firstLastTwo k K (a ⊗ₜ w) = firstHom k K a * lastTwo k K w :=
  Algebra.TensorProduct.lift_tmul _ _ _ _ _

omit [IsDomain (Sq k K ⊗[k] K)] in
/-- Every element of `K ⊗[k] Frac(K ⊗[k] K)` becomes an element of `K ⊗[k] (K ⊗[k] K)` after
multiplication by `1 ⊗ d` for a nonzero `d`. -/
theorem exists_mul_eq_map (z : K ⊗[k] Sq k K) :
    ∃ d ∈ nonZeroDivisors (K ⊗[k] K), ∃ w : K ⊗[k] (K ⊗[k] K),
      (1 ⊗ₜ toSq k K d) * z = Algebra.TensorProduct.map (AlgHom.id k K) (toSq k K) w := by
  induction z using TensorProduct.inductionOn with
  | tmul a v =>
    obtain ⟨p, q, hq, rfl⟩ := IsFractionRing.div_surjective (A := K ⊗[k] K) v
    refine ⟨q, hq, a ⊗ₜ p, ?_⟩
    have hq' : toSq k K q ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hq
    rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply]
    congr 1
    change algebraMap _ (Sq k K) q * (algebraMap _ _ p / algebraMap _ _ q) = algebraMap _ _ p
    rw [mul_comm]
    exact div_mul_cancel₀ _ hq'
  | add z₁ z₂ h₁ h₂ =>
    obtain ⟨d₁, hd₁, w₁, hw₁⟩ := h₁
    obtain ⟨d₂, hd₂, w₂, hw₂⟩ := h₂
    refine ⟨d₁ * d₂, mul_mem hd₁ hd₂, (1 ⊗ₜ d₂) * w₁ + (1 ⊗ₜ d₁) * w₂, ?_⟩
    simp only [map_add, map_mul]
    rw [← hw₁, ← hw₂]
    simp only [Algebra.TensorProduct.map_tmul, map_one]
    rw [← mul_assoc, ← mul_assoc]
    simp only [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    rw [mul_comm (toSq k K d₂), mul_add]

omit [IsDomain (K ⊗[k] K)] [IsDomain (Sq k K ⊗[k] K)] in
/-- A product of pure tensors in `Frac(K ⊗[k] K) ⊗[k] K`. -/
theorem toSq_tmul_mul_tmul (a b c : K) :
    (toSq k K (a ⊗ₜ[k] 1) ⊗ₜ[k] (1 : K)) * (toSq k K (1 ⊗ₜ[k] b) ⊗ₜ[k] c) =
      toSq k K (a ⊗ₜ[k] b) ⊗ₜ[k] c := by
  rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
    mul_one, one_mul]

/-- On `K ⊗[k] (K ⊗[k] K)`, `firstLastTwo` is the reassociation followed by the canonical
injective maps. -/
theorem firstLastTwo_map (w : K ⊗[k] (K ⊗[k] K)) :
    firstLastTwo k K (Algebra.TensorProduct.map (AlgHom.id k K) (toSq k K) w) =
      algebraMap _ (Cube k K) (Algebra.TensorProduct.map (toSq k K) (AlgHom.id k K)
        ((Algebra.TensorProduct.assoc k k k K K K).symm w)) := by
  induction w using TensorProduct.inductionOn with
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add, map_add]
  | tmul a v =>
    induction v using TensorProduct.inductionOn with
    | add x y hx hy => rw [TensorProduct.tmul_add, map_add, map_add, hx, hy, map_add, map_add,
        map_add]
    | tmul b c =>
      rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, firstLastTwo_tmul, firstHom_apply,
        lastTwo_toSq, lastTwoHom_tmul, Algebra.TensorProduct.assoc_symm_tmul,
        Algebra.TensorProduct.map_tmul, AlgHom.id_apply, ← toSq_tmul_mul_tmul a b c]
      exact (RingHom.map_mul _ _ _).symm

/-- `firstLastTwo` is injective: after clearing a denominator it is the reassociation of
`K ⊗[k] (K ⊗[k] K)` followed by injective maps. -/
theorem firstLastTwo_injective : Function.Injective (firstLastTwo k K) := by
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨d, hd, w, hw⟩ := exists_mul_eq_map z
  have hw0 : w = 0 := by
    have h0 : firstLastTwo k K (Algebra.TensorProduct.map (AlgHom.id k K) (toSq k K) w) = 0 := by
      rw [← hw, map_mul, hz, mul_zero]
    rw [firstLastTwo_map] at h0
    have hinj : Function.Injective (algebraMap (Sq k K ⊗[k] K) (Cube k K)) :=
      IsFractionRing.injective _ _
    have hinj2 : Function.Injective (Algebra.TensorProduct.map (toSq k K) (AlgHom.id k K)) :=
      TensorProduct.map_injective_of_flat_flat (toSq k K).toLinearMap (AlgHom.id k K).toLinearMap
        toSq_injective Function.injective_id
    have h1 : (Algebra.TensorProduct.map (toSq k K) (AlgHom.id k K))
        ((Algebra.TensorProduct.assoc k k k K K K).symm w) = 0 :=
      hinj (h0.trans (map_zero (algebraMap (Sq k K ⊗[k] K) (Cube k K))).symm)
    have h2 := hinj2 (h1.trans (map_zero _).symm)
    exact (Algebra.TensorProduct.assoc k k k K K K).symm.injective (h2.trans (map_zero _).symm)
  rw [hw0, map_zero] at hw
  have hu : IsUnit ((1 : K) ⊗ₜ[k] toSq k K d) := by
    have hd' : toSq k K d ≠ 0 := IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hd
    refine ⟨⟨1 ⊗ₜ toSq k K d, 1 ⊗ₜ (toSq k K d)⁻¹, ?_, ?_⟩, rfl⟩ <;>
      rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul]
    · rw [mul_inv_cancel₀ hd']; rfl
    · rw [inv_mul_cancel₀ hd']; rfl
  exact hu.mul_right_eq_zero.mp hw

variable (Δ : K →ₐ[k] Sq k K)

/-- The map `1 ⊗ Δ : K ⊗[k] K → Frac(Frac(K ⊗[k] K) ⊗[k] K)`, `a ⊗ b ↦ (a ⊗ 1 ⊗ 1) · Δ(b)` with
`Δ(b)` in the last two slots. -/
noncomputable def comulLastTwoHom : K ⊗[k] K →ₐ[k] Cube k K :=
  (firstLastTwo k K).comp (Algebra.TensorProduct.map (AlgHom.id k K) Δ : K ⊗[k] K →ₐ[k] _)

/-- `1 ⊗ Δ` is injective. -/
theorem comulLastTwoHom_injective : Function.Injective (comulLastTwoHom Δ) :=
  firstLastTwo_injective.comp (TensorProduct.map_injective_of_flat_flat (R := k)
    (AlgHom.id k K).toLinearMap Δ.toLinearMap Function.injective_id Δ.toRingHom.injective)

/-- **The comultiplication on the last two slots**, `(1 ⊗ Δ)~ : Frac(K ⊗[k] K) →
Frac(Frac(K ⊗[k] K) ⊗[k] K)`; with `TensorProduct.fractionRingMap K Δ`, which is `(Δ ⊗ 1)~`, it
states coassociativity of `Δ`. -/
noncomputable def comulLastTwo : Sq k K →ₐ[k] Cube k K :=
  IsFractionRing.liftAlgHom (K := Sq k K) (g := comulLastTwoHom Δ) (comulLastTwoHom_injective Δ)

/-- `(1 ⊗ Δ)~` on the image of a pure tensor. -/
theorem comulLastTwo_algebraMap_tmul (a b : K) :
    comulLastTwo Δ (algebraMap (K ⊗[k] K) (Sq k K) (a ⊗ₜ[k] b)) =
      firstHom k K a * lastTwo k K (Δ b) := by
  rw [comulLastTwo, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]
  change firstLastTwo k K (a ⊗ₜ Δ b) = _
  exact firstLastTwo_tmul a (Δ b)

end Coassociativity

/-! ### Fields of definition -/

section Definition

variable {L : Type*} [Field L] [Algebra k L] [IsDomain (L ⊗[k] K)]

/-- `TensorProduct.fractionRingMap` commutes with the structure maps from `k`. -/
theorem fractionRingMap_algebraMap_base {K' : Type*} [Field K'] [Algebra k K']
    [IsDomain (K' ⊗[k] K)] (a : K' →ₐ[k] L) (c : k) :
    fractionRingMap K a (algebraMap k (FractionRing (K' ⊗[k] K)) c) = algebraMap k _ c := by
  rw [IsScalarTower.algebraMap_apply k (K' ⊗[k] K) (FractionRing (K' ⊗[k] K)),
    fractionRingMap_algebraMap, IsScalarTower.algebraMap_apply k (L ⊗[k] K) (FractionRing _)]
  congr 1
  exact (Algebra.TensorProduct.map a (AlgHom.id k K)).commutes c

/-- `TensorProduct.fractionRingMap K M.val` on a pure tensor. -/
theorem fractionRingMap_val_algebraMap_tmul (M : IntermediateField k L) (m : M) (d : K) :
    fractionRingMap K M.val (algebraMap (M ⊗[k] K) _ (m ⊗ₜ[k] d)) =
      algebraMap (L ⊗[k] K) _ ((m : L) ⊗ₜ[k] d) := by
  rw [fractionRingMap_algebraMap, LinearMap.rTensor_tmul]
  rfl

/-- The image of `Frac(K' ⊗[k] K)` in `Frac(L ⊗[k] K)`, as an intermediate field. -/
noncomputable def definedOverField (M : IntermediateField k L) :
    IntermediateField k (FractionRing (L ⊗[k] K)) :=
  Subfield.toIntermediateField (fractionRingMap K M.val).fieldRange fun c =>
    ⟨algebraMap k _ c, fractionRingMap_algebraMap_base M.val c⟩

/-- Membership in `definedOverField`. -/
theorem mem_definedOverField {M : IntermediateField k L} {z : FractionRing (L ⊗[k] K)} :
    z ∈ definedOverField (K := K) M ↔ z ∈ Set.range (fractionRingMap K M.val) :=
  Iff.rfl

end Definition

/-! ### The approximation -/

section Approximation

variable [IsDomain (K ⊗[k] K)] [IsDomain (Sq k K ⊗[k] K)] (Δ : K →ₐ[k] Sq k K)

omit [IsDomain (Sq k K ⊗[k] K)] in
/-- `TensorProduct.fractionRingMap K K'.val` on the image of a tensor. -/
theorem fractionRingMap_val_algebraMap (K' : IntermediateField k K) (a : K') (b : K) :
    fractionRingMap K K'.val (algebraMap (K' ⊗[k] K) _ (a ⊗ₜ[k] b)) =
      toSq k K ((a : K) ⊗ₜ[k] b) :=
  fractionRingMap_val_algebraMap_tmul K' a b

/-- An additive map out of a tensor product takes values in a subfield as soon as it does so on
pure tensors. -/
private theorem map_tmul_mem_subfield {M N L : Type*} [AddCommMonoid M] [Module k M]
    [AddCommMonoid N] [Module k N] [Field L] {F : Type*} [FunLike F (M ⊗[k] N) L]
    [AddMonoidHomClass F (M ⊗[k] N) L] (f : F) (Q : Subfield L)
    (h : ∀ m n, f (m ⊗ₜ[k] n) ∈ Q) (x : M ⊗[k] N) : f x ∈ Q := by
  induction x using TensorProduct.inductionOn with
  | add x y hx hy => rw [map_add]; exact Subfield.add_mem _ hx hy
  | tmul m n => exact h m n

/-- The image of `(a ⊗ b) ⊗ d`, for `a ∈ K'`, lies in the image of `Frac(M ⊗ K)`, for `M` the
image of `Frac(K' ⊗ K)`. -/
private theorem algebraMap_toSq_tmul_mem (K' : IntermediateField k K) {a : K} (ha : a ∈ K')
    (b d : K) : algebraMap (Sq k K ⊗[k] K) (Cube k K) (toSq k K (a ⊗ₜ[k] b) ⊗ₜ[k] d) ∈
      Set.range (fractionRingMap K (definedOverField (K := K) K').val) := by
  have hm : toSq k K (a ⊗ₜ[k] b) ∈ definedOverField (K := K) K' :=
    ⟨algebraMap _ _ ((⟨a, ha⟩ : K') ⊗ₜ[k] b), fractionRingMap_val_algebraMap K' ⟨a, ha⟩ b⟩
  exact ⟨algebraMap _ _ ((⟨_, hm⟩ : definedOverField (K := K) K') ⊗ₜ[k] d),
    by rw [fractionRingMap_val_algebraMap_tmul]⟩

/-- The last two slots of anything land in the image of `Frac(M ⊗ K)`, for `M` the image of
`Frac(K' ⊗ K)`. -/
theorem lastTwo_mem (K' : IntermediateField k K) (w : Sq k K) :
    lastTwo k K w ∈ Set.range (fractionRingMap K (definedOverField (K := K) K').val) := by
  refine map_mem_of_forall_algebraMap_mem (A := K ⊗[k] K) (lastTwo k K).toRingHom
    (definedOverField (K := K) (definedOverField (K := K) K')).toSubfield (fun q => ?_) w
  change lastTwo k K (algebraMap _ _ q) ∈ _
  rw [lastTwo_algebraMap]
  refine map_tmul_mem_subfield (lastTwoHom k K) _ (fun c d => ?_) q
  rw [lastTwoHom_tmul]
  exact algebraMap_toSq_tmul_mem K' K'.one_mem c d

/-- **`(1 ⊗ Δ)~` maps elements defined over `K'` to elements defined over the image of
`Frac(K' ⊗ K)`.** -/
theorem comulLastTwo_mem (K' : IntermediateField k K) {z : Sq k K}
    (hz : z ∈ Set.range (fractionRingMap K K'.val)) :
    comulLastTwo Δ z ∈ Set.range (fractionRingMap K (definedOverField (K := K) K').val) := by
  obtain ⟨w, rfl⟩ := hz
  refine map_mem_of_forall_algebraMap_mem (A := K' ⊗[k] K)
    ((comulLastTwo Δ).toRingHom.comp (fractionRingMap K K'.val))
    (definedOverField (K := K) (definedOverField (K := K) K')).toSubfield (fun p => ?_) w
  refine map_tmul_mem_subfield (((comulLastTwo Δ).toRingHom.comp (fractionRingMap K K'.val)).comp
    (algebraMap (K' ⊗[k] K) _)) _ (fun a b => ?_) p
  change comulLastTwo Δ (fractionRingMap K K'.val (algebraMap _ _ (a ⊗ₜ[k] b))) ∈ _
  rw [fractionRingMap_val_algebraMap]
  change comulLastTwo Δ (algebraMap (K ⊗[k] K) (Sq k K) ((a : K) ⊗ₜ[k] b)) ∈ _
  rw [comulLastTwo_algebraMap_tmul]
  refine Subfield.mul_mem _ ?_ (lastTwo_mem K' (Δ b) : _)
  rw [firstHom_apply]
  exact algebraMap_toSq_tmul_mem K' a.2 1 1

variable {Δ} in
/-- **The key step (Perrin, III 2.2.1).**  If `Δ x` is defined over `K'`, then `Δ` maps the
minimal field of definition of `Δ x` into the image of `Frac(K' ⊗[k] K)`. -/
theorem map_fieldOfDefinition_le (hcoass : ∀ x, fractionRingMap K Δ (Δ x) = comulLastTwo Δ (Δ x))
    (x : K) {K' : IntermediateField k K} (hK' : fieldOfDefinition (Δ x) ≤ K') :
    (fieldOfDefinition (Δ x)).map Δ ≤ definedOverField (K := K) K' := by
  rw [← fieldOfDefinition_map, hcoass]
  refine fieldOfDefinition_le ?_
  obtain ⟨w, hw⟩ := comulLastTwo_mem Δ K' (definedOver_mono hK' (fieldOfDefinition_spec (Δ x)))
  exact ⟨w, hw⟩

/-- **Perrin, thèse, III 2.2.1 (one-sided).**  Let `Δ : K → Frac(K ⊗[k] K)` be a coassociative
comultiplication: `(Δ ⊗ 1)~ ∘ Δ = (1 ⊗ Δ)~ ∘ Δ`.  Every finite subset `s` of `K` lies in a
finitely generated intermediate field `K₁` with `Δ(K₁)` contained in the image of
`Frac(K₁ ⊗[k] K)`.

`K₁` is generated by `s` and the minimal fields of definition of the `Δ x`, `x ∈ s`. -/
theorem exists_fg_leftInvariant_intermediateField
    (hcoass : ∀ x, fractionRingMap K Δ (Δ x) = comulLastTwo Δ (Δ x)) (s : Finset K) :
    ∃ K₁ : IntermediateField k K, K₁.FG ∧ (s : Set K) ⊆ K₁ ∧
      ∀ y ∈ K₁, Δ y ∈ Set.range (fractionRingMap K K₁.val) := by
  classical
  choose t ht using fun x : K => fieldOfDefinition_fg (Δ x)
  set T : Finset K := s ∪ s.biUnion t
  set K₁ := IntermediateField.adjoin k (T : Set K)
  have hsT : (s : Set K) ⊆ K₁ := fun x hx =>
    IntermediateField.subset_adjoin k _ (Finset.mem_coe.2 (Finset.mem_union_left _ hx))
  have hfod : ∀ x ∈ s, fieldOfDefinition (Δ x) ≤ K₁ := by
    intro x hx
    rw [← ht x, IntermediateField.adjoin_le_iff]
    intro z hz
    exact IntermediateField.subset_adjoin k _ (Finset.mem_coe.2 (Finset.mem_union_right _
      (Finset.mem_biUnion.2 ⟨x, hx, hz⟩)))
  refine ⟨K₁, ⟨T, rfl⟩, hsT, ?_⟩
  have hle : K₁ ≤ (definedOverField (K := K) K₁).comap Δ := by
    rw [IntermediateField.adjoin_le_iff]
    intro z hz
    rcases Finset.mem_union.1 (Finset.mem_coe.1 hz) with hz | hz
    · exact definedOver_mono (hfod z hz) (fieldOfDefinition_spec (Δ z))
    · obtain ⟨x, hx, hzx⟩ := Finset.mem_biUnion.1 hz
      have hz' : z ∈ fieldOfDefinition (Δ x) := by
        rw [← ht x]; exact IntermediateField.subset_adjoin k _ hzx
      exact map_fieldOfDefinition_le hcoass x (hfod x hx) ⟨z, hz', rfl⟩
  exact fun y hy => hle hy

end Approximation


