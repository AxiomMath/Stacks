module

public import Mathlib.FieldTheory.PurelyInseparable.Exponent
public import StacksFrontier.FieldTheory.PBasis
public import StacksFrontier.FieldTheory.Separable.Defs

/-!
# Separable algebraic elements lie in the compositum of the base with the `p`-th powers

Let `K/k` be an extension of fields of characteristic `p` and write `kK^p` for the subfield
`compositumFrobenius k K p` of `K` generated by the image of `k` together with all `p`-th powers
of elements of `K`. If `K/k` is separable in the sense of Tag 030O and `x ∈ K` is algebraic over
`k`, then `x` already lies in `kK^p`.

If moreover `[K : kK^p] = p`, a field `E` is embedded in `K` so that `K/E` is finite and the image
of `k` is contained in the image of `E`, and some element of `E` has image outside `kK^p`, then
`K/E` is separable.

## Main results

* `mem_compositumFrobenius_of_isIntegral`: an algebraic element of a separable extension lies in
  `kK^p`.
* `isSeparable_of_notMem_compositumFrobenius`: if `[K : kK^p] = p`, the extension `K/E` is finite,
  the image of `k` in `K` lies in the image of `E`, and some element of `E` has image outside
  `kK^p`, then `K` is separable over `E`.

## Implementation notes

The compositum `kK^p` is a `Subfield K` rather than an `IntermediateField k K`; it contains the
image of `k`, so `Subfield.toIntermediateField` turns it into one.

## References

* [Stacks Project, Tag 030O](https://stacks.math.columbia.edu/tag/030O)
* [Stacks Project, Tag 07P2](https://stacks.math.columbia.edu/tag/07P2)
* [Stacks Project, Tag 09HE](https://stacks.math.columbia.edu/tag/09HE)
-/

@[expose] public section

/-- An element of `K` that is integral over `k` is separable over `k` when `K/k` is a separable
extension in the sense of Tag 030O. -/
private theorem isSeparable_of_isSeparableExtension_of_isIntegral {k K : Type*} [Field k] [Field K]
    [Algebra k K] [Algebra.IsSeparableExtension k K] {x : K} (hx : IsIntegral k x) :
    IsSeparable k x := by
  let L : IntermediateField k K := IntermediateField.adjoin k {x}
  have : FiniteDimensional k L := IntermediateField.adjoin.finiteDimensional hx
  obtain ⟨s, hsBasis, hsSep⟩ :=
    Algebra.IsSeparablyGenerated.exists_isTranscendenceBasis_and_isSeparable (k := k) (K := L)
  rw [Set.isEmpty_coe_sort.mp hsBasis.1.isEmpty_of_isAlgebraic,
    IntermediateField.adjoin_empty] at hsSep
  have : Algebra.IsSeparable k L := Algebra.IsSeparable.trans k (⊥ : IntermediateField k L) L
  exact IntermediateField.isSeparable_of_mem_isSeparable k K
    (IntermediateField.mem_adjoin_simple_self k x)

/-- An element of `K` that is separable over `k` lies in the compositum `kK^p`. -/
private theorem mem_compositumFrobenius_of_isSeparable {k K : Type*} [Field k] [Field K]
    [Algebra k K] (p : ℕ) [Fact p.Prime] [CharP K p] {x : K} (hx : IsSeparable k x) :
    x ∈ compositumFrobenius k K p := by
  let P : IntermediateField k K :=
    (compositumFrobenius k K p).toIntermediateField fun a =>
      Subfield.subset_closure (Or.inl ⟨a, rfl⟩)
  have : ExpChar P p := .prime (Fact.out : p.Prime)
  have : IsPurelyInseparable P K := by
    rw [isPurelyInseparable_iff_pow_mem (F := P) p]
    exact fun y => ⟨1, ⟨⟨y ^ p, Subfield.subset_closure (Or.inr ⟨y, rfl⟩)⟩, by rw [pow_one]; rfl⟩⟩
  obtain ⟨y, hy⟩ := IsPurelyInseparable.inseparable P x (hx.tower_top P)
  exact hy ▸ y.2

/-- An element of `K` that is algebraic over `k` lies in the compositum `kK^p` of the image of `k`
with the `p`-th powers of `K`, provided `K/k` is a separable field extension in the sense of Tag
030O. -/
theorem mem_compositumFrobenius_of_isIntegral {k K : Type*} [Field k] [Field K] [Algebra k K]
    (p : ℕ) [Fact p.Prime] [CharP K p] [Algebra.IsSeparableExtension k K]
    (x : K) (hx : IsIntegral k x) : x ∈ compositumFrobenius k K p :=
  mem_compositumFrobenius_of_isSeparable p (isSeparable_of_isSeparableExtension_of_isIntegral hx)

/-- If `[K : kK^p] = p`, the image of `k` in `K` lies in the image of `E`, and some element of `E`
has image outside `kK^p`, then the `p`-th powers of `K` generate `K` over `E`. -/
private theorem adjoin_range_pow_eq_top {k K E : Type*} [Field k] [Field K] [Field E]
    [Algebra k K] [Algebra E K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (hdeg : Module.finrank (compositumFrobenius k K p) K = p)
    (hkE : ∀ a : k, algebraMap k K a ∈ (algebraMap E K).fieldRange)
    {f : E} (hf : algebraMap E K f ∉ compositumFrobenius k K p) :
    IntermediateField.adjoin E (Set.range fun x : K => x ^ p) = ⊤ := by
  have : IsSimpleOrder (IntermediateField (compositumFrobenius k K p) K) :=
    IntermediateField.isSimpleOrder_of_finrank_prime _ _ (by rw [hdeg]; exact Fact.out)
  have key : ∀ P : IntermediateField E K, compositumFrobenius k K p ≤ P.toSubfield → P = ⊤ := by
    intro P hCP
    set D : IntermediateField (compositumFrobenius k K p) K :=
      P.toSubfield.toIntermediateField fun a => hCP a.2
    have hmem : ∀ x : K, x ∈ D ↔ x ∈ P := fun _ => Iff.rfl
    rcases eq_bot_or_eq_top D with hD | hD
    · have hfD : algebraMap E K f ∈ D := (hmem _).2 (P.algebraMap_mem f)
      rw [hD, IntermediateField.mem_bot] at hfD
      obtain ⟨c, hc⟩ := hfD
      exact absurd (hc ▸ c.2) hf
    · exact eq_top_iff.mpr fun x _ => (hmem x).1 (hD ▸ IntermediateField.mem_top)
  refine key _ (Subfield.closure_le.mpr (Set.union_subset ?_ ?_))
  · rintro a ⟨c, rfl⟩
    obtain ⟨e, he⟩ := hkE c
    exact he ▸ IntermediateField.algebraMap_mem _ e
  · rintro a ⟨b, rfl⟩
    exact IntermediateField.subset_adjoin E _ ⟨b, rfl⟩

/-- If every `x : K` has `x ^ p ^ (j + 1)` in an intermediate field `L` of `K/E` and the `p`-th
powers of `K` generate `K` over `E`, then every `x : K` has `x ^ p ^ j ∈ L`. -/
private theorem pow_mem_of_pow_succ_mem {K E : Type*} [Field K] [Field E] [Algebra E K]
    (p : ℕ) [Fact p.Prime] [CharP K p] (L : IntermediateField E K)
    (htop : IntermediateField.adjoin E (Set.range fun x : K => x ^ p) = ⊤)
    {j : ℕ} (h : ∀ x : K, x ^ p ^ (j + 1) ∈ L) (x : K) : x ^ p ^ j ∈ L := by
  have hpj : p ^ j ≠ 0 := pow_ne_zero _ (Fact.out : p.Prime).pos.ne'
  set M : IntermediateField E K :=
    { carrier := {y : K | y ^ p ^ j ∈ L}
      mul_mem' := fun {a b} ha hb => by
        show (a * b) ^ p ^ j ∈ L
        rw [mul_pow]; exact mul_mem ha hb
      one_mem' := by
        show (1 : K) ^ p ^ j ∈ L
        rw [one_pow]; exact one_mem L
      add_mem' := fun {a b} ha hb => by
        show (a + b) ^ p ^ j ∈ L
        rw [add_pow_char_pow]; exact add_mem ha hb
      zero_mem' := by
        show (0 : K) ^ p ^ j ∈ L
        rw [zero_pow hpj]; exact zero_mem L
      algebraMap_mem' := fun r => by
        show algebraMap E K r ^ p ^ j ∈ L
        rw [← map_pow]; exact L.algebraMap_mem _
      inv_mem' := fun a ha => by
        show (a⁻¹) ^ p ^ j ∈ L
        rw [inv_pow]; exact inv_mem ha }
  have hmem : ∀ y : K, y ∈ M ↔ y ^ p ^ j ∈ L := fun _ => Iff.rfl
  have hle : (⊤ : IntermediateField E K) ≤ M := by
    rw [← htop]
    refine IntermediateField.adjoin_le_iff.mpr ?_
    rintro y ⟨z, rfl⟩
    refine (hmem _).2 ?_
    rw [← pow_mul, ← pow_succ']
    exact h z
  exact (hmem x).1 (hle IntermediateField.mem_top)

/-- If `[K : kK^p] = p`, the extension `K/E` is finite, the image of `k` in `K` lies in the image
of `E`, and some element of `E` has image outside `kK^p`, then `K` is separable over `E`. -/
theorem isSeparable_of_notMem_compositumFrobenius {k K E : Type*} [Field k] [Field K] [Field E]
    [Algebra k K] [Algebra E K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (hdeg : Module.finrank (compositumFrobenius k K p) K = p) [Module.Finite E K]
    (hkE : ∀ a : k, algebraMap k K a ∈ (algebraMap E K).fieldRange)
    {f : E} (hf : algebraMap E K f ∉ compositumFrobenius k K p) :
    Algebra.IsSeparable E K := by
  have htop := adjoin_range_pow_eq_top (k := k) p hdeg hkE hf
  have : Module.Finite (separableClosure E K) K :=
    Module.Finite.right E (separableClosure E K) K
  have : ExpChar (separableClosure E K) p := .prime (Fact.out : p.Prime)
  obtain ⟨m, hm0⟩ :=
    (IsPurelyInseparable.hasExponent_iff' (↥(separableClosure E K)) K p).1 inferInstance
  have hm : ∀ x : K, x ^ p ^ m ∈ separableClosure E K := fun x => by
    obtain ⟨c, hc⟩ := hm0 x
    exact hc ▸ c.2
  have descend : ∀ j : ℕ, (∀ x : K, x ^ p ^ j ∈ separableClosure E K) →
      ∀ x : K, x ∈ separableClosure E K := by
    intro j
    induction j with
    | zero => intro h x; simpa using h x
    | succ n ih => exact fun h => ih fun y => pow_mem_of_pow_succ_mem p _ htop h y
  rw [← separableClosure.eq_top_iff]
  exact eq_top_iff.mpr fun x _ => descend m hm x

end
