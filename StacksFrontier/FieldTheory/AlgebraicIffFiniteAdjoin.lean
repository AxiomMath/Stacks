module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# Algebraic extensions and finite simple subextensions

A finite field extension `E/k` is algebraic (`Algebra.IsAlgebraic.of_finite` in Mathlib), and an
extension `E/k` is algebraic if and only if every simple subextension `k(α)/k`, `α ∈ E`, is finite.
-/

@[expose] public section

open IntermediateField

/-- An extension `E/k` is algebraic if and only if every simple subextension `k(α)/k` generated by
some `α ∈ E` is finite. The forward direction is Mathlib's
`IntermediateField.adjoin.finiteDimensional` applied to each element; the reverse direction views
`α` as an element of the finite extension `k(α)/k`, where it is integral. -/
theorem Algebra.isAlgebraic_iff_forall_finiteDimensional_adjoin_simple {k E : Type*} [Field k]
    [Field E] [Algebra k E] :
    Algebra.IsAlgebraic k E ↔ ∀ α : E, FiniteDimensional k k⟮α⟯ := by
  refine ⟨fun _ α ↦ adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral α), fun h ↦ ?_⟩
  refine ⟨fun α ↦ ?_⟩
  have := h α
  let y : k⟮α⟯ := ⟨α, mem_adjoin_simple_self k α⟩
  exact ((Algebra.IsIntegral.isIntegral (R := k) y).map k⟮α⟯.val).isAlgebraic

/-- **Stacks 09GG.** A finite extension `E/k` is algebraic, and an extension `E/k` is algebraic if
and only if every simple subextension `k(α)/k` generated by some `α ∈ E` is finite. -/
@[stacks 09GG "Both assertions: the first is Mathlib's `Algebra.IsAlgebraic.of_finite`, the
second is `Algebra.isAlgebraic_iff_forall_finiteDimensional_adjoin_simple`."]
theorem Algebra.isAlgebraic_of_finite_and_isAlgebraic_iff_forall_finiteDimensional_adjoin
    (k E : Type*) [Field k] [Field E] [Algebra k E] :
    (FiniteDimensional k E → Algebra.IsAlgebraic k E) ∧
      (Algebra.IsAlgebraic k E ↔ ∀ α : E, FiniteDimensional k k⟮α⟯) :=
  ⟨fun _ ↦ Algebra.IsAlgebraic.of_finite k E,
    isAlgebraic_iff_forall_finiteDimensional_adjoin_simple⟩
