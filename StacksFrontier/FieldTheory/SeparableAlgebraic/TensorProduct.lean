module

public import Mathlib.RingTheory.Localization.Defs
public import StacksFrontier.FieldTheory.SeparableAlgebraic.Localization

import Mathlib.LinearAlgebra.TensorProduct.Quotient

/-!
# Changing the base of a tensor product along a separable algebraic extension

Let `R → S` be a ring map whose multiplication map `S ⊗[R] S → S` is a localization at a submonoid
`M`, and let `A`, `B` be `S`-algebras. Then `A ⊗[S] B` is the localization of `A ⊗[R] B` at the
image of `M`. The kernel of `A ⊗[R] B → A ⊗[S] B` is generated by the elements
`(s • a) ⊗ b - a ⊗ (s • b)`, each of which is the image of `s ⊗ 1 - 1 ⊗ s` times `a ⊗ b`, and
`s ⊗ 1 - 1 ⊗ s` is killed by an element of `M` since both terms multiply to `s`.

By Lemma 0C2X the hypothesis holds for a separable algebraic field extension `k'/k`, so that
`A ⊗[k'] B` is a localization of `A ⊗[k] B` for any two `k'`-algebras `A` and `B`; properties
of rings which pass to localizations therefore descend from `A ⊗[k] B` to `A ⊗[k'] B`. This is how
Lemmas 0C2Y and 0C31 compare geometric reducedness and normality over `k` and over `k'`.

## Main results

* `Algebra.TensorProduct.isLocalization_mapOfCompatibleSMul`: the general statement.
* `Algebra.TensorProduct.exists_isLocalization_mapOfCompatibleSMul_of_isSeparable`: the case of a
  separable algebraic field extension.

## References

* [Stacks Project, Tag 0C2X](https://stacks.math.columbia.edu/tag/0C2X)
-/

@[expose] public section

open scoped TensorProduct

namespace Algebra.TensorProduct

variable {R S A B : Type*} [CommRing R] [CommRing S] [CommRing A] [CommRing B] [Algebra R S]
  [Algebra R A] [Algebra R B] [Algebra S A] [Algebra S B] [IsScalarTower R S A]
  [IsScalarTower R S B]

/-- The map `S ⊗[R] S → A ⊗[R] B` induced by the structure maps. -/
noncomputable abbrev mapStructure : S ⊗[R] S →ₐ[R] A ⊗[R] B :=
  map (IsScalarTower.toAlgHom R S A) (IsScalarTower.toAlgHom R S B)

/-- The generator `(s • a) ⊗ b - a ⊗ (s • b)` of the kernel of `A ⊗[R] B → A ⊗[S] B` is the product
of `a ⊗ b` with the image of `s ⊗ 1 - 1 ⊗ s`. -/
private theorem smul_tmul_sub_tmul_smul (s : S) (a : A) (b : B) :
    (s • a) ⊗ₜ[R] b - a ⊗ₜ[R] (s • b) = mapStructure (s ⊗ₜ[R] 1 - 1 ⊗ₜ[R] s) * (a ⊗ₜ[R] b) := by
  simp [Algebra.smul_def, sub_mul]

/-- The map `A ⊗[R] B → A ⊗[S] B` carries the image of `x ∈ S ⊗[R] S` to the image of the product
`lmul' R x ∈ S`. -/
private theorem mapOfCompatibleSMul_mapStructure (x : S ⊗[R] S) :
    mapOfCompatibleSMul S R S A B (mapStructure x) = algebraMap S (A ⊗[S] B) (lmul' R x) := by
  induction x with
  | zero => simp
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  | tmul s t =>
    rw [map_tmul, IsScalarTower.coe_toAlgHom', IsScalarTower.coe_toAlgHom',
      mapOfCompatibleSMul_tmul, lmul'_apply_tmul, Algebra.algebraMap_eq_smul_one (A := B) t,
      TensorProduct.tmul_smul, TensorProduct.smul_tmul', Algebra.smul_def, ← map_mul, mul_comm,
      Algebra.TensorProduct.algebraMap_apply]

variable (M : Submonoid (S ⊗[R] S))

/-- An element of the kernel of `A ⊗[R] B → A ⊗[S] B` is killed by the image of an element of
`M`, when the multiplication map `S ⊗[R] S → S` is a localization at `M`. -/
private theorem exists_mul_eq_zero_of_mapOfCompatibleSMul_eq_zero
    (hloc : letI := (lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom.toAlgebra; IsLocalization M S)
    {x : A ⊗[R] B} (hx : mapOfCompatibleSMul S R S A B x = 0) :
    ∃ c ∈ M, mapStructure c * x = 0 := by
  let _ := (lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom.toAlgebra
  replace hx : x ∈ LinearMap.ker (_root_.TensorProduct.mapOfCompatibleSMul S R S A B) := hx
  rw [TensorProduct.AlgebraTensorModule.ker_mapOfCompatibleSMul] at hx
  induction hx using Submodule.span_induction with
  | zero => exact ⟨1, M.one_mem, mul_zero _⟩
  | mem y hy =>
    obtain ⟨s, a, b, rfl⟩ := hy
    obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := M) (S := S)
      (x := s ⊗ₜ[R] 1) (y := 1 ⊗ₜ[R] s) (by simp [RingHom.algebraMap_toAlgebra])
    refine ⟨c, c.2, ?_⟩
    rw [smul_tmul_sub_tmul_smul, ← mul_assoc, ← map_mul, mul_sub, hc, sub_self, map_zero,
      zero_mul]
  | add y z _ _ hy hz =>
    obtain ⟨c, hc, hcy⟩ := hy
    obtain ⟨c', hc', hcz⟩ := hz
    refine ⟨c * c', M.mul_mem hc hc', ?_⟩
    rw [map_mul, mul_add, mul_right_comm, hcy, mul_assoc, hcz]
    ring
  | smul s y _ hy =>
    obtain ⟨c, hc, hcy⟩ := hy
    refine ⟨c, hc, ?_⟩
    rw [Algebra.smul_def, mul_left_comm, hcy, mul_zero]

/-- If the multiplication map `S ⊗[R] S → S` is a localization at `M`, then for `S`-algebras `A`
and `B` the ring `A ⊗[S] B` is the localization of `A ⊗[R] B` at the image of `M`. -/
theorem isLocalization_mapOfCompatibleSMul
    (hloc : letI := (lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom.toAlgebra; IsLocalization M S) :
    letI := (mapOfCompatibleSMul S R S A B).toRingHom.toAlgebra
    IsLocalization (M.map (mapStructure (A := A) (B := B))) (A ⊗[S] B) := by
  let _ := (lmul' R : S ⊗[R] S →ₐ[R] S).toRingHom.toAlgebra
  let _ := (mapOfCompatibleSMul S R S A B).toRingHom.toAlgebra
  have halg : algebraMap (A ⊗[R] B) (A ⊗[S] B) = (mapOfCompatibleSMul S R S A B).toRingHom :=
    RingHom.algebraMap_toAlgebra _
  refine ⟨?_, fun z ↦ ?_, fun {x y} hxy ↦ ?_⟩
  · rintro ⟨_, hy⟩
    obtain ⟨c, hc, rfl⟩ := Submonoid.mem_map.mp hy
    rw [halg, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, mapOfCompatibleSMul_mapStructure]
    exact (IsLocalization.map_units S ⟨c, hc⟩).map (algebraMap S (A ⊗[S] B))
  · obtain ⟨t, rfl⟩ := mapOfCompatibleSMul_surjective S R S A B z
    exact ⟨⟨t, 1⟩, by simp [halg]⟩
  · rw [halg] at hxy
    obtain ⟨c, hc, hcxy⟩ := exists_mul_eq_zero_of_mapOfCompatibleSMul_eq_zero M hloc
      (x := x - y) (by simpa [sub_eq_zero] using hxy)
    exact ⟨⟨_, Submonoid.mem_map_of_mem _ hc⟩, by simpa [mul_sub, sub_eq_zero] using hcxy⟩

/-- **Change of base along a separable algebraic extension.** For a separable algebraic field
extension `k'/k` and `k'`-algebras `A` and `B`, the ring `A ⊗[k'] B` is a localization of
`A ⊗[k] B` along the canonical map, by Lemma 0C2X. -/
theorem exists_isLocalization_mapOfCompatibleSMul_of_isSeparable (k k' A B : Type*) [Field k]
    [Field k'] [CommRing A] [CommRing B] [Algebra k k'] [Algebra.IsSeparable k k'] [Algebra k A]
    [Algebra k B] [Algebra k' A] [Algebra k' B] [IsScalarTower k k' A] [IsScalarTower k k' B] :
    letI := (mapOfCompatibleSMul k' k k' A B).toRingHom.toAlgebra
    ∃ M : Submonoid (A ⊗[k] B), IsLocalization M (A ⊗[k'] B) := by
  obtain ⟨M, hM⟩ := exists_isLocalization_lmul'_of_isSeparable_isAlgebraic k k'
  exact ⟨_, isLocalization_mapOfCompatibleSMul M hM⟩

end Algebra.TensorProduct
