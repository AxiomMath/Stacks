module

public import Mathlib.FieldTheory.SeparableClosure
public import Mathlib.FieldTheory.SeparableDegree
import StacksCore.Tactic.StacksAttribute

/-!
# Separability along a tower of simple extensions

Let `E = F(α₀, …, α_{n-1})` be a finite extension and write `Kᵢ = F(α₀, …, α_{i-1})`. If each
`αᵢ` is separable over `Kᵢ`, then `E / F` is separable and the number of `F`-embeddings of `E`
into an algebraically closed extension of `F` equals `[E : F]`. If some `αᵢ` is not separable
over `Kᵢ`, that number is strictly smaller than `[E : F]`.

## Main results

* `IntermediateField.isSeparable_of_isSeparable_adjoin_image_Iio`: the extension is separable when
  every generator is separable over the field generated by the previous ones.
* `Field.card_algHom_eq_finrank_of_isSeparable_adjoin_image_Iio`: the number of embeddings equals
  the degree in that case.
* `Field.card_algHom_lt_finrank_of_not_isSeparable_adjoin_image_Iio`: the number of embeddings is
  strictly smaller than the degree when some generator is not separable over the field generated
  by the previous ones.

## References

* [Stacks Project, Tag 09H9](https://stacks.math.columbia.edu/tag/09H9)
-/

@[expose] public section

open Module IntermediateField

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- If each `αᵢ` is separable over `F(α₀, …, α_{i-1})` for `i < n`, then every `αᵢ` with `i < n`
is separable over `F`. -/
theorem IntermediateField.isSeparable_of_isSeparable_adjoin_image_Iio (α : ℕ → E) (n : ℕ)
    (hsep : ∀ i < n, IsSeparable (adjoin F (α '' Set.Iio i)) (α i)) :
    ∀ i < n, IsSeparable F (α i) := by
  suffices h : ∀ m ≤ n, ∀ i < m, IsSeparable F (α i) from h n le_rfl
  intro m hm
  induction m with
  | zero => simp
  | succ m ih =>
    have ih := ih (Nat.le_of_succ_le hm)
    intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
    · exact ih i hi
    · have : Algebra.IsSeparable F (adjoin F (α '' Set.Iio i)) :=
        (isSeparable_adjoin_iff_isSeparable F E).2 fun _ ⟨j, hj, hx⟩ ↦ hx ▸ ih j hj
      exact IsSeparable.of_algebra_isSeparable_of_isSeparable F (hsep i hm)

/-- **Stacks 09H9**, separability.
Let `E = F(α₀, …, α_{n-1})`. If each `αᵢ` is separable over `F(α₀, …, α_{i-1})`, then `E / F` is
separable. -/
@[stacks 09H9 "Separability of `K/F` when each `αᵢ` is separable over `K_{i-1}`."]
theorem Algebra.isSeparable_of_isSeparable_adjoin_image_Iio (α : ℕ → E) (n : ℕ)
    (hgen : IntermediateField.adjoin F (α '' Set.Iio n) = ⊤)
    (hsep : ∀ i < n, IsSeparable (IntermediateField.adjoin F (α '' Set.Iio i)) (α i)) :
    Algebra.IsSeparable F E := by
  set K := IntermediateField.adjoin F (α '' Set.Iio n)
  have : Algebra.IsSeparable F K :=
    (IntermediateField.isSeparable_adjoin_iff_isSeparable F E).2 fun _ ⟨j, hj, hx⟩ ↦
      hx ▸ IntermediateField.isSeparable_of_isSeparable_adjoin_image_Iio α n hsep j hj
  exact ⟨fun x ↦ IntermediateField.isSeparable_of_mem_isSeparable F E (L := K)
    (hgen ▸ IntermediateField.mem_top : x ∈ K)⟩

/-- **Stacks 09H9**, the count.
Let `E = F(α₀, …, α_{n-1})` and `L` an algebraically closed extension of `F`. If each `αᵢ` is
separable over `F(α₀, …, α_{i-1})`, then the number of `F`-embeddings `E → L` is `[E : F]`.
Finiteness of `E / F` is not assumed: it follows from the hypotheses. -/
@[stacks 09H9 "Equality `|Mor_F(K, F̄)| = [K : F]` when each `αᵢ` is separable over `K_{i-1}`."]
theorem Field.card_algHom_eq_finrank_of_isSeparable_adjoin_image_Iio (L : Type*) [Field L]
    [Algebra F L] [IsAlgClosed L] (α : ℕ → E) (n : ℕ)
    (hgen : adjoin F (α '' Set.Iio n) = ⊤)
    (hsep : ∀ i < n, IsSeparable (adjoin F (α '' Set.Iio i)) (α i)) :
    Nat.card (E →ₐ[F] L) = finrank F E := by
  have := Algebra.isSeparable_of_isSeparable_adjoin_image_Iio α n hgen hsep
  rw [← Field.finSepDegree_eq_of_isAlgClosed F E L, Field.finSepDegree_eq_finrank_of_isSeparable]

/-- **Stacks 09H9**, the strict inequality.
Let `E / F` be a finite extension, `L` an algebraically closed extension of `F` and
`α₀, …, α_{n-1} ∈ E`. If some `αᵢ` is not separable over `F(α₀, …, α_{i-1})`, then the number of
`F`-embeddings `E → L` is strictly smaller than `[E : F]`. That the `αᵢ` generate `E` is not
needed. -/
@[stacks 09H9 "Strict inequality `|Mor_F(K, F̄)| < [K : F]` when some `αᵢ` is not separable
  over `K_{i-1}`."]
theorem Field.card_algHom_lt_finrank_of_not_isSeparable_adjoin_image_Iio (L : Type*) [Field L]
    [Algebra F L] [IsAlgClosed L] [FiniteDimensional F E] (α : ℕ → E) (n : ℕ)
    (hns : ∃ i < n, ¬ IsSeparable (adjoin F (α '' Set.Iio i)) (α i)) :
    Nat.card (E →ₐ[F] L) < finrank F E := by
  rw [← Field.finSepDegree_eq_of_isAlgClosed F E L]
  refine lt_of_le_of_ne (Field.finSepDegree_le_finrank F E) fun h ↦ ?_
  have := (Field.finSepDegree_eq_finrank_iff F E).1 h
  obtain ⟨i, -, hi⟩ := hns
  exact hi ((Algebra.IsSeparable.isSeparable F (α i)).tower_top _)
