module

public import Mathlib.FieldTheory.KummerExtension
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Kummer extensions obtained by adjoining an `n`-th root

Let `L / K` be generated by an element `b` whose `n`-th power lies in `K`. If `K` contains a
primitive `n`-th root of unity, then `L / K` is a finite Galois extension. Its Galois group
embeds in the group of `n`-th roots of unity of `K` by the Kummer character `σ ↦ σ b / b`; in
particular the Galois group is cyclic and the degree of `L / K` divides `n`.

## Main definitions

* `Stacks.FieldTheory.KummerExtension.kummerCharacter`: the canonical homomorphism from the
  Galois group to the `n`-th roots of unity in the base field.

## Main results

* `Stacks.FieldTheory.KummerExtension.kummerCharacter_apply`: the Kummer character has value
  `σ b / b` after mapping it into the extension field.
* `isGalois_isCyclic_finrank_dvd_and_kummerCharacter_injective_of_adjoin_root_eq_top`:
  Galoisness, cyclicity, the degree bound, and injectivity of the Kummer character.

## Implementation notes

The condition that the `n`-th power of the generator lies in the base field is expressed as
membership in the range of the algebra map. The Kummer character uses the equivalence between the
roots of unity in the two fields induced by a primitive root in the base field.

## References

* [Stacks Project, Tag 09I6](https://stacks.math.columbia.edu/tag/09I6)
-/

@[expose] public section

universe uK uL

namespace Stacks.FieldTheory.KummerExtension

/-- The Kummer character associated to a nonzero element `b` whose `n`-th
power lies in the base field. It sends `σ` to the unique `n`-th root of unity
in the base field whose image in the extension is `σ(b) / b`. -/
@[sga "7 XV 3.3.2"]
noncomputable def kummerCharacter
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (n : ℕ) (hn : n ≠ 0) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (b : L) (hb : b ≠ 0)
    (hpow : b ^ n ∈ Set.range (algebraMap K L)) :
    (L ≃ₐ[K] L) →* rootsOfUnity n K := by
  let _ : NeZero n := ⟨hn⟩
  let e : rootsOfUnity n K ≃* rootsOfUnity n L :=
    rootsOfUnityEquivOfPrimitiveRoots (algebraMap K L).injective
      ⟨ζ, (mem_primitiveRoots (NeZero.pos n)).2 hζ⟩
  let ratio : (L ≃ₐ[K] L) → rootsOfUnity n L := fun σ ↦
    rootsOfUnity.mkOfPowEq (σ b / b) (by
      obtain ⟨a, ha⟩ := hpow
      have ha0 : algebraMap K L a ≠ 0 := ha.trans_ne (pow_ne_zero n hb)
      rw [div_pow, ← map_pow, ← ha, σ.commutes, div_self ha0])
  refine
    { toFun := fun σ ↦ e.symm (ratio σ)
      map_one' := ?_
      map_mul' := ?_ }
  · apply e.injective
    apply rootsOfUnity.coe_injective
    simp [ratio, hb]
  · intro σ τ
    apply e.injective
    simp only [map_mul, MulEquiv.apply_symm_apply]
    apply rootsOfUnity.coe_injective
    have hratio (ρ : L ≃ₐ[K] L) :
        algebraMap K L ((e.symm (ratio ρ) : rootsOfUnity n K) : Kˣ) =
          ((ratio ρ : rootsOfUnity n L) : Lˣ) :=
      rootsOfUnityEquivOfPrimitiveRoots_symm_apply
        (algebraMap K L).injective
        ⟨ζ, (mem_primitiveRoots (NeZero.pos n)).2 hζ⟩ _
    change (σ * τ) b / b = (σ b / b) * (τ b / b)
    rw [AlgEquiv.mul_apply]
    have hτ :
        τ b = algebraMap K L ((e.symm (ratio τ) : rootsOfUnity n K) : Kˣ) * b := by
      rw [hratio τ]
      change τ b = (τ b / b) * b
      field_simp
    rw [hτ, map_mul, σ.commutes, hratio τ]
    field_simp

/-- After mapping to the extension field, the Kummer character has value
`σ(b) / b`. -/
theorem kummerCharacter_apply
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (n : ℕ) (hn : n ≠ 0) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (b : L) (hb : b ≠ 0)
    (hpow : b ^ n ∈ Set.range (algebraMap K L)) (σ : L ≃ₐ[K] L) :
    algebraMap K L
        (((kummerCharacter K L n hn ζ hζ b hb hpow σ : rootsOfUnity n K) : Kˣ) : K) =
      σ b / b := by
  let _ : NeZero n := ⟨hn⟩
  dsimp [kummerCharacter]
  exact rootsOfUnityEquivOfPrimitiveRoots_symm_apply
    (algebraMap K L).injective
    ⟨ζ, (mem_primitiveRoots (NeZero.pos n)).2 hζ⟩ _

/-- Two automorphisms of `L / K` agreeing on a generator `b` of `L` are equal. -/
private theorem algEquiv_ext_of_adjoin_singleton_eq_top {K L : Type*} [Field K] [Field L]
    [Algebra K L] {b : L} (hgen : Algebra.adjoin K {b} = ⊤) {σ τ : L ≃ₐ[K] L}
    (h : σ b = τ b) : σ = τ := by
  have : σ.toAlgHom = τ.toAlgHom :=
    AlgHom.ext_of_adjoin_eq_top hgen fun x hx ↦ by simpa [Set.mem_singleton_iff.1 hx] using h
  exact AlgEquiv.coe_toAlgHom_injective this

/-- A field extension generated by an `n`-th root is finite Galois when the
base field contains a primitive `n`-th root of unity. Its Galois group is
cyclic, its degree divides `n`, and, for a nonzero generator, its Kummer
character is injective and is given by `σ ↦ σ(b) / b`. -/
@[stacks 09I6]
theorem isGalois_isCyclic_finrank_dvd_and_kummerCharacter_injective_of_adjoin_root_eq_top
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    (n : ℕ) (hn : 2 ≤ n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (b : L)
    (hpow : b ^ n ∈ Set.range (algebraMap K L))
    (hgen : Algebra.adjoin K {b} = ⊤) :
    ∃ hfin : Module.Finite K L,
      letI := hfin
      IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L) ∧ Module.finrank K L ∣ n ∧
        ∀ hb : b ≠ 0,
          Function.Injective
            (kummerCharacter K L n (by omega) ζ hζ b hb hpow) ∧
          ∀ σ : L ≃ₐ[K] L,
            algebraMap K L
                (((kummerCharacter K L n (by omega) ζ hζ b hb hpow σ :
                    rootsOfUnity n K) : Kˣ) : K) =
              σ b / b := by
  obtain ⟨a, ha⟩ := id hpow
  have : NeZero n := ⟨by lia⟩
  have hbint : IsIntegral K b := by
    refine ⟨Polynomial.X ^ n - Polynomial.C a,
      Polynomial.monic_X_pow_sub_C _ (by lia), ?_⟩
    simp [ha]
  let hfin : Module.Finite K L := by
    let := Algebra.finite_adjoin_simple_of_isIntegral hbint
    apply Module.Finite.of_surjective (Algebra.adjoin K {b}).val.toLinearMap
    intro x
    refine ⟨⟨x, ?_⟩, rfl⟩
    rw [hgen]
    trivial
  refine ⟨hfin, ?_⟩
  let := hfin
  have hinjective (hb : b ≠ 0) :
      Function.Injective (kummerCharacter K L n (by lia) ζ hζ b hb hpow) := by
    intro σ τ hστ
    refine algEquiv_ext_of_adjoin_singleton_eq_top hgen ?_
    have hratio : σ b / b = τ b / b := by
      rw [← kummerCharacter_apply K L n (by lia) ζ hζ b hb hpow σ,
        ← kummerCharacter_apply K L n (by lia) ζ hζ b hb hpow τ, hστ]
    simpa [hb] using congrArg (fun x : L ↦ x * b) hratio
  have hK (hb : b = 0) : Nonempty (K ≃ₐ[K] L) := by
    have htopbot : (⊤ : Subalgebra K L) = ⊥ := by
      rw [← hgen, hb]
      simp
    exact ⟨AlgEquiv.ofBijective (Algebra.ofId K L) (Algebra.bijective_algebraMap_iff.2 htopbot)⟩
  have hGalois : IsGalois K L := by
    by_cases hb : b = 0
    · obtain ⟨e⟩ := hK hb
      exact IsGalois.of_algEquiv e
    · let : Polynomial.IsSplittingField K L
          (Polynomial.X ^ n - Polynomial.C a) := by
        constructor
        · simpa [ha] using
            X_pow_sub_C_splits_of_isPrimitiveRoot
              (hζ.map_of_injective (algebraMap K L).injective) ha.symm
        · apply le_antisymm le_top
          rw [← hgen]
          apply Algebra.adjoin_mono
          rw [Set.singleton_subset_iff, Polynomial.mem_rootSet_of_ne
            (Polynomial.X_pow_sub_C_ne_zero (by lia) a)]
          simp [ha]
      apply IsGalois.of_separable_splitting_field
        (p := Polynomial.X ^ n - Polynomial.C a)
      rw [← Polynomial.separable_map (algebraMap K L)]
      apply (Polynomial.nodup_roots_iff_of_splits
        (Polynomial.map_ne_zero
          (Polynomial.X_pow_sub_C_ne_zero (by lia) a))
          (Polynomial.IsSplittingField.splits (L := L)
            (Polynomial.X ^ n - Polynomial.C a))).mp
      simpa [Polynomial.nthRoots, ha] using
        (hζ.map_of_injective (algebraMap K L).injective).nthRoots_nodup
          (pow_ne_zero n hb)
  let := hGalois
  have hcyclic : IsCyclic (L ≃ₐ[K] L) := by
    by_cases hb : b = 0
    · have hsub : Subsingleton (L ≃ₐ[K] L) :=
        ⟨fun σ τ ↦ algEquiv_ext_of_adjoin_singleton_eq_top hgen (by simp [hb])⟩
      infer_instance
    · exact isCyclic_of_injective
        (kummerCharacter K L n (by lia) ζ hζ b hb hpow) (hinjective hb)
  refine ⟨hGalois, hcyclic, ?_, fun hb ↦ ⟨hinjective hb, ?_⟩⟩
  · by_cases hb : b = 0
    · obtain ⟨e⟩ := hK hb
      rw [← e.toLinearEquiv.finrank_eq]
      simp
    · rw [← IsGalois.card_aut_eq_finrank, ← hζ.card_rootsOfUnity]
      exact Subgroup.card_dvd_of_injective
        (kummerCharacter K L n (by lia) ζ hζ b hb hpow) (hinjective hb)
  · exact kummerCharacter_apply K L n (by lia) ζ hζ b hb hpow

end Stacks.FieldTheory.KummerExtension
