/-! # Separable degree -/

@[expose] public section

add_to_stacks 09H5 Polynomial.natSepDegree_eq_of_isAlgClosed

open Field Fintype IntermediateField

section Tower

open Polynomial

variable {F E : Type*} [Field F] [Field E] [Algebra F E]

/-- Adjoining the first `i + 1` terms of a sequence is adjoining the `i`-th term to the field
generated by the first `i` terms. -/
theorem IntermediateField.adjoin_image_Iio_succ (α : ℕ → E) (i : ℕ) :
    adjoin F (α '' Set.Iio (i + 1)) =
      (adjoin (adjoin F (α '' Set.Iio i)) {α i}).restrictScalars F := by
  rw [restrictScalars_adjoin, Set.union_singleton, adjoin_insert_adjoin, ← Set.image_insert_eq,
    ← Order.succ_eq_add_one, Order.Iio_succ_eq_insert]

/-- The separable degree of `F(α₀, …, α_{n-1}) / F` is the product of the separable degrees of the
minimal polynomials of `αᵢ` over `F(α₀, …, α_{i-1})`. -/
theorem IntermediateField.finSepDegree_adjoin_image_Iio [Algebra.IsAlgebraic F E] (α : ℕ → E)
    (n : ℕ) : finSepDegree F (adjoin F (α '' Set.Iio n)) =
      ∏ i ∈ Finset.range n, (minpoly (adjoin F (α '' Set.Iio i)) (α i)).natSepDegree := by
  induction n with
  | zero =>
    rw [show adjoin F (α '' Set.Iio 0) = ⊥ by simp, finSepDegree_bot]
    simp
  | succ n ih =>
    rw [Finset.prod_range_succ, ← ih, adjoin_image_Iio_succ,
      ← finSepDegree_adjoin_simple_eq_natSepDegree _ _ (Algebra.IsAlgebraic.isAlgebraic (α n)),
      finSepDegree_mul_finSepDegree_of_isAlgebraic]
    rfl

/-- **Stacks 09H7**.
Let `E = F(α₀, …, α_{n-1})` and let `L` be a field extension of `F`. Write
`Kᵢ = F(α₀, …, α_{i-1})` and `Pᵢ` for the minimal polynomial of `αᵢ` over `Kᵢ`. Then
`φ ↦ (φ(α₀), …, φ(α_{n-1}))` is a bijection from the `F`-embeddings `E → L` onto the tuples
`(β₀, …, β_{n-1})` for which there are `F`-embeddings `ψᵢ : Kᵢ → L` (`i ≤ n`) such that `βᵢ` is
a root of `Pᵢ` twisted by `ψᵢ`, and `ψᵢ₊₁` extends `ψᵢ` and sends `αᵢ` to `βᵢ`. -/
@[stacks 09H7]
theorem IntermediateField.bijOn_algHom_apply_of_adjoin_eq_top {L : Type*} [Field L] [Algebra F L]
    (α : ℕ → E) (n : ℕ) (hgen : adjoin F (α '' Set.Iio n) = ⊤) :
    Set.BijOn (fun (φ : E →ₐ[F] L) (i : Fin n) ↦ φ (α i)) Set.univ
      {β | ∃ ψ : ∀ i ≤ n, adjoin F (α '' Set.Iio i) →ₐ[F] L, ∀ (i : ℕ) (hi : i < n),
        ((minpoly (adjoin F (α '' Set.Iio i)) (α i)).map (ψ i hi.le : _ →+* L)).IsRoot
          (β ⟨i, hi⟩) ∧
        (ψ (i + 1) (Order.add_one_le_of_lt hi)).comp (inclusion <| adjoin.mono _ _ _ <|
          Set.image_mono <| Set.Iio_subset_Iio (Nat.le_add_right i 1)) = ψ i hi.le ∧
        ψ (i + 1) (Order.add_one_le_of_lt hi)
          ⟨α i, Set.mem_of_subset_of_mem (subset_adjoin _ _) <|
            Set.mem_image_of_mem α <| Set.mem_Iio.2 (Nat.lt_add_one i)⟩ =
          β ⟨i, hi⟩} := by
  refine ⟨fun φ _ ↦ ⟨fun i _ ↦ φ.comp (val _), fun i hi ↦ ⟨?_, rfl, rfl⟩⟩,
    fun φ _ φ' _ h ↦ ?_, fun β ⟨ψ, hψ⟩ ↦ ?_⟩
  · have := hom_eval₂ (minpoly (adjoin F (α '' Set.Iio i)) (α i)) (algebraMap _ E) (φ : E →+* L)
      (α i)
    rw [← aeval_def, minpoly.aeval, map_zero] at this
    rw [IsRoot, eval_map]
    exact this.symm
  · refine AlgHom.ext fun x ↦ ?_
    have hx : x ∈ adjoin F (α '' Set.Iio n) := hgen ▸ mem_top
    induction hx using adjoin_induction with
    | mem x hx => obtain ⟨i, hi, rfl⟩ := hx; exact congr_fun h ⟨i, hi⟩
    | algebraMap => simp
    | add _ _ _ _ h₁ h₂ => simp [h₁, h₂]
    | mul _ _ _ _ h₁ h₂ => simp [h₁, h₂]
    | inv _ _ h => simp [h]
  · have key (i : ℕ) (hi : i < n) (j : ℕ) (hij : i < j) (hj : j ≤ n) :
        ψ j hj ⟨α i, Set.mem_of_subset_of_mem (subset_adjoin _ _)
          (Set.mem_image_of_mem α (Set.mem_Iio.2 hij))⟩ =
          β ⟨i, hi⟩ := by
      induction j, hij using Nat.le_induction with
      | base => exact (hψ i hi).2.2
      | succ j hij ih =>
        rw [← ih (Nat.le_of_succ_le hj), ← (hψ j hj).2.1]
        rfl
    refine ⟨(ψ n le_rfl).comp ((equivOfEq hgen).trans topEquiv).symm.toAlgHom, trivial, ?_⟩
    funext ⟨i, hi⟩
    exact key i hi n hi le_rfl

/-- **Stacks 09H8**.
Let `E = F(α₀, …, α_{n-1})` be an algebraic extension and `L` an algebraically closed field
extension of `F`. Then the number of `F`-embeddings `E → L` is the product over `i < n` of the
separable degrees of the minimal polynomials of `αᵢ` over `F(α₀, …, α_{i-1})`. -/
@[stacks 09H8]
theorem Field.card_algHom_eq_prod_natSepDegree (L : Type*) [Field L] [Algebra F L] [IsAlgClosed L]
    [Algebra.IsAlgebraic F E] (α : ℕ → E) (n : ℕ) (hgen : adjoin F (α '' Set.Iio n) = ⊤) :
    Nat.card (E →ₐ[F] L) =
      ∏ i ∈ Finset.range n, (minpoly (adjoin F (α '' Set.Iio i)) (α i)).natSepDegree := by
  rw [← finSepDegree_eq_of_isAlgClosed F E L, ← finSepDegree_adjoin_image_Iio, hgen,
    finSepDegree_top]

end Tower

/-- Composing with the canonical embedding into the algebraic closure is injective. -/
private theorem injective_algHom_comp_algebraicClosure (F E : Type*) [Field F] [Field E]
    [Algebra F E] :
    Function.Injective ((Algebra.algHom F E (AlgebraicClosure E)).comp : (E →ₐ[F] E) → _) :=
  fun _ _ ↦ (AlgHom.cancel_left (RingHom.injective _)).mp

/-- The cardinalities of `E ≃ₐ[F] E` and of the `F`-embeddings of `E` into its algebraic closure,
in terms of `E →ₐ[F] E` and `finSepDegree F E`. -/
private theorem card_algEquiv_and_finSepDegree_eq (F E : Type*) [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] :
    card (E ≃ₐ[F] E) = card (E →ₐ[F] E) ∧
      finSepDegree F E = card (E →ₐ[F] AlgebraicClosure E) :=
  ⟨card_congr (algEquivEquivAlgHom _ _).toEquiv,
    (finSepDegree_eq_of_isAlgClosed _ _ (AlgebraicClosure E)).trans Nat.card_eq_fintype_card⟩

@[stacks 09HS "inequality"]
theorem card_algEquiv_le_finSepDegree
    (F E : Type*) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E] :
    card (E ≃ₐ[F] E) ≤ finSepDegree F E := by
  rw [(card_algEquiv_and_finSepDegree_eq F E).1, (card_algEquiv_and_finSepDegree_eq F E).2]
  exact card_le_of_injective _ (injective_algHom_comp_algebraicClosure F E)

@[stacks 09HS "equality"]
theorem normal_iff_card_algEquiv_eq_finSepDegree
    (F E : Type*) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E] :
    Normal F E ↔ card (E ≃ₐ[F] E) = finSepDegree F E := by
  simp_rw [normal_iff_comp_bijective (Algebra.algHom F E (AlgebraicClosure E)),
    Fintype.bijective_iff_injective_and_card, injective_algHom_comp_algebraicClosure, true_and,
    (card_algEquiv_and_finSepDegree_eq F E).1, (card_algEquiv_and_finSepDegree_eq F E).2]

open Polynomial

/-- Scaling a separable element by a scalar in the base field preserves separability. -/
@[simp]
theorem IsSeparable.smul {K A : Type*} [Field K] [CommRing A] [Algebra K A]
    {x : A} (hx : IsSeparable K x) (b : K) : IsSeparable K (b • x) := by
  obtain rfl | hb := eq_or_ne b 0
  · simp [zero]
  have hbx := hx.isIntegral.smul b
  classical
  rw [IsSeparable, minpoly_smul _ hb, ← natSepDegree_eq_natDegree_iff _
    (scaleRoots_ne_zero (minpoly.ne_zero hx.isIntegral) _),
    natDegree_scaleRoots, natSepDegree_eq_of_isAlgClosed (AlgebraicClosure K), aroots,
    map_scaleRoots _ _ _ (by simp [minpoly.ne_zero hx.isIntegral]), roots_scaleRoots _ (by simpa),
    Multiset.toFinset_map, Finset.card_image_of_injective, ← aroots,
    ← natSepDegree_eq_of_isAlgClosed, natSepDegree_eq_natDegree_of_separable _ hx]
  simpa [← Algebra.smul_def] using smul_right_injective _ hb
