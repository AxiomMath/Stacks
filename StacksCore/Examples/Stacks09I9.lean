module

public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import StacksCore.Examples.Stacks09I8

/-! # Transcendence degree of ℚ(e, π)

The transcendence degree of `ℚ(e, π)` over `ℚ` is either `1` or `2`: at most `2`
because two elements generate the field, and at least `1` because one of the
generators is transcendental. Which of the two occurs is not known — it is `1`
exactly when `e` and `π` are algebraically dependent over `ℚ`.

Only transcendence of `π` is needed, and it is `transcendental_pi` (Tag 09I8).
-/

@[expose] public section

open Real IntermediateField

namespace Stacks.Examples.Stacks09I9

/-- If the intermediate field `K` of `E / F` is generated as a field by a set `S ⊆ E`,
then the transcendence degree of `K` over `F` is at most the cardinality of `S`. -/
theorem trdeg_le_cardinalMk_of_adjoin_eq {F E : Type*} [Field F] [Field E] [Algebra F E]
    {K : IntermediateField F E} {S : Set E} (hKS : adjoin F S = K) :
    Algebra.trdeg F K ≤ Cardinal.mk S := by
  have hrange : S ⊆ Set.range (Subtype.val : K → E) := by
    simpa [Subtype.range_coe] using hKS ▸ subset_adjoin F S
  have himg : (Subtype.val '' (Subtype.val ⁻¹' S) : Set E) = S :=
    Set.image_preimage_eq_of_subset hrange
  have htop : adjoin F (Subtype.val ⁻¹' S : Set K) = ⊤ := by
    refine (IntermediateField.lift_inj _ _).mp ?_
    rw [lift_adjoin, lift_top, himg, hKS]
  have halg : Algebra.IsAlgebraic (Algebra.adjoin F (Subtype.val ⁻¹' S : Set K)) K := by
    rw [← isAlgebraic_adjoin_iff_top, htop]
    infer_instance
  refine (Algebra.IsAlgebraic.trdeg_le_cardinalMk F (Subtype.val ⁻¹' S : Set K)).trans_eq ?_
  exact Cardinal.mk_preimage_of_injective_of_subset_range _ _ Subtype.val_injective hrange

end Stacks.Examples.Stacks09I9

open Stacks.Examples.Stacks09I9 in
/-- **Stacks 09I9**.
The transcendence degree of `ℚ(e, π)` over `ℚ` is either `1` or `2`.

The lower bound needs transcendence of `π`, which is `transcendental_pi` (Tag 09I8). -/
@[stacks 09I9]
theorem trdeg_exp_1_pi :
    Algebra.trdeg ℚ (ℚ⟮rexp 1, π⟯) = 1 ∨ Algebra.trdeg ℚ (ℚ⟮rexp 1, π⟯) = 2 := by
  -- Upper bound: the field is generated by the two-element set `{e, π}`.
  have hub : Algebra.trdeg ℚ ℚ⟮rexp 1, π⟯ ≤ 2 := by
    refine (trdeg_le_cardinalMk_of_adjoin_eq (S := {rexp 1, π}) rfl).trans ?_
    refine Cardinal.mk_insert_le.trans ?_
    simp [one_add_one_eq_two]
  -- Lower bound: `π`, viewed in `ℚ(e, π)`, is a transcendental element.
  have hpimem : π ∈ ℚ⟮rexp 1, π⟯ := subset_adjoin ℚ _ (by simp)
  have htr : Transcendental ℚ (⟨π, hpimem⟩ : ℚ⟮rexp 1, π⟯) := fun h =>
    transcendental_pi (IntermediateField.isAlgebraic_iff.mp h)
  have hlb : (1 : Cardinal) ≤ Algebra.trdeg ℚ ℚ⟮rexp 1, π⟯ := by
    simpa [Cardinal.mk_fin] using
      (algebraicIndependent_iff_transcendental.mpr htr).cardinalMk_le_trdeg
  -- A cardinal at most `2` is a natural number, so the two bounds pin it down.
  obtain ⟨n, hn⟩ := Cardinal.lt_aleph0.mp (lt_of_le_of_lt hub (by simp))
  rw [hn] at hub hlb ⊢
  have h1 : 1 ≤ n := by exact_mod_cast hlb
  have h2 : n ≤ 2 := by exact_mod_cast hub
  have hcases : n = 1 ∨ n = 2 := by omega
  rcases hcases with h | h <;> subst h
  · exact Or.inl (by norm_num)
  · exact Or.inr (by norm_num)
