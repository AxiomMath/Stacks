module

public import Mathlib.Algebra.Order.Star.Real
public import Mathlib.Analysis.CStarAlgebra.Classes
public import Mathlib.Analysis.InnerProductSpace.Basic
public import Mathlib.FieldTheory.KummerPolynomial
public import Mathlib.RingTheory.SimpleRing.Principal

/-! `ℂ ≅ ℝ[x]/(x² + 1)` -/

@[expose] public section

open Polynomial Complex

/-- **Stacks 09FI**.
For any field `K`, the polynomial ring `K[X]` is an integral domain and a principal ideal ring.
Together with the fact that an ideal generated by an irreducible element of a PID is maximal,
this is the construction by which `K[X]/(P)` is a field for `P` irreducible. -/
@[stacks 09FI "second part"]
theorem polynomial_PID_of_field (K : Type*) [Field K] : IsDomain K[X] ∧ IsPrincipalIdealRing K[X] :=
  ⟨inferInstance, inferInstance⟩

/-- `ℂ` has a basis over `ℝ` given by powers of `I` with exponent less than two. -/
@[simps] noncomputable def PowerBasis.realComplex : PowerBasis ℝ ℂ where
  gen := I
  dim := 2
  basis := basisOneI
  basis_eq_pow := by simp

/-- The polynomial `X^2 + 1` is irreducible over `ℝ`. -/
theorem Real.irreducible_X_sq_add_one : Irreducible (X ^ 2 + 1 : ℝ[X]) := by
  rw [← C_1, ← neg_neg 1, map_neg, ← sub_eq_add_neg,
    X_pow_sub_C_irreducible_iff_of_prime Nat.prime_two]
  intro x
  nlinarith

@[simp] theorem Complex.minpoly_I : minpoly ℝ I = X ^ 2 + 1 := .symm <|
  minpoly.eq_of_irreducible_of_monic Real.irreducible_X_sq_add_one (by simp)
    (monic_X_pow_add_C _ (by grind))

/-- **Stacks 09FI**.
The complex numbers are realized as the quotient of `ℝ[X]` by the maximal ideal `(X^2 + 1)`,
expressed as the `ℝ`-algebra isomorphism `AdjoinRoot (X^2 + 1) ≃ₐ[ℝ] ℂ`. -/
@[stacks 09FI "fifth part"]
noncomputable def Complex.adjoinRootAlgEquiv : AdjoinRoot (X ^ 2 + 1 : ℝ[X]) ≃ₐ[ℝ] ℂ :=
  AdjoinRoot.equiv' _ PowerBasis.realComplex (by simp) (by simp)
