module

public import Mathlib.Topology.Bases

/-!
# The topology generated by a subbasis

Stacks 08ZJ says that any collection `B` of subsets of a set `X` is a subbasis for exactly one
topology on `X`, i.e. there is exactly one topology on `X` for which the finite intersections of
members of `B` form a topological basis. That topology is `TopologicalSpace.generateFrom B`, so the
tag splits into the two halves recorded here, with the topology named rather than hidden inside an
existential.

## Main results

* `TopologicalSpace.isTopologicalBasis_sInter_image_generateFrom`: the finite intersections of
  members of `B` form a topological basis for `TopologicalSpace.generateFrom B`. This is the
  existence half.
* `TopologicalSpace.eq_generateFrom_of_isTopologicalBasis_sInter_image`: any topology for which
  the finite intersections of members of `B` form a basis equals `TopologicalSpace.generateFrom B`.

## References

* [Stacks Project, Tag 08ZJ](https://stacks.math.columbia.edu/tag/08ZJ)
-/

@[expose] public section

open Set

namespace TopologicalSpace

/-- The sets `⋂₀ f`, for `f` a finite subcollection of a collection `B` of subsets of `X`, form a
topological basis for the topology generated by `B`. -/
@[stacks 08ZJ "existence"]
theorem isTopologicalBasis_sInter_image_generateFrom {X : Type*} (B : Set (Set X)) :
    @IsTopologicalBasis X (generateFrom B)
      ((fun f => ⋂₀ f) '' { f : Set (Set X) | f.Finite ∧ f ⊆ B }) :=
  @isTopologicalBasis_of_subbasis X (generateFrom B) B rfl

/-- If the finite intersections of a collection `B` form a basis for a topology `t`, then `t`
is the topology generated by `B`. -/
@[stacks 08ZJ "uniqueness"]
theorem eq_generateFrom_of_isTopologicalBasis_sInter_image {X : Type*}
    {t : TopologicalSpace X} {B : Set (Set X)}
    (hB : @IsTopologicalBasis X t
      ((fun f => ⋂₀ f) '' { f : Set (Set X) | f.Finite ∧ f ⊆ B })) :
    t = generateFrom B :=
  (@IsTopologicalBasis.eq_generateFrom X t _ hB).trans
    (@IsTopologicalBasis.eq_generateFrom X (generateFrom B) _
      (isTopologicalBasis_sInter_image_generateFrom B)).symm

end TopologicalSpace
