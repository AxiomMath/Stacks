module

public import Mathlib.Topology.Bases
import StacksCore.Tactic.StacksAttribute

/-!
# The topology generated by a collection of subsets

Stacks 0D5P says that a collection `B` of subsets of a set `X` which covers `X` and which refines
its own pairwise intersections is a basis for exactly one topology on `X`. That topology is
`TopologicalSpace.generateFrom B`, so the tag splits into the two halves recorded here, with the
topology named rather than hidden inside an existential.

## Main results

* `TopologicalSpace.isTopologicalBasis_generateFrom`: `B` is a topological basis for
  `TopologicalSpace.generateFrom B`. This is the existence half.
* Uniqueness is Mathlib's `TopologicalSpace.IsTopologicalBasis.eq_generateFrom`: any topology for
  which `B` is a basis equals `TopologicalSpace.generateFrom B`.

## References

* [Stacks Project, Tag 0D5P](https://stacks.math.columbia.edu/tag/0D5P)
-/

@[expose] public section

open Set

namespace TopologicalSpace

/-- A collection `B` of subsets of `X` which covers `X` and which refines its own pairwise
intersections is a topological basis for the topology it generates. The intersection condition
requires that, for all `B₁, B₂ ∈ B` and `x ∈ B₁ ∩ B₂`, some `B₃ ∈ B` satisfies
`x ∈ B₃` and `B₃ ⊆ B₁ ∩ B₂`. -/
@[stacks 0D5P "existence"]
theorem isTopologicalBasis_generateFrom {X : Type*} {B : Set (Set X)}
    (hcov : ⋃₀ B = univ)
    (hinter : ∀ B₁ ∈ B, ∀ B₂ ∈ B, ∀ x ∈ B₁ ∩ B₂, ∃ B₃ ∈ B, x ∈ B₃ ∧ B₃ ⊆ B₁ ∩ B₂) :
    @IsTopologicalBasis X (generateFrom B) B :=
  @IsTopologicalBasis.mk X (generateFrom B) B hinter hcov rfl

end TopologicalSpace

add_to_stacks 0D5P "uniqueness" TopologicalSpace.IsTopologicalBasis.eq_generateFrom
