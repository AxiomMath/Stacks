module

public import Mathlib.Tactic.SuppressCompilation
public import StacksCore.Algebra.Module.LocalizedModule.Basic

/-! # Iterated localization of modules

For a commutative semiring `R`, multiplicative subsets `S, S' ⊆ R` and an `R`-module `M`,
localizing `M` at the multiplicative set generated by `S` and `S'` is the same as first
localizing `M` at `S'` and then localizing the result, viewed as an `R`-module, at `S`:
`(S ⊔ S')⁻¹M ≅ S⁻¹(S'⁻¹M)`.  Since `S ⊔ S'` is exactly the set of products `s * s'` with
`s ∈ S` and `s' ∈ S'` (`Submonoid.mem_sup`), this is Stacks 02C7, whose multiplicative set
`SS'` is spelled `S ⊔ S'` here.

The equivalence is obtained by showing that the composite of the two canonical maps
`M → S'⁻¹M → S⁻¹(S'⁻¹M)` satisfies the universal property of the localization of `M` at
`S ⊔ S'` (`IsLocalizedModule`), so that `IsLocalizedModule.iso` produces the equivalence.
-/

@[expose] public section

suppress_compilation

universe u v

variable {R : Type u} [CommSemiring R] (S S' : Submonoid R)
variable {M : Type v} [AddCommMonoid M] [Module R M]

namespace LocalizedModule

variable (M) in
/-- The canonical map `M → S⁻¹(S'⁻¹M)`, the composite of the two localization maps. -/
noncomputable def doubleMkLinearMap : M →ₗ[R] LocalizedModule S (LocalizedModule S' M) :=
  mkLinearMap S (LocalizedModule S' M) ∘ₗ mkLinearMap S' M

@[simp, grind =]
theorem doubleMkLinearMap_apply (m : M) :
    doubleMkLinearMap S S' M m = mk (mk m 1) 1 := by
  simp [doubleMkLinearMap]

instance : IsLocalizedModule (S ⊔ S') (doubleMkLinearMap S S' M) where
  map_units x := by
    obtain ⟨t, ht, t', ht', hx⟩ := Submonoid.mem_sup.mp x.2
    rw [← hx, map_mul]
    exact (IsLocalizedModule.map_units (mkLinearMap S (LocalizedModule S' M)) ⟨t, ht⟩).mul <|
      isUnit_algebraMap_end_of_isUnit S <| IsLocalizedModule.map_units (mkLinearMap S' M) ⟨t', ht'⟩
  surj z := by
    induction z with | h y s => induction y with | h m s' =>
    refine ⟨(m, ⟨(s : R) * (s' : R), mul_mem (Submonoid.mem_sup_left s.2)
      (Submonoid.mem_sup_right s'.2)⟩), ?_⟩
    rw [Submonoid.mk_smul, mul_smul, smul'_mk, smul'_mk, smul'_mk, mk_cancel', mk_cancel',
      doubleMkLinearMap_apply]
  exists_of_eq {m m'} h := by
    simp only [doubleMkLinearMap_apply] at h
    obtain ⟨u, hu⟩ := mk_eq.mp h
    simp only [one_smul, Submonoid.smul_def, smul'_mk] at hu
    obtain ⟨u', hu'⟩ := mk_eq.mp hu
    refine ⟨⟨(u' : R) * (u : R),
      mul_mem (Submonoid.mem_sup_right u'.2) (Submonoid.mem_sup_left u.2)⟩, ?_⟩
    simpa [Submonoid.smul_def, mul_smul] using hu'

variable (M) in
/-- **Stacks 02C7.**  Iterated localization of modules: for multiplicative subsets
`S, S' ⊆ R` and an `R`-module `M`, the localization of `M` at the multiplicative set
`SS' = S ⊔ S'` is the localization at `S` of the `R`-module `S'⁻¹M`. -/
@[stacks 02C7]
noncomputable def equivLocalizedModuleLocalizedModule :
    LocalizedModule (S ⊔ S') M ≃ₗ[R] LocalizedModule S (LocalizedModule S' M) :=
  IsLocalizedModule.iso (S ⊔ S') (doubleMkLinearMap S S' M)

end LocalizedModule
