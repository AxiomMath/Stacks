module

public import Mathlib.LinearAlgebra.Matrix.Adjugate
public import Mathlib.RingTheory.Ideal.Operations

/-! # The ideal generated by the maximal minors of a matrix

For `A : Matrix n m R` over a commutative ring, `Matrix.minorIdeal A` is the ideal generated by
the determinants of the square submatrices `A.submatrix r id` obtained by selecting one row of
`A` for each column index. When `A` has at least as many rows as columns these are exactly the
maximal minors of `A`; in general the selections that repeat a row contribute `0`, so nothing is
lost by ranging over all of `r : m → n` rather than over injections.

## Main results

* `Matrix.det_mul_eq_sum_prod_mul_det_submatrix`: the determinant of a product of an `m × n` and
  an `n × m` matrix, expanded over the ways of choosing a row of the right factor for each row of
  the product. This is the Cauchy–Binet formula before the terms are collected by image.
* `Matrix.exists_mul_eq_smul_one_of_mem_minorIdeal` and `Matrix.pow_card_mem_minorIdeal`: the two
  halves of Stacks 07DQ, saying that `A.minorIdeal` and the scalars `f` for which `f • 1` factors
  as `B * A` determine each other up to radicals; `Matrix.mem_radical_minorIdeal_iff` packages
  them as a single equivalence.
-/

@[expose] public section

namespace Matrix

variable {R : Type*} [CommRing R] {m n : Type*} [Fintype m] [DecidableEq m]

/-- The ideal generated by the maximal minors of `A : Matrix n m R`, that is, by the determinants
of the square submatrices `A.submatrix r id` picking out one row of `A` for each column index. -/
def minorIdeal (A : Matrix n m R) : Ideal R :=
  Ideal.span (Set.range fun r : m → n => (A.submatrix r id).det)

theorem det_submatrix_mem_minorIdeal (A : Matrix n m R) (r : m → n) :
    (A.submatrix r id).det ∈ A.minorIdeal :=
  Ideal.subset_span ⟨r, rfl⟩

/-- Selections repeating a row contribute nothing, so `Matrix.minorIdeal` is indeed generated by
the minors of `A` proper. -/
theorem minorIdeal_eq_span_range_embedding (A : Matrix n m R) :
    A.minorIdeal = Ideal.span (Set.range fun r : m ↪ n => (A.submatrix r id).det) := by
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_le.2 ?_)
  · rintro _ ⟨r, rfl⟩
    by_cases hr : Function.Injective r
    · exact Ideal.subset_span ⟨⟨r, hr⟩, rfl⟩
    · obtain ⟨j, k, hjk, hne⟩ := Function.not_injective_iff.1 hr
      change (A.submatrix r id).det ∈ _
      rw [det_zero_of_row_eq hne (funext fun c => by simp [hjk])]
      exact Ideal.zero_mem _
  · rintro _ ⟨r, rfl⟩
    exact det_submatrix_mem_minorIdeal A r

variable [Fintype n]

/-- Expanding the determinant of `B * A` along the rows of `A`. Each row of `B * A` is the
combination of the rows of `A` with coefficients from the corresponding row of `B`, so
multilinearity of the determinant expresses `(B * A).det` as a sum over all the ways `r : m → n`
of choosing a row of `A` for each row of `B * A`. This is the Cauchy–Binet formula, before the
terms are collected according to the image of `r`. -/
theorem det_mul_eq_sum_prod_mul_det_submatrix (B : Matrix m n R) (A : Matrix n m R) :
    (B * A).det = ∑ r : m → n, (∏ j, B j (r j)) * (A.submatrix r id).det := by
  have hBA : ((B * A) : Matrix m m R) = fun j => ∑ i : n, B j i • A i := by
    ext j k; simp [mul_apply]
  rw [show (B * A).det
      = (detRowAlternating : (m → R) [⋀^m]→ₗ[R] R).toMultilinearMap (B * A) from rfl, hBA,
    MultilinearMap.map_sum]
  refine Finset.sum_congr rfl fun r _ => ?_
  rw [(detRowAlternating : (m → R) [⋀^m]→ₗ[R] R).toMultilinearMap.map_smul_univ, smul_eq_mul]
  rfl

/-- **Stacks 07DQ (1)**: every element of the ideal of maximal minors of `A` is realised as a
scalar left inverse of `A`. -/
@[stacks 07DQ "(1)"]
theorem exists_mul_eq_smul_one_of_mem_minorIdeal {A : Matrix n m R} {f : R}
    (hf : f ∈ A.minorIdeal) : ∃ B : Matrix m n R, B * A = f • 1 := by
  classical
  refine Submodule.span_induction ?_ ⟨0, by simp⟩ ?_ ?_ hf
  · rintro _ ⟨r, rfl⟩
    have hE : ((1 : Matrix n n R).submatrix r id) * A = A.submatrix r id := by
      ext j k; simp [mul_apply, one_apply]
    exact ⟨adjugate (A.submatrix r id) * (1 : Matrix n n R).submatrix r id, by
      rw [Matrix.mul_assoc, hE, adjugate_mul]⟩
  · rintro x y - - ⟨B₁, h₁⟩ ⟨B₂, h₂⟩
    exact ⟨B₁ + B₂, by rw [Matrix.add_mul, h₁, h₂, add_smul]⟩
  · rintro a x - ⟨B, h⟩
    exact ⟨a • B, by rw [Matrix.smul_mul, h, smul_smul, smul_eq_mul]⟩

/-- The determinant of any product `B * A` lies in the ideal of maximal minors of `A`. -/
theorem det_mul_mem_minorIdeal (B : Matrix m n R) (A : Matrix n m R) :
    (B * A).det ∈ A.minorIdeal := by
  rw [det_mul_eq_sum_prod_mul_det_submatrix]
  exact Submodule.sum_mem _ fun r _ => Ideal.mul_mem_left _ _ (det_submatrix_mem_minorIdeal A r)

/-- **Stacks 07DQ (2)**: a scalar left inverse of `A` lies in the ideal of maximal minors of `A`
after raising it to the number of columns of `A`. -/
@[stacks 07DQ "(2)"]
theorem pow_card_mem_minorIdeal {A : Matrix n m R} {B : Matrix m n R} {f : R}
    (h : B * A = f • 1) : f ^ Fintype.card m ∈ A.minorIdeal := by
  have := det_mul_mem_minorIdeal B A
  rwa [h, det_smul, det_one, mul_one] at this

/-- **Stacks 07DQ**, both parts at once: the radical of the ideal of maximal minors of `A` is
exactly the set of scalars some power of which admits a left inverse against `A`. -/
@[stacks 07DQ]
theorem mem_radical_minorIdeal_iff {A : Matrix n m R} {f : R} :
    f ∈ A.minorIdeal.radical ↔ ∃ k : ℕ, ∃ B : Matrix m n R, B * A = (f ^ k) • 1 := by
  refine ⟨fun ⟨k, hk⟩ => ⟨k, exists_mul_eq_smul_one_of_mem_minorIdeal hk⟩, ?_⟩
  rintro ⟨k, B, hB⟩
  exact ⟨k * Fintype.card m, by rw [pow_mul]; exact pow_card_mem_minorIdeal hB⟩

end Matrix
