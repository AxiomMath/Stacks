module

public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
import StacksCore.GroupTheory.Index

/-! # Basic facts about cyclic groups -/

@[expose] public section

open Subgroup

/-- For `g : G` and `m n : ℕ`, the element `g ^ gcd m n` lies in `⟨g ^ n⟩` iff `g ^ m` does. -/
theorem pow_gcd_mem_zpowers_pow_iff {G : Type*} [Group G] (g : G) (m n : ℕ) :
    g ^ m.gcd n ∈ zpowers (g ^ n) ↔ g ^ m ∈ zpowers (g ^ n) := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · rw [← Nat.mul_div_cancel' (m.gcd_dvd_left n), pow_mul]
    exact pow_mem h _
  · rw [← zpow_natCast g (m.gcd n), Nat.gcd_eq_gcd_ab, zpow_add]
    simp_rw [zpow_mul, zpow_natCast]
    exact mul_mem (zpow_mem h _) (zpow_mem (by simp) _)

/-- Characterization of when `g ^ m` lies in the subgroup `⟨g ^ n⟩` generated by `g ^ n`, in
terms of an arithmetic identity on `gcd`, `lcm`, and `orderOf g`. -/
theorem pow_mem_zpowers_pow_iff {G : Type*} [Group G] (g : G) (m n : ℕ) :
    g ^ m ∈ zpowers (g ^ n) ↔ n.gcd ((orderOf g).lcm (m.gcd n)) = m.gcd n := by
  rw [← pow_gcd_mem_zpowers_pow_iff]
  nth_rw 1 [← Nat.mul_div_cancel' (m.gcd_dvd_right n), pow_mul, mem_zpowers_pow_iff]
  obtain h | h := eq_or_ne (m.gcd n) 0
  · rw [Nat.gcd_eq_zero_iff] at h
    simp [h]
  rw [orderOf_pow' _ h, ← Nat.mul_left_inj h, ← Nat.gcd_mul_right,
    Nat.div_mul_cancel (m.gcd_dvd_right n), Nat.div_mul_right_comm (Nat.gcd_dvd_left _ _),
    ← Nat.lcm_eq_mul_div, one_mul]

/-- When `n` divides the order of `g`, the element `g ^ m` lies in `⟨g ^ n⟩` iff `n ∣ m`. -/
theorem pow_mem_zpowers_pow_iff_of_dvd {G : Type*} [Group G] {g : G}
    {n : ℕ} (hn : n ∣ orderOf g) (m : ℕ) : g ^ m ∈ zpowers (g ^ n) ↔ n ∣ m := by
  rw [pow_mem_zpowers_pow_iff, Nat.lcm_eq_left ((m.gcd_dvd_right n).trans hn),
    Nat.gcd_eq_left hn, eq_comm, Nat.gcd_eq_right_iff_dvd]

namespace IsCyclic

/-- If `gen` generates `G`, its image in `G ⧸ S` has order `S.index`. -/
private theorem orderOf_mk_eq_index {G : Type*} [Group G] [IsCyclic G] {gen : G}
    (hgen : ∀ x, x ∈ zpowers gen) (S : Subgroup G) : orderOf (gen : G ⧸ S) = S.index := by
  rw [index]
  refine orderOf_eq_card_of_forall_mem_zpowers fun x ↦ ?_
  obtain ⟨y, rfl⟩ := QuotientGroup.mk_surjective x
  obtain ⟨k, rfl⟩ := hgen y
  simp

/-- In a cyclic group with generator `gen`, the subgroup `⟨gen ^ n⟩` has index `n` whenever
`n` divides the order of `gen`. -/
theorem index_zpowers_pow {G : Type*} [Group G] [IsCyclic G]
    {gen : G} (hgen : ∀ x, x ∈ Subgroup.zpowers gen) {n : ℕ} (hn : n ∣ orderOf gen) :
    (zpowers (gen ^ n)).index = n := by
  obtain rfl | hn0 := n.eq_zero_or_pos
  · rw [pow_zero, zpowers_one_eq_bot, index_bot, ← zero_dvd_iff]
    exact hn.trans <| orderOf_dvd_natCard _
  rw [← orderOf_mk_eq_index hgen]
  refine (orderOf_eq_iff hn0).mpr ⟨?_, ?_⟩
  · simp [← QuotientGroup.mk_pow]
  · rintro m hmn hm
    simpa [← QuotientGroup.mk_pow, pow_mem_zpowers_pow_iff_of_dvd hn]
      using Nat.not_dvd_of_pos_of_lt hm hmn

/-- Every subgroup `S` of a cyclic group with generator `gen` is generated by `gen ^ [G : S]`. -/
theorem subgroup_eq_zpowers_index {G : Type*} [Group G] [IsCyclic G]
    {gen : G} (hgen : ∀ x, x ∈ Subgroup.zpowers gen) (S : Subgroup G) :
    .zpowers (gen ^ S.index) = S := by
  obtain hS | hS := eq_or_ne S.index 0
  · rw [hS, pow_zero, zpowers_one_eq_bot, eq_comm, eq_bot_iff_forall]
    rintro x hx
    obtain ⟨i, hi : _ ^ _ = _⟩ := hgen x
    obtain hi0 | hi0 := eq_or_ne i 0
    · simp [← hi, hi0]
    · have : (gen : G ⧸ S) ^ i.natAbs = 1 := by
        rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
        obtain ⟨i, rfl | rfl⟩ := i.eq_nat_or_neg <;> simp_all [← hi, -hi]
      rw [← orderOf_dvd_iff_pow_eq_one, orderOf_mk_eq_index hgen, hS, zero_dvd_iff] at this
      exact (i.natAbs_ne_zero.mpr hi0 this).elim
  have hsi : S.index ∣ orderOf gen := by
    simpa [orderOf_eq_card_of_forall_mem_zpowers hgen] using S.index_dvd_card
  have : (zpowers (gen ^ S.index)).FiniteIndex := ⟨by rwa [index_zpowers_pow hgen hsi]⟩
  refine eq_of_le_of_index_le (zpowers_le_of_mem ?_) ?_
  · rw [← QuotientGroup.eq_one_iff, QuotientGroup.mk_pow]
    exact pow_card_eq_one'
  · rw [index_zpowers_pow hgen hsi]

/-- Subgroups of a cyclic group are determined by their index. -/
theorem ext_subgroup_index {G : Type*} [Group G] [IsCyclic G]
    {S₁ S₂ : Subgroup G} (hS : S₁.index = S₂.index) : S₁ = S₂ := by
  obtain ⟨gen, hgen⟩ := IsCyclic.exists_generator (α := G)
  rw [← subgroup_eq_zpowers_index hgen S₁, hS, subgroup_eq_zpowers_index hgen]

/-- Subgroups of a finite cyclic group are determined by their cardinality. -/
theorem ext_subgroup_card {G : Type*} [Group G] [IsCyclic G] [Finite G]
    {S₁ S₂ : Subgroup G} (hS : Nat.card S₁ = Nat.card S₂) : S₁ = S₂ := by
  refine ext_subgroup_index ?_
  have hS₁ : 0 < Nat.card S₁ := Nat.card_pos
  rw [← Nat.mul_left_inj hS₁.ne', index, ← card_eq_card_quotient_mul_card_subgroup,
    hS, index, ← card_eq_card_quotient_mul_card_subgroup]

/-- In a cyclic group, `[G : S₁]` divides `[G : S₂]` iff `S₂ ≤ S₁`. -/
theorem index_dvd_iff_ge {G : Type*} [Group G] [IsCyclic G] (S₁ S₂ : Subgroup G) :
    S₁.index ∣ S₂.index ↔ S₂ ≤ S₁ := by
  obtain ⟨gen, hgen⟩ := IsCyclic.exists_generator (α := G)
  nth_rw 2 [← subgroup_eq_zpowers_index hgen S₁, ← subgroup_eq_zpowers_index hgen S₂]
  rw [zpowers_le, pow_mem_zpowers_pow_iff_of_dvd]
  rw [orderOf_eq_card_of_forall_mem_zpowers hgen]
  exact S₁.index_dvd_card

/-- In a finite cyclic group, `|S₁|` divides `|S₂|` iff `S₁ ≤ S₂`. -/
theorem card_dvd_iff_le {G : Type*} [Group G] [Finite G] [IsCyclic G] (S₁ S₂ : Subgroup G) :
    Nat.card S₁ ∣ Nat.card S₂ ↔ S₁ ≤ S₂ := by
  rw [← index_dvd_iff_ge, index, index]
  nth_rw 2 [← mul_dvd_mul_iff_left (Nat.card_pos (α := S₁)).ne',
    ← mul_dvd_mul_iff_right (Nat.card_pos (α := S₂)).ne']
  rw [mul_assoc, ← card_eq_card_quotient_mul_card_subgroup, mul_comm _ (Nat.card (G ⧸ S₁)),
    ← card_eq_card_quotient_mul_card_subgroup, mul_comm,
    mul_dvd_mul_iff_left Nat.card_pos.ne']

end IsCyclic
