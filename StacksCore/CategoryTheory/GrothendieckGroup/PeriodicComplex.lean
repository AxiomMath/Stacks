module

import Mathlib.CategoryTheory.Limits.FullSubcategory
public import Mathlib.CategoryTheory.ObjectProperty.FiniteProducts
import StacksCore.Algebra.FreeAbelianGroup.Finsupp
import StacksCore.Algebra.Homology.ShortComplex.Preadditive
import StacksCore.CategoryTheory.GrothendieckGroup.Abelian
public import StacksCore.CategoryTheory.GrothendieckGroup.Basic

/-! # 2-periodic complexes and the Grothendieck group: Stacks 02MX (2)

Let `𝒜` be an abelian category, `𝒞 ⊂ 𝒜` a Serre subcategory and `ℬ = 𝒜/𝒞`. Stacks 02MX (2)
says that the kernel of `K₀(𝒞) → K₀(𝒜)` consists of the classes `[H⁰(M, φ, ψ)] - [H¹(M, φ, ψ)]`
of the 2-periodic complexes `⋯ → M --φ--> M --ψ--> M --φ--> M → ⋯` in `𝒜` (Stacks 02MW) that
become exact in `ℬ`, that is, whose homology objects `H⁰ = Ker ψ / Im φ` and `H¹ = Ker φ / Im ψ`
lie in `𝒞`. In Lean, `𝒜` is an abelian category `A` and `𝒞` is a property `P : ObjectProperty A`;
a 2-periodic complex is a pair `φ ψ : M ⟶ M` with `φ ≫ ψ = 0` and `ψ ≫ φ = 0`, and `H⁰` and
`H¹` are `(ShortComplex.mk φ ψ _).homology` and `(ShortComplex.mk ψ φ _).homology`.

## Main results

* `GrothendieckGroup.of_eq_of_iff_exists_homology_iso`, the *realisation theorem*: two objects
  `X` and `Y` of `A` have the same class in `K₀(A)` if and only if there is a 2-periodic
  complex `(M, φ, ψ)` in `A` with `H⁰ ≅ X` and `H¹ ≅ Y`. No subcategory is involved. It is the
  key step of 02MX (2), and the form in which Stacks 02SC uses it.
* `GrothendieckGroup.map_ι_eq_zero_iff`, 02MX (2) itself, for any property of objects `P` that
  contains `0` and is closed under binary products (hence under isomorphisms), and for any proof
  `hι` that the inclusion `P.ι` preserves short exact sequences: `map P.ι hι x = 0` if and only if
  `x = [H⁰] - [H¹]` for a 2-periodic complex in `A` whose homology objects satisfy `P`.

In Stacks' case of a Serre class `P`, the second result reads
`map_ι_eq_zero_iff P P.shortExact_map_ι x`, with `ObjectProperty.shortExact_map_ι` from
`StacksCore.CategoryTheory.Abelian.Subcategory` and the instance `P.IsClosedUnderBinaryProducts`
from `StacksCore.CategoryTheory.Abelian.SerreClass.Basic`; the same term works for a weak
Serre class. For a Serre class, `ObjectProperty.SerreClassLocalization.exact_map_iff`, applied
to `ShortComplex.mk φ ψ _` and to `ShortComplex.mk ψ φ _`, identifies "`H⁰` and `H¹` satisfy `P`"
with Stacks' "`(M, φ, ψ)` becomes exact in `𝒜/𝒞`".

## Proof

The classes `[H⁰] - [H¹]` vanish in `K₀(A)` by `of_homology_eq_of_homology`. Conversely, let
`[X] = [Y]`. Then `[Y] - [X]`, taken in the free abelian group on the objects, lies in the
subgroup generated by the relations `[S.X₂] - [S.X₁] - [S.X₃]` of the short exact sequences `S`
(`of_eq_of_iff`), and an induction over that subgroup carries a *certificate*: a `ℤ/2`-graded
complex `d₀ : X₀ ⟶ X₁`, `d₁ : X₁ ⟶ X₀` that is exact in both degrees, together with two lists of
objects (the atoms) `u` and `v` such that the element is `Σ u - Σ v` and `X₀ ≅ ⊞ v`,
`X₁ ≅ ⊞ u`. The relation of `S` has the certificate `S.X₁ ⊞ S.X₃ ⇄ S.X₂`, with
`d₀ = fst ≫ S.f` and `d₁ = S.g ≫ inr`; `0` has `0 ⇄ 0` with empty lists, a sum has the biproduct
of the two certificates, and a negative swaps the two degrees. From `[Y] - [X] = Σ u - Σ v`, the
lists `Y :: v` and `X :: u` are permutations of each other
(`FreeAbelianGroup.list_sum_map_of_eq_list_sum_map_of_iff_perm`), so `Y ⊞ X₀ ≅ X ⊞ X₁`. The
biproduct of the complex `Y ⇄ X` with zero maps and the certificate is a complex
`Y ⊞ X₀ ⇄ X ⊞ X₁` with homology `X` at `X ⊞ X₁` and `Y` at `Y ⊞ X₀`, and transporting it along
`Y ⊞ X₀ ≅ X ⊞ X₁` gives a 2-periodic complex on `M = Y ⊞ X₀` with `H⁰ ≅ X` and `H¹ ≅ Y`. The
lists and the permutation play the role of Stacks' index sets `T⁺`, `T⁻` and bijection `τ`; only
binary biproducts occur.

Stacks' written proof ends with `P ≅ Ker φ / Im ψ = H¹` and `Q ≅ Ker ψ / Im φ = H⁰` for
`x = [P] - [Q]`, so the complex it builds has `[H⁰] - [H¹] = -x`. This sign slip is harmless,
since swapping `φ` and `ψ` swaps `H⁰` and `H¹`; here `H⁰ ≅ X` holds by construction, and the
sign is the one in the statement.

## Implementation notes

The auxiliary declarations are private. The biproduct `listBiprod l = X₁ ⊞ (X₂ ⊞ ⋯ ⊞ (Xₙ ⊞ 0))`
of a list of objects is used through its rfl-lemmas `listBiprod_nil` and `listBiprod_cons`, and
only in private lemmas, so no exposed declaration refers to it. Each auxiliary lemma assumes only
the classes its proof uses: the realisation direction holds in any preadditive category with a
zero object, binary biproducts and homology, and `[Abelian A]` enters through
`of_homology_eq_of_homology`. `map_ι_eq_zero_iff` does not assume that `P` is closed under
isomorphisms, since this follows: if `P X` and `X ≅ Y`, then `Y` is a product of a zero object
of `P` and `X`. The proof derives the instance locally, as Mathlib's `binaryProductsClosure_le_iff`
does with `IsClosedUnderBinaryProducts.closedUnderIsomorphisms`, the terminal-object form.
-/

@[expose] public section

universe v u

namespace CategoryTheory.GrothendieckGroup

open Limits ZeroObject

variable {A : Type u} [Category.{v} A]

/-! ### Biproducts of lists of objects -/

section ListBiprod

variable [HasZeroMorphisms A] [HasZeroObject A] [HasBinaryBiproducts A]

/-- The biproduct `X₁ ⊞ (X₂ ⊞ ⋯ ⊞ (Xₙ ⊞ 0))` of the objects of a list `[X₁, …, Xₙ]`. -/
private noncomputable def listBiprod : List A → A
  | [] => 0
  | X :: l => X ⊞ listBiprod l

/-- The biproduct of the empty list is `0`. -/
private lemma listBiprod_nil : listBiprod ([] : List A) = 0 := rfl

/-- The biproduct of `X :: l` is `X ⊞ listBiprod l`. -/
private lemma listBiprod_cons (X : A) (l : List A) :
    listBiprod (X :: l) = (X ⊞ listBiprod l) := rfl

/-- The biproduct of a concatenation of two lists is the biproduct of their biproducts. -/
private lemma nonempty_listBiprod_append_iso (l₁ l₂ : List A) :
    Nonempty (listBiprod (l₁ ++ l₂) ≅ listBiprod l₁ ⊞ listBiprod l₂) := by
  induction l₁ with
  | nil =>
    rw [List.nil_append, listBiprod_nil]
    exact ⟨isoZeroBiprod (isZero_zero A)⟩
  | cons X l ih =>
    obtain ⟨e⟩ := ih
    rw [List.cons_append, listBiprod_cons, listBiprod_cons]
    exact ⟨biprod.mapIso (Iso.refl X) e ≪≫ (biprod.associator _ _ _).symm⟩

/-- Two lists that are permutations of each other have isomorphic biproducts. -/
private lemma nonempty_listBiprod_iso_of_perm {l₁ l₂ : List A} (h : l₁.Perm l₂) :
    Nonempty (listBiprod l₁ ≅ listBiprod l₂) := by
  induction h with
  | nil => exact ⟨Iso.refl _⟩
  | cons X _ ih =>
    obtain ⟨e⟩ := ih
    rw [listBiprod_cons, listBiprod_cons]
    exact ⟨biprod.mapIso (Iso.refl X) e⟩
  | swap X Y l =>
    rw [listBiprod_cons, listBiprod_cons, listBiprod_cons, listBiprod_cons]
    exact ⟨(biprod.associator _ _ _).symm ≪≫ biprod.mapIso (biprod.braiding _ _) (Iso.refl _) ≪≫
      biprod.associator _ _ _⟩
  | trans _ _ ih₁ ih₂ =>
    obtain ⟨e₁⟩ := ih₁
    obtain ⟨e₂⟩ := ih₂
    exact ⟨e₁ ≪≫ e₂⟩

end ListBiprod

/-! ### Three auxiliary short complexes -/

/-- If `X₁ --f--> X₂ --g--> X₃` is exact, `e` is an epimorphism and `m` a monomorphism, then
`X₁' --e ≫ f--> X₂ --g ≫ m--> X₃'` is exact. -/
private lemma exact_mk_epi_comp_comp_mono [HasZeroMorphisms A] {X₁' X₁ X₂ X₃ X₃' : A}
    (e : X₁' ⟶ X₁) [Epi e] (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (m : X₃ ⟶ X₃') [Mono m]
    (hfg : f ≫ g = 0) (h : (ShortComplex.mk f g hfg).Exact) :
    (ShortComplex.mk (e ≫ f) (g ≫ m) (by simp [reassoc_of% hfg])).Exact := by
  have hfgm : f ≫ g ≫ m = 0 := by simp [reassoc_of% hfg]
  have h' := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono (S₁ := .mk f g hfg)
    (S₂ := .mk f (g ≫ m) hfgm) { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := m }).1 h
  exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono
    (S₁ := .mk (e ≫ f) (g ≫ m) (by simp [hfgm])) (S₂ := .mk f (g ≫ m) hfgm)
    { τ₁ := e, τ₂ := 𝟙 _, τ₃ := 𝟙 _ }).2 h'

/-- The short complex `Y --inr--> X ⊞ Y --fst--> X` is exact: it is split. -/
private lemma exact_inr_fst [Preadditive A] [HasZeroObject A] (X Y : A) [HasBinaryBiproduct X Y] :
    (ShortComplex.mk (biprod.inr : Y ⟶ X ⊞ Y) biprod.fst biprod.inr_fst).Exact :=
  ShortComplex.Splitting.exact
    { r := biprod.snd
      s := biprod.inl
      f_r := by simp
      s_g := by simp
      id := by simp [add_comm] }

/-- The homology of the short complex `X --0--> Y --0--> X` is `Y`. -/
private lemma nonempty_homology_zeros [HasZeroMorphisms A] (X Y : A) :
    Nonempty ((ShortComplex.mk (0 : X ⟶ Y) (0 : Y ⟶ X) comp_zero).homology ≅ Y) :=
  ⟨((ShortComplex.mk (0 : X ⟶ Y) (0 : Y ⟶ X) comp_zero).asIsoHomologyπ rfl).symm ≪≫
    ShortComplex.cyclesIsoX₂ _ rfl⟩

/-- The homology of a short complex isomorphic to `(0 : Y ⟶ X) ⊞ d` (with `d` exact) is `X`. -/
private lemma homology_iso_of_iso_biprod_zeros [Preadditive A] [HasBinaryBiproducts A]
    [CategoryWithHomology A] {X Y X₀ X₁ : A}
    (d : X₀ ⟶ X₁) (d' : X₁ ⟶ X₀)
    (w : d ≫ d' = 0) (h : (ShortComplex.mk d d' w).Exact)
    (W : biprod.map (0 : Y ⟶ X) d ≫ biprod.map (0 : X ⟶ Y) d' = 0) {S : ShortComplex A}
    (i : S ≅ .mk (biprod.map (0 : Y ⟶ X) d) (biprod.map (0 : X ⟶ Y) d') W) :
    Nonempty (S.homology ≅ X) := by
  obtain ⟨i₂⟩ := nonempty_homology_zeros Y X
  exact ⟨ShortComplex.homologyMapIso i ≪≫
    ShortComplex.homologyBiprodIso (.mk (0 : Y ⟶ X) (0 : X ⟶ Y) comp_zero) (.mk d d' w) ≪≫
    biprod.mapIso i₂ (Iso.refl _) ≪≫
    (isoBiprodZero ((ShortComplex.exact_iff_isZero_homology _).1 h)).symm⟩

/-! ### The certificate and the realisation -/

section Realisation

variable [Preadditive A] [HasZeroObject A] [HasBinaryBiproducts A] [CategoryWithHomology A]

/-- The certificate carried by the induction over the subgroup generated by the relations: every
element `y` of that subgroup is `Σ u - Σ v` for two lists of objects `u` and `v`, and there is a
`ℤ/2`-graded complex `d₀ : X₀ ⟶ X₁`, `d₁ : X₁ ⟶ X₀`, exact in both degrees, with `X₀ ≅ ⊞ v` and
`X₁ ≅ ⊞ u`. -/
private lemma exists_exact_of_mem_closure {y : FreeAbelianGroup A}
    (hy : y ∈ AddSubgroup.closure (relations A)) :
    ∃ (X₀ X₁ : A) (d₀ : X₀ ⟶ X₁) (d₁ : X₁ ⟶ X₀) (w₀ : d₀ ≫ d₁ = 0) (w₁ : d₁ ≫ d₀ = 0),
      (ShortComplex.mk d₀ d₁ w₀).Exact ∧ (ShortComplex.mk d₁ d₀ w₁).Exact ∧
      ∃ u v : List A, y = (u.map .of).sum - (v.map .of).sum ∧
        Nonempty (X₀ ≅ listBiprod v) ∧ Nonempty (X₁ ≅ listBiprod u) := by
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    cases hy with | @ofShortExact S hS => ?_
    have := hS.mono_f
    have := hS.epi_g
    refine ⟨S.X₁ ⊞ S.X₃, S.X₂, biprod.fst ≫ S.f, S.g ≫ biprod.inr, by simp, by simp,
      exact_mk_epi_comp_comp_mono _ _ _ _ S.zero hS.exact,
      exact_mk_epi_comp_comp_mono S.g biprod.inr biprod.fst S.f biprod.inr_fst
        (exact_inr_fst S.X₁ S.X₃),
      [S.X₂], [S.X₁, S.X₃], ?_, ?_, ?_⟩
    · simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      abel
    · rw [listBiprod_cons, listBiprod_cons, listBiprod_nil]
      exact ⟨biprod.mapIso (Iso.refl _) (isoBiprodZero (isZero_zero A))⟩
    · rw [listBiprod_cons, listBiprod_nil]
      exact ⟨isoBiprodZero (isZero_zero A)⟩
  | zero =>
    have e : Nonempty ((0 : A) ≅ listBiprod []) := by
      rw [listBiprod_nil]
      exact ⟨Iso.refl _⟩
    exact ⟨0, 0, 0, 0, comp_zero, comp_zero, ShortComplex.exact_of_isZero_X₂ _ (isZero_zero A),
      ShortComplex.exact_of_isZero_X₂ _ (isZero_zero A), [], [], by simp, e, e⟩
  | add y y' _ _ ih ih' =>
    obtain ⟨X₀, X₁, d₀, d₁, w₀, w₁, h₀, h₁, u, v, rfl, ⟨e₀⟩, ⟨e₁⟩⟩ := ih
    obtain ⟨X₀', X₁', d₀', d₁', w₀', w₁', h₀', h₁', u', v', rfl, ⟨e₀'⟩, ⟨e₁'⟩⟩ := ih'
    obtain ⟨a⟩ := nonempty_listBiprod_append_iso v v'
    obtain ⟨b⟩ := nonempty_listBiprod_append_iso u u'
    refine ⟨X₀ ⊞ X₀', X₁ ⊞ X₁', biprod.map d₀ d₀', biprod.map d₁ d₁',
      (ShortComplex.biprodMk (.mk d₀ d₁ w₀) (.mk d₀' d₁' w₀')).zero,
      (ShortComplex.biprodMk (.mk d₁ d₀ w₁) (.mk d₁' d₀' w₁')).zero,
      ShortComplex.exact_biprodMk h₀ h₀', ShortComplex.exact_biprodMk h₁ h₁',
      u ++ u', v ++ v', ?_, ⟨biprod.mapIso e₀ e₀' ≪≫ a.symm⟩, ⟨biprod.mapIso e₁ e₁' ≪≫ b.symm⟩⟩
    rw [List.map_append, List.map_append, List.sum_append, List.sum_append]
    abel
  | neg y _ ih =>
    obtain ⟨X₀, X₁, d₀, d₁, w₀, w₁, h₀, h₁, u, v, rfl, e₀, e₁⟩ := ih
    exact ⟨X₁, X₀, d₁, d₀, w₁, w₀, h₁, h₀, v, u, neg_sub _ _, e₁, e₀⟩

/-- The realisation: if `[X] = [Y]` in `K₀(A)`, there is a 2-periodic complex `(M, φ, ψ)` with
`H⁰ = Ker ψ / Im φ ≅ X` and `H¹ = Ker φ / Im ψ ≅ Y`. -/
private lemma exists_homology_iso_of_of_eq_of {X Y : A} (h : of X = of Y) :
    ∃ (M : A) (φ ψ : M ⟶ M) (hφψ : φ ≫ ψ = 0) (hψφ : ψ ≫ φ = 0),
      Nonempty ((ShortComplex.mk φ ψ hφψ).homology ≅ X) ∧
        Nonempty ((ShortComplex.mk ψ φ hψφ).homology ≅ Y) := by
  obtain ⟨X₀, X₁, d₀, d₁, w₀, w₁, h₀, h₁, u, v, huv, ⟨e₀⟩, ⟨e₁⟩⟩ :=
    exists_exact_of_mem_closure (of_eq_of_iff.1 h.symm)
  have hperm : (Y :: v).Perm (X :: u) := by
    refine FreeAbelianGroup.list_sum_map_of_eq_list_sum_map_of_iff_perm.1 ?_
    rw [List.map_cons, List.map_cons, List.sum_cons, List.sum_cons]
    exact (sub_eq_sub_iff_add_eq_add.1 huv).trans (add_comm _ _)
  have he := nonempty_listBiprod_iso_of_perm hperm
  rw [listBiprod_cons, listBiprod_cons] at he
  obtain ⟨e⟩ := he
  let E : Y ⊞ X₀ ≅ X ⊞ X₁ :=
    biprod.mapIso (Iso.refl Y) e₀ ≪≫ e ≪≫ biprod.mapIso (Iso.refl X) e₁.symm
  let D₀ : Y ⊞ X₀ ⟶ X ⊞ X₁ := biprod.map 0 d₀
  let D₁ : X ⊞ X₁ ⟶ Y ⊞ X₀ := biprod.map 0 d₁
  have W₀ : D₀ ≫ D₁ = 0 :=
    (ShortComplex.biprodMk (.mk (0 : Y ⟶ X) (0 : X ⟶ Y) comp_zero) (.mk d₀ d₁ w₀)).zero
  have W₁ : D₁ ≫ D₀ = 0 :=
    (ShortComplex.biprodMk (.mk (0 : X ⟶ Y) (0 : Y ⟶ X) comp_zero) (.mk d₁ d₀ w₁)).zero
  refine ⟨Y ⊞ X₀, D₀ ≫ E.inv, E.hom ≫ D₁, by simp [W₀], by simp [reassoc_of% W₁], ?_, ?_⟩
  · exact homology_iso_of_iso_biprod_zeros d₀ d₁ w₀ h₀ W₀
      (ShortComplex.isoMk (Iso.refl _) E (Iso.refl _) (by simp [D₀]) (by simp [D₁]))
  · exact homology_iso_of_iso_biprod_zeros d₁ d₀ w₁ h₁ W₁
      (ShortComplex.isoMk E (Iso.refl _) E (by simp [D₁]) (by simp [D₀]))

end Realisation

/-! ### Stacks 02MX (2) -/

variable [Abelian A]

/-- The realisation theorem, the key step of Stacks 02MX (2): two objects `X` and `Y` of `A`
have the same class in `K₀(A)` if and only if there is a 2-periodic complex
`M --φ--> M --ψ--> M` (Stacks 02MW) whose homology objects `H⁰ = Ker ψ / Im φ` and
`H¹ = Ker φ / Im ψ` are isomorphic to `X` and to `Y`. Stacks 02SC uses it in this form. -/
@[stacks 02MX "(2), key step: `[X] = [Y]` iff `X ≅ H⁰`, `Y ≅ H¹` for some `(M, φ, ψ)`"]
theorem of_eq_of_iff_exists_homology_iso {X Y : A} :
    of X = of Y ↔ ∃ (M : A) (φ ψ : M ⟶ M) (hφψ : φ ≫ ψ = 0) (hψφ : ψ ≫ φ = 0),
      Nonempty ((ShortComplex.mk φ ψ hφψ).homology ≅ X) ∧
        Nonempty ((ShortComplex.mk ψ φ hψφ).homology ≅ Y) := by
  refine ⟨exists_homology_iso_of_of_eq_of, ?_⟩
  rintro ⟨M, φ, ψ, hφψ, hψφ, ⟨e₀⟩, ⟨e₁⟩⟩
  rw [← of_eq_of_iso e₀, ← of_eq_of_iso e₁]
  exact of_homology_eq_of_homology φ ψ hφψ hψφ

/-- Stacks 02MX (2): let `P` be a property of objects of `A` that contains `0` and is closed under
binary products (hence under isomorphisms), and let `hι` say that the inclusion `P.ι` preserves
short exact sequences. An element `x` of `K₀(P.FullSubcategory)` maps to `0` in `K₀(A)` if and
only if `x = [H⁰] - [H¹]` for a 2-periodic complex `(M, φ, ψ)` in `A` (Stacks 02MW) whose
homology objects `H⁰ = Ker ψ / Im φ` and `H¹ = Ker φ / Im ψ` satisfy `P`. Stacks states it for a
Serre subcategory, where it reads `map_ι_eq_zero_iff P P.shortExact_map_ι x`; there, by
`ObjectProperty.SerreClassLocalization.exact_map_iff`, the homology objects satisfy `P` if and
only if the complex becomes exact in the Serre quotient of `A` by `P`. -/
@[stacks 02MX "(2), for any `P` containing `0` and closed under `⊞`"]
theorem map_ι_eq_zero_iff (P : ObjectProperty A) [P.ContainsZero] [P.IsClosedUnderBinaryProducts]
    (hι : ∀ ⦃S : ShortComplex P.FullSubcategory⦄, S.ShortExact → (S.map P.ι).ShortExact)
    (x : GrothendieckGroup P.FullSubcategory) :
    map P.ι hι x = 0 ↔ ∃ (M : A) (φ ψ : M ⟶ M) (hφψ : φ ≫ ψ = 0) (hψφ : ψ ≫ φ = 0)
      (h₀ : P (ShortComplex.mk φ ψ hφψ).homology) (h₁ : P (ShortComplex.mk ψ φ hψφ).homology),
      x = of ⟨_, h₀⟩ - of ⟨_, h₁⟩ := by
  constructor
  · intro hx
    have : P.IsClosedUnderIsomorphisms := by
      obtain ⟨Z, hZ, hPZ⟩ := P.exists_prop_of_containsZero
      exact ⟨fun {X Y} e hX ↦ P.prop_of_isLimit_binaryFan
        (BinaryFan.IsLimit.mk (BinaryFan.mk (hZ.from_ Y) e.inv) (fun _ f ↦ f ≫ e.hom)
          (fun _ _ ↦ hZ.eq_of_tgt _ _) (fun _ _ ↦ by simp) (fun _ _ m _ h ↦ by simp [← h]))
        hPZ hX⟩
    have := HasBinaryBiproducts.of_hasBinaryProducts (C := P.FullSubcategory)
    obtain ⟨X, Y, rfl⟩ := exists_eq_of_sub_of x
    rw [map_sub, map_of, map_of, sub_eq_zero, ObjectProperty.ι_obj, ObjectProperty.ι_obj] at hx
    obtain ⟨M, φ, ψ, hφψ, hψφ, ⟨e₀⟩, ⟨e₁⟩⟩ := of_eq_of_iff_exists_homology_iso.1 hx
    have h₀ := P.prop_of_iso e₀.symm X.property
    have h₁ := P.prop_of_iso e₁.symm Y.property
    refine ⟨M, φ, ψ, hφψ, hψφ, h₀, h₁, ?_⟩
    rw [of_eq_of_iso (P.isoMk (X := ⟨_, h₀⟩) (Y := X) e₀),
      of_eq_of_iso (P.isoMk (X := ⟨_, h₁⟩) (Y := Y) e₁)]
  · rintro ⟨M, φ, ψ, hφψ, hψφ, h₀, h₁, rfl⟩
    rw [map_sub, map_of, map_of, ObjectProperty.ι_obj, ObjectProperty.ι_obj, sub_eq_zero]
    exact of_homology_eq_of_homology φ ψ hφψ hψφ

end CategoryTheory.GrothendieckGroup
