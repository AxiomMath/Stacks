module

public import Mathlib.LinearAlgebra.Charpoly.Basic
public import Mathlib.RingTheory.AdjoinRoot
import StacksCore.RingTheory.AdjoinRoot
import StacksCore.RingTheory.PowerBasis

/-! # Free quotients of R[X]

Here we prove the following theorem: if `I` is an ideal of `R[X]` such that `R[X] ⧸ I` is free
over `R` with rank `n`, then `I` is in fact generated by a monic polynomial of degree `n`.

-/

@[expose] public section

open Module Ideal LinearMap Polynomial Algebra

namespace Polynomial

set_option backward.isDefEq.respectTransparency false in
/-- If `R[X] ⧸ I` is finite free over `R`, then `I` is principal, generated by the
characteristic polynomial of left-multiplication by `X` on the quotient.
To obtain a power basis consisting of powers of `⟦X⟧`, use `PowerBasis.adjoinOfFree`. -/
theorem eq_span_charpoly_of_free_quotient
    {R : Type*} [CommRing R] [Nontrivial R] (I : Ideal R[X])
    [Free R (R[X] ⧸ I)] [Module.Finite R (R[X] ⧸ I)] :
    I = span {(Algebra.lmul R (R[X] ⧸ I) (X : R[X])).charpoly} := by
  let y : R[X] ⧸ I := (X : R[X])
  have hy (q : R[X]) : aeval y q = Ideal.Quotient.mk I q := by
    simp_rw [y, ← Quotient.mkₐ_eq_mk R, aeval_algHom_apply, aeval_X_left_apply]
  let p := (Algebra.lmul R _ y).charpoly
  have hpy : p.aeval y = 0 := Algebra.aeval_self_charpoly_lmul y
  have hpI : p ∈ I := by rw [← Quotient.eq_zero_iff_mem, ← hy, hpy]
  have hpm : p.Monic := LinearMap.charpoly_monic _
  have hpd : p.natDegree = finrank R (R[X] ⧸ I) := LinearMap.charpoly_natDegree _
  let φ : AdjoinRoot p →ₐ[R] R[X] ⧸ I := AdjoinRoot.liftAlgHom _ (Algebra.ofId _ _) y hpy
  have hφq (q : R[X]) : φ (.mk _ q) = q := by simp [φ, ← aeval_def, hy]
  have hφ : Function.Surjective φ := fun q' ↦
    let ⟨q, hq⟩ := Ideal.Quotient.mk_surjective q'
    ⟨.mk _ q, hq ▸ by simp [hφq]⟩
  have := hpm.free_adjoinRoot
  have := hpm.finite_adjoinRoot
  replace hφ : Function.Bijective φ :=
    OrzechProperty.bijective_of_surjective_of_finrank_le φ.toLinearMap hφ (by simp [hpm, hpd])
  refine le_antisymm (fun x hx ↦ ?_) ((span_singleton_le_iff_mem _).mpr hpI)
  rw [mem_span_singleton, ← AdjoinRoot.mk_eq_zero, ← hφ.injective.eq_iff, map_zero, hφq]
  exact Quotient.eq_zero_iff_mem.mpr hx

/-- The minimal polynomial of `AdjoinRoot.root f` for a monic polynomial `f` is `f` itself. -/
theorem Monic.minpoly_adjoinRoot
    {R : Type*} [CommRing R] {f : R[X]} (hf : f.Monic) :
    minpoly R (AdjoinRoot.root f) = f :=
  (AdjoinRoot.powerBasis' hf).minpoly_gen_eq (by simp) hf rfl

/-- If `R[X] ⧸ I` is finite free over `R`, the minimal polynomial of the class of `X` in
`R[X] ⧸ I` is the characteristic polynomial of left-multiplication by `X` on the quotient. -/
theorem minpoly_eq_of_free_quotient
    {R : Type*} [CommRing R] (I : Ideal R[X])
    [Free R (R[X] ⧸ I)] [Module.Finite R (R[X] ⧸ I)] :
    minpoly R ((X : R[X]) : R[X] ⧸ I) = (LinearMap.mul R (R[X] ⧸ I) (X : R[X])).charpoly := by
  nontriviality R
  generalize hp : (LinearMap.mul R (R[X] ⧸ I) (X : R[X])).charpoly = p
  have hpm : p.Monic := hp ▸ LinearMap.charpoly_monic _
  obtain rfl : I = span {p} := hp ▸ eq_span_charpoly_of_free_quotient I
  exact hpm.minpoly_adjoinRoot

end Polynomial
