module

public import Mathlib.RingTheory.Trace.Basic
import StacksCore.Tactic.StacksAttribute

/-! # Basic facts about algebraic trace -/

@[expose] public section

add_to_stacks 0BIH trace_eq_finrank_mul_minpoly_nextCoeff

open Finset

/-- For a finite Galois extension `K/F` whose Galois group is generated by `σ`, the algebraic
trace of `x ∈ K` equals `∑ i ∈ range #Gal(K/F), σⁱ x` after applying `algebraMap F K`. -/
theorem IsGalois.trace_eq_of_zpowers_eq_top
    {F K : Type*} [Field F] [Field K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K]
    {σ : Gal(K/F)} (hσ : ∀ g, g ∈ Subgroup.zpowers σ) (x : K) :
    algebraMap F K (Algebra.trace F K x) = ∑ i ∈ range (Nat.card Gal(K/F)), (σ ^ i) x := by
  classical
  have := IsCyclic.image_range_orderOf hσ
  rw [trace_eq_sum_automorphisms, ← this, sum_image (by simp [pow_injOn_Iio_orderOf]),
    ← Nat.card_zpowers, (Subgroup.eq_top_iff' _).mpr hσ, Subgroup.card_top]
